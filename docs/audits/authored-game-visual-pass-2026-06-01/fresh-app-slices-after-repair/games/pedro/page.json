  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Pedro",
          "subtitle": "Cinch / High Five",
          "content": [
            {
              "type": "paragraph",
              "text": "Pedro (Cinch, High Five) is an American Pitch variant. The trump 5 (pedro) and the other 5 of same colour (low pedro) are each worth 5 points. 4p partnerships, 9 cards each, bidding 7-14. Discard non-trumps, refill to 6. First to 62 wins."
            },
            {
              "type": "paragraph",
              "text": "US 19th-century Pitch variant. Very popular late 1800s; declined in 20th century. Still played in southern USA, West Coast, Louisiana, Nicaragua (as Pedro), Finland (Pidro), Italy, Azores."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 in fixed partnerships. Partners opposite."
            },
            {
              "type": "paragraph",
              "text": "Standard 52 cards."
            },
            {
              "type": "paragraph",
              "text": "52-card deck."
            },
            {
              "type": "paragraph",
              "text": "9 each, 3 at a time. Deal and play clockwise."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Min Bid 6: Minimum bid 6; dealer forced to 6 or 7."
                },
                {
                  "text": "Slam: Bid 14: +28 if made, -14 if set."
                },
                {
                  "text": "28-56: Dealer only, with A-K-2 trumps: 56 if all points, -28 if set."
                },
                {
                  "text": "63: Additional scoring cards; play to 63."
                },
                {
                  "text": "83: With joker; play to 83."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
