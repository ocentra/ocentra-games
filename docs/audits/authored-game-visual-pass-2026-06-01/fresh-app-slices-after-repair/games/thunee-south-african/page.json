      "pages": [
        {
          "title": "Thunee",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Thunee (or Thuni) is a popular trick-taking card game in South Africa, particularly among Indian South Africans in Durban. It is related to the Jass family of games (like 304). The name 'Thunee' means 'water' in Tamil (though the connection is debated) or refers to a specific call. Unusually, the Jack and Nine are the highest cards. The game involves bidding and 'ball' scoring."
            },
            {
              "type": "paragraph",
              "text": "Evolved from the '304' game brought by Indian indentured labourers to South Africa."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 in partnerships (2–6 with variants)."
            },
            {
              "type": "paragraph",
              "text": "24 cards. Remove 2-8. Rank: J-9-A-10-K-Q."
            },
            {
              "type": "paragraph",
              "text": "Cards, score counters (balls)"
            },
            {
              "type": "paragraph",
              "text": "Deal 4 cards. Bid. Deal 2 more (total 6)."
            }
          ]
        }
      ]
    }
  ]
