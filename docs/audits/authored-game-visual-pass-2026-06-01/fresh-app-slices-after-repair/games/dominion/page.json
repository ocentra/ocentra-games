          "title": "Dominion",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Dominion is a commercial deck-building card game where players buy cards into personal decks and race for the highest victory score."
            },
            {
              "type": "paragraph",
              "text": "Created by Donald X. Vaccarino and published by Rio Grande Games in 2008, Dominion established deck-building as a major modern card-game mechanism."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Dominion."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Dominion kingdom, treasure, victory, and curse cards"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Dominion kingdom, treasure, victory, and curse cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Each player starts with a small identical deck; choose kingdom supply piles and prepare treasure, victory, and curse supplies."
            }
          ]
        }
      ]
    }
