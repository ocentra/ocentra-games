  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Shichi Narabe",
          "subtitle": "Layout Shedding Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Shichi Narabe is a Japanese layout shedding game related to Fan Tan/Sevens. Players lay out all sevens first, then extend each suit outward toward Ace and King while managing a limited number of passes."
            },
            {
              "type": "paragraph",
              "text": "Shichi Narabe is the Japanese form of Sevens/Fan Tan, adapted with explicit passing limits and several local tactical variants."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3 or more players; 3-5 is commonly preferred."
            },
            {
              "type": "paragraph",
              "text": "Use a standard 52-card deck; add one Joker for the Joker variant."
            },
            {
              "type": "paragraph",
              "text": "Cards and table space for a 13x4 suit layout."
            },
            {
              "type": "paragraph",
              "text": "Deal all cards one-by-one clockwise. All players who hold sevens place them face up to start the layout."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Joker Variant: Adds a Joker with exchange mechanics that can skip blocked cards in a row."
                },
                {
                  "text": "Tunnelling: Suit row ends connect so completion can force reverse-order continuation."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
