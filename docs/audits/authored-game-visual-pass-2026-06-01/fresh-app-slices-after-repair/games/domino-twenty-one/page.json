  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Domino Twenty-One",
          "subtitle": "Domino rules and play flow",
          "content": [
            {
              "type": "paragraph",
              "text": "Domino Twenty-One is a gambling game for 2 to 5 players that adapts the mechanics of Blackjack (21) to a standard set of double-six dominoes. Players bet against a banker to reach a pip total as close to 21 as possible without exceeding it."
            },
            {
              "type": "paragraph",
              "text": "Developed as a tile-based alternative to the card game 'Vingt-Un' (Twenty-One). The game mirrors the risk-management of Blackjack while using the finite 28-tile set of dominoes."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 5 players. One player is the Banker."
            },
            {
              "type": "paragraph",
              "text": "Standard 28 double-six dominoes."
            },
            {
              "type": "paragraph",
              "text": "Dominoes, betting chips or coins."
            },
            {
              "type": "paragraph",
              "text": "Each player is dealt 2 tiles face-down. Remaining tiles stay in the boneyard."
            }
          ]
        }
      ]
    }
  ]
