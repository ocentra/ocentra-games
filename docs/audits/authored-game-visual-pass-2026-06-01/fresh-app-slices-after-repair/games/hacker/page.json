          "title": "Hacker",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Hacker is a commercial dedicated-deck card game for three to six players published by Steve Jackson Games."
            },
            {
              "type": "paragraph",
              "text": "Hacker was published in 1992 by Steve Jackson Games after the events surrounding GURPS Cyberpunk and the Secret Service raid became part of the company history around the product."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-6 players use the table arrangement described for Hacker."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Hacker card deck"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Hacker card deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Hacker deck and any shared scoring, resource, or tableau area described by the rules."
            }
          ]
