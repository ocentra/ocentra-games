  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Getaway",
          "subtitle": "Punjabi Shedding Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Getaway is a Punjabi-origin shedding game in which players race to empty their hands while avoiding pickup penalties triggered by off-suit breaks (tochoo or thulla)."
            },
            {
              "type": "paragraph",
              "text": "Documented as a Punjabi family and social game under names including Getaway and Bhabhi, with related forms in Bangladesh and South India."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3 to 8 players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card pack with rank order A K Q J 10 9 8 7 6 5 4 3 2."
            },
            {
              "type": "paragraph",
              "text": "No additional equipment required."
            },
            {
              "type": "paragraph",
              "text": "Deal all cards as evenly as possible clockwise; some players may have one extra card."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Take from Left: Before a trick, a player may take all cards from immediate-left active player in many local rules."
                },
                {
                  "text": "Counterclockwise Direction: Some tables play and deal in anticlockwise direction with mirrored take-card rule."
                },
                {
                  "text": "Donkey: Related Kerala variant introduces trump suit when first off-suit is played."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
