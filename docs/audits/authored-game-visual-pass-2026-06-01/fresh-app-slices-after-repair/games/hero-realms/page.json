        {
          "title": "Hero Realms",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Hero Realms is a commercial fantasy deck-building card game where players acquire market cards and attack opposing champions or players."
            },
            {
              "type": "paragraph",
              "text": "Designed by Rob Dougherty and Darwin Kastle and published by Wise Wizard Games in 2016, Hero Realms adapts Star Realms-style deck building to a fantasy combat setting."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Hero Realms."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Hero Realms market and player decks"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Hero Realms market and player decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Hero Realms deck and any shared scoring, resource, or tableau area described by the rules."
            }
          ]
        }
      ]
    }
  ]
