  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Lowball Poker",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Lowball Poker is a family of poker variants in which the lowest-ranking hand wins rather than the highest hand."
            },
            {
              "type": "paragraph",
              "text": "Lowball developed as an inversion of ordinary poker hand ranking, with ace-to-five, deuce-to-seven, and ace-to-six ranking systems becoming the principal families."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-8 players use the table arrangement described for Lowball Poker."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Standard 52-card deck and deal or lay out cards according to the documented Lowball Poker rules before play begins."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Ace-to-five lowball: Aces are low and straights or flushes do not count against the low hand."
                },
                {
                  "text": "Deuce-to-seven lowball: Aces are high and straights or flushes count against the low hand; 7-5-4-3-2 is best."
                },
                {
                  "text": "Ace-to-six lowball: Aces are low but straights and flushes count against the hand."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
