      "pages": [
        {
          "title": "Irish Poker",
          "subtitle": "The Prediction Drinking Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Irish Poker is a high-energy, four-stage social drinking/betting game based on predictive card guessing. It is famous for its simple but escalating mechanics: Red or Black, Higher or Lower, Inside or Outside, and Suit. While it shares a name with Poker, it is a game of probability and penalty rather than hand rankings."
            },
            {
              "type": "paragraph",
              "text": "A modern social adaptation of older betting games like 'Red or Black'. It became a staple in university and pub culture globally under the name 'Irish Poker' or 'Ride the Bus'."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Best with 3-6 players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Deal four cards face-down to each player in a line."
            }
          ]
        }
      ]
    }
