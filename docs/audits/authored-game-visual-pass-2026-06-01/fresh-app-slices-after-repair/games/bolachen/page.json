          "title": "Bolachen",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Bolachen is a traditional three-player Upper Bavarian plain-trick game with suit bidding and contracts such as Bettel and Mord."
            },
            {
              "type": "paragraph",
              "text": "Bolachen is a traditional card game from southern Upper Bavaria. It belongs to the Wallachen environment and uses three-player contract play with a 32-card German pack, including contracts such as suit games, Bettel, and Mord."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3 players use the table arrangement described for Bolachen."
            },
            {
              "type": "paragraph",
              "text": "32-card German pack"
            },
            {
              "type": "paragraph",
              "text": "32-card German pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal a 32-card German pack to three players, then bid or choose the contract for the hand."
            }
          ]
        }
