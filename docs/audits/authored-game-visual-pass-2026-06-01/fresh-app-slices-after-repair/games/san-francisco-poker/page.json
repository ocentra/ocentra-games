        {
          "title": "San Francisco Poker",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "San Francisco: 7-card stud variant where all Queens are wild. Same deal and betting as 7-card stud; any Queen counts as any card. USA; dealer's choice."
            },
            {
              "type": "paragraph",
              "text": "American 7-card stud variant; Queens wild. Popular in home and dealer's choice games."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "From two to eight players may take part. The game is best for five to seven players; with eight players the deck can run short on the final deal. All four Queens are wild for every player."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck. No jokers."
            },
            {
              "type": "paragraph",
              "text": "Chips; table space."
            },
            {
              "type": "paragraph",
              "text": "Same as 7-card stud. All Queens are wild for all players."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Standard (Queens wild): Sources describe only the standard form; all four Queens are wild for all players. Same deal and betting as 7-card stud."
                }
              ]
            }
          ]
        }
      ]
