      "pages": [
        {
          "title": "Alhambra",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "Alhambra is a two-deck solitaire with a distinctive reserve and foundation structure, aiming to transfer all 104 cards into ordered foundation piles."
            },
            {
              "type": "paragraph",
              "text": "Alhambra is documented as a unique two-pack patience layout rather than a social card game, and is preserved mainly in solitaire rule collections."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One player arranges the reserve, tableau, stock, and foundations."
            },
            {
              "type": "paragraph",
              "text": "Use two shuffled standard 52-card decks."
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal the Alhambra reserve and starting foundation/tableau layout, then hold the rest as stock for controlled waste play."
            }
          ]
        }
      ]
    }
  ]
