      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Double Briškula",
          "subtitle": "Rummy rules and play flow",
          "content": [
            {
              "type": "paragraph",
              "text": "Double Briskula is a Balkan Briscola variant in which players hold four cards instead of three and play two cards per trick in two sub-rounds."
            },
            {
              "type": "paragraph",
              "text": "Derived from the Italian game Briscola, which spread to the Balkan coast during the Venetian and Austro-Hungarian eras. The 'Double' variant is a regional specialization common in Dalmatia and Istria."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players in two partnerships (North-South vs East-West)."
            },
            {
              "type": "paragraph",
              "text": "40ndcard deck (Standard 52 minus 8s, 9s, 10s). Suits: Coins, Cups, Batons, Swords."
            },
            {
              "type": "paragraph",
              "text": "40ndcard deck, score pad."
            },
            {
              "type": "paragraph",
              "text": "Dealer deals 4 cards to each player. A single card is turned facendup to indicate the Trump (Briscola) suit."
            }
          ]
        }
      ]
    }
  ]
