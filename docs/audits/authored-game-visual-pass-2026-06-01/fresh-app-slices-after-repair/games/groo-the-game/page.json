        {
          "title": "Groo The Game",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Groo The Game is a commercial card game based on Groo the Wanderer where players compete to build the largest town."
            },
            {
              "type": "paragraph",
              "text": "Published by Archangel Studios in 1997, Groo The Game adapts the comic property into a proprietary card game of town building and disruptive effects."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Groo The Game."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Groo The Game cards"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Groo The Game cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Groo The Game deck and any shared scoring, resource, or tableau area described by the rules."
            }
          ]
        }
      ]
    }
  ]
