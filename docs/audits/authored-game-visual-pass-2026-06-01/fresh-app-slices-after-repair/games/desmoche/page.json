      "pages": [
        {
          "title": "Desmoche",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Desmoche is a Nicaraguan rummy game, also played as conquién in Nicaragua, where players try to lay exactly ten cards in sets or runs."
            },
            {
              "type": "paragraph",
              "text": "Desmoche probably arose in Nicaragua in the first half of the 20th century and is closely related to Conquian and Gin Rummy."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Desmoche."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Standard 52-card deck and deal or lay out cards according to the documented Desmoche rules before play begins."
            }
          ]
        }
      ]
    }
  ]
