        {
          "title": "Chratze",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Chratze is a Swiss Rams-group trick-taking game for two to seven players using Swiss Jass cards and pot play."
            },
            {
              "type": "paragraph",
              "text": "Chratze, meaning raking, is a Swiss trick-taking game related to Kratzen and Mauscheln. It combines pot stakes, four-card hands, exchanging, and optional participation."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-7, best with 4-5 players use the table arrangement described for Chratze."
            },
            {
              "type": "paragraph",
              "text": "36-card Swiss Jass deck"
            },
            {
              "type": "paragraph",
              "text": "36-card Swiss Jass deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal four-card hands from a 36-card Swiss deck, establish the pot, and allow exchange or participation choices under local rules."
            }
          ]
        }
      ]
    }
  ]
