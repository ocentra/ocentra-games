          "title": "Doctor Who The Card Game",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Doctor Who The Card Game is a commercial card game where players use Doctor Who themed cards to defend locations and send threats at opponents."
            },
            {
              "type": "paragraph",
              "text": "Designed by Martin Wallace and published by Cubicle 7 in 2012, the game adapts the Doctor Who television setting into a dedicated multiplayer card game."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Doctor Who The Card Game."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Doctor Who card game deck"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Doctor Who card game deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal location, defender, enemy, and support cards from the dedicated deck according to the player count."
            }
          ]
        }
      ]
    }
