        {
          "title": "Kratzen",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Kratzen is an Austrian Rams-family trick-taking game for three to six players, usually played for small stakes with a 33-card William Tell pack."
            },
            {
              "type": "paragraph",
              "text": "Kratzen is related to Swiss Chratze and the wider Rams group, where players may drop out if they doubt they can win enough tricks."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-6 players use the table arrangement described for Kratzen."
            },
            {
              "type": "paragraph",
              "text": "33-card William Tell pack with the Weli retained"
            },
            {
              "type": "paragraph",
              "text": "33-card William Tell pack with the Weli retained, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare 33-card William Tell pack with the Weli retained and deal or lay out cards according to the documented Kratzen rules before play begins."
            }
          ]
        }
      ]
    }
