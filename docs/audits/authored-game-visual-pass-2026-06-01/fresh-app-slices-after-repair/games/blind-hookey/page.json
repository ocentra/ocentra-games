        {
          "title": "Blind Hookey",
          "subtitle": "Gambling",
          "content": [
            {
              "type": "paragraph",
              "text": "Blind Hookey is a simple chance card game also known as Dutch Bank, Banker and Broker, Haufeln, Bockspiel, or Packchen Wenden."
            },
            {
              "type": "paragraph",
              "text": "Recorded in German play as Haufeln as early as the eighteenth century and later known in English under several banking names."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 or more players use the table arrangement described for Blind Hookey."
            },
            {
              "type": "paragraph",
              "text": "Standard playing-card pack"
            },
            {
              "type": "paragraph",
              "text": "Standard playing-card pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Use small packets or face-down cards; players stake before packets are turned or compared."
            }
          ]
        }
      ]
    }
  ]
