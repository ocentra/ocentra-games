        {
          "title": "Herzeln",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Herzeln is an Austrian compendium trick-taking game with several deals and changing penalty objectives."
            },
            {
              "type": "paragraph",
              "text": "Herzeln is an Austrian multi-contract game related to Barbu, Lorum, Quodlibet, Rosbiratschka, Rumpel, and Kein Stich. It uses a shortened Skat-style pack and a series of distinct trick objectives."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-4 players use the table arrangement described for Herzeln."
            },
            {
              "type": "paragraph",
              "text": "24 or 32-card French or German Skat deck"
            },
            {
              "type": "paragraph",
              "text": "24 or 32-card French or German Skat deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal 24 or 32-card French or German Skat deck for 3-4 players according to the local rules before the first trick."
            }
          ]
        }
      ]
