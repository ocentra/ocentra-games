  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Agram",
          "subtitle": "Niger Last-Trick Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Agram is a West African last-trick game in which only the final trick decides the hand winner."
            },
            {
              "type": "paragraph",
              "text": "Agram is one of the most popular card games in Niger. Another version is played in northern Mali (Gao, Timbuktu, Kidal) and has spread to Cameroon as Fapfap. It is related to Spar or Sipa in Ghana and West Africa, probably descended from a European game introduced during the slave trade era."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two to five players; typically two to four. With six cards each and a 35-card pack, five is the maximum."
            },
            {
              "type": "paragraph",
              "text": "35-card pack from a standard deck with K, Q, J, all 2s, and Ace of spades removed."
            },
            {
              "type": "paragraph",
              "text": "Deck and optional score or stake tracking."
            },
            {
              "type": "paragraph",
              "text": "Deal 6 cards each in two batches of 3 (counterclockwise in common Niger form)."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Sink-Sink: Variant dealing five cards; winner of fifth trick wins."
                },
                {
                  "text": "Mali Pack: Uses 31-card Mali pack with adjusted top spade ordering."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
