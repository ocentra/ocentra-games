          "title": "Launch Pad",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Launch Pad is a commercial family strategy card game where players construct rockets and score completed launches."
            },
            {
              "type": "paragraph",
              "text": "Designed by Melanie James and published by Stratus Games in 2010, Launch Pad uses cards for rocket parts, experts, actions, and a four-card launch-pad game clock."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Launch Pad."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Launch Pad rocket, resource, action, and launch-pad cards"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Launch Pad rocket, resource, action, and launch-pad cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Launch Pad cards and any shared table, score, or resource areas from the published rules."
            }
          ]
        }
      ]
    }
