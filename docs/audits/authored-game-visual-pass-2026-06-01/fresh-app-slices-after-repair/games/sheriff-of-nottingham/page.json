          "title": "Sheriff of Nottingham",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Sheriff of Nottingham is a multiplayer bluffing and negotiation game where merchants smuggle goods past a rotating sheriff."
            },
            {
              "type": "paragraph",
              "text": "Designed by Sergio Halaban, Bryan Pope, and André Zatz, Sheriff of Nottingham was first released by Arcane Wonders in 2014."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-5 players use the table arrangement described for Sheriff of Nottingham."
            },
            {
              "type": "paragraph",
              "text": "Commercial goods cards with player boards, bags, and coins"
            },
            {
              "type": "paragraph",
              "text": "Commercial goods cards with player boards, bags, and coins, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Commercial goods cards with player boards, bags, and coins and deal or lay out cards according to the documented Sheriff of Nottingham rules before play begins."
            }
          ]
        }
      ]
