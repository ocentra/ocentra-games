          "title": "Knightmare Chess",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Knightmare Chess is a commercial fantasy chess variant where players use cards to alter normal chess movement, board state, and tactics."
            },
            {
              "type": "paragraph",
              "text": "The game is an English-language Steve Jackson Games edition of the French Tempête sur l'échiquier by Pierre Cléquin and Bruno Faidutti."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 players use the table arrangement described for Knightmare Chess."
            },
            {
              "type": "paragraph",
              "text": "Commercial Knightmare Chess cards plus a chess set"
            },
            {
              "type": "paragraph",
              "text": "Commercial Knightmare Chess cards plus a chess set, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Commercial Knightmare Chess cards plus a chess set and deal or lay out cards according to the documented Knightmare Chess rules before play begins."
            }
          ]
        }
      ]
