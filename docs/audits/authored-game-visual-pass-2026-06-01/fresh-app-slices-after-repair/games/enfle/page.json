      "pages": [
        {
          "title": "Enflé",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Enflé, also called Rolling Stone, Farbenjagd, or Schweller, is a French trick-taking shedding game where a player unable to follow suit must pick up the current trick."
            },
            {
              "type": "paragraph",
              "text": "Enflé appears in early nineteenth-century French sources and has been described as a simple but entertaining children's and family game."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-8 players use the table arrangement described for Enflé."
            },
            {
              "type": "paragraph",
              "text": "32-card French-suited pack, or 52 cards with larger groups"
            },
            {
              "type": "paragraph",
              "text": "32-card French-suited pack, or 52 cards with larger groups, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare 32-card French-suited pack, or 52 cards with larger groups and deal or lay out cards according to the documented Enflé rules before play begins."
            }
          ]
        }
      ]
    }
  ]
