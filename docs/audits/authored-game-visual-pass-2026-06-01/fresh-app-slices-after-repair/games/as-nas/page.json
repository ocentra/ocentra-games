  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "As-Nas",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "As-Nas is a historical Persian vying game played with a small five-suit pack, using poker-like betting and ranked combinations before modern poker standardized."
            },
            {
              "type": "paragraph",
              "text": "As-Nas was played in Persia with dedicated illustrated cards and is often discussed as part of the broader family of early vying games that predate or parallel poker."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two to five players can take part in a betting round."
            },
            {
              "type": "paragraph",
              "text": "Use the traditional As-Nas pack, commonly twenty cards with five copies of ranked court-style cards."
            },
            {
              "type": "paragraph",
              "text": "Traditional 20 or 25-card As-Nas pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal a small hand to each player, then conduct betting rounds around the table."
            }
          ]
        }
      ]
    }
  ]
