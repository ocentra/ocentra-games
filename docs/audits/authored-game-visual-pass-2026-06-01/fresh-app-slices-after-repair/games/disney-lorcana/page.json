          "title": "Disney Lorcana",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Disney Lorcana is a commercial trading card game where players quest with character cards and race to collect lore."
            },
            {
              "type": "paragraph",
              "text": "Released by Ravensburger in 2023, Disney Lorcana is a modern trading card game built around constructed decks, ink resources, character questing, and lore racing."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 or more players use the table arrangement described for Disney Lorcana."
            },
            {
              "type": "paragraph",
              "text": "Constructed Disney Lorcana deck of at least 60 cards"
            },
            {
              "type": "paragraph",
              "text": "Constructed Disney Lorcana deck of at least 60 cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Each player brings a constructed deck, draws an opening hand, and uses cards as ink resources during play."
            }
          ]
