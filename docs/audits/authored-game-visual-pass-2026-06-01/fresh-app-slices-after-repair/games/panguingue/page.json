        {
          "title": "Panguingue",
          "subtitle": "Southwest Rummy",
          "content": [
            {
              "type": "paragraph",
              "text": "Panguingue (Pan) is an American gambling rummy game popular in the Southwest. Played with eight 40-card decks (320 cards; 8sâ€“10s removed). Players meld sets and runs; first to meld 11 cards goes out. Conditions (valle cards, ace/king sets) earn immediate chip payouts."
            },
            {
              "type": "paragraph",
              "text": "Possibly from Philippines (pangginggi). Gambling rummy popular in Southwest USA. Name may derive from Tagalog pangguinggui."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2â€“15. Best 2â€“8."
            },
            {
              "type": "paragraph",
              "text": "Eight 40-card decks. Remove 8s, 9s, 10s. Rank K-Q-J-7-6-5-4-3-2-A (Ace low)."
            },
            {
              "type": "paragraph",
              "text": "320 cards, chips for ante and payouts."
            },
            {
              "type": "paragraph",
              "text": "10 cards each in five rounds of 2. Ante 1 chip. One card turned to start discard pile."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "310 Cards: Remove one full set of spades."
                },
                {
                  "text": "307 Cards: Remove 3, 5, 7 (and optionally 2, Q) from second spade set."
                }
              ]
            }
          ]
        }
      ]
    }
