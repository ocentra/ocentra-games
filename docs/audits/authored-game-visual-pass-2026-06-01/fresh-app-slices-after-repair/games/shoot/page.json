      "pages": [
        {
          "title": "Shoot",
          "subtitle": "Banking Variant",
          "content": [
            {
              "type": "paragraph",
              "text": "Shoot is a banking betting game in the Red Dog family. The dealer maintains the pot while each player bets that their hidden hand contains a card of the same suit and higher rank than the dealer's turned-up card."
            },
            {
              "type": "paragraph",
              "text": "Shoot is one of several named variants of the Red Dog / High Card Pool banking game family."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3 to about 8 players, with one acting as dealer/banker."
            },
            {
              "type": "paragraph",
              "text": "52-card deck, ace high."
            },
            {
              "type": "paragraph",
              "text": "Cards and money/chips for a shared dealer-controlled pot."
            },
            {
              "type": "paragraph",
              "text": "Dealer stakes the pot, then deals 3 cards to each non-dealer player. Players look at cards only just before their own bet."
            }
          ]
        }
      ]
    }
  ]
