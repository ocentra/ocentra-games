  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Differenzler Jass",
          "subtitle": "Precision Bid Jass",
          "content": [
            {
              "type": "paragraph",
              "text": "Differenzler Jass is a Swiss bidding point-trick game where each player predicts tricks and points won, and penalties are based on the difference between bid and result."
            },
            {
              "type": "paragraph",
              "text": "Differenzler developed in Swiss Jass circles as a variant that rewards accurate prediction rather than only raw trick count."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Three or four players. Four-player tables are common."
            },
            {
              "type": "paragraph",
              "text": "Swiss 36-card Jass deck (or French-suited equivalent regional pack)."
            },
            {
              "type": "paragraph",
              "text": "Cards and score sheet."
            },
            {
              "type": "paragraph",
              "text": "Dealer deals all cards in packets of three: 9 each with 4 players, 12 each with 3 players. Trump is determined from the cut card as described in rules."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Secret Predictions: Players write predictions privately and reveal after play."
                },
                {
                  "text": "Exact-Hit Bonus: An exact prediction scores -10 instead of 0 (with special handling for a prediction of 0)."
                },
                {
                  "text": "Stock Plus/Minus: Declaring Stock allows choosing +20 or -20 card points at declaration time."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
