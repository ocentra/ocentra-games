      "pages": [
        {
          "title": "Lexicon",
          "subtitle": "Matching",
          "content": [
            {
              "type": "paragraph",
              "text": "Lexicon is a British commercial word game using cards rather than tiles, with players forming and scoring words."
            },
            {
              "type": "paragraph",
              "text": "Designed by David Whitelaw and published by Waddingtons in 1932, Lexicon adapts crossword and anagram word play into a dedicated card deck."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 or more with another deck players use the table arrangement described for Lexicon."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Lexicon letter cards"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Lexicon letter cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Lexicon cards and any shared table, score, or resource areas from the published rules."
            }
          ]
        }
      ]
    }
  ]
