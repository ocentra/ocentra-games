  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Sheng Ji",
          "subtitle": "Point-Trick Partnership Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Sheng Ji (Tractor / Level Up) is a Chinese point-trick game family with dynamic trump rank and suit each round. The standard form uses four players in fixed partnerships and two decks with jokers."
            },
            {
              "type": "paragraph",
              "text": "Sheng Ji developed as a Chinese point-trick game family and spread across regions with many house-rule systems."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Usually 4 players in fixed partnerships (partners sit opposite)."
            },
            {
              "type": "paragraph",
              "text": "Commonly two full decks with jokers (108 cards total)."
            },
            {
              "type": "paragraph",
              "text": "Cards and score/rank tracking."
            },
            {
              "type": "paragraph",
              "text": "Players draw one card at a time during deal; in two-deck four-player games, each player gets 25 cards and 8 cards remain as kitty/bottom."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Tractor (Double Deck): Most common partnership form with two decks, tractors/chains, and fixed partnerships."
                },
                {
                  "text": "Zhao Pengyou (Finding Friends): Dealer calls partner cards in larger-player games with fluid partnerships."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
