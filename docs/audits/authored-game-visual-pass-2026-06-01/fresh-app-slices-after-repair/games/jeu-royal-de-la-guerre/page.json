      "pages": [
        {
          "title": "Jeu Royal de la Guerre",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Jeu Royal de la Guerre is a seventeenth-century French novelty trick-taking game played with a dedicated 40-card war-themed pack."
            },
            {
              "type": "paragraph",
              "text": "The rules were described in La Maison des Jeux Academiques in 1659, using a war-themed adaptation of a French-suited piquet pack plus four suitless special cards."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-12 players use the table arrangement described for Jeu Royal de la Guerre."
            },
            {
              "type": "paragraph",
              "text": "Dedicated historical 40-card war-themed pack"
            },
            {
              "type": "paragraph",
              "text": "Dedicated historical 40-card war-themed pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Dedicated historical 40-card war-themed pack and deal or lay out cards according to the documented Jeu Royal de la Guerre rules before play begins."
            }
          ]
        }
      ]
    }
  ]
