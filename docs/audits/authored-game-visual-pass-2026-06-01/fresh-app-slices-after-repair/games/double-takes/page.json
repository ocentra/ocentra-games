      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Double Takes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Double Takes is a western domino game played with a double-15 set, using the larger value range to support long sessions and more complex end control. Players use standard matching placements while managing high-value risk and mobility across a wide range of open-end values."
            },
            {
              "type": "paragraph",
              "text": "Double Takes is encountered as a modern large-set domino format that relies on extended western domino sets for longer and less blocked sessions."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 10 players."
            },
            {
              "type": "paragraph",
              "text": "One double-15 western domino set."
            },
            {
              "type": "paragraph",
              "text": "Domino set and optional score tracking by match profile."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles by player count; remaining tiles form a boneyard if the profile uses draws."
            }
          ]
        }
      ]
    }
  ]
