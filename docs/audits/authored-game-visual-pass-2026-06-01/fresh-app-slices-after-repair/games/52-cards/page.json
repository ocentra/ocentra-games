        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Putt Putt: Turning the corner is permitted: a King may be played on an Ace, and an Ace on a King."
                },
                {
                  "text": "Queens on Kings: Queens may be played on top of Kings to make the game easier."
                },
                {
                  "text": "Wild Card: One or both Jokers added to the deck and used as wild cards that represent any rank."
                },
                {
                  "text": "Empty Foundation Head-Start: The waste pile starts empty; the player may choose one exposed tableau card to move to the waste to begin."
                }
              ]
            }
