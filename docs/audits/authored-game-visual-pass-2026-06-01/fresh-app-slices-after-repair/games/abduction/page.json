          "title": "Abduction",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Abduction is a commercial science-fiction card game in which players try to escape from an alien abduction scenario through custom cards and event resolution."
            },
            {
              "type": "paragraph",
              "text": "Abduction was published by Eden Studios as a late-1990s science-fiction card game focused on escaping an alien-threat premise."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Players use the dedicated Abduction card set and scenario setup."
            },
            {
              "type": "paragraph",
              "text": "Use the commercial game deck and any role or scenario cards specified by the rules."
            },
            {
              "type": "paragraph",
              "text": "Commercial science-fiction card game deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the scenario deck, deal starting cards, and establish the escape or alien-threat state."
            }
          ]
        }
      ]
