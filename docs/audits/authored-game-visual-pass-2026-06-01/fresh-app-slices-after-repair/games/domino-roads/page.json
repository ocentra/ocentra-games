      "pages": [
        {
          "title": "Domino Roads",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Domino Roads is a western connecting domino game played with two double-six sets, enabling larger tables and longer layouts. Players build a shared layout by matching open ends while managing mobility and pip exposure under duplicated-tile uncertainty."
            },
            {
              "type": "paragraph",
              "text": "Domino Roads is encountered as a modern connecting format that increases supply by combining two standard sets to reduce early blocking."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 8 players."
            },
            {
              "type": "paragraph",
              "text": "Two double-6 domino sets combined and mixed."
            },
            {
              "type": "paragraph",
              "text": "Domino sets and optional score tracking."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles by player count; remaining tiles may form a boneyard by table profile."
            }
          ]
        }
      ]
    }
  ]
