  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Game to Lose",
          "subtitle": "Reverse Trick-Taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Game to Lose is a three-player reverse trick-taking game from England's West Midlands. Players try to avoid taking valuable cards, because points are bad and the first player to 121 or more loses."
            },
            {
              "type": "paragraph",
              "text": "Game to Lose is documented as a West Midlands three-player reverse form of Chaser (Nine Card Don family)."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3 players, playing individually."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck. Rank high to low: A K Q J 10 9 8 7 6 5 4 3 2."
            },
            {
              "type": "paragraph",
              "text": "Score pegs or cribbage board lanes are commonly used."
            },
            {
              "type": "paragraph",
              "text": "Dealer deals four clockwise 13-card hands one card at a time: pitcher, next player, dealer, and a dummy hand. The dummy hand is set aside face down as sleeping cards."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Tie for Eight: If two players tie for highest post-play card points, each pegs 4 instead of one player pegging 8."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
