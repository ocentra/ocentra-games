        {
          "title": "Hund",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Hund is a Silesian shedding card game for four players in which each player has an individual trump suit and the aim is to get rid of cards to opponents."
            },
            {
              "type": "paragraph",
              "text": "Hund is especially associated with Silesia and is related to games such as Bauernheinrich, Calypso, Dudák, and Svoi Kozyri."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players use the table arrangement described for Hund."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card French-suited deck without Jokers"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card French-suited deck without Jokers, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Standard 52-card French-suited deck without Jokers and deal or lay out cards according to the documented Hund rules before play begins."
            }
          ]
        }
      ]
    }
