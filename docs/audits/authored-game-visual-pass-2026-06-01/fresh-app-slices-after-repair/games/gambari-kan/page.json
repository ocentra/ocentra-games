  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Gambari-Kan",
          "subtitle": "Solo vs Pair Trick Play",
          "content": [
            {
              "type": "paragraph",
              "text": "Gambari-Kan is the three-player variant of Kan from Aomori. One player becomes the lone kankei (solo side) against two mukankei opponents and tries to capture enough point cards in trick play."
            },
            {
              "type": "paragraph",
              "text": "Gambari-Kan is documented as the three-player branch of the Kan family played in the Tsugaru and Goshogawara area of Aomori."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Exactly three players. One becomes kankei (solo), the other two form mukankei."
            },
            {
              "type": "paragraph",
              "text": "30-card pack: remove all 2s, 3s, 4s, 5s, and 6s, and remove all 7s except the 7 of Spades; include one joker."
            },
            {
              "type": "paragraph",
              "text": "30-card pack: remove all 2s, 3s, 4s, 5s, and 6s, and remove all 7s except the 7 of Spades; include one joker."
            },
            {
              "type": "paragraph",
              "text": "Dealer shuffles and deals 10 cards to each player counterclockwise. No stock remains."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Clockwise Table Play: Some groups reverse direction and play clockwise instead of the traditional counterclockwise order."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
