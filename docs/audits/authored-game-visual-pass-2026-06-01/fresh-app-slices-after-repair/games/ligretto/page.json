      "pages": [
        {
          "title": "Ligretto",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Ligretto is a commercial real-time shedding game where players race simultaneously to play numbered color cards to shared piles."
            },
            {
              "type": "paragraph",
              "text": "The current form was designed by Michael Michaels and published in 1988 by Rosengarten Spiele; later editions were published by Schmidt-Spiele and Playroom Entertainment."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-12 players use the table arrangement described for Ligretto."
            },
            {
              "type": "paragraph",
              "text": "Commercial Ligretto color and number card decks"
            },
            {
              "type": "paragraph",
              "text": "Commercial Ligretto color and number card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Commercial Ligretto color and number card decks and deal or lay out cards according to the documented Ligretto rules before play begins."
            }
          ]
        }
      ]
    }
  ]
