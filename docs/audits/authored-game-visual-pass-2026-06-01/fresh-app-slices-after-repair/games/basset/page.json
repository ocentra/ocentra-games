        {
          "title": "Basset",
          "subtitle": "Gambling",
          "content": [
            {
              "type": "paragraph",
              "text": "Basset is a historical Italian gambling card game in which players bet against a banker on ranks that may appear from the pack."
            },
            {
              "type": "paragraph",
              "text": "A seventeenth-century gambling game of Italian origin that became fashionable in France and England before being displaced by faro-style banking games."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "banker and any number of punters players use the table arrangement described for Basset."
            },
            {
              "type": "paragraph",
              "text": "52-card Anglo-American pack"
            },
            {
              "type": "paragraph",
              "text": "52-card Anglo-American pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "The banker controls the pack and exposes cards while players place stakes on rank positions before the turn-up sequence resolves."
            }
          ]
        }
      ]
    }
