      "pages": [
        {
          "title": "Bluke",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Bluke, also called Blook in some sources, is an American trick-taking game using a 52-card deck plus two Jokers, where the Jokers are the highest trumps and the deal size changes from hand to hand."
            },
            {
              "type": "paragraph",
              "text": "Bluke is documented in parts of the American East Coast and Midwest, with a related version called Back Alley or Blooper associated with American military play around the Second World War."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-15 players use the table arrangement described for Bluke."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck plus two Jokers"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck plus two Jokers, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Standard 52-card deck plus two Jokers and deal or lay out cards according to the documented Bluke rules before play begins."
            }
          ]
        }
      ]
    }
  ]
