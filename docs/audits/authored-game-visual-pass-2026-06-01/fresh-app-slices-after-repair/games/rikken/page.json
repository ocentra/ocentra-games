      "pages": [
        {
          "title": "Rikken",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Rikken is a trick-taking game from the Netherlands and Belgium. Four players; 52 cards (2 low to A high). Multiple contracts: Rik (8 tricks with called Ace partner), Rik Beter (hearts trump), 8-13 Alleen (solo), MisÃ¨re, Piek (exactly 1 trick). Cards never shuffled between hands."
            },
            {
              "type": "paragraph",
              "text": "Rikken originates in the southern Netherlands, mainly the province of Noord Brabant, and is also played in Belgium. It is a plain trick game with trumps and bidding, with similarities to Solo Whist, and is played in competitions."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "52 cards. A high, 2 low."
            },
            {
              "type": "paragraph",
              "text": "Deck. No shuffle between hands."
            },
            {
              "type": "paragraph",
              "text": "7+6 each (13). Deal clockwise."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Three Player: Blind hand."
                },
                {
                  "text": "Five Player: Dealer sits out."
                }
              ]
            }
          ]
        }
      ]
    }
