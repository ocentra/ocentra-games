        {
          "title": "Once Upon a Time",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Once Upon a Time is a commercial storytelling card game where players guide a shared fairy tale toward their own ending card."
            },
            {
              "type": "paragraph",
              "text": "First published in 1994 by Atlas Games, Once Upon a Time uses prompt cards and ending cards to turn competitive hand management into collaborative storytelling."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-6 players use the table arrangement described for Once Upon a Time."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Once Upon a Time story and ending cards"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Once Upon a Time story and ending cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Once Upon a Time cards and any shared table, score, or resource areas from the published rules."
            }
          ]
        }
      ]
    }
