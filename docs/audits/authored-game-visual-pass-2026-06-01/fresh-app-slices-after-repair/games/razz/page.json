    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Razz",
          "subtitle": "7-Card Stud Low",
          "content": [
            {
              "type": "paragraph",
              "text": "Razz is 7-Card Stud played for low. A-5 lowball: Aces are low; straights and flushes don't count; best hand is 5-4-3-2-A (the wheel). Betting as in Stud. Fixed-limit or spread-limit. Popular in HORSE."
            },
            {
              "type": "paragraph",
              "text": "Razz is the low-only variant of Seven-Card Stud, using ace-to-five (A-5) lowball ranking. It emerged within American stud poker and became widely known as one of the five games in the mixed format HORSE (Texas hold'em, Omaha hi-low, Razz, Seven-card stud, Eight-or-better), featured in the World Series of Poker and high-stakes casino play."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "A standard 52-card pack is used; two to eight players can take part. The game is best for five to seven players."
            },
            {
              "type": "paragraph",
              "text": "Deck, chips."
            },
            {
              "type": "paragraph",
              "text": "2 down, 1 up; 3 up; 1 up; 1 down. As Stud."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "HORSE: Razz is one of five games."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
