          "content": [
            {
              "type": "paragraph",
              "text": "Clock, also known as Sundial, is a luck-based solitaire laid out like a clock face."
            },
            {
              "type": "paragraph",
              "text": "A simple non-builder patience known by layouts representing the twelve clock positions."
            }
          ]
        },
