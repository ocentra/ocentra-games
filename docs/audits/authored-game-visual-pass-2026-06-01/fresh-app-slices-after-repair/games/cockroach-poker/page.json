        {
          "title": "Cockroach Poker",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Cockroach Poker is a commercial bluffing card game where players pass creature cards while declaring what they claim the card is."
            },
            {
              "type": "paragraph",
              "text": "Designed by Jacques Zeimet and published by Drei Magier Spiele in 2004, Cockroach Poker is a modern bluffing party card game."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-6 players use the table arrangement described for Cockroach Poker."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Cockroach Poker creature deck"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Cockroach Poker creature deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal the creature cards among players; there is no shared rank-and-suit deck."
            }
          ]
        }
      ]
    }
  ]
