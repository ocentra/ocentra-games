  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Sevens Dominoes",
          "subtitle": "Triangle Layout Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Sevens is a domino layout game where players build a triangular pattern from doubles and sequential non-doubles, trying to be first to play all tiles."
            },
            {
              "type": "paragraph",
              "text": "Sevens Dominoes is described as the domino equivalent of Fan Tan (Sevens), documented in modern form through published internet rules."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Best for 2-3 players; 4 players leave no boneyard."
            },
            {
              "type": "paragraph",
              "text": "Standard 28-tile double-six set, from 0-0 to 6-6."
            },
            {
              "type": "paragraph",
              "text": "Double-six dominoes and table space for a triangle layout."
            },
            {
              "type": "paragraph",
              "text": "Each player draws 7 tiles; remaining tiles form a boneyard."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Free Start: Some groups allow any opening tile or a random boneyard starter instead of highest double."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
