      "pages": [
        {
          "title": "Thirty-One (Greek)",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Thirty-One (often called '31' or 'H τριανταμία' in Greek) is a simple draw-and-discard game popular in Greece and worldwide. Players try to collect a hand of three cards in the same suit totaling 31 points (Ace=11, Face=10). The player with the lowest score loses a life."
            },
            {
              "type": "paragraph",
              "text": "One of the oldest European card games, dating back to the 15th century (Trentuno)."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck"
            },
            {
              "type": "paragraph",
              "text": "Tokens (lives) - usually 3 per player."
            },
            {
              "type": "paragraph",
              "text": "Deal 3 cards to each player. Place one card face up (or three) to start discard pile."
            }
          ]
        }
      ]
    }
  ]
