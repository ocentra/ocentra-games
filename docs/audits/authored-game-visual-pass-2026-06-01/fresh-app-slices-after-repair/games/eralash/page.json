        {
          "title": "Eralash",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Eralash is a family of Russian Whist variants for four players in partnerships, using whist-style follow-suit trick play with local scoring and contract differences."
            },
            {
              "type": "paragraph",
              "text": "Eralash, a Russian word meaning jumble or scramble, refers to Russian Whist variants built on the same four-player partnership trick-taking foundation as whist and bridge."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 in two partnerships players use the table arrangement described for Eralash."
            },
            {
              "type": "paragraph",
              "text": "Standard playing-card pack"
            },
            {
              "type": "paragraph",
              "text": "Standard playing-card pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal the pack to four players seated in two partnerships, then play the agreed Eralash variant."
            }
          ]
        }
      ]
    }
  ]
