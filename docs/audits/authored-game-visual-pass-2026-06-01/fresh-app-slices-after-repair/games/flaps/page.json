        {
          "title": "Flaps",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Flaps is a commercial shedding card game based on Crazy Eights, using a custom deck whose seven levels progressively add more rules."
            },
            {
              "type": "paragraph",
              "text": "Paul Feagan invented Flaps in England in 1981 by writing special rules onto ordinary playing cards; a commercial edition was released in 1994 and later translated into a dual English-Czech edition."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-8 players use the table arrangement described for Flaps."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Flaps deck with staged rule text"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Flaps deck with staged rule text, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Dedicated Flaps deck with staged rule text and deal or lay out cards according to the documented Flaps rules before play begins."
            }
          ]
        }
      ]
