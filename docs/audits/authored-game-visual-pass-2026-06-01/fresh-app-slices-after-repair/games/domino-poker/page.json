    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Domino Poker",
          "subtitle": "Draw and Showdown Tiles",
          "content": [
            {
              "type": "paragraph",
              "text": "Domino Poker is a draw-and-compare domino game where players form the strongest poker-style tile pattern."
            },
            {
              "type": "paragraph",
              "text": "Domino Poker emerged as a house-game adaptation of card poker concepts using pip combinations instead of card suits and ranks."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 4 players."
            },
            {
              "type": "paragraph",
              "text": "One double-six set (28 tiles)."
            },
            {
              "type": "paragraph",
              "text": "Dominoes and score/pot tracking."
            },
            {
              "type": "paragraph",
              "text": "Each player is dealt a starting hand; remaining tiles form boneyard for draw phases."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Single Draw: Only one draw round before showdown."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
