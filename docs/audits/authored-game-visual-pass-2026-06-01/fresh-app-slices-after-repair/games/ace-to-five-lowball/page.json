  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Ace-To-Five Lowball",
          "subtitle": "California Draw Low",
          "content": [
            {
              "type": "paragraph",
              "text": "Ace-To-Five Lowball is a draw poker variant in which the lowest hand wins. Aces are low, and straights and flushes do not count against a low hand."
            },
            {
              "type": "paragraph",
              "text": "Ace-to-five lowball developed in U.S. card rooms and became a core lowball form, especially in California."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two to eight players; the game is similar to Five Card Draw with one draw round. Typically played with blinds (dealer, small blind, big blind) or an ante; best with about six at the table."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck; optional joker bug in some house rules."
            },
            {
              "type": "paragraph",
              "text": "Deck, chips, dealer button, and blind markers if blind structure is used."
            },
            {
              "type": "paragraph",
              "text": "Deal 5 cards face-down to each player."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Single Draw: One draw round and two main betting rounds."
                },
                {
                  "text": "Triple Draw: Three draw rounds with additional betting rounds."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
