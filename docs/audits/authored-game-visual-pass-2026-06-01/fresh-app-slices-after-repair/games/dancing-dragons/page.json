    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Dancing Dragons",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Dancing Dragons is a Chinese-domino connecting game in which players extend a shared layout by matching legal ends while trying to empty their hands before opponents."
            },
            {
              "type": "paragraph",
              "text": "Dancing Dragons is documented as a modern Chinese-domino line game format rather than a long-established classical gambling family."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 4 players."
            },
            {
              "type": "paragraph",
              "text": "One Chinese domino set of 32 tiles."
            },
            {
              "type": "paragraph",
              "text": "Chinese domino tiles and table space for a line layout."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles evenly to players according to table convention; remaining tiles can be boneyard if used by local rules."
            }
          ]
        }
      ]
    }
  ]
