          "title": "Soko",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Soko is a Finnish five-card stud poker variant. It keeps the Five Card Stud deal but adds two extra hand ranks: four-card straight and four-card flush, both ranking above one pair and below two pair."
            },
            {
              "type": "paragraph",
              "text": "Originated in Finland; SÃ¶kÃ¶ is the Finnish word for 'Check' (in the poker sense) or potentially derived from a Swedish word. Despite the name 'Canadian Stud', it is most strongly associated with Finland and widely played there."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck"
            },
            {
              "type": "paragraph",
              "text": "Chips, dealer button"
            },
            {
              "type": "paragraph",
              "text": "Standard Five Card Stud deal: Everyone antes. Each player receives one card face down (hole) and one card face up (door)."
            }
          ]
        }
