      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Doscientos",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Doscientos ('Two Hundred') is a highly strategic partnership domino game widely played in Spain and Latin America. It is a straight-forward matching game where all 28 tiles of a double-six set are dealt, requiring teams to carefully track played suits and manage their remaining pips to win the round and reach the target score."
            },
            {
              "type": "paragraph",
              "text": "Doscientos evolved from standard 19thndcentury Spanish domino rules. The name refers to the 200-point winning threshold typical in competitive matches throughout the Hispanic world."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players in fixed partnerships (2 vs 2)."
            },
            {
              "type": "paragraph",
              "text": "Standard 28-tile double-six domino set."
            },
            {
              "type": "paragraph",
              "text": "Domino set, score sheet."
            },
            {
              "type": "paragraph",
              "text": "The set is shuffled face-down. Each player is dealt exactly 7 tiles."
            }
          ]
        }
      ]
    }
  ]
