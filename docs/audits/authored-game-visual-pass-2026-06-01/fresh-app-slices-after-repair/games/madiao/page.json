      "pages": [
        {
          "title": "Madiao",
          "subtitle": "Chinese money-card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Madiao is a historical Chinese money-card game with trick-taking and gambling structure, traditionally played with a dedicated 40-card money-suited deck."
            },
            {
              "type": "paragraph",
              "text": "Madiao is one of the classic Chinese money-card games and is historically important in the development of East Asian card and tile traditions."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Four players in traditional banker-versus-others style structures."
            },
            {
              "type": "paragraph",
              "text": "A dedicated 40-card Madiao money-card deck."
            },
            {
              "type": "paragraph",
              "text": "Madiao cards and stake or score tracking according to table custom."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt to the four players according to the local Madiao procedure before trick play begins."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Local contract scale: Some groups use slightly different contract ladders and values."
                }
              ]
            }
          ]
        }
      ]
    }
