        {
          "title": "Babylon 5 Collectible Card Game",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Babylon 5 Collectible Card Game is a commercial licensed CCG where players use factions, agendas, and card effects from the Babylon 5 setting."
            },
            {
              "type": "paragraph",
              "text": "The Babylon 5 CCG was published during the 1990s licensed collectible card game period and focused on political and factional conflict from the television series."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Players bring constructed faction decks."
            },
            {
              "type": "paragraph",
              "text": "Use legal commercial Babylon 5 cards and deck construction rules."
            },
            {
              "type": "paragraph",
              "text": "Commercial Babylon 5 collectible card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare starting faction materials, shuffle decks, and draw opening hands."
            }
          ]
        }
      ]
