          "title": "Bluchern",
          "subtitle": "Gambling",
          "content": [
            {
              "type": "paragraph",
              "text": "Bluchern is a simple historical gambling card game for any number of players using either a 52-card or 32-card pack."
            },
            {
              "type": "paragraph",
              "text": "A chance game named after Gebhard Leberecht von Blucher, now mainly of historical and social interest."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "any number players use the table arrangement described for Bluchern."
            },
            {
              "type": "paragraph",
              "text": "52-card French pack or 32-card French or German pack"
            },
            {
              "type": "paragraph",
              "text": "52-card French pack or 32-card French or German pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare small packets or turn-up cards according to the local form, with players staking before the reveal."
            }
          ]
        }
      ]
