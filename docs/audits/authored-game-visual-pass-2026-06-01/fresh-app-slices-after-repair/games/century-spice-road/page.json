          "title": "Century Spice Road",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Century Spice Road is a commercial card-driven strategy game where players trade and upgrade spice cubes to buy point cards."
            },
            {
              "type": "paragraph",
              "text": "Designed by Emerson Matsuuchi and published by Plan B Games in 2017, Century Spice Road uses cards to model fifteenth-century spice trading and engine building."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-5 players use the table arrangement described for Century Spice Road."
            },
            {
              "type": "paragraph",
              "text": "Dedicated merchant and point cards plus spice cubes"
            },
            {
              "type": "paragraph",
              "text": "Dedicated merchant and point cards plus spice cubes, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Set out merchant cards, point cards, and starting spice cubes for each player."
            }
          ]
        }
      ]
    }
