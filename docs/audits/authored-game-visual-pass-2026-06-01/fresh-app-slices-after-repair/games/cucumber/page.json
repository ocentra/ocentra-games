  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Cucumber",
          "subtitle": "Lose Last Trick",
          "content": [
            {
              "type": "paragraph",
              "text": "Cucumber is a Nordic lose-last-trick game: the goal is to avoid winning the final trick of the hand."
            },
            {
              "type": "paragraph",
              "text": "Cucumber appears in Nordic student card culture and is documented with national variants such as Agurk and Gurka."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "From 2 to 7 players in the baseline Danish form (Agurk); the Swedish variant Gurka allows 3 to 8, and some regional forms use extra decks for more. The game was popular with students across Nordic countries; this build uses the common 2–7 player range with seven cards each."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Deck and score tracking for penalty totals."
            },
            {
              "type": "paragraph",
              "text": "Deal 7 cards each in Danish Agurk baseline; undealt cards are set aside unseen."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Swedish Previous-Card Rule: Players may only need to beat the previous card played, not the current highest in trick."
                },
                {
                  "text": "Polish Ogorek Last-Trick Ace Low: In final trick, Ace counts as low (1) for penalty valuation."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
