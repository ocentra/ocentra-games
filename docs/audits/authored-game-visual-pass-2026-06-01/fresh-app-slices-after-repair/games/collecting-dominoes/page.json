          "title": "Collecting Dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Collecting Dominoes is a western domino game where play emphasizes accumulating advantageous outcomes over a hand sequence while still operating through legal matching placements on a shared layout."
            },
            {
              "type": "paragraph",
              "text": "The rules are encountered as a modern western domino format emphasizing collection-style scoring goals expressed through standard matching play."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 6 players."
            },
            {
              "type": "paragraph",
              "text": "One double-6 domino set."
            },
            {
              "type": "paragraph",
              "text": "Domino set and score tracking for collection-style scoring."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles by player count; remaining tiles may be boneyard by local rule."
            }
          ]
        }
      ]
