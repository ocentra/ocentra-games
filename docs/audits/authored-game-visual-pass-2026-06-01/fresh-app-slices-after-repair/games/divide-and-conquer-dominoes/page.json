        {
          "title": "Divide and Conquer Dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Divide and Conquer Dominoes is a western domino connecting game where layout management and end-control decisions are central, as players try to shed tiles while limiting opponent response options."
            },
            {
              "type": "paragraph",
              "text": "The game appears as a modern western domino connecting format emphasizing strategic end shaping and opponent constraint through layout control."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 6 players."
            },
            {
              "type": "paragraph",
              "text": "One double-6 domino set."
            },
            {
              "type": "paragraph",
              "text": "Domino set and table space; optional score tracking for match play."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles by player count; remaining tiles may form a boneyard depending on table profile."
            }
          ]
        }
      ]
    }
