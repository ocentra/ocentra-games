  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Gharat",
          "subtitle": "Iranian Loot Fishing",
          "content": [
            {
              "type": "paragraph",
              "text": "Gharat is an Iranian fishing-loot game where players match ranks to steal cards from the central play pile or from the top of opponents' capture piles."
            },
            {
              "type": "paragraph",
              "text": "Gharat was documented in Iran as a fishing game whose name means loot, reflecting rank-match theft from visible pile tops."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2, 3, or 4 players, with optional partnerships at 4."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card international deck, rank-only comparisons."
            },
            {
              "type": "paragraph",
              "text": "Score sheet for cumulative target race."
            },
            {
              "type": "paragraph",
              "text": "Start play pile with four face-up stacked cards (only top visible), deal four cards to each player, and keep remainder as face-down stock for future 4-card redeals."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Pair Play Easy Variant: A player holding a pair may place both to capture pile in one turn, then skips later turn(s) to compensate card count."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
