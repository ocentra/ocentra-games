          "title": "Fourteen Out",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "Fourteen Out is a one-deck adding-and-pairing patience where pairs totaling fourteen are removed from the layout."
            },
            {
              "type": "paragraph",
              "text": "Fourteen Out, also known as Fourteen Off, Fourteen Puzzle, Take Fourteen, or Fourteen, is a pairing patience based on arithmetic removal from a 52-card deck."
            }
          ]
        },
