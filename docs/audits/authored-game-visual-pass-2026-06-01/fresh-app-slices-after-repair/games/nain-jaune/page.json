        {
          "title": "Nain Jaune",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Nain Jaune, or Yellow Dwarf, is a classic French stops-family card game using a five-compartment board and counters, named for the seven of diamonds."
            },
            {
              "type": "paragraph",
              "text": "The game appeared in Lorraine around 1760, spread through Europe, and survives as a French family game with modern simplified rules."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-8 players use the table arrangement described for Nain Jaune."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck plus five-compartment Nain Jaune board and counters"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck plus five-compartment Nain Jaune board and counters, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Standard 52-card deck plus five-compartment Nain Jaune board and counters and deal or lay out cards according to the documented Nain Jaune rules before play begins."
            }
          ]
        }
