        {
          "title": "Cyprus Dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Cyprus Dominoes is a regional western-domino connecting game associated with Cypriot table tradition, played by matching open ends and managing hand exit routes across a hand sequence."
            },
            {
              "type": "paragraph",
              "text": "The game is treated as a regional domino ruleset associated with Cyprus, using standard matching play on an expanded set to support longer layouts."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 6 players."
            },
            {
              "type": "paragraph",
              "text": "One double-9 domino set."
            },
            {
              "type": "paragraph",
              "text": "Domino set and table space; optional score tracking."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles by player count; remaining tiles may form a boneyard by table profile."
            }
          ]
        }
      ]
    }
  ]
