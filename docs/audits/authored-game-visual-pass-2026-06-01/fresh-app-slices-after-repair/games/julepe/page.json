        {
          "title": "Julepe",
          "subtitle": "Gambling",
          "content": [
            {
              "type": "paragraph",
              "text": "Julepe is a Spanish-origin gambling card game related to Tute and five-card Loo, in which players elect whether to play and must win enough tricks to avoid penalties."
            },
            {
              "type": "paragraph",
              "text": "Julepe spread through Spanish-American countries during the nineteenth century and appears as a Tute-family gambling game."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-8 players use the table arrangement described for Julepe."
            },
            {
              "type": "paragraph",
              "text": "Spanish 40-card pack without 8s and 9s"
            },
            {
              "type": "paragraph",
              "text": "Spanish 40-card pack without 8s and 9s, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Spanish 40-card pack without 8s and 9s and deal or lay out cards according to the documented Julepe rules before play begins."
            }
          ]
        }
      ]
    }
