      "pages": [
        {
          "title": "Yukon Hold'em",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Yukon Hold'em is a Texas Hold'em variant with TWO separate flops. 2 hole cards + 7 community cards (2 flops of 2, 2 turns, 1 river). At showdown, choose ONLY ONE of 2 community card sets to combine with hole cards. Best 5-card hand wins."
            },
            {
              "type": "paragraph",
              "text": "Yukon Hold'em is a Texas Hold'em variant that uses two separate community boards. It emerged as a home and casino poker variant in North America in the late 20th century, extending standard hold'em with dual flops and a choice of which board to use at showdown."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card French deck, no jokers. One deck used."
            },
            {
              "type": "paragraph",
              "text": "Cards, chips"
            },
            {
              "type": "paragraph",
              "text": "2 hole cards each."
            }
          ]
        }
      ]
    }
