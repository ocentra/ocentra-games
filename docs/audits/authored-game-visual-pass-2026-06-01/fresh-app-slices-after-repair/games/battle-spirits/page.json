          "title": "Battle Spirits",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Battle Spirits is a commercial collectible card battle game where players build decks, summon spirits, and attack the opponent life total."
            },
            {
              "type": "paragraph",
              "text": "Designed by Mike Elliott and published by Bandai, Battle Spirits launched in 2008 as a trading card game with anime and organized-play support."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 players use the table arrangement described for Battle Spirits."
            },
            {
              "type": "paragraph",
              "text": "Constructed Battle Spirits deck with core resource system"
            },
            {
              "type": "paragraph",
              "text": "Constructed Battle Spirits deck with core resource system, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Each player brings a constructed deck and starts with life, a hand, and access to core resources used to summon and level cards."
            }
          ]
        }
