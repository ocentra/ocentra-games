      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Moghul Ganjifa",
          "subtitle": "Austrian tarock game",
          "content": [
            {
              "type": "paragraph",
              "text": "Moghul Ganjifa is a traditional South Asian trick-taking game family played with the 96-card Mughal ganjifa deck and circular-suited court structure."
            },
            {
              "type": "paragraph",
              "text": "Doppen appears in Austrian tarock references as a real regional tarock game in the broader Industrie und Glück branch."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Typically 2-6 players depending on local ganjifa variant."
            },
            {
              "type": "paragraph",
              "text": "54-card Industrie und Glück pack with 22 permanent trumps and 32 suited cards."
            },
            {
              "type": "paragraph",
              "text": "Tarock deck and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt with a talon packet according to local Doppen dealing conventions before contract decisions."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Local contract scale: Some groups use slightly different contract ladders and values."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
