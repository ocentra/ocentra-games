        {
          "title": "Grasobern",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Grasobern is a Bavarian trick-avoidance plain-trick game where players try to avoid the Grasober and related penalties."
            },
            {
              "type": "paragraph",
              "text": "Grasobern, also called Grasoberln, Graseberla, or Grunobern, is a Bavarian plain-trick avoidance game using a 32-card German pack and leisurely short hands."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players use the table arrangement described for Grasobern."
            },
            {
              "type": "paragraph",
              "text": "32-card German pack"
            },
            {
              "type": "paragraph",
              "text": "32-card German pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal 32-card German pack for 4 players according to the local rules before the first trick."
            }
          ]
        }
      ]
    }
