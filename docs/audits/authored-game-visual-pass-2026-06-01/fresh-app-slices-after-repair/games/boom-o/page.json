        {
          "title": "Boom O",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Boom-O is a Mattel commercial card game in the Ninety-Nine family where players add values toward a dangerous explosion total."
            },
            {
              "type": "paragraph",
              "text": "Published by Mattel, Boom-O adapts the public adding-game idea of Ninety-Nine into a proprietary bomb-themed family card game."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-6 players use the table arrangement described for Boom O."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Boom-O deck"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Boom-O deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal hands from the dedicated deck and start a shared running total."
            }
          ]
        }
      ]
    }
  ]
