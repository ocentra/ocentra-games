        {
          "title": "Just One",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Just One is a cooperative party game where players give one-word clues to help a guesser identify a secret word, with duplicate clues cancelled."
            },
            {
              "type": "paragraph",
              "text": "Designed by Ludovic Roudy and Bruno Sautter and published by Repos Production in 2018, Just One became an award-winning modern party game."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-7 players use the table arrangement described for Just One."
            },
            {
              "type": "paragraph",
              "text": "Commercial Just One word cards plus writing boards"
            },
            {
              "type": "paragraph",
              "text": "Commercial Just One word cards plus writing boards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Commercial Just One word cards plus writing boards and deal or lay out cards according to the documented Just One rules before play begins."
            }
          ]
        }
      ]
    }
