    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Kalookie (British-European)",
          "subtitle": "British Rummy Excellence",
          "content": [
            {
              "type": "paragraph",
              "text": "Kalookie (British/European version) is a sophisticated Rummy variant played with 106 cards. Unlike the Caribbean 'contract' version, British Kalookie typically emphasizes a points-based initial meld requirement (most commonly 51 points). It is known for its fast 'tacking' gameplay and the high value placed on Jokers, which can be 'stolen' from existing melds on the table."
            },
            {
              "type": "paragraph",
              "text": "Believed to have roots in the Jewish communities of London and New York in the mid-20th century. It shares ancestry with games like Vatikan and Rummy 51."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 4 players is optimal."
            },
            {
              "type": "paragraph",
              "text": "106 cards (2 standard decks + 2 Jokers)."
            },
            {
              "type": "paragraph",
              "text": "106 cards, score sheet, chips for stakes (optional)"
            },
            {
              "type": "paragraph",
              "text": "Deal 13 cards to each player. One card is turned up to start the discard pile."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Kalooki 40: Smaller opening requirement (40 pts)."
                },
                {
                  "text": "Kalooki 51: Standard British/European tournament rules."
                },
                {
                  "text": "Vatikan: A related European game with more complex melding rules."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
