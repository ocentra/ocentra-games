  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Four Card Brag",
          "subtitle": "The Strategic Vyer",
          "content": [
            {
              "type": "paragraph",
              "text": "Four Card Brag is the four-card variation of Three Card Brag: each player is dealt four cards, discards one face down, and plays the best three-card Brag hand, with the discard used only to break exact ties."
            },
            {
              "type": "paragraph",
              "text": "4-Card Brag developed as a popular regional variant in the UK, designed to provide more player agency than the strictly deterministic deal of 3-Card Brag. It is particularly common in casual pub games where players want slightly 'bigger' hands to play with."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Typically 3 to 8 players playing individually."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card French pack (No Jokers)."
            },
            {
              "type": "paragraph",
              "text": "Standard pack, betting chips or currency."
            },
            {
              "type": "paragraph",
              "text": "Deal four cards face-down to each player. Players choose three to keep and place the fourth face-down in a shared muck pile."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "5-Card Brag: Players receive five cards and choose three, leading to even stronger average hands."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
