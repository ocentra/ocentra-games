      "pages": [
        {
          "title": "Cau Robat",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Cau Robat is a children's fishing game from Catalonia, Spain. Played with a Spanish 40-card deck. Features unique 'Cau' calls and capture of sequences. Somewhat similar to Ronda but with less scope for skill."
            },
            {
              "type": "paragraph",
              "text": "Cau Robat is a traditional children's fishing game from Catalonia, the northeast region of Spain. It was documented by Enric Capo. The game is somewhat similar to Ronda (played in Morocco) but with less emphasis on skill."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-5 players (usual number), any number can play."
            },
            {
              "type": "paragraph",
              "text": "Standard Spanish 40-card deck: four suits (swords, cups, coins, clubs), ranks 1-7 and 10-12 (Sota/Valet=10, Cavall/Horse=11, Rei/King=12). Only ranks matter."
            },
            {
              "type": "paragraph",
              "text": "Spanish deck"
            },
            {
              "type": "paragraph",
              "text": "Standard dealing for fishing games."
            }
          ]
        }
      ]
    }
  ]
