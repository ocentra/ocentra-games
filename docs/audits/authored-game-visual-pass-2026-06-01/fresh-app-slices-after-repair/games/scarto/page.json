      "pages": [
        {
          "title": "Scarto",
          "subtitle": "Tarot trick-taking game",
          "content": [
            {
              "type": "paragraph",
              "text": "Scarto is a Piedmontese tarot trick-taking game from northwestern Italy. It is played with the full 78-card Tarocco Piemontese family and emphasizes careful discard, trump timing, and partnership coordination over multiple deals."
            },
            {
              "type": "paragraph",
              "text": "Scarto belongs to the northern Italian tarocchi tradition and is associated with Piedmontese tarot practice."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Four players in fixed partnerships, partners seated opposite."
            },
            {
              "type": "paragraph",
              "text": "A full 78-card Tarocco Piemontese deck with trumps, fool, and four Italian-suited series."
            },
            {
              "type": "paragraph",
              "text": "Tarocco Piemontese deck and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt to all players and play proceeds by tricks according to local tarocchi order and obligations."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Regional scoring: Local clubs may use different bonus and counting conventions."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
