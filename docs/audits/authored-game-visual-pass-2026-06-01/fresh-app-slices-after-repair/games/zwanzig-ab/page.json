  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Zwanzig ab",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Zwanzig ab ('Twenty Off') is a German trick game. 2-4 players. 32-card Skat deck. 5 each (2+3). Start at 20pts, subtract 1 per trick won. First to 0 wins. Forehand chooses trumps. Can exchange up to 3 cards. May drop out (except trump chooser). Hearts trumps = double scoring."
            },
            {
              "type": "paragraph",
              "text": "Zwanzig ab (Twenty Off) is a traditional German trick-taking game in the Rams group, played with a 32-card Skat pack. English-language rules trace to Ralf Brostedt's page; the game uses count-down scoring from 20 to zero and is popular in Germany."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "32 Skat cards. A-10-K-Q-J-9-8-7."
            },
            {
              "type": "paragraph",
              "text": "Cards"
            },
            {
              "type": "paragraph",
              "text": "5 each (2 then 3). Forehand picks trump from first 2."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Jass trump order: Some play with trump rank order J-9-A-10-K-Q-8-7 (Jass style) but A-10-K-Q-J-9-8-7 in plain suits."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
