      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "American Toad",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "American Toad is a two-deck patience game related to Canfield, using a reserve, tableau, waste, and foundations that begin from a dealt base rank."
            },
            {
              "type": "paragraph",
              "text": "American Toad is an American solitaire form in the Canfield family, extending that reserve-and-foundation pattern to a larger two-deck layout."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One player manages reserve, tableau, stock, waste, and foundations."
            },
            {
              "type": "paragraph",
              "text": "Use two shuffled standard packs."
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal the reserve and tableau, turn a base card to determine the foundation rank, and place the rest as stock."
            }
          ]
        }
      ]
    }
  ]
