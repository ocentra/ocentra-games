        {
          "title": "Babette",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "Babette is a two-deck solitaire with play similar to Labyrinth, using stock and foundation movement to clear a combined 104-card pack."
            },
            {
              "type": "paragraph",
              "text": "Babette is preserved as a named two-pack patience game in solitaire collections, notable for its relationship to the Labyrinth style of foundation play."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One player arranges the two-deck solitaire layout."
            },
            {
              "type": "paragraph",
              "text": "Use two shuffled standard decks."
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal the prescribed Babette layout and keep the undealt cards as stock for waste play."
            }
          ]
        }
      ]
    }
  ]
