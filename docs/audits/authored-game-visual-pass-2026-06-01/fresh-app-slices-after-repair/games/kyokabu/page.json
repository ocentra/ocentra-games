      "pages": [
        {
          "title": "Kyokabu",
          "subtitle": "Austrian tarock game",
          "content": [
            {
              "type": "paragraph",
              "text": "Kyokabu is a traditional Japanese kabufuda gambling-card game played with the 40-card Kabufuda family, emphasizing value totals and betting decisions."
            },
            {
              "type": "paragraph",
              "text": "Doppen appears in Austrian tarock references as a real regional tarock game in the broader Industrie und Glück branch."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Multiple players with rotating banker depending on local house rules."
            },
            {
              "type": "paragraph",
              "text": "54-card Industrie und Glück pack with 22 permanent trumps and 32 suited cards."
            },
            {
              "type": "paragraph",
              "text": "Tarock deck and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt with a talon packet according to local Doppen dealing conventions before contract decisions."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Local contract scale: Some groups use slightly different contract ladders and values."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
