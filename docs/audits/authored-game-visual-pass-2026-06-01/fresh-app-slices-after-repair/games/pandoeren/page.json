  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Pandoeren",
          "subtitle": "Dutch Jass",
          "content": [
            {
              "type": "paragraph",
              "text": "Pandoeren is a Dutch trick-taking Jass game for four with variable partnerships and a wide choice of contracts. A 33-card pack is used. Declarer bids a contract (points, piccolo, misère, solo, etc.) and calls a partner via an ace or king."
            },
            {
              "type": "paragraph",
              "text": "Pandoeren is a Dutch trick-taking game in the Jass (Ace-Ten) family. It used to be popular across the Netherlands and is still much played in Heerlen in the south. It shows resemblance to solo whist and klaverjas. Regional variants such as West Friesland and Tachtigen (University of Amsterdam) have different bids and scoring."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "33 cards: A-K-Q-J-10-9-8-7 in four suits + 6♥."
            },
            {
              "type": "paragraph",
              "text": "33-card pack. Forehand starts bidding."
            },
            {
              "type": "paragraph",
              "text": "4 each, 1 face-up in center, 4 each. Declarer picks up center card and discards one."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "West Friesland: West Friesland version with different bids and scoring; rules exist in Dutch and in English translation."
                },
                {
                  "text": "Tachtigen: University of Amsterdam variant. Different contracts."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
