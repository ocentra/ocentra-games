  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "All for One and One for All Poker",
          "subtitle": "The Musketeer Draw",
          "content": [
            {
              "type": "paragraph",
              "text": "All for One and One for All is a high-churn variant of Five-Card Draw. Unlike standard poker where you draw once, here players can repeatedly exchange their entire hand or a single card through multiple rounds of betting until the deck is nearly exhausted."
            },
            {
              "type": "paragraph",
              "text": "A relatively modern home-game variant of Five-Card Draw. Its name is a playful reference to the Three Musketeers, echoing the 'One card or All cards' binary choice of the discard phase."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 6 players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52 cards."
            },
            {
              "type": "paragraph",
              "text": "Poker chips, standard deck."
            },
            {
              "type": "paragraph",
              "text": "Each player is dealt 5 cards face-down. Antes are placed."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Musketeer Wilds: Deuces/Jacks are wild to increase the power level of the multiple draws."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
