        {
          "title": "Brede Mette",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Brede Mette is a Danish card game from Funen for two or more players, using a standard pack without jokers and a trump ace as the highest card."
            },
            {
              "type": "paragraph",
              "text": "A Danish regional game played since at least the mid twentieth century and reminiscent of Rakker."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 or more players use the table arrangement described for Brede Mette."
            },
            {
              "type": "paragraph",
              "text": "52-card Danish pattern pack without jokers"
            },
            {
              "type": "paragraph",
              "text": "52-card Danish pattern pack without jokers, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Remove jokers from a 52-card pack and deal according to the number of players."
            }
          ]
        }
      ]
    }
  ]
