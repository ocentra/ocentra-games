    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "20 dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "20 dominoes can refer to domino games played with a 20-tile set or scoring to 20. When played as a Blackjack-style game, it is similar to Twenty-One dominoes: players draw tiles aiming for a total of 20 or 21 without busting, with a banker."
            },
            {
              "type": "paragraph",
              "text": "Domino banking game; aim for 20 or 21 (like blackjack) vs banker. Tiles drawn, pip total; blank often 0 or 7. Payout may multiply by tiles in hand (e.g. squared)."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Double-six domino set (28 tiles)"
            },
            {
              "type": "paragraph",
              "text": "Double-six domino set, chips or stakes"
            },
            {
              "type": "paragraph",
              "text": "Banker chosen (e.g. by drawing highest tile). Players buy tiles from the banker for a stake; max nine tiles per hand."
            }
          ]
        }
      ]
    }
  ]
