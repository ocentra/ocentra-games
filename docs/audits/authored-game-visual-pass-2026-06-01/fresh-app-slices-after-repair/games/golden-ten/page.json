  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Golden Ten",
          "subtitle": "Rook Reverse Trick Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Golden Ten is a reverse trick-taking game using a 56-card Rook deck: players avoid red-card penalties while trying to capture the yellow ten bonus card."
            },
            {
              "type": "paragraph",
              "text": "Golden Ten is a Hearts-like reverse game adapted to the color-and-rank structure of Rook cards."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-7 players, clockwise deal and play."
            },
            {
              "type": "paragraph",
              "text": "56 cards: four colors (red, yellow, green, black), ranks 1 through 14."
            },
            {
              "type": "paragraph",
              "text": "Scorepad for cumulative penalty totals across six deals."
            },
            {
              "type": "paragraph",
              "text": "Deal all cards as equally as possible; with 3, 5, or 6 players, leftovers are won by winner of first trick."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Fixed Six Deals: Standard session consists of exactly six deals and lowest cumulative penalty wins."
                },
                {
                  "text": "Long Session Target: Alternative table rule continues beyond six deals to an agreed round limit."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
