        {
          "title": "Credo",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Credo is a commercial strategy card game about duelling dogmas, with players using cards to contest religious and doctrinal influence."
            },
            {
              "type": "paragraph",
              "text": "Published by Chaosium in 1993, Credo was designed by Chris Gidlow as a satirical strategy card game with proprietary card effects and theme."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-5 players use the table arrangement described for Credo."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Credo strategy card deck"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Credo strategy card deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Players receive hands from the dedicated deck and play cards into doctrinal or influence contests."
            }
          ]
        }
      ]
    }
