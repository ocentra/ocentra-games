        {
          "title": "Bohnanza",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Bohnanza is a commercial trading card game where players plant, trade, and harvest bean cards for coins while hand order is restricted."
            },
            {
              "type": "paragraph",
              "text": "Designed by Uwe Rosenberg and first published in 1997, Bohnanza became a modern classic built around negotiation and forced hand-order management."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-7 players use the table arrangement described for Bohnanza."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Bohnanza bean deck"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Bohnanza bean deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal each player a hand that must keep its order; prepare bean fields and the draw deck."
            }
          ]
        }
      ]
    }
  ]
