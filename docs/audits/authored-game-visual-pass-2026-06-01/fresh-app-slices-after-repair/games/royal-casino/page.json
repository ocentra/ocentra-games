  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Royal Casino",
          "subtitle": "Casino with Court Values",
          "content": [
            {
              "type": "paragraph",
              "text": "Royal Casino is Casino with picture cards having numerical values: Jacks 11, Queens 12, Kings 13, Aces 1 or 14. Players capture cards from a layout by matching number or sum. Dominican version: 4 cards each, 4 face up on table; capture, build, or trail. Target 21. Counter-clockwise."
            },
            {
              "type": "paragraph",
              "text": "Casino variant. Royal Casino = Casino with court values. Dominican, Haitian, Tuxedo, Hungarian variants."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 (4 in partnerships)."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card pack (French suits). In Royal Casino the court cards have numerical capture values: Jacks 11, Queens 12, Kings 13; number cards use face value; Aces count as 1 or 14 at the player's choice. The same deck is used for capture, building, and trailing as in Casino."
            },
            {
              "type": "paragraph",
              "text": "Standard deck."
            },
            {
              "type": "paragraph",
              "text": "4 each; 4 face up on table. Deal 4 more when hands empty."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Dominican: Target 21."
                },
                {
                  "text": "Tuxedo: North American variant."
                },
                {
                  "text": "Hungarian: Hungarian Casino."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
