          "title": "Brelan",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Brelan is a historical French vying game for three to five players using a 28-card pack and escalating bets around matched cards."
            },
            {
              "type": "paragraph",
              "text": "A prominent French betting game from the seventeenth to nineteenth centuries; the name also came to mean a card player or gambling room."
            }
          ]
        },
