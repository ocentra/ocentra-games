      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Five Card Stud High-Low",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Five Card Stud with pot split between best high hand and best qualifying low hand."
            },
            {
              "type": "paragraph",
              "text": "Stud poker first appeared in America as early as the 1860s; five card stud was the earliest stud form. Five Card Stud High-Low is a split-pot variant: the pot is divided between the best high hand and the best qualifying low hand, with declaration (high or low) after the final betting round in home games."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 10 players"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck"
            },
            {
              "type": "paragraph",
              "text": "Chips"
            },
            {
              "type": "paragraph",
              "text": "Each player receives one card face down (hole card) and one face up, then three more cards face up, one at a time, with a betting round after each round of cards."
            }
          ]
        }
      ]
    }
  ]
