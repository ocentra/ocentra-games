      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Don Irish",
          "subtitle": "Trick-taking rules and play flow",
          "content": [
            {
              "type": "paragraph",
              "text": "Don Irish (also known simply as Don in Ireland) is a point-trick game for four players in fixed partnerships. It is a descendant of the 17th-century game All Fours and is closely related to Dom Pedro. The game focuses on capturing specific high-value scoring cards, particularly the 'Pedros' (fives) and the nines."
            },
            {
              "type": "paragraph",
              "text": "Don is derived from the older game Dom Pedro, which was popular in Ireland and America in the 19th century. In Ireland, the name was shortened to 'Don'."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players in fixed partnerships (2 vs 2)."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "52-card deck, peg board (recommended for scoring)."
            },
            {
              "type": "paragraph",
              "text": "Dealer deals all 52 cards (13 to each player) in batches of 3 or 4."
            }
          ]
        }
      ]
    }
  ]
