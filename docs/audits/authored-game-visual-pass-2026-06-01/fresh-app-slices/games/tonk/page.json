  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Tonk",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Tonk (or Tunk) is a fast-paced matching card game popular in the USA. It combines features of Rummy and 'Knock' games (like Gin). Players aim to form spreads (books/runs) or 'Drop' (knock) with a low point count."
            },
            {
              "type": "paragraph",
              "text": "Popularized in the mid-20th century, particularly in African American communities and jazz culture."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card. Face=10, A=1, Num=Value."
            },
            {
              "type": "paragraph",
              "text": "Cards, chips"
            },
            {
              "type": "paragraph",
              "text": "Deal 5 (or 7) cards to each."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Deal size: Five, seven, or nine cards dealt depending on number of players."
                },
                {
                  "text": "House rules: Instant win at 49/50, high or low count, only runs as spreads, and other common house rules."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
