      "pages": [
        {
          "title": "28-91 dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "28-91 dominoes refers to block or draw domino games played with sets of 28 tiles (double-6) up to 91 tiles (double-12). Same core rules: match numbers on open ends, doubles crosswise, first out or lowest pips if blocked. Set size and player count vary."
            },
            {
              "type": "paragraph",
              "text": "Block/draw dominoes with set sizes from 28 (double-6) to 91 (double-12). Same core rules; larger sets allow more players or longer games."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-6 (depending on set size)"
            },
            {
              "type": "paragraph",
              "text": "Double-6 (28), double-9 (55), or double-12 (91) domino set"
            },
            {
              "type": "paragraph",
              "text": "Domino set, table"
            },
            {
              "type": "paragraph",
              "text": "Draw tiles (number per player depends on set size); remainder boneyard in draw variant."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Double-9 Set: Played with a double-9 domino set (55 tiles) for 4-6 players."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
