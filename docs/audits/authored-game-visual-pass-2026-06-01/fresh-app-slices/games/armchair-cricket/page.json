      "pages": [
        {
          "title": "Armchair Cricket",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Armchair Cricket is a commercial cricket simulation card game using a dedicated 110-card pack where bowling and batting cards determine runs, wickets, and extras."
            },
            {
              "type": "paragraph",
              "text": "Armchair Cricket was produced commercially in England as a card simulation of cricket, with short Quicket rules and longer limited-over or full-cricket versions."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two players represent bowler and batsman, or four players can play team versions."
            },
            {
              "type": "paragraph",
              "text": "Use two identical 55-card decks with five cricket-equipment suits numbered 1 to 11."
            },
            {
              "type": "paragraph",
              "text": "Dedicated 110-card cricket deck with five suits numbered 1 to 11, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal hidden hands to the batting and bowling sides according to the selected cricket format."
            }
          ]
        }
      ]
    }
  ]
