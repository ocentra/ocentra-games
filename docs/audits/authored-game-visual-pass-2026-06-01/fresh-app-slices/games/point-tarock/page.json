      "pages": [
        {
          "title": "Point Tarock",
          "subtitle": "Austrian tarock game",
          "content": [
            {
              "type": "paragraph",
              "text": "Point Tarock is a three-player Austrian tarock game in the Industrie und Glueck family. It is closely related to Tapp Tarock but adds announcement and scoring emphasis around point capture and contract value."
            },
            {
              "type": "paragraph",
              "text": "Point Tarock appears in tarot-family references as a regional tarock game in the broader Industrie und Glueck tradition."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Three players compete as declarer against two defenders each deal."
            },
            {
              "type": "paragraph",
              "text": "54-card Industrie und Glück pack with 22 permanent trumps and 32 suited cards."
            },
            {
              "type": "paragraph",
              "text": "Tarock deck and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt with a talon packet according to local rules before contract decisions and trick play."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Point Tarock local contract scale: Some groups use slightly different contract ladders and values."
                }
              ]
            }
          ]
        }
      ]
    }
