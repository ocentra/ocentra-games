        {
          "title": "Chlust",
          "subtitle": "Gambling",
          "content": [
            {
              "type": "paragraph",
              "text": "Chlust is a Polish gambling card game from Upper Silesia that combines quick trick play with high-chance betting outcomes."
            },
            {
              "type": "paragraph",
              "text": "Chlust is primarily known in Upper Silesia and has alternate local names. It is related to Tryszak and Zwikken and uses a very short hand with gambling stakes."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Chlust."
            },
            {
              "type": "paragraph",
              "text": "20 or 24-card French-suited pack"
            },
            {
              "type": "paragraph",
              "text": "20 or 24-card French-suited pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Use a 20 or 24-card pack and deal the short hand required by the local stake rules."
            }
          ]
        }
      ]
    }
