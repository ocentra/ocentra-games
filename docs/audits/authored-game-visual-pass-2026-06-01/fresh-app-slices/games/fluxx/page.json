      "pages": [
        {
          "title": "Fluxx",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Fluxx is a commercial Looney Labs card game where the rules, hand limits, play counts, and win condition change during play."
            },
            {
              "type": "paragraph",
              "text": "Fluxx was published by Looney Labs and became known for its rule-changing structure, with many themed editions using the same core mechanism of mutable goals and rules."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-6 players use the table arrangement described for Fluxx."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Fluxx keeper, goal, rule, action, and new-rule cards"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Fluxx keeper, goal, rule, action, and new-rule cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Fluxx deck and any shared scoring, resource, or tableau area described by the rules."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Oz Fluxx: Commercial Oz-themed Fluxx version using the same changing-rule Fluxx structure with Land of Oz theming."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
