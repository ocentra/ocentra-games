  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Perevodnoy Durak",
          "subtitle": "Transfer Fool",
          "content": [
            {
              "type": "paragraph",
              "text": "Perevodnoy Durak (Transfer Fool) is a Durak variant where the defender can transfer the attack to the next player by playing a card of the same rank. Otherwise like Podkidnoy Durak: 36 cards, attack/defend, last with cards = Fool. Works well with 2 players."
            },
            {
              "type": "paragraph",
              "text": "Variant of Podkidnoy Durak. 'Perevodnoy' = transfer. Defender passes attack by matching rank."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-6. Individuals (no partnerships)."
            },
            {
              "type": "paragraph",
              "text": "36 cards. Rank A-K-Q-J-10-9-8-7-6."
            },
            {
              "type": "paragraph",
              "text": "36-card pack."
            },
            {
              "type": "paragraph",
              "text": "6 each. Turn one for trump. Stock face-down."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Kiev: After beating some cards, defender can transfer new thrown-in cards by playing equal."
                },
                {
                  "text": "Pass Card: Trump of same rank: show (don't play) to transfer; keep card."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
