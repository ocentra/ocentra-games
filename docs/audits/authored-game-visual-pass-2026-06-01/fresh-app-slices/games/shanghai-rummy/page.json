    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Shanghai Rummy",
          "subtitle": "Contract Rummy",
          "content": [
            {
              "type": "paragraph",
              "text": "Shanghai Rummy is a contract-rummy style game played across ten hands with changing meld requirements. Players draw, meld sets/runs, and try to go out while minimizing penalty points."
            },
            {
              "type": "paragraph",
              "text": "Shanghai Rummy is a contract-rummy family game also known as Shanghai Rum or California Rummy."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-8 players, usually individual play."
            },
            {
              "type": "paragraph",
              "text": "Use enough 54-card decks for table size (typically two decks for up to four players). Jokers are wild."
            },
            {
              "type": "paragraph",
              "text": "Cards, discard pile area, and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Deal 11 cards to each player each hand; remaining cards form stock with one face-up discard starter."
            }
          ]
        }
      ]
    }
  ]
