      "pages": [
        {
          "title": "Fish Pitch",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Fish Pitch is a documented card game with defined setup, turn flow, and scoring conditions."
            },
            {
              "type": "paragraph",
              "text": "Fish Pitch is a partnership Pitch variation contributed by Judd A. Schorr and documented in published card-game rules. It belongs to the Pitch/Setback family, which is North American and derived from the English game of All Fours (Seven Up). Pitch added bidding to All Fours; partnership forms became popular in the American mid-west as family or social games. Fish Pitch adds a fishing mechanic where each player has six hand cards and six face-down cards from which they may play during tricks, creating uncertainty and limiting card-counting."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Cards"
            },
            {
              "type": "paragraph",
              "text": "Each player receives six cards, dealt three at a time."
            }
          ]
        }
      ]
    }
