        {
          "title": "Gnau",
          "subtitle": "Gambling",
          "content": [
            {
              "type": "paragraph",
              "text": "Gnau, also called Ngau or Ngao, is a Malaysian five-card gambling game using standard French-suited decks and ox-point hand values."
            },
            {
              "type": "paragraph",
              "text": "Gnau originated in Malaysia and can be played casually or as a gambling game. Each player receives five cards with no discards or redraws, and larger groups can add extra decks."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 or more players use the table arrangement described for Gnau."
            },
            {
              "type": "paragraph",
              "text": "One or more 52-card French-suited decks"
            },
            {
              "type": "paragraph",
              "text": "One or more 52-card French-suited decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal five cards to every player from one or more standard decks; no redraws or discards are used."
            }
          ]
        }
      ]
    }
  ]
