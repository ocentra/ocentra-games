      "pages": [
        {
          "title": "Apples to Apples",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Apples to Apples is a commercial party card game where players submit noun cards to match an adjective prompt and a rotating judge chooses the best fit."
            },
            {
              "type": "paragraph",
              "text": "Apples to Apples was designed by Mark Alan Osterhaus and became a mainstream party game through its simple judge-and-comparison format."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Four or more players sit with one rotating judge each round."
            },
            {
              "type": "paragraph",
              "text": "Use the dedicated red apple and green apple decks."
            },
            {
              "type": "paragraph",
              "text": "Dedicated red noun cards and green adjective cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal red cards to players; the judge reveals a green prompt card each round."
            }
          ]
        }
      ]
    }
  ]
