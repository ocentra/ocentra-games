        {
          "title": "Bauerchen",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Bauerchen is a Palatinate four-player trick-taking game in which the four jacks are permanent top trumps above a reduced ace-ten pack."
            },
            {
              "type": "paragraph",
              "text": "A regional German ace-ten family game also known by names such as Bauerspiel or Bauersche."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players use the table arrangement described for Bauerchen."
            },
            {
              "type": "paragraph",
              "text": "20-card French pack"
            },
            {
              "type": "paragraph",
              "text": "20-card French pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Use the reduced 20-card pack and deal the cards evenly for four players."
            }
          ]
        }
      ]
    }
