      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Aces and Kings",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "Aces and Kings is a difficult two-deck solitaire in which eight foundations build both upward from aces and downward from kings without regard to suit."
            },
            {
              "type": "paragraph",
              "text": "Aces and Kings was created by Thomas Warfield as a modern solitaire design. It became known through software and solitaire collections because its reserve structure makes it much harder than most casual packers."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One player lays out the reserve, tableau, stock, waste, and eight foundations."
            },
            {
              "type": "paragraph",
              "text": "Two shuffled standard packs are used together."
            },
            {
              "type": "paragraph",
              "text": "Two standard decks and solitaire table space."
            },
            {
              "type": "paragraph",
              "text": "Deal two reserve piles of thirteen cards, four tableau cards face up, and keep the remaining cards as stock with a waste pile."
            }
          ]
        }
      ]
    }
  ]
