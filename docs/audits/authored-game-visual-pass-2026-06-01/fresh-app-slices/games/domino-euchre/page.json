      "pages": [
        {
          "title": "Domino Euchre",
          "subtitle": "Trump Partnership Tiles",
          "content": [
            {
              "type": "paragraph",
              "text": "Domino Euchre is a trump trick-taking domino game inspired by card euchre, using a double-six set and contract-style play."
            },
            {
              "type": "paragraph",
              "text": "Domino Euchre developed as a tile adaptation of euchre-style trick taking, preserving trump and contract ideas in domino form."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Four players in fixed partnerships."
            },
            {
              "type": "paragraph",
              "text": "Standard double-six dominoes (28 tiles)."
            },
            {
              "type": "paragraph",
              "text": "Domino set and score sheet."
            },
            {
              "type": "paragraph",
              "text": "All tiles are shuffled face-down and dealt evenly; bidding determines trump and contract."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Short Game: Play to 7 points instead of 10."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
