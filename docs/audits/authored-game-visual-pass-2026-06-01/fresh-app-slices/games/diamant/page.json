      "pages": [
        {
          "title": "Diamant",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Diamant, also known as Incan Gold, is a commercial push-your-luck card-driven game where players enter caves for gems and decide when to leave."
            },
            {
              "type": "paragraph",
              "text": "Designed by Alan R. Moon and Bruno Faidutti, Diamant uses card reveals to create a shared risk path where players split treasure or flee before repeated hazards strike."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-8 players use the table arrangement described for Diamant."
            },
            {
              "type": "paragraph",
              "text": "Dedicated cave, treasure, and hazard cards with gem tokens"
            },
            {
              "type": "paragraph",
              "text": "Dedicated cave, treasure, and hazard cards with gem tokens, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the cave deck and gem pool; each expedition reveals cards from the deck one at a time."
            }
          ]
        }
      ]
    }
  ]
