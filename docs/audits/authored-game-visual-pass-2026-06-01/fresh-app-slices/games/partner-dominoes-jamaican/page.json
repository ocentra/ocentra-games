        {
          "title": "Partner Dominoes Jamaican",
          "subtitle": "Caribbean Partnership Dominoes",
          "content": [
            {
              "type": "paragraph",
              "text": "Jamaican Partner Dominoes is the Jamaican variant of Latin Partnership Dominoes. Four players in partnerships, double-six set, all tiles dealt. Same base rules as Partnership Dominoes with Jamaican/ Caribbean conventions."
            },
            {
              "type": "paragraph",
              "text": "Caribbean variant of Latin Partnership Dominoes. Jamaica and Puerto Rico (Chiva) have regional rules."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 in fixed partnerships. Partners sit opposite."
            },
            {
              "type": "paragraph",
              "text": "Double-six set, 28 tiles."
            },
            {
              "type": "paragraph",
              "text": "28 double-six tiles."
            },
            {
              "type": "paragraph",
              "text": "All tiles dealt; 7 each."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Caribbean Conventions: Jamaican and Puerto Rican (Chiva) differ in who starts the next hand and tie-breaking in blocked hands; see primary sources for regional details."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
