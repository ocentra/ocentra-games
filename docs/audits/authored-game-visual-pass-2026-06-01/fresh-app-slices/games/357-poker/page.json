        {
          "title": "3 5 7 Poker",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Three-stage Guts variant: stage one 3 cards (threes wild), stage two 5 cards (fives wild), stage three 7 cards (sevens wild). At each stage players declare in or out; only player in scores a leg; multiple in then best hand wins and losers match the pot. First to three legs wins the pot."
            },
            {
              "type": "paragraph",
              "text": "Guts-style poker variant from the United States where 3-5-7 cards are dealt with corresponding wild cards in each round."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card pack without jokers; the same deck as base Guts is used for all three stages (3, 5, and 7 cards)."
            },
            {
              "type": "paragraph",
              "text": "Cards"
            },
            {
              "type": "paragraph",
              "text": "3 then 2 then 2"
            }
          ]
        }
      ]
    }
  ]
