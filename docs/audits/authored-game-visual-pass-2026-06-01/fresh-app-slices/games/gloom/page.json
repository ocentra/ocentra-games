          "title": "Gloom",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Gloom is a commercial storytelling card game where players make their own family miserable while improving opponents before deaths are scored."
            },
            {
              "type": "paragraph",
              "text": "Designed by Keith Baker and published by Atlas Games in 2004, Gloom is known for transparent cards and dark comic storytelling attached to score modifiers."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 basic deck players use the table arrangement described for Gloom."
            },
            {
              "type": "paragraph",
              "text": "Dedicated transparent Gloom family and modifier cards"
            },
            {
              "type": "paragraph",
              "text": "Dedicated transparent Gloom family and modifier cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Gloom deck and any shared scoring, resource, or tableau area described by the rules."
            }
          ]
        }
      ]
