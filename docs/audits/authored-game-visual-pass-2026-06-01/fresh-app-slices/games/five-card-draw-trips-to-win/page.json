  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Trips to Win (5 Card Draw)",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Trips to Win: Five Card Draw variant. To win at showdown you must hold at least three of a kind (trips). Otherwise the hand is a push and the pot carries over."
            },
            {
              "type": "paragraph",
              "text": "Trips to Win is a qualifier variant of Five Card Draw Jacks or Better that requires at least three of a kind to win the pot, reducing bluffing and ensuring the winner has a real hand. It shares the same American draw-poker lineage as Five Card Draw and Jacks or Better and is a standard home and dealer's choice variant."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two to six players; six is recommended for the best game. More than six risks running out of cards during the draw."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card pack; one full deck, no jokers. Same as base Five Card Draw."
            },
            {
              "type": "paragraph",
              "text": "Chips."
            },
            {
              "type": "paragraph",
              "text": "5 cards each; standard draw."
            }
          ]
        }
      ]
    }
  ]
