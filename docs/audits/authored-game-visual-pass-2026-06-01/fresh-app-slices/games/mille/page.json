        {
          "title": "Mille",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Mille is a two-player rummy game from Canada using two standard decks, with canasta-like discard-pile pickup and same-rank melds."
            },
            {
              "type": "paragraph",
              "text": "Mille is said to have been devised in Montreal and brought to Toronto in the 1990s, where it became increasingly popular."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 players use the table arrangement described for Mille."
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks"
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Two standard 52-card decks and deal or lay out cards according to the documented Mille rules before play begins."
            }
          ]
        }
      ]
    }
  ]
