      "pages": [
        {
          "title": "Umtali",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Umtali is a 2-player Rummy game from Rhodesia (now Zimbabwe). 10 cards each. Features 5 meld types: sets (no Jacks), runs, marriages (K+Q same suit for double), single Jacks, and single-card extensions. Opponent gets one final turn after someone goes out. Two-card melds allowed in final turn."
            },
            {
              "type": "paragraph",
              "text": "Umtali is a Rhodesian (now Zimbabwean) rummy game. It was popular on train journeys in colonial Rhodesia. The name comes from Umtali, a market town on the Salisbury-Beira railway line; it is described as an unusual rummy game from that tradition."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "52 cards. A is low."
            },
            {
              "type": "paragraph",
              "text": "Cards, scoresheet"
            },
            {
              "type": "paragraph",
              "text": "10 each (or 11 to non-dealer). Top of stock starts discard."
            }
          ]
        }
      ]
