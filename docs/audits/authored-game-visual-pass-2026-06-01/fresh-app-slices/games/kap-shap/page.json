      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "K'ap Shap",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "K'ap Shap is the two-player form of the Chinese domino draw-and-discard game K'ap T?i Shap. The aim is to complete a hand with one identical pair and three pairs whose spots total 10 or 20."
            },
            {
              "type": "paragraph",
              "text": "Originating in Southern China (Cantonese culture), K'ap Shap is one of the most popular social domino games. It occupies a similar cultural space to Gin Rummy in the West."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-20 players (larger groups use more sets)."
            },
            {
              "type": "paragraph",
              "text": "32 Chinese domino tiles (Civil and Military pairs)."
            },
            {
              "type": "paragraph",
              "text": "32 Chinese domino tiles (Civil and Military pairs)."
            },
            {
              "type": "paragraph",
              "text": "First player gets 10 tiles, others get 9. Tiles are shuffled face-down and stacked in a wall."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "K'ap Shap (two-player): Two-player variant: single set of 32 tiles, wall four high and eight wide. First player takes 8 tiles, second takes 7. Winning hand: one identical pair (eye) plus three pairs summing to 10 or 20 (not four pairs)."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
