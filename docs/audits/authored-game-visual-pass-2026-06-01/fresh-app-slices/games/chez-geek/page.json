        {
          "title": "Chez Geek",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Chez Geek is a commercial card game where roommates use job, people, thing, and activity cards to gain the most Slack."
            },
            {
              "type": "paragraph",
              "text": "Published by Steve Jackson Games, Chez Geek turns roommate life into a humorous card game built around invitations, shopping, activities, and Slack scoring."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-5 players use the table arrangement described for Chez Geek."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Chez Geek deck"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Chez Geek deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal job and hand cards from the dedicated deck; each player tracks Slack and free time or income from their job."
            }
          ]
        }
      ]
    }
  ]
