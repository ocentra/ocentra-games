        {
          "title": "Arkham Horror The Card Game",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Arkham Horror The Card Game is a cooperative commercial living card game where investigators use custom decks to resolve narrative horror scenarios."
            },
            {
              "type": "paragraph",
              "text": "Arkham Horror The Card Game was released by Fantasy Flight Games as a cooperative Lovecraftian living card game with campaign progression."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One to four investigators each use a deck and character setup."
            },
            {
              "type": "paragraph",
              "text": "Use investigator decks, encounter decks, agenda cards, act cards, locations, and tokens from the commercial set."
            },
            {
              "type": "paragraph",
              "text": "Commercial living card game investigator decks and scenario decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the scenario, shuffle encounter and player decks, draw opening hands, and place starting locations."
            }
          ]
        }
      ]
    }
  ]
