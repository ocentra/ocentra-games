        {
          "title": "Le Her",
          "subtitle": "Gambling",
          "content": [
            {
              "type": "paragraph",
              "text": "Le Her is a French two-player gambling card game from the sixteenth century, belonging to the Ranter-Go-Round or Cuckoo family."
            },
            {
              "type": "paragraph",
              "text": "Le Her, also called le here, dates back to the sixteenth century and appears in early French literary references. It is part of the same exchange-and-avoidance family as Coucou and Ranter-Go-Round."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 players use the table arrangement described for Le Her."
            },
            {
              "type": "paragraph",
              "text": "52-card standard pack"
            },
            {
              "type": "paragraph",
              "text": "52-card standard pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "One player is dealer and one is non-dealer; cards are dealt for the exchange and comparison sequence."
            }
          ]
        }
      ]
    }
  ]
