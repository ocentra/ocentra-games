          "title": "Four Color Cards",
          "subtitle": "Matching",
          "content": [
            {
              "type": "paragraph",
              "text": "Four Color Cards is an East Asian matching game using a 112-card deck derived from Chinese chess symbols."
            },
            {
              "type": "paragraph",
              "text": "Four Color Cards is played in Chinese-speaking regions, especially Taiwan, using four colour suits of Chinese chess-style cards and matching or grouping rules related to Conquian-style play."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4, with 2-3 variants players use the table arrangement described for Four Color Cards."
            },
            {
              "type": "paragraph",
              "text": "112-card four color Chinese chess card set"
            },
            {
              "type": "paragraph",
              "text": "112-card four color Chinese chess card set, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Four Color Cards deck and any shared scoring, resource, or tableau area described by the rules."
            }
          ]
        }
