          "title": "American Mahjong",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "American Mahjong is a North American Mahjong variant with a card-defined hand system and joker usage. It uses an expanded tile set compared with classical Chinese variants and emphasizes matching published hand patterns over unrestricted fan construction."
            },
            {
              "type": "paragraph",
              "text": "American Mahjong developed in the United States as a structured variant with annual hand-card systems and joker rules."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players seated by wind position."
            },
            {
              "type": "paragraph",
              "text": "American Mahjong tile set including jokers and bonus tiles."
            },
            {
              "type": "paragraph",
              "text": "Mahjong set, annual hand card, dice, and table accessories."
            },
            {
              "type": "paragraph",
              "text": "Players receive 13 tiles; dealer begins with 14 and discards first after initial exchange sequence."
            }
          ]
        }
      ]
