      "pages": [
        {
          "title": "Chiva",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Chiva: Caribbean domino game (e.g. Puerto Rico). Four players in fixed partnerships; double-6 set. Play by matching ends; doubles crosswise. Team wins by scoring 4 or 6 times in a row (characteristic Caribbean style)."
            },
            {
              "type": "paragraph",
              "text": "Caribbean (e.g. Jamaica, Puerto Rico). Partnership dominoes; objective to win several rounds in a row (e.g. 4 or 6). Double-6 set; holder of double-six poses first; play anticlockwise."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4; fixed partnerships, partners opposite. Play anticlockwise."
            },
            {
              "type": "paragraph",
              "text": "Double-6 set (28 tiles)."
            },
            {
              "type": "paragraph",
              "text": "Double-6 domino set; table."
            },
            {
              "type": "paragraph",
              "text": "Each player draws 7 bones. Holder of double-six poses first (or winner of previous hand); doubles played crosswise."
            }
          ]
        }
      ]
    }
  ]
