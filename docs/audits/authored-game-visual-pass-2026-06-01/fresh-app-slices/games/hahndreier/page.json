        {
          "title": "Hahndreier",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Hahndreier, also called Hanrei and many regional spellings, is an eighteenth-century Danish and north German children's and family shedding game."
            },
            {
              "type": "paragraph",
              "text": "The game is recorded from the eighteenth century and remained known across northern Germany and Denmark, with numerous regional names and variants."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Hahndreier."
            },
            {
              "type": "paragraph",
              "text": "36-card French-suited pack"
            },
            {
              "type": "paragraph",
              "text": "36-card French-suited pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare 36-card French-suited pack and deal or lay out cards according to the documented Hahndreier rules before play begins."
            }
          ]
        }
      ]
    }
  ]
