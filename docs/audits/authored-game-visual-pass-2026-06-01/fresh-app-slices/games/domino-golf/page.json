      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Domino Golf",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Domino Golf is a western domino game played on a larger set where players use standard matching placements while trying to optimize scoring outcomes over multiple hands, analogous to minimizing a golf score."
            },
            {
              "type": "paragraph",
              "text": "The game is encountered as a modern scoring-focused domino format that uses the larger tile set to support longer and more varied hand outcomes."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 8 players."
            },
            {
              "type": "paragraph",
              "text": "One double-12 domino set."
            },
            {
              "type": "paragraph",
              "text": "Domino set and score tracking for golf-style match play."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles by player count; remaining tiles may form a boneyard by table profile."
            }
          ]
        }
      ]
    }
  ]
