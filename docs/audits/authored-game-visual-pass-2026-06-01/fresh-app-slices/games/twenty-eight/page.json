          "title": "Twenty-Eight",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Twenty-Eight is a South Asian point-trick card game for four players in partnerships, related to the Jass family and played with a 32-card pack."
            },
            {
              "type": "paragraph",
              "text": "Twenty-Eight is widely played in India and nearby regions as a partnership trick-taking game with bidding, trump, and Jass-style card values."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players use the table arrangement described for Twenty-Eight."
            },
            {
              "type": "paragraph",
              "text": "32-card pack, usually 7 through Ace in each suit"
            },
            {
              "type": "paragraph",
              "text": "32-card pack, usually 7 through Ace in each suit, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare 32-card pack, usually 7 through Ace in each suit and deal or lay out cards according to the documented Twenty-Eight rules before play begins."
            }
          ]
        }
      ]
    }
