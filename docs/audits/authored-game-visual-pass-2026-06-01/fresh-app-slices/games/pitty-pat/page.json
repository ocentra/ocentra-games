      "pages": [
        {
          "title": "Pitty Pat",
          "subtitle": "Belize Rummy",
          "content": [
            {
              "type": "paragraph",
              "text": "Pitty Pat is a rummy-like game from Belize. Object: make three pairs. No melding to table; players collect pairs in hand. Draw one, discard one. First to show three pairs wins. Simple, fast."
            },
            {
              "type": "paragraph",
              "text": "Pitty Pat is the national card game of Belize. It is essentially a rummy game with a similar mechanism to Conquian: the objective is to make three pairs from a five-card hand. Full rules are documented on the Belizeans.com web site; a computer program for the game is available from Unique Games."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two to four players use a standard 52-card pack. Each player receives five cards; deal and play proceed clockwise as described in the primary sources."
            },
            {
              "type": "paragraph",
              "text": "Standard 52 cards."
            },
            {
              "type": "paragraph",
              "text": "52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Five cards each."
            }
          ]
        }
      ]
    }
  ]
