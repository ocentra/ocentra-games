          "title": "Double Canfield",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "Double Canfield is a two-deck solitaire variant of Canfield with expanded foundations and reserve pressure."
            },
            {
              "type": "paragraph",
              "text": "A doubled form of Canfield patience, increasing the foundation and reserve puzzle while preserving the Demon-family structure."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "1 players use the table arrangement described for Double Canfield."
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks"
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal a Canfield-style reserve and tableau from two decks, then set foundation base ranks from the initial card."
            }
          ]
        }
