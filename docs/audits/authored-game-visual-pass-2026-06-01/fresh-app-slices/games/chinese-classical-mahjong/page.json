        {
          "title": "Chinese Classical Mahjong",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Chinese Classical Mahjong is a traditional four-player Mahjong ruleset emphasizing classic hand structure, open information management, and fan-based scoring categories grounded in older Chinese table practice."
            },
            {
              "type": "paragraph",
              "text": "Chinese Classical Mahjong preserves rule ideas from early widespread Chinese Mahjong forms before heavy modern regional standardization."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players seated by wind position."
            },
            {
              "type": "paragraph",
              "text": "Standard Mahjong set including suited tiles, winds, dragons, and optional flowers/seasons."
            },
            {
              "type": "paragraph",
              "text": "Standard Mahjong set including suited tiles, winds, dragons, and optional flowers/seasons."
            },
            {
              "type": "paragraph",
              "text": "Each player receives 13 tiles; East starts with 14 and discards first."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
