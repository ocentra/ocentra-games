        {
          "title": "Strip Poker",
          "subtitle": "Poker",
          "content": [
            {
              "type": "paragraph",
              "text": "Poker variant where losers remove clothing. Social/stakes variant of standard poker."
            },
            {
              "type": "paragraph",
              "text": "Strip poker is a social variant of poker in which losers remove clothing; it is usually based on five-card draw. Popular in 20th-century American culture and media."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 6 players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Standard deck; chips or clothing stakes as agreed."
            },
            {
              "type": "paragraph",
              "text": "Each player is dealt five cards face down. After first betting round, each player may discard 0 to 5 cards and receive that many from the deck. Second betting round, then showdown."
            }
          ]
        }
      ]
    }
  ]
