  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "German Solo",
          "subtitle": "Ombre Family Contract Game",
          "content": [
            {
              "type": "paragraph",
              "text": "German Solo is a four-player trick-taking game from the Ombre family with contract bidding, temporary partnerships, and a fixed high-trump structure built around matadors."
            },
            {
              "type": "paragraph",
              "text": "German Solo emerged as a simplified descendant of l'Hombre and Quadrille. It later persisted mainly in regional communities in the United States."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players in the core ruleset."
            },
            {
              "type": "paragraph",
              "text": "32-card stripped pack: A, K, Q, J, 10, 9, 8, 7 in each suit."
            },
            {
              "type": "paragraph",
              "text": "Score sheet or chips for bid-value settlement."
            },
            {
              "type": "paragraph",
              "text": "Deal 8 cards to each player, commonly in a 3-2-3 or 4-2-2 pattern."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Six-Hand Solo: A faster six-player variant using card removals and five-card hands; strategy differs from core four-player form."
                },
                {
                  "text": "Macker Bonuses: Optional bonus payouts for holding first three, four, or five top matador sequence cards under contract conditions."
                },
                {
                  "text": "First and Last: Optional payout bonus for capturing first five tricks and potentially last three under eligible contracts."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
