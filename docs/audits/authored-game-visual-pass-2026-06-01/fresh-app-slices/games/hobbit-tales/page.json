          "title": "Hobbit Tales",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Hobbit Tales is a commercial storytelling card game set in Middle-earth where players build tales and interrupt each other with hazards."
            },
            {
              "type": "paragraph",
              "text": "Designed by Marco Maggi and Francesco Nepitello and published by Cubicle 7 in 2014, Hobbit Tales connects to The One Ring roleplaying line and uses story prompts with a custom die."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-5 players use the table arrangement described for Hobbit Tales."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Hobbit Tales story and hazard cards plus die"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Hobbit Tales story and hazard cards plus die, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Hobbit Tales deck and any shared scoring, resource, or tableau area described by the rules."
            }
          ]
        }
      ]
    }
