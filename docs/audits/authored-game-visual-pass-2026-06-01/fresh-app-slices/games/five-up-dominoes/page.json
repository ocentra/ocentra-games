  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Five Up Dominoes",
          "subtitle": "Domino",
          "content": [
            {
              "type": "paragraph",
              "text": "Domino game in the Fives family. All doubles are spinners. Score when layout pip total is a multiple of 5. Play to 61 points."
            },
            {
              "type": "paragraph",
              "text": "Five Up is a domino game in the Fives family. Dominic C. Armanino made it extremely popular in California and the Southwestern United States with books and tournaments."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Double-6 domino set"
            },
            {
              "type": "paragraph",
              "text": "Double-six domino set; cribbage board recommended for scoring."
            },
            {
              "type": "paragraph",
              "text": "Each player receives five tiles. The remaining tiles form the boneyard (stock)."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Armanino scoring: Winner scores opponents' total pips (rounded to nearest 5, divided by 5) at hand end. Blocked two-hand: winner scores opponents' total pips. Three-hand blocked: only lowest pip holder scores the difference. Turn to lead may rotate clockwise."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
