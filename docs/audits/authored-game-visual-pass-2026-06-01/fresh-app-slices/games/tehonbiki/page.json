        {
          "title": "Tehonbiki",
          "subtitle": "Japanese banking game",
          "content": [
            {
              "type": "paragraph",
              "text": "Tehonbiki is a traditional Japanese gambling game where players guess a hidden number chosen by the banker using specialized numbered card sets and stake tiers."
            },
            {
              "type": "paragraph",
              "text": "Tehonbiki is a traditional Japanese gambling game built around hidden-number selection, banker advantage, and rapid wager resolution using specialist numbered card packs."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One banker with multiple bettors; roles rotate by house rules."
            },
            {
              "type": "paragraph",
              "text": "A specialized Tehonbiki numbered-card set, modeled here as a 48-card family for repeated number identities and local layouts."
            },
            {
              "type": "paragraph",
              "text": "Tehonbiki cards and stake tracking or betting markers."
            },
            {
              "type": "paragraph",
              "text": "Instead of a conventional trick-taking deal, the banker prepares the concealed number choice and the table places guesses or wagers under the current house format."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Local contract scale: Some groups use slightly different contract ladders and values."
                }
              ]
            }
          ]
        }
      ]
    }
