        {
          "title": "Domizerka",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Domizerka is a western domino connecting game played by matching open ends on a shared layout and managing hand exit routes through careful pip coverage."
            },
            {
              "type": "paragraph",
              "text": "The game is encountered as a named connecting domino ruleset in modern rules references and social domino play communities."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 6 players."
            },
            {
              "type": "paragraph",
              "text": "One double-6 domino set."
            },
            {
              "type": "paragraph",
              "text": "Dominoes and table space; optional score tracking."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles by player count; remaining tiles may form a boneyard depending on table profile."
            }
          ]
        }
      ]
    }
