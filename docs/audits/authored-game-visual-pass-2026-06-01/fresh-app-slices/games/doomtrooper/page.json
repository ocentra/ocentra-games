          "title": "Doomtrooper",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Doomtrooper is an out-of-print collectible card game where players deploy warriors and resources from the Mutant Chronicles setting."
            },
            {
              "type": "paragraph",
              "text": "Designed by Bryan Winter and released in 1994, Doomtrooper is a collectible card game connected to the Mutant Chronicles universe."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 or more players use the table arrangement described for Doomtrooper."
            },
            {
              "type": "paragraph",
              "text": "Constructed Doomtrooper collectible card decks"
            },
            {
              "type": "paragraph",
              "text": "Constructed Doomtrooper collectible card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Each player uses a constructed deck and draws an opening hand, then builds forces and resources during play."
            }
          ]
        }
      ]
