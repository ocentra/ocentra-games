        {
          "title": "Rödskägg",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Rödskägg, or Redbeard, is a Swedish trick-taking game for three to seven players with declared trick goals and penalties for missed bids and ritual mistakes."
            },
            {
              "type": "paragraph",
              "text": "Rödskägg is documented in Swedish sources from the early twentieth century and is considered one of the more tactically demanding Swedish card games."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-7 players use the table arrangement described for Rödskägg."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck without Jokers"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck without Jokers, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Standard 52-card deck without Jokers and deal or lay out cards according to the documented Rödskägg rules before play begins."
            }
          ]
        }
      ]
    }
  ]
