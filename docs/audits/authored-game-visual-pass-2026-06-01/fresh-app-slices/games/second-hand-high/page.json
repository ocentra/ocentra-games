      "pages": [
        {
          "title": "Second Hand High",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Second Hand High: 7-card stud variant where at showdown the second-highest hand wins the pot. Same deal and betting as 7-card stud; if all but one player fold, the survivor wins. USA; dealer's choice."
            },
            {
              "type": "paragraph",
              "text": "American 7-card stud variant in which the second-highest hand at showdown wins the pot. Encourages staying in with second-best draws."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "A standard 52-pack is used and from 2 to 8 players can take part. The game is best for 5 to 7 players. When 8 play there is the problem that the cards may run out towards the end of the deal."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck. No jokers."
            },
            {
              "type": "paragraph",
              "text": "Chips; table space."
            },
            {
              "type": "paragraph",
              "text": "Same as 7-card stud. No wilds."
            }
          ]
        }
      ]
    }
  ]
