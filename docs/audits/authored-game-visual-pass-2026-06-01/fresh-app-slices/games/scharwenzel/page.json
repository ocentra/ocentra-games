          "title": "Scharwenzel",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Scharwenzel is a traditional north German partnership plain-trick game from the Schafkopf family, preserved on Fehmarn."
            },
            {
              "type": "paragraph",
              "text": "Scharwenzel is documented as a distinct traditional card game with its own player count, equipment, and objective."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4-8 players use the table arrangement described for Scharwenzel."
            },
            {
              "type": "paragraph",
              "text": "Traditional German or French-suited pack"
            },
            {
              "type": "paragraph",
              "text": "Traditional German or French-suited pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Traditional German or French-suited pack and deal or lay out cards according to the documented Scharwenzel rules before play begins."
            }
          ]
        }
