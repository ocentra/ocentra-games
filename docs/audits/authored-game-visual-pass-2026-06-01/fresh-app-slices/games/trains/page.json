          "title": "Trains",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Trains is a simultaneous-play card game where players race to form a 'Train' â€” a complete ascending sequence using all cards in their hand, starting from a 2. The game is played over 4 rounds with decreasing draw piles."
            },
            {
              "type": "paragraph",
              "text": "Trains is a modern American folk card game of the 20th century, played with a standard 52-card deck. It emerged as a casual, simultaneous-play climbing game in which players race to complete an ascending sequence (the Train) starting from a 2. No single published origin or inventor is documented; it is transmitted as a traditional family or social game."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Cards"
            },
            {
              "type": "paragraph",
              "text": "Deal 7 cards. Remaining split into piles (4 in round 1, 3 in round 2, etc.)."
            }
          ]
        }
