        {
          "title": "Illuminati New World Order",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Illuminati: New World Order is an out-of-print collectible card game by Steve Jackson Games, based on the earlier Illuminati game."
            },
            {
              "type": "paragraph",
              "text": "Released in 1994, INWO used starter decks and booster packs, followed by expansion material and a published player guide."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-6 players use the table arrangement described for Illuminati: New World Order."
            },
            {
              "type": "paragraph",
              "text": "Commercial collectible card game decks and booster cards"
            },
            {
              "type": "paragraph",
              "text": "Commercial collectible card game decks and booster cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Commercial collectible card game decks and booster cards and deal or lay out cards according to the documented Illuminati: New World Order rules before play begins."
            }
          ]
        }
      ]
    }
  ]
