        {
          "title": "Josephine",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "Josephine is a two-deck patience game, a variant of Napoleon at St Helena or Forty Thieves, where same-suit sequences may move as groups."
            },
            {
              "type": "paragraph",
              "text": "Josephine is named after Joséphine de Beauharnais and is documented as a solitaire variant in the Forty Thieves family."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "1 players use the table arrangement described for Josephine."
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks"
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Two standard 52-card decks and deal or lay out cards according to the documented Josephine rules before play begins."
            }
          ]
        }
