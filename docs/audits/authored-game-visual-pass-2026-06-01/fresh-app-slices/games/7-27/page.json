      "pages": [
        {
          "title": "Seven Twenty-Seven",
          "subtitle": "Split-Target Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Seven Twenty-Seven is an American vying game, often used in dealer's-choice sessions, where players build card totals as close as possible to 7 and 27 while betting between draws."
            },
            {
              "type": "paragraph",
              "text": "Seven Twenty-Seven is an American non-standard poker-style vying game passed through home and dealer's-choice traditions."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4-10 players in clockwise betting order."
            },
            {
              "type": "paragraph",
              "text": "52 cards. Number cards are face value; J/Q/K are 0.5 each; Ace counts as 1 or 11 (and can be interpreted differently for 7 and 27 in the same hand)."
            },
            {
              "type": "paragraph",
              "text": "Cards and agreed betting stakes/limits."
            },
            {
              "type": "paragraph",
              "text": "Each player antes. Standard deal: one face-up and one face-down card to each player. Common variation: two face-down and one face-up initially."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Face-Up Additional Cards: Requested extra cards are dealt face up instead of face down."
                },
                {
                  "text": "Declared Side: Players declare 7, 27, or both; declaring both requires sweeping both halves to win anything."
                },
                {
                  "text": "Over Is Bust: Totals above 7 cannot win the 7 side; totals above 27 cannot win anything and may bust immediately."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
