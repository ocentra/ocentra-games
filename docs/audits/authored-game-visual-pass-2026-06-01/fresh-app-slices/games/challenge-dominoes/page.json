      "pages": [
        {
          "title": "Challenge Dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Challenge Dominoes is an expanded-supply western domino connecting game played with two double-six sets. The duplicated tiles reduce early blocking and change inference, so play emphasizes robust end control, mobility, and managing pip exposure under uncertainty."
            },
            {
              "type": "paragraph",
              "text": "Challenge Dominoes is encountered as a modern expanded-supply domino format that uses two standard sets to keep the layout moving at larger tables."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 8 players."
            },
            {
              "type": "paragraph",
              "text": "Two double-6 domino sets combined and mixed."
            },
            {
              "type": "paragraph",
              "text": "Domino sets and optional score tracking."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles by player count; remaining tiles may form a boneyard by table profile."
            }
          ]
        }
      ]
    }
  ]
