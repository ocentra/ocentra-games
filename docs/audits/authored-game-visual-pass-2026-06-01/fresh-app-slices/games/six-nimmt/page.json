      "pages": [
        {
          "title": "Six Nimmt",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Six Nimmt is a commercial card game where players secretly choose numbered cards to place into ascending rows while avoiding taking rows full of bullhead penalties."
            },
            {
              "type": "paragraph",
              "text": "Six Nimmt was designed by Wolfgang Kramer and became a widely known modern German card game because simultaneous card choice creates simple but sharp risk management."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two to ten players each receive a hand of numbered cards."
            },
            {
              "type": "paragraph",
              "text": "Use the dedicated numbered deck with printed bullhead values."
            },
            {
              "type": "paragraph",
              "text": "Dedicated numbered deck from 1 to 104 with bullhead penalty icons, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal hands and lay four starting row cards face up."
            }
          ]
        }
      ]
    }
  ]
