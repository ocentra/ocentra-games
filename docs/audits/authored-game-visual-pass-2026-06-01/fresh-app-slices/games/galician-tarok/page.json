      "pages": [
        {
          "title": "Galician Tarok",
          "subtitle": "Galician tarock game",
          "content": [
            {
              "type": "paragraph",
              "text": "Galician Tarok is a three-player historical tarock game from the Galicia region. It uses a 42-card reduced tarock structure and combines talon exchange, contract pressure, and strict trick-taking obligations."
            },
            {
              "type": "paragraph",
              "text": "Galician Tarok appears in tarot-family references as a regional tarock game in the broader Industrie und Glueck tradition."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Three players, each handling contract and trick goals in a declarer-versus-defenders structure."
            },
            {
              "type": "paragraph",
              "text": "54-card Industrie und Glück pack with 22 permanent trumps and 32 suited cards."
            },
            {
              "type": "paragraph",
              "text": "Tarock deck and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt with a talon packet according to local rules before contract decisions and trick play."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Galician Tarok local contract scale: Some groups use slightly different contract ladders and values."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
