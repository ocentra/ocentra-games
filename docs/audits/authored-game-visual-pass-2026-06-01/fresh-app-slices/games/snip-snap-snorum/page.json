    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Snip Snap Snorum",
          "subtitle": "Matching",
          "content": [
            {
              "type": "paragraph",
              "text": "Snip Snap Snorum is a traditional round game for four to eight players who shed cards by extending ascending suit sequences of up to five cards."
            },
            {
              "type": "paragraph",
              "text": "Snip Snap Snorum is an old British and German social card game in the stops group, related to Pope Joan and Michigan and later variants such as Earl of Coventry and Nobble."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Four to eight players sit in turn order."
            },
            {
              "type": "paragraph",
              "text": "Use one standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal all cards as evenly as possible; some players may receive one more card."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Earl of Coventry: Equal-ranked cards are played with a rhymed call instead of ascending suit sequences."
                },
                {
                  "text": "Nobble: A Lancashire variant with related stop-game structure."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
