  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Shithead",
          "subtitle": "Shedding Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Shithead is a shedding card game in which players try to get rid of all cards while avoiding being the last player left with cards. It is also known as Karma or Palace and has many regional rule variants."
            },
            {
              "type": "paragraph",
              "text": "Shithead emerged as a modern folk shedding game with many local names and informal house rules."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-5 players in free-for-all play."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck; some tables add jokers."
            },
            {
              "type": "paragraph",
              "text": "Cards and central play pile/discard area."
            },
            {
              "type": "paragraph",
              "text": "Each player receives 3 face-down table cards, 3 face-up table cards on top, and 3 hand cards. Remaining cards form stock."
            }
          ]
        }
      ]
    }
  ]
