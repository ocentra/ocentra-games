      "pages": [
        {
          "title": "7th Sea CCG",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "7th Sea CCG is a commercial collectible card game set in the 7th Sea universe, with players building decks and resolving conflicts through faction cards and tactical play."
            },
            {
              "type": "paragraph",
              "text": "7th Sea CCG was published by Alderac Entertainment Group as a licensed collectible card game tied to the 7th Sea roleplaying setting."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two players bring constructed decks and any faction-specific starting material."
            },
            {
              "type": "paragraph",
              "text": "Use legal constructed decks from the commercial card pool."
            },
            {
              "type": "paragraph",
              "text": "Collectible custom decks built from 7th Sea cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Shuffle each deck, draw opening hands, and set up any starting cards required by the format."
            }
          ]
        }
      ]
    }
  ]
