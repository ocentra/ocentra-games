          "title": "Big Game Dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Big Game Dominoes is a western domino connecting game played with an expanded set to support larger layouts and longer tactical exchanges."
            },
            {
              "type": "paragraph",
              "text": "The game belongs to modern western domino connecting traditions that favor larger tile sets for extended interaction and scoring potential."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 6 players."
            },
            {
              "type": "paragraph",
              "text": "One double-8 domino set."
            },
            {
              "type": "paragraph",
              "text": "Domino set and score tracking if playing match format."
            },
            {
              "type": "paragraph",
              "text": "Tiles are dealt by player count; remaining tiles may form a boneyard under table profile."
            }
          ]
        }
