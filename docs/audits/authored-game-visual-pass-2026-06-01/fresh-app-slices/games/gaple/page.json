  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Gaple",
          "subtitle": "Indonesian Block Dominoes",
          "content": [
            {
              "type": "paragraph",
              "text": "Gaple is a popular Indonesian block domino game played on a single train line. Players add matching tiles at either end, and if blocked they either discard a dead tile or pass depending on table rules."
            },
            {
              "type": "paragraph",
              "text": "Gaple developed as an Indonesian local form of block dominoes using western double-six tiles."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Four or five players. With four, play can be individual or partnerships; with five, individual play."
            },
            {
              "type": "paragraph",
              "text": "One double-six domino set (28 tiles)."
            },
            {
              "type": "paragraph",
              "text": "One double-six domino set (28 tiles)."
            },
            {
              "type": "paragraph",
              "text": "Four-player variants use either 6 each (4 face-down in center) or 7 each (no center tiles). Five-player game deals 5 each (3 face-down in center)."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Four Player Six-Tile Deal: Each player takes six tiles, leaving four face down; one center tile is exposed to start."
                },
                {
                  "text": "Pass-Only Blocking: When blocked, players pass and keep all tiles in hand instead of discarding dead tiles."
                },
                {
                  "text": "Double-Blank 25 Rule: At scoring, the double blank 0-0 counts 25 only if the player holds no other blank tile."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
