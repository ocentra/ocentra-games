      "pages": [
        {
          "title": "Castle Rock Dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Castle Rock Dominoes is a western domino connecting game played on a shared layout where players match open ends and aim to shed tiles efficiently over a series of hands."
            },
            {
              "type": "paragraph",
              "text": "The game is encountered as a modern western domino connecting ruleset circulated through tabletop communities and rules collections."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 6 players."
            },
            {
              "type": "paragraph",
              "text": "One double-6 domino set."
            },
            {
              "type": "paragraph",
              "text": "Dominoes and table space; optional score sheet for match play."
            },
            {
              "type": "paragraph",
              "text": "Deal tiles according to player count; remaining tiles, if any, may form a boneyard by table preference."
            }
          ]
        }
      ]
    }
  ]
