        {
          "title": "Barbarossa",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Barbarossa is a Japanese deck-building commercial card game set in an alternate-history Eastern Front theme."
            },
            {
              "type": "paragraph",
              "text": "Published by Arclight Games in 2010, Barbarossa adapts the deck-building structure popularized by modern hobby card games into a proprietary historical-fantasy setting."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-5 players use the table arrangement described for Barbarossa."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Barbarossa deck-building card set"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Barbarossa deck-building card set, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Each player starts with a small starter deck and buys or gains cards from shared supply piles during play."
            }
          ]
        }
      ]
    }
  ]
