      "pages": [
        {
          "title": "Comet",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Comet is an old French stops-family card game for two to five players, formerly called Manille and renamed after the appearance of Halley's Comet in 1682."
            },
            {
              "type": "paragraph",
              "text": "Comet descends from the 17th-century French Hoc family, especially Hoc de Mazarin, and its sequential shedding phase influenced later stops games."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-5 players use the table arrangement described for Comet."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card French-suited pack"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card French-suited pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Standard 52-card French-suited pack and deal or lay out cards according to the documented Comet rules before play begins."
            }
          ]
        }
      ]
    }
  ]
