        {
          "title": "Buta no Shippo",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Buta no Shippo is a Japanese card game in which players flip cards around a circular layout and try to avoid taking the pig-tail pile."
            },
            {
              "type": "paragraph",
              "text": "Buta no Shippo, meaning pig tail, is a Japanese family card game built around a circular spread of cards and quick recognition of matching or penalty events."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 or more players use the table arrangement described for Buta no Shippo."
            },
            {
              "type": "paragraph",
              "text": "Standard playing-card pack"
            },
            {
              "type": "paragraph",
              "text": "Standard playing-card pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Spread cards face down in a circle like a tail, leaving the centre as the discard or capture area."
            }
          ]
        }
      ]
    }
  ]
