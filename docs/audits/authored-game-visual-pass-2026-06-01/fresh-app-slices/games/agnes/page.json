      "pages": [
        {
          "title": "Agnes",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "Agnes is a one-player patience game in the Klondike family, using tableau building, foundations, and named variants such as Agnes Sorel and Agnes Bernauer."
            },
            {
              "type": "paragraph",
              "text": "Agnes belongs to the family of traditional named patience games that adapt Klondike-style building with a different reserve and deal rhythm."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One player uses a tableau and foundations."
            },
            {
              "type": "paragraph",
              "text": "Use a single shuffled 52-card pack."
            },
            {
              "type": "paragraph",
              "text": "One standard 52-card deck, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal the initial tableau and reserve according to the selected Agnes variant, then use the remaining stock for later packets."
            }
          ]
        }
      ]
    }
  ]
