        {
          "title": "Brusquembille",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Brusquembille is a historical French trick-and-draw point-trick game for two to five players using a 32-card piquet pack."
            },
            {
              "type": "paragraph",
              "text": "Brusquembille is a historical French trick-and-draw game from the eighteenth-century piquet-pack tradition. It is related to Briscan and Brisque and combines short three-card hands with point cards captured through tricks."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-5 players use the table arrangement described for Brusquembille."
            },
            {
              "type": "paragraph",
              "text": "32-card piquet pack"
            },
            {
              "type": "paragraph",
              "text": "32-card piquet pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal three-card hands from a 32-card piquet pack and leave a stock for drawing after tricks."
            }
          ]
        }
      ]
    }
  ]
