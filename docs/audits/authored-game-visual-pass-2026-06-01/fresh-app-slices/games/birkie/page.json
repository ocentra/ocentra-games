          "title": "Birkie",
          "subtitle": "Accumulation",
          "content": [
            {
              "type": "paragraph",
              "text": "Birkie is a historical Scottish two-player adding-up card game related to Beggar my Neighbour and Battle."
            },
            {
              "type": "paragraph",
              "text": "A Scottish historical card game also spelled Birky, using quick reaction and observation in a battle-like structure."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 players use the table arrangement described for Birkie."
            },
            {
              "type": "paragraph",
              "text": "52-card French-suited pack"
            },
            {
              "type": "paragraph",
              "text": "52-card French-suited pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal the pack between two players, then reveal cards alternately into the play pile."
            }
          ]
        }
