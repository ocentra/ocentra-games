      "pages": [
        {
          "title": "Davoserjazz",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Davoserjazz is a Danish trick-taking compendium game for three to seven players with six deals and changing objectives."
            },
            {
              "type": "paragraph",
              "text": "Davoserjazz is a Danish compendium card game related to Barbu, Lorum, and Herzeln. It preserves the northern European tradition of playing several short trick-taking contracts in one session, with each deal changing the penalty target and hand evaluation."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-7 players use the table arrangement described for Davoserjazz."
            },
            {
              "type": "paragraph",
              "text": "52-card French-suited pack"
            },
            {
              "type": "paragraph",
              "text": "52-card French-suited pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal from a 52-card pack for each of the six contracts."
            }
          ]
        }
      ]
    }
  ]
