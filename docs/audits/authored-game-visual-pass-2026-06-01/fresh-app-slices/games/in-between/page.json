      "pages": [
        {
          "title": "In Between",
          "subtitle": "Acey Deucey Banking",
          "content": [
            {
              "type": "paragraph",
              "text": "In Between is a banking gambling game where a player bets that a third card will rank strictly between two initial cards."
            },
            {
              "type": "paragraph",
              "text": "In Between appears in gambling and dealer's-choice traditions, with major name variants including Acey Deucey and Red Dog."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-8 players; often best around 5-8."
            },
            {
              "type": "paragraph",
              "text": "One standard 52-card deck."
            },
            {
              "type": "paragraph",
              "text": "Deck, chips, and a banker/dealer position."
            },
            {
              "type": "paragraph",
              "text": "Dealer gives two initial face-up cards for a wager decision, then a third resolving card."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Pot Banker: Dealer acts as banker and players wager against shared pot."
                },
                {
                  "text": "Casino Red Dog: Single house deal with fixed spread-based payouts."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
