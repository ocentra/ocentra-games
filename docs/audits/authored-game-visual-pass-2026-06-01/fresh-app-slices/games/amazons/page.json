        {
          "title": "Amazons",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "Amazons is a short patience game using a reduced piquet pack without kings, organized as a simple builder where queens and suit sequences drive the finish."
            },
            {
              "type": "paragraph",
              "text": "Amazons is a traditional compact patience layout known for its short playing time and unusual reduced pack."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One player lays out the reduced pack for solitaire play."
            },
            {
              "type": "paragraph",
              "text": "Use a piquet pack after removing the kings."
            },
            {
              "type": "paragraph",
              "text": "Piquet pack with kings removed, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal according to the Amazons layout, exposing cards for foundation building and keeping the remainder as stock."
            }
          ]
        }
      ]
    }
  ]
