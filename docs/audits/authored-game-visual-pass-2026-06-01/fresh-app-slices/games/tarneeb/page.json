      "pages": [
        {
          "title": "Tarneeb",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Tarneeb (Arabic for 'Trump') is a popular trick-taking card game in the Middle East (Levant, Egypt). It is a partnership game for 4 players. Teams bid on how many tricks they can take (starting from 7 up to 13). The highest bidder names the trump suit (Tarneeb). The objective is to fulfill the bid."
            },
            {
              "type": "paragraph",
              "text": "Roots in the Middle East; likely influenced by Whist and Bridge. The name comes from the Arabic word for trump."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 (Two teams of two, sitting opposite)"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck (A-K-Q-J-10...2)"
            },
            {
              "type": "paragraph",
              "text": "Cards, score pad"
            },
            {
              "type": "paragraph",
              "text": "Deal 13 cards to each player."
            }
          ]
        }
      ]
    }
  ]
