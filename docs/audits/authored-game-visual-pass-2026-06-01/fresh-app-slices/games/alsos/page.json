  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Alsos",
          "subtitle": "The Hungarian Masterpiece",
          "content": [
            {
              "type": "paragraph",
              "text": "Alsos is a sophisticated Hungarian trick-taking game blending Jass structure with Tarokk-style announced figures. In the core three-player form one declarer plays against the other two."
            },
            {
              "type": "paragraph",
              "text": "Alsos emerged in Budapest in the late 19th century and remained popular through the first half of the 20th century."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3 active players. With 4 players, dealer sits out each hand."
            },
            {
              "type": "paragraph",
              "text": "32 cards (A, K, Over, Under, 10, 9, 8, 7). Usually Hungarian suits (Acorns, Hearts, Leaves, Bells)."
            },
            {
              "type": "paragraph",
              "text": "Hungarian deck, complex scoring sheet."
            },
            {
              "type": "paragraph",
              "text": "Each player receives 9 cards (dealt in batches of 3-3-3). 5 cards remain in the 'Talon' (one face up to propose trump)."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Betli: The declarer must lose every single trick. Worth 5 game points."
                },
                {
                  "text": "Klopitzky: A 'no-trump' variation where every player plays for themselves for one hand."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
