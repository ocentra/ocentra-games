        {
          "title": "Munchkin",
          "subtitle": "Social",
          "content": [
            {
              "type": "paragraph",
              "text": "Munchkin is a commercial dedicated-deck card game spoofing tabletop role-playing dungeon crawls with negotiation and take-that play."
            },
            {
              "type": "paragraph",
              "text": "Published by Steve Jackson Games in 2001, Munchkin became a long-running humorous card-game line built around levels, monsters, treasures, and table negotiation."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-6 players use the table arrangement described for Munchkin."
            },
            {
              "type": "paragraph",
              "text": "Dedicated Munchkin door and treasure cards"
            },
            {
              "type": "paragraph",
              "text": "Dedicated Munchkin door and treasure cards, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare the dedicated Munchkin cards and any shared table, score, or resource areas from the published rules."
            }
          ]
        }
      ]
    }
  ]
