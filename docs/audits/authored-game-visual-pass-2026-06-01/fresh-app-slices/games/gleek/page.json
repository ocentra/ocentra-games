  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Gleek",
          "subtitle": "Historic English Vying-Trick Game",
          "content": [
            {
              "type": "paragraph",
              "text": "Gleek is a historical English three-player vying and trick-taking game played with a 44-card deck, combining stock bidding, ruff betting, declaration of sets, and 12-trick play."
            },
            {
              "type": "paragraph",
              "text": "Gleek appears in English sources from the 16th century and was a major three-player game in the 16th-17th centuries."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3 players clockwise; eldest is left of dealer."
            },
            {
              "type": "paragraph",
              "text": "44 cards ranked A K Q J 10 9 8 7 6 5 4 in each suit (2s and 3s removed)."
            },
            {
              "type": "paragraph",
              "text": "Counters or stakes for pot payments."
            },
            {
              "type": "paragraph",
              "text": "Deal 12 cards to each player; place remaining 8 as stock and turn top card to set trump."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Discard-Then-Take vs Take-Then-Discard: Reconstructions differ on whether stock winner discards before taking stock or vice versa."
                },
                {
                  "text": "Early Pass Interpretation: Some tables treat initial pass in ruff vie as fold, others as check-like option before first vie."
                },
                {
                  "text": "Trump Side Payment Rules: Optional side claims for trump Four (Tiddy) and optionally trump Five/Six are table-dependent."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
