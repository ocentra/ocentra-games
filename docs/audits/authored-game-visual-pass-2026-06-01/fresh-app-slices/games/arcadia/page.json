        {
          "title": "Arcadia",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Arcadia is a commercial collectible card game published by White Wolf, supporting deck construction and fantasy-themed card conflict for one to five players."
            },
            {
              "type": "paragraph",
              "text": "Arcadia was published in the 1990s collectible card game boom and is associated with White Wolfs fantasy card-game catalogue."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "One to five players use constructed or scenario-ready decks."
            },
            {
              "type": "paragraph",
              "text": "Use the commercial Arcadia card pool and deck rules."
            },
            {
              "type": "paragraph",
              "text": "Commercial Arcadia collectible card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Set up player decks, draw hands, and prepare shared scenario elements if used."
            }
          ]
        }
      ]
    }
