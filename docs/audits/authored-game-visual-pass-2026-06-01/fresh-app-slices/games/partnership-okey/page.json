    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Partnership Okey",
          "subtitle": "Turkish Tile Rummy",
          "content": [
            {
              "type": "paragraph",
              "text": "Partnership Okey is a team variant of Okey where opposite players cooperate through discard signaling and shared outcome scoring."
            },
            {
              "type": "paragraph",
              "text": "Okey derives from 19th-century Levant and Central Asian tile games, sharing ancestry with Rummikub and Mahjong. It stabilised in Ottoman Turkey."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players (2-3 possible). Each uses a rack (Istaka)."
            },
            {
              "type": "paragraph",
              "text": "106 tiles: numbers 1-13 in red, yellow, green, black (8 per number); 2 unmarked false jokers. One 6-sided die."
            },
            {
              "type": "paragraph",
              "text": "106 tiles, racks, one die."
            },
            {
              "type": "paragraph",
              "text": "Tiles mixed face-down, stacked in 21 piles of 5. Dealer throws die twice to select indicator tile. Player to dealer's right gets 15 tiles, others 14. Play proceeds anticlockwise."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Okey 101: Players receive 21-22 tiles; melds are laid on table. First meld must total at least 101 points."
                },
                {
                  "text": "Partnership Okey: Players opposite are partners; team scoring."
                },
                {
                  "text": "Color Okey: Win with one-color hand doubles score (4 or 8 points lost)."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
