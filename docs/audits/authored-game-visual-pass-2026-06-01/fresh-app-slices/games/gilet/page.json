        {
          "title": "Gilet",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Gilet is a sixteenth-century Italian gambling and matching-vying card game related to Brelan, Primero, and flux-style comparison games."
            },
            {
              "type": "paragraph",
              "text": "Gilet, also spelled Gile or Gillet, is a sixteenth-century Italian game that combines gambling stakes with matching and comparison of card combinations. It is historically related to Brelan, Ge, Point, Flux et Sequence, and Primero."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-4 players use the table arrangement described for Gilet."
            },
            {
              "type": "paragraph",
              "text": "32-card Italian pack"
            },
            {
              "type": "paragraph",
              "text": "32-card Italian pack, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal hands from a 32-card Italian pack, then resolve stakes by comparing the relevant card combinations."
            }
          ]
        }
      ]
    }
