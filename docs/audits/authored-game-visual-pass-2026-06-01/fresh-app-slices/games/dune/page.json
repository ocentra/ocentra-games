          "title": "Dune",
          "subtitle": "Vying",
          "content": [
            {
              "type": "paragraph",
              "text": "Dune is an out-of-print collectible card game, also called Eye of the Storm, based on the Dune setting."
            },
            {
              "type": "paragraph",
              "text": "Produced by Last Unicorn Games and Five Rings Publishing Group, and later by Wizards of the Coast, Dune CCG adapts political and faction conflict from the Dune universe into constructed decks."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2-8 players use the table arrangement described for Dune."
            },
            {
              "type": "paragraph",
              "text": "Constructed Dune collectible card decks"
            },
            {
              "type": "paragraph",
              "text": "Constructed Dune collectible card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Players bring constructed decks and establish faction, resource, and starting hand areas according to the game rules."
            }
          ]
        }
      ]
    }
