  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "All Fours (17th Century)",
          "subtitle": "1674 Original",
          "content": [
            {
              "type": "paragraph",
              "text": "This is the earliest documented form of All Fours, as described in Charles Cotton's 'The Compleat Gamester' (1674). It laid the foundation for dozens of American and British trick-taking games, introducing the iconic 'Begging' mechanic and the four-point scoring system."
            },
            {
              "type": "paragraph",
              "text": "All Fours originated in Kent, England, and was famously denounced as a 'common' or 'vulgar' game by high society, despite its deep tactical complexity."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Exactly 2 players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck. Ace is high."
            },
            {
              "type": "paragraph",
              "text": "Standard deck, counters or tokens for 11 points."
            },
            {
              "type": "paragraph",
              "text": "Each player receives 6 cards in batches of 3. The 13th card is turned up to set the potential trump suit."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Running All Fours: Historical line to 31 where turned trump A/K/Q/J awards dealer 4/3/2/1 at deal time."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
