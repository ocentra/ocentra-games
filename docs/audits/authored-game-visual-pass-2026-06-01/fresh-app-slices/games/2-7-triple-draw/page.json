        {
          "title": "2-7 Triple Draw",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "2-7 Triple Draw (Deuce to Seven) is a lowball draw poker game where the lowest hand wins. Players get five cards and three drawing rounds to improve; straights and flushes count against you; aces are high. Best possible hand is 7-5-4-3-2 offsuit."
            },
            {
              "type": "paragraph",
              "text": "USA; lowball draw poker variant. Introduced at the World Series of Poker (WSOP) in 2004; featured in mixed-game formats."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2–8 (ideally 4–8)"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck"
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck, chips"
            },
            {
              "type": "paragraph",
              "text": "Five cards each; three draw rounds (discard and replace) with betting between each."
            }
          ]
        }
      ]
    }
