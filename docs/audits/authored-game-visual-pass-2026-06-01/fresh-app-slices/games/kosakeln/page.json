      "pages": [
        {
          "title": "Kosakeln",
          "subtitle": "Austrian tarock game",
          "content": [
            {
              "type": "paragraph",
              "text": "Kosakeln is a two-player Austrian tarock trick-taking game in the Industrie und Glueck family. It is a head-to-head adaptation of the Austrian tarock tradition using a 54-card deck with strong emphasis on trump counting and precise endgame timing."
            },
            {
              "type": "paragraph",
              "text": "Kosakeln appears in tarot-family references as a regional tarock game in the broader Industrie und Glueck tradition."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two players compete directly without partnerships."
            },
            {
              "type": "paragraph",
              "text": "54-card Industrie und Glück pack with 22 permanent trumps and 32 suited cards."
            },
            {
              "type": "paragraph",
              "text": "Tarock deck and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt with a talon packet according to local rules before contract decisions and trick play."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
