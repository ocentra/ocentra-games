          "title": "Polskpas",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Polskpas is a Scandinavian five-card plain-trick game for four individual players using a 24-card pack and permanent Wenzels."
            },
            {
              "type": "paragraph",
              "text": "Polskpas is documented as a distinct traditional card game with its own player count, equipment, and objective."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "4 players use the table arrangement described for Polskpas."
            },
            {
              "type": "paragraph",
              "text": "24-card pack with four Jacks as permanent Wenzels"
            },
            {
              "type": "paragraph",
              "text": "24-card pack with four Jacks as permanent Wenzels, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare 24-card pack with four Jacks as permanent Wenzels and deal or lay out cards according to the documented Polskpas rules before play begins."
            }
          ]
        }
