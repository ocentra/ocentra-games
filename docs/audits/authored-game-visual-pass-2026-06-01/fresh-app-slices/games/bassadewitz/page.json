        {
          "title": "Bassadewitz",
          "subtitle": "Trick-taking",
          "content": [
            {
              "type": "paragraph",
              "text": "Bassadewitz is a German trick-avoidance game in which players try to avoid penalty tricks or penalty cards under a compact four-player structure."
            },
            {
              "type": "paragraph",
              "text": "Bassadewitz is a regional German avoidance game, also known under related names such as Passadewitz and Passarowitz."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Four players play individually around the table."
            },
            {
              "type": "paragraph",
              "text": "Use the regional pack specified by the local rules."
            },
            {
              "type": "paragraph",
              "text": "German or French-suited pack by local rules, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Deal the pack evenly, then play tricks clockwise or by local convention."
            }
          ]
        }
      ]
    }
  ]
