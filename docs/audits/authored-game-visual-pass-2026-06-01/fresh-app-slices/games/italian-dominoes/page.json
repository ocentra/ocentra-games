  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Italian Dominoes",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Adding game with double-6 dominoes: each turn you draw from the boneyard or play a tile to the tableau, announcing the cumulative pip total. Score when the total hits exactly 30, 50, 70, or 100; first to reach or pass 50 points wins."
            },
            {
              "type": "paragraph",
              "text": "Italian Dominoes is documented in published rules and active table play traditions."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 5 players."
            },
            {
              "type": "paragraph",
              "text": "Double-6 set; tiles 0-0 through 6-6."
            },
            {
              "type": "paragraph",
              "text": "Double six set and equipment for keeping score."
            },
            {
              "type": "paragraph",
              "text": "Each player draws a hand of tiles (2 players: 8 each; 3: 7 each; 4 or 5: 4 each). One player is picked to lead the first round; lead passes to the left with each new hand."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Double second tile: A player setting a double gets to set a second tile at the same time."
                },
                {
                  "text": "Four-handed partnerships: The four-handed game can be played in partnerships."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
