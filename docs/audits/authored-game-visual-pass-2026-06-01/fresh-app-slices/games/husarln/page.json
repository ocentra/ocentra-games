      "pages": [
        {
          "title": "Husarln",
          "subtitle": "Austrian tarock game",
          "content": [
            {
              "type": "paragraph",
              "text": "Husarln is a three-player Austrian tarock game linked to the Illustrated Tarock branch. It is played with a 42-card reduced tarock pack and puts heavy pressure on trump distribution and tactical contract play."
            },
            {
              "type": "paragraph",
              "text": "Husarln appears in tarot-family references as a regional tarock game in the broader Industrie und Glueck tradition."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Three players compete in rotating declarer versus defenders flow."
            },
            {
              "type": "paragraph",
              "text": "54-card Industrie und Glück pack with 22 permanent trumps and 32 suited cards."
            },
            {
              "type": "paragraph",
              "text": "Tarock deck and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt with a talon packet according to local rules before contract decisions and trick play."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Husarln local contract scale: Some groups use slightly different contract ladders and values."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
