      "pages": [
        {
          "title": "Penneech",
          "subtitle": "17th-Century Trick",
          "content": [
            {
              "type": "paragraph",
              "text": "Penneech is a 17th-century British 2-player trick game. Trump changes each trick (turned from stock). The 7â™¦ (Peneech) is highest when diamonds are trump and scores 7. Ace/K/Q/J of trumps score 5/4/3/2. First to 61 wins."
            },
            {
              "type": "paragraph",
              "text": "Described in Charles Cotton's Compleat Gamester (1676). One of the earliest documented trick games."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two or more players."
            },
            {
              "type": "paragraph",
              "text": "Standard 52. Diamonds: 7 ranks above Ace when diamonds trump."
            },
            {
              "type": "paragraph",
              "text": "52 cards. Cribbage board for scoring."
            },
            {
              "type": "paragraph",
              "text": "7 each. Remainder = stock."
            }
          ]
        }
      ]
    }
  ]
