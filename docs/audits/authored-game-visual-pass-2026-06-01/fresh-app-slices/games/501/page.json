      "pages": [
        {
          "title": "501 (Russian card game)",
          "subtitle": "Card Game",
          "content": [
            {
              "type": "paragraph",
              "text": "501 is a Russian three-player card game: hybrid of 1000 (dealing, bidding) and 66 (marriage scores, fixed trump). 24-card pack; A,10,K,Q,J,9. Marriages in trump 40, non-trump 20. Bid to 501; clockwise deal and play."
            },
            {
              "type": "paragraph",
              "text": "Russia; hybrid of 1000 (dealing, bidding) and 66 (marriage scores, fixed trump). Described by Michael Latash from Moscow; possibly an intermediate between older 66 and newer 1000."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3 active (or 4 with dealer sitting out). Deal and play clockwise."
            },
            {
              "type": "paragraph",
              "text": "24-card pack: A, 10, K, Q, J, 9 per suit. Marriages: trump 40, non-trump 20. 120 points in pack."
            },
            {
              "type": "paragraph",
              "text": "24-card pack; score sheet to 501."
            },
            {
              "type": "paragraph",
              "text": "Deal and bid clockwise; bid to 501; fixed trump by turn of card or similar."
            }
          ]
        }
      ]
    }
  ]
