          "title": "Emprunt",
          "subtitle": "Gambling",
          "content": [
            {
              "type": "paragraph",
              "text": "Emprunt is a historical French Hoc-family card game for three to six players, named for its distinctive borrowing rule."
            },
            {
              "type": "paragraph",
              "text": "Rules for Emprunt date at least to 1718, and French games compendia continued to include it into the late nineteenth century."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "3-6 players use the table arrangement described for Emprunt."
            },
            {
              "type": "paragraph",
              "text": "Standard French-suited pack, stripped by player count in some rules"
            },
            {
              "type": "paragraph",
              "text": "Standard French-suited pack, stripped by player count in some rules, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Prepare Standard French-suited pack, stripped by player count in some rules and deal or lay out cards according to the documented Emprunt rules before play begins."
            }
          ]
        }
      ]
    }
