      "pages": [
        {
          "title": "Khorol",
          "subtitle": "Card game",
          "content": [
            {
              "type": "paragraph",
              "text": "Khorol is a Mongolian tile game family treated as its own tile family rather than a western domino skin. It uses a dedicated khorol tile set and regional pattern rules, with placement and scoring conventions that differ from standard western domino supply assumptions."
            },
            {
              "type": "paragraph",
              "text": "Khorol is documented as a Mongolian tile game tradition with a distinct tile family and cultural usage in social play."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "2 to 4 players."
            },
            {
              "type": "paragraph",
              "text": "One Khorol 60 tile set."
            },
            {
              "type": "paragraph",
              "text": "Khorol tiles and score tracking if the table profile uses cumulative scoring."
            },
            {
              "type": "paragraph",
              "text": "Tiles are distributed according to the active khorol table profile."
            }
          ]
        }
      ]
    }
  ]
