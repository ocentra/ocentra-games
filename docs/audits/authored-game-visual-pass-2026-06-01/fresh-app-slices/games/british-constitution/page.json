        {
          "title": "British Constitution",
          "subtitle": "Patience",
          "content": [
            {
              "type": "paragraph",
              "text": "British Constitution is an English two-pack patience game with strong restrictions on moving cards through the tableau toward foundations."
            },
            {
              "type": "paragraph",
              "text": "Known simply as Constitution in some American sources, it is a traditional English patience with relatively favourable winning chances."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "1 players use the table arrangement described for British Constitution."
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks"
            },
            {
              "type": "paragraph",
              "text": "Two standard 52-card decks, score area, and enough table space for play."
            },
            {
              "type": "paragraph",
              "text": "Remove kings, queens, and aces at setup according to the layout, discard the kings and queens, and use aces as foundation bases."
            }
          ]
        }
      ]
    }
