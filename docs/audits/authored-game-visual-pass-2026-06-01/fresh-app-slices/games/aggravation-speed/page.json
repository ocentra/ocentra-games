  "sections": [
    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Aggravation Speed",
          "subtitle": "Reflex Match Race",
          "content": [
            {
              "type": "paragraph",
              "text": "Aggravation is a two-player speed-matching game where players rapidly cover same-rank matches in expanding face-up rows."
            },
            {
              "type": "paragraph",
              "text": "Aggravation is documented as a California Speed family variant with expanding rows rather than fixed 2x4 layout."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Exactly 2 players."
            },
            {
              "type": "paragraph",
              "text": "One 52-card deck split equally into 26-card face-down player piles."
            },
            {
              "type": "paragraph",
              "text": "Deck and flat table space for two parallel rows."
            },
            {
              "type": "paragraph",
              "text": "Players simultaneously deal one face-up card each to begin rows, extending rows until matches occur."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Frustration: When one player runs out, both scoop local rows and restart race with remaining cards until threshold is reached."
                },
                {
                  "text": "California Speed: Fixed 2x4 layout variant instead of growing rows."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
