      "pages": [
        {
          "title": "Doppen",
          "subtitle": "Austrian tarock game",
          "content": [
            {
              "type": "paragraph",
              "text": "Doppen is an Austrian tarock trick-taking game in the Industrie und Glück family. It is played with the reduced 54-card tarock deck and focuses on contract choice, talon decisions, and efficient trump timing in three-player play."
            },
            {
              "type": "paragraph",
              "text": "Doppen appears in Austrian tarock references as a real regional tarock game in the broader Industrie und Glück branch."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Three players; each plays independently."
            },
            {
              "type": "paragraph",
              "text": "54-card Industrie und Glück pack with 22 permanent trumps and 32 suited cards."
            },
            {
              "type": "paragraph",
              "text": "Tarock deck and score tracking."
            },
            {
              "type": "paragraph",
              "text": "Cards are dealt with a talon packet according to local Doppen dealing conventions before contract decisions."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Local contract scale: Some groups use slightly different contract ladders and values."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
