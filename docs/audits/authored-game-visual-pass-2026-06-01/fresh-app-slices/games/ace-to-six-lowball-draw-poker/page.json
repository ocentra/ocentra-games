    {
      "type": "about",
      "tabLabel": "About",
      "pages": [
        {
          "title": "Ace-To-Six Lowball (Draw) Poker",
          "subtitle": "London Single Draw",
          "content": [
            {
              "type": "paragraph",
              "text": "Ace-To-Six Lowball (Draw) Poker is the single-draw implementation of ace-to-six lowball, where straights and flushes count against low hands."
            },
            {
              "type": "paragraph",
              "text": "Ace-to-six lowball developed as a home-game lowball ranking in eastern United States and United Kingdom poker circles, then spread through parts of Europe."
            }
          ]
        },
        {
          "title": "Setup",
          "subtitle": "Table, deck, equipment, and deal",
          "content": [
            {
              "type": "paragraph",
              "text": "Two to six players. As with other five-card draw lowball variants, the game is typically played in this range; with more than six players the deck can run short when many draw replacements, so six is a practical maximum. Play proceeds clockwise from the dealer's left."
            },
            {
              "type": "paragraph",
              "text": "Standard 52-card deck; optional joker bug in some house rules."
            },
            {
              "type": "paragraph",
              "text": "Deck, chips, dealer button, and blind markers if blind structure is used."
            },
            {
              "type": "paragraph",
              "text": "Deal 5 cards face-down to each player."
            }
          ]
        },
        {
          "title": "Variations",
          "subtitle": "Known ways this game changes",
          "content": [
            {
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "text": "Single Draw Mainline: Primary form: one draw round and two main betting rounds."
                },
                {
                  "text": "Triple Draw Extension: Three draw rounds with additional betting rounds as a table variation."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
