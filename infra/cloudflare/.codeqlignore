# CodeQL ignore file - excludes build artifacts and temporary files
# CodeQL CLI respects this file when extracting JavaScript/TypeScript files
# See: https://codeql.github.com/docs/codeql-cli/manual/database-create/

# Wrangler build artifacts (temporary worker builds)
.wrangler/
.wrangler/**

# Stryker mutation testing artifacts
.stryker-tmp/
.stryker-tmp/**

# Test runner outputs (not source code)
test-runner/
test-runner/**

# Node modules
node_modules/
node_modules/**

# Build outputs
dist/
dist/**
build/
build/**

# CodeQL database itself
.codeql-database/
.codeql-database/**

# Test artifacts and logs
*.log
.test-run.log

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml
