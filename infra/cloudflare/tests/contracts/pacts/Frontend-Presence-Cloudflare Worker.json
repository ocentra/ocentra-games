{
  "consumer": {
    "name": "Frontend-Presence"
  },
  "interactions": [
    {
      "description": "a request for presence by user id",
      "pending": false,
      "providerStates": [
        {
          "name": "presence service is available"
        }
      ],
      "request": {
        "headers": {
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/presence/test-user"
      },
      "response": {
        "body": {
          "content": {
            "friends": [
              "user-id"
            ],
            "status": "offline"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.friends": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.friends[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "14.0.0"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Cloudflare Worker"
  }
}