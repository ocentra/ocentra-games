{
  "consumer": {
    "name": "Frontend-Matchmaking"
  },
  "interactions": [
    {
      "description": "a request to join matchmaking queue",
      "pending": false,
      "providerStates": [
        {
          "name": "matchmaking queue accepts request"
        }
      ],
      "request": {
        "body": {
          "content": {},
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Content-Type": [
            "application/json"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "POST",
        "path": "/api/v1/matchmaking/queue"
      },
      "response": {
        "body": {
          "content": {
            "position": 0,
            "ticketId": "ticket-uuid"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.position": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.ticketId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "14.0.0"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Cloudflare Worker"
  }
}