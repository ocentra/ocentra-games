{
  "consumer": {
    "name": "Frontend-Progression"
  },
  "interactions": [
    {
      "description": "a client-authoritative achievement progress request",
      "pending": false,
      "providerStates": [
        {
          "name": "user exists"
        }
      ],
      "request": {
        "body": {
          "content": {
            "achievementId": "client-selected-achievement",
            "progress": 100
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Content-Type": [
            "application/json"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "POST",
        "path": "/api/v1/progression/update-achievement"
      },
      "response": {
        "body": {
          "content": {
            "error": "Forbidden",
            "message": "Achievement progress must be issued by trusted server workflows"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 403
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a client-authoritative progression XP request",
      "pending": false,
      "providerStates": [
        {
          "name": "user exists"
        }
      ],
      "request": {
        "body": {
          "content": {
            "amount": 1000
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Content-Type": [
            "application/json"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "POST",
        "path": "/api/v1/progression/xp"
      },
      "response": {
        "body": {
          "content": {
            "error": "Forbidden",
            "message": "Progression XP must be issued by trusted server workflows"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 403
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for progression without auth",
      "pending": false,
      "providerStates": [
        {
          "name": "no authentication"
        }
      ],
      "request": {
        "headers": {
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/progression"
      },
      "response": {
        "body": {
          "content": {
            "error": "Unauthorized"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for progression xp",
      "pending": false,
      "providerStates": [
        {
          "name": "user has progression data"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/progression/xp"
      },
      "response": {
        "body": {
          "content": {
            "level": 1,
            "totalXpEarned": 0,
            "xp": 0
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.level": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.totalXpEarned": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.xp": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
