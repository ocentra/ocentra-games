{
  "consumer": {
    "name": "Frontend-Shop"
  },
  "interactions": [
    {
      "description": "a request for shop products list",
      "pending": false,
      "providerStates": [
        {
          "name": "shop has zero or more products"
        }
      ],
      "request": {
        "headers": {
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/shop/products"
      },
      "response": {
        "body": {
          "content": {
            "products": [
              {
                "acAmount": 100,
                "active": true,
                "availability": "live",
                "badge": "Starter",
                "benefits": [
                  "AI analysis fuel"
                ],
                "currency": "usd",
                "description": "Starter refill",
                "displayName": "100 AC",
                "entitlementKind": "credits",
                "productId": "prod-1",
                "productType": "AC_CREDITS",
                "shopTab": "Treasury",
                "unitPriceCents": 199
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.products": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.products[*].acAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].active": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].availability": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].badge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].benefits": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.products[*].benefits[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].displayName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].entitlementKind": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].productId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].productType": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].shopTab": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].unitPriceCents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for single product by id",
      "pending": false,
      "providerStates": [
        {
          "name": "product does not exist"
        }
      ],
      "request": {
        "headers": {
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/shop/products/no-such-product"
      },
      "response": {
        "body": {
          "content": {
            "error": "Product not found"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Cloudflare Worker"
  }
}