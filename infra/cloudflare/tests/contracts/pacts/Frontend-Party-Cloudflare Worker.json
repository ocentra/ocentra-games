  "interactions": [
    {
      "description": "a request for party by id",
      "pending": false,
      "providerStates": [
        {
          "name": "party exists"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/party/party-contract-1"
      },
      "response": {
        "body": {
          "content": {
            "members": [
              {
                "userId": "test-user"
              }
            ],
            "partyId": "party-contract-1"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.members": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.members[*].userId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.partyId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to create a party",
      "pending": false,
      "providerStates": [
        {
          "name": "user can create party"
        }
      ],
      "request": {
        "body": {
          "content": {},
          "contentType": "application/json",
          "encoded": false
