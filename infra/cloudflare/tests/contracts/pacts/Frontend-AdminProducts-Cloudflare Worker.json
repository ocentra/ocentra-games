{
  "consumer": {
    "name": "Frontend-AdminProducts"
  },
  "interactions": [
    {
      "description": "a request for admin products list",
      "pending": false,
      "providerStates": [
        {
          "name": "user is authenticated but not admin"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/admin/products"
      },
      "response": {
        "body": {
          "content": {
            "error": "Forbidden"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 403
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for admin products list by admin",
      "pending": false,
      "providerStates": [
        {
          "name": "user is admin and products exist"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-admin-user:admin"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/admin/products"
      },
      "response": {
        "body": {
          "content": {
            "products": [
              {
                "active": true,
                "displayName": "100 AC",
                "productId": "prod-1"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.products": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].active": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].displayName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.products[*].productId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Cloudflare Worker"
  }
}