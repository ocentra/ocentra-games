{
  "consumer": {
    "name": "Frontend-Audit"
  },
  "interactions": [
    {
      "description": "a request for audit query",
      "pending": false,
      "providerStates": [
        {
          "name": "audit log has events"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/audit/query"
      },
      "response": {
        "body": {
          "content": {
            "events": [
              {
                "id": "evt-1",
                "timestamp": 1700000000000,
                "type": "action"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.events": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.events[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.events[*].timestamp": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.events[*].type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for audit query without auth",
      "pending": false,
      "providerStates": [
        {
          "name": "no authentication"
        }
      ],
      "request": {
        "headers": {
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/audit/query"
      },
      "response": {
        "body": {
          "content": {
            "error": "Unauthorized"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Cloudflare Worker"
  }
}