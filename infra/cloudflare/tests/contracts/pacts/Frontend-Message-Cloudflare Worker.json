{
  "consumer": {
    "name": "Frontend-Message"
  },
  "interactions": [
    {
      "description": "a request for message list",
      "pending": false,
      "providerStates": [
        {
          "name": "conversation has messages"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/messages/conv-contract-test"
      },
      "response": {
        "body": {
          "content": {
            "messages": [
              {
                "content": "hello",
                "messageId": "msg-1",
                "senderId": "test-user",
                "timestamp": 1700000000000
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.messages": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.messages[*].content": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.messages[*].messageId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.messages[*].senderId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.messages[*].timestamp": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for message list without auth",
      "pending": false,
      "providerStates": [
        {
          "name": "no authentication"
        }
      ],
      "request": {
        "headers": {
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/messages/conv-contract-test"
      },
      "response": {
        "body": {
          "content": {
            "error": "Unauthorized"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to mark messages read",
      "pending": false,
      "providerStates": [
        {
          "name": "user can mark messages read"
        }
      ],
      "request": {
        "body": {
          "content": {
            "messageIds": [
              "msg-1"
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Content-Type": [
            "application/json"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "POST",
        "path": "/api/v1/messages/conv-contract-test/read-receipt"
      },
      "response": {
        "body": {
          "content": {
            "read": true
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.read": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to send a message",
      "pending": false,
      "providerStates": [
        {
          "name": "user can send message"
        }
      ],
      "request": {
        "body": {
          "content": {
            "content": "hello"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Content-Type": [
            "application/json"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "POST",
        "path": "/api/v1/messages/conv-contract-test/send"
      },
      "response": {
        "body": {
          "content": {
            "messageId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "sent": true
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.messageId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              ]
            },
            "$.sent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Cloudflare Worker"
  }
}