    {
      "description": "a request to claim a badge",
      "pending": false,
      "providerStates": [
        {
          "name": "user can claim a badge"
        }
      ],
      "request": {
        "body": {
          "content": {
            "badge_id": "pro_bronze"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Content-Type": [
            "application/json"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "POST",
        "path": "/api/v1/badges/test-user/claim"
      },
      "response": {
        "body": {
          "content": {
            "badge": {
              "badge_id": "pro_bronze",
              "unlocked_at": "2026-02-05T12:00:00.000Z"
            },
            "rewards_claimed": false,
            "success": true
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.badge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.badge.badge_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.badge.unlocked_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d\\.\\d+([+-][0-2]\\d(:?[0-5]\\d)?|Z)$"
                }
              ]
            },
            "$.rewards_claimed": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.success": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
