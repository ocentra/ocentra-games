{
  "consumer": {
    "name": "Frontend-Players"
  },
  "interactions": [
    {
      "description": "a request for player stats",
      "pending": false,
      "providerStates": [
        {
          "name": "user has player stats"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/players/test-user"
      },
      "response": {
        "body": {
          "content": {
            "credits": {
              "ac_balance": 0,
              "gp_balance": 0,
              "total_ac_purchased": 0,
              "total_ac_spent": 0,
              "total_gp_earned": 0
            },
            "losses": 0,
            "total_games": 0,
            "win_rate": 0,
            "wins": 0
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.credits": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.credits.ac_balance": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.credits.gp_balance": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.credits.total_ac_purchased": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.credits.total_ac_spent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.credits.total_gp_earned": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.losses": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total_games": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.win_rate": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.wins": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for player stats without authentication",
      "pending": false,
      "providerStates": [
        {
          "name": "no authentication"
        }
      ],
      "request": {
        "headers": {
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/players/test-user"
      },
      "response": {
        "body": {
          "content": {
            "error": "Unauthorized",
            "message": "Authentication required"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
