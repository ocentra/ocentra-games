{
  "consumer": {
    "name": "Frontend-AI-Escrow"
  },
  "interactions": [
    {
      "description": "a request to reserve AI escrow",
      "pending": false,
      "providerStates": [
        {
          "name": "user is authenticated"
        }
      ],
      "request": {
        "body": {
          "content": {
            "estimatedTokens": 100,
            "idempotencyKey": "idem-1",
            "reservedAmount": 10
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Content-Type": [
            "application/json"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "POST",
        "path": "/api/v1/ai/escrow/reserve"
      },
      "response": {
        "body": {
          "content": {
            "escrowId": "e1",
            "reservedAmount": 10,
            "success": true
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.escrowId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.reservedAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.success": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to reserve AI escrow without auth",
      "pending": false,
      "providerStates": [
        {
          "name": "no authentication"
        }
      ],
      "request": {
        "body": {
          "content": {
            "estimatedTokens": 50,
            "idempotencyKey": "idem-2",
            "reservedAmount": 5
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "POST",
        "path": "/api/v1/ai/escrow/reserve"
      },
      "response": {
        "body": {
          "content": {
            "error": "Unauthorized"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "Cloudflare Worker"
  }
}