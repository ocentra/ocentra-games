{
  "consumer": {
    "name": "Frontend-Notification"
  },
  "interactions": [
    {
      "description": "a request for notification list",
      "pending": false,
      "providerStates": [
        {
          "name": "user has notifications"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-user"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/notifications/list"
      },
      "response": {
        "body": {
          "content": {
            "notifications": [
              {
                "body": "Body",
                "id": "notif-1",
                "read": false,
                "title": "Title",
                "type": "info"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.notifications": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.notifications[*].body": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.notifications[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.notifications[*].read": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.notifications[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.notifications[*].type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
