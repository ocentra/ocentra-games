    {
      "description": "a request for payment events",
      "pending": false,
      "providerStates": [
        {
          "name": "admin is authenticated"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer test-token:test-admin-user:admin"
          ],
          "Origin": [
            "http://localhost:5173"
          ]
        },
        "method": "GET",
        "path": "/api/v1/payments/events"
      },
      "response": {
        "body": {
          "content": {
            "events": [
              {
                "currentState": "",
                "paymentId": ""
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.events": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.events[*].currentState": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.events[*].paymentId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
