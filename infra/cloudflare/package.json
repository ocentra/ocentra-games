    "test:query:stats:integration": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=integration",
    "test:query:stats:e2e": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=e2e",
    "test:query:stats:contract": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=contract",
    "test:query:stats:unit:pool": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=unit --run-type=single-pool",
    "test:query:stats:unit:threads": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=unit --run-type=single-threads",
    "test:query:stats:integration:pool": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=integration --run-type=single-pool",
    "test:query:stats:integration:threads": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=integration --run-type=single-threads",
    "test:query:stats:e2e:pool": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=e2e --run-type=single-pool",
    "test:query:stats:e2e:threads": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=e2e --run-type=single-threads",
    "test:query:stats:contract:pool": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=contract --run-type=single-pool",
    "test:query:stats:contract:threads": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --suite-type=contract --run-type=single-threads",
    "logs:cloudflare:prepare": "cd ../../packages/logging-domain && npx tsx scripts/prepare-ndjson-logs.ts --wipe --prepare --run-type=single-pool --tests-dir=../../infra/cloudflare/tests && npx tsx scripts/prepare-ndjson-logs.ts --prepare --run-type=single-threads --tests-dir=../../infra/cloudflare/tests",
    "contracts:generate": "vitest run --config vitest.contract.config.ts tests/contracts/consumers",
    "contracts:verify": "cross-env TEST_RUNNER=unstable vitest run --config vitest.contract.config.ts tests/contracts/providers",
    "contracts:test": "npm run contracts:generate && npm run contracts:verify",
    "lint": "npm run lint:exec && npm run type-check",
    "lint:exec": "eslint --config eslint.config.js . && npx tsx test-runner/script/check-orchestration-boundaries.ts",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "test:ui:dev": "npx vite tests/test-ui --port 3999 --strictPort",
    "test:ui:serve": "npx vite build tests/test-ui && npx vite preview tests/test-ui -l 3999",
    "test:ui:e2e": "playwright test --config=playwright.test-ui.config.ts"
