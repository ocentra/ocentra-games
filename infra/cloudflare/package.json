    "test:query:failed:integration:threads": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts failed --suite-type=integration --run-type=single-threads",
    "test:query:failed:e2e:pool": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts failed --suite-type=e2e --run-type=single-pool",
    "test:query:failed:e2e:threads": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts failed --suite-type=e2e --run-type=single-threads",
    "test:query:failed:contract:pool": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts failed --suite-type=contract --run-type=single-pool",
    "test:query:failed:contract:threads": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts failed --suite-type=contract --run-type=single-threads",
    "test:query:failed:pool": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts failed --run-type=single-pool",
    "test:query:failed:threads": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts failed --run-type=single-threads",
    "test:query:stats": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats",
    "test:query:stats:pool": "cd ../../packages/logging-domain && npx tsx scripts/query-test-logs.ts stats --run-type=single-pool",
