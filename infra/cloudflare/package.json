{
  "name": "claim-cloudflare-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "npx tsx scripts/generate-log-modules.ts && cd ../.. && npm run dev:prep:worker",
    "predev": "npx tsx scripts/generate-log-modules.ts && cd ../.. && npm run dev:prep:worker",
    "prelint": "cd ../.. && npm run dev:prep:worker",
    "pretest": "cd ../.. && npm run dev:prep:worker",
    "dev": "npx tsx scripts/seed-assets-local.ts && wrangler dev --env development",
    "seed:assets:local": "npx tsx scripts/seed-assets-local.ts",
    "wipe:r2:remote-assets": "npx tsx scripts/wipe-remote-r2-asset-buckets.ts",
    "seed:products:local": "npx tsx scripts/seed-products-local.ts",
    "deploy:dev": "npx tsx scripts/deploy-with-version.ts --env development",
    "deploy": "npx tsx scripts/deploy-with-version.ts --config wrangler.production.toml --env production",
    "login": "wrangler login",
    "test": "npx tsx scripts/test-runner.ts",
    "test:unstable": "npx tsx scripts/test-runner.ts --mode=unstable",
    "test:production": "npx tsx scripts/test-runner.ts --mode=production",
    "test:unit": "npx tsx scripts/test-runner.ts --type=unit",
    "test:unit:unstable": "npx tsx scripts/test-runner.ts --type=unit --mode=unstable",
    "test:unit:both": "npx tsx scripts/test-runner.ts --type=unit && npx tsx scripts/test-runner.ts --type=unit --mode=unstable",
    "test:unit:helper": "npx tsx scripts/run-suite-helper.ts --type=unit --mode=both",
    "test:unit:ci": "npx tsx scripts/run-suite-helper.ts --type=unit --mode=both --ci",
    "test:unit:pool:helper": "npx tsx scripts/run-suite-helper.ts --type=unit --mode=pool",
    "test:unit:threads:helper": "npx tsx scripts/run-suite-helper.ts --type=unit --mode=unstable",
    "test:integration:helper": "npx tsx scripts/run-suite-helper.ts --type=integration --mode=both",
    "test:integration:ci": "npx tsx scripts/run-suite-helper.ts --type=integration --mode=both --ci",
    "test:integration:pool:helper": "npx tsx scripts/run-suite-helper.ts --type=integration --mode=pool",
    "test:integration:threads:helper": "npx tsx scripts/run-suite-helper.ts --type=integration --mode=unstable",
    "test:e2e:helper": "npx tsx scripts/run-suite-helper.ts --type=e2e --mode=both",
    "test:e2e:ci": "npx tsx scripts/run-suite-helper.ts --type=e2e --mode=both --ci",
    "test:e2e:pool:helper": "npx tsx scripts/run-suite-helper.ts --type=e2e --mode=pool",
    "test:e2e:threads:helper": "npx tsx scripts/run-suite-helper.ts --type=e2e --mode=unstable",
    "test:e2e:unstable:helper": "npx tsx scripts/run-suite-helper.ts --type=e2e --mode=unstable",
    "test:contract:helper": "npx tsx scripts/run-suite-helper.ts --type=contract --mode=both",
    "test:contract:ci": "npx tsx scripts/run-suite-helper.ts --type=contract --mode=both --ci",
    "test:contract:pool:helper": "npx tsx scripts/run-suite-helper.ts --type=contract --mode=pool",
    "test:contract:threads:helper": "npx tsx scripts/run-suite-helper.ts --type=contract --mode=unstable",
    "test:helper": "npx tsx scripts/run-suite-helper.ts --type=all --mode=both",
    "test:all-cloudflare:ci": "npm run test:unit:ci && npm run test:integration:ci && npm run test:e2e:ci && npm run test:contract:ci",
    "test:flaky:detect": "npx tsx scripts/detect-flaky.ts",
    "test:integration": "npx tsx scripts/test-runner.ts --type=integration",
    "test:integration:unstable": "npx tsx scripts/test-runner.ts --type=integration --mode=unstable",
    "test:integration:both": "npx tsx scripts/test-runner.ts --type=integration && npx tsx scripts/test-runner.ts --type=integration --mode=unstable",
    "test:integration:firebase:real": "npx tsx scripts/run-firebase-real-smoke.ts",
    "test:e2e": "npx tsx scripts/test-runner.ts --type=e2e",
    "test:e2e:unstable": "npx tsx scripts/test-runner.ts --type=e2e --mode=unstable",
    "test:e2e:both": "npx tsx scripts/test-runner.ts --type=e2e && npx tsx scripts/test-runner.ts --type=e2e --mode=unstable",
    "test:websocket": "npx tsx scripts/test-runner.ts --type=websocket",
    "test:websocket:unstable": "npx tsx scripts/test-runner.ts --type=websocket --mode=unstable",
    "test:websocket:both": "npx tsx scripts/test-runner.ts --type=websocket && npx tsx scripts/test-runner.ts --type=websocket --mode=unstable",
    "test:security": "npx tsx scripts/test-runner.ts tests/unit/auth.test.ts tests/unit/cors.test.ts tests/unit/security-monitoring.test.ts tests/integration/resources-api.test.ts tests/integration/request-smuggling.test.ts tests/integration/observability.test.ts",
    "test:watch": "vitest watch",
    "test:watch:coverage": "vitest watch --coverage --run",
    "test:coverage": "npx tsx test-runner/script/report/test-coverage.ts",
    "test:runner:coverage": "npx tsx test-runner/script/run-coverage.ts",
    "test:coverage:check": "vitest run --coverage && node -e \"const fs=require('fs');const r=JSON.parse(fs.readFileSync('./test-runner/coverage/coverage-summary.json','utf8'));const {lines,branches,functions,statements}=r.total;console.log(`Coverage: Lines=${lines.pct}% Branches=${branches.pct}% Functions=${functions.pct}% Statements=${statements.pct}%`);const f=[lines.pct<95,branches.pct<90,functions.pct<95,statements.pct<95].some(x=>x);if(f){console.error('❌ Coverage thresholds not met (Plan A: 95/90/95/95)');process.exit(1);}console.log('✅ All thresholds met');\"",
    "test:coverage:open": "node -e \"const {exec}=require('child_process');const os=require('os');const cmd=os.platform()==='win32'?'start':os.platform()==='darwin'?'open':'xdg-open';exec(`${cmd} test-runner/coverage/index.html`);\"",
    "test:ui": "vitest --ui",
    "test:comprehensive": "npx --yes tsx tests/analytics/test-analytics-comprehensive.ts",
    "test:token": "npx --yes tsx tests/analytics/test-analytics-comprehensive.ts token",
    "test:logs": "npx --yes tsx tests/analytics/test-analytics-comprehensive.ts logs",
    "test:all": "npm run test:security && npm run test:e2e && npm run test:comprehensive",
    "test:all-cloudflare": "npx tsx scripts/run-all-cloudflare-tests.ts",
    "test:all-cloudflare:unstable": "npx tsx scripts/test-runner.ts --type=unit --mode=unstable && npx tsx scripts/test-runner.ts --type=integration --mode=unstable && npx tsx scripts/test-runner.ts --type=e2e --mode=unstable",
    "test:all-cloudflare:both": "npx tsx scripts/run-all-cloudflare-tests.ts --both-modes",
    "test:all-configs": "npm run test",
    "test:real": "echo 'Real Cloudflare tests not yet implemented - use test:e2e for local E2E tests' && exit 1",
    "test:mutation": "npx --yes tsx test-runner/script/run-mutation-tests.ts",
    "test:runner:mutation": "npx --yes tsx test-runner/script/run-mutation-only.ts",
    "test:property": "npx tsx scripts/test-runner.ts tests/integration/property-invariants.test.ts",
    "test:schemathesis": "npx tsx test-runner/script/run-schemathesis.ts",
    "test:schemathesis:examples": "npx tsx test-runner/script/run-schemathesis.ts --examples-only",
    "test:schemathesis:example-gaps": "npx tsx test-runner/script/run-schemathesis.ts --report-examples",
    "test:load": "k6 run tests/k6/concurrency.test.js",
    "test:k6": "npx tsx test-runner/script/run-k6.ts",
    "test:k6:soak": "k6 run tests/k6/soak.test.js",
    "test:k6:memory": "k6 run tests/k6/memory-pressure.test.js",
    "test:k6:fd": "k6 run tests/k6/fd-exhaustion.test.js",
    "test:k6:stress": "npm run test:k6:soak && npm run test:k6:memory && npm run test:k6:fd",
    "test:static-analysis": "npx tsx test-runner/script/run-static-analysis.ts",
    "test:codeql": "npx tsx test-runner/script/run-codeql.ts",
    "test:observability": "npx tsx test-runner/script/run-observability.ts",
    "test:full": "npx tsx test-runner/script/run-full-suite-interactive.ts",
    "test:report": "npx tsx test-runner/script/report/generate-test-report.ts",
    "test:security-full": "npm run test:security && npm run test:property && npm run test:mutation",
    "worker:start": "npx --yes tsx tests/start-worker-server.ts",
    "worker:status": "npx --yes tsx -e \"import('./tests/helpers/worker-helper.js').then(m => console.log(JSON.stringify(m.getWorkerStatus(), null, 2))).catch(e => console.error(e))\"",
    "generate:k6-constants": "npx tsx test-runner/script/codegen/generate-k6-constants.ts",
    "verify:plan": "npx tsx scripts/verify-plan-requirements.ts",
