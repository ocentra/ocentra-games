{
  "name": "@ocentra/leaderboard-playground",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cd .. && npx tsx scripts/dev/dev-scratchpad-vite.ts",
    "dev:raw": "vite --host 127.0.0.1 --port 5176 --strict-port",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "lint": "npm run lint:exec && npm run type-check",
