{
  "name": "@ocentra/verification-domain",
  "version": "1.0.0",
  "type": "module",
  "description": "Match verification, canonical serialization, dispute resolution. Depends on crypto-domain, solana-domain, storage-domain.",
  "dependencies": {},
  "exports": {
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./canonical/CanonicalJSON": {
      "import": "./dist/canonical/CanonicalJSON.js",
      "types": "./dist/canonical/CanonicalJSON.d.ts"
    },
    "./canonical/CanonicalSerializer": {
      "import": "./dist/canonical/CanonicalSerializer.js",
      "types": "./dist/canonical/CanonicalSerializer.d.ts"
    },
    "./services/DisputeResolver": {
      "import": "./dist/services/DisputeResolver.js",
      "types": "./dist/services/DisputeResolver.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias && node ../../scripts/fix-esm-imports.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache src && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^2.0.0"
  }
}
