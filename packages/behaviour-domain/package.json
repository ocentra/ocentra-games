{
  "name": "@ocentra/behaviour-domain",
  "version": "1.0.0",
  "type": "module",
  "description": "Unity-like lifecycle base class (ReactBehaviour) and React hooks. Enables ScriptableObject/asset untanglement.",
  "exports": {
    "./ReactBehaviour": {
      "types": "./dist/ReactBehaviour.d.ts",
      "import": "./dist/ReactBehaviour.js",
      "default": "./dist/ReactBehaviour.js"
    },
    "./BehaviourHost": {
      "types": "./dist/BehaviourHost.d.ts",
      "import": "./dist/BehaviourHost.js",
      "default": "./dist/BehaviourHost.js"
    },
    "./hooks/useBehaviour": {
      "types": "./dist/hooks/useBehaviour.d.ts",
      "import": "./dist/hooks/useBehaviour.js",
      "default": "./dist/hooks/useBehaviour.js"
    },
    "./hooks/useBehaviourState": {
      "types": "./dist/hooks/useBehaviourState.d.ts",
      "import": "./dist/hooks/useBehaviourState.js",
      "default": "./dist/hooks/useBehaviourState.js"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "react": "^19.1.1"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-imports.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache src && tsc --noEmit",
    "lint:eslint": "eslint --cache src",
    "lint:fix": "eslint --cache src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
