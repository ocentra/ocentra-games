{
  "name": "@ocentra/card-game-ui",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./CardGamePreviewSurface": {
      "import": "./dist/CardGamePreviewSurface.js",
      "types": "./dist/CardGamePreviewSurface.d.ts"
    },
    "./CardGameDesignStudioWorkbench": {
      "import": "./dist/CardGameDesignStudioWorkbench.js",
      "types": "./dist/CardGameDesignStudioWorkbench.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-css.mjs && node ../../scripts/fix-esm-imports.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint --cache src && tsc --noEmit",
    "lint:eslint": "eslint --cache src",
    "lint:fix": "eslint --cache src --fix"
  },
  "dependencies": {
    "@ocentra/game-layout-domain": "file:../game-layout-domain",
    "@ocentra/game-ui-types": "file:../game-ui-types",
    "react": "^19.1.1"
  },
  "peerDependencies": {
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.15.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^2.0.0"
  }
}
