{
  "name": "@ocentra/credentials-domain",
  "version": "1.0.0",
  "type": "module",
  "description": "Secret adapter contract – types only. Each platform provides its own implementation.",
  "exports": {
    "./SecretAdapter": {
      "types": "./dist/SecretAdapter.d.ts",
      "import": "./dist/SecretAdapter.js",
      "default": "./dist/SecretAdapter.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias && node ../../scripts/fix-esm-imports.mjs",
    "prepare": "npm run build",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache src && tsc --noEmit",
    "lint:eslint": "eslint --cache src",
    "lint:fix": "eslint --cache src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.15.0"
  }
}
