                    "build":  "tsc \u0026\u0026 node ../../scripts/fix-esm-imports.mjs \u0026\u0026 node -e \"const fs=require(\u0027fs\u0027);const path=require(\u0027path\u0027);[[\u0027src/tokens.css\u0027,\u0027dist/\u0027],[\u0027src/Footer/GameFooter.module.css\u0027,\u0027dist/Footer/\u0027],[\u0027src/Header/BaseHeader.module.css\u0027,\u0027dist/Header/\u0027],[\u0027src/Header/GameHeader.module.css\u0027,\u0027dist/Header/\u0027],[\u0027src/Header/EditorHeader.module.css\u0027,\u0027dist/Header/\u0027],[\u0027src/Header/EditorPageHeader.module.css\u0027,\u0027dist/Header/\u0027],[\u0027src/Header/ProfilePictureModal.module.css\u0027,\u0027dist/Header/\u0027],[\u0027src/Header/HeaderHomeButton.module.css\u0027,\u0027dist/Header/\u0027],[\u0027src/Header/ProfileMenu.module.css\u0027,\u0027dist/Header/\u0027],[\u0027src/Common/FeaturedGameCarousel/FeaturedGameCarousel.css\u0027,\u0027dist/Common/FeaturedGameCarousel/\u0027],[\u0027src/Common/ComingSoonCarousel/ComingSoonCarousel.css\u0027,\u0027dist/Common/ComingSoonCarousel/\u0027],[\u0027src/Common/ExploreGamesPanel/ExploreGamesPanel.css\u0027,\u0027dist/Common/ExploreGamesPanel/\u0027],[\u0027src/Common/GameBadgesOverlay/GameBadgesOverlay.css\u0027,\u0027dist/Common/GameBadgesOverlay/\u0027],[\u0027src/GamesExplorer/GameCard.css\u0027,\u0027dist/GamesExplorer/\u0027],[\u0027src/GamesExplorer/GameListRow.css\u0027,\u0027dist/GamesExplorer/\u0027],[\u0027src/GamesExplorer/ExplorerContentBar.css\u0027,\u0027dist/GamesExplorer/\u0027],[\u0027src/GamesExplorer/ExplorerSidebar.css\u0027,\u0027dist/GamesExplorer/\u0027]].forEach(([s,d])=\u003e{fs.mkdirSync(d,{recursive:true});fs.copyFileSync(s,d+path.basename(s));});\"",
                    "type-check":  "tsc --noEmit",
                    "lint":  "node -e \"const cmd = process.env.TURBO_HASH ? \u0027npm run lint:exec\u0027 : \u0027npx turbo run lint:exec --filter=@ocentra/core-ui\u0027; require(\u0027child_process\u0027).spawnSync(cmd.split(\u0027 \u0027)[0], cmd.split(\u0027 \u0027).slice(1), { stdio: \u0027inherit\u0027, shell: true });\"",
