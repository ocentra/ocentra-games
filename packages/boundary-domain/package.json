{
    "name":  "@ocentra/boundary-domain",
    "version":  "1.0.0",
    "type":  "module",
    "description":  "Single source of truth for names and values that app, Cloudflare worker, and Firebase must agree on (bucket names, path prefixes, collection names).",
    "exports":  {
                    "./constants/buckets":  {
                                                "import":  "./dist/constants/buckets.js",
                                                "types":  "./dist/constants/buckets.d.ts"
                                            },
                    "./constants/bucket-paths":  {
                                                     "import":  "./dist/constants/bucket-paths.js",
                                                     "types":  "./dist/constants/bucket-paths.d.ts"
                                                 },
                    "./constants/firestore-collections":  {
                                                              "import":  "./dist/constants/firestore-collections.js",
                                                              "types":  "./dist/constants/firestore-collections.d.ts"
                                                          },
                    "./constants/do-storage-prefixes":  {
                                                            "import":  "./dist/constants/do-storage-prefixes.js",
                                                            "types":  "./dist/constants/do-storage-prefixes.d.ts"
                                                        },
                    "./constants/kv-key-prefixes":  {
                                                        "import":  "./dist/constants/kv-key-prefixes.js",
                                                        "types":  "./dist/constants/kv-key-prefixes.d.ts"
                                                    },
                    "./contracts/Interface":  {
                                                  "import":  "./dist/contracts/Interface.js",
                                                  "types":  "./dist/contracts/Interface.d.ts"
                                              },
                    "./contracts/Implements":  {
                                                   "import":  "./dist/contracts/Implements.js",
                                                   "types":  "./dist/contracts/Implements.d.ts"
                                               },
                    "./types/asset-identifiers":  {
                                                      "import":  "./dist/types/asset-identifiers.js",
                                                      "types":  "./dist/types/asset-identifiers.d.ts"
                                                  },
                    "./types/asset-category":  {
                                                   "import":  "./dist/types/asset-category.js",
                                                   "types":  "./dist/types/asset-category.d.ts"
                                               },
                    "./types/provider-type":  {
                                                  "import":  "./dist/types/provider-type.js",
                                                  "types":  "./dist/types/provider-type.d.ts"
                                              },
                    "./types/resource-entry":  {
                                                   "import":  "./dist/types/resource-entry.js",
                                                   "types":  "./dist/types/resource-entry.d.ts"
                                               },
                    "./types/asset-metadata":  {
                                                   "import":  "./dist/types/asset-metadata.js",
                                                   "types":  "./dist/types/asset-metadata.d.ts"
                                               },
                    "./types/resource-request":  {
                                                     "import":  "./dist/types/resource-request.js",
                                                     "types":  "./dist/types/resource-request.d.ts"
                                                 },
                    "./types/asset-entry":  {
                                                "import":  "./dist/types/asset-entry.js",
                                                "types":  "./dist/types/asset-entry.d.ts"
                                            },
                    "./types/scan-response":  {
                                                  "import":  "./dist/types/scan-response.js",
                                                  "types":  "./dist/types/scan-response.d.ts"
                                              }
                },
    "scripts":  {
                    "build":  "tsc \u0026\u0026 tsc-alias \u0026\u0026 node ../../scripts/fix-esm-imports.mjs",
                    "type-check":  "tsc --noEmit",
                    "lint":  "node -e \"const cmd = process.env.TURBO_HASH ? \u0027npm run lint:exec\u0027 : \u0027npx turbo run lint:exec --filter=@ocentra/boundary-domain\u0027; require(\u0027child_process\u0027).spawnSync(cmd.split(\u0027 \u0027)[0], cmd.split(\u0027 \u0027).slice(1), { stdio: \u0027inherit\u0027, shell: true });\"",
                    "lint:exec":  "eslint --cache src \u0026\u0026 tsc --noEmit",
                    "lint:eslint":  "eslint --cache src",
                    "lint:fix":  "eslint --cache src --fix"
                },
    "dependencies":  {
                         "@ocentra/schema-domain":  "file:../schema-domain"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.15.0",
                            "eslint":  "^9.15.0",
                            "globals":  "^15.12.0",
                            "tsc-alias":  "^1.8.16",
                            "typescript":  "^6.0.2",
                            "typescript-eslint":  "^8.58.0"
                        }
}
