{
  "name": "@ocentra/solana-domain",
  "version": "1.0.0",
  "type": "module",
  "description": "Solana client services: Merkle batching, circuit breaker, rate limiter, memo anchor, error handling, transaction handling. Shared by main app and scripts.",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@ocentra/ai-domain": "file:../ai-domain",
    "@ocentra/crypto-domain": "file:../crypto-domain",
    "@ocentra/eventing-domain": "file:../eventing-domain",
    "@ocentra/logging-domain": "file:../logging-domain",
    "@ocentra/verification-domain": "file:../verification-domain",
    "@solana/spl-memo": "^0.2.5",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.1"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": ">=0.29.0",
    "@solana/web3.js": ">=1.87.0",
    "@solana/spl-memo": ">=0.4.0",
    "bn.js": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@coral-xyz/anchor": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": false
    },
    "@solana/spl-memo": {
      "optional": true
    },
    "bn.js": {
      "optional": true
    }
  },
  "exports": {
    "./MerkleBatching": {
      "import": "./dist/MerkleBatching.js",
      "types": "./dist/MerkleBatching.d.ts"
    },
    "./ErrorHandler": {
      "import": "./dist/ErrorHandler.js",
      "types": "./dist/ErrorHandler.d.ts"
    },
    "./CircuitBreaker": {
      "import": "./dist/CircuitBreaker.js",
      "types": "./dist/CircuitBreaker.d.ts"
    },
    "./RateLimiter": {
      "import": "./dist/RateLimiter.js",
      "types": "./dist/RateLimiter.d.ts"
    },
    "./MemoAnchor": {
      "import": "./dist/MemoAnchor.js",
      "types": "./dist/MemoAnchor.d.ts"
    },
    "./TransactionHandler": {
      "import": "./dist/TransactionHandler.js",
      "types": "./dist/TransactionHandler.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./interfaces": {
      "import": "./dist/interfaces.js",
      "types": "./dist/interfaces.d.ts"
    },
    "./SolanaAnchorService": {
      "import": "./dist/SolanaAnchorService.js",
      "types": "./dist/SolanaAnchorService.d.ts"
    },
    "./AnchorClient": {
      "import": "./dist/AnchorClient.js",
      "types": "./dist/AnchorClient.d.ts"
    },
    "./GameClient": {
      "import": "./dist/GameClient.js",
      "types": "./dist/GameClient.d.ts"
    },
    "./SolanaEventBridge": {
      "import": "./dist/SolanaEventBridge.js",
      "types": "./dist/SolanaEventBridge.d.ts"
    },
    "./MatchEventCollector": {
      "import": "./dist/MatchEventCollector.js",
      "types": "./dist/MatchEventCollector.d.ts"
    },
    "./BatchManager": {
      "import": "./dist/BatchManager.js",
      "types": "./dist/BatchManager.d.ts"
    },
    "./CoordinatorWalletPool": {
      "import": "./dist/CoordinatorWalletPool.js",
      "types": "./dist/CoordinatorWalletPool.d.ts"
    },
    "./MatchCoordinator": {
      "import": "./dist/MatchCoordinator.js",
      "types": "./dist/MatchCoordinator.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias && node ../../scripts/fix-esm-imports.mjs",
    "type-check": "tsc --noEmit",
    "lint": "npm run lint:exec && npm run type-check",
    "lint:exec": "eslint --cache src tests",
    "lint:eslint": "eslint --cache src tests",
    "lint:fix": "eslint --cache src tests --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@types/bn.js": "^5.1.6",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^2.0.0"
  }
}
