{
  "name": "@ocentra/data-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "db:init": "npm run db:init --prefix ../card-games",
    "db:migrate": "npm run db:migrate --prefix ../card-games",
    "ingest:json-files": "npm run ingest:json-files --prefix ../card-games",
    "ingest": "npm run ingest --prefix ../card-games",
    "names-audit": "npm run names-audit --prefix ../card-games",
    "start": "vite"
  },
  "dependencies": {
    "@ocentra/card-games": "file:../card-games",
    "@ocentra/endpoint-domain": "file:../endpoint-domain",
    "@ocentra/game-domain": "file:../game-domain",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "duckdb": "^1.1.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "typescript-eslint": "^8.15.0",
    "@types/node": "^20.19.33",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
