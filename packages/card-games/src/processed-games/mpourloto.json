  "quality": "complete",
  "overview": {
    "description": "Mpourloto (also spelled Bourloto) is a Greek trick-taking game closely related to French Belote. It is played by four players in partnerships using a 32-card deck. The game features bidding for trumps, declaring melds for bonus points, and a unique scoring system where the trump makers must outscore their opponents or lose all points to them ('mesa').",
    "category": "Trick-taking",
    "subCategory": "Belote Family",
    "origin": "Greece",
    "players": {
      "minPlayers": 4,
      "maxPlayers": 4,
      "recommendedPlayers": 4,
      "display": "4"
    },
    "deck": "32-card deck (Piquet pack)",
    "difficulty": "Intermediate",
    "duration": "30-45 minutes",
    "hasPlaceholders": false,
    "playerMode": "multiplayer",
    "originName": "Mpourloto (μπουρλότο)"
  },
  "history": {
    "originCountries": ["Greece"],
    "origins": "Mpourloto is derived from French Belote, which spread throughout Europe in the 20th century. The Greek variant developed its own scoring and meld rules, distinguishing it from the French original.",
    "timeline": [
      "Early 20th Century: Belote spreads to Greece",
      "Mid-20th Century: Greek rules formalize with unique scoring",
      "Present: Popular in Greece and among Greek communities abroad"
    ],
    "evolution": "The key differences from Belote include: different meld values, all melds count (not just the highest), the 'mesa' rule for failed contracts, and the ability to choose any suit in the second bidding round.",
    "cultural": "A popular social game in Greece, played in cafes (kafeneia), homes, and clubs. The game is part of the Greek card-playing tradition alongside games like Prefa and Biriba.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 players in fixed partnerships, partners sitting opposite each other.",
    "deck": "32-card pack (7 through Ace in each suit: Hearts, Diamonds, Clubs, Spades).",
    "equipment": "32-card deck, score sheet.",
    "dealing": "5 cards to each player, one at a time. The next card is turned face up to propose trumps. After bidding, 3 more cards are dealt to each player.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Be the first partnership to reach 1000 points by winning tricks, capturing valuable cards, and declaring melds.",
    "gameplay": "Player left of dealer leads. Must follow suit if possible. If unable, must play a trump. Must beat the highest card played so far if possible (overtaking is compulsory).",
    "keyRules": [
      "Jack and 9 of trumps are highest cards",
      "All melds count toward score",
      "Must follow suit, must trump if void",
      "Must overtake if possible",
      "Mesa: failed contract gives all points to opponents"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Bid with strong hands, especially with good trump support. Declare all melds. Try to capture the trump Jack and 9.",
    "intermediate": "Consider the Mesa risk when bidding - a failed contract is devastating. Coordinate with partner through card play. Save high trumps for important tricks.",
    "advanced": "Card counting is essential. Track trumps and high cards. Understand when to sacrifice a trick to set up future wins. Master the compulsory overtaking rules.",
    "tips": [
      "The trump Jack (20 points) is the most valuable single card",
      "Don't bid unless you have strong trump support or a good meld",
      "Mesa can swing hundreds of points - bid carefully",
      "Sequences are valuable - look for consecutive cards in the same suit",
      "The King-Queen of trumps (Mpourloto) gives a 20-point meld"
    ],
    "hasPlaceholders": false
  },
