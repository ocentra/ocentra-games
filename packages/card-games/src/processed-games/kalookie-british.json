  "history": {
    "origins": "Believed to have roots in the Jewish communities of London and New York in the mid-20th century. It shares ancestry with games like Vatikan and Rummy 51.",
    "originCountries": ["UK", "USA"],
    "timeline": [
      "1920s: Rummy becomes globally popular; 2-deck variants emerge.",
      "1950s: Kalooki 40 and Kalooki 51 become standardized in UK bridge and card clubs.",
      "1990s: Online Kalooki sites popularize the British ruleset.",
      "Present: A staple tournament game in the UK and European Rummy circles."
    ],
    "evolution": "The major innovation in the British version is the 'Joker Swap'â€”the ability to replace a Joker in a meld with the natural card, a feature less common in other Rummy styles.",
    "cultural": "Often played in competitive bridge clubs as a less formal but equally strategic alternative.",
    "hasPlaceholders": false
  },
