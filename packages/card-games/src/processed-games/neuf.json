    "dealing": "13 each + 13-card spare hand (Chômeur).",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Reach a score of zero by making more than your quota of four tricks per deal; each extra trick subtracts one point, each trick below quota adds one point.",
    "gameplay": "Rotating trumps: ♥-♦-♣-♠-NT cycle. May swap entire hand with Chômeur (first refusal passes right). Follow suit, trump if void. Quota=4 tricks: above=-1pt, below=+1pt. Win all 13=instant win (-9pts).",
    "keyRules": [
      "Start at 9",
      "Chômeur hand swap option",
      "Rotating trump cycle",
      "Quota of 4 tricks",
      "Win all 13 = instant -9"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Swap with weak Chômeur showing.",
    "intermediate": "Trump cycle awareness.",
    "advanced": "All-13 attempts.",
    "tips": [
      "Watch the Chômeur hand exposed before deciding to swap.",
      "Remember the rotating trump cycle to plan ahead.",
      "Track tricks taken vs. quota of 4 to manage score changes.",
      "Attempting to win all 13 tricks gives instant -9 victory."
