  "history": {
    "origins": "Le Neuf is a trick-taking game from Eastern Canada, played mainly in French-speaking Quebec (as Le Neuf or Chômeur) and by Acadians in Nova Scotia, and in Newfoundland and Eastern Ontario under the name Nines. It belongs to the quota-whist family; the name refers to each player starting with 9 points.",
    "originCountries": ["Canada"],
    "timeline": ["20th century: Played in Quebec, Acadian regions and Newfoundland (Eastern Canada)."],
    "evolution": null,
    "cultural": "Popular in Quebec and Acadian communities.",
