    "nullReasons": {
      "evolution": "No documented evolutionary changes; game emerged as a stable tradition."
    }
  },
  "setup": {
    "players": "3 (4 with partnerships)",
    "deck": "52 cards. A high. 13 each + 13-card Chômeur.",
