  "rules": {
    "objective": "Score best under the table's collection goal while attempting to shed tiles efficiently.",
    "gameplay": "Players place legal matching tiles to open ends. Collection scoring is applied based on the table's defined collected outcomes during play or at hand end. The hand ends when a player goes out or play blocks.",
    "keyRules": [
      "All placements must be legal matches to open ends of the shared layout.",
      "Collection scoring is applied by table rule profile to define what is collected and when.",
      "Hand ends on first empty hand or complete block resolution."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Avoid wasting flexible tiles unless they contribute to the collection goal.",
    "intermediate": "Track what has already been collected to plan the remaining value routes.",
    "advanced": "Shape end values to force opponents away from profitable collection outcomes.",
    "tips": [
      "Do not sacrifice hand flexibility just to chase marginal collection points.",
      "When ahead, prioritize safe shedding lines to avoid late blocks."
    ],
