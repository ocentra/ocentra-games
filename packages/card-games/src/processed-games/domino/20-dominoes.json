  "setup": {
    "players": "Two or more players.",
    "deck": "Double-six domino set (28 tiles)",
    "equipment": "Double-six domino set, chips or stakes",
    "dealing": "Banker chosen (e.g. by drawing highest tile). Players buy tiles from the banker for a stake; max nine tiles per hand.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Reach a total of 20 or 21 (or as close as possible without busting) to beat the banker. Stick to stop; bust if over 21 and lose the wager.",
    "gameplay": "Players take turns buying tiles from the banker, keeping a running total. Beyond the first two tiles, one tile is turned face-up so each player has two face-down and the rest face-up. Stick to stop; bust if over 21. Banker then draws without exceeding 21; banker bust pays all remaining players; otherwise banker collects from lower or equal totals and pays higher.",
    "keyRules": [
      "Aim for 20 or 21; bust over 21",
      "Max nine tiles per hand",
      "Blank = 0 or 7",
      "Banker draws last; settles with each player"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Stop when you are close to 21 and the banker may bust; avoid taking tiles that risk busting. Remember blank can be 0 or 7 to flex your total.",
    "intermediate": "Consider how many tiles the banker has drawn and visible totals; more tiles in your hand multiplies payout (squared) so sometimes taking one more tile is worth the bust risk.",
    "advanced": "Double-blank + one tile for exactly 21 with three tiles beats everything; aim for that when the stake is high.",
    "tips": [
      "Blank counts 0 or 7—use it to land on 20 or 21.",
      "21 with exactly three tiles including double-blank beats the banker even if banker has 21.",
      "Payout is stake × (tiles in hand)²—more tiles = much higher payoff.",
      "Stick when your total is strong and banker might bust."
    ],
    "hasPlaceholders": false
  },
