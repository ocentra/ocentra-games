  "history": {
    "origins": "Domino banking game; aim for 20 or 21 (like blackjack) vs banker. Tiles drawn, pip total; blank often 0 or 7. Payout may multiply by tiles in hand (e.g. squared).",
    "originCountries": ["China", "France"],
    "timeline": [
      "Modern era: described in Western sources as a blackjack-style domino banking game using a double-six set and aiming for totals of 20 or 21 against a banker."
    ],
    "evolution": null,
