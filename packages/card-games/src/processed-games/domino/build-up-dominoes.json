  "history": {
    "originCountries": ["Unknown"],
    "origins": "Build-Up Dominoes is encountered as a modern expanded-supply connecting format that uses two standard domino sets to reduce early blocking and support larger tables.",
    "timeline": [
      "Modern era: circulated through social play and rules collections."
    ],
    "evolution": "Using two sets increases duplication of tiles, changing end-control and safety compared with a single-set game.",
    "cultural": "Played as a social table game where tile duplication changes inference and increases the value of flexible connectors.",
