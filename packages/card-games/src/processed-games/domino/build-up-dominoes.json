  },
  "setup": {
    "players": "2 to 8 players.",
    "deck": "Two double-6 domino sets shuffled together.",
    "equipment": "Domino sets and optional score tracking by table profile.",
    "dealing": "Deal tiles by player count; remaining tiles may form a boneyard by table profile.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Play legal tiles by matching exposed open ends and reach the hand-end condition defined by the table profile with the best resulting score.",
    "gameplay": "Players place one legal matching tile to an open end of the shared layout. When blocked, the table profile determines whether to draw from a boneyard or pass. Hands end when a player empties their hand or when the table becomes blocked, and scoring follows the table profile.",
    "keyRules": [
      "A tile placement must match the value of an open end.",
      "Blocked turns are resolved by a draw-or-pass table profile.",
      "Hand-end conditions and scoring depend on the match rules in use."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Preserve flexible connectors and avoid being left with high-pip tiles.",
    "intermediate": "Because duplicates exist, do not over-trust single-tile inference from discards and visible play.",
    "advanced": "Control the open ends to reduce opponent mobility while keeping your own exits available under duplication.",
    "tips": [
      "Duplicate tiles reduce certainty; play for robust safety rather than precise reads.",
      "Keep multiple matching options to avoid being trapped when the table shifts."
    ],
    "hasPlaceholders": false
  },
