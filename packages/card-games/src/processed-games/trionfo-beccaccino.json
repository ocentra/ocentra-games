  "history": {
    "origins": "Marafon-Beccaccino is characteristic of the Italian province of Romagna. It is a four-player partnership game based on Tressette with the addition of a trump suit. The first printed reference to Beccaccino appears in 1971 in Libero Ercolani's Vocabolario romagnolo-italiano (Ravenna). Earlier the game was known as \"tri sett cun el taj\" (Tressette with cutting). The composite name Marafon-Beccaccino was coined in Alteo Dolcini's Il Principe di Romagna (Imola, 1975), which codified official rules.",
    "originCountries": ["Italy"],
    "timeline": ["1971: First printed reference in Ercolani's Vocabolario romagnolo-italiano (Ravenna).", "1975: Dolcini's Il Principe di Romagna codifies rules (Imola)."],
    "evolution": "Tressette with trumps. Parent game of Trionfino.",
    "cultural": "The signature card game of Romagna.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 (partnerships)",
    "deck": "40 cards (Romagnole). Rank: 3-2-A-K-Kt-J-7-6-5-4. Values: A=1, 3/2/K/Kt/J=1/3.",
    "equipment": "Cards",
    "dealing": "10 cards each. 4â™¦ holder chooses trump.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Reach 41 points first with your partner; Maraffa and last-trick bonuses apply.",
    "gameplay": "Follow suit. Trump if void. 3-2-A ranking. Maraffa: Declare if holding A+2+3 trumps = 3 bonus pts. Communication: Busso (knock), Striscio (indicate 2), Tiro (indicate A). Total 11 pts/hand + Maraffa.",
    "keyRules": [
      "4â™¦ holder chooses trump",
      "Maraffa/Cricca = 3 bonus pts",
      "Signaling: Busso, Striscio, Tiro",
      "Game to 41"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Choose trump in longest/strongest suit. Declare Maraffa when eligible.",
    "intermediate": "Use legal signals to coordinate with partner.",
    "advanced": "Card counting across 10-trick hands. Manage the endgame for last-trick bonus.",
    "tips": [
      "3s are the most powerful cards.",
      "Last trick is worth fighting for."
    ],
