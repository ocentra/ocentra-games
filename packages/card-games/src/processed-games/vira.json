  "history": {
    "origins": "Vira is Sweden's national card game and the most elaborate of the Solo family (with Solo Whist and Préférence). Tradition holds it was invented around 1810 at Vira courthouse when a storm snowbound the court; two Walloon gentlemen are said to have devised it. It was the most advanced and popular card game in Sweden for a long time; popularity declined after Contract Bridge arrived in the early 1930s because Vira never became standardized like Skat.",
    "originCountries": ["Sweden"],
    "timeline": [
      ""
    ],
    "evolution": "Influenced Swedish language ('gÃ¥ bet' = fail, 'gask' = party).",
    "cultural": "Deeply embedded in Swedish culture.",
    "hasPlaceholders": false
  },
