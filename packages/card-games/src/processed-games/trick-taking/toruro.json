  "history": {
    "originCountries": ["Colombia"],
    "origins": "Toruro is a Colombian three-card gambling game, said to be popular in the state of Santander. Documented rules draw on information from Harry Viens and on the Toruro rules by Andres F Pabon published at thespiel.net. It belongs to the Rams group of trick-taking games.",
    "timeline": ["20th century: Documented as Colombian gambling game; rules by Andres F Pabon at thespiel.net."],
    "evolution": "Simple 3-trick gambling format.",
    "cultural": "Social gathering game.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Two or more players.",
    "deck": "40 cards. Rank: A-3-K-Kt-J-7-6-5-4-2.",
    "equipment": "Chips/counters for 3 pots",
    "dealing": "Deal 3 cards. Turn 1 card for trump.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Win tricks to claim the three pots (Cabeza, Barriga, Cola); players who go must win at least one trick or pay a lulo penalty.",
    "gameplay": "1. Deal 3 cards + 1 trump indicator. 2. Declare: Ir (go) or pass. Must win 1+ trick if going. 3. Exchange cards (0-3). If exchanging 3, get 4 and keep best 3. 4. Play 3 tricks. Follow suit. Must trump if void. 5. First trick: Must lead Ace of trumps if held. 6. Second trick: Must lead highest trump.",
    "keyRules": [
      "Three pots for three tricks",
      "Ir/Pass decision",
      "Must win 1+ trick if going (Lulo)",
      "Lead restrictions on tricks 1 and 2"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Only go with strong trumps. Ace of trumps guarantees one trick.",
    "intermediate": "Exchange to improve trump holding. Don't go unless you can guarantee one trick.",
    "advanced": "Calculate how many players went. More players going = harder to win a trick.",
