  "history": {
    "origins": "Ristikontra is a Finnish game for four players, popular in lumber camps, and is likely the original of the Sedma group. In that group, tricks are won by the last card of equal rank to the card led. These games are played only in a region from Lapland in the north to Hungary in the south; Ristikontra is the Finnish member of that Central European ace–ten family.",
    "originCountries": [
      "Finland"
    ],
    "timeline": [
      "20th century: Finnish Sedma-group variant documented; related to Central European Sedma, Hola, Zsírozás."
    ],
    "evolution": "Original of Sedma group.",
    "cultural": "Lumber camps.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 in partnerships.",
