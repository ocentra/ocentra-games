  },
  "rules": {
    "objective": "Take tricks containing point cards (A, 10, K, Q, J). Score at least 61 card points (more than half of 120) to win 1 game point; take all 120 to score 2 game points. First team to the target (usually 7) wins the match.",
    "gameplay": "1. Trick won by last card of same rank as led. 2. Draw from stock after each trick. 3. May play top stock 'in the dark'. 4. Cannot lead same rank four tricks in a row. 5. 60-60 = abeyance.",
    "keyRules": [
      "Last same-rank wins. Suits irrelevant.",
      "A=11, 10=10, K=4, Q=3, J=2.",
      "61+ = 1 pt; 120 = 2; target 7."
    ],
    "hasPlaceholders": false
  },
