  "history": {
    "origins": "Ristiklappi originates in northern Finland and Lapland as a more elaborate variant of Ristikontra within the Sedma group of games, in which tricks are won by the last card of the same rank as led. The Sedma family is confined to a region from Lapland to Hungary. The game was popular in lumber camps and is documented as a Finnish point-trick game with the distinctive clean rule (queen-taking requiring a later king-trick).",
    "originCountries": ["Finland"],
    "timeline": ["20th century: documented as Finnish Sedma variant in Lapland; related to Ristikontra."],
    "evolution": "More elaborate than Ristikontra; adds the clean rule and 5-card hand.",
    "cultural": "Lumber camps and rural Lapland; played in fixed partnerships.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 in partnerships.",
    "deck": "52 cards. No ranking; suits irrelevant.",
    "equipment": "Deck.",
    "dealing": "5 each; rest stock.",
