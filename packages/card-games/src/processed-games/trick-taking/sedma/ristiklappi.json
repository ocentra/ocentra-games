  },
  "rules": {
    "objective": "61+ card points; 'clean' if took queen in first part.",
    "gameplay": "1. Trick won by last card of same rank as led. 2. May play top stock card ('in the dark'). 3. Cannot lead same rank four tricks in a row. 4. Draw from stock after each trick. 5. Clean: if took queen before stock empty, must win trick with king (not by queen) in last 5 tricks. 6. Fail to clean = dishonourable loss.",
    "keyRules": [
      "Last same-rank card wins trick. Suits irrelevant.",
      "A=11, 10=10, K=4, Q=3, J=2. 120 pts total.",
      "Clean rule: queen in first part â†’ must win king-trick in last 5 (not by queen)."
    ],
    "hasPlaceholders": false
  },
