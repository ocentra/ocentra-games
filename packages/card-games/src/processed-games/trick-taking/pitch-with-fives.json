  },
  "history": {
    "origins": "Original Pedro had only one scoring five (9 points). Pitch with Fives preserves this. Judd A. Schorr; Catch Five in some regions.",
    "originCountries": ["USA"],
    "timeline": [
      "Pre-Pedro variant.",
      "Variant of Pitch (Setback) in which the trump five scores 5 points; described alongside Double Pedro and Cinch in rulebooks and online."
    ],
    "evolution": "Single five vs Double Pedro (both 5s).",
    "cultural": "USA regional.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 in partnerships. Partners opposite.",
    "deck": "Standard 52 cards.",
    "equipment": "52-card deck.",
    "dealing": "6 each. One round of bidding.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "First team to 31. Nine points per hand: high(1), low(1), jack(1), game(1), five(5).",
    "gameplay": "1. Bid min 2; dealer forced to bid min if all pass. Dealer can steal by equalling. 2. High bidder names trump. 3. All discard non-trumps. 4. Dealer refills to 6. 5. Play tricks. Must follow suit. 6. Trump 5 = 5 points to side that wins it.",
    "keyRules": [
      "Only one five scores: trump 5 (5 pts).",
      "9 points total: high, low, jack, game, five.",
      "Must follow suit (cannot trump freely).",
      "Purge non-trumps; refill to 6.",
      "31 to win."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Save trump to capture the five. Must follow suit restricts trumping.",
    "intermediate": "Purge reveals trump counts. Time the five capture.",
    "advanced": "Can start with no trump and pick up 3-5 in refill.",
    "tips": [
      "Must follow suit - cannot save 5 by trumping if you have led suit.",
      "Refill can change hand dramatically."
    ],
    "hasPlaceholders": false
  },
