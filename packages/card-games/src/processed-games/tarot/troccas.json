  "history": {
    "originCountries": [
      "Switzerland",
      "Italy"
    ],
    "origins": "Although the exact history is uncertain, Troccas is thought to have been imported from Italy to Switzerland in the seventeenth century. It took root in the Romansh-speaking Canton Grisons, especially the Surselva region from the Medel and Tujetsch valleys to Ilanz, and has been preserved there as a living tradition. In recent decades it has gained in popularity, with local clubs and tournaments; scholarly accounts include Carla Deplazes' work on Graubünden tarot and tournament rules from Savognin.",
    "timeline": [
      "17th century: Game arrived in Switzerland from Italy."
    ],
    "evolution": "Preserved in Romansh-speaking communities.",
    "cultural": "Recognized as living tradition of Switzerland.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 (partnerships)",
    "deck": "78 cards: 4 suits x 14 + 21 trumps + Fool. Points: K/Bagat/TrXXI/Fool=5, Q=4, Cav=3, J=2, others=1. Count in groups of 4, subtract 3. Total 72.",
    "equipment": "Cards",
    "dealing": "19 each (dealer gets 21, discards 2). Last card face up.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Score more card points than opponent team (target 36 to break even).",
    "gameplay": "Follow suit. Must trump if void. Fool excuses from following. King and Jack Rule: When King is first played in a suit, winner demands the Jack of that suit. Counterclockwise play.",
    "keyRules": [
      "King and Jack Rule (unique)",
      "Fool as excuse card",
      "Coded signals (Tschintschar)",
      "Dealer discards 2 from 21-card hand"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Play Kings early to trigger Jack Rule. Protect Honors (1, 21, Fool).",
    "intermediate": "Use Tschintschar to signal partner.",
    "advanced": "Manage trump count. Force opponent Honors out.",
