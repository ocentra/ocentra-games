  "history": {
    "originCountries": [
      "Hungary"
    ],
    "origins": "Part of the Central European Tarot tradition, which arrived in Hungary from Austria in the 19th century.",
    "timeline": [
      "1830s: Tarot games appear in Budapest's coffee houses.",
      "1890s: Modern Hungarian Tarokk rules (with bird imagery/Illustrated) solidify.",
      "1990s: Revival of organized Tarokk clubs in Hungary.",
      "Present: A prestigious strategic game with a dedicated player base."
    ],
    "evolution": "The game moved away from scoring purely on points in tricks to a more complex system of bonuses (like 'Pagat Ultimo' and 'XXI Catch').",
    "cultural": "In Hungary, Tarokk is often calling the 'game of kings' or 'aristocrats', requiring significant mental agility.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 players (2 vs 2 or 3 vs 1 depending on bidding).",
    "deck": "42 cards: 22 Trumps (labeled I to XXI + Skylark/Sküs) and 20 suit cards (King, Queen, Cavalier, Jack and 10/Ace).",
    "equipment": "",
    "dealing": "Deal in batches of 6 cards each.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Score game points through contracts and bonuses. The primary goal is usually to win the majority of points in tricks (12 or 16 points).",
    "gameplay": "1. Must follow suit. If unable, MUST play a trump.\n2. Standard trick-taking rules: highest trump wins, or highest suit card if no trumps.",
    "keyRules": [
      "Follow the legal action constraints defined for Hungarian Tarokk.",
      "Round outcome is resolved by the scoring method: Scoring summary: Scoring follows the game-specific point or pot rules.",
      "Winning condition: Score game points through contracts and bonuses."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Identify your partner early by observing who plays the XX. Conserve your high trumps to protect your partner's high-value cards.",
    "intermediate": "The 'Talon' swap: Use the talon to discard your 'voids' (suits you have none of) so you can trump in on those suits later.",
    "advanced": "Master the cue-bid language. Knowing that your partner has the XIX and the XXI allows you to signal aggressive play styles.",
    "tips": [
      "The 'Sküs' is the most powerful card as it is the only one that can 'catch' the XXI.",
      "Keep the lowest trump (I) for the final trick when possible; opponents may force it out earlier."
    ],
    "hasPlaceholders": false
