  "rules": {
    "objective": "Avoid taking tricks with point cards. Player reaching 21 penalty points LOSES.",
    "gameplay": "Same as Tressette play: Must follow suit. No trumps. Highest of led suit wins. But scoring is inverted â€” points are BAD.",
    "keyRules": [
      "Same play as Tressette",
      "Points are PENALTIES",
      "Cappotto reversal",
      "No Accuso (declarations)"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Avoid Aces (they're worth the most penalty). Dump high cards on others' leads.",
    "intermediate": "Deliberately go for Cappotto if you have overwhelming strength (reverses penalty to opponents).",
    "advanced": "Count points taken. Decide when to attempt Cappotto vs play safe.",
    "tips": [
      "Don't lead Aces.",
      "The last trick is worth 1 penalty point.",
      "Cappotto is a high-risk, high-reward move."
    ],
