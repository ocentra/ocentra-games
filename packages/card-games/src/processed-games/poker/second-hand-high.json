  "rules": {
    "objective": "Win the pot by having the second-best hand at showdown; the second-highest hand takes the entire pot.",
    "gameplay": "Deal and betting as in 7-card stud. At showdown, the second-highest five-card hand wins the pot. If all but one fold, that player wins. If there is a tie for first, none of those hands wins and the next highest hand takes the pot; if there is a tie for second, the equal hands split the pot.",
    "keyRules": [
      "Second-highest hand at showdown wins the pot",
      "Standard 7-card stud deal and betting",
      "Tie for first: next highest wins; tie for second: split pot"
    ],
    "hasPlaceholders": false
  },
