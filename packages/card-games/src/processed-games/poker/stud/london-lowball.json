    "originName": "London Lowball"
  },
  "history": {
    "originCountries": ["UK"],
    "origins": "Developed in the 1970s and 80s in London gaming clubs like the Victoria Casino ('The Vic'). It adapted American Razz rules to the British preference for Pot-Limit betting.",
    "timeline": [
      "1980s: Becomes a staple in London's high-stakes poker circuit.",
      "1990s: Differentiated from US Razz by the prevalence of Pot-Limit betting instead of Fixed-Limit.",
      "2000s: Gained international recognition through the Late Night Poker television show.",
      "Present: Still played in European mixed-games rotation (H.O.R.S.E. or similar)."
    ],
    "evolution": "The game moved from a 'side-show' in Stud circles to a primary game for 'action' players who enjoy the mathematical complexity of drawing to low hands.",
    "cultural": "In the UK, it is often called 'London Razz'.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Best with 6-8 players.",
    "deck": "Standard 52-card deck. No Jokers.",
    "equipment": "Standard deck, poker chips, dealer button.",
    "dealing": "Two cards face-down, one card face-up to begin. Subsequent rounds follow the 7-card stud pattern (4th, 5th, 6th streets up, 7th street down).",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Form the lowest possible 5-card hand. Straights and Flushes ARE NOT counted (California/A-5 Lowball rules).",
    "gameplay": "1. **Bring-In**: The player with the HIGHEST door card (1st up card) must pay a mandatory bring-in bet. 2. **Betting Rounds**: Five rounds of betting (starting after 3rd street). 3. **Showdown**: Players reveal 7 cards; best 5-card 'Low' hand wins.",
    "keyRules": [
      "Ace-to-Five lowball ranking: A-2-3-4-5 (Wheel) is best hand.",
      "Aces always low.",
      "Straights and flushes do not count against player.",
      "Highest door card pays bring-in (Ace is low, so King is worst).",
      "Pairs are badâ€”any no-pair hand beats any paired hand.",
      "Compare highest cards first when ranking hands.",
      "Traditionally played Pot-Limit."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Starting Hand Selection: Only play if your first three cards are both 8 or lower with no pair. If your hole card is paired with your upcard, or if you show a high card like a King or Queen, strongly consider folding.",
    "intermediate": "The 'Hidden' Low: If your two hole cards are an A and a 2, and your up-card is a Jack, your hand looks weak to opponents. Use this to induce bluffs from players with 'cleaner' 3rd-street up-cards.",
    "advanced": "Pot-Limit Pressure: Since it's Pot-Limit, if you have a lock on the low (e.g., you show 3-4-5-6 and hold an Ace), bet the maximum to force opponents who have 5-6-7-8 to either pay a premium or fold their second-best draws.",
    "tips": [
      "In Lowball, the Ace is your most valuable card. If you see three Aces showing among your opponents' up-cards, your own Ace-high draw becomes much stronger (as they are less likely to have an Ace in the hole).",
      "Don't chase a 9-low if the pot is large and your opponent is showing the potential for a 7-low. You are 'drawing dead' in many scenarios."
    ],
    "hasPlaceholders": false
  },
