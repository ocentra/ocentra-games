  "setup": {
    "players": "From two to eight players may take part, using a standard 52-card pack. The game is best with five to seven players. When eight play, the deck may run out toward the end of the deal, so five to seven is the recommended range for a full deal and betting structure as in standard seven-card stud.",
    "deck": "Standard 52-card deck. No jokers.",
    "equipment": "Chips; table space.",
    "dealing": "Same as 7-card stud: 2 down, 1 up, then 4 more (3 up, 1 down). Lowest hole card is wild for that player.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Make the best five-card poker hand from seven cards; your lowest hole card is wild for you.",
    "gameplay": "Betting rounds as in 7-card stud. At showdown, each player's lowest card in the hole is wild for that player only; use any five of seven for best hand.",
    "keyRules": [
      "Lowest hole card is wild for that player",
      "Wild can change when new hole cards are dealt",
      "Standard 7-card stud deal and betting"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Play when your hole cards give you a strong wild (e.g. low pair in hole becomes trips).",
    "intermediate": "Track which low cards are out; your wild may improve or worsen on later streets.",
    "advanced": "Variant-specific bluffing with visible low cards.",
