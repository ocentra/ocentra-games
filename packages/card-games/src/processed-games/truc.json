  "history": {
    "origins": "Truc probably originates from the end of the Middle Ages in Spain; the word means \"trick\" or to trick into false announcements in Valencian. It later migrated to France and is closely related to the old English game Put, first described by Cotton in The Compleat Gamester (1674). Truc is the basis of Truco, popular in Argentina, Uruguay, Venezuela, Paraguay and Brazil.",
    "originCountries": ["France", "Spain"],
    "timeline": ["15th century: Bluff trick-taking game originates in Spain; later migrates to France."],
    "evolution": "Spread from Iberian Peninsula to South America.",
    "cultural": "Still played in Occitania, Valencia, Basque Country.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "2 or 4 (partnerships)",
    "deck": "French: 32 cards (Piquet). Rank: 7-8-A-K-Q-J-10-9. Spanish: 22 cards. Rank: Aâ™ -Aâ™£-7â™ -7â™¦-3s-7s-6s-5s-4s.",
    "equipment": "Cards",
    "dealing": "Three cards each, one at a time, starting with the player to dealer's right. If the player to dealer's left taps the deck instead of cutting, dealer may deal one card each when neither team has more than 10 points.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Win two of the three tricks in each hand. The first player or partnership to reach 12 points wins the game.",
    "gameplay": "No trump. No suit obligation. Highest card wins (ANY suit). Equal-rank cards = spoilt trick. Players can propose raising stakes at any time. Opponent accepts or concedes.",
    "keyRules": [
      "7 is highest card (French)",
      "No trump, no suit obligation",
      "Spoilt tricks when equal cards",
      "Bluff/raise at any time"
