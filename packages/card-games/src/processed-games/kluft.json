  "quality": "complete",
  "overview": {
    "description": "Kluft (meaning 'Gap' or 'Clique') is the Dutch variant of the popular Israeli/Nepalese card game Yaniv. It is a draw-and-discard game where the objective is to reduce the total value of cards in your hand to as low a number as possible. Once a player reaches a threshold (usually 5 points or fewer), they can call 'Kluft' to end the round and claim victory, unless they are challenged by an 'Onderkluft'.",
    "category": "Shedding",
    "subCategory": "Two-Player Draw-and-Discard",
    "origin": "Netherlands (derived from Yaniv)",
    "originName": "Kluft (Nederlands)",
    "players": {
      "minPlayers": 2,
      "maxPlayers": 5,
      "recommendedPlayers": 2,
      "display": "2-5"
    },
    "deck": "54 cards (52 standard + 2 Jokers)",
    "difficulty": "Intermediate",
    "duration": "10-20 minutes",
    "hasPlaceholders": false,
    "playerMode": "multiplayer"
  },
  "history": {
    "origins": "Kluft emerged in the Netherlands in the late 20th century as travelers brought the game of Yaniv back from Israel and South Asia. It was localized with Dutch scoring penalties and the term 'Onderkluft' for the challenge.",
    "originCountries": ["Netherlands", "Israel"],
    "timeline": [
      "1980s: Yaniv spreads among international travelers.",
      "1990s: Gains a dedicated following in the Netherlands.",
      "2010s: Standardized rules for 'Kluft' appear in Dutch gaming circles.",
      "Present: Popular informal social game in cafes and homes across the Benelux region."
    ],
    "evolution": "The game's evolution in the Netherlands focused on the 'Onderkluft' penalty (15 points), which is more forgiving than some Israeli variants, encouraging more aggressive challenges.",
    "cultural": "In Dutch social play, 'Kluft' is synonymous with a quick, high-tension finish to an evening of cards.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "3 to 4 is the standard competitive format.",
    "deck": "54 cards (including 2 Jokers). Jokers are worth 0 points.",
    "equipment": "",
    "dealing": "Each player receives 5 cards. The rest form the stock pile.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Have the lowest hand value (sum of card ranks) when someone calls 'Kluft'.",
    "gameplay": "1. **Discard**: You may discard a single card, a set of identical ranks (e.g., three 8s), or a sequence of 3+ cards of the same suit.\n2. **Draw**: After discarding, you must draw either the top card from the stock or one of the cards discarded by the previous player.\n3. **Calling Kluft**: If your hand total is **5 or less**, you may call 'Kluft' at the start of your turn. You do not discard/draw; the round ends immediately.",
    "keyRules": [
      "Can discard single cards, sets, or sequences",
      "Must draw from stock or discard pile after discarding",
      "Call Kluft with 5 points or less",
      "Onderkluft: challenge if you have equal or lower points"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Keep Jokers. Since they are worth 0 points, they are the most valuable cards for reaching the 5-point threshold fast.",
    "intermediate": "The Discard Trap: If you have a low hand (e.g., 4 points), don't call Kluft immediately. Watch if the player after you draws a low card from the pile. If they do, they might be aiming for an Onderkluft challenge.",
    "advanced": "Sequence Disposal: Don't just discard single high cards. Wait until you have a sequence (e.g., 8-9-10 of Hearts) to dump 27 points in a single turn. This is the most efficient way to 'drop' your hand value toward the Kluft zone.",
    "tips": [
      "If you call Kluft with 0 points (two Jokers), you are almost immune to Onderkluft, as no one can have a lower total than 0.",
      "Be careful with the 50/100 point 'cut' rule. Sometimes taking a small penalty on purpose can land you exactly on 50, effectively reducing your total more than winning the round would."
    ],
    "hasPlaceholders": false
  },
