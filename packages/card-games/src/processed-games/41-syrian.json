  "history": {
  "origins": "This trick-taking game is often known as 400 (arba3meyeh). It is much played in Syria and to some extent in Lebanon; the name 400 does not arise in the scoring. The rules were documented from multiple contributors in the early 2000s.",
  "originCountries": [
    "Syria",
    "Lebanon"
  ],
  "timeline": [
    "Early 21st century: documented online as a popular Syrian partnership game, also played to some extent in Lebanon."
  ],
  "evolution": null,
  "cultural": "Much played in Syria and to some extent in Lebanon; considered a national game in the region.",
  "hasPlaceholders": false,
  "nullReasons": {
      "evolution": "No documented evolutionary changes; game emerged as a stable tradition."
  }
  },
  "setup": {
    "players": "Four players in two fixed partnerships; partners sit as in Bridge (North-South versus East-West).",
    "deck": "Standard 52-card pack, ranking A-K-Q-J-10 down to 2; Hearts is the permanent trump suit.",
    "equipment": "Deck, score sheet",
    "dealing": "13 cards each, dealt anticlockwise in batches of 1-2-2-2-2-2-2; dealer rotates anticlockwise.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "The partnership wins when one partner's score reaches or exceeds 41 points and the other partner's score is positive. If both partnerships reach this in the same deal, the one with the higher total wins.",
    "gameplay": "Hearts is permanent trump. Each player bids once (minimum 1 trick); the sum of all bid values must be at least 11 or hands are thrown in and the next player deals. Player to dealer's right leads; play is anticlockwise. Follow suit if possible; otherwise play any card. Highest trump or highest card of the suit led wins the trick. Bids 1–6 score face value if made, 7+ score double; failing scores minus the bid value.",
    "keyRules": [
      "Hearts trump",
      "Bids total 11+",
      "41 and partner positive"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Bid on strength.",
    "intermediate": "Bid on trick strength; count trumps (Hearts).",
    "advanced": "Same as 41 Exchange; partnership coordination.",
    "tips": [
      "Also 400/Arba3meyeh; Hearts trump; bids total 11+."
    ],
    "hasPlaceholders": false
  },
