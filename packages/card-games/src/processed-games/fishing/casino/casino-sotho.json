  "history": {
    "origins": "Sotho Casino is the Lesotho variant of the African Casino family, closely related to Swazi Casino (Eswatini) and South African Casino. It was documented by Jonathan Dushoff. The game shares the characteristic African Casino feature of face-up capture piles.",
    "originCountries": ["Lesotho"],
    "timeline": [
      "Traditional: Played for generations in Lesotho",
      "Modern: Documented by Jonathan Dushoff",
      "Current: Part of the Southern African Casino family"
    ],
    "evolution": "Sotho Casino follows the same evolutionary path as other African Casino variants, diverging from Anglo-American Casino by keeping captures face-up and allowing opponents to use the top card of capture piles in builds.",
    "cultural": "Played in Lesotho and surrounding areas. The game is part of the broader Southern African card game tradition. Lesotho is a mountainous kingdom completely surrounded by South Africa.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "2-4 players. 4 players play in fixed partnerships (partners opposite). Play is anticlockwise.",
    "deck": "Standard 52-card pack. Card values: 2-10=face value, J=11, Q=12, K=13, A=1 or 14.",
    "equipment": "Standard deck, score sheet",
    "dealing": "Similar to Swazi Casino: cut 4 cards for initial layout, deal all cards to players. Some variations in dealing rules exist between regions.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Capture cards from the layout. First player/team to reach target score wins.",
    "gameplay": "Core rules same as Swazi Casino: Captured cards kept face up in pile. Top card can be used by opponents in augmented builds. Must play exactly one card per turn. Can perform multiple build actions. Single builds (sum=value) and augmented builds (multiple sets with same value). Build owner must eventually capture. Drifting (using capturable card in build) allowed. Cannot capture directly from opponent's pile.",
    "keyRules": [
      "2-4 players, 4 in partnerships, anticlockwise",
      "Picture cards: J=11, Q=12, K=13, A=1/14",
      "4-card initial layout",
      "All cards dealt to players",
      "Captured cards face up",
      "Opponents can use top card of your pile",
      "Must play one card per turn",
      "Single and augmented builds",
      "Build owner must capture",
      "Drifting allowed"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Same as Swazi Casino: Capture when beneficial, build when you have the card, be careful about early captures.",
    "intermediate": "Focus on high-value builds (13s, 14s). Time captures to minimize opponent access to valuable top cards.",
    "advanced": "Complex build warfare. Creating build monopolies. Using opponent's capture pile against them. Partner signaling in partnership games.",
    "tips": [
      "High-value builds are powerful",
      "Early captures help opponents",
      "Build monopolies on aces (14) or kings (13)",
      "Watch what you leave on top of your pile",
      "Use drifting strategically"
    ],
    "hasPlaceholders": false
