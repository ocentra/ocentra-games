  "rules": {
    "objective": "Capture cards from the table by matching their values. Score points for specific captured cards and achievements.",
    "gameplay": "Players take turns playing one card from hand. A card can capture table cards of the same value, or combinations of table cards that sum to the played card's value. If no capture is possible, the card is added to the table.",
    "keyRules": [
      "Capture by matching card values",
      "Can capture combinations that sum to played card",
      "Building creates new capture values",
      "Sweep (clearing the table) scores bonus",
      "Score for specific cards and achievements"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Try to capture high-value cards (10 of Diamonds, 2 of Spades, Aces). Clear the table when possible for sweep bonuses. Remember which cards have been played.",
    "intermediate": "Use building to set up captures for your strong cards. Force opponents to leave valuable cards on the table. Track the distribution of spades.",
    "advanced": "Card counting is essential. Calculate probabilities of opponents holding specific cards. Use building and blocking to control the table. Time your sweeps for maximum advantage.",
    "tips": [
      "The 10 of Diamonds is usually the most valuable single card",
      "Clearing the table (sweep) gives a bonus point",
      "Track which spades have been played - most spades scores points",
      "Building can set up multiple captures but risks opponents stealing",
      "Aces are valuable both as captures and for scoring"
    ],
    "hasPlaceholders": false
  },
