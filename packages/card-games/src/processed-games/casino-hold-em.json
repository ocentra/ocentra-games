  "history": {
    "origins": "Casino Hold'em Poker was introduced by Stephen Au-Yeung in 2001. It was developed to capitalize on the enormous popularity of Texas Hold'em poker by creating a house-banked casino version.",
    "originCountries": ["USA"],
    "timeline": [
      "2000: Texas Hold'em experiences massive popularity boom",
      "2001: Stephen Au-Yeung introduces Casino Hold'em",
      "2000s: Game spreads to casinos worldwide",
      "Current: Popular in land-based and online casinos"
    ],
    "evolution": "The game was designed to offer Texas Hold'em-style play against the house. Unlike poker, there's no bluffing - it's a game of pure chance with house edge. A bonus bet on the player's hole cards plus flop was added as a side bet.",
    "cultural": "Popular in casinos globally due to Texas Hold'em's familiarity. The simple two-decision structure (fold or play 2x) makes it accessible to casual players.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Any number of players, each playing individually against the house/dealer. No player vs player action.",
    "deck": "Standard 52-card pack. Standard poker hand rankings apply.",
    "equipment": "Standard deck, casino chips, table with betting areas",
    "dealing": "Each player and dealer receive 2 hole cards face down. 5 community cards dealt in stages: 3-card flop (face up), turn, river.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Make a better 5-card poker hand than the dealer using your 2 hole cards and 5 community cards.",
    "gameplay": "Place ante bet (optional AA bonus side bet). Dealer gives 2 hole cards to each player and themselves. 3-card flop dealt face up. Decision: Fold (lose ante) OR Place play bet (2x ante amount). Turn and river dealt. Dealer reveals hole cards. Best 5-card hand from 7 cards wins. Dealer qualifies with pair of 4s or better.",
    "keyRules": [
      "Ante bet required to play",
      "Optional AA bonus side bet",
      "2 hole cards dealt to player and dealer",
      "3-card flop shown before decision",
      "Fold: lose ante",
      "Play: bet 2x ante to continue",
      "Turn and river dealt after play bet",
      "Best 5-card hand from 7 cards wins",
      "Dealer qualifies with pair of 4s or better",
      "Ante pays enhanced odds by hand strength",
      "Play bet pays even money (1:1) if won"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Always play with a pair or better. Fold with poor hands. The AA bonus is a side bet with high house edge - play only for entertainment.",
    "intermediate": "Optimal strategy is complex but generally: Play with any pair, any ace high, any king high with good kickers, and many queen-high hands. Fold weak hands that don't connect with the flop.",
    "advanced": "Fully optimal strategy involves considering all possible outcomes. Rough guideline: Call with about 60% of hands. The house edge is approximately 2.16% with optimal play. The AA bonus bet has much higher house edge (around 6-7%).",
    "tips": [
