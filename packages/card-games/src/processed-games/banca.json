  "history": {
    "origins": "Baccarat as a banking game is first documented in early 19th-century France, though later writers popularised a legend that it came from Italy. The modern casino form known as Punto Banco or Banca was developed in the mid-20th century at the Capri Casino in Havana, Cuba, before spreading to Las Vegas and other gambling centres.",
    "originCountries": ["France", "Italy", "Cuba"],
    "timeline": [
      "15th Century: 'Baccara' played in Italy with Tarot cards.",
      "19th Century: Becomes the preferred game of the French aristocracy.",
      "1950s: Introduced to the Sands Casino in Las Vegas, quickly becoming a symbol of high-stakes gambling.",
      "Present: Dominates Macau and Singapore casinos, making up over 70% of casino revenue in some regions."
    ],
    "evolution": "The transition from a choice-based game such as Chemin de Fer to the fixed-rule casino game now known as Punto Banco or Banca allowed casinos to speed up play and scale to large numbers of simultaneous bettors.",
    "cultural": "Famously associated with James Bond (though Bond originally played Chemin de Fer in the novels).",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Unlimited bettors; 1 Dealer/Banker.",
    "deck": "8 decks shuffled into a 'Shoe' (Sabbia).",
    "equipment": "Baccarat table, shoe, high-value chips, 'Cut' card.",
    "dealing": "Two cards are dealt face down to the Player (Punto) and two to the Banker (Banco). Depending on the totals, a third card may be dealt to either side based on fixed rules.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Predict which handâ€”Punto or Bancoâ€”will have a total closest to 9.",
    "gameplay": "Players place bets on Punto, Banco, or Tie. Two cards each to Punto and Banco; third card by fixed rules. Closest to 9 wins.",
    "keyRules": [
      "Tens and Faces are zero (Baccarat).",
      "No decision-making for players regarding card draws.",
      "A 'Tie' bet pays 8:1 or 9:1."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Always bet on the Banker. Statistically, the Banker hand wins slightly more often than the Player hand (45.8% vs 44.6%).",
    "intermediate": "Avoid the Tie bet. Despite the high payout, the house edge is over 14%, making it one of the worst bets in the casino.",
    "advanced": "Look for 'No Commission' tables. These tables pay 1:1 on Banker wins except for a specific banker total (usually 6), which pays 1:2. This slightly changes the optimal betting pattern.",
    "tips": [
      "Follow the 'Roadmap': Many players track past wins (Big Road, Small Road) looking for patterns, though outcomes are mathematically independent.",
      "Manage your bankroll. Baccarat is a high-speed game; losses can accumulate quickly."
    ],
    "hasPlaceholders": false
  },
