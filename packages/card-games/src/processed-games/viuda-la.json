    "difficulty": "Intermediate",
    "duration": "20-40 minutes",
    "hasPlaceholders": false,
    "playerMode": "multiplayer"
  },
  "history": {
    "origins": "Whisky Poker is an American commerce game described in late 19th- and early 20th-century card game books; players improve hands by exchanging with a common table hand. La Viuda is the Mexican version still played today, documented by John McLeod from Rudy Quezada. The name may originally have been La Vida (life), referring to the extra-life buyback chip.",
    "originCountries": ["Mexico", "United States"],
    "timeline": ["Late 19th–20th century: Whisky Poker in North American books.", "20th century: La Viuda played in Mexico as local variant."],
    "evolution": "Mexican La Viuda adds wild cards (jokers plus a rank tied to chip pool), counter-clockwise play, and the La Viuda buyback chip; otherwise follows Whisky Poker deal and exchange phases.",
    "cultural": "Popular social gambling game in Mexico; chip value agreed beforehand; last player with chips collects all money.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Four to seven players (best with that range).",
    "deck": "Standard 52-card pack plus two jokers; jokers are wild, and one rank is also wild according to the number of chips in the central pool (e.g. one chip = Aces wild).",
    "equipment": "Cards, chips (2-3 per player); one extra chip called La Viuda in the central pool.",
    "dealing": "Five cards each and a five-card spare hand (widow) dealt face down in the centre; deal and play proceed counter-clockwise.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Obtain the best five-card poker hand at showdown; avoid having the worst hand, which pays one chip to the pool. Last player left with chips wins all money paid for chips.",
    "gameplay": "Options: swap entire hand for widow (your old hand becomes new widow), swap 1 card, or knock. After knock = 1 final round for all. Showdown: worst hand loses 1 chip. 'La Viuda' = extra buyback chip (costs 2x). Out of chips = eliminated.",
    "keyRules": [
      "5-card widow exchange",
      "Full swap or 1-card swap",
      "Knock triggers final round",
      "La Viuda buyback chip",
      "Last player wins pot"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Swap for widow if hand is weak.",
    "intermediate": "Time your knock.",
    "advanced": "Track widow cards after swaps.",
