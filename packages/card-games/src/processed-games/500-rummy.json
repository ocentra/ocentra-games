  "rules": {
    "objective": "First to 500 points wins. Melds (sets and runs) score positive; unmelded cards in hand count negative. You may take any card from the discard pile but must take all cards above it and meld the drawn card immediately.",
    "gameplay": "Draw one from stock or take from discard (must take all above chosen card and meld that card). Lay melds; add to existing melds. Discard one. Go out by melding all; unmelded cards count negative. Jokers wild.",
    "keyRules": [
      "Draw from stock or take from discard (take all above, meld the taken card)",
      "Sets and runs; jokers wild",
      "First to 500 points wins"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Take from discard when you can use the card and the pile helps; avoid leaving useful cards on top for opponents.",
    "intermediate": "Track discards; go out when you can to leave opponents with negative points.",
    "advanced": "Dump high unmelded cards early; time going out to maximise opponent penalty.",
    "tips": [
      "Key twist: taking from discard requires taking all cards above your pick and melding the pick.",
      "Jokers are wild; melds score positive, hand negative."
    ],
    "hasPlaceholders": false
  },
