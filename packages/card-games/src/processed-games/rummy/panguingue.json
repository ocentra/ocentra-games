  "rules": {
    "objective": "Be first to meld 11 cards (10 hand + 1 draw). Conditions (valle cards, sequences to/from K or A) pay chips from other players immediately.",
    "gameplay": "1. Draw from stock or discard. 2. Meld sets (3+ same rank, same or mixed suits) and runs (3+ in suit). Aces/Kings can form sets across suits. 3. Discard one. 4. If from discard, must meld immediately. 5. Conditions: melds with 3s, 5s, 7s (valle) or runs ending in K or starting with A pay chips. 6. First to meld 11 wins the hand.",
    "keyRules": [
      "Eight 40-card decks; rank K-Q-J-7-6-5-4-3-2-A.",
      "Meld 11 cards to go out.",
      "Conditions (valle cards, ace/king sequences) pay chips immediately.",
      "Draw from discard = must meld that card.",
      "Ante before each hand."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Prioritize valle cards (3, 5, 7) for conditions. Build sets and runs early.",
    "intermediate": "Track which conditions have been paid. Block opponents by taking key discards.",
    "advanced": "Balance going out vs. collecting condition payouts. Read opponentsâ€™ melds.",
    "tips": [
      "Valle cards (3, 5, 7) drive chip income.",
      "Runs to King or from Ace pay extra.",
      "Drawing from discard forces immediate meld."
    ],
    "hasPlaceholders": false
