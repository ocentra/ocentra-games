  "rules": {
    "objective": "By drawing and discarding, form your cards into spreads (books of equal rank or runs in suit) or add to existing spreads. You win by getting rid of all your cards (tonk out or run out) or by having the lowest point count when someone drops (knocks).",
    "gameplay": "1. Check for Instant Win (49/50 points). 2. Draw (Stock/Discard). 3. Meld/Hit (Optional). 4. Discard. 5. Drop (Knock): Can be done before drawing if confident in low points. Opponents challenge.",
    "keyRules": [
      "Drop (Knock) mechanic",
      "Hitting opponent spreads",
      "Instant win hands (49/50)"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Drop if under 15 points early. Hit others to reduce hand size.",
    "intermediate": "Don't hold spreads in hand too long; play them to reduce count.",
    "advanced": "Bluffing by not dropping. Calculating 'Hit' potential.",
    "tips": [
      "Aces are valuable (low count).",
      "Watch who picks up discards."
    ],
