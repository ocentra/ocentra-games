    "equipment": "52-card deck.",
    "dealing": "Five cards each.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Make three pairs from your hand. Each turn draw one card from the stock or the discard pile, then discard one. Pairs stay in hand; no melding to the table. First player to hold and show three pairs wins.",
    "gameplay": "1. Draw one from stock or discard. 2. Discard one. 3. Pairs stay in hand. 4. When you have three pairs, show them to win.",
    "keyRules": [
      "Three pairs to win.",
      "Draw one, discard one.",
      "No melding to table until winning.",
      "First to show three pairs wins."
    ],
    "hasPlaceholders": false
  },
