  "history": {
    "origins": "Pitty Pat is the national card game of Belize. It is essentially a rummy game with a similar mechanism to Conquian: the objective is to make three pairs from a five-card hand. Full rules are documented on the Belizeans.com web site; a computer program for the game is available from Unique Games.",
    "originCountries": ["Belize"],
    "timeline": [
      "National card game of Belize; full rules at Belizeans.com; software from Unique Games."
    ],
    "evolution": "Simpler than standard rummy.",
    "cultural": "Belizean card game.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Two to four players use a standard 52-card pack. Each player receives five cards; deal and play proceed clockwise as described in the primary sources.",
