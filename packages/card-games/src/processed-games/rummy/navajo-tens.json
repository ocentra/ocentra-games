  "rules": {
    "objective": "Capture the most cards by making combinations that sum to 10.",
    "gameplay": "On your turn, play one card from your hand. Capture cards from the center that combine with your card to make 10 (e.g. play 7, capture 3). Multiple cards can be captured if their sum equals 10. If you cannot capture, add your card to the center. Draw to replenish after each play.",
    "keyRules": [
      "Card values: A=1, 2-10=face value, J=Q=K=10",
      "Captures must sum to exactly 10",
      "If no capture possible, card is added to center layout",
      "Replenish hand after each play"
    ],
    "hasPlaceholders": false
  },
