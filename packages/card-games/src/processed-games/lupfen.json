  "history": {
    "originCountries": ["Austria", "Germany", "Liechtenstein"],
    "origins": "Originated in the Alpine regions of Switzerland and Bavaria in the 19th century. It evolved from older German trick-taking games like Schafkopf and Watten, adapting to local preferences and card decks.",
    "timeline": [
      "1800s: Lupfen emerges in Swiss and Bavarian taverns.",
      "1900s: Becomes a popular social game in rural Alpine communities.",
      "Mid-20th Century: Standardized rules established in Swiss card game circles.",
      "Present: Still played in traditional Swiss and German card clubs."
    ],
    "evolution": "The game developed its unique auction system and trump selection mechanics, distinguishing it from its parent games. The 36-card deck became standardized for this game.",
    "cultural": "Often played in taverns and at social gatherings in Alpine regions. The game is part of the cultural heritage of Swiss-German card playing.",
    "hasPlaceholders": false
  },
