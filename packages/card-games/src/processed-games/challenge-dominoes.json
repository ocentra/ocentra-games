  "rules": {
    "objective": "Play legal tiles by matching open ends and achieve the hand-end and scoring goals defined by the table profile.",
    "gameplay": "Players place one tile per turn to a legal open end of the shared layout. When blocked, the table profile determines whether to draw from a boneyard or pass. The hand ends when a player empties their hand or when no legal plays remain, and scoring follows the match rules in use.",
    "keyRules": [
      "A played tile must match an exposed open end value.",
      "Blocked turns resolve by the active draw-or-pass policy.",
      "Hand-end and scoring are table-profile dependent."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Keep flexible tiles and avoid being left with high-pip tiles when hands end.",
    "intermediate": "Duplicates reduce certainty, so prioritize moves that keep multiple responses available.",
    "advanced": "Control open ends to limit opponents while keeping safe exits, adjusting for lower-confidence inference.",
    "tips": [
      "Avoid over-committing to reads that assume unique tiles.",
      "Plan for mobility so a single blocked value does not strand your hand."
    ],
    "hasPlaceholders": false
  },
