  "quality": "complete",
  "overview": {
    "description": "Irish Don (specifically the Nine-card variant) is a popular Irish partnership trick-taking game. It is a point-trick game where specific cards (5s, 9s, Aces, etc.) have high values. It is unique for its 'Pitching' start, where the first card led sets the trump suit, and the rules prohibiting certain partners from seeing their cards until the game begins to prevent signaling.",
    "category": "Trick-taking",
    "subCategory": "Partnership",
    "origin": "Ireland",
    "players": {
      "minPlayers": 4,
      "maxPlayers": 4,
      "recommendedPlayers": 4,
      "display": "4 (Partnerships)"
    },
    "deck": "Standard 52-card deck",
    "difficulty": "Intermediate",
    "duration": "20-40 minutes",
    "hasPlaceholders": false,
    "playerMode": "multiplayer",
    "originName": "Don (Irish Don)"
  },
  "history": {
    "originCountries": ["Ireland"],
    "origins": "Part of the 'Don' family of games (related to Phat and All Fours). The 'Nine-card' version is particularly prevalent in the north and west of Ireland.",
    "timeline": [
      "1800s: Don variants develop in Britain and Ireland.",
      "Early 20th Century: The Nine-card version becomes standardized in Irish social clubs.",
      "Present: Still played in traditional 'Don leagues' in Ireland."
    ],
    "evolution": "The game evolved to focus on the 'Pitch' (the first lead) as a critical tactical decision that dictates the entire hand.",
    "cultural": "Known as a 'gentleman's game' where no signaling is allowed, and strict silence is often maintained during play.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 players in two partnerships sitting opposite.",
    "deck": "Standard 52-card deck. Ranking: A (High) to 2 (Low).",
    "equipment": "",
    "dealing": "Dealer deals 9 cards to each player (leaving 16 in the deck). The 'Pitcher' (the person who led the previous hand or won the cut) leads first.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Score a target total (usually 91 or 121 points) across multiple hands.",
    "gameplay": "1. Must follow suit. If unable, can trump or discard.\n2. Highest trump wins the trick; if no trump, highest card of suit led wins.",
    "keyRules": [
      "Follow the legal action constraints defined for Irish Don (Nine-card).",
      "Round outcome is resolved by the scoring method: Points are scored for capturing specific cards in tricks: - **Individual Card Points**: 5 of Trumps (10 pts), 9 of Trumps (9 pts), Ace (4), King (3), Queen (2), Jack (1).",
      "Winning condition: Score a target total (usually 91 or 121 points) across multiple hands."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Priority #1 is capturing the 5 and 9 of Trumps. These are worth almost 20% of the target score alone. Don't waste your high trumps on small tricks.",
    "intermediate": "The Lead: If you have a long suit with high cards, 'pitch' that suit as trump. This forces others to either trump (wasting their trumps) or lose to your long-suit power.",
    "advanced": "Defensive Pitching: If you have a very poor hand, lead a suit you have 'none' of, hoping your partner can win it and set a trump suit that favors them.",
    "tips": [
      "The '10' is huge for the 'Game' bonus (8 points). Don't ignore it.",
      "The partner of the pitcher must be patient; your hand is a 'blind' asset until the suit is set."
    ],
    "hasPlaceholders": false
  },
