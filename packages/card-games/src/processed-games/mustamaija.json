  "history": {
    "originCountries": ["Finland"],
    "origins": "Mustamaija originated in Finland. The name refers to the Queen of Spades, which is the 'losing' card. Despite the similar name, it is not related to the British game Black Maria (a Hearts variant).",
    "timeline": [
      "Traditional: Played for generations in Finland",
      "1993: Featured in 'Marjapussissa Porvooseen' by Pekka Ranta",
      "Present: Popular Finnish card game for all ages"
    ],
    "evolution": "The game has several variants dealing different numbers of initial cards and handling trumps differently.",
    "cultural": "A popular family game in Finland, enjoyed by both children and adults. The simple rules and quick play make it ideal for casual gaming.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Two to six players use a standard 52-card pack. Deal and play are clockwise. One player is the attacker and the player to their left is the defender; these roles shift as cards are beaten or picked up. The loser is the player left holding the Queen of Spades when all others have run out of cards.",
    "deck": "Standard 52-card deck. Ranking: A (high), K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2 (low).",
    "equipment": "Standard deck.",
    "dealing": "5 cards to each player (3 or 6 in some variants). Remaining cards form the talon. Turn up top card to determine trump suit (usually cannot be Spades).",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Avoid being the last player holding cards, particularly the Queen of Spades (Mustamaija).",
    "gameplay": "One player is the attacker, the player to their left is the defender. The attacker leads one or more cards of the same suit.",
    "keyRules": [
      "Queen of Spades (Mustamaija) cannot beat or be beaten",
      "Must follow suit if able when defending",
      "Trump can beat any non-trump",
      "Pick up unbeaten cards",
      "Last player with cards loses"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Try to get rid of all your cards. Save trumps for when you need them. Be careful with the Queen of Spades - you cannot get rid of her easily.",
    "intermediate": "Collect trumps early for the endgame. Watch what cards opponents pick up to know their holdings. Try to force opponents to pick up cards.",
    "advanced": "Card counting is valuable. Time your attacks to maximize cards played. In the endgame, minimize the number of suits in your hand. Know when to lead the Queen of Spades.",
    "tips": [
      "Collect trumps early - you will need them in the endgame",
      "The fewer suits you have in the endgame, the better",
      "Lead the Queen of Spades when you think the game will end before she returns",
      "If you beat all but one card, use a trump to get rid of the last one so you can lead next",
      "Watch what opponents pick up - it tells you their new cards"
    ],
    "hasPlaceholders": false
  },
