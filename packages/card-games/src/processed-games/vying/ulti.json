  },
  "history": {
    "origins": "Ulti is Hungary's national trick-taking game, related to Mariáš and ultimately derived from the old French game Mariage. Its name comes from the bid to win the last trick with the lowest trump (the 7), a feature found in Central European games like Trappola, Tapp Tarock, Tarokk and Alsós. The game developed from Talonmáriás (first mentioned in Hungary in 1787, described in 1883); the version with bidding is often called Rablóulti because players \"rob\" the two-card talon at each bid.",
    "originCountries": ["Hungary"],
    "timeline": ["1787: First mentioned in Hungary; 1883: First described as Talonmariaš; 1930: Potter described as ultimáriás."],
    "evolution": "One of Hungary's most popular games.",
    "cultural": "Central to Hungarian gaming culture.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "3 (12-10-10 deal)",
    "deck": "32 Hungarian cards. Rank: A-K-O-U-10-9-8-7. A=11, 10=10, K=4, O=3, U=2.",
    "equipment": "Cards, score sheet",
    "dealing": "12 to first, 10 each to others. First player discards 2 (talon).",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "The highest bidder becomes declarer and plays alone against the other two. The declarer must fulfill the contracted bid (e.g. score more card points than the defenders, win the last trick with the trump 7 in Ulti, take no tricks in Betli, or take all tricks in Durchmars). The defenders aim to prevent the declarer from fulfilling the contract.",
    "gameplay": "Bid: Passz(1), Ulti(4), 40-100(4), Betli(5), Durchmars(7), 20-100(8). Bids combinable. Kontra doubles stakes. Follow suit, must head, must trump. Last trick = 10 bonus. Silent achievements = half value.",
    "keyRules": [
      "Ulti: win last trick with trump 7",
      "Betli: take no tricks",
      "Durchmars: take all tricks",
      "Combinable bids",
      "Kontra system"
    ],
    "hasPlaceholders": false
  },
