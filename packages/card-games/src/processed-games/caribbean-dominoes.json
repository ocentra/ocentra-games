  "history": {
    "origins": "Domino games are enthusiastically played on many Caribbean islands. Typically the style of play is boisterous, and the pieces are slammed down on the table rather than placed gently. Most often there are four players in fixed partnerships. The rules vary from place to place; often the objective is for one team to win several rounds in a row (e.g. 4 or 6), which is characteristic of the Caribbean. Regional variants are documented for Jamaica (Partner and Cut Throat), Haiti, Puerto Rico (Chiva), and Cuba.",
    "originCountries": ["Jamaica", "Haiti", "Cuba", "Puerto Rico"],
    "timeline": ["Early 21st century: Played across Caribbean islands in partnership style; regional variants in Jamaica, Haiti, Cuba, Puerto Rico."],
    "evolution": null,
    "cultural": null,
    "nullReasons": {
      "evolution": "No documented evolutionary changes; game emerged as a stable folk tradition.",
      "cultural": "Played in Caribbean as a partnership domino pastime."
    },
