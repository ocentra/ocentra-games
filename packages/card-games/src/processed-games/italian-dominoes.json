    "players": "2 to 5 players.",
    "deck": "Double-6 set; tiles 0-0 through 6-6.",
    "equipment": "Double six set and equipment for keeping score.",
    "dealing": "Each player draws a hand of tiles (2 players: 8 each; 3: 7 each; 4 or 5: 4 each). One player is picked to lead the first round; lead passes to the left with each new hand.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Be the first to reach or pass 50 points by scoring when the cumulative pip total on the tableau hits exactly 30, 50, 70, or 100.",
    "gameplay": "Each turn a player either draws one tile from the boneyard or plays one tile face up on the tableau, announcing the new cumulative total of pips. The round ends when the total reaches 100 or more; there is no penalty for holding tiles. Rounds repeat until a player reaches or passes 50 points.",
    "keyRules": [
      "Each turn: draw one tile from the boneyard or play one tile to the tableau.",
      "Player announces the cumulative pip total after placing a tile.",
      "Score 1 pt at 30, 2 at 50, 4 at 70, 8 at 100 (to the player who laid that tile).",
      "Round ends when total is 100 or over; first to 50+ points wins the game."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Watch the cumulative total; jot it down or use a calculator until mental math is reliable.",
    "intermediate": "Draw when your hand is weak to trade a turn for better options; track when opponents might score.",
    "advanced": "To block an opponent from hitting a scoring total you can push the total over, but that may help them reach a higher total for more points.",
    "tips": [
      "Keep track of the running pip total.",
      "Drawing is often good when your hand is weak.",
      "Consider blocking scoring totals at the risk of giving a higher score later."
    ],
    "hasPlaceholders": false
  },
