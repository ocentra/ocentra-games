    "players": "2, 3, or 4. Each gets 24÷n cards (e.g. 2p=12 each, 4p=6 each).",
    "deck": "52 cards. Numeral 1–9 capture by sum to 10; Ten and pictures capture same rank only.",
    "equipment": "52-card deck; layout space for 4+ cards.",
    "dealing": "Deal 24÷n cards each. Four cards turned face up as initial layout. Rest face down.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Capture cards from the layout. Numeral cards capture one card that sums to 10 with them (A–9, e.g. 3 captures 7). Tens and pictures capture one card of same rank only. Each play or flip captures at most one card.",
    "gameplay": "Turn: play one card from hand. If it captures a layout card, take both to your pile; else add your card to layout. Then flip top of deck: if it captures, take both; else add to layout. Next player.",
    "keyRules": [
      "Capture: numeral + numeral = 10, or same rank for 10/J/Q/K",
      "One card captures at most one layout card",
      "After play and flip, turn passes"
    ],
    "hasPlaceholders": false
  },
