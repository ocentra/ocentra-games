  "rules": {
    "objective": "Bid 7-14; choose trump; win at least bid points. First to 62 wins.",
    "gameplay": "1. Bidding: one chance each, min 7 max 14. Dealer forced to bid 7 if all pass. 2. High bidder names trump. 3. All discard non-trumps. Dealer fills others to 6; dealer takes trumps from remainder (may have >6). 4. High bidder leads. 5. Trump rank: A-K-Q-J-10-9-8-7-5(pedro)-other 5(low pedro)-4-3-2. 6. Points: high(1), jack(1), ten(1), pedro(5), low pedro(5), low(1) = 14 total. Trump 2 point goes to holder's team.",
    "keyRules": [
      "Pedro = trump 5 (5 pts). Low pedro = other 5 same colour (5 pts).",
      "Bid 7-14. Must make bid or subtract from score.",
      "Discard non-trumps; refill to 6. Dealer takes all trumps.",
      "62 to win. Bidder goes out when both 55+.",
      "14 points in pack."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Cinch: trump with high card to stop pedro. Save scoring trumps.",
    "intermediate": "Bid according to trump strength. Bury non-scoring trumps.",
    "advanced": "Count points. Coordinate with partner via play.",
    "tips": [
      "Trump 2 point goes to holder's team regardless.",
      "Cannot bury scoring trumps.",
      "Slam (14) scores 28 if made, -14 if set (variant)."
    ],
    "hasPlaceholders": false
  },
