  "rules": {
    "objective": "First to 61. Score for A(5), K(4), Q(3), J(2) of trump; 7â™¦=7 when diamonds trump.",
    "gameplay": "1. Turn top of stock = trump for first trick. 2. Non-dealer leads. 3. Follow suit; higher wins (or trump). 4. Winner scores any scoring trump in trick. 5. Turn next stock card = trump for next trick. 6. Repeat. 7. No A or face = throw in, redeal. 8. 7â™¦ beats all diamonds when diamonds trump.",
    "keyRules": [
      "Trump changes every trick (from stock).",
      "7â™¦ (Peneech) = highest when diamonds trump; scores 7.",
      "A/K/Q/J trumps: 5/4/3/2.",
      "61 to win. Cribbage board.",
      "No Ace, no face = redeal."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Save scoring trumps for when that suit is trump.",
    "intermediate": "Lead to waste opponent's high trumps.",
    "advanced": "Count scoring cards; control stock turn.",
