  "history": {
    "origins": "A regional variant of traditional German trick-taking games like Skat and Schafkopf, but simplified to focus on specific cards.",
    "originCountries": ["Germany"],
    "timeline": [
      "19th Century: Folk variants of 'Hunting' games recorded in East Germany.",
      "20th Century: 'Young Hunter' standardized in game rule collections.",
      "Present: A niche regional game, often played in social clubs."
    ],
    "evolution": "The game's innovation is the 'Hits and Catches' system, where players must declare their targets before the round starts.",
    "cultural": "Reflects the common 'Jacks-as-Special' motif found in Skat and other German-suited card games.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 individual players.",
    "deck": "Standard 52-card deck. Ranking: A (High) to 2 (Low).",
    "equipment": "",
    "dealing": "Deal all 52 cards (13 per player).",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Collect the most 'Jacks' (Youngs) by capturing them in tricks.",
    "gameplay": "1. Standard trick-taking rules: must follow suit.\n2. **The Catch**: If you play a higher card of the suit led and an opponent plays a Jack on that trick, you 'catch' it for 2 points.\n3. **The Hit**: If you lead a Jack and no one can beat it with a higher card of the same suit, you 'hit' it for 2 points.",
    "keyRules": [
      "Follow the legal action constraints defined for Hunter.",
      "Round outcome is resolved by the scoring method: Scoring summary: Scoring follows the game-specific point or pot rules.",
      "Winning condition: Collect the most 'Jacks' (Youngs) by capturing them in tricks."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Save your Aces and Kings to specifically use on tricks where you suspect a Jack will be played. If you have a Jack, try to lead it when you've already depleted that suit in your opponents' hands.",
    "intermediate": "Bidding Strategy: Only declare a 'Hit' if you have the Jack and the Ace of the same suit. The Ace ensures you can stop anyone from overplaying your lead.",
    "advanced": "Tracking 'Youngs': Keep track of exactly which Jacks have been played. If three are gone, the final Jack becomes the primary target for all players.",
    "tips": [
      "If you are leading and have no Jacks, lead a suit where you have high cards to flush out an opponent's Jack.",
      "In the middle and end-game, avoid leading low cards, as it gives neighbors a free chance to dump their Jacks safely."
    ],
    "hasPlaceholders": false
  },
