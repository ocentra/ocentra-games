  "history": {
    "originCountries": [
      "Netherlands"
    ],
    "origins": "Pandoeren is a Dutch trick-taking game in the Jass (Ace-Ten) family. It used to be popular across the Netherlands and is still much played in Heerlen in the south. It shows resemblance to solo whist and klaverjas. Regional variants such as West Friesland and Tachtigen (University of Amsterdam) have different bids and scoring.",
    "timeline": [
      "Pre-1990s: Established Dutch game.",
      "1995: First published description in English (Nick Wedd, later edited by John McLeod).",
      "Present: Regional play; West Friesland and Tachtigen variants exist."
    ],
    "evolution": "West Friesland and Tachtigen have different bids and scoring.",
    "cultural": "Part of Dutch/Belgian Jass family.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Two or more players.",
    "deck": "33 cards: A-K-Q-J-10-9-8-7 in four suits + 6♥.",
    "equipment": "33-card pack. Forehand starts bidding.",
    "dealing": "4 each, 1 face-up in center, 4 each. Declarer picks up center card and discards one.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Win the contract. Number contracts: take at least bid points (tricks + roem + stuk). Other contracts: win/lose tricks as specified.",
    "gameplay": "1. **Bidding**: Forehand starts. Bids 120–220+, Piccolo, Misère, Kereltje, Zwabber, Solo-zwabber, Pandoer, Privé, etc. Three passes ends bidding. 2. **Declarer**: Picks center card, discards, names trump (if any), calls partner (ace or king). 3. **Play**: Follow suit or trump. Trump rank: J-9-A-K-Q-10-8-7-6. Non-trump: A-K-Q-J-10-9-8-7. Jas (trump J) never forced. 4. **Roem**: Sequences and four-of-a-kind announced; can be denied. Stuk (K-Q trumps) = 20.",
    "keyRules": [
      "33 cards. Declarer calls ace (or king if holds 4 aces) for partner.",
      "Trump: J-9-A-K-Q-10-8-7-6.",
      "Roem: sequences 3–8, four queens/kings/aces/jacks; denial possible.",
      "Stuk: K-Q of trumps = 20.",
      "146 card-points in play; last trick +5."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Bid conservatively. Announce roem when safe. Count card points.",
    "intermediate": "Deny roem when holding better. Time calling partner for maximum impact.",
    "advanced": "Bid according to hand strength; coordinate with partner via play.",
    "tips": [
      "Roem can be denied by opponents with higher roem.",
      "Partner identity revealed when they pick up a trick.",
      "Piccolo/Misère require precise hand management."
    ],
    "hasPlaceholders": false
  },
