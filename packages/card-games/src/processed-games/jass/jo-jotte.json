    },
    "deck": "32-card Piquet deck (A-K-Q-J-10-9-8-7)",
    "difficulty": "Intermediate",
    "duration": "20-40 minutes",
    "hasPlaceholders": false,
    "playerMode": "multiplayer",
    "originName": "Jo-Jotte"
  },
  "history": {
    "originCountries": [
      "USA"
    ],
    "origins": "Invented by Ely Culbertson, who sought a two-player game with the strategic depth of Bridge. He drew heavily from the European game Klaberjass (Clobyosh).",
    "timeline": [
      "1937: Ely Culbertson publishes 'Jo-Jotte: How to Play and Win'.",
      "1938: The game is heavily promoted through bridge clubs and literature.",
      "1940s: Fades in popularity as players return to traditional Gin Rummy and Bridge.",
      "Present: A cult classic among card historians and serious trick-taking fans."
    ],
    "evolution": "The game introduced a 'Bridge-style' score sheet with points 'above' and 'below' the line, which was a significant innovation for a Belote-style game.",
    "cultural": "Named after Josephine Culbertson ('Jo'), reflective of the power-couple dynamic of professional card playing in the 1930s.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Two players. The first dealer is determined by a single cut of the deck (low card deals first). Thereafter the deal alternates between the two players.",
    "deck": "32 cards (standard deck with 2s through 6s removed).",
    "equipment": "",
    "dealing": "Deal six cards to each player. One card is turned up to start the bidding. After trump is set, three more cards are dealt to each player (total of 9 cards).",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Score points through tricks, melds, and fulfilling contracts. The first to 1,000 points wins.",
    "gameplay": "1. Must follow suit. If unable, must trump.\n2. **Melds**: Sequences and four-of-a-kind can be declared before play.\n3. **Jo-Jotte (Marriage)**: Declaring 'Jo' and 'Jotte' for the King and Queen of trumps (20 pts).",
    "keyRules": [
      "Follow the legal action constraints defined for Jo-Jotte.",
      "Round outcome is resolved by the scoring method: Points are scored 'Below the line' for tricks and 'Above the line' for melds/bonuses, similar to Rubber Bridge.",
      "Winning condition: Score points through tricks, melds, and fulfilling contracts."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Priority is winning the first trick or setting the trump. Because it's a 32-card deck, counting cards is much easier and absolutely necessary.",
    "intermediate": "The '9' and 'Jack' of trumps are the most powerful cards. If you hold both, you have a massive advantage and should bid aggressively.",
    "advanced": "Defensive Play: If you are the Defender, your goal is to 'bust' the Declarer by winning just enough points to prevent them from hitting the majority. Force the Declarer to use their trumps on minor tricks.",
    "tips": [
      "The card values (20 for Jack, 14 for 9) mean that winning just two specific tricks can define the whole game.",
      "Always exchange the 7 of trumps for the face-up trump card if you have it."
    ],
    "hasPlaceholders": false
  },
