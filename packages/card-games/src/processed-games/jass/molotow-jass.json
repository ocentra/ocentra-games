  "history": {
    "originCountries": ["Switzerland"],
    "origins": "Molotow Jass was derived from Mittlere Jass (for three players) to accommodate four players. The game preserves the dynamic trump mechanism while adapting the middle-score concept to four players.",
    "timeline": [
      "Traditional: Developed from Mittlere Jass within Swiss Jass tradition",
      "Modern: Played in Swiss Jass circles as a four-player alternative",
      "Present: Part of the Swiss Jass repertoire"
    ],
    "evolution": "The adaptation from three to four players required significant changes to the scoring system while maintaining the core dynamic trump mechanic.",
    "cultural": "Part of the rich Swiss Jass tradition. Jass is considered the national card game of Switzerland, with many regional and player-count variants.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 players, each playing for themselves.",
    "deck": "36-card Jass deck (6 through Ace in four suits: Acorns, Shields, Flowers, Bells). Can use standard deck with 5s and below removed.",
    "equipment": "36-card Jass deck or modified standard deck, scoring slate (for sticks and potatoes).",
    "dealing": "9 cards to each player, dealt in packets of 3. Deal and play are anticlockwise.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Avoid being in the middle scores. Score points by winning tricks, but try to be either highest or lowest scorer.",
    "gameplay": "Player to dealer's right leads to first trick. Must follow suit if possible. If unable to follow, may play any card - if no trump is established, this card's suit becomes trumps. Once trump is established, must follow suit or trump if void.",
    "keyRules": [
      "First void play determines trumps",
      "Avoid middle scores",
      "Different scoring than Mittlere for four players",
      "No penalty for taking no tricks",
      "100+ points is heavily penalized"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Try to be either the highest scorer or the lowest scorer. Avoid the middle. Be careful not to reach 100 points which carries a heavy penalty.",
    "intermediate": "Control when trumps are established. Win early tricks to control play. In four players, coordination is harder but watch for opportunities to force others into the middle.",
    "advanced": "Track all cards to predict trump establishment. Calculate risk of reaching 100 points. Understand when to push for high score vs. when to dump points.",
    "tips": [
      "100 points is the danger zone - avoid it at all costs",
      "Sometimes taking no tricks is better than taking middle points",
      "Establishing trumps early gives you control but reveals information",
      "Watch opponents' scores to predict their strategies"
    ],
    "hasPlaceholders": false
  },
