    ],
    "origins": "Evolved from the '304' game brought by Indian indentured labourers to South Africa.",
    "timeline": [
      "19th century: Brought to South Africa by Indian indentured labourers; evolved into Thunee in Durban."
    ],
    "evolution": "Developed its own distinctive terminology (Balls, Khanock, Thunee call).",
    "cultural": "A central part of social life in Durban's Indian community.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 in partnerships (2–6 with variants).",
    "deck": "24 cards. Remove 2-8. Rank: J-9-A-10-K-Q.",
    "equipment": "Cards, score counters (balls)",
    "dealing": "Deal 4 cards. Bid. Deal 2 more (total 6).",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Win tricks to score points (Balls). First to 12/13 Balls wins.",
    "gameplay": "1. Deal 4. 2. Bidding (10, 20, etc., or Thunee). Highest bidder sets Trump. 3. Deal 2. 4. Play tricks. Must follow suit. Trumping allowed if void. 5. Scoring: Card values: J=30, 9=20, A=11, 10=10, K=3, Q=2. Total 104 points (plus bonus?).",
    "keyRules": [
      "J > 9 > A > 10 > K > Q",
      "Thunee call = All tricks",
      "Khanock = Penalty/Double",
      "Ball scoring"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Similar to 304: Save Jacks and Nines. Secure trumps early.",
    "intermediate": "Counting points to reach 105 (winning total?). Signalling partner.",
    "advanced": "Bluffing with a Thunee call. Catching a Thunee (stopping them).",
    "tips": [
      "Don't call Thunee lightly.",
      "A 'ball' is a game point.",
      "Jodhi (Marriage) adds points."
    ],
    "hasPlaceholders": false
  },
