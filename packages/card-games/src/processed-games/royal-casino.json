  "setup": {
    "players": "2-4 (4 in partnerships).",
    "deck": "Standard 52-card pack (French suits). In Royal Casino the court cards have numerical capture values: Jacks 11, Queens 12, Kings 13; number cards use face value; Aces count as 1 or 14 at the player's choice. The same deck is used for capture, building, and trailing as in Casino.",
    "equipment": "Standard deck.",
    "dealing": "4 each; 4 face up on table. Deal 4 more when hands empty.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Capture cards; score points. First to 21 (Dominican) wins.",
    "gameplay": "1. Must play exactly one card. 2. Capture: match loose card or sum; or capture build. 3. Build: combine with table cards; owner must hold matching card. 4. Trail: leave card on table if no match. Cannot trail if played card equals loose card. Owner of build cannot trail. 5. Sweeps (clearing table) score extra.",
    "keyRules": [
      "K=13, Q=12, J=11, A=1 or 14. Number cards = face value.",
      "Capture, build, or trail. Owner of build must hold matching card.",
      "Cannot trail when played card matches loose card. Target 21."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Control builds; avoid giving sweeps.",
    "intermediate": null,
    "advanced": null,
    "tips": [
      "Near 21, only certain scoring categories count: at 18 only most cards; at 19 only 10 of Diamonds; at 20 only most spades.",
      "Control builds; avoid leaving sweeps for the opponent. Owner of a build cannot trail."
    ],
    "hasPlaceholders": false,
    "nullReasons": {
      "intermediate": "No distinct intermediate level; strategy scales with build and sweep control.",
      "advanced": "No separate advanced tier; optimal play is build control and sweep denial."
    }
  },
