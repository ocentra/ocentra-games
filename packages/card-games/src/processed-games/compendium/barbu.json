  "quality": "complete",
  "overview": {
    "description": "Barbu (French for 'The Bearded One', referring to the King of Hearts) is the ultimate compendium card game, a favorite among French bridge players for its strategic depth and psychological complexity. A full session consists of 28 hands, where each of the four players acts as 'Declarer' for 7 hands, choosing from 7 different contracts. The game is a marathon of adaptability, shifting from punishing negative games (where you must avoid specific cards) to high-speed positive games like 'Trump' and the layout-based 'Domino'.",
    "category": "Trick-taking",
    "subCategory": "Trick-taking / Multi-game",
    "origin": "France",
    "originName": "Barbu (French: \"barbu\" – the bearded one)",
    "playerMode": "multiplayer",
    "players": {
      "minPlayers": 4,
      "maxPlayers": 4,
      "recommendedPlayers": 4,
      "display": "4"
    },
    "deck": "Standard 52-card deck",
    "difficulty": "Expert",
    "duration": "60-120 minutes",
    "hasPlaceholders": false
  },
  "history": {
    "origins": "Barbu evolved in early 20th-century France from earlier multi-game suites like 'Quodlibet'. In the 1960s, it underwent a resurgence among competitive bridge players, who added the complex 'Doubles' system that turned it into a serious gambling and strategy contest.",
    "originCountries": [
      "France"
    ],
    "timeline": [
      "1910s: Early versions played in French cafes.",
      "1968: The 'Bridge Player's' version with Doubles is standardized.",
      "1980s: Spread to the UK and USA as a high-skill alternative to Hearts.",
      "Present: Widely played in European bridge clubs as a 'relaxed' but still intense side game."
    ],
    "evolution": "The game's name (Barbu) specific focus on the King of Hearts as a 'Bomba' card is shared with Polish Kierki and Middle Eastern Trix.",
    "cultural": "Regarded as a game of 'temporary alliances'; unlike Bridge, you have no permanent partner, but you must constantly negotiate with others to bring down the leader.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Exactly 4 players, playing individually.",
    "deck": "Standard 52 cards (Ace high, 2 low).",
    "equipment": "Standard pack, specialized Barbu score sheet (to track 28 rounds).",
    "dealing": "Dealer (rotating) deals all cards. Each player receives 13 cards.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Accumulate the highest positive score (or lowest negative) at the end of the 28-hand cycle.",
    "gameplay": "For all contracts except Domino, standard trick-taking rules apply: must follow suit; highest card of suit led wins the trick (unless trumps are involved).",
    "keyRules": [
      "No Trumps in negative contracts.",
      "The declarer must play all 7 contracts exactly once during their tenure.",
      "In 'No Hearts', you cannot lead a heart until a heart has been discarded (broken suit)."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "In negative rounds, 'dump' your high cards on tricks started by others where no penalties are involved. In Trumps, try to clear your short suits early to use your trumps.",
    "intermediate": "The Double Strategy: If you have a terrible hand for 'No Queens' (e.g., three high Queens), DO NOT double the declarer. If you have an amazing hand for 'No Tricks', double everyoneâ€”you'll harvest their negative points.",
    "advanced": "Void Management: In 'No Barbu', if you realize you are stuck with the Kâ™¥, try to create a 'Void' in another suit so you can discard the King the moment someone else leads that suit.",
    "tips": [
      "Domino is the hardest contract to play well. Look for cards that 'Block' your opponents (e.g., holding the 7 of Clubs prevents anyone from starting the bottom or top half of that suit).",
      "Pay attention to what contracts the other players have left. If a player hasn't played 'Trumps' yet and they're low on cards, they will be dangerous."
    ],
    "hasPlaceholders": false
  },
