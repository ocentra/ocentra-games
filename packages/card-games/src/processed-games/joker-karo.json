  "history": {
    "originCountries": ["Germany", "Switzerland"],
    "origins": "Derived from traditional Rummy/RommÃ© games. The name 'Joker Karo' refers to the high value placed on the Joker and the 'Diamond' (Karo) suit used in specific scoring variants.",
    "timeline": [
      "Early 20th Century: Rummy becomes the dominant family game in Germany.",
      "1950s: The addition of extra Jokers (up to 6) creates the faster 'Jokern' style.",
      "Present: One of the most common social card games in German-speaking households."
    ],
    "evolution": "The game evolved to allow for more flexible melding, with the 'Joker swap' mechanic becoming a core strategic element.",
    "cultural": "Often played in long sessions where cumulative points determine the ultimate 'Master' of the game.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Usually 2 to 4 players.",
    "deck": "Two standard decks plus 6 Jokers (Total 110 cards).",
    "equipment": "",
    "dealing": "Deal 13 cards to each player. Remaining cards form a draw pile.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Be the first to discard all cards by forming valid melds (sets and sequences) on the table.",
    "gameplay": "1. Draw a card from the deck or discard pile.\n2. Meld cards if possible (first meld must be worth 30+ points).\n3. **Joker Exchange**: If a Joker is on the table representing a 7 of Hearts, and you have the 7 of Hearts, you can swap them and keep the Joker for yourself.\n4. Discard one card to end turn.",
    "keyRules": [
      "Follow the legal action constraints defined for Joker Karo.",
      "Round outcome is resolved by the scoring method: Numbered cards (2-10) = face value.",
      "Winning condition: Be the first to discard all cards by forming valid melds (sets and sequences) on the table."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Keep Jokers until you can use them for the 'Final Out'. Don't meld your Jokers too early as your opponents might steal them using the exchange rule.",
    "intermediate": "The 30-point Hurdle: Try to save your initial Aces and Kings to make your first meld. Once you are 'open' (have melded once), the game becomes much easier as you can add to others' piles.",
    "advanced": "Joker Trapping: Deliberately meld a Joker to lure an opponent into playing a high-value card for the exchange, then using their discarded cards to finish your own hand.",
    "tips": [
      "An Ace is worth 11 points in a sequence (Q-K-A), which helps reach the 30-point meld faster.",
      "A Joker in hand at the end of the game counts for 20 penalty pointsâ€”don't hoard them if someone is close to winning!"
    ],
    "hasPlaceholders": false
  },
