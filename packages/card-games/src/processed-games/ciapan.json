  "history": {
    "originCountries": ["Italy"],
    "origins": "Country/Region of Origin: Italy (Tuscany and Emilia-Romagna regions)\nTime Period: 19th-20th century\nHistorical Development: Developed as a variant of Tressette with reversed objectives. The name 'CiapanÃ²' comes from the Italian 'ciapa' (take) + 'no' (not).\nCultural Significance: Popular in central Italian regions as a social game.",
    "timeline": [
      "19th century: Game develops from Tressette",
      "20th century: Popular in Tuscany and Emilia-Romagna",
      "Present: Still played in central Italy"
    ],
    "evolution": "CiapanÃ² evolved from Tressette by reversing the objective - instead of trying to win tricks, players try to avoid taking them. This creates a completely different strategic dynamic.",
    "cultural": "The game is part of traditional Italian card gaming culture, particularly in Tuscany where Tressette and its variants are widely played.",
    "hasPlaceholders": false
  },
