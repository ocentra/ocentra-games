  "rules": {
    "objective": "Avoid taking tricks. The player with the fewest tricks taken at the end wins. Unlike most trick-taking games, taking tricks is penalized rather than rewarded.",
    "gameplay": "1. All cards are dealt to players\n2. First player (to dealer's right) leads any card\n3. Players must follow suit if possible\n4. If cannot follow suit, may play any card\n5. Highest card of led suit wins the trick\n6. Winner of trick leads to next trick\n7. Continue until all cards are played\n8. Player with fewest tricks taken wins the partie",
    "keyRules": [
      "Must follow suit if possible",
      "Highest card of led suit wins the trick",
      "Taking tricks is bad - goal is to avoid tricks",
      "Ace is the highest card in each suit",
      "No trump suit",
      "In 3-player game, one four is removed from the pack"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Play high cards when you must take a trick to avoid taking multiple tricks. Save low cards for when you can avoid winning.",
    "intermediate": "Count cards to track what has been played. Try to force opponents to win tricks by leading suits they must follow. Void yourself in suits where you have high cards.",
    "advanced": "Complex card counting and probability. Track suit distributions to predict when you can safely lead. Use endgame knowledge to force specific opponents to take crucial tricks.",
    "tips": [
      "Avoid winning tricks - this is the opposite of most trick games",
      "Try to void yourself in suits where you hold high cards",
      "Force opponents to win by leading suits they must follow",
      "Save your lowest cards for critical moments",
      "Pay attention to which players are ahead/behind in tricks"
    ],
    "hasPlaceholders": false
  },
