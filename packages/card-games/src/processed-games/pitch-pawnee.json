  "rules": {
    "objective": "First team to 10 points. Points: high (1), low (1), jack (1), game (1).",
    "gameplay": "1. Bidding: players bid 1-4 (or pass). 2. High bidder names trump and calls for partner (e.g. 'Ace of spades'). Holder of that card is partner (doesn't reveal until card played). 3. Play as Pitch: follow suit, trump. 4. Score high, low, jack, game for the bidding team.",
    "keyRules": [
      "Call-partner: high bidder calls a card; holder is partner.",
      "10 points to win.",
      "Standard Pitch scoring: high, low, jack, game.",
      "Partner unknown until called card is played."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "As Pitch. Call a card you expect partner to hold.",
    "intermediate": "Bid according to trump strength. Partner inference.",
    "advanced": "Optimal card call; coordinate once partner known.",
