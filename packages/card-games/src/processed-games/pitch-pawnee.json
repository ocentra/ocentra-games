  "history": {
    "originCountries": ["USA"],
    "origins": "Pitch descends from the English game All Fours (Seven Up), with bidding added; it became a North American family and social game, especially in the mid-west. Call-partner variants such as Pawnee Pitch allow the high bidder to name a card whose holder becomes their partner (identity hidden until that card is played). The Pawnee name is tied to a ten-point call-your-partner form; rules were contributed by James Adams, whose brothers learned it in Wichita, Kansas in the 1950s; the four-player, ten-point-to-win version is a common variant of that tradition.",
    "timeline": [
      "See Pitch. Call-partner adds variable partnerships."
    ],
    "evolution": "Call-partner allows declarer to choose partner via card call.",
    "cultural": "Part of Pitch/All Fours family; regional play in Kansas and mid-west USA.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4. Variable partnerships via call.",
    "deck": "Standard 52 cards.",
