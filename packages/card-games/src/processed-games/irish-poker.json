  "history": {
    "origins": "A modern social adaptation of older betting games like 'Red or Black'. It became a staple in university and pub culture globally under the name 'Irish Poker' or 'Ride the Bus'.",
    "originCountries": ["Ireland"],
    "timeline": [
      "1980s: Simplistic card guessing games become popular in Western pub culture.",
      "1990s: Rules for the four-stage variant (Red/Black, High/Low, etc.) are standardized.",
      "Present: One of the most common card-based icebreakers and social drinking games."
    ],
    "evolution": "The game evolved by adding the 'Ride the Bus' finale to give it a conclusive ending.",
    "cultural": "Used at parties and social gatherings; emphasizes rapid participation and group interaction.",
    "hasPlaceholders": false
  },
