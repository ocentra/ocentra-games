  "rules": {
    "objective": "Shed all cards (hand, face-up, face-down). Last player loses.",
    "gameplay": "Play equal/higher rank. Draw to 3 while stock lasts. Can't play = pick up pile. 2=reset (any card next). 10=burn pile. Four-of-a-kind=burn. After hand empty: play face-up cards, then blind face-down.",
    "keyRules": [
      "3 layers: hand â†’ face-up â†’ face-down",
