  "history": {
    "originCountries": ["Italy", "Spain"],
    "origins": "Tute originated in Italy, where it was known as tutti (the declaration for holding all four kings or four jacks). During the 19th century the game spread to Spain, reportedly brought back by Spanish troops returning from missions in Italy; Spanish speakers adapted the name to tute. It became one of the most popular card games in Spain and is also played in some Latin American countries; in Mexico it was known as tuti. The game is a point-trick game of the marriage type, related to Brisca and other Mediterranean ace-ten games.",
    "timeline": ["19th century: Game spread to Spain from Italy; became one of the most popular card games in Spain."],
    "evolution": "Related to Brisca and other Mediterranean games.",
    "cultural": "Deeply rooted in Spanish culture.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "Two or more players.",
    "deck": "40 Spanish cards. Rank: A-3-K-Kt-J-7-6-5-4-2. Values: A=11, 3=10, K=4, Kt=3, J=2. Total 120 pts.",
    "equipment": "Cards",
    "dealing": "2p: 8 each +stock. 3p: 13 each. 4p: 10 each. Last card = trump.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Score 101+ points. Or declare Tute (4 Kings or 4 Knights).",
    "gameplay": "Follow suit. Must play higher if possible. Must trump if void in suit. Cantes: K+Kt of trump = 40 pts. K+Kt of other suit = 20 pts. Cantes only after winning first trick. Last trick = 10 bonus. 7 of trumps can swap with face-up trump card.",
    "keyRules": [
      "Must follow suit AND play higher",
      "Must trump if void",
      "Cantes: K+Kt bonus",
      "Tute: 4 Kings or 4 Knights = instant win",
      "7 of trumps swaps trump indicator"
    ],
    "hasPlaceholders": false
  },
