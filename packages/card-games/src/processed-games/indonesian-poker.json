  "history": {
    "origins": "Derived from the Chinese game 'Pai GOW' using cards instead of tiles. It evolved into what is now internationally known as Chinese Poker, with 'Capsa' referring to the 13 cards dealt in the local Indonesian/Hakka dialect.",
    "originCountries": ["China", "Indonesia"],
    "timeline": [
      "20th Century: Becomes a staple in Indonesian social and commercial card rooms.",
      "1990s: Rules standardize for commercial casino and tournament play.",
      "Present: One of the most downloaded mobile card games in Indonesia."
    ],
    "evolution": "The game moved from a complex point-based system to a simplified 'hands won' comparison format common in the region.",
    "cultural": "Commonly played during family festivals (Imlek) and social gatherings.",
    "hasPlaceholders": false
  },
  "setup": {
    "players": "4 players (standard).",
    "deck": "Standard 52-card deck. Ranking: A-K-Q-J-10...2.",
    "equipment": "",
    "dealing": "Each player receives 13 cards.",
    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Arrange your 13 cards into three hands (Back, Middle, Front) that beat your opponents' respective hands.",
    "gameplay": "Indonesian Poker proceeds through deal, legal play actions, and end-of-round resolution. Play proceeds through legal actions until round resolution.",
    "keyRules": [
      "Follow the legal action constraints defined for Indonesian Poker.",
      "Round outcome is resolved by the scoring method: Players compare their Front vs Front, Middle vs Middle, and Back vs Back against each opponent.",
      "Winning condition: Arrange your 13 cards into three hands (Back, Middle, Front) that beat your opponents' respective hands."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Prioritize a solid Back hand (Full House or better) to ensure you win at least one point. Don't leave your Front hand too weak; a pair of Jacks can often win the top row.",
    "intermediate": "Balanced setup: Instead of one massive hand and two weak ones, try to build three 'average' hands that can steal wins from specialists.",
    "advanced": "Opponent profiling: In a 4-player game, observe who builds from the bottom up. If the dealer always has a strong Back, aim to beat them in the Front and Middle.",
    "tips": [
      "Avoid the 'Foul' at all costs. It's an automatic maximum loss.",
      "A 'Three-of-a-kind' in the front hand is very rare and almost guaranteed to win that row."
    ],
    "hasPlaceholders": false
  },
