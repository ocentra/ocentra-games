  "rules": {
    "objective": "Win chips. Stage 1: Hold A/K/Q/J/10 of pay suit â†’ take pool. Marriage (K+Q), Sequence (7-8-9) of pay suit. Stage 2: Pochenâ€”bet on best pair/triple/quartet. Stage 3: Stopsâ€”play cards in ascending sequence; first out wins centre + 1 per card from others.",
    "gameplay": "1. Stage 1: Claim pools for pay-suit cards. 2. Stage 2: Bet (Pochen); best pair/triple/quartet wins. 3. Stage 3: Winner of Pochen (or left of dealer if all pass) leads; play next higher in suit; stop when no one has next card; last player leads again. First out wins.",
    "keyRules": [
      "Pay suit from turned card.",
      "Pochen: pairs, triples, quartets only.",
      "Stops: play next higher in suit; stop = new lead.",
      "First out in stage 3 wins centre + 1 per opponent card."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Track pay suit. Save high cards for Stops.",
    "intermediate": "Pochen: bet with strong pairs/triples.",
    "advanced": "Stops: optimal sequencing.",
    "tips": [
      "Marriage and Sequence often roll over.",
      "Pay suit card turned = that pool not won."
