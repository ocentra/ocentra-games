    "hasPlaceholders": false
  },
  "rules": {
    "objective": "Win at least as many tricks as bid. First team to reach target score (e.g., 31, 41, or 61) wins.",
    "gameplay": "Bidding starts at 7 tricks. Players bid number of tricks (7-13) or pass. Highest bidder declares Trump (Tarneeb). Player to dealer's right (or bidder) leads first. Must follow suit. Highest trump wins, or highest card of led suit. Winner leads next.",
    "keyRules": [
      "Bidding required (7+)",
      "Declarer names Trump",
      "Partnership play",
      "Must follow suit"
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Bid on long suits (5+ cards) with high honors (A, K). Count trumps played. Support partner if they bid.",
    "intermediate": "Lead trumps early to clear opponents' trumps if you are declarer. If defending, try to force declarer to ruff (use trumps) when they are weak.",
    "advanced": "Signal partner with discards (high/low). Calculate 'losing tricks' to estimate bid. Squeeze opponents in end-game.",
    "tips": [
      "Don't overbid without support.",
      "A bid of 7 usually requires a 5-card suit and some aces.",
      "Kaboot (13 tricks) is rare and risky but high reward."
    ],
    "hasPlaceholders": false
  },
