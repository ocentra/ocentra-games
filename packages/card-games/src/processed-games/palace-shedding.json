  "rules": {
    "objective": "Get rid of all cards. Last player with cards loses.",
    "gameplay": "1. **Setup**: 3 face-down, 3 face-up, 3 hand. Swap hand with face-up if desired. 2. **Play**: Play card or set equal to or higher than pile top. Draw to refill hand to 3 until stock empty. 3. **Pick up**: Cannot play â†’ take entire pile. 4. **Layers**: Empty hand first, then face-up, then blind-flip face-down. 5. **2**: Resets pile; next player can play anything. 6. **10**: Burns pile; same player plays again. 7. **Four-of-a-kind**: Burns pile; same player plays again.",
    "keyRules": [
      "2: Resets pile; next player can play any card.",
      "10: Burns (clears) pile; same player plays again.",
      "Four-of-a-kind: Burns pile; same player plays again.",
      "Must empty hand before face-up, face-up before face-down.",
      "Blind flip: if unplayable, pick up pile including flipped card."
    ],
    "hasPlaceholders": false
  },
  "strategy": {
    "basic": "Put 2s, 10s, and Aces in face-up slots. Shed small cards early.",
    "intermediate": "Sometimes take a small pile if it contains useful cards. Save 10s for huge piles.",
    "advanced": "Block opponents with face-up cards. Force pickups when they are on face-down.",
    "tips": [
      "Save 10s for when the pile is huge.",
      "Keep a 2 ready before blind-flipping.",
      "Don't rush to empty face-up cards without a 2 as backup."
    ],
    "hasPlaceholders": false
  },
