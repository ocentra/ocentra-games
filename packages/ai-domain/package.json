  "scripts": {
    "pretest": "cd ../.. && npm run build:domains",
    "build": "tsc && tsc-alias && node ../../scripts/fix-dist-aliases.mjs && node ../../scripts/fix-esm-imports.mjs",
    "type-check": "tsc --noEmit",
    "lint": "node -e \"const cmd = process.env.TURBO_HASH ? 'npm run lint:exec' : 'npx turbo run lint:exec --filter=@ocentra/ai-domain'; require('child_process').spawnSync(cmd.split(' ')[0], cmd.split(' ').slice(1), { stdio: 'inherit', shell: true });\"",
    "lint:eslint": "eslint --cache src",
    "lint:fix": "eslint --cache src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "lint:exec": "eslint --cache src && tsc --noEmit"
  },
