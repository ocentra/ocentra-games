{
    "name":  "@ocentra/asset-editor-types",
    "version":  "1.0.0",
    "type":  "module",
    "description":  "Shared types for asset editor: FlatNode, ResourceTree.",
    "exports":  {
                    "./FlatNode":  {
                                       "import":  "./dist/FlatNode.js",
                                       "types":  "./dist/FlatNode.d.ts"
                                   }
                },
    "scripts":  {
                    "build":  "tsc \u0026\u0026 node ../../scripts/fix-esm-imports.mjs",
                    "type-check":  "tsc --noEmit",
                    "lint":  "node -e \"const cmd = process.env.TURBO_HASH ? \u0027npm run lint:exec\u0027 : \u0027npx turbo run lint:exec --filter=@ocentra/asset-editor-types\u0027; require(\u0027child_process\u0027).spawnSync(cmd.split(\u0027 \u0027)[0], cmd.split(\u0027 \u0027).slice(1), { stdio: \u0027inherit\u0027, shell: true });\"",
                    "lint:exec":  "eslint --cache src \u0026\u0026 tsc --noEmit"
                },
    "dependencies":  {
                         "@ocentra/asset-domain":  "file:../asset-domain"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.15.0",
                            "eslint":  "^9.15.0",
                            "typescript":  "^6.0.2",
                            "typescript-eslint":  "^8.58.0"
                        }
}
