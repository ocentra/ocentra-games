{
    "name":  "@ocentra/network-domain",
    "version":  "1.0.0",
    "type":  "module",
    "description":  "P2P WebRTC networking types, WebRTCHandler, P2PManager, and router-type re-exports. Shared by main app.",
    "dependencies":  {
                         "@ocentra/boundary-domain":  "file:../boundary-domain",
                         "@ocentra/logging-domain":  "file:../logging-domain"
                     },
    "peerDependencies":  {
                             "react":  "\u003e=18.0.0"
                         },
    "peerDependenciesMeta":  {
                                 "react":  {
                                               "optional":  true
                                           }
                             },
    "exports":  {
                    "./types":  {
                                    "import":  "./dist/types.js",
                                    "types":  "./dist/types.d.ts"
                                },
                    "./connection/WebRTCHandler":  {
                                                       "import":  "./dist/connection/WebRTCHandler.js",
                                                       "types":  "./dist/connection/WebRTCHandler.d.ts"
                                                   },
                    "./managers/P2PManager":  {
                                                  "import":  "./dist/managers/P2PManager.js",
                                                  "types":  "./dist/managers/P2PManager.d.ts"
                                              },
                    "./hooks/useP2PNetworking":  {
                                                     "import":  "./dist/hooks/useP2PNetworking.js",
                                                     "types":  "./dist/hooks/useP2PNetworking.d.ts"
                                                 },
                    "./router-types":  {
                                           "import":  "./dist/router-types.js",
                                           "types":  "./dist/router-types.d.ts"
                                       }
                },
    "scripts":  {
                    "build":  "tsc \u0026\u0026 tsc-alias \u0026\u0026 node ../../scripts/fix-esm-imports.mjs",
                    "type-check":  "tsc --noEmit",
                    "lint":  "node -e \"const cmd = process.env.TURBO_HASH ? \u0027npm run lint:exec\u0027 : \u0027npx turbo run lint:exec --filter=@ocentra/network-domain\u0027; require(\u0027child_process\u0027).spawnSync(cmd.split(\u0027 \u0027)[0], cmd.split(\u0027 \u0027).slice(1), { stdio: \u0027inherit\u0027, shell: true });\"",
                    "lint:eslint":  "eslint --cache src tests",
                    "lint:fix":  "eslint --cache src tests --fix",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "lint:exec":  "eslint --cache src tests \u0026\u0026 tsc --noEmit"
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.15.0",
                            "eslint":  "^9.15.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.2",
                            "globals":  "^15.12.0",
                            "react":  "^19.0.0",
                            "tsc-alias":  "^1.8.16",
                            "typescript":  "^6.0.2",
                            "typescript-eslint":  "^8.58.0",
                            "vitest":  "^2.0.0"
                        }
}
