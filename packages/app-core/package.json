{
  "name": "@ocentra/app-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared app bootstrap: ServiceRegistry, path utils.",
  "exports": {
    "./ServiceRegistry": { "import": "./dist/ServiceRegistry.js", "types": "./dist/ServiceRegistry.d.ts" },
    "./path": { "import": "./dist/path.js", "types": "./dist/path.d.ts" },
    "./guid": { "import": "./dist/guid.js", "types": "./dist/guid.d.ts" },
    "./timeout": { "import": "./dist/timeout.js", "types": "./dist/timeout.d.ts" },
    "./UniqueList": { "import": "./dist/UniqueList.js", "types": "./dist/UniqueList.d.ts" },
    "./platform": { "import": "./dist/platform.js", "types": "./dist/platform.d.ts" }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-imports.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache src && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ocentra/asset-domain": "file:../asset-domain"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.0.0"
  }
}
