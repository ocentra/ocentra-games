{
  "name": "@ocentra/api-domain",
  "version": "1.0.0",
  "type": "module",
  "description": "HTTP client and API service clients for worker endpoints. Auth injected at bootstrap. Shared by main app.",
  "dependencies": {
    "@ocentra/boundary-domain": "file:../boundary-domain",
    "@ocentra/endpoint-domain": "file:../endpoint-domain",
    "@ocentra/logging-domain": "file:../logging-domain",
    "@ocentra/network-domain": "file:../network-domain"
  },
  "exports": {
    "./createApiClient": { "import": "./dist/createApiClient.js", "types": "./dist/createApiClient.d.ts" },
    "./httpClient": { "import": "./dist/httpClient.js", "types": "./dist/httpClient.d.ts" },
    "./playerHub": { "import": "./dist/playerHub.js", "types": "./dist/playerHub.d.ts" },
    "./social": { "import": "./dist/social.js", "types": "./dist/social.d.ts" },
    "./multiplayer": { "import": "./dist/multiplayer.js", "types": "./dist/multiplayer.d.ts" },
    "./competition": { "import": "./dist/competition.js", "types": "./dist/competition.d.ts" },
    "./cloud/CloudService": { "import": "./dist/cloud/CloudService.js", "types": "./dist/cloud/CloudService.d.ts" },
    "./cloud/CloudServiceImpl": { "import": "./dist/cloud/CloudServiceImpl.js", "types": "./dist/cloud/CloudServiceImpl.d.ts" }
  },
  "scripts": {
    "build": "tsc && tsc-alias && node ../../scripts/fix-esm-imports.mjs",
    "prepare": "npm run build",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache src && tsc --noEmit",
    "lint:eslint": "eslint --cache src",
    "lint:fix": "eslint --cache src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.15.0"
  }
}
