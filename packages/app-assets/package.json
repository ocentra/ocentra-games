{
  "name": "@ocentra/app-assets",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./avatars": {
      "import": "./dist/avatars.js",
      "types": "./dist/avatars.d.ts"
    },
    "./commons": {
      "import": "./dist/commons.js",
      "types": "./dist/commons.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./artwork": {
      "import": "./dist/artwork.js",
      "types": "./dist/artwork.d.ts"
    },
    "./cardgame": {
      "import": "./dist/cardgame.js",
      "types": "./dist/cardgame.d.ts"
    },
    "./banners": {
      "import": "./dist/banners.js",
      "types": "./dist/banners.d.ts"
    },
    "./placeholders": {
      "import": "./dist/placeholders.js",
      "types": "./dist/placeholders.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-imports.mjs && node scripts/fix-asset-imports.mjs && node scripts/copy-assets.mjs",
    "type-check": "tsc --noEmit",
    "lint": "npm run lint:exec && npm run type-check",
    "lint:exec": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
