  "scripts": {
    "build": "tsc && tsc-alias && node ../../scripts/fix-esm-imports.mjs",
    "prepare": "npm run build",
    "type-check": "tsc --noEmit",
    "bridge": "npx tsx scripts/log-bridge.ts",
    "db:ensure": "npx tsx scripts/ensure-db.ts",
    "db:rebuild": "npx tsx scripts/rebuild-db-from-ndjson.ts",
    "db:ingest": "npx tsx scripts/rebuild-db-from-ndjson.ts --no-delete",
    "logs:prepare": "npx tsx scripts/prepare-ndjson-logs.ts",
    "logs:cloudflare:prepare": "npx tsx scripts/prepare-ndjson-logs.ts --wipe --prepare --run-type=single-pool --tests-dir=../../infra/cloudflare/tests && npx tsx scripts/prepare-ndjson-logs.ts --prepare --run-type=single-threads --tests-dir=../../infra/cloudflare/tests",
    "test:query": "npx tsx scripts/query-test-logs.ts",
    "view:ndjson": "npx tsx scripts/view-ndjson.ts",
    "lint": "eslint --cache src scripts && tsc --noEmit",
    "lint:eslint": "eslint --cache src scripts",
    "lint:fix": "eslint --cache src scripts --fix"
  },
