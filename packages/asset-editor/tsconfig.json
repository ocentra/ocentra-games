{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@utils/*": ["./src/utils/*"],
      "@providers/*": ["./src/providers/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*.ts", "scripts/asset-editor-logs.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
