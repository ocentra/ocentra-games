{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@main/*": [
        "../../src/*"
      ],
      "@ocentra/core-ui/*": [
        "../core-ui/src/*"
      ],
      "@ocentra/game-ui-types/*": [
        "../game-ui-types/src/*"
      ],
      "@ocentra/game-layout-domain/*": [
        "../game-layout-domain/src/*"
      ],
      "@ocentra/card-game-ui/*": [
        "../card-game-ui/src/*"
      ],
      "@ocentra/eventing-domain/*": [
        "../eventing-domain/src/*"
      ],
      "@ocentra/asset-domain/*": [
        "../asset-domain/src/*"
      ],
      "@ocentra/game-domain/*": [
        "../game-domain/src/*"
      ],
      "@ocentra/game-asset-domain/*": [
        "../game-asset-domain/src/*"
      ],
      "@ocentra/boundary-domain/*": [
        "../boundary-domain/src/*"
      ],
      "@ocentra/logging-domain/*": [
        "../logging-domain/src/*"
      ],
      "@ocentra/endpoint-domain/*": [
        "../endpoint-domain/src/*"
      ],
      "@ocentra/ai-domain/*": [
        "../ai-domain/src/*"
      ],
      "@ocentra/api-domain/*": [
        "../api-domain/src/*"
      ],
      "@ocentra/app-assets/*": [
        "../app-assets/src/*"
      ],
      "@ocentra/app-core/*": [
        "../app-core/src/*"
      ],
      "@ocentra/asset-editor-types/*": [
        "../asset-editor-types/src/*"
      ],
      "@ocentra/auth-domain/*": [
        "../auth-domain/src/*"
      ],
      "@ocentra/behaviour-domain/*": [
        "../behaviour-domain/src/*"
      ],
      "@ocentra/card-games/*": [
        "../card-games/src/*"
      ],
      "@ocentra/credentials-domain/*": [
        "../credentials-domain/src/*"
      ],
      "@ocentra/crypto-domain/*": [
        "../crypto-domain/src/*"
      ],
      "@ocentra/network-domain/*": [
        "../network-domain/src/*"
      ],
      "@ocentra/solana-domain/*": [
        "../solana-domain/src/*"
      ],
      "@ocentra/storage-domain/*": [
        "../storage-domain/src/*"
      ],
      "@ocentra/verification-domain/*": [
        "../verification-domain/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*.ts",
    "scripts/asset-editor-logs.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../eventing-domain"
    },
    {
      "path": "../asset-domain"
    },
    {
      "path": "../game-domain"
    },
    {
      "path": "../game-asset-domain"
    },
    {
      "path": "../boundary-domain"
    },
    {
      "path": "../logging-domain"
    },
    {
      "path": "../endpoint-domain"
    },
    {
      "path": "../ai-domain"
    },
    {
      "path": "../api-domain"
    },
    {
      "path": "../app-core"
    },
    {
      "path": "../asset-editor-types"
    },
    {
      "path": "../auth-domain"
    },
    {
      "path": "../behaviour-domain"
    },
    {
      "path": "../card-game-ui"
    },
    {
      "path": "../card-games"
    },
    {
      "path": "../core-ui"
    },
    {
      "path": "../credentials-domain"
    },
    {
      "path": "../crypto-domain"
    },
    {
      "path": "../game-layout-domain"
    },
    {
      "path": "../game-ui-types"
    },
    {
      "path": "../network-domain"
    },
    {
      "path": "../solana-domain"
    },
    {
      "path": "../storage-domain"
    },
    {
      "path": "../verification-domain"
    }
  ]
}
