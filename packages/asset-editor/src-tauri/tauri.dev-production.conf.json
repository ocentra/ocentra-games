{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asset Editor",
  "version": "0.1.0",
  "identifier": "ca.ocentra.asset-editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npx tsx ../../scripts/dev/wait-for-dev-server.ts --url=http://localhost:5174",
    "beforeBuildCommand": "node src-tauri/run-build-editor.cjs"
  },
  "app": {
    "windows": [
      {
        "title": "Asset Editor",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
