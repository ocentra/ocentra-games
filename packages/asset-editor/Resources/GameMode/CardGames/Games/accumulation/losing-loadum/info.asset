    historyContent: {
      origins: 'First mentioned in 1591. It was a favorite of the Elizabethan and Stuart courts before being simplified into modern Hearts and Black Maria.',
      originCountries: [
        'England',
      ],
      timeline: [
        "1590s: Mentioned in 'A Manifest Detection of Dice-Play'.",
        '1670s: Comprehensive rules written by Francis Willughby.',
        "18th Century: Popularity wanes as 'Whist' becomes the dominant trick-taker.",
        'Present: Rediscovered by card historians such as David Parlett.',
      ],
      evolution: "The game's 31-point limit was likely influenced by 'Vingt-Un' (21), but used as a ceiling for loss rather than a goal for victory.",
      cultural: "The name 'Loadum' refers to 'loading' an opponent with unwanted points.",
    },
    setupContent: {
      players: '3-9 players individually (Best with 4-5).',
