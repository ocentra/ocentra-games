  data: {
    hero: {
      title: 'LOSING LOADUM',
      subtitle: 'The Elizabethan Elimination Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Losing Loadum',
            subtitle: 'The Elizabethan Elimination Game',
            content: [
              {
                type: 'paragraph',
                text: "Losing Loadum (or Losing Lodam) is an intriguing ancestor of the Hearts family, dating back to 16th-century England. It is a 'penalty trick' game where the objective is to avoid winning specific high-value cards called 'Loaders'. The game is unique for its elimination mechanic: any player reaching 31 points is immediately 'out'. It also features a rare 'hidden trump' system where trumps are determined only when a player first fails to follow suit.",
              },
              {
                type: 'paragraph',
                text: 'First mentioned in 1591. It was a favorite of the Elizabethan and Stuart courts before being simplified into modern Hearts and Black Maria.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-9 players individually (Best with 4-5).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranked Ace (high) down to 2.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck and score sheet.',
              },
              {
                type: 'paragraph',
                text: "Cards are dealt evenly. A small 'talon' of remaining cards is placed face-down.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Great Loadum: The standard version without the 31-point elimination.',
                  },
                  {
                    text: 'Black Maria: A refined 3-player version.',
                  },
                  {
                    text: 'Hearts: The modern global avoidance game.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Losing Loadum (or Losing Lodam) is an intriguing ancestor of the Hearts family, dating back to 16th-century England. It is a 'penalty trick' game where the objective is to avoid winning specific high-value cards called 'Loaders'. The game is unique for its elimination mechanic: any player reaching 31 points is immediately 'out'. It also features a rare 'hidden trump' system where trumps are determined only when a player first fails to follow suit.",
    tags: [
      'card-game',
      'trick-taking',
      'social',
    ],
    comingSoon: false,
    minPlayers: 3,
    maxPlayers: 9,
    routePath: 'losing-loadum',
    LLM: 'Game: Losing Loadum. 3-9 players, 52-card deck. Deal evenly. Point cards: A=11, 10=10, K=3, Q=2, J=1. Must follow suit. First void reveals talon top as trump (hidden after). Can exchange cards between tricks. Reach 31 points = eliminated. Last player wins.',
    Player: "Welcome to Losing Loadum, a 16th-century English classic! Avoid capturing point cardsâ€”Aces (11), Tens (10), Kings (3), Queens (2), Jacks (1). Hit 31 points and you're eliminated! Watch for the sudden trump reveal when someone can't follow suit. You can even exchange high cards between tricks!",
    tagline: "Stay under 31, or you're done.",
    gameCategory: 'Trick-taking',
    subcategory: 'Avoidance / Elimination',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-30 minutes',
    origin: 'England',
    originName: 'Losing Loadum',
    deck: 'Standard 52-card deck',
    alsoKnownAs: [
      'Losing Lodam',
    ],
    playersDisplay: '3-9',
    quality: 'complete',
    completeness: {
