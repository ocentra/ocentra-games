    historyContent: {
      origins: 'Noddy is the 16th-century English ancestor of Cribbage, making it the oldest identifiable card game with this gaming structure. It was played during the Tudor period in England. The game was described by David Parlett as the foundation from which Cribbage evolved.',
      originCountries: [
        'England',
      ],
      timeline: [
        '16th Century: Noddy played in Tudor England',
        'Early 17th Century: Game evolves into Costly Colours',
        "1630s: Sir John Suckling creates Cribbage by refining Noddy's rules",
        "Present: Played by historical card game enthusiasts; preserved as Cribbage's predecessor",
      ],
      evolution: "Noddy evolved into Costly Colours, which then influenced Sir John Suckling's creation of Cribbage in the 1630s. Cribbage refined Noddy's mechanics, adding the crib and modifying the scoring board. Noddy used four cards dealt (no crib) and was primarily a two-player game.",
      cultural: "Part of Tudor English gaming culture. The game's survival through its descendant Cribbage makes it historically significant in the development of card games.",
    },
    setupContent: {
      players: '2-4 players; primarily a two-player game.',
      deck: 'Standard 52-card pack. Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2. In Noddy, Ace is low only (counts 1).',
      equipment: 'Standard deck, Noddy board (similar to Cribbage board but simpler), pegs for scoring.',
      dealing: "Four cards dealt to each player (unlike Cribbage's six). No crib in Noddy.",
    },
