    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Noddy',
            subtitle: "Cribbage's Ancestor",
            content: [
              {
                type: 'paragraph',
                text: 'Noddy is a 16th-century English card game and the direct ancestor of Cribbage. It is the oldest identifiable card game with the Cribbage gaming structure. Played with a distinctive board for scoring, it features the familiar combination of pegging, fifteens, pairs, runs, and flushes that would later be refined into modern Cribbage.',
              },
              {
                type: 'paragraph',
                text: 'Noddy is the 16th-century English ancestor of Cribbage, making it the oldest identifiable card game with this gaming structure. It was played during the Tudor period in England. The game was described by David Parlett as the foundation from which Cribbage evolved.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 players; primarily a two-player game.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2. In Noddy, Ace is low only (counts 1).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, Noddy board (similar to Cribbage board but simpler), pegs for scoring.',
              },
              {
                type: 'paragraph',
                text: "Four cards dealt to each player (unlike Cribbage's six). No crib in Noddy.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Costly Colours: Evolved form of Noddy with additional scoring combinations and more complex rules.',
                  },
                  {
                    text: 'Three or Four Player: Noddy can be played with 3-4 players with modifications to dealing and play.',
                  },
                ],
              },
            ],
          },
        ],
