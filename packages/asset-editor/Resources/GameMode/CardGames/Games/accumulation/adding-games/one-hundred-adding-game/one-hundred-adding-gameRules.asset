  data: {
    LLM: 'Game: One Hundred. Logic: See rules.objective and rules.gameplay.',
    Player: "One Hundred (or Hundred) is a classic 'adding' card game where players collectively build a running total. The goal is simple: avoid being the person to push the count over 100. It is a game of mental arithmetic, risk management, and tactical use of special ability cards that can reverse, double, or reset the total.",
    objective: 'Avoid playing a card that makes the running total exceed 100.',
    gameplay: "1. Players take turns playing one card to a central pile and announcing the new cumulative total.\n2. After playing, the player draws one card from the deck.\n3. **Basic Cards**: Numbers 2-9 (excluding 4 and 5) add their face value.\n4. **Special Cards**:\n   - **Aces**: Add 1 or 11 (player choice).\n   - **4s**: Direction of play reverses (adds 0).\n   - **5s**: Subtracts 10 from the total.\n   - **10s**: Sets the total to exactly 100 (or adds 0 if already at 100).\n   - **Face Cards (J, Q, K)**: Add 10.\n   - **9s**: The 'Monkey' or 'Safe' card - adds 0.",
    keyRules: [
      'Do not take the pile value over 100; if you cannot play without doing so, you lose one chip.',
      'After playing a card, draw one card from the stock.',
      'Last player with chips remaining wins.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
