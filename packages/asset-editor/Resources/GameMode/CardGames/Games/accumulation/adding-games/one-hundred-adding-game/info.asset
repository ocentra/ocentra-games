    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'One Hundred',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "One Hundred (or Hundred) is a classic 'adding' card game where players collectively build a running total. The goal is simple: avoid being the person to push the count over 100. It is a game of mental arithmetic, risk management, and tactical use of special ability cards that can reverse, double, or reset the total.",
              },
              {
                type: 'paragraph',
                text: "Likely a relative of the game '99'. The '100' threshold has been used in various gambling and parlor games for centuries, notably the German game 'Hundert'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 8 players.',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card deck for 3 to 6 players; two decks for 7 or more players.',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card deck for 3 to 6 players; two decks for 7 or more players.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 3 cards. The rest form a draw pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Two decks: Use two decks when 7 or more players; one deck for 3 to 6 players.',
                  },
                ],
              },
            ],
          },
        ],
      },
