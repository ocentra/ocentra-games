      award_pot: 'This game has no pot to award.',
      play_card: 'Legal only if the card type and current tableau state allow it (e.g. distance only when Roll is showing; hazard only on opponent who has Roll or empty speed area for Speed Limit).',
      draw: 'Once per turn at start of turn; from stock only.',
      discard: 'One card per turn when chosen; must discard if no other legal action.',
      pass: 'This game has no pass action.',
      bid: 'This game has no bid action.',
      meld: 'This game has no meld action.',
      go_out: 'This game has no go-out action.',
