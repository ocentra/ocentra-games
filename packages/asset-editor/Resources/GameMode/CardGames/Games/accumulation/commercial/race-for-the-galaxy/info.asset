        rules: {
          objective: 'Score the most victory points through developed cards, settled worlds, and bonus scoring.',
          gameplay: 'Players simultaneously choose phase cards, then all selected phases resolve. Hand cards act both as playable developments/worlds and as currency to pay for them, creating a tight hand-management engine.',
          keyRules: [
            'Players secretly choose phases each round.',
            'Cards in hand are also the currency for playing other cards.',
            'Victory comes from tableau points, chips, and bonus cards.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Focus first on the visible objective in Race for the Galaxy: conserve cards or resources that directly advance the win condition.',
          intermediate: 'Track public information and avoid giving opponents easy tempo swings during the middle turns.',
          advanced: 'Plan several turns ahead around the scoring window and force opponents into low-value or defensive plays.',
          tips: [
            'Track the cards and roles that have already appeared.',
            'Preserve flexible plays until they improve the final scoring position.',
          ],
