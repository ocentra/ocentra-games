        rules: {
          objective: 'Finish with the fewest bullhead penalty points after the agreed number of rounds.',
          gameplay: 'Each player chooses one card face down, then all are revealed and placed from lowest to highest into the legal row whose end card is nearest below it. If a card would be the sixth in a row, the player takes the row as penalties and starts a new row.',
          keyRules: [
            'Cards are selected simultaneously.',
            'Revealed cards resolve from lowest to highest.',
            'Cards must extend the nearest lower row end.',
            'Taking a sixth card row gives all its bullhead penalties.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Estimate which rows opponents will extend and avoid playing cards that become unavoidable sixth cards.',
          intermediate: 'Track the cards, suits, or resources that control the next legal plays, and avoid giving opponents a simple route to their scoring condition.',
