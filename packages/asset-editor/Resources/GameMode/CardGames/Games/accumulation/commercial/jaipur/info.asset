        rules: {
          objective: 'Win two seals of excellence by earning more rupees than the opponent in best-of-three rounds.',
          gameplay: 'On a turn, take goods or camels from the market, exchange cards with the market, or sell goods from hand for tokens. Larger sales earn bonuses, while rare goods lose value as tokens are claimed. A round ends when enough goods piles are exhausted or the deck runs out.',
          keyRules: [
            'Players choose between taking cards and selling cards each turn.',
            'Selling larger sets earns bonus tokens.',
            'Camels manage hand pressure and market exchange tempo.',
          ],
          hasPlaceholders: false,
