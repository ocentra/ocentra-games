        rules: {
          objective: 'Win more than 26 tricks to be the winner of the deal.',
          gameplay: '1. Non-dealer leads the first card.\n2. Standard Whist rules: Must follow suit if possible.\n3. Highest card of the suit led wins the trick, unless a trump is played.\n4. Winner of the trick leads the next.\n5. **Perfect Information**: Since all cards are dealt, players know exactly what the opponent holds at all times.',
          keyRules: [
            'Follow the legal action constraints defined for Humbug.',
            'Round outcome is resolved by the scoring method: The game is scored by the number of tricks won.',
            'Winning condition: Win more than 26 tricks to be the winner of the deal.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Card Counting: Since you know every card your opponent has, the game becomes a puzzle. Identify which suits you dominate and lead them early to draw out trumps.',
          intermediate: "Trump Management: If you have the higher trumps, use them to kill your opponent's Aces in their long suits.",
          advanced: "Endplay positioning: Force your opponent into a 'Throw-in' where they must lead into your winning cards in the final few tricks.",
          tips: [
            'Always track the remainders of the trump suit.',
            'In a game of 52 cards, the distribution is key. If you have 10 hearts, your opponent only has 3; use this to exhaust them.',
          ],
          hasPlaceholders: false,
        },
