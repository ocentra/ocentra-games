    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Cassino',
            subtitle: 'The Fishing Game',
            content: [
              {
                type: 'paragraph',
                text: "Cassino (also spelled Casino) is a classic fishing-capture card game originating in Italy and popular throughout the world. Players capture cards from a central tableau by matching rank (pairing) or arithmetic sum (combining). Special prizes exist for the Ten of Diamonds ('Big Cassino', worth 2 points) and Two of Spades ('Little Cassino', worth 1 point). The first player or team to reach 11 (or 21 in some variants) points wins.",
              },
              {
                type: 'paragraph',
                text: 'Cassino is one of the oldest fishing-type games in European card culture, with Italian origins. It was described in English-language card game books as early as the late 18th century.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2, 3, or 4 (4 often as 2v2 partnerships).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: 'Cards. Score sheet.',
              },
              {
                type: 'paragraph',
                text: "4 cards each; 4 cards face-up on table (the 'tableau'). Rest is stock. Redeal 4 each when hands empty until stock gone.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Royal Cassino: Aces count as 1 OR 14. Jacks = 11, Queens = 12, Kings = 13 for building purposes. Creates much richer building combinations.',
                  },
                  {
                    text: 'Draw Cassino: Players draw to replenish hand to 4 after each turn, rather than waiting for the whole hand to run out.',
                  },
                  {
                    text: 'Spade Cassino: Each spade captured earns individual points (Aâ™ =2, 2â™ =2, others=1). A much higher scoring variant.',
                  },
                ],
              },
            ],
          },
        ],
      },
