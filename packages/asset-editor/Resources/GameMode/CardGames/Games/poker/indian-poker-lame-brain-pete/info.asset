  data: {
    hero: {
      title: 'LAME BRAIN PETE',
      subtitle: 'The Shifting Wild Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Lame Brain Pete',
            subtitle: 'The Shifting Wild Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Lame Brain Pete is a stud poker variant belonging to the Cincinnati family of games. Players receive three hole cards and bet before four community cards are revealed one at a time. The unique twist is that the lowest-ranking exposed community card (and all cards of that rank) become wild cards, creating dynamic hand possibilities that change throughout the hand.',
              },
              {
                type: 'paragraph',
                text: "Lame Brain Pete is a variant of Cincinnati Poker, which emerged in the American Midwest in the early 20th century. The 'Lame Brain' name humorously refers to the frustration players feel when the wild card changes unfavorably.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-10 players (Optimal with 5-7).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips, and a flat playing surface.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 3 cards face-down (hole cards). Four cards are placed face-down in the center as community cards.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Classic Cincinnati: The first community card dealt is wild throughout, rather than determining the wild card at the end.',
                  },
                  {
                    text: 'High Card Wild: The HIGHEST exposed community card is wild instead of the lowest.',
                  },
                  {
                    text: 'Five Hole Cards: Players receive 5 hole cards instead of 3, creating more hand possibilities.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Lame Brain Pete is a stud poker variant belonging to the Cincinnati family of games. Players receive three hole cards and bet before four community cards are revealed one at a time. The unique twist is that the lowest-ranking exposed community card (and all cards of that rank) become wild cards, creating dynamic hand possibilities that change throughout the hand.',
    tags: [
