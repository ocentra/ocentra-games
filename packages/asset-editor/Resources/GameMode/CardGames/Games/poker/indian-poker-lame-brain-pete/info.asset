    historyContent: {
      origins: "Lame Brain Pete is a variant of Cincinnati Poker, which emerged in the American Midwest in the early 20th century. The 'Lame Brain' name humorously refers to the frustration players feel when the wild card changes unfavorably.",
      originCountries: [
        'USA',
      ],
      timeline: [
        'Early 1900s: Cincinnati Poker emerges as a popular home game variant.',
        "1940s-50s: Lame Brain Pete variant gains popularity as a 'Dealer's Choice' option.",
        'Present: Played in home games and occasionally in casino mixed games.',
      ],
      evolution: 'The game evolved from standard Cincinnati (where the first community card dealt is wild) to the more dynamic Lame Brain Pete variant where the lowest exposed card is always wild, creating shifting strategies.',
      cultural: "Popular in American home poker games, particularly as a 'wild card' game that adds excitement through the changing wild card mechanic.",
    },
    setupContent: {
      players: '3-10 players (Optimal with 5-7).',
      deck: 'Standard 52-card deck. No jokers.',
