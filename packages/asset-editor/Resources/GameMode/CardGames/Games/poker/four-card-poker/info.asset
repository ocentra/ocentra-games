    aiContent: {
      difficulty: {
        easy: 'Never bets 3x even with Four-of-a-Kind; folds pairs of 10s; plays 5-high junk hands.',
        medium: "Follows the '10s or better' rule; bets 3x on Three-of-a-Kind; understands the Aces Up payout table.",
        hard: "Perfectly calculates the probability of the dealer's 6-card hand based on the visible upcard; optimizes the 2x/3x decision point; manages its bankroll against the high-variance 'Ante Bonus' payouts.",
      },
      considerations: [
        'AI must account for the asymmetrical nature of the deal (5 cards vs 6 cards).',
      ],
