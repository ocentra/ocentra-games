    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Four Card Poker',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Four Card Poker is a popular casino table game that pits the player against the house. Similar to Three Card Poker, it is a game of decision-making and hand valuation, but with a unique twist: the dealer receives a significant card advantage (six cards to the player's five) to offset the fact that the dealer does not need to 'qualify' to play. Despite the name, players and the dealer use their best four-card hand from their respective totals, leading to a unique ranking system where Three-of-a-Kind actually beats a Flush.",
              },
              {
                type: 'paragraph',
                text: 'Designed by Roger Snow and owned by Shuffle Master (now part of Light & Wonder), Four Card Poker was released as a follow-up to the massive success of Three Card Poker. It was engineered to provide more aggressive betting options (up to 3x Ante) while maintaining a low entry barrier for casual gamblers.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically 1 to 6 players seated at a specialized casino table.',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card deck, usually shuffled by a machine after every hand.',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card deck, usually shuffled by a machine after every hand.',
              },
              {
                type: 'paragraph',
                text: 'The Player receives 5 cards. The Dealer receives 6 cards (one of which is turned face up).',
              },
            ],
          },
        ],
      },
