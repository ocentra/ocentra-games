    historyContent: {
      origins: 'Designed by Roger Snow and owned by Shuffle Master (now part of Light & Wonder), Four Card Poker was released as a follow-up to the massive success of Three Card Poker. It was engineered to provide more aggressive betting options (up to 3x Ante) while maintaining a low entry barrier for casual gamblers.',
      originCountries: [
        'USA',
      ],
      timeline: [
        'Early 2000s: Introduced to Las Vegas casinos.',
        '2005-2010: Becomes a standard fixture in casino pits nationwide.',
        "Present: One of the 'Big Three' specialty poker games alongside Three Card Poker and Ultimate Texas Hold'em.",
      ],
      evolution: "The game's hand rankings were mathematically tuned to account for the four-card format, specifically making Three-of-a-Kind rare enough to outrank both Straights and Flushes.",
      cultural: "Known for the 'Aces Up' side bet, which allows players to win big payouts regardless of whether they beat the dealer.",
    },
    setupContent: {
      players: 'Typically 1 to 6 players seated at a specialized casino table.',
      deck: 'One standard 52-card deck, usually shuffled by a machine after every hand.',
      equipment: 'One standard 52-card deck, usually shuffled by a machine after every hand.',
      dealing: 'The Player receives 5 cards. The Dealer receives 6 cards (one of which is turned face up).',
    },
    variationsContent: {
      list: [],
      noVariationsReason: 'Sources describe only the standard casino form with optional Aces Up side bet; no regional or rule variations documented.',
