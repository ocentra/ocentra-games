    ],
    comingSoon: false,
    minPlayers: 3,
    maxPlayers: 7,
    routePath: 'abyssinia-poker',
    LLM: 'Game: Abyssinia Poker. Logic: Market-buy phase (5 rounds). Progression: [Ante -> MarketSetup(2 up) -> (BuyPhase -> BetRound) x5 -> SimultaneousDeclare -> Showdown]. Buy costs: Ranks 2-5=2u, 6-K=1u, A=4u, Stock=2u (revealed face-up). Betting: Fixed Limit. Hand eval: High=StandardPoker, Low=AceToFive 8-or-better. Declaration: chips_in_fist {0=Low,1=High,2=Both}. PigRule=true: declaring Both and failing = forfeit pot. Split: 50/50 High/Low; high scoops if no qualifying low. Odd chip to High.',
    Player: 'Welcome to Abyssinia. Step up to the market where victory is bought, not dealt. You start with an empty hand and a table full of opportunities. Each round, you must buy one card from the face-up market or take a chance on the stock. Watch your budget—high ranks like Aces cost more than commoners. After five rounds of buying and betting, declare your hand: go for High, Low, or both. But beware the Pig Rule—declare Both and fail, and you leave the table empty-handed.',
    tagline: 'In this market, victory is bought, not dealt.',
    gameCategory: 'Poker',
    subcategory: 'High-Low Stud',
    playerMode: 'multiplayer',
    difficulty: 'Expert',
    duration: '20-40 minutes',
    origin: 'United States',
    originName: 'Abyssinia',
    deck: 'Standard 52-card deck',
