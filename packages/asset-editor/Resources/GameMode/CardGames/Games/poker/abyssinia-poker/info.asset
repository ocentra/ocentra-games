    hero: {
      title: 'ABYSSINIA',
      subtitle: 'Market-Driven High-Low Poker',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Abyssinia Poker',
            subtitle: 'Market-Driven High-Low Poker',
            content: [
              {
                type: 'paragraph',
                text: "Abyssinia is a five-card stud, high-low poker variant where players 'buy' cards from a central market. It introduces financial resource management to traditional poker mechanics.",
              },
              {
                type: 'paragraph',
                text: "Originating in the United States, Abyssinia was once a staple of 'Dealer's Choice' home games. It was extensively documented in Scarne on Cards (1949).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-7 players (Optimal with 5).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips, and a dealer button.',
              },
              {
                type: 'paragraph',
                text: '1. All players ante. 2. Dealer turns up two cards and places them beside the face-down deck (the Market). 3. No initial cards to players; each builds a 5-card hand over 5 buy rounds.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Fixed Market Price: All cards cost 2 units regardless of rank. Removes the tiered economy.',
                  },
                  {
                    text: 'Hidden Stock: Cards bought from the stock remain face-down (private), instead of being revealed to the table.',
                  },
                  {
                    text: '7-Card Abyssinia: Hand size is 7; best 5 of 7 play. Buy phases extend to 5 rounds.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Abyssinia is a five-card stud, high-low poker variant where players 'buy' cards from a central market. It introduces financial resource management to traditional poker mechanics.",
    tags: [
      'card-game',
