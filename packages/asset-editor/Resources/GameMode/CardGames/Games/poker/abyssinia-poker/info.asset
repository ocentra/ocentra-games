    historyContent: {
      origins: "Originating in the United States, Abyssinia was once a staple of 'Dealer's Choice' home games. It was extensively documented in Scarne on Cards (1949).",
      originCountries: [
        'United States',
      ],
      timeline: [
        '1940s: Emerged as a competitive stud variant in high-stakes home games.',
        '1950s: Standard tier-pricing (2u/1u/4u) for ranks became the house standard.',
        'Present: Remained a niche favorite in professional poker circles.',
      ],
      evolution: 'Replaced the random deal of Five-Card Stud with a tiered-cost economy for specific card ranks.',
      cultural: 'Reflects the American post-war home-game culture of introducing complex rules to standard gambling games.',
