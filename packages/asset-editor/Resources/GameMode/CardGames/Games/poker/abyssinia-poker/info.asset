    aiContent: {
      difficulty: {
        easy: "Buys 1-unit (6-K) cards only. Always declares High. Never uses the 'Both' declaration.",
        medium: "Attempts Lows if starting cards are both < 6. Avoids 'Both' declaration. Tracks own buy cost budget.",
        hard: "Simulates opponent declarations from face-up buys. Performs defensive blocking of low cards. Considers both halves of the pot when evaluating 'Both' declaration risk.",
      },
      considerations: [
        "AI must factor in 'Buy Cost' as a locked expense before evaluating pot odds.",
        'AI must model the face-up cards of all opponents to estimate their likely declaration direction.',
        "Pig Rule creates a high-variance situation: hard AI should only declare 'Both' when it has near-certain wins in both directions.",
      ],
    },
