    actions: {
      ante: {
        supported: true,
        description: 'Post the mandatory ante before cards are dealt. One unit equals the ante and minimum bet.',
        cost: '0',
        constraints: 'Required for each player at start of hand.',
        isTerminating: false,
        effectType: 'ante',
        effectHints: {},
      },
      deal: {
        supported: true,
        description: 'Dealer deals 5 cards to each player: 2 face down (hole cards) and 3 face up.',
        cost: '0',
        constraints: 'Dealer only. Performed at start of hand after ante.',
        isTerminating: false,
        effectType: 'deal',
        effectHints: {},
      },
      reveal_market: {
        supported: true,
        description: 'Dealer places 3 cards face up in a row and the undealt deck face down at the end of the row. The four buying options are: furthest card 1 unit, middle 2 units, next to deck 3 units, top of deck 4 units.',
        cost: '0',
        constraints: 'Dealer only. After initial deal.',
        isTerminating: false,
        effectType: 'reveal',
        effectHints: {
          from: 'stock',
          to: 'market',
        },
      },
      buy_market: {
        supported: true,
        description: 'Discard one card from hand and buy one of the three face-up cards to replace it. Pay 1, 2, or 3 units to the pot depending on position (furthest to nearest). Replacement stays face up if replacing an upcard, face down if replacing a hole card. Must keep at least two hole cards.',
        cost: {
          type: 'byRank',
        },
        constraints: 'During a buy round. Choose one of the three face-up cards. Price by position: 1, 2, or 3 units.',
        isTerminating: false,
        effectType: 'buy',
        effectHints: {
          from: 'market',
          to: 'hand',
          costSource: 'market',
        },
      },
      buy_stock: {
        supported: true,
        description: 'Discard one card from hand and buy the unknown top card of the deck for 4 units. You look at it but keep it face down. Must keep at least two hole cards.',
        cost: {
          type: 'flat',
          value: 4,
        },
        constraints: 'During a buy round. Takes the top card of the deck blind.',
        isTerminating: false,
        effectType: 'buy',
        effectHints: {
          from: 'stock',
          to: 'hand',
          costSource: 'stock',
        },
      },
      fold: {
        supported: true,
        description: 'Throw away your cards face down and take no further part in the hand. Forfeit all claim to the pot.',
        cost: '0',
        constraints: 'Available during any buy round or betting round.',
        isTerminating: true,
        effectType: 'fold',
        effectHints: {},
      },
      check: {
        supported: true,
        description: 'Pass action to next player without betting.',
        cost: '0',
        constraints: 'Only legal when no bet has been opened in the current betting round.',
        isTerminating: false,
        effectType: 'pass',
        effectHints: {},
      },
      call: {
        supported: true,
        description: 'Match the current highest open bet to stay in the hand.',
        cost: {
          type: 'match_current_bet',
        },
        constraints: 'Only legal when a bet or raise exists in the current round.',
        isTerminating: false,
        effectType: 'bet',
        effectHints: {},
      },
      bet: {
        supported: true,
        description: 'Open betting by placing the minimum bet.',
        cost: {
          type: 'min_bet',
        },
        constraints: 'Only legal when no bet opened yet in the current round. Player with best hand showing starts the betting.',
        isTerminating: false,
        effectType: 'bet',
        effectHints: {},
      },
      raise: {
        supported: true,
        description: 'Increase the current bet above the existing open bet.',
        cost: {
          type: 'min_raise',
        },
        constraints: 'Only legal when a bet or raise exists. Subject to agreed betting limits.',
        isTerminating: false,
        effectType: 'bet',
        effectHints: {},
      },
      declare: {
        supported: true,
        description: 'Secretly declare high, low, or both (e.g. chips in fist: 0=Low, 1=High, 2=Both). All surviving players reveal declarations simultaneously. Pig Rule: declaring Both and failing to win both halves forfeits entire pot share.',
        cost: '0',
        constraints: 'All active players declare simultaneously after the final betting round.',
        isTerminating: false,
        effectType: 'declare',
        effectHints: {},
      },
      reveal_hand: {
        supported: true,
        description: 'Reveal all hole cards face up for showdown.',
        cost: '0',
        constraints: 'At showdown for all active players.',
        isTerminating: false,
        effectType: 'reveal',
        effectHints: {},
      },
      award_pot: {
        supported: true,
        description: 'Dealer evaluates hands per declarations and splits pot between high and low winners. Pig Rule applied to Both declarers who fail.',
        cost: '0',
        constraints: 'Dealer only. After all hands revealed.',
