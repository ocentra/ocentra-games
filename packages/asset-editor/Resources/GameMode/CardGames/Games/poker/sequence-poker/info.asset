        rules: {
          objective: 'Win by having the best five-card hand at showdown. Hand values use standard poker rankings with sequences (straights) counting in hand evaluation.',
          gameplay: 'Poker variant where hands include sequences. Each player receives five cards. After the deal, hands are compared at showdown; the highest hand wins. No betting rounds in the basic form.',
          keyRules: [
            'Standard 52-card deck, five cards per player.',
            'Hands ranked by standard poker order: straight flush, four of a kind, full house, flush, straight, three of a kind, two pair, one pair, high card.',
            'Sequence (straight) is five consecutive ranks; A-2-3-4-5 (wheel) and 10-J-Q-K-A (broadway) are valid straights.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Hold cards that can form straights or high pairs; discard weak high cards that block sequences.',
          intermediate: "Track which ranks have been dealt to estimate opponents' straight potential; prefer connected cards over disconnected high cards.",
          advanced: 'Balance bluffing a strong sequence with actually building one; late position can represent straights more effectively.',
          tips: [
            'A-2-3-4-5 (wheel) and 10-J-Q-K-A (broadway) are the two ace-high straights; both count in standard poker order.',
            'In a no-betting variant, hand selection is key; aim for hands that make straights or strong pairs.',
          ],
          hasPlaceholders: false,
