          {
            title: 'Sequence Poker',
            subtitle: 'Poker',
            content: [
              {
                type: 'paragraph',
                text: 'Poker variant where hands include sequences. Combines poker with sequence-building mechanics.',
              },
              {
                type: 'paragraph',
                text: 'Sequence Poker is documented as a poker variant focused on sequence-building hand value; straights (sequences) are central to hand ranking.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French deck; four suits (Hearts, Diamonds, Clubs, Spades), thirteen ranks per suit (Ace through King). Used for five-card hands and standard poker hand rankings including straights.',
              },
              {
                type: 'paragraph',
                text: 'Cards or tiles',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt five cards one at a time, face down. No further cards are dealt during the hand.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'With betting: Add one or more betting rounds after the deal and before showdown; standard poker betting (bet, call, raise, fold) applies.',
                  },
                ],
              },
            ],
          },
        ],
