    hero: {
      title: 'CARIBBEAN STUD POKER',
      subtitle: 'Beat the Dealer. Chase the Jackpot.',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Caribbean Stud Poker',
            subtitle: 'Beat the Dealer. Chase the Jackpot.',
            content: [
              {
                type: 'paragraph',
                text: "Caribbean Stud Poker is a casino table game based on 5-card stud poker, played against the house (dealer) rather than against other players. Each player receives 5 cards and must choose to fold or raise after seeing one of the dealer's cards. The dealer must 'qualify' with A-K or better for the hand to play. Caribbean Stud features a progressive jackpot side bet for royal flushes and other premium hands.",
              },
              {
                type: 'paragraph',
                text: "Caribbean Stud Poker is believed to have been developed in the 1980s, allegedly by poker professional David Sklansky (originally as 'Casino Poker'). It spread through Caribbean cruise ships and casinos, reaching land-based casinos in the late 1980s and 1990s.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '1-7 players each playing individually against the dealer.',
              },
              {
                type: 'paragraph',
                text: '52 cards, standard.',
              },
              {
                type: 'paragraph',
                text: 'Casino table with betting spots. Optional progressive jackpot meter.',
              },
              {
                type: 'paragraph',
                text: 'Each player places an Ante bet. Optional: $1 side bet for progressive jackpot. Dealer deals 5 cards to each player and 5 to self, with one dealer card face-up.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Casino Stud Poker (UK variant): Essentially the same game with minor paytable differences.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Caribbean Stud Poker is a casino table game based on 5-card stud poker, played against the house (dealer) rather than against other players. Each player receives 5 cards and must choose to fold or raise after seeing one of the dealer's cards. The dealer must 'qualify' with A-K or better for the hand to play. Caribbean Stud features a progressive jackpot side bet for royal flushes and other premium hands.",
