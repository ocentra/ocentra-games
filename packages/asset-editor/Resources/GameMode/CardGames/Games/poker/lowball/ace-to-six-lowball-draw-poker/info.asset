        rules: {
          objective: 'Make the lowest five-card hand by ace-to-six ranking.',
          gameplay: 'Players contribute forced bets (ante or blinds), receive five down cards, complete first betting, perform a single draw (discard 0-5 then draw equal replacements, or stand pat), complete final betting, and go to showdown.',
          keyRules: [
            'Aces are always low.',
            'Straights and flushes count and are bad for low ranking.',
            'Best hand is 6-4-3-2-A (not a flush).',
            'A-2-3-4-5 is a straight and therefore weak in this variant.',
            'Hands are compared from highest card downward among low hands.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Avoid draws that can complete a straight or flush by accident.',
          intermediate: 'Track outs that spoil lows, especially 5-completions to A-2-3-4 patterns.',
          advanced: 'Use pat lines selectively, since opponents also account for straight/flush contamination risk.',
          tips: [
            'A-2-3 starts can be awkward if they force straight-prone continuation cards.',
            'A pat hand can be value or bluff depending on prior draw pattern.',
          ],
