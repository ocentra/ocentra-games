    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Psycho Poker',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Psycho Poker is a poker variant in which players wager over which hand is best according to the game's rules, with psychological or unusual rule twists typical of home-game variants. Standard poker hand rankings apply.",
              },
              {
                type: 'paragraph',
                text: "Poker was popularized in the American South in the early 19th century. Psycho Poker is a home-game or dealer's-choice style variant with psychological or unusual rules, documented in poker variant sources.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players. Optimal with 2.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck and poker chips (or equivalent) for betting.',
              },
              {
                type: 'paragraph',
                text: "Dealer shuffles; player to dealer's right cuts. Dealer deals five cards to each player one at a time, face-down, beginning with the player to the left. Remaining deck forms the stock.",
              },
            ],
          },
        ],
      },
