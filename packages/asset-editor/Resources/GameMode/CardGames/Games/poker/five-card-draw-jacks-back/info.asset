  data: {
    hero: {
      title: 'JACKS BACK',
      subtitle: 'Five Card Draw with Exposure',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Jacks Back (5 Card Draw)',
            subtitle: 'Five Card Draw with Exposure',
            content: [
              {
                type: 'paragraph',
                text: 'Jacks Back: Five Card Draw with Jacks or Better to open. If no one opens, the same hand is kept and played as ace-to-five lowball, so fewer deals are thrown in. Suited to three to five players.',
              },
              {
                type: 'paragraph',
                text: "Jacks Back is a draw poker variant that emerged from the Jacks or Better tradition in American home and club play. Five Card Draw with a pair of jacks or better required to open was the dominant form until the spread of Texas Hold'em; Jacks Back adapts that game for smaller groups by keeping the same hand in play when no one opens and switching to ace-to-five lowball, so fewer deals are thrown in. It is documented as a club and home game variant in US poker literature.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six players; three to five is ideal so that more hands are played and the Lowball fallback when no one opens is used often.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Chips.',
              },
              {
                type: 'paragraph',
                text: 'Five cards each face down; first betting round requires Jacks or Better to open. If someone opens, draw and second betting round as in Five Card Draw. If no one opens, same hand becomes ace-to-five lowball with a new betting round, then draw for low, then final betting and showdown.',
              },
            ],
          },
        ],
      },
    ],
    description: 'Jacks Back: Five Card Draw with Jacks or Better to open. If no one opens, the same hand is kept and played as ace-to-five lowball, so fewer deals are thrown in. Suited to three to five players.',
