  data: {
    hero: {
      title: 'Knock Poker',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Knock Poker',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Knock Poker (also known as Rap Poker) is an American draw and discard game in which the aim is to collect the best five-card poker hand. Unlike traditional poker, there is no betting process of raising and folding. Instead, players draw cards from a stock pile or take the previous player's discard, with the ability to 'knock' to end the round when they believe they have the strongest hand.",
              },
              {
                type: 'paragraph',
                text: "Knock Poker emerged in the United States in the early 20th century as a non-gambling alternative to traditional poker. It was documented in Albert Ostrow's 'The Complete Card Player' (1945) and later in Scarne's 'Encyclopedia of Games' (1973).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 5 players optimal. Can be played with 2 or more than 5 using the same rules.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card Anglo-American deck without jokers.',
              },
              {
                type: 'paragraph',
                text: 'Poker chips or coins for scoring and a central pot.',
              },
              {
                type: 'paragraph',
                text: "Cards are shuffled, cut by the player to dealer's right, and dealt one at a time until each player has five cards. The remainder forms a draw pile, with the top card turned face up to start the discard pile.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Simple Settlement: Knock ends play immediately with no additional turns. Best hand simply takes the pot with no other payments.',
                  },
                  {
                    text: 'Ante Per Draw: Each player adds an extra chip to the pot each time they draw a card.',
                  },
                  {
                    text: 'Minimum Knock Requirement: Players can only knock with a minimum hand such as a pair of Jacks or a pair of Aces.',
                  },
                  {
                    text: 'Bonus Wins: Extra bonuses paid by all players: 2 chips for knocking on first turn without drawing, 4 chips for royal flush, 2 chips for straight flush, 1 chip for four of a kind.',
                  },
                  {
                    text: 'Dompe: Mexican variant played with a Joker as wild card and possibility of winning with a 6-card hand.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Knock Poker (also known as Rap Poker) is an American draw and discard game in which the aim is to collect the best five-card poker hand. Unlike traditional poker, there is no betting process of raising and folding. Instead, players draw cards from a stock pile or take the previous player's discard, with the ability to 'knock' to end the round when they believe they have the strongest hand.",
