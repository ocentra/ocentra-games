    historyContent: {
      origins: 'Country/Region of Origin: China/Hong Kong\nTime Period: Traditional game, popularized in 20th century\nHistorical Development: Known as Sap Sam Cheung (十三張 - 13 cards) in Cantonese. Also called Luosong Pai Jiu (羅宋牌九 - Russian Pai Gow) in Chinese. Distantly related to Pai Gow.\nCultural Significance: Popular gambling game in Hong Kong, Southeast Asia, and among Asian communities in the USA.',
      originCountries: [
        'China',
        'Hong Kong',
      ],
      timeline: [
        'Traditional origins: Played for generations in China',
        '20th century: Popularized in Hong Kong and Southeast Asia',
        'Modern Era: Spread to USA, particularly Hawaii (called Pepito) and Filipino communities (called Pusoy)',
        'Recent development: Open Face Chinese Poker variant created',
      ],
      evolution: 'The traditional game evolved into Open Face Chinese Poker, where hands are built face up one card at a time after the initial five cards. This variant has become popular in poker player circles.',
      cultural: 'Known by many names across different regions: Pusoy (Philippines), Pepito (Hawaii), Russian Poker, Good Better Best. The game is often played for money with agreed unit values.',
    },
    setupContent: {
      players: 'Minimum Players: 2\nMaximum Players: 4\nOptimal Players: 4\nPartnerships: No, each plays for themselves',
      deck: 'Type: Standard 52-card pack\nNumber of Decks: 1\nJokers: None\nNo wild cards',
      equipment: 'Standard 52-card pack\nAgreed stake per unit\nTable space for arranging hands',
      dealing: 'Cards per Player: 13 cards each\nDealing Pattern: Singly, clockwise\nAll cards dealt at once',
    },
