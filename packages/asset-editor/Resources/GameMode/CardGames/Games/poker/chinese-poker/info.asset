        pages: [
          {
            title: 'Chinese Poker',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Chinese Poker, also known as Pusoy, Capsa Susun, or 13 Cards, is a card game where players arrange 13 cards into three poker hands (back, middle, front) that must increase in strength. Players compare corresponding hands against each opponent to win units.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: China/Hong Kong\nTime Period: Traditional game, popularized in 20th century\nHistorical Development: Known as Sap Sam Cheung (十三張 - 13 cards) in Cantonese. Also called Luosong Pai Jiu (羅宋牌九 - Russian Pai Gow) in Chinese. Distantly related to Pai Gow.\nCultural Significance: Popular gambling game in Hong Kong, Southeast Asia, and among Asian communities in the USA.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 4\nOptimal Players: 4\nPartnerships: No, each plays for themselves',
              },
              {
                type: 'paragraph',
                text: 'Type: Standard 52-card pack\nNumber of Decks: 1\nJokers: None\nNo wild cards',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack\nAgreed stake per unit\nTable space for arranging hands',
              },
              {
                type: 'paragraph',
                text: 'Cards per Player: 13 cards each\nDealing Pattern: Singly, clockwise\nAll cards dealt at once',
              },
            ],
          },
        ],
      },
