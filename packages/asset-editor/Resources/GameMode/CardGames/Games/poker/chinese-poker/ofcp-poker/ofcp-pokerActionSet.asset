        effectType: 'play',
        id: 'place_cards',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Draw the top card from the stock and expose it. You must then place it in one of your three hands (Back, Middle, or Front).',
        cost: '0',
        constraints: "Clockwise from dealer's left. One card per turn. When a row is full (5 back, 5 middle, 3 front), no more cards can be added to that row.",
        isTerminating: false,
        effectType: 'draw',
        id: 'draw_card',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Place the drawn card into one of your three hands (Back 5, Middle 5, or Front 3). Once placed, cards cannot be moved.',
        cost: '0',
        constraints: 'Must place in a row that is not yet full. Back and Middle hold 5 cards each; Front holds 3. Valid only if Back ≥ Middle ≥ Front strength.',
        isTerminating: false,
        effectType: 'play',
        id: 'place_card',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Compare Back vs Back, Middle vs Middle, Front vs Front against each opponent. Award 1 pt per hand won, 3 pt sweep bonus; apply royalties.',
