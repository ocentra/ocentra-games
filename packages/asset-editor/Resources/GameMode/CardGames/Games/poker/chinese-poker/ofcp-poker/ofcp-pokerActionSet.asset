      {
        supported: true,
        description: 'Set the initial 5 cards face-up into Back, Middle, or Front hand. Each card is assigned to one of the three hands; cards cannot be moved once placed.',
        cost: '0',
        constraints: "Dealer's left sets first; others follow clockwise. Each of the 5 cards must be placed in exactly one of Back (5), Middle (5), or Front (3).",
