  data: {
    hero: {
      title: 'OPEN FACE CHINESE POKER',
      subtitle: 'Partition Poker',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Open Face Chinese Poker (OFCP)',
            subtitle: 'Partition Poker',
            content: [
              {
                type: 'paragraph',
                text: 'Open Face Chinese Poker is a partition game where players receive 13 cards over several rounds and place them face-up into three hands: Back (5), Middle (5), and Front (3). Hands must be in descending strength (Back â‰¥ Middle â‰¥ Front) or the player fouls. Players score by winning hand comparisons and earning royalties for premium hands. Fantasyland rewards QQ+ in Front with 13 cards dealt at once next hand.',
              },
              {
                type: 'paragraph',
                text: 'OFCP originated in Russia and Finland in the early 21st century. It was introduced to the poker circuit by Russian players in Paris in early 2012.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 players. Pineapple works well with 3.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Each player has a board with 13 slots (Back 5, Middle 5, Front 3).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, chips or score sheet, agreed stake per point.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives 5 cards face-down. Players set them face-up. Then each player draws 1 card at a time (8 rounds), placing each in Back, Middle, or Front. Cards cannot be moved once placed.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Pineapple OFCP: 3 cards per turn; set 2, discard 1 face-down. Faster and more strategic. Popular with 3 players.',
                  },
                  {
                    text: 'Progressive OFCP: Fantasyland hand size depends on Top pair: KK=15 cards, AA=16, Trips=17. Discard excess before setting.',
                  },
                  {
                    text: 'Pineapple 2-7 OFCP: Middle hand is low-ball (2-7 ranking). Front and Back are high. 75432 in middle earns royalties.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Open Face Chinese Poker is a partition game where players receive 13 cards over several rounds and place them face-up into three hands: Back (5), Middle (5), and Front (3). Hands must be in descending strength (Back â‰¥ Middle â‰¥ Front) or the player fouls. Players score by winning hand comparisons and earning royalties for premium hands. Fantasyland rewards QQ+ in Front with 13 cards dealt at once next hand.',
    tags: [
