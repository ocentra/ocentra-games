        pages: [
          {
            title: 'Archie Poker',
            subtitle: 'Triple Draw High-Low',
            content: [
              {
                type: 'paragraph',
                text: 'Archie Poker (Archie) is a triple draw high/low split poker game. Five cards each; three draw rounds with betting (small, small, big, big). Pot is split between best qualifying high hand (pair of 9s or better, house rules vary) and best qualifying low (eight or better, ace-to-five). No qualifying high allows low to scoop; no qualifiers may split or go to best hand (house rules). Considered one of the most complex poker variants because hand value shifts across draws.',
              },
              {
                type: 'paragraph',
                text: 'USA; triple draw high/low split; Barge rulebook, countingouts.com, Steve Badger strategy.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2â€“6 (typically 6 max). Blinds. No partnerships.',
              },
              {
                type: 'paragraph',
                text: '52 cards. Standard high hand ranking; low = ace-to-five (8 or better to qualify).',
              },
              {
                type: 'paragraph',
                text: '52-card deck, chips.',
              },
              {
                type: 'paragraph',
                text: 'Five cards each, face down. Bet â€“ draw â€“ bet (small) â€“ draw â€“ bet (big) â€“ draw â€“ bet (big) â€“ showdown.',
              },
            ],
          },
        ],
