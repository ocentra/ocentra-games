    historyContent: {
      origins: 'Developed in American home poker games as a variant of Seven Card Stud to increase pot sizes and the frequency of big hands (Quads/Straight Flushes).',
      originCountries: [
        'USA',
      ],
      timeline: [
        "1950s: Becomes a popular 'Dealer's Choice' filler game.",
        '1970s: Reaches the fringes of underground casino play.',
        "Present: Commonly played in low-stakes social games and online 'wild card' lobbies.",
      ],
      evolution: "The game evolved into several sub-variants, including 'Hi-Lo' and 'Follow the Queen', but the core 'Low Hole' remains the most mathematically straightforward.",
      cultural: "Known as a 'beginner killer' because the presence of wild cards masks the true strength of opponents' hands.",
    },
    setupContent: {
      players: 'Up to 8 players.',
      deck: "Standard 52 cards. Ace is high (Ranking: A, K, Q... 2). For the purpose of the 'Low' calculation, 2 is the lowest card.",
