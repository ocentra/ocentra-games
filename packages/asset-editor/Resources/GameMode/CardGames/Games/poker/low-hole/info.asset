    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Low Hole (Wild Card Stud)',
            subtitle: 'Wild Card Stud',
            content: [
              {
                type: 'paragraph',
                text: "Low Hole is an action-packed 'dealer's choice' Poker variant played as Seven Card Stud. Its defining characteristic is the 'Low Hole' wild card rule: the lowest-valued card in each player's individual 'hole' (face-down cards) is wild for that specific player. Because your wild card can change as you receive new hole cards, it creates high-variance gameplay and massive winning hands.",
              },
              {
                type: 'paragraph',
                text: 'Developed in American home poker games as a variant of Seven Card Stud to increase pot sizes and the frequency of big hands (Quads/Straight Flushes).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Up to 8 players.',
              },
              {
                type: 'paragraph',
                text: "Standard 52 cards. Ace is high (Ranking: A, K, Q... 2). For the purpose of the 'Low' calculation, 2 is the lowest card.",
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips.',
              },
              {
                type: 'paragraph',
                text: 'Standard 7-card stud: 2 down, 4 up, 1 down.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Hi-Lo Low Hole: Split pot between best high and best low hands.',
                  },
                  {
                    text: 'Midnight Low Hole: The lowest card in the ENTIRE 7-card hand is wild (Dangerous!).',
                  },
                  {
                    text: 'Low Hole and the Lady: Lowest hole card AND all Queens are wild.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Low Hole is an action-packed 'dealer's choice' Poker variant played as Seven Card Stud. Its defining characteristic is the 'Low Hole' wild card rule: the lowest-valued card in each player's individual 'hole' (face-down cards) is wild for that specific player. Because your wild card can change as you receive new hole cards, it creates high-variance gameplay and massive winning hands.",
    tags: [
      'card-game',
      'poker',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 8,
    routePath: 'low-hole',
    LLM: 'Game: Low Hole. Seven Card Stud with wild cards. 2-8 players. 2 down, 1 up; 4th-6th up, 7th down. Lowest hole card is wild for each player (individual wilds). 7th card may change wild card. Standard poker hand rankings with wilds. Five of a Kind possible.',
    Player: 'Welcome to Low Hole! In this wild Seven Card Stud game, your LOWEST hole card is WILD for youâ€”and it can change when you get your final card! Start with 2 down, 1 up. Your lowest down card is wild. Get another low card down on 7th street? Your wild just changed!',
    tagline: 'Your lowest hole card is wildâ€”and it can change!',
    gameCategory: 'Poker',
    subcategory: 'Wild Card Stud',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
