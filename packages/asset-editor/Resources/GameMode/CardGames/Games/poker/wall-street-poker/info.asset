        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Wall Street Poker',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Wall Street Poker is a Seven-Card Stud variant with buyable community cards. 2-7 players. 52-card deck. Deal 3 hole cards (2 down, 1 up). 4 community cards ('Wall Street') placed face-up with escalating costs (1-4 units). Players can buy a community card (goes to pot) or get a free card from deck. Named after aggressive financial bidding.",
              },
              {
                type: 'paragraph',
                text: 'Wall Street is a seven-card stud variant in the buy-your-card family where players pay fixed amounts to the pot to acquire cards. The name refers to the row of four face-up community cards (Wall Street) that players may buy at 1-4 units or pass for a free card from the deck. It shares mechanics with The Price is Right but offers four market cards and a free-card alternative; the theme evokes bidding and speculation in home poker.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck; one pack. No jokers or stripped cards.',
              },
              {
                type: 'paragraph',
                text: 'Cards, chips',
              },
              {
                type: 'paragraph',
                text: "Ante. 3 hole cards (2 down, 1 up) + 4 community 'Wall Street' cards.",
              },
            ],
          },
        ],
      },
