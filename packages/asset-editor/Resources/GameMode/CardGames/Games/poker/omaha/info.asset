  data: {
    hero: {
      title: 'OMAHA',
      subtitle: 'Four Cards, Two Choices',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Omaha',
            subtitle: 'Four Cards, Two Choices',
            content: [
              {
                type: 'paragraph',
                text: "Omaha is a community-card poker variant where each player receives four hole cards and must use exactly two of them with exactly three of the five board cards to make their best five-card hand. The constraint makes hand-reading and drawing significantly different from Texas Hold'em.",
              },
              {
                type: 'paragraph',
                text: "Omaha emerged in the 1980s, likely in casino card rooms, and rapidly became a staple of both live and online poker. It derives from Texas Hold'em but adds the mandatory two-from-hand, three-from-board rule.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-10 players (typically 6-9 at a full table).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips, dealer button.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives four hole cards face-down. Five community cards are dealt in stages: flop (3), turn (1), river (1).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Omaha High: Standard pot-limit or fixed-limit; only the best high hand wins.',
                  },
                  {
                    text: 'Omaha Hi-Low 8-or-Better: Pot splits between best high and best qualifying low (8-high or better). Commonly fixed-limit.',
                  },
                  {
                    text: 'Five Card Omaha (Big O): Each player receives five hole cards; must still use exactly two with three board cards.',
                  },
                  {
                    text: 'Six Card Omaha: Six hole cards; must use exactly two with three board cards.',
                  },
                  {
                    text: 'Courchevel: One board card is dealt face-up before the first betting round; popular in France.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
