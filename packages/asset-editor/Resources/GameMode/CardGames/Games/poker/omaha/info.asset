        rules: {
          objective: 'Win the pot by having the best five-card hand at showdown, using exactly two hole cards and exactly three board cards.',
          gameplay: '1. Blinds posted (small and big blind). 2. Each player receives four hole cards. 3. First betting round (pre-flop). 4. Dealer burns one card and deals three community cards (flop). 5. Second betting round. 6. Burn and deal one card (turn). 7. Third betting round. 8. Burn and deal one card (river). 9. Final betting round. 10. Showdown: each active player must use exactly two hole cards and exactly three board cards to make their best hand.',
          keyRules: [
            'Exactly two hole cards and exactly three board cards must be usedâ€”no more, no fewer.',
            'Standard poker hand rankings apply.',
            'Pot Limit Omaha (PLO): maximum raise equals current pot size.',
            'Omaha/8: Pot splits 50/50 between best high hand and best qualifying low (8-or-better); ace plays low for low.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Play hands with coordinated cardsâ€”same suits and close ranks for straights and flushes. Four random high cards are weaker than 9-10-J-Q double-suited.',
          intermediate: 'Blockers matter: if you hold two Aces, opponents are less likely to have nut flush draws. Fold marginal hands pre-flop; Omaha punishes loose play.',
          advanced: 'Equity runs close; avoid overvaluing top set on a coordinated board. Nut draws (e.g. nut flush + straight draw) have strong implied odds.',
          tips: [
            'Position is crucialâ€”late position lets you see more action before committing.',
            'In Omaha/8, scooping (winning both halves) is the key to profit; avoid playing hands that can only win one way.',
          ],
          hasPlaceholders: false,
        },
