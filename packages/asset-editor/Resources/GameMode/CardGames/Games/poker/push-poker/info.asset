  data: {
    hero: {
      title: 'Push Poker',
      subtitle: 'Poker',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Push Poker',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Push is a five-card stud poker variant in which players may pay an agreed price to reject an upcard offered by the dealer and receive the next card from the deck instead. Four rounds of card-offer and pushing are followed by betting; highest hand wins.',
              },
              {
                type: 'paragraph',
                text: 'Push is a five-card stud variant in the Pass the Trash family; players may pay to reject an offered upcard and receive the next card from the deck.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 to 9 players. Best with 5 to 7.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck and chips. Push price (e.g. 5 times minimum bet) agreed in advance.',
              },
              {
                type: 'paragraph',
                text: 'One hole card face down to each player. Then the dealer offers one card face up to the player to his left; that player may accept it or pay the agreed price to push it and receive the next card from the deck (second card must be accepted). The next player is offered the pushed card or a new card; this continues for all players. After each of four such rounds there is a betting round. Final hand is five cards (one hole, four up); highest hand wins.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Roll your own: All cards dealt face down; pushing is free. After four rounds each player has one hole card and four face-up cards; can be played all-high, all-low, or high-low with declaration.',
                  },
                  {
                    text: 'Substitution: After the final betting round, active players may pay an agreed price (e.g. 10× minimum bet) to discard one card and receive a replacement from the deck; then a final betting round and showdown.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
