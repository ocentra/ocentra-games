        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Five Card Draw',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Five Card Draw is the quintessential variant of Poker and was for decades the most popular form of the game played in homes and Western films. Unlike community card games like Texas Hold 'em, Five Card Draw is a 'closed' game where all cards are held privately. The game features a unique 'Draw' phase where players can discard unwanted cards and replace them with new ones from the deck, allowing for sophisticated bluffing based on the number of cards drawn.",
              },
              {
                type: 'paragraph',
                text: 'Five Card Draw evolved from older Persian (As-Nas) and French (Poque) games in the early 19th-century United States. It gained massive popularity during the American Civil War, becoming a staple of frontier life and eventually the standard for global homendgamers.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 6 players. Best with 5 or 6.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 5 cards face down.',
              },
            ],
          },
        ],
      },
    ],
    description: "Five Card Draw is the quintessential variant of Poker and was for decades the most popular form of the game played in homes and Western films. Unlike community card games like Texas Hold 'em, Five Card Draw is a 'closed' game where all cards are held privately. The game features a unique 'Draw' phase where players can discard unwanted cards and replace them with new ones from the deck, allowing for sophisticated bluffing based on the number of cards drawn.",
