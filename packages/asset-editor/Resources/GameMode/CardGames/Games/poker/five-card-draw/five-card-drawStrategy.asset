  data: {
    LLM: "If your starting hand is less than a pair of Kings, you should usually fold early. Don't waste money 'chasing' a draw unless the pot odds are very favorable.\n\nThe 'One Card Draw' Bluff: If you draw only one card, opponents will assume you are fishing for a Straight or a Flush. You can use this to represent strength even if you have nothing.\n\nBreaking a Pair: In high-level play, you might break a low pair to draw for a Straight Flush if the pot is massive, though this is statistically risky.",
    Player: "If your starting hand is less than a pair of Kings, you should usually fold early. Don't waste money 'chasing' a draw unless the pot odds are very favorable.\n\nThe 'One Card Draw' Bluff: If you draw only one card, opponents will assume you are fishing for a Straight or a Flush. You can use this to represent strength even if you have nothing.\n\nBreaking a Pair: In high-level play, you might break a low pair to draw for a Straight Flush if the pot is massive, though this is statistically risky.",
    aggressiveness: 0.5,
    riskTolerance: 0.5,
    bluffFrequency: 0.3,
    bluffSettings: {
      profile: 'balanced',
    },
    basic: "If your starting hand is less than a pair of Kings, you should usually fold early. Don't waste money 'chasing' a draw unless the pot odds are very favorable.",
    intermediate: "The 'One Card Draw' Bluff: If you draw only one card, opponents will assume you are fishing for a Straight or a Flush. You can use this to represent strength even if you have nothing.",
    advanced: 'Breaking a Pair: In high-level play, you might break a low pair to draw for a Straight Flush if the pot is massive, though this is statistically risky.',
    tips: [
      {
        title: 'Tip',
        description: "Pay attention to how many cards opponents draw. A player drawing 3 usually has a pair; a player drawing 1 has a draw or two-pair; a player drawing 0 is 'standing pat' with a very strong hand.",
      },
      {
        title: 'Tip',
        description: "Position is everything. If you are the last to act, you have the most information about your opponents' drawing patterns.",
      },
    ],
  },
