  data: {
    hero: {
      title: 'DIABLO',
      subtitle: 'The Pot-Escalating Draw Poker',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Diablo',
            subtitle: 'The Pot-Escalating Draw Poker',
            content: [
              {
                type: 'paragraph',
                text: "Diablo is a high-action Five Card Draw poker variant characterized by three primary mechanics: Deuces are wild, players are restricted to drawing a maximum of two cards, and most importantly, if the player who opens the betting fails to win the pot, they must 'match the pot' to create a new one for the next deal.",
              },
              {
                type: 'paragraph',
                text: "A staple of 'Dealer's Choice' home games in the United States. Its exact origin is undocumented, but it belongs to the mid-20th century tradition of 'action-inducing' poker variants.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players (Best with 5-6 to ensure enough competition for the opener).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. All four 2s are wild.',
              },
              {
                type: 'paragraph',
                text: 'Poker chips, dealer button.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 5 cards face down. In some variants, the first replacement card drawn later is dealt face up, though standard Diablo keeps all cards face down (verify with house rules).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Capped Diablo: To prevent bankrupting players, the amount the opener must match is capped at a fixed limit (e.g., 20 big blinds).',
                  },
                  {
                    text: 'Exposed Diablo: The first card drawn by each player is dealt face up, providing more information to the table.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Diablo is a high-action Five Card Draw poker variant characterized by three primary mechanics: Deuces are wild, players are restricted to drawing a maximum of two cards, and most importantly, if the player who opens the betting fails to win the pot, they must 'match the pot' to create a new one for the next deal.",
    tags: [
      'card-game',
      'poker',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'five-card-draw-diablo',
    LLM: 'Game: Diablo (Five Card Draw Poker). Deuces (2s) are wild. Setup: 5-card deal to each player, standard antes. Gameplay: First betting round (standard poker), then draw phase (max 2 cards), then second betting round. Showdown: Best hand wins pot. Diablo rule: If the player who opened (bet first in round 1) loses the hand, they pay the pot amount into a new pot for next deal. No new antes; deal passes left. Cycle repeats until opener wins. Hand rankings include Five-of-a-Kind as highest (due to wild cards).',
    Player: "Welcome to Diablo! Deuces are wild. You can draw a maximum of 2 cards. Here's the twist: If you open the betting and lose the hand, you must match the potâ€”doubling it for the next deal. This creates escalating pots and high-stakes tension. Only open if you have the chips and the hand!",
    tagline: 'Deuces wild. Maximum 2-card draw. Openers must win or match the pot.',
    gameCategory: 'Poker',
    subcategory: 'Draw Poker',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '10-20 minutes (per hand)',
    origin: 'USA (Home Game variant)',
    originName: 'Diablo',
    deck: '52-card standard deck',
    alsoKnownAs: [
      'Diablo Poker',
      'Must-Win Opener Poker',
    ],
    playersDisplay: '2-6 (Optimal: 5-6)',
    quality: 'complete',
    completeness: {
