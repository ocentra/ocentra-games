    historyContent: {
      origins: "A staple of 'Dealer's Choice' home games in the United States. Its exact origin is undocumented, but it belongs to the mid-20th century tradition of 'action-inducing' poker variants.",
      originCountries: [
        'USA',
      ],
      timeline: [
        'Mid-20th Century: Diablo emerges in social poker circles.',
        '2010: First documented in English-language card-game references as a Draw Poker variant.',
      ],
      evolution: "Derived from Standard Five Card Draw, the 'Diablo' element was added to ensure pots grow exponentially and to penalize marginal openers.",
      cultural: "Known as a 'pot-builder' or 'destroyer of bankrolls' in casual settings.",
