        pages: [
          {
            title: 'Trees Poker',
            subtitle: 'Poker',
            content: [
              {
                type: 'paragraph',
                text: 'Poker variant with a tree-themed or environmental twist. Players receive five cards face-down, post an ante, and play one round of betting (check, bet, call, raise, or fold) before showdown; highest standard poker hand wins the pot.',
              },
              {
                type: 'paragraph',
                text: 'Poker spread from the United States in the 19th century. Trees Poker is a thematic variant with tree or environmental twist; specific origin and history are not documented in available sources.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card deck with French suits (Hearts, Diamonds, Clubs, Spades); no jokers. Same composition as standard poker.',
              },
              {
                type: 'paragraph',
                text: 'Cards or tiles',
              },
              {
                type: 'paragraph',
                text: "Dealer shuffles; player to dealer's right cuts. Dealer deals five cards face-down to each player, one at a time, clockwise from the player to dealer's left.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'No Limit: Play with no maximum bet; any bet up to full stack is allowed.',
                  },
                ],
              },
            ],
          },
        ],
      },
