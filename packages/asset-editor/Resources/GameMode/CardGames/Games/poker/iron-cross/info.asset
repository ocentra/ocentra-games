    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Iron Cross Poker',
            subtitle: 'Community Card Poker',
            content: [
              {
                type: 'paragraph',
                text: "Iron Cross (also known as Criss-Cross or Church Poker) is a popular community-card poker variant played in 'dealer's choice' games. Five community cards are arranged in a cross pattern on the table. Each player receives two hole cards and must form the best five-card hand by combining their cards with either the vertical or horizontal line of the cross.",
              },
              {
                type: 'paragraph',
                text: "Developed as a variation of '7-Card Stud' and 'Texas Hold'em'. The unique cross layout adds a layer of spatial decision-making to the betting process.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 to 8 players is optimal.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips.',
              },
              {
                type: 'paragraph',
                text: 'Deal two hole cards face-down to each player. Arrange 5 community cards face-down in a cross (three horizontal, three vertical, sharing a middle card).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'High-Low Iron Cross: Best hand on vertical splits the pot with best hand on horizontal.',
                  },
                  {
                    text: 'Wild Cross: The center card is wild.',
                  },
                  {
                    text: 'Double Cross: Two crosses are dealt, creating four possible paths.',
                  },
                ],
              },
            ],
          },
        ],
      },
