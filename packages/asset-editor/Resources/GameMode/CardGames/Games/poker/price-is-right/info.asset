            title: 'Price is Right, The Poker',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Price is Right Poker is an American poker variant themed on the TV game show. Players use a standard 52-card deck and standard poker hand rankings; gameplay combines hand-building with guessing or bidding on prices. Two to six players compete to form the best hand.',
              },
              {
                type: 'paragraph',
                text: 'American TV game show themed poker variant; inspired by The Price Is Right; combines poker hand rankings with guessing or bidding on prices.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck and poker chips or tokens for price-guessing rounds.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives each player five cards; the remainder stays as stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Price Guess Bonus: Before showdown, one item is priced; closest guess without going over wins a chip bonus added to the pot.',
