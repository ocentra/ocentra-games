          {
            title: '5 Card Stud High-Low With a Buy',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Five Card Stud High-Low with a Buy: each player gets one hole card and four face-up cards over four betting rounds. Pot split between best high hand and best low hand (typically 8-or-better). The buy is an optional mechanic allowing players to purchase an extra card or modifier; exact implementation varies by house rules.',
              },
              {
                type: 'paragraph',
                text: 'Stud poker first appeared in America in the 1860s as an open game with one hole card and four face-up cards. Five Card Stud High-Low with a Buy is a home and club variant that combines the high-low split pot with an optional buy round after the fifth card; it persists in home games even as casino five-card stud declined in the late 20th century.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Only five cards per player are dealt, so up to 10 can play.',
              },
              {
                type: 'paragraph',
                text: 'Chips, deck',
              },
              {
                type: 'paragraph',
                text: 'One down, four up; four betting rounds.',
              },
            ],
          },
