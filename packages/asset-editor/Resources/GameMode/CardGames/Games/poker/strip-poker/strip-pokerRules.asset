  data: {
    LLM: 'Play is the same as five-card draw: deal five cards, first betting round, discard and draw (0 to 5 cards), second betting round, showdown. Stakes can be chips only, clothing only, or a combination; losers remove an item per lost hand or when out of chips.',
    Player: 'Play is the same as five-card draw: deal five cards, first betting round, discard and draw (0 to 5 cards), second betting round, showdown. Stakes can be chips only, clothing only, or a combination; losers remove an item per lost hand or when out of chips.',
    objective: 'Win the pot by having the highest-ranking five-card poker hand at showdown or by forcing all other players to fold. In strip poker, losers remove clothing (or stakes can be chips and clothing).',
    gameplay: 'Play is the same as five-card draw: deal five cards, first betting round, discard and draw (0 to 5 cards), second betting round, showdown. Stakes can be chips only, clothing only, or a combination; losers remove an item per lost hand or when out of chips.',
    keyRules: [
      'Standard five-card draw hand rankings.',
      'Stand pat (draw zero) or discard and draw up to five.',
      'Betting rounds before and after the draw.',
      'Stakes agreed in advance (clothing, chips, or both).',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2 to 6 players.',
      deck: 'Standard 52-card deck.',
      equipment: 'Standard deck; chips or clothing stakes as agreed.',
      dealing: 'Each player is dealt five cards face down. After first betting round, each player may discard 0 to 5 cards and receive that many from the deck. Second betting round, then showdown.',
    },
    turnFlow: 'Play is the same as five-card draw: deal five cards, first betting round, discard and draw (0 to 5 cards), second betting round, showdown. Stakes can be chips only, clothing only, or a combination; losers remove an item per lost hand or when out of chips.',
    moveValidityConditions: {
      ante: 'Strip poker is often played without an ante; stakes are chips or clothing as agreed.',
      deal: 'Deal is performed by the dealer; not a player action.',
      reveal_market: 'This game does not use a market to reveal.',
      buy_market: 'This game has no market purchase.',
      buy_stock: 'This game has no buying from stock.',
      fold: 'Legal during any betting round when it is your turn to act.',
      check: 'Legal only when no one has bet in the current betting round.',
      call: 'Legal when a bet has been made and you have not yet acted to the current bet.',
      bet: 'Legal when no bet has been made in the current round; amount must meet minimum.',
      raise: 'Legal when a bet has been made; must raise by at least the minimum raise.',
      declare: 'This game has no declare phase.',
      reveal_hand: 'Legal in showdown phase when you are still in the hand.',
      award_pot: 'Triggered after showdown; not a player-initiated action.',
      play_card: 'Strip poker is draw poker; cards are not played to a trick, only revealed at showdown.',
      draw: 'Legal in draw round after discarding; draw count must match discard count.',
      discard: 'Legal in draw round; must discard before drawing; can stand pat by discarding zero.',
      pass: 'This game has no pass action.',
      bid: 'This game has no bid action.',
      meld: 'This game has no meld action.',
      go_out: 'This game has no go-out action.',
    },
    exampleHands: [
      'Setup example: 5 card(s) per player.',
      'Rule example: Win the pot by having the highest-ranking five-card poker hand at showdown or by forcing all other players to fold. In strip poker, losers remove clothing (or stakes can be chips and clothing).',
      'Turn-flow example: Play is the same as five-card draw: deal five cards, first betting round, discard and draw (0 to 5 cards), second betting round, showdown. Stakes can be chips only, clothing only, or a combination; losers remove an item per lost hand or when out of chips.',
      'Scoring example: Highest five-card poker hand at showdown wins the pot; or the last player remaining when all others have folded. In strip poker, losers may remove clothing as stakes. Highest five-card hand at showdown wins the pot; or last player left after all others fold..',
