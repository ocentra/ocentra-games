          hasPlaceholders: false,
        },
        rules: {
          objective: 'Win the pot by having the highest-ranking five-card poker hand at showdown or by forcing all other players to fold. In strip poker, losers remove clothing (or stakes can be chips and clothing).',
          gameplay: 'Play is the same as five-card draw: deal five cards, first betting round, discard and draw (0 to 5 cards), second betting round, showdown. Stakes can be chips only, clothing only, or a combination; losers remove an item per lost hand or when out of chips.',
          keyRules: [
            'Standard five-card draw hand rankings.',
            'Stand pat (draw zero) or discard and draw up to five.',
            'Betting rounds before and after the draw.',
            'Stakes agreed in advance (clothing, chips, or both).',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Play solid draw poker: fold weak hands, draw to improve pairs and draws, bet when you improve.',
          intermediate: 'Bluff by standing pat or drawing one card; read opponents by how many they draw.',
          advanced: 'Balance value bets and bluffs; use position; adjust to agreed stakes (chips vs clothing).',
          tips: [
            'Agree stakes and rules before play.',
            'Worst hand at showdown (or everyone except winner) removes clothing in the classic version.',
          ],
          hasPlaceholders: false,
        },
