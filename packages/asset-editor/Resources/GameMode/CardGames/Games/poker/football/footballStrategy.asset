    tips: [
      {
        title: 'Tip',
        description: "Keep an eye on the deck. If several players have received extra cards from 2s, the dealer may run out of cards for the final street. In this case, the final card is often dealt as a common 'community card'.",
      },
      {
        title: 'Tip',
        description: "Wild cards are common; don't be afraid to fold a Straight if the board is showing lots of 3s and 6s.",
      },
