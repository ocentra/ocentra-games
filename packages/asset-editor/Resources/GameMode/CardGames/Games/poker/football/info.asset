    },
    historyContent: {
      origins: "Derived from the older Poker variant 'Baseball,' Football adapted the 'sportndthemed wild card' concept to focus on different numeric values. It emerged in midnd20th century American home games as a more complex and highndscoring alternative to standard Stud.",
      originCountries: [
        'USA',
      ],
      timeline: [
        "1950s: Becomes a popular variant alongside 'Baseball' in American social clubs.",
        "1980s: Variations involving 'overtime' cards and 'extra points' are documented in poker strategy books.",
        "Present: Remains a favorite 'chaos' game in recreational poker loops.",
      ],
      evolution: 'The game evolved from Baseball with different wild ranks: 3s and 6s are wild and 2s grant an extra card, creating massive pots and unpredictable showdowns.',
      cultural: 'Often played during major sports events (like the Super Bowl) as a thematic drinking or social game.',
    },
    setupContent: {
      players: "2 to 6 players. Limited to 6 due to the 'extra card' rule potentially exhausting the deck.",
      deck: 'Standard 52-card deck.',
      equipment: 'Standard 52-card deck.',
      dealing: 'Standard Seven Card Stud format: 2 cards face-down, 4 cards face-up, 1 final card face-down.',
    },
    variationsContent: {
      list: [],
      noVariationsReason: 'Sources describe only the standard form; no regional or rule variations documented for Football. Pagat lists it as a single variant of Baseball (3s and 6s wild, 2s extra card) with no sub-variants.',
    },
    aiContent: {
      difficulty: {
        easy: "Doesn't realize 3s and 6s are wild; ignores the benefit of the extra card from 2s; plays standard Stud strategy incorrectly.",
        medium: 'Uses 3s and 6s to build hands; recognizes when an opponent is likely representing Five-of-a-Kind; folds when up-cards are dominated.',
        hard: "Calculates the dynamic odds of receiving extra cards; uses the high volatility to its advantage by bluffing during 'low wild card' rounds; perfectly calculates equity in 10-player/extra-card scenarios.",
      },
      considerations: [
        'AI must handle hands that have variable lengths (e.g. some players have 7 cards, others have 9).',
      ],
    },
