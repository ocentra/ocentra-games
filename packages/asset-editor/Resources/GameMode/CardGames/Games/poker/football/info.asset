    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Football',
            subtitle: 'The Wild Card Stud Game',
            content: [
              {
                type: 'paragraph',
                text: "Football is a high-action Poker variant based on Seven Card Stud, themed around American Football. It is characterized by its numerous wild cards and the 'extra boost' mechanics that mirror scoring in football. In this game, 3s and 6s are wild, and 2s give an extra card when dealt face-up. It is an extremely volatile game where hand rankings frequently reach Five-of-a-Kind, making it a staple of casual Dealer's Choice poker nights.",
              },
              {
                type: 'paragraph',
                text: "Derived from the older Poker variant 'Baseball,' Football adapted the 'sportndthemed wild card' concept to focus on different numeric values. It emerged in midnd20th century American home games as a more complex and highndscoring alternative to standard Stud.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "2 to 6 players. Limited to 6 due to the 'extra card' rule potentially exhausting the deck.",
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard Seven Card Stud format: 2 cards face-down, 4 cards face-up, 1 final card face-down.',
              },
            ],
          },
        ],
      },
    ],
    description: "Football is a high-action Poker variant based on Seven Card Stud, themed around American Football. It is characterized by its numerous wild cards and the 'extra boost' mechanics that mirror scoring in football. In this game, 3s and 6s are wild, and 2s give an extra card when dealt face-up. It is an extremely volatile game where hand rankings frequently reach Five-of-a-Kind, making it a staple of casual Dealer's Choice poker nights.",
    tags: [
      'card-game',
      'poker',
      'stud',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'football',
    LLM: 'Game: Football (Seven Card Stud variant). Deal: 2 down, 4 up, 1 down. Wild cards: 3s and 6s. Extra card rule: Any player dealt a 2 face-up immediately receives an additional face-up card. Betting: Each street has a betting round. Hand lengths may vary (7-9 cards). Win: Best 5-card Poker hand at showdown. Hand rankings: Five-of-a-Kind (highest), Royal Flush, Straight Flush, Four-of-a-Kind, Full House, etc.',
    Player: "Welcome to Football, the wild-card Seven Card Stud variant. Threes and sixes are wild. If you're dealt a 2 face-up, you immediately get an extra card. Build the best 5-card hand using your seven (or more) cards. Five-of-a-Kind beats everything.",
    tagline: 'Threes and sixes are wild. Twos get extra cards. Five-of-a-Kind rules.',
    gameCategory: 'Poker',
    subcategory: 'Stud / Wild Cards',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '15-25 minutes',
    origin: 'USA',
    originName: 'Football (American poker variant)',
    deck: 'Standard 52-card deck',
    alsoKnownAs: [
      'Football Poker',
      'Football Stud',
      'Twos, Sevens and Jokers Wild',
      'Football Card Game',
    ],
    playersDisplay: '2-6',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
      variations: true,
