        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Aces, Straights and Flushes Poker',
            subtitle: 'Shared Bug Stud',
            content: [
              {
                type: 'paragraph',
                text: 'A seven-card stud variant where each player gets six personal cards and everyone shares a central joker as the seventh card. The joker is a bug: it can act as an ace or complete a straight or flush, but not build non-ace sets.',
              },
              {
                type: 'paragraph',
                text: "Documented in dealer's choice circles as a stud variant with a shared bug joker.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'From two to eight players may take part, as in standard seven-card stud; the game plays best with five to seven. Each player receives six personal cards and shares one center joker as the seventh card.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck and one joker placed face-up in center.',
              },
              {
                type: 'paragraph',
                text: 'Deck, chips, dealer button.',
              },
              {
                type: 'paragraph',
                text: 'Deal starts as stud: two down and one up to each player, with later streets as defined by house flow.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'ASAF Lowball: Low-hand winner variant using table-agreed low ranking.',
                  },
                ],
              },
            ],
          },
        ],
      },
