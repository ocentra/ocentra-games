  data: {
    hero: {
      title: 'One Arm Joe',
      subtitle: 'Poker',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'One Arm Joe',
            subtitle: 'Indian Poker One-Card',
            content: [
              {
                type: 'paragraph',
                text: 'One Arm Joe (One-Armed Pete) is a one-card variant of Indian Poker. Each player receives one card face-down, holds it to their forehead so everyone else can see it but they cannot, then bets. Highest card at showdown wins the pot. A game of pure deduction and bluff.',
              },
              {
                type: 'paragraph',
                text: 'Indian Pokerâ€”cards held to the forehead so others see your card but you do notâ€”originated in America. The name has nothing to do with India; it refers to cards resembling a headdress. One Arm Joe and One-Armed Pete are regional names for the one-card variant.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "Two to eight players. The one-card variant is the basic form: each player is dealt one card face down, picks it up without looking, and holds it against the forehead so all others can see its value. A round of betting follows; at showdown the highest card among those who did not fold wins the pot. The game is usually played with 2–8; skills involved are probability and reading other players' actions and bets.",
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace high; no suit ranking for ties.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips.',
              },
              {
                type: 'paragraph',
                text: 'Each player antes. Dealer deals one card face-down to each player. Players pick up their card without looking, hold it facing outward, and place it against their forehead so all others can see it.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Low Wins: Lowest card wins instead of highest. Otherwise identical.',
                  },
                  {
                    text: 'High-Low Split: Best high card and best low card split the pot.',
                  },
                  {
                    text: 'Match Pot: Stay/drop declaration; best card wins; others who stayed must match the pot.',
                  },
                  {
                    text: 'Two-Card Indian: Deal two cards each; best hand wins. Less common; not much more strategic.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
