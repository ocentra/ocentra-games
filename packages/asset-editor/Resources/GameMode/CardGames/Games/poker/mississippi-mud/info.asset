            title: 'Mississippi Mud',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mississippi Mud: 7-card stud variant where the first and fourth upcards dealt to each player are wild for that player. Same deal as 7-card stud; two designated upcards act as wilds. USA; dealer's choice.",
              },
              {
                type: 'paragraph',
                text: 'American 7-card stud variant; named for the wild upcards. Distinct from the casino game Mississippi Stud.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to eight players may take part; a standard 52-card pack is used. The game is best for five to seven players. When eight play, the deck may run out toward the end of the deal.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Chips; table space.',
              },
              {
                type: 'paragraph',
                text: 'Same as 7-card stud. First upcard (3rd street) and fourth upcard (6th street) for each player are wild for that player.',
              },
            ],
          },
        ],
      },
