    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Guts',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Guts is a high-stakes poker variant known for its rapidly escalating pots and simple 'in or out' decision-making. Players receive 2-3 cards and simultaneously declare whether they're 'in' (competing for the pot) or 'out' (folding). Losers must match the entire pot, causing explosive pot growth. The name refers to the bravery required to risk large sums.",
              },
              {
                type: 'paragraph',
                text: "Developed in the United States as a dealer's choice poker variant. The exact origin is unknown, but it became popular in home games and casinos in the mid-20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-10 players. (Best with 5-8).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 2 or 3 cards (variant-dependent). No community cards. Simultaneous in/out declaration.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Simultaneous Declare: All players declare in or out at once, e.g. on dealer's call of 1-2-3-DROP (drop cards to be out) or using chips in closed fist (chip = in). No sequential bluffing.",
                  },
                  {
                    text: 'Single Loser, Ante on All Deals: Only the player with the worst hand among those in matches the pot. Players ante every deal; only whoever had to match the pot is excused from ante on the next deal.',
                  },
                  {
                    text: 'Kitty or Ghost: An extra hand (ghost) is dealt and exposed at showdown. To win you must beat the ghost and other players. If ghost wins, everyone who stayed in matches the pot.',
                  },
                  {
                    text: 'Three-Card Guts: Each player receives three cards. Hand ranking usually: three of a kind, straight flush, straight, flush, pair, nothing. Declaration and match-pot procedure same as two-card.',
                  },
                ],
              },
            ],
          },
        ],
      },
