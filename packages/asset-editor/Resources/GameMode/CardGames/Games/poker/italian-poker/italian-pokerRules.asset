  data: {
    LLM: 'Ante; optional blind (buio, controbuio, over) before deal. Deal 5 cards each. First betting round: pass or open (with pair of Jacks or better, or 4-card straight-flush draw); then fold, call, raise. Draw: each surviving player may exchange 0–4 cards. Second betting round: bet, check, or parol (throw in and carry pot); then fold, call, raise. Showdown: highest hand wins; flush beats full house; straight flush has min/medium/max with min beating max.',
    Player: 'Ante; optional blind (buio, controbuio, over) before deal. Deal 5 cards each. First betting round: pass or open (with pair of Jacks or better, or 4-card straight-flush draw); then fold, call, raise. Draw: each surviving player may exchange 0–4 cards. Second betting round: bet, check, or parol (throw in and carry pot); then fold, call, raise. Showdown: highest hand wins; flush beats full house; straight flush has min/medium/max with min beating max.',
    objective: 'Win the pot by having the highest-ranking hand at showdown, or by being the last player standing when all others have folded.',
    gameplay: 'Ante; optional blind (buio, controbuio, over) before deal. Deal 5 cards each. First betting round: pass or open (with pair of Jacks or better, or 4-card straight-flush draw); then fold, call, raise. Draw: each surviving player may exchange 0–4 cards. Second betting round: bet, check, or parol (throw in and carry pot); then fold, call, raise. Showdown: highest hand wins; flush beats full house; straight flush has min/medium/max with min beating max.',
    keyRules: [
      'Opening requires pair of Jacks or better, or four consecutive cards of a suit (no Ace) that can extend to straight flush.',
      'Flush ranks above full house. Straight flush: minimum beats maximum, maximum beats medium, medium beats minimum.',
      'Ties broken by suit order: hearts highest, then diamonds, clubs, spades.',
      'Direction of play is clockwise.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '4, 5, or 6 players.',
      deck: 'Short deck of 32 (4 players), 36 (5) or 40 (6) cards from a standard 52-card pack; lowest rank is 11 minus number of players.',
      equipment: 'Standard deck (short pack), chips for betting; ante amount and min/max limits agreed before play.',
      dealing: "All players ante (invito). Optionally the first player may open blind (buio) before the deal; then dealer gives 5 cards each, one at a time clockwise starting to dealer's left.",
    },
    turnFlow: 'Ante; optional blind (buio, controbuio, over) before deal. Deal 5 cards each. First betting round: pass or open (with pair of Jacks or better, or 4-card straight-flush draw); then fold, call, raise. Draw: each surviving player may exchange 0–4 cards. Second betting round: bet, check, or parol (throw in and carry pot); then fold, call, raise. Showdown: highest hand wins; flush beats full house; straight flush has min/medium/max with min beating max.',
