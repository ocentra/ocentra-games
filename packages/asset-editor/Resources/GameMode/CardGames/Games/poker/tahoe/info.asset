          {
            title: 'Tahoe',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Tahoe (also known as Wichita Hold'em) is a community card poker game similar to Texas Hold'em and Pineapple. Players receive three hole cards (sometimes two, but usually three in the Tahoe variant) and share five community cards. The key restriction is that players may use zero, one, or two of their hole cards to form a handâ€”never all three. It is often played High-Low Split.",
              },
              {
                type: 'paragraph',
                text: "A variant of Texas Hold'em and Pineapple poker, arising as home games sought more action.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Chips, dealer button',
              },
              {
                type: 'paragraph',
                text: 'Deal 3 hole cards to each player. 5 community cards dealt in Flop-Turn-River stages.',
              },
            ],
          },
        ],
      },
