      {
        title: 'Tip',
        description: "Observe which cards opponents choose to reveal first; cautious players reveal their lowest 'junk' cards.",
      },
      {
        title: 'Tip',
        description: 'In Hi-Lo variants, always track the number of low cards showing to judge the safety of a low-hand split.',
      },
      {
        title: 'Tip',
        description: 'The choice of what to reveal is your primary weapon - use it to tell a story.',
