    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Roll Your Own Poker',
            subtitle: 'Choose Your Fate',
            content: [
              {
                type: 'paragraph',
                text: "Roll Your Own is a strategic 'style' of Stud Poker (most commonly Seven-Card Stud) where the dealer provides cards face-down, and players choose which ones to reveal to their opponents. This shifts the game from a test of luck into a nuanced game of information management and bluffing. 'Dakota' is a specific high-low variation of this style featuring personal wild cards based on the lowest hidden card.",
              },
              {
                type: 'paragraph',
                text: "Developed as a home-game enhancement to Seven-Card Stud. It gained popularity in rural American poker circles (like North/South Dakota, giving rise to the 'Dakota' variant) for adding a 'choice' element to the otherwise fixed Stud deal.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-7 players (limit based on 52-card deck exhaustion).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard cards, poker chips, dealer button.',
              },
              {
                type: 'paragraph',
                text: "Varies by variant. Standard 'Roll Your Own' deals 3 cards down initially, then 4 more sequentially.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Mexican Stud: Five-card version. Two down initially, roll one. Dealt one down, roll one, until 4 up 1 down.',
                  },
                  {
                    text: 'Mississippi Mud: Two cards discarded from 7. Every card is revealed sequentially. High-Low with declaration.',
                  },
                ],
              },
            ],
          },
        ],
      },
