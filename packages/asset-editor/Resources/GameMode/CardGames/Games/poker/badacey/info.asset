    hero: {
      title: 'BADACEY',
      subtitle: 'The Ultimate Split-Pot Duel',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Badacey',
            subtitle: 'The Ultimate Split-Pot Duel',
            content: [
              {
                type: 'paragraph',
                text: "Badacey is a high-skill, split-pot poker variant that combines the unique hand-building of Badugi with the classic Ace-to-Five Lowball. Players are dealt five cards and undergo three rounds of drawing to create two distinct winning combinations: a 4-card Badugi hand (all different suits and ranks) and a 5-card Lowball hand. It is a 'mixed game' favorite in high-stakes circles, prized for its complex mathematical crossovers.",
              },
              {
                type: 'paragraph',
                text: "Developed in the early 2000s in Las Vegas and California card rooms as part of the 'Mixed Game' movement. It was created to merge the popularity of Badugi with the more established Ace-to-Five Lowball format.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six players. All players post an ante; the dealer gives each player five cards face down. Play uses a dealer button with small and big blinds; the game is commonly played with fixed-limit betting in card rooms.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck (No Jokers).',
              },
              {
                type: 'paragraph',
                text: 'Poker chips, Dealer button, Small/Big Blind markers.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 5 cards face down. There are three drawing rounds where players can discard 0-5 cards and receive replacements.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Badeucy: Uses Deuce-to-Seven rules for the low half instead of Ace-to-Five.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Badacey is a high-skill, split-pot poker variant that combines the unique hand-building of Badugi with the classic Ace-to-Five Lowball. Players are dealt five cards and undergo three rounds of drawing to create two distinct winning combinations: a 4-card Badugi hand (all different suits and ranks) and a 5-card Lowball hand. It is a 'mixed game' favorite in high-stakes circles, prized for its complex mathematical crossovers.",
