    aiContent: {
      difficulty: {
        easy: "Draws until they have any 4-card Badugi. Doesn't understand the 'Wheel' concept for the low half.",
        medium: "Understands 'Smooth' vs 'Rough' lows. Will only bet if they have at least 3 cards to an 8-low or better.",
        hard: "Perfectly calculates the probability of improving a 3-card Badugi based on revealed cards. Uses 'Snowing' bluffs against tight opponents.",
      },
      considerations: [
        'AI must calculate two independent Hand Strengths (Badugi-Rank and Low-Rank) for a single selection.',
        'Requires a complex discard-optimization algorithm (Which 5 to keep for the 4-card split?).',
      ],
    },
