    tips: [
      {
        title: 'Tip',
        description: 'Aces represent double value in Badacey: they are the best card for both the Low and the Badugi halves.',
      },
      {
        title: 'Tip',
        description: "Pay attention to 'folded' cards if the game allows peeking at the muck; it tells you which low cards are out of play.",
