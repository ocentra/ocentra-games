      {
        title: 'Tip',
        description: 'Avoid pairs at all costs. A hand with a pair of 2s loses to any no-pair hand, even one with a King.',
      },
      {
        title: 'Tip',
        description: "Watch for 'counterfeited' cards. If you have 7-5-4-3-2 and a 7 is dealt to an opponent, you're now playing 5-4-3-2-X.",
      },
      {
        title: 'Tip',
        description: "Don't chase with 9-low or worse if there's significant actionâ€”someone likely has you beat.",
