    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'English Stud',
            subtitle: 'Poker Variant',
            content: [
              {
                type: 'paragraph',
                text: 'English Stud is a 7-card stud variant where players have the unique option to exchange cards during the deal. Deal and play follow standard 7-card stud, but after each betting round (following the 5-card and 6-card streets), each player can optionally exchange one card for a new one. This card exchange feature distinguishes English Stud from traditional 7-card stud.',
              },
              {
                type: 'paragraph',
                text: 'British adaptation of American 7-card stud; Pot-Limit and club rules common in UK card rooms.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six players. Six is the maximum for this variant so the deck suffices for the deal and two optional single-card exchange rounds; with five or fewer players a seventh face-down card may be dealt as in standard seven-card stud. Best with five or six players for balance of action and card availability.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Chips; table space.',
              },
              {
                type: 'paragraph',
                text: 'Same as 7-card stud. Betting structure often Pot-Limit or Spread-Limit (local rules).',
              },
            ],
          },
        ],
      },
