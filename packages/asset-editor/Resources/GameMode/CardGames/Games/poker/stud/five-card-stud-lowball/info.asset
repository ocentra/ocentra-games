    hero: {
      title: 'FIVE CARD STUD LOWBALL',
      subtitle: 'Ace-to-Five Stud',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Five Card Stud Lowball',
            subtitle: 'Ace-to-Five Stud',
            content: [
              {
                type: 'paragraph',
                text: "Five Card Stud Lowball is a variant of Five Card Stud where the lowest hand wins instead of the highest. Played with the same dealing structure as standard Five Card Stud (one hole card, four up cards), it uses ace-to-five lowball ranking where straights and flushes do not count against the player. The best possible hand is A-2-3-4-5 (the 'wheel').",
              },
              {
                type: 'paragraph',
                text: 'Five Card Stud Lowball evolved from Five Card Stud in the early-to-mid 20th century as poker players sought low-hand variants. It became particularly popular in California card rooms and American home games as a simpler alternative to Razz (Seven Card Stud Low).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-10 players (optimal with 4-7).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips, dealer button.',
              },
              {
                type: 'paragraph',
                text: 'Five Card Stud format: 1 card face down (hole card), 4 cards face up. Four betting rounds.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Ace-to-Six Lowball: Aces are low but straights and flushes DO count against you. A-2-3-4-5 is a straight and therefore a poor hand. Best hand is A-2-3-4-6 (not a straight).',
                  },
                  {
                    text: 'Deuce-to-Seven Lowball: Aces are high, and straights/flushes count. Best hand is 2-3-4-5-7 (not a straight). Also known as Kansas City Lowball.',
                  },
                  {
                    text: 'Five Card Stud High-Low: Pot splits between highest and lowest hands. Often played with declaration or with an 8-or-better qualifier for low.',
                  },
                  {
                    text: "Five Card Stud Lowball with a Buy: After the fifth card, players may 'buy' a sixth card (face down) for an additional bet. Best 5 of 6 cards play.",
                  },
                  {
                    text: 'Razz: Seven Card Stud Lowballâ€”same hand rankings but with seven cards dealt (2 down, 4 up, 1 down). More popular in modern poker.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Five Card Stud Lowball is a variant of Five Card Stud where the lowest hand wins instead of the highest. Played with the same dealing structure as standard Five Card Stud (one hole card, four up cards), it uses ace-to-five lowball ranking where straights and flushes do not count against the player. The best possible hand is A-2-3-4-5 (the 'wheel').",
