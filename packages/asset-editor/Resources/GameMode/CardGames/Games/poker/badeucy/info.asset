    aiContent: {
      difficulty: {
        easy: "Draws indiscriminately. Doesn't realize that their 6-high straight is a terrible low hand.",
        medium: "Understands 'Nut' low draws. Will fold pre-draw if they hold multiple suits that could lead to a flush.",
        hard: "Expertly calculates 'Smoother' vs 'Rougher' lows. Bluffs 'pat' hands on the third draw if the board suggests opponents are drawing weak suits.",
      },
      considerations: [
        "AI must factor in the 'Flush/Straight' penalty logic when evaluating the Low-5 hand.",
        'Requires a specialized suit-distribution check for every hand state.',
      ],
