    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Badeucy',
            subtitle: "The Expert's Triple Draw",
            content: [
              {
                type: 'paragraph',
                text: "Badeucy is a sophisticated split-pot poker variant that blends the mechanics of Badugi with Deuce-to-Seven Triple Draw. In this high-stakes favorite, players aim to build two specific low hands: a 4-card 'Badugi' (four different suits and ranks) and a 5-card Deuce-to-Seven low. Unlike its sister game Badacey, Aces in Badeucy are always high and detrimental, making the 2-3-4-5-7 'Wheel' the ultimate goal.",
              },
              {
                type: 'paragraph',
                text: "Part of the modern 'Mixed Game' evolution in high-stakes poker rooms. It was popularized by players who enjoyed the complexity of Deuce-to-Seven Lowball and wanted to add a Badugi component back when Badugi was the newest trend in the mid-2000s.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six players. All players make an ante bet; the dealer gives each player five cards face down, then a round of betting and three draw-and-bet cycles before the final betting and split-pot showdown.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Poker chips, Dealer button, Small/Big Blind markers.',
              },
              {
                type: 'paragraph',
                text: '5 cards face down to each player. 3 draw phases follow.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Badacey: The variant where Aces are low and straights/flushes are ignored.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
