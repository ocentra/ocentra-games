      declare: 'This game has no declare phase.',
      reveal_hand: 'Legal at showdown when you are an active player.',
      award_pot: 'This game has no pot to award.',
      play_card: 'Sviten Special has no card play to the table during rounds; only betting, draw replacement, and showdown.',
      draw: 'Legal in draw_replace phase after discarding; draw from stock (deck). If deck is exhausted, muck is shuffled to form new deck.',
      discard: 'Legal in draw_replace phase; must discard before drawing; number discarded determines number of replacements.',
      pass: 'This game has no pass action.',
      bid: 'This game has no bid action.',
      meld: 'This game has no meld action.',
      go_out: 'This game has no go-out action.',
