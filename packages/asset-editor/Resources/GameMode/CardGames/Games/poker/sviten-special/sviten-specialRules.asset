      reveal_market: 'This game does not use a market to reveal.',
      buy_market: 'This game has no market purchase.',
      buy_stock: 'This game has no buying from stock.',
      fold: 'Legal when it is your turn in a betting round.',
      check: 'Legal only when no bet has been made in the current round (or you have already matched the current bet).',
      call: 'Legal when a bet has been made and you have not yet matched it.',
      bet: 'Legal when no bet has been made in the current round; maximum bet is the current pot size (pot limit).',
