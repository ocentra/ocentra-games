    hero: {
      title: 'MATCH POT POKER',
      subtitle: 'Card game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Match Pot Poker',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Match Pot Poker is a dramatic high-stakes poker variant where players must match the entire pot when dealt a face-up 3 (the 'Strike'). This creates massive pot escalation and intense decision points. The game combines elements of Baseball Poker with an even more severe penalty structure, making it a favorite for adrenaline-seeking home game players.",
              },
              {
                type: 'paragraph',
                text: "Originating in the United States as an evolution of Baseball Poker, Match Pot Poker amplifies the 'Strike' penalty to create massive pots. It was documented in various poker variant collections in the late 20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-7 players (Optimal with 5-6).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips, and a dealer button.',
              },
              {
                type: 'paragraph',
                text: 'Standard 7-Card Stud deal: 2 down, 1 up, then 3 more up, then 1 down. Players use best 5 of 7.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Match Pot Baseball: Combines Match Pot rules with Baseball's 3s and 9s wild, plus 4s for extra cards.",
                  },
                  {
                    text: 'Double Match: Second face-up 3 requires matching double the pot.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
