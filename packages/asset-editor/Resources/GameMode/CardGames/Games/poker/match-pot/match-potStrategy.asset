      {
        title: 'Tip',
        description: 'Track which 3s have been dealt face-up; the remaining 3s become less dangerous',
      },
      {
        title: 'Tip',
        description: "In a 6-player game, be aware that multiple face-up 3s can create pots larger than some players' stacks",
