    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: '4-2-3 (Four-Two-Three)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Four-Two-Three (4-2-3) is a Guts-family poker variant. Each player is dealt four cards face-down; players declare in or out simultaneously (e.g. with a coin in fist). The dealer then deals three common cards face up. Players who stayed in form their best five-card poker hand from their four hole cards plus the three board cards; the best hand wins the pot. All who stayed in and lost must match the pot. Game ends when one player stays in alone and wins.',
              },
              {
                type: 'paragraph',
                text: 'Variant of Four-Two-Two (4-2-2), contributed by Brian Johnson; differs by dealing three common cards instead of two face-up cards per player.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to ten players; Guts-style games typically work best with around five to ten. All agree ante and optional maximum loss per deal before play.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack, no jokers.',
              },
              {
                type: 'paragraph',
                text: 'Cards, chips or money for ante and pot, optional coin for simultaneous declare.',
              },
              {
                type: 'paragraph',
                text: 'Dealer shuffles and deals four cards face-down to each player. After declarations, dealer deals three common cards face up in the center.',
              },
            ],
          },
        ],
      },
