    aiContent: {
      difficulty: {
        easy: 'Uses basic hand valuation; opens only with pair of Kings or better; does not bluff; draws 0–4 cards by simple rule (e.g. always draw 3 with one pair).',
        medium: 'Evaluates hands using Turkish ranking (flush > full house, three of a kind > straight); opens and bluffs occasionally; considers draw count when betting.',
        hard: 'Full Turkish hand order and suit tiebreaks; models opponents from draw counts and betting; exploits opening requirement and second-round position.',
      },
      considerations: [
        'AI must use Turkish hand order: flush beats full house, three of a kind beats straight; suit ranking breaks ties.',
        'Opening requirement (pair of Kings) must be enforced; opener proof-on-demand when folding or winning without showdown.',
      ],
