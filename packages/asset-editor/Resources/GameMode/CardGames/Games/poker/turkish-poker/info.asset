    hero: {
      title: 'TURKISH POKER',
      subtitle: 'Poker',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Turkish Poker',
            subtitle: 'Poker',
            content: [
              {
                type: 'paragraph',
                text: 'Türk pokeri (Turkish Poker) is a five-card draw variant played with a short deck of 24 to 36 cards depending on player count. Each player receives five cards; up to four may be exchanged in the draw. Opening requires a pair of Kings; hand rankings differ from international poker (flush beats full house, three of a kind beats straight).',
              },
              {
                type: 'paragraph',
                text: 'Turkish poker (Türk pokeri) is a draw poker variant using a shortened French deck; information is attributed to Burçin Kerem Seyis. It follows the same deal–bet–draw–bet–showdown structure as five-card draw but with a minimum opening requirement of a pair of Kings and distinct hand rankings.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 5 players.',
              },
              {
                type: 'paragraph',
                text: 'Short deck: 24 cards (2 players) through 36 cards (5 players), made by removing low cards from a standard 52-card pack.',
              },
              {
                type: 'paragraph',
                text: 'Cards and chips.',
              },
              {
                type: 'paragraph',
                text: 'First dealer chosen at random; deal rotates left. Before each deal all players ante an equal amount. Cards are shuffled, cut, and dealt clockwise one at a time until each player has five cards.',
              },
            ],
          },
        ],
      },
    ],
