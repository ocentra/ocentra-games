    historyContent: {
      origins: 'Turkish poker (Türk pokeri) is a draw poker variant using a shortened French deck; information is attributed to Burçin Kerem Seyis. It follows the same deal–bet–draw–bet–showdown structure as five-card draw but with a minimum opening requirement of a pair of Kings and distinct hand rankings.',
      originCountries: [
        'Turkey',
      ],
      timeline: [
        'Contemporary: Turkish draw poker variant using a shortened French deck; information attributed to Burçin Kerem Seyis.',
      ],
      evolution: 'Uses stripped deck (24–36 cards) and regional hand order: flush above full house, three of a kind above straight; suits break ties.',
      cultural: 'Played in Turkey with Turkish hand names (Floş, Kare, Ful, Üçlü, Kent, Doper, Per, Yüksek Kart).',
    },
    setupContent: {
