        rules: {
          objective: 'Form the best five-card poker hand; the highest-ranked hand at showdown wins the pot. Hand order differs from standard poker: flush ranks above full house in the 32-card deck.',
          gameplay: 'Blinds. Deal 5. Betting round. Draw up to 4 cards. Final betting. Showdown. Altered rankings: Flush > Full House (flushes rarer in 32-card deck). A can be low: A-7-8-9-10 = valid straight. Suit ranking may tiebreak.',
          keyRules: [
            '32-card stripped deck (7-A)',
            'Flush beats Full House',
            'Ace-low straights (A-7-8-9-10)',
            'Suit ranking tiebreaker',
            'Draw up to 4 cards',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Flush pursuit is more valuable than in standard 52-card poker because flushes are rarer in the 32-card deck.',
          intermediate: 'Understand stripped-deck probabilities: straights and flushes are more common, while full houses are slightly less frequent than in a full deck.',
          advanced: 'Track suit distribution to leverage the suit ranking tiebreaker; avoid drawing into easily dominated flushes when opponents likely hold higher suits.',
          tips: [
            'Hands that would be marginal in a 52-card game, such as medium flushes, gain value because flushes are rarer in the 32-card deck.',
            'Because players may draw up to four cards, be cautious about slow-playing strong but fragile hands before the draw.',
            'When using suit order as a tiebreaker, prefer building flushes in higher-ranking suits and avoid committing heavily with weak-suit flushes.',
          ],
