    advanced: 'Track suit distribution to leverage the suit ranking tiebreaker; avoid drawing into easily dominated flushes when opponents likely hold higher suits.',
    tips: [
      {
        title: 'Tip',
        description: 'Hands that would be marginal in a 52-card game, such as medium flushes, gain value because flushes are rarer in the 32-card deck.',
      },
      {
        title: 'Tip',
        description: 'Because players may draw up to four cards, be cautious about slow-playing strong but fragile hands before the draw.',
      },
      {
        title: 'Tip',
        description: 'When using suit order as a tiebreaker, prefer building flushes in higher-ranking suits and avoid committing heavily with weak-suit flushes.',
