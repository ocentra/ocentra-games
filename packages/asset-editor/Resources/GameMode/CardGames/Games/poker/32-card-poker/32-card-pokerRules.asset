  data: {
    LLM: 'Blinds. Deal 5. Betting round. Draw up to 4 cards. Final betting. Showdown. Altered rankings: Flush > Full House (flushes rarer in 32-card deck). A can be low: A-7-8-9-10 = valid straight. Suit ranking may tiebreak.',
    Player: 'Blinds. Deal 5. Betting round. Draw up to 4 cards. Final betting. Showdown. Altered rankings: Flush > Full House (flushes rarer in 32-card deck). A can be low: A-7-8-9-10 = valid straight. Suit ranking may tiebreak.',
    objective: 'Form the best five-card poker hand; the highest-ranked hand at showdown wins the pot. Hand order differs from standard poker: flush ranks above full house in the 32-card deck.',
    gameplay: 'Blinds. Deal 5. Betting round. Draw up to 4 cards. Final betting. Showdown. Altered rankings: Flush > Full House (flushes rarer in 32-card deck). A can be low: A-7-8-9-10 = valid straight. Suit ranking may tiebreak.',
    keyRules: [
      '32-card stripped deck (7-A)',
      'Flush beats Full House',
      'Ace-low straights (A-7-8-9-10)',
      'Suit ranking tiebreaker',
      'Draw up to 4 cards',
    ],
    bonusRuleGuids: [],
