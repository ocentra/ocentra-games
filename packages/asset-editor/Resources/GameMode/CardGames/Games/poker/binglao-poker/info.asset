    historyContent: {
      origins: 'Developed within the Nordic tournament poker circuit as a way to increase variety and skill testing in mixed-game festivals. It gained official recognition when it was added to the side-event schedule of the Norwegian Poker Championship week in Dublin.',
      originCountries: [
        'Norway',
      ],
      timeline: [
        "2010s: Binglao appears as a novelty '6-Max' side event in European tournaments.",
        '2015: Becomes a recurring feature of the Nordic mixed-game rotation.',
        'Present: Played both as a tournament specialty and a high-stakes cash game format in specialized card rooms.',
      ],
      evolution: "Binglao is part of the 'Omaha-plus' trend, where increasing the number of hole cards (5-card and 6-card variants) has become popular to create more drawing opportunities and multi-way action.",
      cultural: "Reflects the Norwegian community's enthusiasm for complex Pot Limit games, where position and range calculation are highly prized.",
    },
    setupContent: {
      players: 'Typically 2 to 6 players; the 6-max format is standard to accommodate the potential for 6 hole cards per player.',
      deck: 'Standard 52-card French pack.',
      equipment: 'Standard pack, poker chips, one six-sided die (D6).',
      dealing: 'The dealer rolls the D6 to establish the hand rules. Players are dealt 4, 5, or 6 hole cards face down. Five community cards are dealt in the flop (3), turn (1), and river (1) pattern.',
