  data: {
    hero: {
      title: 'BINGLAO',
      subtitle: 'The Die-Roll Omaha Variant',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Binglao Poker',
            subtitle: 'The Die-Roll Omaha Variant',
            content: [
              {
                type: 'paragraph',
                text: 'Binglao is a high-action Pot Limit Omaha (PLO) variant where the deal parameters are randomized before each hand. By rolling a six-sided die, the dealer determines the number of hole cards each player receives (4, 5, or 6) and whether the game will be played as High-only or High-Low 8-or-Better. Popularized in the Nordic poker community and featured in the Norwegian Poker Championship, it requires players to master multiple Omaha formats and adapt their ranges instantly.',
              },
              {
                type: 'paragraph',
                text: 'Developed within the Nordic tournament poker circuit as a way to increase variety and skill testing in mixed-game festivals. It gained official recognition when it was added to the side-event schedule of the Norwegian Poker Championship week in Dublin.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically 2 to 6 players; the 6-max format is standard to accommodate the potential for 6 hole cards per player.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, poker chips, one six-sided die (D6).',
              },
              {
                type: 'paragraph',
                text: 'The dealer rolls the D6 to establish the hand rules. Players are dealt 4, 5, or 6 hole cards face down. Five community cards are dealt in the flop (3), turn (1), and river (1) pattern.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'High-Only Binglao: The High-Low option is removed from the die roll outcomes.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Binglao is a high-action Pot Limit Omaha (PLO) variant where the deal parameters are randomized before each hand. By rolling a six-sided die, the dealer determines the number of hole cards each player receives (4, 5, or 6) and whether the game will be played as High-only or High-Low 8-or-Better. Popularized in the Nordic poker community and featured in the Norwegian Poker Championship, it requires players to master multiple Omaha formats and adapt their ranges instantly.',
    tags: [
      'card-game',
      'poker',
      'poker-variant',
      'betting',
      'traditional',
      'strategy',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'binglao-poker',
    LLM: 'Game: Binglao. PLO variant. D6 determines hole card count (4/5/6) and High or Hi-Lo 8-or-better per deal. Standard Omaha: must use exactly 2 hole + 3 board. Pot Limit betting. 6-max table. Norwegian championship format.',
    Player: "The die shows 5 — this hand is 5-Card Omaha Hi-Lo! You're dealt: A♠ 2♥ K♦ J♣ 7♠. The flop is 3♦ 5♠ Q♥. You have a strong low draw (A-2) and need a low card on turn/river to qualify. Your high is weak. Pot Limit — control the sizing.",
    tagline: 'Roll the die. Get your cards. Adapt or die.',
    gameCategory: 'Poker',
    subcategory: 'Shared Card / Omaha Variant',
    playerMode: 'multiplayer',
    difficulty: 'Expert',
    duration: 'Variable',
