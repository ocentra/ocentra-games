    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Jacks or Better (5 Card Draw)',
            subtitle: 'The Qualified Opening Draw',
            content: [
              {
                type: 'paragraph',
                text: 'Jacks or Better: Five Card Draw. You may only open betting with at least a pair of Jacks. Prevents blind opening.',
              },
              {
                type: 'paragraph',
                text: 'Five Card Draw is one of the oldest forms of poker. Jacks or Better (also called Jack Pots) emerged in the late 1800s with a minimum hand to open: a pair of jacks or better. R.F. Foster (1897) criticized the rule as injurious to poker; John Scarne (1949) argued it was essential for game stability. The variant became the most popular version of Five Card Draw.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six players; standard Five Card Draw allows this range. For Jacks or Better, at least four players are recommended so that hands are not frequently thrown in when no one can open.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Chips.',
              },
              {
                type: 'paragraph',
                text: '5 each; open only with pair of Jacks or better.',
              },
            ],
          },
        ],
      },
    ],
