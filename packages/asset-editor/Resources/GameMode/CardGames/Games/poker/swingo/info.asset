    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Swingo Poker',
            subtitle: 'Poker',
            content: [
              {
                type: 'paragraph',
                text: 'Poker variant in which players bet on the best five-card hand, using their own five cards (three exposed), one shared face-up river card, and one exposed card from any other player.',
              },
              {
                type: 'paragraph',
                text: 'Invented by Steve Albini in December 2007 and developed by the Alliance-X poker group in Chicago. Named after a classic Chicago punk song by Naked Raygun.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to eight players; best with five to eight.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack without jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck and poker chips. Stakes (blinds and pot limit) agreed before play.',
              },
              {
                type: 'paragraph',
                text: "Before the deal, the player to dealer's left posts the small blind and the next player posts the big blind (twice the small blind). Dealer shuffles and cuts, then deals five cards face down to each player.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Sweet Chariot: Lowball variant: played like Swingo but the lowest hand wins the pot at showdown.',
                  },
                  {
                    text: 'High-Low with declaration: Played with limit betting and a chips-in-fist declaration of high, low, or both before showdown; pot split per declarations.',
                  },
                ],
              },
            ],
          },
        ],
      },
