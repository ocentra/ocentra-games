    historyContent: {
      origins: 'Swingo Poker was invented by Steve Albini in December 2007 and developed by the Alliance-X poker group in Chicago; it is named after a song by Naked Raygun. Sweet Chariot is a lowball variation of Swingo: same structure but the lowest hand wins at showdown.',
      originCountries: [
        'United States',
      ],
      timeline: [
        '2007: Swingo invented by Steve Albini.',
        'Thereafter: Sweet Chariot played as lowball variant of Swingo.',
      ],
      evolution: "Sweet Chariot inverts Swingo's showdown: lowest hand wins instead of highest, using the same shared-card and borrow-one-opponent-board-card structure.",
      cultural: 'Developed in Chicago poker circles; reflects home-game variant culture of shared-card poker.',
    },
