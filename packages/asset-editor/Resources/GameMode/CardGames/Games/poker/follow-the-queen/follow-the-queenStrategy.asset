    tips: [
      {
        title: 'Tip',
        description: 'Always keep track of which Queens have already been dealt. If 3 Queens are on the table, the wild card is unlikely to change again.',
      },
      {
        title: 'Tip',
        description: "Five-of-a-Kind: Remember that with wild cards, a 'Five-of-a-Kind' is the highest possible hand, beating even a Royal Flush.",
