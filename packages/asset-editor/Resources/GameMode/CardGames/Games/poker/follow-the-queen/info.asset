    historyContent: {
      origins: "A popular home game variant from the mid-20th century, Follow the Queen was designed to inject high volatility into the otherwise methodical game of Seven Card Stud. It is a staple of 'Dealer's Choice' poker nights across North America.",
      originCountries: [
        'USA',
      ],
      timeline: [
        '1950s: Emerges in domestic poker circles as a way to inflate pots and increase action.',
        "1970s: Becomes a standard 'Wild Card' variant in informal casinos and home games.",
        "Present: Frequently played in recreational poker leagues as a 'fun' alternative to serious tournament formats.",
      ],
      evolution: 'As Poker strategy became more refined, Follow the Queen remained popular because its shifting wild cards actively disrupt modern mathematical modeling, making it a game of pure intuition and adaptation.',
      cultural: "Symbolizes the 'wild' side of American social poker, where the focus is on large pots and surprising reversals.",
    },
    setupContent: {
      players: '2 to 7 players.',
      deck: 'Standard 52-card deck.',
      equipment: 'Standard 52-card deck.',
      dealing: 'Standard Seven Card Stud deal: 2 down, 4 up, 1 down.',
    },
    variationsContent: {
      list: [],
      noVariationsReason: 'This entry encodes the standard Follow the Queen form; Pagat documents optional house-rule variants (queens in hole wild, no-queen misdeal, extra card when last is queen, Buderick version) which are not listed as separate buildable variations.',
    },
    aiContent: {
      difficulty: {
        easy: "Doesn't notice when the wild card changes; still bets heavily on a hand that used to be a full house but is now just a pair.",
        medium: 'Recalculates hand strength immediately after a Queen appears; understands the increased value of Five-of-a-Kind.',
        hard: "Anticipates the volatility; plays conservatively when the 'Follower' hasn't been determined yet; perfectly calculates equity based on the remaining deck and the current wild status.",
      },
      considerations: [
        "AI must handle a dynamic 'Wild Rank' variable that can be updated mid-round.",
      ],
    },
