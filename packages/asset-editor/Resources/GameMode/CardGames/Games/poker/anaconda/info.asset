    historyContent: {
      origins: "A staple of 'Dealer's Choice' home poker games in the United States. It likely emerged in the mid-20th century as players sought to add more interaction to standard Seven-Card Stud.",
      originCountries: [
        'USA',
      ],
      timeline: [
        '1950s: Becomes popular in American home-game circuits.',
        "1980s: Standardized in various 'Home Poker' guides.",
        'Present: A favorite in social poker clubs for its high pot-building potential.',
      ],
      evolution: "The game evolved from simple 'Pass the Trash' (one pass) into 'Anaconda' (three passes) to maximize the betting rounds and the 'trash' accumulation.",
      cultural: "Often the 'wildest' game in a poker night, known for generating massive pots due to the repeated betting and the slow-burn reveal of the rollout.",
    },
    setupContent: {
      players: "Best with 6-8 players to ensure many cards are 'trashed'.",
      deck: 'Standard 52 cards. Ace is high.',
      equipment: 'Poker chips, standard deck.',
      dealing: 'Each player receives 7 cards face down. Initial ante or forced bets are placed.',
    },
