    historyContent: {
      origins: "Indian Poker is named after the idea that cards held to the players' heads resemble a Native American headdress or war bonnet; it has nothing to do with India. It is also known as Blind Man's Buff. The basic one-card version is described as presumably the original: players ante, receive one card each face down, hold it to the forehead without looking so others can see it, then a round of poker betting follows; at showdown the highest card wins (or in the bull variant, the highest and lowest cards share the pot).",
      originCountries: [
        'USA',
      ],
      timeline: [
        '20th–21st century: One-card variant with card on forehead and bull (high-low) variant played in informal settings.',
      ],
      evolution: '',
      cultural: '',
    },
    setupContent: {
      players: 'Two or more players.',
