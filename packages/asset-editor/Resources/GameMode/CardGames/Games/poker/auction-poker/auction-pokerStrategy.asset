      {
        title: 'Tip',
        description: "The '4-unit' blind draw from the deck is a gamble; only take it if the face-up market cards are useless and you are desperate for a draw.",
      },
      {
        title: 'Tip',
        description: "Pay attention to 'The Replacement'. If the dealer flips a high Spade after you buy a card, and the next player is chasing a flush, you've just improved their odds.",
      },
