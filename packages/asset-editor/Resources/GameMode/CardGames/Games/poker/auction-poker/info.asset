  data: {
    hero: {
      title: 'AUCTION POKER',
      subtitle: 'The Market Always Wins',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Auction Poker',
            subtitle: 'The Market Always Wins',
            content: [
              {
                type: 'paragraph',
                text: "Auction Poker is a dynamic Stud variant where the primary mechanic is 'buying' improved position or cards from a communal marketplace. Unlike standard poker where you are dealt what you get, Auction Poker allows players to actively purchase cards from a face-up display or the top of the deck, paying a premium to the pot to refine their hand before betting rounds.",
              },
              {
                type: 'paragraph',
                text: "Emerging from the 'Dealer's Choice' tradition in American home games, Auction Poker (and its sibling 'Buy Your Card') was designed to increase pot sizes and reduce the impact of purely random distribution.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players (to ensure enough cards in the deck for buying rounds).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, poker chips.',
              },
              {
                type: 'paragraph',
                text: 'Initial: 2 cards face down, 3 cards face up to each player. Market: 3 cards dealt face up in a row in the center.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Auction Flop: Players bid against each other for the right to take cards from a community flop.',
                  },
                  {
                    text: 'Market Wilds: If a Joker appears in the market, its price is doubled, but it acts as a wild card.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Auction Poker is a dynamic Stud variant where the primary mechanic is 'buying' improved position or cards from a communal marketplace. Unlike standard poker where you are dealt what you get, Auction Poker allows players to actively purchase cards from a face-up display or the top of the deck, paying a premium to the pot to refine their hand before betting rounds.",
    tags: [
