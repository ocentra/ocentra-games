      'betting',
      'social',
      'auction',
      'stud',
      'gambling',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'auction-poker',
    LLM: 'Game: Auction Poker (Buy Your Card). Type: Stud / Market variant. Rules: Pay 1-4 units to swap cards from a 3-card market. 3 rounds of buying/betting. Showdown: Best 5-card hand wins.',
    Player: 'Welcome to Auction Poker! You have two 10s showing. The Market has another 10 for just 3 units. Do you buy it now to lock in your Three-of-a-Kind, or do you save your chips for the betting round?',
    tagline: "Don't just play the hand you're dealt. Buy the hand you want.",
    gameCategory: 'Poker',
    subcategory: 'Stud / Exchange',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-40 minutes',
    origin: 'USA',
    originName: 'Auction',
    deck: 'Standard 52-card deck',
