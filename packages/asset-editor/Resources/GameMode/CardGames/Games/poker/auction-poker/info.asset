    },
    historyContent: {
      origins: "Emerging from the 'Dealer's Choice' tradition in American home games, Auction Poker (and its sibling 'Buy Your Card') was designed to increase pot sizes and reduce the impact of purely random distribution.",
      originCountries: [
        'United States',
      ],
      timeline: [
        "Mid-20th Century: Variations of 'Buying' poker appear in military and fraternal card clubs.",
        "1980s: Cataloged by card game historians as a distinct sub-genre of 'Exchange' poker.",
        "Present: A popular specialty game in high-stakes home games where 'The Market' is used to induce action.",
      ],
      evolution: "Evolution from static Stud to 'Market-based' Stud increased the skill ceiling by requiring players to value card improvements against the cost in chips.",
      cultural: "Often played as a 'High-Low' game to maximize participation and split pots.",
    },
    setupContent: {
      players: '2-6 players (to ensure enough cards in the deck for buying rounds).',
      deck: 'Standard 52-card deck.',
      equipment: 'Standard pack, poker chips.',
      dealing: 'Initial: 2 cards face down, 3 cards face up to each player. Market: 3 cards dealt face up in a row in the center.',
    },
