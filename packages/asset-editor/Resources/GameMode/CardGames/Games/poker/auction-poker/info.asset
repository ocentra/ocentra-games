    aiContent: {
      difficulty: {
        easy: 'Always buys the cheapest card (1 unit) regardless of rank. Never folds during betting rounds.',
        medium: 'Understands hand potential (straights/flushes). Buys cards that have a high probability of completing a draw.',
        hard: "Expert at 'Pot Odds vs. Market Cost'. Calculates the exact EV of buying a card vs. staying with the current hand. Bluff-buys cards to deceive opponents about its hand strength.",
      },
      considerations: [
        "AI must factor the 'Market Cost' as a non-refundable investment in its EV calculations.",
        "Opponent modeling is critical to detect 'Bluff-Buying'.",
      ],
    },
