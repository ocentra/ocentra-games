          {
            title: 'Spit in the Ocean Poker',
            subtitle: 'Poker',
            content: [
              {
                type: 'paragraph',
                text: 'Draw poker with one shared community card dealt face up. That card and all cards of the same rank are wild. Players get four private cards plus the community card to make a five-card hand, with a draw round and two betting rounds.',
              },
              {
                type: 'paragraph',
                text: 'Described in the 1926 US Playing-Card Company Official Rules as a variant of Wild Widow; one of the first shared-card poker games.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Standard deck',
              },
              {
                type: 'paragraph',
                text: 'Four cards face down to each player, then one card face up to the table. The table card and all cards of the same rank are wild.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
