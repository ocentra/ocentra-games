    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Napalm',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Napalm (Whipsaw/3-5-7) is a multi-stage poker variant emphasizing bluffing. 4-7 players. 52-card deck. Three stages: Stage 1 (2 cards, best high), Stage 2 (+3 community, best LOW 5-card), Stage 3 (+2 more, best HIGH 5-card). Each stage: declare 'yes/no' if you think you have best hand. Single yes=token. Multiple yes=side bets. First to collect 5 tokens wins the pot.",
              },
              {
                type: 'paragraph',
                text: 'This unusual poker variant was contributed by Michael Sanderson. Exact origin is unclear but it likely originated in the Northeastern USA; it was certainly played at Brandeis University (Massachusetts) and now has a following in the Maryland-Virginia area and Annapolis, where it is standard fare at several poker games. The name Napalm is of unknown origin.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '52 cards. Aces high. Tokens (non-monetary) + chips for side bets.',
              },
              {
                type: 'paragraph',
                text: 'Cards, tokens, chips',
              },
              {
                type: 'paragraph',
                text: 'Staged dealing: 2+3+2 cards.',
              },
            ],
          },
        ],
      },
