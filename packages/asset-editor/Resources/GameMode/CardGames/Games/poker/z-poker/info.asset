        tabLabel: 'About',
        pages: [
          {
            title: 'Z Poker',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Z Poker is a little-known community card poker variant with 4 community cards instead of 5. Players get 2 hole cards and use a modified community card structure. Home game variant — unlikely found in casinos.',
              },
              {
                type: 'paragraph',
                text: "Poker variants were largely created in the United States from the mid-1800s through the early 1900s. Z Poker belongs to the community card poker family, in which each player's hidden hand is combined with shared face-up cards; it is typically played in home games, often as part of dealer's choice, and uses four community cards instead of the usual five.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: "One standard 52-card French deck; no jokers. Same deck as Texas hold'em and other community card games.",
              },
              {
                type: 'paragraph',
                text: 'Cards, chips',
              },
              {
                type: 'paragraph',
                text: '2 hole cards each + 4 community.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'None documented: No common variations documented for Z Poker.',
                  },
                ],
              },
            ],
          },
        ],
      },
