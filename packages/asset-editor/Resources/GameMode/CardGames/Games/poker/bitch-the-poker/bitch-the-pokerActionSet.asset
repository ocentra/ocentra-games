    customActions: [
      {
        supported: true,
        description: 'Dealer deals two hole cards face-down and one card face-up to each player (third street).',
        cost: '0',
        constraints: 'Dealer only; at start of hand after ante phase.',
        isTerminating: false,
        effectType: 'play',
        id: 'deal_3rd_street',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Dealer deals one card face-up to each active player for the current street (4th, 5th, 6th, or 7th).',
        cost: '0',
        constraints: 'Dealer only; after each betting round until seven cards per player.',
        isTerminating: false,
        effectType: 'play',
        id: 'deal_card_faceup',
        effectHints: {},
      },
      {
        supported: true,
        description: 'After dealing a face-up card, check if it is the Queen of Spades; if so, kill the hand, reshuffle, and redeal to non-folded players only.',
        cost: '0',
        constraints: 'Dealer or system; after each face-up card is dealt.',
        isTerminating: false,
        effectType: 'play',
        id: 'check_kill_queen',
        effectHints: {},
      },
      {
        supported: true,
        description: "Determine the best 5-card poker hand from each active player's seven cards using standard hand rankings.",
        cost: '0',
        constraints: 'System only; at showdown.',
        isTerminating: false,
        effectType: 'play',
        id: 'evaluate_hands',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Determine whether any active player has the Queen of Spades in the hole (face-down cards).',
        cost: '0',
        constraints: 'System only; at showdown before awarding pot.',
        isTerminating: false,
        effectType: 'play',
        id: 'check_queen_in_hole',
        effectHints: {},
      },
