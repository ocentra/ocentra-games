    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pai Gow Poker',
            subtitle: 'Casino Double-Hand',
            content: [
              {
                type: 'paragraph',
                text: "Pai Gow Poker is a popular casino game that combines elements of the traditional Chinese game Pai Gow with American poker. Players are dealt seven cards and must divide them into a five-card high hand and a two-card low hand. The goal is to beat both of the dealer's corresponding hands, requiring strategic balancing of card strength between the two partitions.",
              },
              {
                type: 'paragraph',
                text: 'Conceptualized in 1985 by Sam Torosian at the Bell Card Club in Los Angeles, California.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically played with six players and a dealer who acts as the banker.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack including one Joker. The Joker is semi-wild, completing straights and flushes or acting as an Ace.',
              },
              {
                type: 'paragraph',
                text: 'Standard poker cards, casino chips, and sometimes dice to determine starting positions.',
              },
              {
                type: 'paragraph',
                text: 'Seven face-down piles of seven cards are dealt; four cards remain unused.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Face-Up Pai Gow: Dealer reveals their hand first; commission is removed, but dealer Ace-high pushes all.',
                  },
                  {
                    text: 'Fortune Side Bet: Optional bet on the quality of the overall seven-card hand ranking.',
                  },
                  {
                    text: 'Progressive Pai Gow: Jackpot side bet awarded for rare high-ranking hands like a seven-card straight flush.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Pai Gow Poker is a popular casino game that combines elements of the traditional Chinese game Pai Gow with American poker. Players are dealt seven cards and must divide them into a five-card high hand and a two-card low hand. The goal is to beat both of the dealer's corresponding hands, requiring strategic balancing of card strength between the two partitions.",
