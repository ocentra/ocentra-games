    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mexican Stud',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mexican Stud (also Mexican Sweat): 7-card stud variant where each player's lowest hole card is wild for that player. Same deal as 7-card stud; wild card can change as new hole cards are dealt. USA; dealer's choice.",
              },
              {
                type: 'paragraph',
                text: "American home and dealer's choice poker; 7-card stud with lowest hole card wild.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'From two to eight players may take part, using a standard 52-card pack. The game is best with five to seven players. When eight play, the deck may run out toward the end of the deal, so five to seven is the recommended range for a full deal and betting structure as in standard seven-card stud.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Chips; table space.',
              },
              {
                type: 'paragraph',
                text: 'Same as 7-card stud: 2 down, 1 up, then 4 more (3 up, 1 down). Lowest hole card is wild for that player.',
              },
            ],
          },
        ],
      },
    ],
