    aiContent: {
      difficulty: {
        easy: "Doesn't understand suit-clashing. Keeps a pair of 2s because '2s are low'. Draws 3 cards too often.",
        medium: 'Draws to a 3-card Badugi properly. Folds 2-card hands after the second draw if no improvement. Never bluffs.',
        hard: "Performs Monte Carlo simulations on every draw. Tracks specific cards seen in previous rounds. Excels at 'Snowing' (standing pat on a 3-card hand to induce folds).",
      },
      considerations: [
        'AI must have a custom low-ball hand evaluator that handles variable hand sizes (1-4).',
        "Draw-logic must account for 'clumping'â€”the tendency for low cards to be removed from the deck early.",
      ],
    },
