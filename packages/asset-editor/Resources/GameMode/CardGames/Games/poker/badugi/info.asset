    historyContent: {
      origins: "The exact origins are debated, with strong claims from both South Korea (where the name 'Badugi' refers to a black-and-white spotted dog) and Canada (where it was played as 'Off Suit Lowball' in the 1980s).",
      originCountries: [
        'South Korea',
        'Canada',
      ],
      timeline: [
        '1980s: Variations appear in Canadian pool halls and South Korean social clubs.',
        '2000s: Introduced to online poker platforms, gaining a cult following.',
        '2008: Added to the World Series of Poker (WSOP) as part of mixed games.',
        "Present: A staple in high-stakes '8-Game' and 'H.O.R.S.E.' mixes.",
      ],
      evolution: "Badugi evolved from 5-card triple draw by stripping away the fifth card to make achieving a 'four-suit' hand statistically challenging and rewarding.",
      cultural: 'In Korea, the game is a popular television and online gambling pastime.',
    },
