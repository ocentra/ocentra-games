    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Badugi',
            subtitle: 'The Spotted Dog',
            content: [
              {
                type: 'paragraph',
                text: "Badugi is a unique and fascinating poker variant characterized by its triple-draw mechanic and four-card hand structure. Unlike traditional poker, where flushes and straights are valued, Badugi is a 'lowball' game that penalizes matching suits and ranks. The ultimate goal is to hold a 'Badugi'â€”four cards of distinct suits and distinct ranks, with the lowest possible values. It's a game of deception, probability, and ruthless discarded-card tracking.",
              },
              {
                type: 'paragraph',
                text: "The exact origins are debated, with strong claims from both South Korea (where the name 'Badugi' refers to a black-and-white spotted dog) and Canada (where it was played as 'Off Suit Lowball' in the 1980s).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-8 players. Typically played with a dealer button and small/big blinds.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards. Aces are always LOW.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, poker chips, dealer button.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 4 cards face down.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Half-Pot Badugi: The pot is split between the best Badugi and the best traditional High hand (very rare).',
                  },
                  {
                    text: 'Badeucy: A split-pot game between Badugi (4 cards) and 2-7 Lowball (5 cards).',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
