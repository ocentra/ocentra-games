        tabLabel: 'About',
        pages: [
          {
            title: 'Hosa Aba',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Hosa Aba (meaning 'Trousers Down') is the Swiss-German variant of the popular European banking game 'Schwimmen' or '31'. It is a fast-paced game of card swapping where players aim to collect cards of a single suit totaling 31 points (Hosa Aba). It is traditionally played with Swiss-German suited cards in the German-speaking cantons of Switzerland.",
              },
              {
                type: 'paragraph',
                text: "Part of the extensive family of 'Thirty-One' games that have existed in Europe since the 15th century. Hosa Aba specifically refers to the localized Swiss version with its unique terminology.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 8 players is ideal.',
              },
              {
                type: 'paragraph',
                text: '36-card Swiss-German deck (6-10, Under, Ober, King, Ace).',
              },
              {
                type: 'paragraph',
                text: '36-card Swiss-German deck (6-10, Under, Ober, King, Ace).',
              },
              {
                type: 'paragraph',
                text: "Deal 3 cards to each player and 3 cards face-down in the center ('The Window').",
              },
            ],
          },
        ],
      },
