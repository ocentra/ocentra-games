    historyContent: {
      origins: "Part of the extensive family of 'Thirty-One' games that have existed in Europe since the 15th century. Hosa Aba specifically refers to the localized Swiss version with its unique terminology.",
      originCountries: [
        'Switzerland',
      ],
      timeline: [
        "15th Century: 'Thirty-One' games recorded in French and Italian literature.",
        '19th Century: Becomes a staple parlor game in Switzerland and Southern Germany.',
        "Present: Popular in Swiss pubs and family gatherings under various names like 'Schwimmen' or 'Knack'.",
      ],
      evolution: "The game adapted to the 36-card Swiss deck, adding specific values for 'Banner' (10s) and ensuring Ace (11) remains the most powerful card.",
      cultural: "Known for the humorous phrase 'Hosa Aba!' shouted when a player achieves 31, forcing others to 'drop their trousers' (equivalent to losing a life).",
