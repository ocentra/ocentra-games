  data: {
    LLM: 'Game: Tri Palki. Logic: See rules.objective and rules.gameplay.',
    Player: "Tri Palki (Ð¢Ñ€Ð¸ Ð¿Ð°Ð»ÐºÐ¸, 'Three Sticks') is a Russian card game where players try to avoid busting past 31 points. Each player holds 4 cards and plays one card per turn, adding to a running total. If your card pushes the total over 31, you earn a 'palka' (stick). Three sticks and you're out.",
    objective: 'Collect cards of one suit totalling 31 points or a special hand; avoid having the lowest score to avoid receiving sticks; three sticks mean elimination; last player left wins.',
    gameplay: "1. Play a card to the center. 2. Add its value to running total. 3. Draw a replacement card. 4. If total > 31, earn a 'palka' (stick). Total resets. 5. Three sticks = out.",
    keyRules: [
      'Running total must not exceed 31',
      '10 is MINUS 10 (reduces total)',
      '9 is 0 (safe play)',
      '3 palki = elimination',
    ],
