  data: {
    LLM: "Game: Fifty-One Japanese (Gojūichi). 2-5 players, 52-card deck. Deal: 5 cards per player, 5 in Market. Turn: Swap 1 with Market OR swap all 5 with Market OR call 'Stop' (gives others one final turn). Scoring: Highest single-suit total (max 51). Exact 51 = instant win. Win: Highest score when game stops.",
    Player: "Welcome to Fifty-One Japanese (Gojūichi). Build a hand of 5 cards in the same suit, scoring up to 51 points. Exchange cards with the central Market: swap 1 card or your entire hand. When your hand is strong (45+), call 'Stop' to trigger final rounds for other players. Exact 51 = instant win!",
    objective: 'Assemble a 5-card hand of the same suit that totals exactly or as close to 51 as possible.',
    gameplay: "Each turn (clockwise), a player MUST perform one of the following exchanges with the table:\n1. 1-for-1: Swap one card from your hand for one card from the table.\n2. 5-for-5: Swap your entire hand for all five cards on the table.\n3. Stop: If you have a high score (usually 40+), you may say 'Stop'. This triggers the final round.",
    keyRules: [
      'Matching Suit constraint: Your score is only the total of cards within the SAME suit. If you have cards of different suits, you only count the suit that gives you the highest total.',
      "Empty Market: If a 5-for-5 swap occurs, the next player may choose to 'Refresh the Market' by clearing the discarded hand and dealing five fresh cards from the deck.",
      'Winning condition: Assemble a 5-card hand of the same suit that totals exactly or as close to 51 as possible.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2 to 5 players. Best with 3 or 4.',
      deck: 'Standard 52-card deck.',
      equipment: 'Standard 52-card deck.',
      dealing: "Assign five cards to each player and place five cards face-up in the center of the table (the 'Market'). The remaining cards form the draw pile (used only when the table is cleared).",
    },
    turnFlow: "Each turn (clockwise), a player MUST perform one of the following exchanges with the table:\n1. 1-for-1: Swap one card from your hand for one card from the table.\n2. 5-for-5: Swap your entire hand for all five cards on the table.\n3. Stop: If you have a high score (usually 40+), you may say 'Stop'. This triggers the final round.",
