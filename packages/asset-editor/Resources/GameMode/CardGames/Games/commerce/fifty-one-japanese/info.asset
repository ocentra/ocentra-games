    hero: {
      title: 'FIFTY-ONE JAPANESE',
      subtitle: 'The Quick Collection Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Fifty-one Japanese (Gojūichi)',
            subtitle: 'The Quick Collection Game',
            content: [
              {
                type: 'paragraph',
                text: "Fifty-one Japanese (Gojūichi / äº”å ä¸€) is a popular fast-paced children's and social card game in Japan. A variation of the 'Commerce' family of games, it focuses on suit-based point collection. Players interact with a public pool of five cards on the table, swapping their own cards to reach a target score of 51. The game is known for its tension-filled ending, where one player can 'Stop' the game, giving everyone else only one last chance to improve their hand.",
              },
              {
                type: 'paragraph',
                text: "Part of the global '51' family, which includes the Chinese Wǔshíyī Diǎn and various European variants. In Japan, it has transitioned from a gambling game into a staple family and childhood game.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 5 players. Best with 3 or 4.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: "Assign five cards to each player and place five cards face-up in the center of the table (the 'Market'). The remaining cards form the draw pile (used only when the table is cleared).",
              },
            ],
          },
        ],
      },
    ],
    description: "Fifty-one Japanese (Gojūichi / äº”å ä¸€) is a popular fast-paced children's and social card game in Japan. A variation of the 'Commerce' family of games, it focuses on suit-based point collection. Players interact with a public pool of five cards on the table, swapping their own cards to reach a target score of 51. The game is known for its tension-filled ending, where one player can 'Stop' the game, giving everyone else only one last chance to improve their hand.",
    tags: [
      'card-game',
      'social',
      'fast-paced',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 5,
    routePath: 'fifty-one-japanese',
    LLM: "Game: Fifty-One Japanese (Gojūichi). 2-5 players, 52-card deck. Deal: 5 cards per player, 5 in Market. Turn: Swap 1 with Market OR swap all 5 with Market OR call 'Stop' (gives others one final turn). Scoring: Highest single-suit total (max 51). Exact 51 = instant win. Win: Highest score when game stops.",
    Player: "Welcome to Fifty-One Japanese (Gojūichi). Build a hand of 5 cards in the same suit, scoring up to 51 points. Exchange cards with the central Market: swap 1 card or your entire hand. When your hand is strong (45+), call 'Stop' to trigger final rounds for other players. Exact 51 = instant win!",
    tagline: "Build one suit to 51. Call 'Stop' at the right moment. Win the round.",
    gameCategory: 'Rummy',
    subcategory: 'Quota / Exchange',
    playerMode: 'multiplayer',
    difficulty: 'Beginner',
    duration: '5-10 minutes',
    origin: 'Japan',
    originName: 'Gojūichi (五十一)',
    deck: 'Standard 52-card deck',
    alsoKnownAs: [
      '51 Japanese',
      'Gojūichi',
      'Fifty-One',
      'Japanese 51',
    ],
    playersDisplay: '2-5',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
      variations: true,
      ai: true,
      sources: true,
    },
    historyContent: {
      origins: "Part of the global '51' family, which includes the Chinese Wǔshíyī Diǎn and various European variants. In Japan, it has transitioned from a gambling game into a staple family and childhood game.",
      originCountries: [
        'Japan',
      ],
      timeline: [
        'Mid-20th Century: Becomes widely known across Japan as a schoolyard and family favorite.',
        '1990s-Present: Frequently included in Japanese digital card game anthologies.',
        "Modern Day: Shared as a 'quick game' (puchingu-gēmu) during social gatherings.",
      ],
      evolution: "The Japanese version streamlined the complex drawing rules of other variants, settling on a mandatory 'Exchange or Swap' mechanic that keeps the table cards rotating rapidly.",
      cultural: 'Commonly used to teach children addition (up to 51) and strategic suit-tracking.',
    },
    setupContent: {
      players: '2 to 5 players. Best with 3 or 4.',
      deck: 'Standard 52-card deck.',
      equipment: 'Standard 52-card deck.',
      dealing: "Assign five cards to each player and place five cards face-up in the center of the table (the 'Market'). The remaining cards form the draw pile (used only when the table is cleared).",
    },
    variationsContent: {
      list: [],
      noVariationsReason: 'Pagat describes only the standard Japanese 51 (Gojūichi); optional house rules such as joker, post-Stop table-clear, and single-suit-only scoring are mentioned but not documented as named regional or rule variants.',
    },
    aiContent: {
      difficulty: {
        easy: "Only performs 1-for-1 swaps; never calls 'Stop' even with a high score.",
        medium: "Actively collects one suit; calls 'Stop' when reaching 45+ points.",
        hard: "Simulates opponent hands based on their table picks; strategically 'hides' high cards of suits others are collecting; waits for the perfect moment to 'All Swap' and then call 'Stop' immediately.",
      },
      considerations: [
        "AI must weigh the 'End Round' advantage of calling 'Stop' against the risk of an opponent reaching 51 in their final turn.",
      ],
    },
