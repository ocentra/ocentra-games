      players: 'Minimum Players: 4\nMaximum Players: 6+ (in teams of 2)\nOptimal Players: 4\nPartnerships: Yes (teams of 2, partners sit opposite)',
      deck: 'Type: Standard 52-card deck (2 decks for 8+ players)\nNumber of Decks: 1 (or 2 for larger groups)\nJokers: No',
      equipment: 'Standard 52-card deck\nTable space for 4 face-up cards',
      dealing: 'Cards per Player: 4\nDealing Pattern: 4 cards to each player\nCenter: 4 cards dealt face-up in the middle',
