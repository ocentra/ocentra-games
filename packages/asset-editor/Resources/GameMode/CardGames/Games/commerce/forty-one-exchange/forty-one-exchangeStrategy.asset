    advanced: "The Ace Bait: If you hold an Ace of a suit you aren't using, hold onto it as long as possible. This 'chokes' the game for whoever is trying to build that suit, potentially forcing them to settle for a lower score.",
    tips: [
      {
        title: 'Tip',
        description: "Aces are the heart of the game. If you don't have an Ace, your maximum score is only 30 (three 10s). You must get an Ace to win.",
      },
      {
        title: 'Tip',
        description: 'If the deck is getting low and no one has hit 41, stop trying for perfection and focus on having the highest total in ANY suit.',
      },
