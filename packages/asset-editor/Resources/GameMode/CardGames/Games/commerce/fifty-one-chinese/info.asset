        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Fifty-one Chinese (Wǔshíyī Diǎn)',
            subtitle: 'The Suit Collection Game',
            content: [
              {
                type: 'paragraph',
                text: "Fifty-one Chinese (Wǔshíyī diǎn / äº”å ä¸€ç‚¹) is a strategic collection game primarily played in the northern Fujian province of China. The game is centered around point-optimization within a single suit, where players attempt to assemble a hand of five cards of the same suit that totals as close to 51 points as possible. Unlike many Western card games, Fifty-one Chinese features a dynamic 'Table Exchange' mechanic where players can swap multiple cards at once with a public pool of facendup cards.",
              },
              {
                type: 'paragraph',
                text: "Wǔshíyī diǎn is a regional specialty of the Nanping area in Fujian. It shares a common ancestor with the Japanese game '51', but has developed more complex exchange rules and scoring nuances.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically 4 players playing individually. 3 players is also common.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No Jokers (usually).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No Jokers (usually).',
              },
              {
                type: 'paragraph',
                text: 'Players draw cards from a face-down stack one by one. The starting player gets 6 cards; others get 5. The starter begins by discarding their sixth card to the table.',
              },
            ],
          },
        ],
      },
    ],
    description: "Fifty-one Chinese (Wǔshíyī diǎn / äº”å ä¸€ç‚¹) is a strategic collection game primarily played in the northern Fujian province of China. The game is centered around point-optimization within a single suit, where players attempt to assemble a hand of five cards of the same suit that totals as close to 51 points as possible. Unlike many Western card games, Fifty-one Chinese features a dynamic 'Table Exchange' mechanic where players can swap multiple cards at once with a public pool of facendup cards.",
    tags: [
      'card-game',
      'social',
    ],
    comingSoon: false,
    minPlayers: 3,
    maxPlayers: 4,
    routePath: 'fifty-one-chinese',
    LLM: 'Game: Fifty-One Chinese (Wǔshíyī diǎn). 3-4 players, 52-card deck. Deal: Starter 6 cards, others 5. Table holds 5 face-up cards. Turn: Draw 1 discard 1, OR swap 1 card with table, OR swap all 5 with table, OR call (all one suit). Scoring: Highest single-suit total (max 51). Exact 51 = instant win.',
    Player: 'Welcome to Fifty-One Chinese. Build a hand of 5 cards in the same suit, scoring points as close to 51 as possible. Exchange cards with the public table strategically. Draw and discard, swap single cards, or even exchange your whole hand. Perfect 51 = instant win!',
    tagline: 'Build one suit to 51 points. Exchange strategically. Win the round.',
    gameCategory: 'Rummy',
    subcategory: 'Quota / Exchange',
    playerMode: 'multiplayer',
    difficulty: 'Beginner',
    duration: '15 minutes',
    origin: 'China (Fujian Province)',
    originName: 'Wǔshíyī diǎn (五十一 点)',
    deck: 'Standard 52-card deck',
    alsoKnownAs: [
      '51 Chinese',
      'Wǔshíyī diǎn',
      'Fifty-One Point',
