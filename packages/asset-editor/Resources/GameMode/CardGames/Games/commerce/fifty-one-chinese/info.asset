    historyContent: {
      origins: "Wǔshíyī diǎn is a regional specialty of the Nanping area in Fujian. It shares a common ancestor with the Japanese game '51', but has developed more complex exchange rules and scoring nuances.",
      originCountries: [
        'China',
      ],
      timeline: [
        "Early 20th Century: Variations of '51' emerge across East Asia.",
        '1950s-1980s: Wǔshíyī diǎn becomes a prominent social pastime in Nanping.',
        "Modern Era: Continues to be played by locals as a quick, social 'pub' style card game.",
      ],
      evolution: "The game's scoring (Aces as 11, Faces as 10) mirrors ancient European 'Points' games, suggesting a long history of cross-cultural adaptation from maritime trade routes reaching Fujian.",
      cultural: 'Used as a common ice-breaker in Fujian social gatherings; emphasizes rapid decisionndmaking and public resource management.',
    },
    setupContent: {
      players: 'Typically 4 players playing individually. 3 players is also common.',
      deck: 'Standard 52-card deck. No Jokers (usually).',
      equipment: 'Standard 52-card deck. No Jokers (usually).',
      dealing: 'Players draw cards from a face-down stack one by one. The starting player gets 6 cards; others get 5. The starter begins by discarding their sixth card to the table.',
    },
    variationsContent: {
      list: [],
      noVariationsReason: "Sources describe only the standard Chinese 51 (Fujian) form; optional house rules (jokers, minimum call, bomb) appear under 'Variations' but no separate regional or named game variants are documented.",
    },
    aiContent: {
      difficulty: {
        easy: "Swaps cards randomly; doesn't recognize that 5 cards of the same suit are required for a high score.",
        medium: "Focuses on one suit; uses the 'Exchange One' action effectively to upgrade cards.",
        hard: "Calculates the target suit of every opponent; purposefully withholds cards to prevent others from hitting 51; uses 'Exchange All' to completely flip its strategy midndround.",
      },
      considerations: [
        "AI must evaluate 'Suit Density' in the hand vs. visibility of available cards on the public table.",
      ],
    },
