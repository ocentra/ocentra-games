  data: {
    LLM: 'Game: Fifty-One Chinese (Wǔshíyī diǎn). 3-4 players, 52-card deck. Deal: Starter 6 cards, others 5. Table holds 5 face-up cards. Turn: Draw 1 discard 1, OR swap 1 card with table, OR swap all 5 with table, OR call (all one suit). Scoring: Highest single-suit total (max 51). Exact 51 = instant win.',
    Player: 'Welcome to Fifty-One Chinese. Build a hand of 5 cards in the same suit, scoring points as close to 51 as possible. Exchange cards with the public table strategically. Draw and discard, swap single cards, or even exchange your whole hand. Perfect 51 = instant win!',
    objective: 'Collect 5 cards of the same suit with the highest possible total value. A perfect hand (Ace, King, Queen, Jack, Ten) equals 51 points.',
    gameplay: "Turns proceed anticlockwise. On your turn, you must choose one of these actions:\n1. Draw & Discard: Draw 1 card from the stock and discard 1 to the table.\n2. Exchange One: Swap 1 card from your hand with 1 facendup card on the table.\n3. Exchange All: Swap your entire 5ndcard hand for the 5 cards on the table.\n4. Call: If your hand is all one suit, you may 'call' and end the round immediatey.",
    keyRules: [
      'Suit Matching: Only cards of the SAME suit in your hand contribute to your score. Mixedndsuit hands score only the value of the highest single suit within them.',
      'Automatic Call: If you reach exactly 51 points, you win the round instantly.',
      'Table Clear: If all 5 cards on the table are cleared, the next player must draw from the stock.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Typically 4 players playing individually. 3 players is also common.',
      deck: 'Standard 52-card deck. No Jokers (usually).',
      equipment: 'Standard 52-card deck. No Jokers (usually).',
      dealing: 'Players draw cards from a face-down stack one by one. The starting player gets 6 cards; others get 5. The starter begins by discarding their sixth card to the table.',
