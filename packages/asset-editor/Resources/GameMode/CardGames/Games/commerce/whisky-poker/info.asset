                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'La Viuda: Mexican variant: 52 cards plus two jokers (wild); counter-clockwise play; wild card determined by number of chips in pool; optional extra chip La Viuda to re-enter after losing all chips.',
                  },
                ],
              },
            ],
          },
        ],
