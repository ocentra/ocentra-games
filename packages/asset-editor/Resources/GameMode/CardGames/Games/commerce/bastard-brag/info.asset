  data: {
    hero: {
      title: 'BASTARD BRAG',
      subtitle: 'Stop The Bus',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bastard Brag',
            subtitle: 'Stop The Bus',
            content: [
              {
                type: 'paragraph',
                text: "Bastard Brag is a lively variant of Three-Card Brag that mixes the hand rankings of Brag with the card-swapping mechanics of Commerce. Instead of a purely static hand, players are dealt three cards and share access to a 'Widow' hand on the table. Players take turns swapping cards with the Widow to improve their hand until someone 'Knocks' (stops the bus) or the pot reaches a certain limit. It is a game of speed, memory, and nerve.",
              },
              {
                type: 'paragraph',
                text: "Evolved in British pubs as a faster, more interactive alternative to standard Brag. The inclusion of the 'Swap' mechanic aligns it with the 'Commerce' family of games (like 31 or Scat), but the use of Brag rankings gives it a distinct flavor.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-10 players. Best with 4-7.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Chips or tokens (3 Lives each for the Lives version).',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 3 cards face down. Three cards are dealt face up (or face down in some variants) to the center of the table (The Widow).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Stop the Bus: Identical mechanics but uses '31' scoring (suit sums) instead of Brag hands.",
                  },
                  {
                    text: 'Bastard Brag (Betting): Standard Brag betting intervals occur after every round of swaps instead of an elimination knock.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bastard Brag is a lively variant of Three-Card Brag that mixes the hand rankings of Brag with the card-swapping mechanics of Commerce. Instead of a purely static hand, players are dealt three cards and share access to a 'Widow' hand on the table. Players take turns swapping cards with the Widow to improve their hand until someone 'Knocks' (stops the bus) or the pot reaches a certain limit. It is a game of speed, memory, and nerve.",
    tags: [
