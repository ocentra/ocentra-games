    comingSoon: false,
    minPlayers: 3,
    maxPlayers: 10,
    routePath: 'bastard-brag',
    LLM: 'Game: Bastard Brag. Type: Commerce/Brag. Rules: Swap with Widow (3 cards). Rank: Prial > Run Flush > Run > Flush > Pair. Knock triggers last round. Worst hand loses a life.',
    Player: 'The Widow has a 7 of Hearts, a 2 of Clubs, and a Jack of Spades. You hold a Pair of 7s. Swap your 9 for that 7 in the Widow to make a Prial! Then Knock immediately!',
    tagline: "Swap fast. Knock early. Don't be the last one on the bus.",
    gameCategory: 'Vying',
