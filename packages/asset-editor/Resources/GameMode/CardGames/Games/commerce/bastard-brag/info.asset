    historyContent: {
      origins: "Evolved in British pubs as a faster, more interactive alternative to standard Brag. The inclusion of the 'Swap' mechanic aligns it with the 'Commerce' family of games (like 31 or Scat), but the use of Brag rankings gives it a distinct flavor.",
      originCountries: [
        'United Kingdom',
      ],
      timeline: [
        'Mid-20th Century: Appears in UK pub game compilations.',
        "1990s: Becomes a popular 'warm-up' game for poker nights.",
        "Present: Often played as 'Stop the Bus' in family settings using 31-scoring instead of Brag hands.",
      ],
      evolution: "The game has two distinct branches: the 'Lives' version (where the worst hand loses a life) and the 'Betting' version (closer to poker). The 'Lives' version is often synonymous with 'Stop the Bus'.",
      cultural: "A classic 'start-stop' game where the tension builds simply by waiting for someone to knock.",
    },
    setupContent: {
      players: '3-10 players. Best with 4-7.',
      deck: 'Standard 52-card deck.',
      equipment: 'Chips or tokens (3 Lives each for the Lives version).',
      dealing: 'Each player receives 3 cards face down. Three cards are dealt face up (or face down in some variants) to the center of the table (The Widow).',
    },
    variationsContent: {
