      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Swaps randomly to match suit. Knocks only with a Flush or better.',
        medium: 'Tracks the 3 cards in the Widow perfectly. Swaps to build Pairs/Runs. Knocks when hand > average winning threshold.',
        hard: 'Tracks opponent pickups. Deduces opponent hands based on what they discard to the Widow. Blocks opponents aggressively.',
      },
      considerations: [
        'Widow state is public perfection information.',
        'Opponent hand inference is key (what did they take vs what did they leave).',
      ],
    },
