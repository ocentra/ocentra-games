        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: '51 (card game)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: '51 is a point-collection card game played in China and Japan. Players collect cards of the same suit; A-K-Q-J-10 of one suit scores 51 points. Chinese version: draw, discard, exchange; first to 500+ wins. Japanese version: pick board cards, discard; call "Stop!" with best hand; highest single-suit total wins.',
              },
              {
                type: 'paragraph',
                text: 'Point-collection game; Chinese and Japanese variants. A-K-Q-J-10 in one suit = 51 points. Chinese: first to 500+; Japanese: call Stop with best hand.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-4 (standard). Optimal: 3-4. Chinese: 4 usual, 3 sometimes; Japanese: best 4.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Numeral cards 2-10 face value; Jack, Queen, King 10 each; Ace 11.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Numeral cards 2-10 face value; Jack, Queen, King 10 each; Ace 11.',
              },
              {
                type: 'paragraph',
                text: 'Chinese: cards dealt one at a time anticlockwise; starter gets 6 cards, others 5. Japanese: dealer gives each player 5 cards, then 5 cards face up on table; rest form stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Chinese 51 with Jokers: Two jokers as wild cards, value 10; hand without joker beats equal hand with joker. Some play only call if hand scores at least 42.',
                  },
                  {
                    text: 'Bomb (Chinese): Four cards of same rank plus any fifth card counts as bomb; declare for 204 points.',
                  },
                  {
                    text: 'Japanese 51 with Joker: One joker as any card not in hand; worth 11 or 10 depending on ace. Some play that after Stop the table cannot be cleared.',
                  },
                ],
              },
            ],
          },
        ],
      },
