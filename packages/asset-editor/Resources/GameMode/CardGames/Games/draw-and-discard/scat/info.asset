  data: {
    hero: {
      title: 'THIRTY-ONE',
      subtitle: 'The Blitz Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Thirty-One (Scat)',
            subtitle: 'The Blitz Game',
            content: [
              {
                type: 'paragraph',
                text: 'Thirty-One, also known as Scat or Blitz, is a classic accumulation game for two or more players. The goal is to obtain a hand with a point total as close to 31 as possible in a single suit. It is widely played in Northwest Europe and North America and is a staple of pub culture.',
              },
              {
                type: 'paragraph',
                text: "The game's roots go back to the 15th century, with variants like 'Vingt-et-un' and 'Bone-Ace'. The modern form solidified in the 19th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'From 2 to 9 or more people can play. The game is often best with 3 players but works well with a larger group.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, three coins or tokens per player (for lives), score sheet.',
              },
              {
                type: 'paragraph',
                text: "Dealer deals 3 cards to each player, one at a time, and 3 cards face-up to the table (the 'widow'). Remaining cards form the stock.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Blitz: Standard North American name where 31 is called a Blitz.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Thirty-One, also known as Scat or Blitz, is a classic accumulation game for two or more players. The goal is to obtain a hand with a point total as close to 31 as possible in a single suit. It is widely played in Northwest Europe and North America and is a staple of pub culture.',
    tags: [
