    icon: '🃏',
  },
  data: {
    LLM: "Turn: draw from stock or top discard. Use drawn card to (a) replace one face-down layout card without looking, discarding the replaced card, or (b) if it is a Jack or Queen drawn from stock, use its power (Jack: swap any two layout cards; Queen: peek at one card) then discard it. Power cards from discard have no power. To end the round: call 'Dacz' instead of drawing; each opponent gets one more turn, then all score.",
    Player: "Turn: draw from stock or top discard. Use drawn card to (a) replace one face-down layout card without looking, discarding the replaced card, or (b) if it is a Jack or Queen drawn from stock, use its power (Jack: swap any two layout cards; Queen: peek at one card) then discard it. Power cards from discard have no power. To end the round: call 'Dacz' instead of drawing; each opponent gets one more turn, then all score.",
    objective: 'Achieve the lowest total score in your 4-card layout by the end of the round.',
    gameplay: "Turn: draw from stock or top discard. Use drawn card to (a) replace one face-down layout card without looking, discarding the replaced card, or (b) if it is a Jack or Queen drawn from stock, use its power (Jack: swap any two layout cards; Queen: peek at one card) then discard it. Power cards from discard have no power. To end the round: call 'Dacz' instead of drawing; each opponent gets one more turn, then all score.",
    keyRules: [
      'You cannot look at a layout card before replacing it unless a Power (Peek) was used.',
      'Discarded Power Cards cannot have their powers used by the next player (powers only activate when drawn from stock).',
      "Penalty for Caller: If the player who called 'Dacz' does not have the lowest score, they add a +10 penalty (+5 if tied for lowest).",
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Two to six players; the game is often best with two to four. Four-card Golf and its power-card variants (Dacz, Cabo, Cambio, Cactus) can in theory be played by two to around eight or more; with eight or more players, two packs are shuffled together. Commercial and folk accounts typically describe play with 2-6 players.',
      deck: 'Standard 52-card deck.',
      equipment: 'Standard deck, score sheet.',
      dealing: 'Each player is dealt 4 cards face-down in a row. Before play begins, each player may peek at their two outer cards (or two inner, by agreement). The rest of the deck forms the stock; one card is turned up to start the discard pile.',
    },
    turnFlow: "Turn: draw from stock or top discard. Use drawn card to (a) replace one face-down layout card without looking, discarding the replaced card, or (b) if it is a Jack or Queen drawn from stock, use its power (Jack: swap any two layout cards; Queen: peek at one card) then discard it. Power cards from discard have no power. To end the round: call 'Dacz' instead of drawing; each opponent gets one more turn, then all score.",
