        rules: {
          objective: 'Get a hand totaling 31 points in one suit, or have a higher score than the lowest player.',
          gameplay: 'Turn: Draw one card from Stock or Discard pile, then discard one card. Try to improve suit sum. Knocking: If a player thinks they have high enough score, they knock. Everyone else gets one last turn. Scoring: A=11, K/Q/J=10, Num=Face. 3 of a kind (30pts) is a special rule in some variants.',
          keyRules: [
            'Suits matters (points must be same suit)',
            'Ace = 11',
            'Knocking ends the round (after 1 orbit)',
            '31 is instant win',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Pick a suit and stick to it. Trade low cards for high ones. Knock if you have >25 points early.',
          intermediate: "Watch what opponents pick up to guess their suit. If someone picks up a Spade, don't discard high Spades.",
          advanced: 'Defensive knocking: Knock early to catch opponents with mixed suits, even if your score is mediocre (e.g., 20-22).',
          tips: [
            'A-K-Q is the best hand (31).',
            'Three of a kind (30) is often a valid hand.',
            "Don't hold onto two suits for too long.",
          ],
          hasPlaceholders: false,
        },
