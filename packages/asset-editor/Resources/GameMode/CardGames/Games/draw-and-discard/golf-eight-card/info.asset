    hero: {
      title: 'GOLF (EIGHT CARD)',
      subtitle: 'Card game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Golf (Eight Card)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Eight-card Golf: 2+ players, 52 cards. Each has 8 cards in layout (e.g. 2Ã—4). Draw or take discard to replace; aim for lowest point total. Same scoring as 4/6-card Golf; larger layout. Play 9 or 18 holes.',
              },
              {
                type: 'paragraph',
                text: "Golf is widespread in North America and Britain; the eight-card form extends six-card Golf with a larger layout (four columns of two cards per player). It is less widespread than 4- and 6-card Golf. The variant was documented on Bill Whitnack's Card Games site, using a double 52-card deck with jokers for larger groups.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to eight players. A standard 52-card pack is used; with more than four players, a second pack (and optionally jokers) may be used.',
              },
              {
                type: 'paragraph',
                text: '52 cards; 2 decks for more players.',
              },
              {
                type: 'paragraph',
                text: 'Score sheet.',
              },
              {
                type: 'paragraph',
                text: '8 cards each in layout; stock and discard.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Eight Card Golf with Jokers: Double 52-card deck with four jokers; pair in column scores zero; two equal pairs in any two columns minus 10; jokers minus 5. Nine deals. (Bill Whitnack variant.)',
                  },
                ],
              },
            ],
          },
        ],
      },
