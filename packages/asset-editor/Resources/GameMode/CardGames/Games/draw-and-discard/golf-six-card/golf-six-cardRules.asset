  data: {
    LLM: 'Game: Six-Card Golf. Cards: 52. Layout: 2x3 per player. Goal: Lowest score. Cards: K=0, A=1, 2-10=face, J/Q=10. Vertical pair in column = 0 pts. Win: Lowest sum over 9 rounds.',
    Player: 'Welcome to Golf! You have 6 cards in a 2x3 grid. Try to flip your high cards for low ones or Kings (0 pts). Match two of the same rank in a column to make that column worth 0 points! Hand ends when someone is all face-up.',
    objective: "Achieve the lowest total score at the end of nine 'holes' (rounds).",
    gameplay: '1. Players take turns clockwise.\n2. ACTION: Draw the top card from the stock OR the top card from the discard pile.\n3. REPLACEMENT: Use the drawn card to replace any one of your six cards (face-up or face-down). The replaced card is discarded face-up.\n4. DISCARDING: If drawing from the stock, you may choose to discard the card immediately instead of using it to replace, but you must then turn one of your face-down cards face-up.\n5. ENDING: When a player has all cards face-up, everyone else gets one final turn. Then scores are tallied.',
    keyRules: [
      'You cannot look at your face-down cards before choosing which one to replace.',
      'A pair of equal rank in the same column scores 0 points for that column (e.g., two Queens in one column = 0).',
      'Kings are the most valuable cards to hold as they score 0 individually.',
      "The hand ends when one player's cards are all face-up; they 'knock' (figuratively) and other players play once more.",
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2-8 players. 4 is optimal.',
      deck: 'Standard 52-card deck. For more than 4 players, two decks may be shuffled together.',
      equipment: 'Standard deck, score sheet.',
      dealing: 'Dealer deals 6 cards to each player, face-down, in a 2x3 layout. Remaining cards form the stock. Top card of stock is turned face-up to start the discard pile. Players turn any two of their own cards face-up at the start.',
    },
    turnFlow: '1. Players take turns clockwise.\n2. ACTION: Draw the top card from the stock OR the top card from the discard pile.\n3. REPLACEMENT: Use the drawn card to replace any one of your six cards (face-up or face-down). The replaced card is discarded face-up.\n4. DISCARDING: If drawing from the stock, you may choose to discard the card immediately instead of using it to replace, but you must then turn one of your face-down cards face-up.\n5. ENDING: When a player has all cards face-up, everyone else gets one final turn. Then scores are tallied.',
