      award_pot: 'This game has no pot to award.',
      play_card: 'This game does not use play_card in engine.',
      draw: 'Must replace a card in layout or discard (if from stock).',
      discard: 'Only allowed if the card was drawn from the stock and not used to replace a layout card.',
