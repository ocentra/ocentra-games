    hero: {
      title: 'GOLF (FOUR CARD)',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Golf (Four Card)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Four-card Golf: 2+ players, 52 cards. Each has 4 cards in a square, two visible once. Draw or take discard to replace; knock to end hand. Lowest score wins. Also Turtle, Polish Poker Four Card.',
              },
              {
                type: 'paragraph',
                text: 'Golf is widespread in North America, Britain, and other English-speaking countries but seldom appears in card game books. The object is to score as little as possible, as in the sport of golf; end-of-hand scores are often likened to strokes per hole. The game is commonly played over 9 or 18 deals (holes). The four-card form is also known as Turtle and as Polish Poker (Polish Polka).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-8; best with 4.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. With eight or more players, two packs may be shuffled together.',
              },
              {
                type: 'paragraph',
                text: 'Score sheet.',
              },
              {
                type: 'paragraph',
                text: '4 cards each, 2x2; look at 2 once. Stock and discard.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Pairs in row or column score zero: Pair of equal cards in the same row or column scores zero for that pair; diagonally opposite equal cards do not cancel.',
                  },
                  {
                    text: 'Knocker penalty 10 points: If the player who knocks does not have the lowest score, they add a penalty of 10 points to their score for that hand.',
                  },
                ],
              },
            ],
          },
        ],
      },
