    historyContent: {
      origins: 'Stop the Bus is a British draw-and-discard game in the commerce family. It shares mechanisms with Commerce (18th century) and Thirty-One (Scat), in which players draw and discard to improve a three-card hand. The version documented here was contributed by Nic Cleveland from Guernsey; the name is also used for a Thirty-One variant (Ride the Bus) and for Bastard Brag, which uses table exchange instead of stock and discard.',
      originCountries: [
        'United Kingdom',
      ],
      timeline: [
        '2000s: Popular as a quick pub game.',
        '2010s: Online apps bring it to a wider audience.',
      ],
      evolution: "The 'Bus' theme is purely thematic (last bus home? losing your ride?).",
      cultural: "A game of nerve: calling 'Stop' forces everyone to reveal.",
    },
    setupContent: {
      players: 'From two to around nine or more can play; the game is best with three to five. With more players, those eliminated early have nothing to do until the game ends.',
