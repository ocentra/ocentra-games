  data: {
    hero: {
      title: 'Stop the Bus',
      subtitle: 'Vying',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Stop the Bus',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Stop the Bus is a fast-paced commerce game played with 3 cards, similar to Commerce and 31. Players start with 3 lives (tokens) and aim to *not* have the worst hand when someone calls 'Stop the Bus'. The game is elimination-based, with the last surviving player winning.",
              },
              {
                type: 'paragraph',
                text: 'Stop the Bus is a British draw-and-discard game in the commerce family. It shares mechanisms with Commerce (18th century) and Thirty-One (Scat), in which players draw and discard to improve a three-card hand. The version documented here was contributed by Nic Cleveland from Guernsey; the name is also used for a Thirty-One variant (Ride the Bus) and for Bastard Brag, which uses table exchange instead of stock and discard.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'From two to around nine or more can play; the game is best with three to five. With more players, those eliminated early have nothing to do until the game ends.',
              },
              {
                type: 'paragraph',
                text: 'A standard Anglo-American 52-card pack; cards in each suit rank high to low A-K-Q-J-10-9-8-7-6-5-4-3-2.',
              },
              {
                type: 'paragraph',
                text: 'Three tokens (e.g. pennies or matches) per player; optionally a small model bus to signal end of play.',
              },
              {
                type: 'paragraph',
                text: 'Dealer shuffles and deals three cards to each player one at a time face down. The next card is placed face up to start the discard pile; the remainder is placed face down as the stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Bastard Stop the Bus: Variant where players exchange cards with a 3-card hand on the table rather than drawing and discarding from stock/discard. Same Brag hand ranking and elimination by lives.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
