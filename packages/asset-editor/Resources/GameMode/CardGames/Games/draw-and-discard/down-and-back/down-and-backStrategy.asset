      {
        title: 'Tip',
        description: "Don't ignore the 3ndcard hand. A simple Prial (3-of-a-kind) in the 3ndcard slot is almost unbeatable.",
      },
      {
        title: 'Tip',
        description: 'Watch what opponents pick from the discard pile. If they pick a 7, do not discard a 6 or 8.',
