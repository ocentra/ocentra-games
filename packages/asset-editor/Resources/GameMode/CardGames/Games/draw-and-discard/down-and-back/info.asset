    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Down and Back',
            subtitle: 'Patience rules and play flow',
            content: [
              {
                type: 'paragraph',
                text: "Down and Back is a rare and intriguing rummy-style card game discovered in Lancashire, England. The game centers on splitndhand management: players must divide their seven cards into a four-card 'Going Down' hand and a three-card 'Coming Back' hand. With only six turns to optimize their holdings, the game is a fast-paced exercise in probability and tactical discarding.",
              },
              {
                type: 'paragraph',
                text: 'The game was documented by researcher Steve Bradbury who observed it in several Lancashire pubs and social clubs during the 1980s. Its formal name is unknown, so it is named after its two-part showdown mechanic.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 5 players. Best with 4.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52ndcard deck. Aces are always LOW (1).',
              },
              {
                type: 'paragraph',
                text: '52ndcard deck, poker chips or coins for the pot.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 7 cards face-down. One card is turned up to start the discard pile. Remaining cards form the stock.',
              },
            ],
          },
        ],
      },
    ],
