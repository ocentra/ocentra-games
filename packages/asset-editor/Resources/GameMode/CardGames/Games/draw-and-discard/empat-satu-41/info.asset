    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Empat Satu (41)',
            subtitle: 'Draw and Discard',
            content: [
              {
                type: 'paragraph',
                text: "Empat Satu (which means 'Forty-One' in Indonesian) is a fast-paced draw-and-discard card game popular throughout Southeast Asia. The game is a test of optimization where players manage a small 4-card hand, attempting to collect four cards of the same suit. The legendary '41' is achieved by holding an Ace and three 10-value cards of the same suit. Because hands are small and the deck is large, the game moves rapidly, often ending in just a few turns when a player 'knocks' or declares a stop.",
              },
              {
                type: 'paragraph',
                text: 'Originating in Indonesia as a social card game, Empat Satu is widely played in coffee shops and community gatherings. Its simplicity makes it accessible across all age groups.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players. Each plays for themselves.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: 'The dealer gives 4 cards to each player, one at a time. The rest of the deck forms the face-down Stock. The top card of the Stock is turned over to start the Discard Pile.',
              },
            ],
          },
        ],
      },
