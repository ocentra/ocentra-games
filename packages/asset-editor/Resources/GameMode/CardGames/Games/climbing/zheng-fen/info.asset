    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Zhēng Fēn',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Zhēng Fēn ('Competing for Points') is a Chinese climbing/point-trick hybrid. 54-card deck (52 + 2 jokers). Shed cards through ascending combinations. Point cards: 5=5pts, 10/K=10pts. 100 total per hand. First out gets LAST player's tricks + remaining cards. Last out scores 0. Play to 500/1000.",
              },
              {
                type: 'paragraph',
                text: "Zhēng Fēn (挣分, 'competing for points') is a traditional Chinese card game, a hybrid of climbing and point-trick (king-ten-five group). Documented in the West in 1985 by Axel Schmale in Pöppel-Revue after he learned it in China during a railway journey; it shares mechanics with Zheng Shangyou and Big Two and point values with Da Bai Fen (Hundred).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Three to six players.',
              },
              {
                type: 'paragraph',
                text: '54 cards (52 + two distinguishable jokers, big and small).',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: 'Anticlockwise. First deal: a randomly chosen player shuffles, right-hand neighbour cuts. Players take one card at a time from the face-down pack, anticlockwise, until all cards are distributed; some may have one more card than others.',
              },
            ],
          },
        ],
      },
