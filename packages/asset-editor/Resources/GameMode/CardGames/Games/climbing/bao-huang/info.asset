    },
    aiContent: {
      difficulty: {
        easy: "Reveals Eunuch identity immediately. Plays high cards on low tricks. Doesn't track played Jokers.",
        medium: 'Logic-based deducer. Analyzes passing patterns to identify the Eunuch by the mid-game. Holds 2s for critical leads.',
        hard: "Perfect card counter (tracks 168 cards). Uses Bayesian inference to assign a 'Eunuch Probability' to every player. Expert at 'Tribute Management' (throwing a game to get better cards next round).",
      },
      considerations: [
        'Must track identical-card frequencies (up to 4 of each rank/suit combination).',
        "Hidden-role engine needs to handle 'Loyalty Bluffing' states.",
      ],
    },
