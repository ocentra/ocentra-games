    historyContent: {
      origins: "Bao Huang emerged from the coastal cities of Shandong (specifically Qingdao and Weifang) in the mid-20th century. It traces its ancestry to simpler climbing games like 'Zheng Fen' but introduced the imperial theme and the unusually large deck to accommodate longer, more strategic social sessions.",
      originCountries: [
        'China',
      ],
      timeline: [
        '1960s: Developed in Shandong as a recreational game among workers.',
        '1990s: Standardized for regional tournaments with dedicated 168-card packs.',
        '2005: Online platforms (like QQ Games) bring Bao Huang to a national audience in China.',
        "Present: One of the 'Big Three' Chinese climbing games alongside Zheng Fen and Sheng Ji.",
      ],
      evolution: "The game's deck size has fluctuated between 168 and 216 cards across different cities, with 168 becoming the professional standard.",
      cultural: "Symbolizes the complex loyalty structures of the old Chinese courts. Playing Bao Huang is often considered a 'diplomatic' skill in northern Chinese business circles.",
    },
    setupContent: {
      players: '5 players. Team A: Emperor & Eunuch. Team B: Three Commoners.',
      deck: "168 cards. Take four standard 52-card decks, remove all 3s, 4s, and 5s. Use 4 Red Jokers and 4 Black Jokers. One specific Red Joker is marked 'Emperor' and one specific Black Joker is marked 'Eunuch'.",
      equipment: 'Special 168-card deck, score pad.',
      dealing: 'Players draw cards one by one from a shuffled wall. Everyone receives 33 or 34 cards.',
