    historyContent: {
      origins: "Originated in Huai'an, Jiangsu Province, China. The name Guan Dan (??) is commonly rendered as 'Throwing Eggs' or 'Smashing Eggs'.",
      originCountries: [
        'China',
      ],
      timeline: [
        'Late 20th Century: Game develops in Huaian, Jiangsu Province.',
        '2000s: Gains popularity across Jiangsu and neighboring provinces.',
        "2010s: Spreads nationwide, becomes one of China's most popular card games.",
        'Present: Played extensively in China, with online platforms and tournaments.',
      ],
      evolution: 'Guan Dan evolved from traditional Chinese climbing games like Dou Dizhu and Tuo La Ji, adding the leveling system and partnership mechanics.',
      cultural: 'Extremely popular in China, particularly in Jiangsu Province. The game is played in homes, teahouses, and online platforms. It represents modern Chinese card gaming culture.',
