    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Goita',
            subtitle: 'Noto Partnership Shedding',
            content: [
              {
                type: 'paragraph',
                text: 'Goita is a four-player Japanese partnership shedding game from Noto in which players answer an attack tile with a matching tile (or king wildcard) and then issue a new attack.',
              },
              {
                type: 'paragraph',
                text: 'Goita is a four-player partnership game from Ushitsu, Noto, Ishikawa prefecture, Japan, where fishermen are said to have played it at least since the early 20th century. Its immediate ancestor is the game Uke-Shogi, popular in Japan in the late 19th and early 20th century.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly 4 players in fixed opposite partnerships (2v2).',
              },
              {
                type: 'paragraph',
                text: '32 tiles/cards: 2 kings, 2 rooks, 2 bishops, 4 golds, 4 silvers, 4 knights, 4 lances, 10 pawns.',
              },
              {
                type: 'paragraph',
                text: 'Score sheet or chips for cumulative team score.',
              },
              {
                type: 'paragraph',
                text: 'All 32 tiles are distributed so each player has 8. Play and deal proceed counterclockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Pawn Check Procedure: Tables differ on exact handling of five-to-eight pawn opening reveals, including redeal versus immediate scoring options.',
                  },
                  {
                    text: 'Initial Dealer Method: First dealer and partnerships may be determined by drawing designated high tiles or by agreed random method.',
                  },
                ],
              },
            ],
          },
        ],
