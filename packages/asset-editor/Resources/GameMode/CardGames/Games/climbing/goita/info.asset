    historyContent: {
      origins: 'Goita is a four-player partnership game from Ushitsu, Noto, Ishikawa prefecture, Japan, where fishermen are said to have played it at least since the early 20th century. Its immediate ancestor is the game Uke-Shogi, popular in Japan in the late 19th and early 20th century.',
      originCountries: [
        'Japan',
      ],
      timeline: [
        'Late 19th to early 20th century: Uke-Shogi and related matching games recorded in Japan.',
        'Early 20th century: Goita played by fishermen in Ushitsu, Noto.',
        'Modern era: Published editions with cards/tiles spread play beyond Ishikawa.',
      ],
      evolution: 'Play shifted from local wooden tiles to commercially printed card versions while preserving partnership and scoring structure.',
      cultural: 'Goita is treated as a regional heritage game in Ishikawa and is often taught as a local traditional pastime.',
    },
