        rules: {
          objective: 'Empty your hand first so your team scores the value of your final attack tile and reaches game target before opponents.',
          gameplay: 'Dealer leads by placing one covered tile and one face-up attack tile. On each subsequent turn, a player may pass or respond by playing a matching tile (or a king except against lance/pawn), then immediately plays a new attack tile. If three consecutive players pass, the last successful attacker leads again with a covered tile and any new attack. Players always act by either playing two tiles or passing. The deal ends when a player plays their final pair.',
          keyRules: [
            'Kings can substitute only against non-lance and non-pawn attacks.',
            'Passing is always allowed, even when a legal response exists.',
            'A king cannot be used as an attack unless the other king is already face up or both kings are in your hand.',
            'Special pre-play pawn holdings (five or more) can trigger immediate win/redeal outcomes.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Preserve kings for difficult defenses and key tempo swings after pass chains.',
          intermediate: 'Use passes to keep partnership tempo and avoid feeding opponents favorable attack values.',
          advanced: 'Track exposed piece counts and concealed lead cards to infer hidden hand structure and endgame outs.',
          tips: [
            'Because action is pass or two-tile play, parity of hand size and expected response windows matters.',
            'Coordinate implicitly with partner through attack choice; you cannot communicate explicitly.',
          ],
          hasPlaceholders: false,
        },
