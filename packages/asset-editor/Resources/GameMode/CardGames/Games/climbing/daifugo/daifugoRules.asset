  data: {
    LLM: 'The player holding 3♦ (or 3♠ in some variants) leads first. On each turn, a player may:\n- Play a combination STRICTLY HIGHER than the previous combination of the SAME TYPE (single, pair, triple, sequence of 3+).\n- Or pass.\nThe played combination must match the current type (if singles are out, you must play singles). The round continues until all but one player passes; then the last player to play leads a new combination.',
    Player: 'The player holding 3♦ (or 3♠ in some variants) leads first. On each turn, a player may:\n- Play a combination STRICTLY HIGHER than the previous combination of the SAME TYPE (single, pair, triple, sequence of 3+).\n- Or pass.\nThe played combination must match the current type (if singles are out, you must play singles). The round continues until all but one player passes; then the last player to play leads a new combination.',
    objective: 'Be first to shed all cards (Daifugō = 1st place). Avoid being last (Daihinmin = last place).',
    gameplay: 'The player holding 3♦ (or 3♠ in some variants) leads first. On each turn, a player may:\n- Play a combination STRICTLY HIGHER than the previous combination of the SAME TYPE (single, pair, triple, sequence of 3+).\n- Or pass.\nThe played combination must match the current type (if singles are out, you must play singles). The round continues until all but one player passes; then the last player to play leads a new combination.',
    keyRules: [
      'You MUST match the current play type (singles vs. pairs vs. sequences).',
      'Revolution (four-of-a-kind) inverts rank order for rest of round.',
      'Daifugō-Daihinmin card exchange is the defining social mechanic.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Three to six players are typical; the game is usually played by 3 to 6, and up to 8 can take part (often with a single 53-card pack in Japan). With five or more players the full title hierarchy applies (Dai Fugō, Fugō, heimin, Hinmin, Dai Hinmin); with three or four only Fugō (winner) and Hinmin (loser) are used.',
      deck: 'Standard 52 cards + optional Jokers.',
      equipment: 'Cards.',
      dealing: 'Deal entire deck evenly. Players with extra cards start at a slight disadvantage.',
    },
    turnFlow: 'The player holding 3♦ (or 3♠ in some variants) leads first. On each turn, a player may:\n- Play a combination STRICTLY HIGHER than the previous combination of the SAME TYPE (single, pair, triple, sequence of 3+).\n- Or pass.\nThe played combination must match the current type (if singles are out, you must play singles). The round continues until all but one player passes; then the last player to play leads a new combination.',
    moveValidityConditions: {
      ante: 'Daifugo has no ante payment; players begin by receiving dealt cards.',
      deal: 'Dealing is handled as setup flow, not as a player-triggered action.',
      reveal_market: 'Daifugo has no market row or reveal-market mechanic.',
      buy_market: 'Cards are not bought from a market in Daifugo.',
      buy_stock: 'Players never buy cards from a stock pile in this game.',
      fold: 'Daifugo is a shedding game with pass-or-play turns, not folding.',
      check: 'Checking is a betting action and does not exist in Daifugo.',
      call: "Calling bets is not part of Daifugo's rules.",
      bet: 'Daifugo has no betting rounds or wager amounts.',
      raise: 'Raising is a betting mechanic and is not used here.',
      declare: 'Daifugo has no declaration phase such as high-low declarations.',
      reveal_hand: 'There is no full-hand showdown reveal step in this game.',
      award_pot: 'Daifugo has no central betting pot to award.',
      play_card: 'Daifugo primarily plays combinations; combo resolution is modeled as custom actions.',
      draw: 'No player draw action exists after initial deal in Daifugo.',
      discard: 'Cards leave hand by legal play, not by separate discard actions.',
      pass: 'You may pass when you cannot or choose not to beat the current combination; passing does not prevent you from playing on the next turn.',
      bid: 'There is no contract bidding process in Daifugo.',
      meld: 'Daifugo does not include rummy-style meld declarations.',
      go_out: 'End-state is determined by empty hand order, not a go-out action call.',
