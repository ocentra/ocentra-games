  data: {
    hero: {
      title: 'Sap Ng Wu',
      subtitle: 'Climbing',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Sap Ng Wu',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Sap Ng Wu (十五湖) is a climbing game for three or four players using an 84-card Chinese domino pack. Players in turn beat the previous play with a higher card or combination or pass; the player who played the highest takes the cards as wu (winning cards). The first to collect 15 or more wu declares a win (sik wu) and receives chip payments from the others.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: China\nTime Period: Early 1900s\nHistorical Development: The game evolved from traditional card games in the region\nCultural Significance: Popular social and family game',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 3\nMaximum Players: 4\nOptimal Players: 3\nPartnerships: None',
              },
              {
                type: 'paragraph',
                text: 'Type: 84-card Chinese domino pack (十五湖紙牌); 21 tile types with four copies of each\nJokers: Not included',
              },
              {
                type: 'paragraph',
                text: '84-card Chinese domino pack (15 lakes playing-cards)\nChips for payment (optional)\nTable space',
              },
              {
                type: 'paragraph',
                text: 'Pack shuffled and spread face down; players take one card at a time anticlockwise from dealer until all taken. Three players: 28 cards each; four players: 21 each.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Wu Han games: Related climbing games from Hubei (Wu Han): military divided by red/black spots; player obliged to beat if able; bonus scores for particular cards among winning cards.',
                  },
                  {
                    text: 'Si Chuan Luan Chuo (乱戳): Played in Si Chuan with 川牌; different ranking (e.g. middle three equal, lower four equal); 16+ wu to win; points and multipliers (番). Sometimes four players with one sitting out; talon of 3 cards.',
                  },
                  {
                    text: 'Mā Huā Huā (抹花花): Northwest China (Shaanxi, Ningxia, Gansu); 48-card pack; three or four players (one sits out); special groups (happy cards, bull cards, pendulum, fish); 6+ pillars for one family, 11+ for two families.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
