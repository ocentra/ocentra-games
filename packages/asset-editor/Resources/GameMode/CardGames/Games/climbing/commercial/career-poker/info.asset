            content: [
              {
                type: 'paragraph',
                text: 'Career Poker is a commercial hierarchical shedding and climbing game, originally published in Germany as Karriere Poker, where players race to shed cards and improve their social rank from dishwasher to company boss.',
              },
              {
                type: 'paragraph',
                text: 'Career Poker was published by Hexagames in 1988 under the German title Karriere Poker and uses a large custom deck with wild cards.',
              },
            ],
          },
