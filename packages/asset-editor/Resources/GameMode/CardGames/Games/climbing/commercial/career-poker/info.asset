          deckDescription: 'One standard 52-card deck consisting of four suits (spades, hearts, diamonds, clubs), each with thirteen ranks. No jokers; used for Big Two (Chinese climbing game) where the two is the highest rank and suit order breaks ties.',
          suitDescription: 'Four French suits with a fixed hierarchy for tie-breaking: spades highest, then hearts, then clubs, then diamonds. When two players play the same rank, the higher suit wins. All four suits are used in the deck.',
          rankDescription: 'Thirteen ranks per suit in Big Two order: two (highest), ace, king, queen, jack, ten, nine, eight, seven, six, five, four, three (lowest). Singles, pairs, triples, and other combinations are compared by highest card then suit.',
          dealPattern: 'Cards are dealt individually clockwise until hands are full.',
          bettingLimits: 'None',
          actions: {},
          handRankingSystem: 'Standard poker hierarchy for 5-card combos; 2 high for singles/pairs.',
          rankingSystem: 'Chinese Big Two (2-A-K...3)',
          useTrump: false,
          notApplicableReasons: {
            drawConfig: 'The full hand is dealt initially; no draw pile exists during the climbing phase.',
            discardConfig: 'Cards are played to the table center or held; no separate discard pile is utilized.',
            specialCards: 'Certain ranks (Twos) are high-ranking but do not trigger secondary automated engine effects.',
            declarationMechanism: 'The game state is determined by public combination play without a hidden declaration phase.',
            fishingConfig: 'Big Two is a climbing game and does not use a capture-from-tableau fishing mechanic.',
          },
