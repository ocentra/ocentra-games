        rules: {
          objective: 'Empty your hand before the other players and gain the highest table rank for the next round.',
          gameplay: 'Deal thirteen cards to each player. The leader plays a single card or a matching set, optionally completed with wild cards. Later players may pass or play the same number of cards at a higher rank. When everyone passes, the last successful raiser clears the table and leads the next combination. Play continues until players empty their hands and receive ranks.',
          keyRules: [
            'Players must match the size of the previous combination when raising.',
            'Wild cards can complete sets and are highest when played alone.',
            'End-of-round order assigns table status, creating advantages and disadvantages in the next deal.',
          ],
          hasPlaceholders: false,
        },
