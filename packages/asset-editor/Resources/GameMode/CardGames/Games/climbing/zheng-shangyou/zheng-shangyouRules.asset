  data: {
    LLM: 'Game: Zhēng Shàngyóu. Logic: See rules.objective and rules.gameplay.',
    Player: "Zhēng Shàngyóu ('Struggling Upstream' / 'Climb to the Top') is a Chinese shedding/climbing game similar to President. 54-card deck (52 + 2 jokers). Play ascending combinations (singles/pairs/triples/sequences/bombs). First out wins. Ranking: 3-A-2-BlackJoker-RedJoker. Bombs beat any combination.",
    objective: 'Be the first to play out all your cards to gain 2 points (or second to gain 1 point) toward a game total of usually 11; the last player left with cards loses the hand and is penalised in the next deal.',
    gameplay: 'Lead any combination. Others must play same type, higher rank, or pass. Combinations: single, pair, triple, sequence (3+), full house. Bombs (4+ same rank) beat anything. Pass = out until new trick. Last out loses.',
    keyRules: [
      'Climbing mechanic',
      'Bombs beat any combination',
      '2s rank above Aces',
      'Jokers highest',
      'Sequences exclude 2s/jokers',
    ],
