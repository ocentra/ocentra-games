        rules: {
          objective: 'Be the first player to discard all cards in your hand.',
          gameplay: "1. The player with the 3 of Diamonds starts (must play it in the first combination).\n2. Players must play a higher card or combination than the previous player.\n3. Types of plays: Single, Pair, Three-of-a-kind, Five-card combinations (Straight, Flush, Full House, Four-of-a-kind + 1, Straight Flush).\n4. **Stripping (Ba Pi)**: If you play a combination that no one can beat, you 'strip' the lead and start the next round with any combination.",
          keyRules: [
            'Player with 3♦ must play it in the first combination.',
            'Plays must match the number of cards led and rank higher (2 high, 3 low; Spades > Hearts > Clubs > Diamonds for ties).',
            'Five-card combinations: Straight, Flush, Full House, Four-of-a-kind+1, Straight Flush.',
            'When all others pass, the last player to play leads the next round with any combination.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Keep high 2s and Aces to regain the lead. Don't waste your only high card on a low-value single.",
          intermediate: 'Shape your hand into five-card combinations early. A single 13-card hand is often won by 2 five-card plays and 3 singles.',
          advanced: "The 'Monkey' tactic: Bait opponents into playing their 2 of Spades early so you can dominate the endgame with your Aces.",
          tips: [
            'Always track which 2s have been played.',
            'If you have many small singles, try to build a Full House to get rid of 5 cards at once.',
          ],
          hasPlaceholders: false,
        },
