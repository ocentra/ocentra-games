        pages: [
          {
            title: 'Hou Zi Ba Pi',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Hou Zi Ba Pi (猴子扒皮 - literally 'Monkey Stripping the Skin') is an aggressive Chinese shedding game, often considered a variant of Big Two (Choi Dai Di). It is known for its fast-paced nature and the use of the term 'Monkey' as slang for specific high cards or the act of stripping an opponent's hand of its high cards.",
              },
              {
                type: 'paragraph',
                text: "Derived from the Cantonese game 'Choi Dai Di' (Big Two). The 'Hou Zi' name surfaced in regional gambling circles, potentially referring to the speed of the game or the 'monkeying around' with high-value face cards.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players (standard).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: 2 (High), A, K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3 (Low). Suits: Spades > Hearts > Clubs > Diamonds.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: 2 (High), A, K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3 (Low). Suits: Spades > Hearts > Clubs > Diamonds.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 13 cards.',
              },
            ],
          },
