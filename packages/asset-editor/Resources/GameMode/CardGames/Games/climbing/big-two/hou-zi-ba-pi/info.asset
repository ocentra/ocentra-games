    historyContent: {
      origins: "Derived from the Cantonese game 'Choi Dai Di' (Big Two). The 'Hou Zi' name surfaced in regional gambling circles, potentially referring to the speed of the game or the 'monkeying around' with high-value face cards.",
      originCountries: [
        'China',
        'Hong Kong',
      ],
      timeline: [
        '20th Century: Big Two variations spread across China.',
        "1990s: 'Hou Zi' slang becomes prominent in specific poker clubs.",
        'Present: Played digitally and in social circles under various regional names.',
      ],
      evolution: "The game prioritizes 'power plays' where huge five-card combinations are used to quickly deplete one's hand, leaving opponents 'naked' or 'skinned' (Ba Pi).",
      cultural: 'Reflects the competitive and humorous nature of Chinese social card play.',
    },
