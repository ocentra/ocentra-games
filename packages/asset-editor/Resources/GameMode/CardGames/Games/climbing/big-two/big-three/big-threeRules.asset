  data: {
    LLM: 'Game: Big Three (Da San). Type: Auction Climbing. Rules: 3 players. 16 cards each + 4 widow. Rank: 3>2>A>K...4. Restriction: 3, 2, A cannot be in sequences.',
    Player: "You have three 3s and two 2s. The bid is currently at '2 points'. With your hand and the four extra cards in the widow, can you beat two opponents combined? Bid '3 points' and take the lead!",
    objective: 'Be the first to shed all cards from your hand. If the declarer wins, they win points from both opponents; if the opponents win, the declarer pays both.',
    gameplay: '1. **Auction**: Players bid 1, 2, or 3 points to take the contract. Highest bidder is Declarer. 2. **Widow**: Declarer takes the 4 cards from the widow into their hand. 3. **Climbing**: Players must play a combination of the same type but higher rank than the previous. 4. **Ranks**: 3 (High) > 2 > A > K > Q ... > 4 (Low). 5. **Combinations**: Singles, Pairs, Triples, and Sequences.',
    keyRules: [
      '3s, 2s, and Aces cannot be part of a sequence (e.g., Q-K-A is illegal).',
      "A Triple of 3s is an invincible 'Bomb' in some variations.",
      'Players can pass on any turn, even if they can beat the current combo.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Exactly 3 players.',
      deck: 'Standard 52-card deck (No Jokers).',
      equipment: 'Standard pack, score sheet.',
      dealing: 'The deck is dealt as follows: 16 cards to each player and 4 cards face down in the center (The Widow).',
    },
    turnFlow: '1. **Auction**: Players bid 1, 2, or 3 points to take the contract. Highest bidder is Declarer. 2. **Widow**: Declarer takes the 4 cards from the widow into their hand. 3. **Climbing**: Players must play a combination of the same type but higher rank than the previous. 4. **Ranks**: 3 (High) > 2 > A > K > Q ... > 4 (Low). 5. **Combinations**: Singles, Pairs, Triples, and Sequences.',
    moveValidityConditions: {
      ante: 'Big Three is a point-based climbing game where stakes are determined by the auction rather than antes.',
      deal: 'The initial distribution of sixteen cards per player and the four-card widow is handled by the system dealer.',
      reveal_market: 'There is no shared community market in Big Three; only the widow exists which is taken by the declarer.',
      buy_market: 'Players cannot purchase cards from a market; the widow is awarded to the highest bidder for free.',
      buy_stock: 'There is no remaining stock to draw from during play; every card is in a hand or the widow at the start.',
      fold: 'Players must remain in the game until someone sheds their entire hand to determine the round score.',
      check: 'The game uses a climbing and passing structure rather than a vying structure with checks and bets.',
      call: 'There is no pot to match in this game; competition is based on card ranking and bidding levels.',
      bet: 'Success is measured by points won or lost from other players based on the auction result.',
      raise: 'The auction allows for bidding escalation, but there are no wagering rounds during the actual play of cards.',
      declare: 'Declarations are handled through the auction and combo play rather than a separate declaration phase.',
      reveal_hand: 'Hands remain private until individual cards are played into climbing combos; no showdown occurs.',
      award_pot: 'Points are transferred between players at the end of the round; there is no physical pot to award.',
      play_card: 'Must match the combination type and exceed the previous rank.',
      draw: 'Players receive their massive hands at the start and no further drawing occurs during the play phase.',
      discard: 'Every card must be shed through valid climbing combinations; there is no separate discard or waste pile.',
      pass: 'May choose to pass even if a legal move is available.',
      bid: 'Must be higher than the previous bid.',
      meld: 'Big Three is a climbing game based on beating combos rather than forming table melds.',
      go_out: 'A player wins the round automatically upon playing their final card from hand.',
    },
