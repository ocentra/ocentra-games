    customActions: [
      {
        supported: true,
        description: 'Draw one card from the stock in turn until all 108 cards are dealt. First three players receive 22 cards each, last two receive 21. Last card drawn is kept face down until Big Ace is decided.',
        cost: '0',
        constraints: 'Players draw in anticlockwise order. During drawing any player may expose an Ace to become declarer.',
        isTerminating: false,
        effectType: 'play',
        id: 'draw_card',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Expose an Ace during the draw to make it the Big Ace and become the declarer; the holder of the matching Ace (same rank and suit from the other deck) is your secret partner.',
        cost: '0',
        constraints: 'Allowed at any time during drawing. If you later obtain the second identical Ace you may expose it to play alone and protect from overcall.',
        isTerminating: false,
        effectType: 'play',
        id: 'expose_ace',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Overcall by exposing a pair of identical Aces to become declarer and play alone against four opponents.',
        cost: '0',
        constraints: 'Allowed after an Ace has been exposed and before play begins.',
        isTerminating: false,
        effectType: 'play',
        id: 'overcall_pair',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a single card or combination (pair, sequence, double sequence, or bomb) that beats the previous play, or pass. Four consecutive passes clear the pile and the last player to play leads again.',
        cost: '0',
        constraints: 'Must beat the current combination with the same type and higher rank, or pass. Bombs beat ordinary combinations.',
        isTerminating: false,
        effectType: 'play',
        id: 'play_combination',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Score based on finish order: Big Ace team scores positive if they go out first and second, negative if last; scores doubled if partner revealed their Ace before play; solo declarer scores differ.',
        cost: '0',
        constraints: 'Applied after all players have emptied hands or the play ends. Zero-sum; declarer and partner share wins/losses when both Aces were exposed.',
        isTerminating: false,
        effectType: 'play',
        id: 'calculate_scores',
        effectHints: {},
