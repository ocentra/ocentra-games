    historyContent: {
      origins: "Big A originated in Inner Mongolia, China. It belongs to the large family of Chinese climbing games (shēng jí / 升级 family) that includes Dou Di Zhu and Tractor. The game's distinctive feature is the secret partnership mechanic based on matching identical Aces across two decks.",
      originCountries: [
        'China',
      ],
      timeline: [
        'Late 20th century: Emerges in Inner Mongolia as a local climbing game.',
        '2000s-2010s: Spreads across China via mobile apps and online platforms.',
        'Present: Popular as a casual multiplayer game, especially in northern China.',
      ],
      evolution: 'Big A combines the climbing/shedding mechanics common to Chinese card games with a hidden-team mechanic reminiscent of games like Bǎo Huáng (保皇). The secret partner system creates a social deduction element layered on top of the climbing gameplay.',
      cultural: 'Part of the rich tradition of Chinese climbing games. The social deduction aspect — figuring out who holds the matching Ace — adds an exciting layer of table talk and inference that makes the game popular in social settings.',
    },
    setupContent: {
      players: 'Exactly 5 players.',
