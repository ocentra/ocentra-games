    hero: {
      title: 'GĀN DÈNG YǍN 干瞪眼',
      subtitle: 'Climbing',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Gān Dèng Yǎn 干瞪眼',
            subtitle: 'Climbing',
            content: [
              {
                type: 'paragraph',
                text: 'Gan Deng Yan is a Chinese climbing and shedding game in which most responses must be exactly one rank higher than the previous combination. Players begin with small hands, draw from a talon after each trick, and try to be first to shed all cards.',
              },
              {
                type: 'paragraph',
                text: 'Gan Deng Yan emerged in southwest China during the early to mid-2010s, with reported roots in Sichuan and documented play in Yunnan variants.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 6 players, with each player competing individually.',
              },
              {
                type: 'paragraph',
                text: '54-card deck (standard 52 cards plus two jokers).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck + 2 jokers',
              },
              {
                type: 'paragraph',
                text: 'Dealer shuffles, then players draw cards in counterclockwise order until dealer has 6 cards and each other player has 5. Remaining cards form a face-down talon.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Double-Deck Group Play: Some groups use two 54-card packs for larger player counts, increasing hand volume and reducing early talon exhaustion.',
                  },
                  {
                    text: 'Triplets as Ordinary Combinations: Some tables treat triplets as ordinary combinations rather than bombs, allowing one-step triplet responses.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
