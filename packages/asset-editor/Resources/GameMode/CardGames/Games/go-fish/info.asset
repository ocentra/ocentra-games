    aiContent: {
      difficulty: {
        easy: 'Asks randomly for any rank held in hand; forgets public information.',
        medium: 'Tracks positive information (who demanded what); prioritizes finishing books of 3.',
        hard: "Perfect memory of all transaction history. Infers 'negative' information (who Fished on what). Calculates probability of cards in Stock vs Hands.",
      },
      considerations: [
        'Memory of asks and responses is the main strategic state for AI.',
        'Decision policy should prioritize ranks near completion while limiting information leakage.',
      ],
    },
