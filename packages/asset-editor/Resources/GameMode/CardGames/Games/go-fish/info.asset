    historyContent: {
      origins: "Derived from 19th-century 'Happy Families' and 'Authors' games, which used special decks. The adaptation to standard playing cards occurred in the United States around the turn of the 20th century.",
      originCountries: [
        'USA',
        'United Kingdom',
      ],
      timeline: [
        "1851: 'Authors' published in the USA, introducing the mechanic of asking for specific cards to complete sets.",
        "1861: 'Happy Families' published in the UK with similar rules.",
        "20th Century: 'Go Fish' becomes the standard name for the game when played with a regular 52-card deck.",
        'Present: Remains a starter game for millions of children worldwide.',
      ],
      evolution: 'Special-pack family games such as Authors and Happy Families were adapted to standard ranks, producing modern Go Fish rules.',
      cultural: 'Used widely as an educational tool for teaching numbers, matching, and memory skills.',
    },
    setupContent: {
      players: '2-6 players, typically best with 3-6.',
