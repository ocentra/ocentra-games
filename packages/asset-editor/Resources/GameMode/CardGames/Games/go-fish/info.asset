    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Go Fish',
            subtitle: 'The Classic Fishing Game',
            content: [
              {
                type: 'paragraph',
                text: 'Go Fish is a classic set-collection game where players ask opponents for ranks they already hold, then draw from stock on failure, aiming to complete the most four-of-a-kind books.',
              },
              {
                type: 'paragraph',
                text: "Derived from 19th-century 'Happy Families' and 'Authors' games, which used special decks. The adaptation to standard playing cards occurred in the United States around the turn of the 20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players, typically best with 3-6.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'No equipment beyond deck; optional score sheet for multi-hand sessions.',
              },
              {
                type: 'paragraph',
                text: "Deal 7 cards each (for 2 players) or 5 cards each (for 3+ players). The rest form the 'Ocean' (Stock) spread out face-down.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Ask Specific Card: Players ask for an exact card (for example seven of diamonds) instead of rank only.',
                  },
                  {
                    text: 'Continue After Stock Empty: After stock is exhausted, asking continues without drawing until all books are formed.',
                  },
                  {
                    text: 'Refill Empty Hand: When a player runs out of cards, they draw up to five cards from stock if available and continue play.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Go Fish is a classic set-collection game where players ask opponents for ranks they already hold, then draw from stock on failure, aiming to complete the most four-of-a-kind books.',
    tags: [
      'card-game',
      'matching',
      'traditional',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'go-fish',
    LLM: "Game: Go Fish. Setup: Deal 7 cards (2 players) or 5 cards (3+ players); remainder is Stock (Ocean). Gameplay: On your turn, ask any player for a specific rank you hold at least one card of. If they have it, they give you ALL matching cards and you take another turn. If not, you say 'Go Fish' and draw one card from Stock. If you draw the rank you asked for, show it and get another turn. Complete 'books' (4 of the same rank) and lay them face-up. Game ends when all books are completed. Most books wins.",
    Player: "Ask for ranks you hold, collect books of four, and track opponents' requests to infer their hands.",
    tagline: 'Ask, collect, complete books. The simplest fun for all ages.',
