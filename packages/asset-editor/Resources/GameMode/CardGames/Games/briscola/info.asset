    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Briscola',
            subtitle: 'Italia Gioca',
            content: [
              {
                type: 'paragraph',
                text: "Briscola is Italy's most beloved card game, a point-trick game played with the distinctive 40-card Italian deck (suits: coins, cups, batons, swords). Each player holds 3 cards and draws after each trick. The trump suit is revealed by the last card dealt, which stays visible until taken. The unusual ranking system (Ace > 3 > King > Queen > Jack > 7-2 in point order) makes Briscola distinct from virtually every other card game in the world.",
              },
              {
                type: 'paragraph',
                text: "Briscola developed in Italy from older European Ace-Ten card games. The word 'briscola' means trump in Italian. The game is one of the founding pillars of Mediterranean card culture.",
              },
            ],
          },
        ],
      },
      {
        type: 'rules',
        tabLabel: 'Rules',
        pages: [
          {
            title: 'Rules',
            subtitle: 'How to play',
            content: [
              {
                type: 'heading',
                level: 3,
                text: 'Objective',
              },
              {
                type: 'paragraph',
                text: 'Score 61 or more of the 120 available card points.',
              },
              {
                type: 'heading',
                level: 3,
                text: 'Gameplay',
              },
              {
                type: 'paragraph',
                text: 'Each trick: non-dealer leads any card. No follow-suit obligation. Opponent plays any card. Trick won by higher Briscola (trump) played, OR higher of led suit if no Briscola. Winner draws first from stock; loser draws second. Winner leads next. Final trick: trump indicator card is last taken from stock.',
              },
              {
                type: 'heading',
                level: 4,
                text: 'Key Rules',
              },
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'NO obligation to follow suitâ€”ever.',
                  },
                  {
                    text: 'Trump (Briscola) beats all off-suit cards regardless of rank.',
                  },
                  {
                    text: 'The trump-indicator card is taken by the winner of the last draw-phase trick.',
                  },
                  {
                    text: 'Pointing cards: only A, 3, K, Q, J have value.',
                  },
                ],
              },
            ],
          },
        ],
      },
      {
        type: 'strategy',
        tabLabel: 'Strategy',
        pages: [
          {
            title: 'Strategy',
            subtitle: 'Tips and guidance',
            content: [
              {
                type: 'paragraph',
                text: 'Lead worthless cards (7-2) to bait opponents into spending Aces or 3s on nothing-tricks.',
              },
              {
                type: 'paragraph',
                text: "Trump Economy: Don't trump low-value tricks. Save your Briscola Ace for the opponent's Ace-led trick.",
              },
              {
                type: 'paragraph',
                text: "End-of-Stock Timing: Once the stock depletes, you know both hands. Calculate exactly who has which trump card. A Briscola 3 in hand is a second-place trumpâ€”use it to steal the opponent's 7 so they can't counter your Briscola Ace.",
              },
            ],
          },
        ],
      },
      {
        type: 'scoring',
        tabLabel: 'Scoring',
        pages: [
          {
