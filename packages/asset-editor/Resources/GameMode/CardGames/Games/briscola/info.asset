    historyContent: {
      origins: "Briscola developed in Italy from older European Ace-Ten card games. The word 'briscola' means trump in Italian. The game is one of the founding pillars of Mediterranean card culture.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        '1600s-1700s: Briscola-type games spread across Italy.',
        '1800s: Standard rules codified across Italian regions.',
        'Present: National game of Italy; also played across the Mediterranean as Briskula, Bisca, and Brisca.',
      ],
      evolution: 'Briscola Chiamata is the most sophisticated common variant, adding called partners and bidding. Related games such as Bisca and Brisca keep the core trump-taking idea but adjust rank details.',
      cultural: 'Briscola is embedded in Italian daily life, played in cafes, homes, courts, and piazzas. The five-player called version is often treated as the prestige variant.',
    },
    setupContent: {
      players: '2 players is standard; 3, 4, or 6 are common variants.',
      deck: '40 cards. Use an Italian deck ranked A, 3, King, Queen, Jack, 7, 6, 5, 4, 2 in four suits, or a French deck stripped of 8s, 9s, and 10s.',
      equipment: 'Cards.',
      dealing: "Deal 3 cards to each player, then turn one card face-up beside the stock. That card's suit is Briscola, the trump suit, and remains visible until the final draw.",
