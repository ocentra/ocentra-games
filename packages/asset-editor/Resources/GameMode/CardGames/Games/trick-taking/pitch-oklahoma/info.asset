    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Oklahoma 10-point Pitch',
            subtitle: 'Partnership Pitch with Jokers',
            content: [
              {
                type: 'paragraph',
                text: 'Oklahoma Ten Point Pitch is a partnership trick-taking variant of Pitch using a 52-card deck plus two jokers. Points come from High, Low, Jack, Off-Jack, High Joker, Low Joker, Game, and optionally the Three of trumps. First team to 21 wins.',
              },
              {
                type: 'paragraph',
                text: 'A Pitch variant from Oklahoma, closely related to Minnesota Smear. Introduces jokers and Off-Jack as additional scoring trumps.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 or 6 players in partnerships.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck plus two distinguishable jokers. Off-Jack = Jack of same color as trump Jack.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, 2 jokers, score sheet.',
              },
              {
                type: 'paragraph',
                text: '4 players: 9 cards each. 6 players: 8 cards each. Remaining cards form widow.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: '7-Point: Omit trey; 7 points to bid.',
                  },
                  {
                    text: 'No Discard Draw: All discard to 6; no replenishment.',
                  },
                ],
              },
            ],
          },
        ],
