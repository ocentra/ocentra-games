        rules: {
          objective: 'Be the first partnership to reach 21 points by capturing scoring cards in tricks.',
          gameplay: '1. Deal 9 (4p) or 8 (6p) cards each. 2. Bid 2-10 (or 2-7 without trey). Dealer cannot steal the bid. 3. Bidder declares trump. 4. Discard and draw to 6 cards. 5. Play: bidder leads. Follow suit or trump. 6. Score: High, Low, Jack, Off-Jack, Jokers, Game (1 each); Trey 3 (optional). First to 21 wins.',
          keyRules: [
            'Trump order: A, K, Q, J, Off-Jack, High Joker, Low Joker, 10-2.',
            'Low = held by team (lowest trump in play).',
            'Bid and make: score points. Set: lose bid, opponents score.',
            'Win only when reaching 21+ on a hand where you made your bid.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Count trumps; bid conservatively. Protect Off-Jack and jokers.',
          intermediate: 'Use discard phase to load trumps. Lead trump to draw high cards.',
          advanced: 'Track scoring cards played. Coordinate with partner.',
          tips: [
            'Widow (6p) gives bidder flexibility.',
            'Low is scored by who holds itâ€”ducking can save Low.',
          ],
          hasPlaceholders: false,
