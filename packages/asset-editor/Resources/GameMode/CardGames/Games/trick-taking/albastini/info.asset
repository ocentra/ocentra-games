    hero: {
      title: 'ALBASTINI',
      subtitle: 'The Queen of Tanzanian Cards',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Albastini',
            subtitle: 'The Queen of Tanzanian Cards',
            content: [
              {
                type: 'paragraph',
                text: 'Albastini is a sophisticated point-trick game from Tanzania, likely derived from the Portuguese game Bisca. It features unique rules such as a total absence of the follow-suit requirement and a bidding phase where players sacrifice cards to set the trump.',
              },
              {
                type: 'paragraph',
                text: "Believed to have been introduced to East Africa by Portuguese sailors or traders, Albastini (corruption of 'Al-Bisca' or similar) evolved into a distinct Tanzanian game with localized terminology like 'Mrithi' and 'Ndoa'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2, 3, or teams of 2 (4 players) or 3 (6 players).',
              },
              {
                type: 'paragraph',
                text: '36-card standard (Remove 2s, 8s, 9s, 10s).',
              },
              {
                type: 'paragraph',
                text: 'Standard modified deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: '5 cards dealt to each player. Remaining cards form the stock. Dealer is chosen by agreement.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Six Player Albastini: Two teams of three. Requires reaching 30 points (Mrithi) to avoid the double-loss.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Albastini is a sophisticated point-trick game from Tanzania, likely derived from the Portuguese game Bisca. It features unique rules such as a total absence of the follow-suit requirement and a bidding phase where players sacrifice cards to set the trump.',
    tags: [
