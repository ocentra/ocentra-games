    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'albastini',
    LLM: "Game: Albastini. Type: Point-trick. Deck: 36 cards (A=11, 7=10, K=4, J=3, Q=2). Rule: NO follow-suit requirement. Strategy: Sacrifice low cards in 'Otea' phase, save A/7 for winning rounds.",
    Player: "Welcome to Albastini. You have 5 cards. This is a trick-taking game where you can play ANY card at any time—you don't have to follow suit. Try to capture Aces (11 pts) and 7s (10 pts) to score over 60. Watch out for 'Ndoa' and reach your 'Mrithi' to stay in the game!",
    tagline: 'Follow no suits, follow only your strategy.',
    gameCategory: 'Trick-taking',
    subcategory: 'Point-trick',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-40 minutes',
    origin: 'Tanzania / East Africa',
    originName: 'Albastini',
    deck: '36-card stripped deck (A, 7, K, J, Q, 6, 5, 4, 3)',
    alsoKnownAs: [
      'Tanzanian Bisca',
      'East African Bisca',
      'Kula (Traditional Name)',
    ],
    playersDisplay: '2, 3, 4, or 6',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
      variations: true,
      ai: true,
      sources: true,
    },
    historyContent: {
      origins: "Believed to have been introduced to East Africa by Portuguese sailors or traders, Albastini (corruption of 'Al-Bisca' or similar) evolved into a distinct Tanzanian game with localized terminology like 'Mrithi' and 'Ndoa'.",
      originCountries: [
        'Tanzania',
        'Portugal',
      ],
      timeline: [
        '16th-18th Century: Portuguese Bisca enters East African ports (Zanzibar, Dar es Salaam).',
        'Late 20th Century: Formalized local rules documented in Tanzania.',
        '2010s: Digital versions by local developers (like Augustino Mponzi) popularize it in the app stores.',
      ],
      evolution: "While Bisca required following suit or trumping in its Italian/Portuguese origins, Albastini dropped this constraint, allowing for deeper 'sacrifice' plays.",
      cultural: "Commonly played in 'vijiwe' (social meeting points) in Tanzania. Winning a trick is called 'Kula' (eating).",
    },
    setupContent: {
      players: '2, 3, or teams of 2 (4 players) or 3 (6 players).',
      deck: '36-card standard (Remove 2s, 8s, 9s, 10s).',
      equipment: 'Standard modified deck, score sheet.',
      dealing: '5 cards dealt to each player. Remaining cards form the stock. Dealer is chosen by agreement.',
    },
    variationsContent: {
      list: [
        {
          id: 'albastini-6p',
          name: 'Six Player Albastini',
          description: 'Two teams of three. Requires reaching 30 points (Mrithi) to avoid the double-loss.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Follows legal moves but often wastes high trumps (A/7) on low-value tricks.',
        medium: 'Tries to reach Mrithi. Saves Aces for tricks containing 7s.',
        hard: "Tracks cards in opponents' hands based on their 'Otea' bids. Knows when to throw away a King to save an Ace.",
      },
      considerations: [
        "AI must operate without a 'Follow Suit' constraint, which increases the branching factor significantly.",
        'Bidding logic (Otea) should focus on sacrificing 6s or 5s.',
      ],
    },
