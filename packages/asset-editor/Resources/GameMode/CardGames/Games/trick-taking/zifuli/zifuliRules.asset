  data: {
    LLM: 'Game: Zifuli. Logic: See rules.objective and rules.gameplay.',
    Player: 'Zifuli is a 5-player variant of Cöch (Cucco), an Italian partnership trick-taking game from Bergamo. Uses the special 40-card Cucco deck (20 pairs). 8 cards each. Bidding phase determines secret partnerships: bid by naming a card you hold, the holder of the other copy becomes your partner (hidden until card is played). Can bid both copies = play alone. Overcall only by lower card of same suit. Win by capturing more card points (19 total).',
    objective: 'Win tricks containing valuable cards. Side with 10+ of 19 points wins.',
    gameplay: 'Bidding: name a card you hold; holder of matching copy = secret partner. Overcall with lower card of same suit only. Can call card you hold both copies of = play alone. Play: no trumps, follow suit, highest of led suit wins, first of equal cards beats second. Card points: Figure V-VIIII=½pt, X=1pt; Matte XI-XV+Brescia=1pt each. Total 19pts.',
    keyRules: [
      'Secret partnership via card naming',
      '40-card Cucco deck (20 pairs)',
