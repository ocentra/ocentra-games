    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Zifuli',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Zifuli is a 5-player variant of Cöch (Cucco), an Italian partnership trick-taking game from Bergamo. Uses the special 40-card Cucco deck (20 pairs). 8 cards each. Bidding phase determines secret partnerships: bid by naming a card you hold, the holder of the other copy becomes your partner (hidden until card is played). Can bid both copies = play alone. Overcall only by lower card of same suit. Win by capturing more card points (19 total).',
              },
              {
                type: 'paragraph',
                text: '5-player variant of Cöch/Cucco from Bergamo, Italy. Described by Anthony Smith in The Playing-Card Vol XX No 1 (1991).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '40-card Cucco deck: 20 pairs. Figure suit (I-X, Roman numerals) + Matte suit (Matto, Mascherone, Secchia, Nulla, XI Osteria, XII Gatto, XIII Cavallo, XIIII Bragon, XV Cucco, Brescia). In Zifuli: Matto ranks between Nulla and Osteria (not lowest).',
              },
              {
                type: 'paragraph',
                text: 'Cucco deck (Masenghini), stakes',
              },
              {
                type: 'paragraph',
                text: '8 cards each, in batches of 4.',
              },
            ],
          },
        ],
      },
