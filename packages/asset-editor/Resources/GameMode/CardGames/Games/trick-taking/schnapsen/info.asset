    aiContent: {
      difficulty: {
        easy: 'Plays legal cards and declares 66 only when obviously over the threshold.',
        medium: 'Tracks card points, values marriages, and closes the talon only with clear trump strength.',
        hard: 'Counts the 20-card pack, infers hidden cards from draws and leads, and evaluates whether closing maximizes expected game points.',
      },
      considerations: [
        'AI must track card-point totals and marriage declarations.',
        'The follow-suit rules change after the talon is closed or exhausted.',
        'Going out incorrectly is costly and must be modeled explicitly.',
      ],
