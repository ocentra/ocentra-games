    historyContent: {
      origins: 'Schnapsen is an Austrian two-player form of the wider Sechsundsechzig or Sixty-Six family. It is described as a tightened version of the German game Sechsundsechzig and is closely related to games such as Bauernschnapsen, Talon-Schnapsen, Tute, Tyziacha, and Snapszli.',
      originCountries: [
        'Austria',
      ],
      timeline: [
        '18th-19th century: Sixty-Six family games spread across Central Europe.',
        'Modern era: Schnapsen becomes one of Austria’s best-known two-player card games, with organized tournaments.',
      ],
      evolution: 'Schnapsen sharpened the Sixty-Six structure into a 20-card Austrian two-hander with a talon, marriage declarations, and the option to close the talon.',
      cultural: 'Schnapsen is a well-known Austrian two-player game with organized tournament play and a reputation as a demanding concentration game rather than a light social filler.',
    },
    setupContent: {
      players: 'Exactly two players sit opposite each other.',
      deck: 'Use 20 cards: Ace, Ten, King, Queen or Ober, and Jack or Unter in each suit. Card points are A=11, 10=10, K=4, Q/O=3, J/U=2.',
      equipment: 'A 20-card Schnapsen pack and a score sheet or counters for game points.',
      dealing: 'Deal five cards to each player. Turn one card face up to establish trump and place the remaining stock crosswise on it as the talon.',
    },
