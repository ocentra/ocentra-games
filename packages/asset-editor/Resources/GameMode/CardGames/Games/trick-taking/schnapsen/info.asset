    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Schnapsen',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Schnapsen is a two-player Austrian marriage-group point-trick game played with a 20-card pack. Players try to be first to 66 points by taking valuable tricks and declaring marriages. The game has an open-talon phase followed by stricter play after the talon is exhausted or closed.',
              },
              {
                type: 'paragraph',
                text: 'Schnapsen is an Austrian two-player form of the wider Sechsundsechzig or Sixty-Six family. It is described as a tightened version of the German game Sechsundsechzig and is closely related to games such as Bauernschnapsen, Talon-Schnapsen, Tute, Tyziacha, and Snapszli.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly two players sit opposite each other.',
              },
              {
                type: 'paragraph',
                text: 'Use 20 cards: Ace, Ten, King, Queen or Ober, and Jack or Unter in each suit. Card points are A=11, 10=10, K=4, Q/O=3, J/U=2.',
              },
              {
                type: 'paragraph',
                text: 'A 20-card Schnapsen pack and a score sheet or counters for game points.',
              },
              {
                type: 'paragraph',
                text: 'Deal five cards to each player. Turn one card face up to establish trump and place the remaining stock crosswise on it as the talon.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Three-Handed Schnapsen: A three-player adaptation of the two-player game in which the deal and table structure are changed for an extra player.',
                  },
                  {
                    text: 'Talon-Schnapsen: A related talon form in the Schnapsen family.',
                  },
                ],
              },
            ],
          },
        ],
      },
