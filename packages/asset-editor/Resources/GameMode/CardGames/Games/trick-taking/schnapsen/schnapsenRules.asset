    gameId: 'schnapsen',
    icon: '🃏',
  },
  data: {
    LLM: 'Players take tricks, drawing from the talon after each trick while it remains open. During the open phase, following suit is not required. A player holding king and queen or ober of the same suit may declare a marriage when leading one of them, scoring 20 points or 40 in trumps. When the talon is exhausted or closed, players must follow suit if possible and trump if unable to follow. A player who believes they have 66 or more points announces it; if correct they score game points based on the opponent’s points, otherwise the opponent scores.',
    Player: 'Players take tricks, drawing from the talon after each trick while it remains open. During the open phase, following suit is not required. A player holding king and queen or ober of the same suit may declare a marriage when leading one of them, scoring 20 points or 40 in trumps. When the talon is exhausted or closed, players must follow suit if possible and trump if unable to follow. A player who believes they have 66 or more points announces it; if correct they score game points based on the opponent’s points, otherwise the opponent scores.',
    objective: 'Be the first player to reach at least 66 card points in the hand, then correctly declare going out to score game points.',
    gameplay: 'Players take tricks, drawing from the talon after each trick while it remains open. During the open phase, following suit is not required. A player holding king and queen or ober of the same suit may declare a marriage when leading one of them, scoring 20 points or 40 in trumps. When the talon is exhausted or closed, players must follow suit if possible and trump if unable to follow. A player who believes they have 66 or more points announces it; if correct they score game points based on the opponent’s points, otherwise the opponent scores.',
    keyRules: [
      'First to 66 points may go out and score the hand.',
      'Marriages score only when the declaring player has already won a trick or wins one before scoring is finalized.',
      'While the talon is open, players draw after each trick and follow-suit obligations are relaxed.',
      'After closing or exhausting the talon, players must follow suit and trump when required.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Exactly two players sit opposite each other.',
      deck: 'Use 20 cards: Ace, Ten, King, Queen or Ober, and Jack or Unter in each suit. Card points are A=11, 10=10, K=4, Q/O=3, J/U=2.',
      equipment: 'A 20-card Schnapsen pack and a score sheet or counters for game points.',
      dealing: 'Deal five cards to each player. Turn one card face up to establish trump and place the remaining stock crosswise on it as the talon.',
    },
    turnFlow: 'Players take tricks, drawing from the talon after each trick while it remains open. During the open phase, following suit is not required. A player holding king and queen or ober of the same suit may declare a marriage when leading one of them, scoring 20 points or 40 in trumps. When the talon is exhausted or closed, players must follow suit if possible and trump if unable to follow. A player who believes they have 66 or more points announces it; if correct they score game points based on the opponent’s points, otherwise the opponent scores.',
    moveValidityConditions: {
      ante: 'Bauernschnapsen is a point-based trick-taking game and does not require pre-hand monetary antes.',
      deal: 'The initial distribution of five cards per player is performed by the system automated dealer.',
      reveal_market: 'All twenty cards are distributed to the players; there is no public market or shared pool of cards.',
      buy_market: 'There is no card market area in this game; players succeed using only the hand they were dealt.',
      buy_stock: 'The entire 20-card deck is dealt out at the start of the round; no stock remains to be purchased.',
      fold: "Players are committed to their partnership's contract and must participate until the hand concludes.",
      check: 'The game uses a trick-taking structure rather than a vying structure where checking would be an option.',
      call: 'There is no bet to match in this game; competition is based on contract declarations and trick points.',
      bet: 'Progress is measured by game points subtracted from a target total rather than financial betting.',
      raise: 'The value of the round is fixed by the declared contract and cannot be raised through wagering.',
      declare: 'During trick play or bidding phase.',
      reveal_hand: 'Hands stay private until cards are played into tricks; there is no dedicated reveal phase.',
      award_pot: "Game points are awarded to the team's total score rather than distributing a physical pot of assets.",
      play_card: 'Must follow suit; must trump if void in suit.',
      draw: 'All cards are distributed during the two-part deal; no drawing occurs during the actual play of tricks.',
      discard: "Every card in the player's hand must be played into a trick; no cards are discarded or buried.",
      pass: 'Players must play one card per trick; passing a turn without action is not permitted in trick play.',
      bid: 'During bidding phase.',
      meld: 'Set collection is handled through marriage declarations rather than a separate melding action.',
      go_out: 'The round concludes automatically once all five tricks have been played by all participants.',
    },
    exampleHands: [
      'Setup example: 5 card(s) per player.',
      'Rule example: Be the first player to reach at least 66 card points in the hand, then correctly declare going out to score game points.',
      'Turn-flow example: Players take tricks, drawing from the talon after each trick while it remains open. During the open phase, following suit is not required. A player holding king and queen or ober of the same suit may declare a marriage when leading one of them, scoring 20 points or 40 in trumps. When the talon is exhausted or closed, players must follow suit if possible and trump if unable to follow. A player who believes they have 66 or more points announces it; if correct they score game points based on the opponent’s points, otherwise the opponent scores.',
      'Scoring example: Card points from tricks plus marriage declarations. A=11, 10=10, K=4, Q/O=3, J/U=2; marriages score 20, trump marriage 40. First player to 66 may go out. Win enough deals to reach the agreed game-point target, commonly seven game points in tournament-style scoring..',
