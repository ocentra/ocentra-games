    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'lost-heir',
    LLM: 'Game: Lost Heir. 2-6 players, partnerships. Custom city deck (New York, Philadelphia, Chicago, Boston). Bid to name Trump city. Trick play: must follow suit. Special cards: Lost Heir (+5), Wrong Boy (-3), Blank (negates). Each trick = 1 point. First to 40 points wins.',
    Player: 'Welcome to Lost Heir! Bid to name your Trump city, then play tricks to score points. Watch for the Lost Heir (+5 points) and avoid the Wrong Boy (-3 points)! Use Blank cards to negate bonus/penalty points. First team to 40 wins!',
    tagline: 'Find the Heir, avoid the Wrong Boy.',
    gameCategory: 'Trick-taking',
    subcategory: 'Bidding / Partnership',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-30 minutes',
    origin: 'USA (McLoughlin Bros.)',
