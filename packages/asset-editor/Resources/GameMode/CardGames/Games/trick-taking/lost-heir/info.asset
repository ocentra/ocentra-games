    historyContent: {
      origins: "Based on the 1872 novel 'The Lost Heir of Linlithgow'. McLoughlin Bros. patented the game in 1893.",
      originCountries: [
        'USA',
      ],
      timeline: [
        '1893: First edition released, featuring New York as the highest city suit.',
        '1908: Updated with more modern cities for the Canadian market (Toronto, Montreal).',
        "1920s: Milton Bradley takes over production; becomes a staple 'Parlor Game'.",
        'Present: A highly sought-after collectible for card game historians and vintage toy enthusiasts.',
      ],
      evolution: "The game was one of the first successful 'themed' card games to move away from standard French suits (Spades/Hearts) to broaden its commercial appeal.",
      cultural: "Used as a social entertainment during the Victorian era, often with a 'storyteller' element describing the search for the heir.",
    },
