    historyContent: {
      origins: "Derived from the French game 'La Bête' (The Beast) and related to the English 'Loo'. It became extremely popular in 18th and 19th-century Italy, evolving from 'Lest' or 'Bête' which spread across European courts.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        "1700s: The game 'Lest' spread across Europe as a precursor to Rams.",
        '1800s: Bestia became a staple in Italian social salons and village taverns.',
        'Present: Remained popular in rural Italy, particularly played during Christmas and Easter gatherings.',
      ],
      evolution: "The distinctive punishment mechanism (paying the full pot) ensured that stakes grew exponentially, leading to the Italian phrase 'andare in bestia' (to fly into a rage/financial ruin).",
      cultural: 'Regarded as a game of courage; players must decide whether to risk their capital based on hand evaluation and the actions of their rivals.',
    },
    setupContent: {
      players: '4 to 6 players; 5 is considered the ideal number for balanced play.',
      deck: 'A standard 40-card Italian deck (Swords, Batons, Cups, Coins). With Latin suits, ranks from high to low are: Ace, 3, King (Re), Horse (Cavallo), Jack (Fante), 7, 6, 5, 4, 2. When French suits are used, the Queen replaces the Horse.',
      equipment: 'Chips or currency for the central pot.',
      dealing: 'Deal 3 cards to each player (usually clockwise). One card is turned face up to determine the Trump suit.',
    },
    variationsContent: {
      list: [
        {
          id: 'bestia-a-5',
          name: 'Five-Card Bestia',
          description: 'Each player receives 5 cards and 5 tricks are played; the pot is divided into five shares.',
        },
        {
          id: 'briscola-bestia',
          name: 'Briscola Bestia',
          description: 'Uses the point-values and ranking system of Briscola (Ace=11, 3=10, King=4...) rather than simple trick counts.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Plays almost every hand regardless of strength. Does not calculate pot risk.',
        medium: 'Folds hands without trumps or high cards. Plays if it holds at least one face-card trump.',
        hard: "Calculates Expected Value (EV) based on pot size and probable opponent holdings. Aggressively attempts to 'Beast' opponents by drawing trumps.",
      },
      considerations: [
        'AI must weigh the 33% reward of a trick against the 100% penalty risk.',
        'Requires tracking of played cards to determine remaining trump density.',
      ],
    },
