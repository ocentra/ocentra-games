  data: {
    hero: {
      title: 'BESTIA',
      subtitle: 'The Beast',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bestia',
            subtitle: 'The Beast',
            content: [
              {
                type: 'paragraph',
                text: "Bestia (The Beast) is a classic Italian gambling card game of the Rams family, dating back to the 18th century. It combines standard trick-taking mechanics with a high-stakes pool-betting system. Players win shares of the pot by taking tricks, but failing to win a single trick results in the 'Bestia' penalty: the player must match the entire current pot for the next round. It is a game of high tension, calculation, and bluffing, especially popular during festive seasons in Italy.",
              },
              {
                type: 'paragraph',
                text: "Derived from the French game 'La Bête' (The Beast) and related to the English 'Loo'. It became extremely popular in 18th and 19th-century Italy, evolving from 'Lest' or 'Bête' which spread across European courts.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 to 6 players; 5 is considered the ideal number for balanced play.',
              },
              {
                type: 'paragraph',
                text: 'A standard 40-card Italian deck (Swords, Batons, Cups, Coins). With Latin suits, ranks from high to low are: Ace, 3, King (Re), Horse (Cavallo), Jack (Fante), 7, 6, 5, 4, 2. When French suits are used, the Queen replaces the Horse.',
              },
              {
                type: 'paragraph',
                text: 'Chips or currency for the central pot.',
              },
              {
                type: 'paragraph',
                text: 'Deal 3 cards to each player (usually clockwise). One card is turned face up to determine the Trump suit.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Five-Card Bestia: Each player receives 5 cards and 5 tricks are played; the pot is divided into five shares.',
                  },
                  {
                    text: 'Briscola Bestia: Uses the point-values and ranking system of Briscola (Ace=11, 3=10, King=4...) rather than simple trick counts.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bestia (The Beast) is a classic Italian gambling card game of the Rams family, dating back to the 18th century. It combines standard trick-taking mechanics with a high-stakes pool-betting system. Players win shares of the pot by taking tricks, but failing to win a single trick results in the 'Bestia' penalty: the player must match the entire current pot for the next round. It is a game of high tension, calculation, and bluffing, especially popular during festive seasons in Italy.",
