    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Whist Israeli',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Four-player exact-bid trick-taking game popular in Israel. No partnerships; each player bids how many tricks they will take. Two-phase bidding sets contract and trick bids; scoring by exact bid (10 plus square of tricks) or penalty for off.',
              },
              {
                type: 'paragraph',
                text: 'Popular in Israel where it is just called Whist. Classified as an exact-bidding game; no partnerships, unlike classic Whist.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players, no partnerships; play is clockwise. A standard 52-card pack is used; each player receives 13 cards. First dealer is chosen at random; the turn to deal passes to the left after each hand.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Dealer shuffles and cuts; all 52 cards dealt one at a time so each player has 13. First dealer chosen at random; turn to deal passes left after each hand.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Gulash: If all four pass in first bidding, do not redeal. Each player passes three cards face down to the left (select before seeing received cards). Then bidding starts again. If all pass again, pass three more left and rebid. If all pass a third time, throw in and redeal by same dealer.',
                  },
                ],
              },
            ],
          },
        ],
      },
