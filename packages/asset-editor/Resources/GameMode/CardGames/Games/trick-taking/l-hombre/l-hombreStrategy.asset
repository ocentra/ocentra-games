    tips: [
      {
        title: 'Tip',
        description: "Remember the 'Manille' changes depending on the trump suit! In Diamonds, it is the 2; in Spades, it is the 7.",
      },
      {
        title: 'Tip',
        description: 'If the Hombre takes cards from the Talon, watch which cards they discard. It tells you exactly which suits they are void in.',
