    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Toruro',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Toruro is a Spanish trick-taking gambling game for 5+ players using a 40-card Spanish deck. There are three pots (Cabeza, Barriga, Cola), one for each trick. Players decide whether to 'go' (ir) or pass, and those who go must win at least one trick or pay a penalty (Lulo). The card ranking features the unusual A-3-K order common in L'Hombre games.",
              },
              {
                type: 'paragraph',
                text: 'Toruro is a Colombian three-card gambling game, said to be popular in the state of Santander. Documented rules draw on information from Harry Viens and on the Toruro rules by Andres F Pabon published at thespiel.net. It belongs to the Rams group of trick-taking games.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '40 cards. Rank: A-3-K-Kt-J-7-6-5-4-2.',
              },
              {
                type: 'paragraph',
                text: 'Chips/counters for 3 pots',
              },
              {
                type: 'paragraph',
                text: 'Deal 3 cards. Turn 1 card for trump.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'First deal everyone must play: In the first deal everyone must play; ensures the game does not end immediately and some lulos are in play.',
                  },
                  {
                    text: 'Ace trump forces play: When an ace is turned up for trump, everyone must play.',
                  },
                ],
              },
            ],
          },
        ],
      },
