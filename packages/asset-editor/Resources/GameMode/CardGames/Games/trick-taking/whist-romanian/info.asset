    hero: {
      title: 'WHIST ROMANIAN',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Whist Romanian',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Romanian Whist is an exact-prediction trick-taking game for 3 to 6 players. Each player bids how many tricks they will take; the sum of all bids must not equal the number of cards dealt. Players score for making their contract exactly and lose points for over- or undertricks.',
              },
              {
                type: 'paragraph',
                text: 'Romanian Whist is a regional exact-prediction trick game; known in Romania simply as Whist. Description contributed by Werner Hintze and others.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Three to six players, each playing alone (no partnerships). Best with 4 to 6.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck; 8 cards per player in use (24 for 3 players, 32 for 4, up to 48 for 6).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'First dealer chosen at random; deal rotates clockwise. Number of cards per player varies by deal: starts at 1 card each for as many deals as players, increases by one per deal up to 8 each, then 8 each for as many deals as players, then decreases back to 1. Example with 4 players: 1,1,1,1, 2,3,4,5,6,7, 8,8,8,8, 7,6,5,4,3,2, 1,1,1,1 (24 deals). After the deal, the next card is turned for trump; in 8-card hands no card remains, so those hands are played without trumps.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: '8-1-8 deal sequence: Begin and end with 8-card hands (8,8,8,8, then 7 down to 1, then back up to 8,8,8,8); reduces 1-card luck.',
                  },
                  {
                    text: 'Blind 1-card: On 1-card deals everyone bids before looking at their card.',
                  },
                  {
                    text: "Forehead 1-card: Players hold 1-card on forehead; see others' cards, bid accordingly.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
