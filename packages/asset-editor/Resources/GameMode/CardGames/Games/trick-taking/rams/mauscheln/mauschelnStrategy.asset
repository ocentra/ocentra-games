    tips: [
      {
        title: 'Tip',
        description: 'Memory: Count the trumps. Since there are only 8 trumps in total, if you have 3, the chances of someone else having enough to beat you across 4 tricks are low.',
      },
      {
        title: 'Tip',
        description: "If you are the dealer, you are the last to act; use this information to decide if the pot is 'vulnerable'.",
