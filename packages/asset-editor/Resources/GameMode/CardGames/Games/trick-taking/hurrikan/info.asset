    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 2,
    routePath: 'hurrikan',
    LLM: 'Game: Hurrikan (German Scopa). 2-player, 32-40 card deck. Deal: 3 cards per player, 4 on table. Turn: Play card. Capture matching single card OR cards summing to card value (single match has priority). Hurrikan (empty table) = 1 bonus point. Scoring: Most cards (1), Most Hearts (1), Seven of Hearts (1), Hurrikan (1 each). Win: First to 16.',
    Player: "Welcome to Hurrikan, the German sweep game. Play a card from your hand to capture cards from the table. You can take a single card of equal value or multiple cards that sum to your card's value. Complete a 'Hurrikan' (sweep) by taking all cards from the tableâ€”that's a bonus point. Prioritize Hearts and the Seven of Hearts. First to 16 points wins.",
    tagline: 'Capture cards. Sweep the table. Race to 16 points.',
    gameCategory: 'Fishing',
    subcategory: 'Scopa-variant',
    playerMode: 'multiplayer',
    difficulty: 'Beginner',
