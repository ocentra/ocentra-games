    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Troeven',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Troeven is a Dutch/Flemish trick-taking game where players start at a score (e.g., 7) and work down to zero. Uses a 32-card deck (7-A). The trump caller picks trump from first 4-5 cards. Win more card-value points (A=4, K=3, Q=2, J=1) than opponents to reduce score by 1. If trump caller loses, their team gains a point (penalty).',
              },
              {
                type: 'paragraph',
                text: 'Troeven is the Dutch name for this trick-taking game, popular in the southern Dutch province of Limburg. It was described by Harry Tiggelovend in The Playing-Card (volume XXIV, No 6). The name means trumps. The game is part of the Couillon family played in Belgium and the Netherlands and is likely related to the old Trumpfspiel recorded in Strasbourg in 1637, which had the same card values.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '32 cards. A(high)-7(low). Values: A=4, K=3, Q=2, J=1. Total 40 pts.',
              },
              {
                type: 'paragraph',
                text: 'Cards, score sheet',
              },
              {
                type: 'paragraph',
                text: '8 cards each. Trump caller sees first 4-5 and declares.',
              },
            ],
          },
        ],
      },
