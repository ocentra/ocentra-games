    hero: {
      title: 'ZHÀO PÉNGYOU',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Zhào Péngyou',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Zhào Péngyou ('Finding Friends') is a Chinese multi-player trick-taking game. 5-12 players. Multiple decks + jokers. Trump maker 'calls' specific cards — holders become secret partners (kankei). Point cards: 5=5pts, 10/K=10pts (100 total). Teams level up through ranks. First to Ace level wins.",
              },
              {
                type: 'paragraph',
                text: 'Zhào Péngyou (Looking for Friends) is a Chinese trick-taking game in the Shēng Jí (升级, raise level) family, alongside Dă Băi Fēn (打百分, 100) and Tractor (拖拉机). These games share level-as-card-rank progression and King-Ten-Five point scoring. The variant with variable, secret partnerships called by the trump maker is popular across China and is one of the few trick-taking games that scales well to 6–12 players. The aim is to win tricks containing Kings, Tens and Fives while teammates are revealed only when the called cards are played.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Multiple decks with jokers. 54 cards per deck.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: 'All cards dealt evenly.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Active and Passive Scores: Only active players (winners of previous hand) may make trumps; defenders win at 40 per pack with no middle zone.',
                  },
                  {
                    text: 'Number of Cards and Size of Kitty: Some use fixed 6-card kitty; others allow 8-card kitty or vary jokers to get close to 6.',
                  },
                  {
                    text: 'Trump suit tractors above Ace: Some allow tractors to continue above ace in trump suit (e.g. 4s and diamonds: A-A-4-4 as tractor).',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Zhào Péngyou ('Finding Friends') is a Chinese multi-player trick-taking game. 5-12 players. Multiple decks + jokers. Trump maker 'calls' specific cards — holders become secret partners (kankei). Point cards: 5=5pts, 10/K=10pts (100 total). Teams level up through ranks. First to Ace level wins.",
