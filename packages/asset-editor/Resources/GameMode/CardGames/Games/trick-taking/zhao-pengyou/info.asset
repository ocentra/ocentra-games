    historyContent: {
      origins: 'Zhào Péngyou (Looking for Friends) is a Chinese trick-taking game in the Shēng Jí (升级, raise level) family, alongside Dă Băi Fēn (打百分, 100) and Tractor (拖拉机). These games share level-as-card-rank progression and King-Ten-Five point scoring. The variant with variable, secret partnerships called by the trump maker is popular across China and is one of the few trick-taking games that scales well to 6–12 players. The aim is to win tricks containing Kings, Tens and Fives while teammates are revealed only when the called cards are played.',
      originCountries: [
        'China',
      ],
      timeline: [
        'Chinese King-Ten-Five (Shēng Jí 升级) family game; popular across China.',
      ],
      evolution: 'Evolved within the Shēng Jí family; variable-partnership form (call cards for secret teammates) distinguishes it from fixed-partnership 100 and Tractor. Now widely played across China.',
      cultural: 'Played as a social party game for large groups; secret partner revelation and level progression make it engaging for 5–12 players.',
    },
    setupContent: {
      players: 'Two or more players.',
      deck: 'Multiple decks with jokers. 54 cards per deck.',
      equipment: 'Cards',
      dealing: 'All cards dealt evenly.',
    },
