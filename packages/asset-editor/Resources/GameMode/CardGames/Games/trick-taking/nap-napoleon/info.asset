    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Nap (Napoleon)',
            subtitle: 'The Classic English Pub Game',
            content: [
              {
                type: 'paragraph',
                text: 'Nap (short for Napoleon) is a classic English trick-taking game that gained massive popularity in Britain during the 19th and early 20th centuries. It is a quick, high-stakes game where players bid on how many of their five cards they can win in a trick-based battle against everyone else. It is known for its escalating bidding tiers named after Napoleonic battles (Wellington, BlÃ¼cher) and its simple yet ruthless scoring system.',
              },
              {
                type: 'paragraph',
                text: "Napoleon is a classic English pub game first documented in H.E. Heather's October 1875 edition of The Bazaar. It quickly became England's national five-card game, displacing Loo. The expression 'going Nap' (meaning to risk all on one attempt) derives from this game.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-8 players; 4-5 is optimal. No permanent partnerships.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2. Often reduced based on player count.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, poker chips or counters for stakes.',
              },
              {
                type: 'paragraph',
                text: 'Five cards to each playerâ€”either 3 then 2, or 2 then 3. Cards shuffled only at start and after successful Nap/Wellington/BlÃ¼cher.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'MisÃ¨re: Bid to lose every trick. Worth 3 points, ranks between Three and Four.',
                  },
                  {
                    text: 'Peep Nap: Extra card dealt face-down to table. Players may pay to privately view it before bidding.',
                  },
                ],
              },
            ],
          },
        ],
      },
