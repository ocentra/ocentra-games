    tips: [
      {
        title: 'Tip',
        description: 'Passing high cards is common, but sometimes keeping them is safer if you have many low cards in the same suit.',
      },
      {
        title: 'Tip',
        description: 'Track which Spades have been played to know if the Queen is still out.',
      },
      {
        title: 'Tip',
        description: 'The player who leads controls the game — try to maintain lead when you have safe suits.',
      },
      {
        title: 'Tip',
        description: "In a 'no pass' round, play more conservatively since you're stuck with your hand.",
