  data: {
    hero: {
      title: 'MADRASSO',
      subtitle: 'Venetian Partnership Trick-Taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Madrasso',
            subtitle: 'Venetian Partnership Trick-Taking',
            content: [
              {
                type: 'paragraph',
                text: "Madrasso is a classic Venetian trick-taking game played in partnerships. It is a member of the 'Tressette' family but features a trump suit, making it a bridge between Tressette and Briscola. Known for its specific point target (777 points) and the 'exchange' of the trump indicator card, it is the quintessential game of the Veneto region of Italy. It requires careful hand management and a strong memory of point-cards already played.",
              },
              {
                type: 'paragraph',
                text: "Developed in the 18th century as a variation of Tressette that introduced the 'Atout' (Trump) as a permanent feature.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: '40 cards: Ace (11), 3 (10), King (4), Knight (3), Jack (2), and 7-6-5-4-2 (0). Total points = 120 + 10 for last trick.',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 10 cards. The 21st card is turned face-up as the Trump Indicator.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Madrasso a Tre: A 3-player version with a dummy or discarded cards.',
                  },
                  {
                    text: 'Tressette con Biliardo: A related regional trick-taker.',
                  },
                  {
                    text: "Briscola Chiamata: The broader 'called trump' family.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Madrasso is a classic Venetian trick-taking game played in partnerships. It is a member of the 'Tressette' family but features a trump suit, making it a bridge between Tressette and Briscola. Known for its specific point target (777 points) and the 'exchange' of the trump indicator card, it is the quintessential game of the Veneto region of Italy. It requires careful hand management and a strong memory of point-cards already played.",
    tags: [
      'card-game',
      'trick-taking',
      'partnership',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'madrasso',
    LLM: 'Game: Madrasso. Type: Partnership trick-taking. Target: 777 points. Deck: 40-card Italian. Rules: Follow suit, must overtake, trump if void. Card values: Ace=11, 3=10, King=4, Knight=3, Jack=2. Last trick=10 points. Can exchange 7 of trumps for indicator.',
    Player: 'Welcome to Madrasso. Partner with your teammate to reach 777 points before your opponents. Watch for the trump indicatorâ€”you may be able to exchange your 7 for a better card. Remember: follow suit, overtake when possible, and track those valuable Aces and 3s!',
    tagline: 'Seven hundred seventy-seven points stand between you and glory.',
    gameCategory: 'Trick-taking',
    subcategory: 'Partnership',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '45-60 minutes',
    origin: 'Italy (Venice / Veneto)',
    originName: 'Madrasso (Italian)',
    deck: '40-card Italian (Venetian pattern)',
    alsoKnownAs: [
      'Magrasso',
      'Mandrasso',
    ],
    playersDisplay: '4',
    quality: 'complete',
    completeness: {
      overview: true,
