    },
    historyContent: {
      origins: "Developed in the 18th century as a variation of Tressette that introduced the 'Atout' (Trump) as a permanent feature.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        "1700s: Madrasso (and the verb 'madrassare') enters the Venetian dialect.",
        "1900s: Becomes a staple in Venice's city clubs and rural taverns.",
        'Present: Still the most played partnership game in the Venice-Padua-Treviso triangle.',
        "2012: The 'Associazione Madrasso' publishes standardized tournament rules.",
      ],
      evolution: "The game's 777-point target is symbolic, intended to create a long session of at least 10 rounds where consistent play is rewarded over 1-round luck.",
      cultural: "In Venice, it is traditional to play Madrasso in pairs for an 'Ombra' (a small glass of wine).",
    },
    setupContent: {
      players: '4 players in two partnerships (North-South vs East-West).',
      deck: '40 cards: Ace (11), 3 (10), King (4), Knight (3), Jack (2), and 7-6-5-4-2 (0). Total points = 120 + 10 for last trick.',
      equipment: '40-card Italian deck, score sheet.',
      dealing: 'Each player is dealt 10 cards. The 21st card is turned face-up as the Trump Indicator.',
    },
