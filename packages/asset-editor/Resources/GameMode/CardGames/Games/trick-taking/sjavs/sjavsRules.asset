  data: {
    LLM: 'Game: Sjavs. Logic: See rules.objective and rules.gameplay.',
    Player: "Sjavs (pronounced 'Shows' or 'Shavs') is a popular card game in the Faroe Islands and parts of Denmark. It is a derivative of the German game Schafkopf, played with a stripped deck of 32 cards (standard Skat/Piquet deck). The game involves bidding, trump calling, and trick-taking, with a unique scoring system based on 'Rubbers' (first to reach 0 points from 24). It is highly strategic and social.",
    objective: 'Win tricks worth points. Reduce score from 24 to 0.',
    gameplay: "After the deal, dealer's left has first bid: each player states the length of their longest trump suit (five or more cards) or Pass; the longest length wins, and clubs beats another suit of the same length. The bid winner then announces trump. Dealer's left leads; play is clockwise. Players must follow suit when able and may trump or discard when void. The winner of each trick leads to the next. There are eight tricks; then each side counts card points in the tricks they won.",
    keyRules: [
      'Must follow suit if able; may trump or discard when void.',
      'Six permanent trumps (Club Q, Spade Q, Club J, Spade J, Heart J, Diamond J) rank above trump-suit cards; then A, K, Q, 10, 9, 8, 7 in trump.',
      'Bidding: state length of longest 5+ trump suit or Pass; longest wins; same length clubs beats. Bid winner names trump.',
      '120 points per deal; rubber: count down from 24, first to 0 wins.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '4 (Partners sit opposite).',
      deck: '32 cards: the 2s through 6s are removed from a standard 52-card pack. Six cards are permanent highest trumps (Club Q, Spade Q, Club J, Spade J, Heart J, Diamond J); remaining cards rank A, K, Q, 10, 9, 8, 7. Point values: A=11, 10=10, K=4, Q=3, J=2; 120 points in the pack.',
      equipment: '32 cards: the 2s through 6s are removed from a standard 52-card pack. Six cards are permanent highest trumps (Club Q, Spade Q, Club J, Spade J, Heart J, Diamond J); remaining cards rank A, K, Q, 10, 9, 8, 7. Point values: A=11, 10=10, K=4, Q=3, J=2; 120 points in the pack.',
      dealing: 'Deal 8 cards each (or 3-3-2).',
