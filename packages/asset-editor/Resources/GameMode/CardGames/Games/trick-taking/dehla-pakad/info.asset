    historyContent: {
      origins: 'Dehla Pakad originated in North India and is deeply rooted in the social fabric of states like Punjab and Haryana. It shares common ancestry with Iranian and Pakistani games like Court Piece and Rang.',
      originCountries: [
        'India',
      ],
      timeline: [
        'Ancient-19th Century: Evolution from traditional trick-taking games in the South Asian subcontinent.',
        '20th Century: Becomes a staple social game in North Indian households.',
        'Present: Widely available on mobile gaming platforms in India as a cultural favorite.',
      ],
      evolution: "The game evolved from the broader 'Rang' family of games. Its specific focus on the tens (Dehlas) distinguishes it from other variants that focus purely on trick count.",
      cultural: 'Dehla Pakad is often played at weddings, festivals, and community gatherings, emphasizing teamwork and memory skills.',
