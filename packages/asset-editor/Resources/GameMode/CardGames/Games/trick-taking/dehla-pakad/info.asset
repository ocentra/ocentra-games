    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Dehla Pakad',
            subtitle: 'North Indian Point-Trick',
            content: [
              {
                type: 'paragraph',
                text: "Dehla Pakad (Hindi for 'Collect the Tens') is a traditional Indian trick-taking card game played by four players in two fixed partnerships. It is a member of the Court Piece (Rang) family, characterized by its unique 'Double Sar' mechanic where tricks are only collected after winning two consecutive tricks. The primary goal is capturing the four tens in the deck.",
              },
              {
                type: 'paragraph',
                text: 'Dehla Pakad originated in North India and is deeply rooted in the social fabric of states like Punjab and Haryana. It shares common ancestry with Iranian and Pakistani games like Court Piece and Rang.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two partnerships (partners sit opposite each other).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Ranking: A (high), K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2 (low).',
              },
              {
                type: 'paragraph',
                text: "Standard deck, paper and pen for tracking 'Kots'.",
              },
              {
                type: 'paragraph',
                text: 'Dealer deals a batch of 5 cards to each player. After trump selection, the remaining cards are dealt in batches of 4. Play is anticlockwise.',
              },
            ],
          },
        ],
      },
