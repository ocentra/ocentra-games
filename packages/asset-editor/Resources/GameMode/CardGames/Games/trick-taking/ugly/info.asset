                text: '52 cards. A high.',
              },
              {
                type: 'paragraph',
                text: 'Cards, scoresheet',
              },
              {
                type: 'paragraph',
                text: 'All cards dealt. Pass cards (escalating each round).',
              },
            ],
          },
