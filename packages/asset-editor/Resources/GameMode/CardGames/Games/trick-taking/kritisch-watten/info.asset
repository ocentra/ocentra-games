        tabLabel: 'About',
        pages: [
          {
            title: 'Kritisch-Watten',
            subtitle: 'Alpine Trick-Taking with Critical Cards',
            content: [
              {
                type: 'paragraph',
                text: "Kritisch-Watten (also known as Bayerisch Watten or Kritisch Warp) is a popular Alpine variant of the trick-taking game Watten, widely played in Bavaria, Tyrol (Austria), and South Tyrol. It is distinguished by the presence of 'Kritische Karten' (Criticals or Kritten)â€”permanent trumps that rank above all other cards, including the elected trump suit and rank. The game is highly social, utilizing secret signals between partners and psychological bluffing.",
              },
              {
                type: 'paragraph',
                text: "Watten dates back to the early 19th Century, allegedly popularized by soldiers during the Napoleonic Wars. 'Kritisch-Watten' emerged as the more competitive variant in Alpine taverns.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships (2 vs 2).',
              },
              {
                type: 'paragraph',
                text: "33 cards in Tyrol (including the 'Weli'). Hearts, Leaves, Acorns, Bells. Standard Ranks: Sau (Ace), K, O, U, 10, 9, 8, 7.",
              },
              {
                type: 'paragraph',
                text: "33 cards in Tyrol (including the 'Weli'). Hearts, Leaves, Acorns, Bells. Standard Ranks: Sau (Ace), K, O, U, 10, 9, 8, 7.",
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 5 cards (packets of 3 then 2).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Bayerisch Watten: Uses the 32-card deck with fixed 7s as criticals.',
                  },
                  {
                    text: 'Tyrolean Watten: Often uses 33 cards (includes Weli).',
                  },
                  {
                    text: 'Vierzwick: A similar German trick-taking game.',
                  },
                ],
              },
            ],
          },
