      {
        title: 'Tip',
        description: "The Nine and Six are often overlooked, but they contribute to the 'Game' point count if they capture a Ten.",
      },
      {
        title: 'Tip',
        description: "Joker Management: The Joker is a 'wild' trump that ranks between the Jack and the Ten. Use it to kill a King or Queen lead if the Jack is already gone.",
