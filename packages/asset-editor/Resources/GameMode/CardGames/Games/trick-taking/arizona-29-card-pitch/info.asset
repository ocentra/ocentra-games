    historyContent: {
      origins: "Developed in the Southwestern United States as a faster, more intense version of the standard 52-card Partnership Pitch. The use of the '6' as the low card instead of the '2' is a regional hallmark.",
      originCountries: [
        'United States',
      ],
      timeline: [
        '1800s: Pitch (Setback) becomes popular in back-woods America.',
        "mid-20th C.: Arizona players standardize the 29-card 'short deck' format.",
        "Present: Remains a popular 'Social Club' game in Arizona and neighboring states.",
      ],
      evolution: "The transition to a 29-card deck was likely an adaptation to make the Joker (a common 53rd card) more central to the gameplay, as it acts as a 'Middle-Trump'.",
      cultural: "In Arizona, this game is often preferred over standard 'Seven Up' for its predictive bidding and the power of the 'Kitty' exchange.",
    },
    setupContent: {
      players: '4 players in two partnerships (North-South vs East-West).',
