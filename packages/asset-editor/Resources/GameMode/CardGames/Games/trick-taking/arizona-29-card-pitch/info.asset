    aiContent: {
      difficulty: {
        easy: 'Bids 2-3 with only one high trump. Fails to use the kitty to create voids in plain suits.',
        medium: 'Consistently bids 4 with the Ace and Joker. Protects the Jack when possible.',
        hard: "Expertly calculates 'Game' pip potential. Sacrifices the Six (Low) to ensure a Ten is captured for the team. Leads low trumps to 'smoke out' opponents' higher ranks.",
      },
      considerations: [
        'AI must handle a non-standard 29-card deck mapping.',
        "The 'Kitty' logic requires the AI to weight cards based on suit-strength and 'Game' point values (A=4, 10=10).",
      ],
    },
