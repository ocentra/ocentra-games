    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Arizona 29-card Pitch',
            subtitle: '29 cards. Infinite Strategy.',
            content: [
              {
                type: 'paragraph',
                text: 'Arizona 29-card Pitch is a specialized regional evolution of the classic American game Pitch (Setback). It uses a condensed 29-card deck and incorporates an unbeatable Joker into the trump hierarchy. Played in partnerships, it rewards both the capture of legendary cards (High, Low, Jack) and the strategic management of a 5-card kitty.',
              },
              {
                type: 'paragraph',
                text: "Developed in the Southwestern United States as a faster, more intense version of the standard 52-card Partnership Pitch. The use of the '6' as the low card instead of the '2' is a regional hallmark.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: '29 cards: Ace, King, Queen, Jack, Ten, Nine, Six of each suit, plus one Joker. Remove 2, 3, 4, 5, 7, and 8 from a standard deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack (modified), score sheet.',
              },
              {
                type: 'paragraph',
                text: "Each player is dealt 6 cards in batches of 3. The 5 remaining cards are placed face down as the 'Kitty'.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Standard Partnership Pitch: Played with the full 52-card deck (minus Joker). High to Low is A to 2.',
                  },
                  {
                    text: 'Flat Pitch: No kitty is dealt; players play only with the 6 cards originally dealt.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
