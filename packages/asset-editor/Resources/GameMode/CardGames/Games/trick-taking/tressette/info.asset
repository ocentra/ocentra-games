        rules: {
          objective: 'Score more points than opponents. Game to 21 (or 31/41).',
          gameplay: '1. Deal 10. 2. Accuso (optional declarations: Napoletana = 3-2-A of same suit = 3pts; 3 or 4 of same honor = pts). 3. Play 10 tricks: Must follow suit. No trumps. Highest of led suit wins. 4. Score: A=1, 3/2/K/Kt/J= 1/3. Last trick=1. Total 11/hand.',
          keyRules: [
            '3 > 2 > A > K (unusual ranking)',
            'No trumps',
            'Accuso (declarations) for bonus points',
            '11 points per deal',
            'Strict no-communication rules (traditional)',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Lead your long suits. Save Aces for capturing. Win the last trick (1 pt bonus).',
          intermediate: 'Signal to partner through legal means (the order of played cards can convey information).',
          advanced: 'Count all 40 cards. Calculate exact remaining holdings. Control which suit is led.',
          tips: [
            'The last trick is always worth fighting for.',
            '3s are the most powerful cards.',
            "Communication is limited to legal 'busso' (knocking).",
          ],
