  data: {
    hero: {
      title: 'BAM',
      subtitle: 'The Price of Failure',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bam',
            subtitle: 'The Price of Failure',
            content: [
              {
                type: 'paragraph',
                text: "Bam (also widely known as Pluck) is a cutthroat trick-taking game primarily for three players, though four-player partnerships exist. Its defining feature is the 'Plucking' mechanic: after the first hand, players who met their trick quotas get to steal the best cards from those who failed, creating a slippery slope where the rich get richer and the poor struggle to recover. It uses a specialized 51-card deck (removing small 2s) and features asymmetric trick targets for the dealer and opponents.",
              },
              {
                type: 'paragraph',
                text: "Likely evolved from Whist or Spades variations in the American Midwest, incorporating the 'card exchange' penalty found in games like President (Scum) but applied to a trick-taking structure.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 players (Cutthroat).',
              },
              {
                type: 'paragraph',
                text: '51 Cards: remove 2♦, 2♥, 2♠. Keep 2♣. Add 2 distinct Jokers (Big and Little).',
              },
              {
                type: 'paragraph',
                text: 'Deck, scorepad.',
              },
              {
                type: 'paragraph',
                text: 'Deal all cards. Each player receives 17 cards. (4-player version deals 13 cards).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Four Player Partnership: Standard 52 cards (no Jokers, or Jokers replace low cards). Teams must make a bid. Plucking involves passing cards between partners.',
                  },
                  {
                    text: "Dropsy: A variation where the plucking rules are stricter; players must drop ('give') their cards before seeing what they get back.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bam (also widely known as Pluck) is a cutthroat trick-taking game primarily for three players, though four-player partnerships exist. Its defining feature is the 'Plucking' mechanic: after the first hand, players who met their trick quotas get to steal the best cards from those who failed, creating a slippery slope where the rich get richer and the poor struggle to recover. It uses a specialized 51-card deck (removing small 2s) and features asymmetric trick targets for the dealer and opponents.",
