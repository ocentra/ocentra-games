    historyContent: {
      origins: "Forty-Five is a streamlined version of the ancient Irish game 'Spoil Five,' which was described as the national game of Ireland as early as the 18th century. It traveled with Irish immigrants to the Maritimes of Canada and the New England states, where it remains a cultural identifier.",
      originCountries: [
        'Ireland',
        'Canada',
      ],
      timeline: [
        '1700s: Spoil Five is established in rural Ireland.',
        "1800s: The game evolves into the faster 'Forty-Five' in North America.",
        "1920s: Bidding is added in some regions, creating 'Auction Forty-Five'.",
        "Present: A standard game at social gatherings and '45s Card Parties' in Newfoundland and the Merrimack Valley.",
      ],
      evolution: "The game retains the 'Highest in Red, Lowest in Black' ranking system, which is a rare survival of medieval card game logic.",
      cultural: "In Atlantic Canada, '45s' is often played with intense table-talk and specific regional jargon like 'robbing the trump'.",
    },
    setupContent: {
      players: '4 players (2 vs 2) is the standard partnership format. Can be played 2, 3, or 6ndhanded.',
