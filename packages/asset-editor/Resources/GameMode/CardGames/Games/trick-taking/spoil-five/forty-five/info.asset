    aiContent: {
      difficulty: {
        easy: "Forgets that the Ace of Hearts is a trump; confused by the 'Highest in Red, Lowest in Black' ranking; fails to rob the trump.",
        medium: 'Understands the trump hierarchy; robs the trump; plays basic partnership strategy by not over-taking their partner.',
        hard: "Perfectly calculates the 'reneging' potential of the 5 of trumps; tracks every played trump to know when the Jack is the high card; expertly 'spoils' the round if they realize they cannot win the majority.",
      },
      considerations: [
        'AI must implement a custom ranking engine to handle the bifurcated Red/Black and permanent Ace of Hearts rules.',
      ],
    },
