    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: '110 (One Hundred and Ten)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: '110 (One Hundred and Ten) is an Irish trick-taking game with bidding, related to Twenty-Five. Played with a standard 52-card deck; the first player or team to reach 110 points wins. Players score 5 points per trick. Card ranking varies by trump suit.',
              },
              {
                type: 'paragraph',
                text: 'Ireland. Bidding version of the game Twenty-Five; part of the Irish trick-taking family (Twenty-Five, 55, 110, 220).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2–9 (five cards each plus five-card kitty from one 52-card pack)',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck, score sheet',
              },
              {
                type: 'paragraph',
                text: 'Five cards to each player and five to the kitty (two then three or three then two at a time); deal passes left.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Only bidder can win: Some groups play that only the bidder can win the game; if someone reaches 110 points through tricks taken against another player's bid, the game continues until the bidder wins or loses.",
                  },
                  {
                    text: 'Bidder names trump before kitty: In some circles the bidder must name the trump suit before looking at the five-card kitty instead of naming trump after picking up and discarding.',
                  },
                  {
                    text: 'Different first lead: Some play that the first lead comes from the player to the left of the bidder; others play that the player to the right of the bidder leads the first trick instead.',
                  },
                  {
                    text: 'Bidder scores only bid amount: Some groups rule that the bidder can only score the amount bid; for example, a bid of 15 that wins all five tricks still scores 15 rather than 30.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
