      {
        title: 'Tip',
        description: "Keep track of the 120 total. If you have 30 points and your partner has 31, you've reached safety.",
      },
      {
        title: 'Tip',
        description: 'In Avinas, tens are worth 10 points—as much as a King and Queen combined. Capturing tens is the secondary priority after winning tricks.',
      },
