    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Avinas',
            subtitle: 'The Ram of Jurbarkas',
            content: [
              {
                type: 'paragraph',
                text: "Avinas, which translates to 'Ram', is the Lithuanian cousin of the German Schafkopf. Played primarily in the Jurbarkas region, it is a four-player partnership trick-taking game with a highly idiosyncratic trump hierarchy that includes the Queen of Clubs and the Seven of the trump suit as the two highest cards. It is a game of community, tradition, and numerical precision.",
              },
              {
                type: 'paragraph',
                text: 'Rooted in the same 18th-century Central European traditions that produced Schafkopf (Sheepshead) and Sjavs. It was preserved in Lithuanian rural communities, particularly along the Niemen river.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships (North-South vs. East-West).',
              },
              {
                type: 'paragraph',
                text: '32 cards (standard Skat/Schafkopf pack). A-10-K-Q-J-9-8-7.',
              },
              {
                type: 'paragraph',
                text: "32-card pack, score sheet for tracking 'Horns' (penalties).",
              },
              {
                type: 'paragraph',
                text: 'Cards are dealt face down in two rounds of 4. If a 7 is accidentally dealt face up, it determines the trump suit and the declarer.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Solo Avinas: One player declares a suit and plays alone against the other three. This is usually only played when a player holds an exceptionally strong hand.',
                  },
                ],
              },
            ],
          },
        ],
      },
