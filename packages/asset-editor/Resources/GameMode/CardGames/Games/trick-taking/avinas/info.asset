    aiContent: {
      difficulty: {
        easy: 'Fails to recognize the 7 as a high trump. Leads its Aces into trumps.',
        medium: "Understand the 61-point threshold. Cooperates with partner by 'feeding' them high-point cards (Aces/10s) on winning tricks.",
        hard: "Expertly calculates when to 'renege' on a high trump lead. Perfectly monitors the point total to know exactly when the 61-point 'safety' mark is reached.",
      },
      considerations: [
        'AI must prioritize the QC and Seven of Trumps as ultra-high-value defense assets.',
        'Partnership communication emulation is needed for feeding points.',
      ],
    },
