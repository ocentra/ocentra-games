        pages: [
          {
            title: 'Schembil',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Schembil is a six-player partnership trick-taking game and variant of Briscola, played in Northern Africa and Southern Italy (especially Sicily). Two teams of three choose a captain (rais) who may direct partners; 36 cards (40-card pack minus twos), three cards each, replenish from stock after each trick.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: Europe\nTime Period: Early 1900s\nHistorical Development: The game evolved from traditional card games in the region\nCultural Significance: Popular social and family game',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 6\nPartnerships: Yes (two teams of three)',
              },
              {
                type: 'paragraph',
                text: 'Type: 36 cards from Italian 40-card pack (twos omitted)\nNumber of Decks: 1\nJokers: Not included',
              },
              {
                type: 'paragraph',
                text: 'Italian 40-card deck (use 36 cards)\nScore sheet (optional)\nTable space',
              },
              {
                type: 'paragraph',
                text: 'Cards per Player: 3 each\nDealing Pattern: Clockwise\nReplenish: Each player draws one card from stock at end of each trick until stock exhausted',
              },
            ],
          },
        ],
      },
