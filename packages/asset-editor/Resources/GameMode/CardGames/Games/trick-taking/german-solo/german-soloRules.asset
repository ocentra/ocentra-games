  data: {
    LLM: 'Players bid once in turn with higher contracts over lower. Some contracts create a temporary partner via called ace or king; others are solo contracts. Winning bid determines trump suit and contract objective. Play 8 tricks with follow-suit required. If void in led suit, player may trump or discard. Highest trump wins trick; otherwise highest of led suit. Trick winner leads next.',
    Player: 'Players bid once in turn with higher contracts over lower. Some contracts create a temporary partner via called ace or king; others are solo contracts. Winning bid determines trump suit and contract objective. Play 8 tricks with follow-suit required. If void in led suit, player may trump or discard. Highest trump wins trick; otherwise highest of led suit. Trick winner leads next.',
    objective: 'As bidder or bidder side, complete contract trick target; as defenders, set the contract.',
    gameplay: 'Players bid once in turn with higher contracts over lower. Some contracts create a temporary partner via called ace or king; others are solo contracts. Winning bid determines trump suit and contract objective. Play 8 tricks with follow-suit required. If void in led suit, player may trump or discard. Highest trump wins trick; otherwise highest of led suit. Trick winner leads next.',
    keyRules: [
      'Matador order is fixed: club queen highest, then seven of trump, then spade queen, followed by remaining trump hierarchy.',
      'Contracts form a ladder and determine target tricks, trump regime, and whether bidder plays alone or with called partner.',
      'Each player bids at most once per hand in the common four-player form.',
      'Settlement is by bid value transfer with optional table bonuses such as mackers and first-and-last.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '4 players in the core ruleset.',
      deck: '32-card stripped pack: A, K, Q, J, 10, 9, 8, 7 in each suit.',
      equipment: 'Score sheet or chips for bid-value settlement.',
      dealing: 'Deal 8 cards to each player, commonly in a 3-2-3 or 4-2-2 pattern.',
    },
    turnFlow: 'Players bid once in turn with higher contracts over lower. Some contracts create a temporary partner via called ace or king; others are solo contracts. Winning bid determines trump suit and contract objective. Play 8 tricks with follow-suit required. If void in led suit, player may trump or discard. Highest trump wins trick; otherwise highest of led suit. Trick winner leads next.',
    moveValidityConditions: {
      ante: 'German Solo uses contract settlement, not ante betting.',
      deal: 'Dealer action at hand start.',
      reveal_market: 'No market mechanic exists in German Solo.',
      buy_market: 'No market purchase mechanic exists in German Solo.',
      buy_stock: 'No stock buying mechanic exists in German Solo.',
      fold: 'Players do not fold after bidding; they complete all tricks.',
      check: 'No check action exists outside poker-style betting games.',
      call: 'No call action exists outside poker-style betting games.',
      bet: 'No per-turn betting; only pre-play contract bidding is used.',
      raise: 'No per-turn betting; only pre-play contract bidding is used.',
      declare: 'Only winning bidder may declare; called card must satisfy contract limits.',
      reveal_hand: 'No showdown reveal occurs; all cards are played in tricks.',
      award_pot: 'Resolution phase only.',
      play_card: 'Must follow led suit if able; otherwise may trump or discard.',
      draw: 'No draw phase exists after initial deal.',
      discard: 'Cards leave play only through tricks, not dedicated discard actions.',
      pass: 'Bidding phase only.',
      bid: 'One bid opportunity per player in core four-player cycle.',
      meld: 'German Solo has no meld declaration mechanic.',
      go_out: 'Hand ends after fixed trick count, not when a player goes out early.',
