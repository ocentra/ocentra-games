        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Yukon',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Yukon is a solitaire/patience card game similar to Klondike. 52 cards. 7 tableau columns. Key difference: can move ANY face-up card plus all cards covering it (no sequence required). No stock pile â€” all 52 cards dealt to tableau. Build foundations Aâ†’K by suit. Empty columns = Kings only.',
              },
              {
                type: 'paragraph',
                text: "Yukon is a patience (solitaire) card game using a single 52-card deck, in the Klondike family. Unlike Klondike, it has no stock; all 52 cards are dealt at the start into seven tableau columns, with the top five cards of each column face-up and the rest face-down. It is classified as a half-open packer. The game is documented in references such as Roya's Card Night (2021) and in solitaire literature; its exact origin and the reason for the Yukon name are not fully documented in the sources.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '52 cards. All dealt to 7 columns. No stock.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: '7 columns: col1=1 face-up. Cols 2-7: face-down cards + 5 face-up each.',
              },
            ],
          },
        ],
      },
