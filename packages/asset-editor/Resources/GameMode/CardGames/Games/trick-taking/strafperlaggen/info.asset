        rules: {
          objective: 'First player to reach zero points wins. Start with 9 points; deduct for winning a figure (Gleich, Hanger, Spiel); add penalty points (Strafpunkte) if you bet or hold and fail to win.',
          gameplay: 'Three players, seven cards each. Trump turned (acorns cannot be trumps). Four tricks needed to win Spiel. Players may bet on Gleich, Hanger or Spiel; opponents concede, hold or raise. Winner of Spiel begins the show to resolve Gleich and Hanger. Unbet figures scored in order: Spiel, Gleich, Hanger.',
          keyRules: [
            'Must follow suit or play trump; Perlaggen baptised when played.',
            'Bet or hold and lose adds 2 or 3 penalty points.',
            'Player with 1 point may not bet or raise.',
            'Blind betting allowed before cut.',
            'Acting out of turn or failing to show a figure adds 2-point penalty.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Use Perlaggs (Wilds) to complete figures. Bluffing is huge. Bet on a weak Hanger to scare opponents. If they fold, you win the point without showing.',
          intermediate: "The 'Weli' Usage: It's the permanent 2nd highest trump? No, Perlaggs have specific ranks. Know the hierarchy perfectly.",
          advanced: 'Straf-Calculation: Force opponents into bad bets. If they bet and lose, they get penalty points (Straf points).',
          tips: [
            'Never show your cards unless challenged.',
            'Silence is key.',
          ],
          hasPlaceholders: false,
        },
