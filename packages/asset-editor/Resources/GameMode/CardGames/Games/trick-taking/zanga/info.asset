    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Zanga',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Zanga is a Spanish trick-taking game related to Hombre/Tresillo. 4 players in 2 teams. 32-card Spanish deck. 8 each. Permanent trumps: Ace of Swords (highest), Ace of Clubs, King of Clubs. Trump chooser's team must win 5+ tricks. Winning all = bonus. Extra points for holding top 3+ trumps.",
              },
              {
                type: 'paragraph',
                text: 'Zanga is a four-player card game and a relative of Hombre and Tresillo. It is played in Spain in the region north of Malaga (Cuenca del Río Campanillas), in villages such as Villanueva de la Concepción, Almogía and Campanillas, and is also popular in the Canary Islands. The Malaga version uses a 32-card Spanish pack; the Canary Islands version uses the full 40-card pack with Tresillo-style ranking.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in two fixed partnerships; partners sit opposite each other.',
              },
              {
                type: 'paragraph',
                text: '32-card Spanish deck (40-card in Canary Islands version). Eight cards per player in the Malaga 32-card version.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: 'Eight cards are dealt to each player from the 32-card pack (Malaga version); ten each in the 40-card Canary Islands version.',
              },
            ],
          },
        ],
      },
