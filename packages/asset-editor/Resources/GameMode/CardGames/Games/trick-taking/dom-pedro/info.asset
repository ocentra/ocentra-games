    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Dom Pedro',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Dom Pedro (Pedro) is a trick-taking card game derived from Pitch. 4-7 players (often partnerships). 52-card deck, 9 dealt. Bid for trump suit. Key scoring cards: Right Pedro (5 of trumps)=5pts, Left Pedro (same-color 5)=5pts, High(A)=1, Low(2)=1, Jack=1, Game(10)=1. Total 14pts per hand. Left Pedro counts as trump. Play to 100.',
              },
              {
                type: 'paragraph',
                text: 'Pedro was developed in the United States in the nineteenth century as a variation of Pitch (All Fours). The trump 5 (Pedro) is worth five points; in Double Pedro or Cinch the other 5 of the same colour is also a trump. The game was extremely widely played in the US at the end of the nineteenth century and declined in the twentieth; it remains popular in the southern USA, West Coast, Louisiana, Nicaragua, and in Finland as Pidro.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4-7 (partnerships) players.',
              },
              {
                type: 'paragraph',
                text: '52 cards. 9 dealt. Left Pedro (same-color 5) is trump.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: '9 each. Discard to 6 after trump chosen.',
              },
            ],
          },
        ],
