        pages: [
          {
            title: 'KnÃ¼ffeln (Schafkopf Variant)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'KnÃ¼ffeln is a trick-taking card game from the Schafkopf family, played primarily in parts of Germany. It shares ancestry with Bavarian Schafkopf and related games like Doppelkopf. The game features the characteristic Schafkopf elements of trump suits, partnerships, and point-based scoring, with local variations that distinguish it from its better-known cousins.',
              },
              {
                type: 'paragraph',
                text: 'KnÃ¼ffeln developed from the broader Schafkopf tradition in Germany. The Schafkopf family dates back to the 18th century, with various regional variants developing across Bavaria and other German-speaking regions. KnÃ¼ffeln represents one of these local interpretations.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players, typically in partnerships (2 vs 2).',
              },
              {
                type: 'paragraph',
                text: '32-card deck (German-suited preferred: Acorns, Leaves, Hearts, Bells; or French: Clubs, Spades, Hearts, Diamonds). Cards rank: Ace/Sau, King, Ober/Queen, Unter/Jack, 10, 9, 8, 7.',
              },
              {
                type: 'paragraph',
                text: '32-card deck (German-suited preferred: Acorns, Leaves, Hearts, Bells; or French: Clubs, Spades, Hearts, Diamonds). Cards rank: Ace/Sau, King, Ober/Queen, Unter/Jack, 10, 9, 8, 7.',
              },
              {
                type: 'paragraph',
                text: 'Cards dealt to each player, typically 8 cards each in a 4-player game with 32 cards. Deal pattern varies by region (e.g., 3-2-3 or 4-4).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Bavarian Schafkopf: The most widely played version of Schafkopf with standardized rules.',
                  },
                  {
                    text: 'Doppelkopf: Popular variant using a double 48-card deck, primarily played in Northern Germany.',
                  },
                  {
                    text: 'Sheepshead (Schafkopf): American variant brought by German immigrants, popular in Wisconsin and surrounding areas.',
                  },
                ],
              },
            ],
          },
        ],
