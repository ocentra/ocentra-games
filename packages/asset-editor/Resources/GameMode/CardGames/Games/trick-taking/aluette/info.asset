          hasPlaceholders: false,
        },
        rules: {
          objective: 'Your team wins the point if one of you takes more tricks than any other single player; if tied, the first to have reached that trick count wins the point for the team.',
          gameplay: 'Left of dealer leads; no suit obligation. Highest card wins trick (ties = trick spoiled, same player leads again). Nine tricks. First to 3 tricks turns a card face up; first to 3 turns two up (to remember order for ties). Partners may signal by agreed gestures.',
          keyRules: [
            '48 cards; fixed ranking; no trumps; tricks not pooled by partnership',
            'Ties for high = spoiled trick; first to most tricks wins point for team',
            'Signals allowed; chanter optional (extra 6 cards each to two players, discard to 9)',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Last to play has advantage (voir venir); first two often play low, third may play high, fourth beats or spoils. Spoil to keep lead with partner.',
          intermediate: "Signal only when partner needs the information; avoid signalling when your hand is strong (helps opponents). Support partner's mordienne by spoiling and spreading tricks.",
          advanced: 'Surrender offer and mordienne commitment; announced mordienne (variant) extends match to 10 points.',
          tips: [
            'Learn the core trick-taking and fixed-rank tactics without using signals first, then layer in the traditional gesture system described in French rulebooks such as those by Rebour.',
          ],
          hasPlaceholders: false,
        },
