    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Aluette',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Aluette is a four-player French trick-taking game using a 48-card Spanish-suited pack with a fixed rank order where suits are irrelevant for trick strength.',
              },
              {
                type: 'paragraph',
                text: 'Aluette is associated with Vendee and the Brittany coast, with possible roots in late medieval Luettes or a later Spanish-merchant influence via Nantes.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four in two fixed partnerships, partners opposite. Deal and play clockwise.',
              },
              {
                type: 'paragraph',
                text: '48-card Spanish pack (A, K, Cavalier, Jack, 9, 8, 7, 6, 5, 4, 3, 2 in each suit) with Aluette fixed rank order.',
              },
              {
                type: 'paragraph',
                text: '48-card Spanish-suited pack (Aluette designs); optional score sheet.',
              },
              {
                type: 'paragraph',
                text: 'First dealer by deal-until-high-four (monsieur/madame vs borgne/vache); madame deals first. Nine cards each in batches of three; 12 left (optional chanter: 6 each to left of dealer and dealer, then each discards 6).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Chanter: If all agree, dealer and player to dealer's left each receive six extra cards and discard six back to nine-card hands.",
                  },
                  {
                    text: 'Announced Mordienne: Mordienne must be announced in advance and match may be played to 10 points.',
                  },
                ],
              },
            ],
          },
        ],
      },
