    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mariagenspiel (Mariage)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Mariagenspiel is the historical ancestor of the vast 'Marriage' family of card games, which includes global hits like Sixty-Six, Schnapsen, Pinochle, and Belote. Its name literally means 'Marriage Game', referring to the core mechanic: earning bonus points by holding and declaring a King and Queen of the same suit. It is a trick-taking game where players must balance the pursuit of card points with the opportunistic timing of their marriages.",
              },
              {
                type: 'paragraph',
                text: 'First appearing in French and German gaming books in the early 18th century (c. 1715). It set the standard for bonus-point declarations.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players. The game is played by two people; each receives six cards at the start. One card is turned face-up for trump (the seven of trumps may be exchanged for it). While the stock lasts, after each trick both players draw to refill to six cards.',
              },
              {
                type: 'paragraph',
                text: '32 cards: Ace, 10, King, Queen, Jack, 9, 8, 7.',
              },
              {
                type: 'paragraph',
                text: '32 cards: Ace, 10, King, Queen, Jack, 9, 8, 7.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 6 cards. One card is flipped to determine the Trump suit.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Three-hand Mariage: Three players; 36 cards; 5 cards each; replenish after each trick. Marriage bonuses paid by each opponent. First to reach target wins.',
                  },
                  {
                    text: 'Kreuzmariage (Cross Mariage): Four players, 8 cards each; last card to dealer sets trump. Melds declared at start in turn; winner has most card points; no matsch; slam earns 8 chips from each.',
                  },
                  {
                    text: 'Closing the stock: A player may close the stock (turn-up crosswise on stock) to try to win from hand; phase 2 rules apply immediately. If closer fails, opponent wins the deal.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
