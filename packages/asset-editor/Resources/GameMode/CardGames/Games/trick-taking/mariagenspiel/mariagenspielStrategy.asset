      {
        title: 'Tip',
        description: 'Keep the Ten of Trumps safe. It is worth 10 points and is second only to the Ace in power.',
      },
      {
        title: 'Tip',
        description: 'Last Trick: Winning the final trick is worth a bonus (usually 10 points). In a close game, this is often the tie-breaker.',
