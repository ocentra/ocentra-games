        pages: [
          {
            title: 'Calypso',
            subtitle: "Trinidad's Personal Trump Game",
            content: [
              {
                type: 'paragraph',
                text: "Calypso is an unusual trick-taking game for 4 players in fixed partnerships, invented in Trinidad in the 1940s. Each player has their own personal trump suit (one player has Spades, another Hearts, etc.). Players build 'Calypsos' â€” complete sequences of A-K-Q-J-10-9-8-7-6-5-4-3-2 in their own trump suit â€” by winning tricks and collecting the necessary cards. Completing a Calypso scores a major bonus.",
              },
              {
                type: 'paragraph',
                text: 'Calypso was invented in Trinidad around the 1940s. It gained international attention in the 1950s following promotion by bridge authority Ely Culbertson who championed it as a potential rival to Contract Bridge.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 in fixed partnerships (N-S vs E-W).',
              },
              {
                type: 'paragraph',
                text: '4 standard 52-card decks shuffled together (208 cards total).',
              },
              {
                type: 'paragraph',
                text: '4 standard 52-card decks. Score sheet.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 13 cards per deal. 4 deals per game.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Three-Player Calypso: Three players, each with own trump plus one suit shared as common trump. Rare variant.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Calypso is an unusual trick-taking game for 4 players in fixed partnerships, invented in Trinidad in the 1940s. Each player has their own personal trump suit (one player has Spades, another Hearts, etc.). Players build 'Calypsos' â€” complete sequences of A-K-Q-J-10-9-8-7-6-5-4-3-2 in their own trump suit â€” by winning tricks and collecting the necessary cards. Completing a Calypso scores a major bonus.",
