        rules: {
          objective: 'Score points by winning tricks and building Calypsos (complete trump suit sequences). First partnership to reach target score wins.',
          gameplay: '1. Deal 13 each (4 decks = 208 cards). 2. Each player has personal trump (one suit). 3. Left of dealer leads. 4. Follow suit or trump. 5. Trump beats non-trump. 6. Build Calypsos (complete A-K of your trump) from won tricks. 7. Surplus trump cards in tricks = 10 pts each at game end. 8. 4 deals; first to target wins.',
          keyRules: [
            'Each player has their own personal trump suit.',
            'Surplus duplicates of trump cards in hand cannot be added to a Calypso â€” only one of each rank needed.',
            "Cards won in tricks that don't contribute to your Calypso are worth 10 pts each at game end.",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Win tricks containing your trump suit cards. Lead from suits your partner is short in to create trump opportunities.',
          intermediate: 'Track which trump ranks you still need. Prioritise winning tricks containing missing Calypso cards over just winning tricks generally.',
          advanced: 'With 4 decks, each trump card appears 4 times â€” but you only need one of each rank. Feed surplus trump cards to partner trick-winners for their 10-pt value. Manage your 13-card hand to maintain coverage across all 4 suits.',
          tips: [
            'Your trump beats ALL non-personal-trump cards â€” use it aggressively when you need a specific rank.',
            'Completing even one Calypso (500 pts) can be decisive.',
          ],
          hasPlaceholders: false,
        },
