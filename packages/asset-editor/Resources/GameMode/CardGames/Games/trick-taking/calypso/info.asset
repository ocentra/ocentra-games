    historyContent: {
      origins: 'Calypso was invented in Trinidad around the 1940s. It gained international attention in the 1950s following promotion by bridge authority Ely Culbertson who championed it as a potential rival to Contract Bridge.',
      originCountries: [
        'Trinidad and Tobago',
      ],
      timeline: [
        '1940s: Invented in Trinidad.',
        '1950s: Promoted internationally, particularly in the UK and USA.',
        '1960s-present: A cult favourite among trick-taking enthusiasts.',
      ],
      evolution: 'The personal-trump concept is unique among widely played trick-taking games. Using four 52-card decks gives each player multiple copies of cards in their trump suit.',
      cultural: 'Named after the Trinidadian musical tradition. The game reflects Caribbean creativity in card game design.',
