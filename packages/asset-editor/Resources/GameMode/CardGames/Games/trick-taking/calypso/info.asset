    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'calypso',
    LLM: 'Game: Calypso. 4 decks (208 cards). 4 players in partnerships. Each player has personal trump: N=Spades, E=Hearts, S=Diamonds, W=Clubs. Complete A-K-Q-J-10-9-8-7-6-5-4-3-2 in your trump = Calypso (500 first, 250 later). Tricks=20pts each. Partial trump cards=10pts.',
    Player: "Your personal trump is Hearts. You've won: Aâ™¥, Kâ™¥, Qâ™¥, Jâ™¥, 10â™¥, 9â™¥ so far. You need 8â™¥, 7â™¥, 6â™¥, 5â™¥, 4â™¥, 3â™¥, 2â™¥ to complete your Calypso (worth 500 pts). Prioritise tricks that might contain these ranks.",
    tagline: 'Build your Calypso. Your trump is yours alone.',
    gameCategory: 'Trick-taking',
    subcategory: 'Partnership / Personal Trump',
    playerMode: 'multiplayer',
