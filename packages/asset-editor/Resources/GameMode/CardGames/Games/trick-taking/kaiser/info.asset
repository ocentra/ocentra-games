    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kaiser',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Kaiser is a beloved Canadian trick-taking game, historically popular in Saskatchewan and the Prairie provinces. Played by four players in partnerships, it uses a unique 32-card deck featuring two highly consequential cards: the 'Kaiser' (3 of Spades, worth -3 points) and the 'Bonus card' (5 of Hearts, worth +5 points). It is a game of high variance and strategic 'dumping' of negative points.",
              },
              {
                type: 'paragraph',
                text: "Originating in the Ukrainian-Canadian communities of Saskatchewan in the early 20th century. Its name and mechanics are likely related to European games like 'Skat' or 'Euchre' brought by Central European immigrants.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships.',
              },
              {
                type: 'paragraph',
                text: '32 cards: 7, 8, 9, 10, J, Q, K, A in all suits, BUT the 7 of Hearts is replaced by the 5 of Hearts (+5), and the 7 of Spades is replaced by the 3 of Spades (-3).',
              },
              {
                type: 'paragraph',
                text: '32 cards: 7, 8, 9, 10, J, Q, K, A in all suits, BUT the 7 of Hearts is replaced by the 5 of Hearts (+5), and the 7 of Spades is replaced by the 3 of Spades (-3).',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 8 cards. Dealing is clockwise.',
              },
            ],
          },
        ],
