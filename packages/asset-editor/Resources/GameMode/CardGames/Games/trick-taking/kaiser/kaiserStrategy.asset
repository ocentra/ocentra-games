      {
        title: 'Tip',
        description: "Watch your partner's discards carefully; if they play a high heart on your trick, they might be clearing a path for the 5 of Hearts.",
      },
      {
        title: 'Tip',
        description: 'Never lead the suit of a special card unless you are flushing it out or have the top card (Ace).',
