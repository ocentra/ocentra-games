    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pepper',
            subtitle: 'Bid Euchre',
            content: [
              {
                type: 'paragraph',
                text: 'Pepper is a Bid Euchre variant from Iowa and Ohio. 24 cards (9-A), right/left bowers. Bid 1-5, little pepper (6), or big pepper (6, doubled stakes). 4p partnerships, 6 cards each.',
              },
              {
                type: 'paragraph',
                text: 'Pepper is a Bid Euchre variant played in Iowa and Ohio, USA. The name derives from Hasenpfeffer (German for peppered hare), a term that appears in card-game books for a related bidding game. It uses a 24-card pack with right and left bowers, and bids from one to five plus little pepper (six tricks) and big pepper (six tricks, doubled stakes). The game is a regional Midwestern variant widely described in trick-taking and Euchre literature.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2, 3, or 4. 4p = partnerships.',
              },
              {
                type: 'paragraph',
                text: '24 cards. Rank: J (right), J (left), A, K, Q, 10, 9.',
              },
              {
                type: 'paragraph',
                text: '24-card pack.',
              },
              {
                type: 'paragraph',
                text: '6 each, one at a time. Clockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Opponent Penalty: Opponents penalised if they take 0 tricks; surrender option.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
