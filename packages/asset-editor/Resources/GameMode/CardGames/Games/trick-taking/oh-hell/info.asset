    "historyContent": {
      "origins": "Believed to have originated in the early 20th century (likely New York clubs), it is a member of the 'Bid Whist' and 'Skat' family but simplified for social play.",
      "originCountries": [
        "UK",
        "USA"
      ],
      "timeline": [
        "1930: First published mention in America.",
        "1936: Listed in official card game manuals as 'Oh Well!'.",
        "1950s: Becomes a staple of 'College Card Games' under many names (Oh Pshaw, Blackout).",
        "Present: One of the most common introductory games for competitive bidding logic."
      ],
      "evolution": "The game's name was frequently censored to 'Oh Well' or 'Oh Heck' in family editions.",
      "cultural": "Known by dozens of local names: Up and Down the River, Estimation, 10-Down, and German Bridge."
    },
    "setupContent": {
