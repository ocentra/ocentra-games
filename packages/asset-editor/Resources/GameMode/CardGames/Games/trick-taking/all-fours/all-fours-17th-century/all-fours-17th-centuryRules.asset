    icon: '🃏',
  },
  data: {
    LLM: 'Deal six cards each in packets of three and turn up the next card for proposed trump. If the non-dealer accepts, play proceeds. If the non-dealer begs, the dealer either gifts one point and throws in the hand immediately, or runs cards by dealing three more each and turning again until trump suit changes. In trick play, players may always play trump, but cannot play off-suit non-trump when able to follow suit. Highest trump wins; if no trump is played, highest of led suit wins. After play, score points in order High, Low, Jack, Game.',
    Player: 'Deal six cards each in packets of three and turn up the next card for proposed trump. If the non-dealer accepts, play proceeds. If the non-dealer begs, the dealer either gifts one point and throws in the hand immediately, or runs cards by dealing three more each and turning again until trump suit changes. In trick play, players may always play trump, but cannot play off-suit non-trump when able to follow suit. Highest trump wins; if no trump is played, highest of led suit wins. After play, score points in order High, Low, Jack, Game.',
    objective: 'Be first to the agreed game total (commonly 11) by collecting High, Low, Jack, and Game points.',
    gameplay: 'Deal six cards each in packets of three and turn up the next card for proposed trump. If the non-dealer accepts, play proceeds. If the non-dealer begs, the dealer either gifts one point and throws in the hand immediately, or runs cards by dealing three more each and turning again until trump suit changes. In trick play, players may always play trump, but cannot play off-suit non-trump when able to follow suit. Highest trump wins; if no trump is played, highest of led suit wins. After play, score points in order High, Low, Jack, Game.',
    keyRules: [
      'High (1 pt): Held by the player dealt the highest trump.',
      'Low (1 pt): Held by the player dealt the lowest trump.',
      'Jack (1 pt): Awarded to the player who WINS the Jack of trumps in a trick.',
      "Game (1 pt): Awarded to the player with the highest 'pip' total in their captured tricks (Ace=4, King=3, Queen=2, Jack=1, 10=10).",
      'A gift after a beg ends the hand immediately and deals pass.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
