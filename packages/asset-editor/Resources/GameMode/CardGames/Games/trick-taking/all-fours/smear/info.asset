    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Smear',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Smear (also spelled 'Schmier' or 'Schmear') is a card game played in the northern Midwest of the USA (Minnesota, Wisconsin), closely related to Pitch and High-Low-Jack. It is a trick-taking game typically played with 4 players in partnerships. The objective is to score points for High, Low, Jack, and Game (the 'Smear'), with bids usually starting at 2 or 3. The term 'Smear' also refers to the act of playing a high-point card (like a 10 or Ace) on a partner's winning trick.",
              },
              {
                type: 'paragraph',
                text: "Derived from All Fours and Pitch, with a focus on team play and aggressive point-dumping (smearing). The name comes from the German word 'schmieren' (to grease or bribe).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in fixed partnerships, partners sitting opposite each other. Some variants use six players in two teams of three or three players without partners.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack; cards in each suit rank A, K, Q, J, 10 down to 2. Some variants use a 54-card pack with one or two jokers as extra trumps, or a stripped 32-card deck (A-K-Q-J-10-9-8-7 per suit).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack; cards in each suit rank A, K, Q, J, 10 down to 2. Some variants use a 54-card pack with one or two jokers as extra trumps, or a stripped 32-card deck (A-K-Q-J-10-9-8-7 per suit).',
              },
              {
                type: 'paragraph',
                text: 'Deal 6 cards each. Bidding starts left of dealer.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Ten Point Smear: 10 points per hand with Jick (left bower) and two jokers; bids 4 to 10; played to 52. Four, five, or six players.',
                  },
                  {
                    text: 'Wisconsin Six Point: 32-card deck (A-K-Q-J-10-9-8-7) plus two jokers; 6 points; low to holder of lowest trump other than joker; target usually 21.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
