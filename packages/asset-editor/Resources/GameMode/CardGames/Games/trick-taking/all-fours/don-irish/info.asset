    historyContent: {
      origins: "Don is derived from the older game Dom Pedro, which was popular in Ireland and America in the 19th century. In Ireland, the name was shortened to 'Don'.",
      originCountries: [
        'Ireland',
      ],
      timeline: [
        '1800s: Dom Pedro gains popularity in Ireland and the US.',
        'Late 1800s: Irish players shorten the name to Don and refine the scoring to include higher values for Nines.',
        'Modern Era: Remains a staple pub game in Ireland and is famously played in Irish correctional facilities.',
      ],
      evolution: "Irish Don is distinguished from the British 'Nine-Card Don' by its 13-card deal (using the full deck) and more aggressive scoring for the Nine of trumps.",
      cultural: "Highly social and competitive, often played for 'legs' (games) in a match.",
    },
