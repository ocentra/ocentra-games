        notes: 'Turn card to propose trump suit.',
      },
      {
        id: 'beg_or_stand',
        label: 'Eldest Decision',
        actor: 'current_player',
        legalActions: [
          'pass',
          'bid',
        ],
        nextPhase: null,
        isMandatory: true,
        loopIndex: null,
        totalLoops: null,
        conditionalNext: [
          {
            condition: "action == 'pass'",
            nextPhase: 'trick_play',
          },
          {
            condition: "action == 'bid'",
            nextPhase: 'dealer_response',
          },
        ],
        cardVisibilityChanges: {},
        notes: 'Eldest hand stands or begs.',
      },
      {
        id: 'dealer_response',
        label: 'Gift or Run Cards',
        actor: 'dealer',
        legalActions: [
          'check',
          'deal',
          'reveal_market',
        ],
        nextPhase: null,
        isMandatory: true,
        loopIndex: null,
        totalLoops: null,
        conditionalNext: [
          {
            condition: "action == 'check'",
            nextPhase: 'trick_play',
          },
          {
            condition: "action == 'deal' && trump_changed == false",
            nextPhase: 'dealer_response',
          },
          {
            condition: "action == 'deal' && trump_changed == true",
            nextPhase: 'discard_after_run',
          },
        ],
        cardVisibilityChanges: {},
        notes: 'Gift gives one point to opponents and play continues; run-cards adds 3 each and turns again until suit changes.',
      },
