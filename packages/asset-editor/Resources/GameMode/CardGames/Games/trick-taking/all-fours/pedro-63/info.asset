    historyContent: {
      origins: "Developed in the late 19th-century American South and West as part of the 'All Fours' family of games. The 63-point variant specifically evolved to make bidding more granular and exciting.",
      originCountries: [
        'USA',
        'Canada',
      ],
      timeline: [
        '1880s: Basic Pedro is popularized in gold-rush mining camps.',
        "1910s: The '63' point system is formalized by inflating the King and Nine values.",
        '1950s: Becomes a staple in rural community halls across the Midwest.',
        'Present: Maintained as a competitive league game in specific regional pockets of the US and Canada.',
      ],
      evolution: "The 'Left Pedro' (the 5 of the OTHER suit of the same color) is a unique mechanic shared with games like Euchre, making the trump suit mathematically larger than others.",
      cultural: "Regarded as the 'Gambler's Bridge' because of the rapid point accumulation and the potential for a single hand to swing the entire game score.",
    },
