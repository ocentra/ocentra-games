            nextPhase: 'dealer_response',
          },
        ],
        cardVisibilityChanges: {},
        notes: "Player on dealer's right stands or begs.",
      },
      {
        id: 'dealer_response',
        label: 'Take One or Run Cards',
        actor: 'dealer',
        legalActions: [
          'check',
          'deal',
          'reveal_market',
        ],
        nextPhase: null,
        isMandatory: true,
        loopIndex: null,
        totalLoops: null,
        conditionalNext: [
          {
            condition: "action == 'check'",
            nextPhase: 'trick_play',
          },
          {
            condition: "action == 'deal' && trump_changed == false",
            nextPhase: 'dealer_response',
          },
          {
            condition: "action == 'deal' && trump_changed == true",
            nextPhase: 'trick_play',
          },
        ],
        cardVisibilityChanges: {},
        notes: 'Take one gifts one point to opponents; run-cards deals 3 each and turns again until suit changes.',
