    icon: '🃏',
  },
  data: {
    LLM: 'The pitcher leads to the first trick; the suit led becomes trump for the hand. Players must follow suit if able, otherwise may play any card. Highest card of led suit wins unless trump is played, then highest trump wins. Trick winner leads next trick. Points are pegged during play for certain trump cards and all fives; after all 13 tricks, card points are counted and the player with highest total pegs the Eight bonus.',
    Player: 'The pitcher leads to the first trick; the suit led becomes trump for the hand. Players must follow suit if able, otherwise may play any card. Highest card of led suit wins unless trump is played, then highest trump wins. Trick winner leads next trick. Points are pegged during play for certain trump cards and all fives; after all 13 tricks, card points are counted and the player with highest total pegs the Eight bonus.',
    objective: 'Avoid winning tricks that contain point-bearing cards. The first player to reach 121 points loses the match.',
    gameplay: 'The pitcher leads to the first trick; the suit led becomes trump for the hand. Players must follow suit if able, otherwise may play any card. Highest card of led suit wins unless trump is played, then highest trump wins. Trick winner leads next trick. Points are pegged during play for certain trump cards and all fives; after all 13 tricks, card points are counted and the player with highest total pegs the Eight bonus.',
    keyRules: [
      'Trump is not preselected: it is set by the suit of the first card led by the pitcher.',
      'A 13-card dummy hand is out of play each deal and can contain scoring cards.',
      'If pegging from a trick takes a player to 121 or more, the game ends immediately and that player loses.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '3 players, playing individually.',
      deck: 'Standard 52-card deck. Rank high to low: A K Q J 10 9 8 7 6 5 4 3 2.',
      equipment: 'Score pegs or cribbage board lanes are commonly used.',
      dealing: 'Dealer deals four clockwise 13-card hands one card at a time: pitcher, next player, dealer, and a dummy hand. The dummy hand is set aside face down as sleeping cards.',
    },
    turnFlow: 'The pitcher leads to the first trick; the suit led becomes trump for the hand. Players must follow suit if able, otherwise may play any card. Highest card of led suit wins unless trump is played, then highest trump wins. Trick winner leads next trick. Points are pegged during play for certain trump cards and all fives; after all 13 tricks, card points are counted and the player with highest total pegs the Eight bonus.',
