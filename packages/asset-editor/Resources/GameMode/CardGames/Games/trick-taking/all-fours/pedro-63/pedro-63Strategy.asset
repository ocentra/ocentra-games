    tips: [
      {
        title: 'Tip',
        description: "The 'Left Pedro' (the other 5 of the same color) counts as a trump for all purposes. Treat it as a middle-tier trump card.",
      },
      {
        title: 'Tip',
        description: "Don't forget the 'Two'. Even though it's worth only 1 point, the team that captures the actual card 'The Deuce' earns the point, regardless of who wins the trick.",
      },
