        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'All Fours (Trinidad)',
            subtitle: 'The Soul of the Caribbean',
            content: [
              {
                type: 'paragraph',
                text: "All Fours, colloquially known as 'All Foes', is the national card game of Trinidad and Tobago. It is a highly competitive, anti-clockwise partnership game where 'hanging the Jack' (capturing the opponent's Jack) is considered the ultimate tactical victory.",
              },
              {
                type: 'paragraph',
                text: 'Brought to the Caribbean by English colonial administrators, the game took deep root in Trinidadian culture, evolving from a simple tavern game into a sophisticated sport with national tournaments.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two partnerships (sitting opposite).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace is high.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, 14-point pegboard.',
              },
              {
                type: 'paragraph',
                text: 'Deal and play are STRICTLY anti-clockwise. Each player receives 6 cards (usually dealt 3 at a time). The 25th card is turned up for trumps.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Tobago Variety: Turning a Six of trumps only counts for 1 point instead of 2 in some local house rules.',
                  },
                  {
                    text: 'No Undertrumping: Rules requiring that if you trump, you must beat any existing trump on the trick if possible.',
                  },
                ],
              },
            ],
          },
        ],
      },
