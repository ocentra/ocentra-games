    historyContent: {
      origins: 'Brought to the Caribbean by English colonial administrators, the game took deep root in Trinidadian culture, evolving from a simple tavern game into a sophisticated sport with national tournaments.',
      originCountries: [
        'England',
        'Trinidad and Tobago',
      ],
      timeline: [
        '1800s: Traditional English All Fours is introduced to Trinidad.',
        'Early 1900s: Rules shift to an anti-clockwise direction and a 14-point target.',
        'Present: A central part of social life, played in community centers and sanctioned leagues across the island.',
      ],
      evolution: "The most significant Caribbean innovations were the 'Hang Jack' bonus (3 points) and the immediate scoring of turn-up cards (Ace, Six, Jack).",
      cultural: "All Fours in Trinidad is noted for its high-tension atmosphere and loud, physical card-playing style (often 'slamming' cards for emphasis).",
    },
