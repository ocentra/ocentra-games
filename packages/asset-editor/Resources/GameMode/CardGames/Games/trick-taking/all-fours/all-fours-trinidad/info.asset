        setup: {
          players: '4 players in two partnerships (sitting opposite).',
          deck: 'Standard 52-card deck. Ace is high.',
          equipment: 'Standard deck, 14-point pegboard.',
          dealing: 'Deal and play are STRICTLY anti-clockwise. Each player receives 6 cards (usually dealt 3 at a time). The 25th card is turned up for trumps.',
          hasPlaceholders: false,
        },
        rules: {
          objective: 'Be first to 14 or more points by combining turn-up bonuses with High, Low, Jack, and Game.',
          gameplay: "1. **Trump Bonus**: If the turned-up card is an Ace (1 pt), Six (2 pts), or Jack (3 pts), the dealer's team scores immediately. 2. **The Beg**: The player to the dealer's right (Eldest) chooses to 'Stand' or 'Beg'. 3. **The Gift/Run**: If they beg, dealer can gift 1 point to opponents or 'Run the cards' (deal 3 more and flip new trump). Score again for new A/6/J. 4. **Trick Play**: Follow suit or trump. 5. **Counting Out**: Points are scored in order: High, Low, Jack, Game.",
          keyRules: [
            'High (1 pt): Team dealt the highest trump.',
            'Low (1 pt): Team dealt the lowest trump.',
            'Jack (1 pt): Winning a trick with the Jack of trumps.',
            "Hang Jack (3 pts): Winning a trick containing an opponent's Jack of trumps.",
            'Game (1 pt): Team with most card pips (A=4, K=3, Q=2, J=1, 10=10).',
            'Direction: Dealing, play, and turn-order are all anti-clockwise.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Prioritize capturing the 10s of any suit; they are the fastest way to win the 'Game' point.",
          intermediate: "The Lead: If your partner has the High trump (Ace), lead a small trump to 'pull' the opponent's trumps and expose their Jack.",
          advanced: "Hanging the Jack: High-level play revolves around detecting who holds the Jack. If you suspect an opponent has a 'lone' Jack, lead an Ace of trumps immediately to 'Hang' it for 3 points.",
          tips: [
            "Never lead the Jack unless you are 100% sure it will win. It's a 3-point liability.",
            'The 6 of trumps is a key swing card because it can score as a turn-up bonus and still matter in trick control.',
          ],
          hasPlaceholders: false,
        },
