    aiContent: {
      difficulty: {
        easy: "Doesn't realize 'Low' can be won or lost based on tricks. Plays high cards randomly.",
        medium: "Attempts to capture the Jack. Understands that the Pitcher's first suit is trumps and adjusts hand evaluation after the lead.",
        hard: "Collaborates with partner by tracking card-counts. Saves high trumps specifically to capture the 'Low' if an opponent attempts to 'bleed' it.",
      },
      considerations: [
        "AI must factor in the 'Low point trick win' rule, which differs from standard All Fours.",
        "Partner-blindness must be simulated for the Pitch phase (partner doesn't know cards until pitch is made).",
      ],
    },
