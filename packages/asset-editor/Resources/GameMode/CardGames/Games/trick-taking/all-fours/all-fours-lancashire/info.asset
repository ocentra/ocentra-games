    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'All Fours (Lancashire)',
            subtitle: "Blackburn's Choice",
            content: [
              {
                type: 'paragraph',
                text: "All Fours as played in Lancashire, England (notably Blackburn and the Ribble Valley), is a partnership variant that removes the 'Begging' phase found in the classic game. Instead, the leader (Pitcher) determines trumps directly, and the 'Low' point is earned by capturing the card, rather than simply having it dealt.",
              },
              {
                type: 'paragraph',
                text: "Part of the North of England's deep-rooted pub game culture. While Yorkshire developed its own league standards, Lancashire refined the 'Low' rule to make the game more aggressive and trick-focused.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace is high.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, All Fours pegging board (traditionally to 11 points).',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 6 cards in batches of 2 or 3. No card is turned up for trumps.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Lancashire League Rules: Strict enforcement of the 11-point target and specific 'Red/Black' guessing protocols for first pitch.",
                  },
                ],
              },
            ],
          },
        ],
      },
