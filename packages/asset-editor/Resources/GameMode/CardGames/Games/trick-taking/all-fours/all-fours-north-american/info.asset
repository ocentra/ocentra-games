    aiContent: {
      difficulty: {
        easy: "Fails to discard effectively after a run. Never 'gifts' a point as dealer.",
        medium: 'Understands the value of the 10 for the Game point. Begs when having no trumps.',
        hard: "Simulates the 'Low' trump probability. As dealer, accurately judges whether to 'Gift' or 'Run' based on the opponent's current score (avoiding gifting a winning 7th point).",
      },
      considerations: [
        "AI must factor in the 'discard to 6' logic as a optimization problem.",
        "The 7-point limit creates a 'tight' endgame where every gift is a major decision.",
      ],
    },
