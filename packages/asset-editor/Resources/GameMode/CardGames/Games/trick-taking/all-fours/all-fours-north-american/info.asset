    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'All Fours (North American)',
            subtitle: 'The American Frontier Classic',
            content: [
              {
                type: 'paragraph',
                text: "North American All Fours, widely known in the 19th century as Seven Up or Old Sledge, is the classic American iteration of the English game. It introduced the 'Seven point' target and refined the 'Discarding' mechanic when the cards are run, making it a faster and more tactical game than its 17th-century ancestor.",
              },
              {
                type: 'paragraph',
                text: "Brought to America by English settlers, All Fours became the most popular card game in the US before the rise of Poker and Bridge. It was famously played by Abraham Lincoln and documented as the primary 'gambling game' of the frontier.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 or 4 (Partnerships opposite each other).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace is high.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, 7 chips per player/team for scoring.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives 6 cards to each player (traditionally 3 at a time). The 13th card is turned up for trumps.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Old Sledge: The exact same game but historically played to 9 or 11 points in some localized areas.',
                  },
                  {
                    text: 'Blind All Fours: No card is turned; the first card led by the Eldest hand sets the trumps.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
