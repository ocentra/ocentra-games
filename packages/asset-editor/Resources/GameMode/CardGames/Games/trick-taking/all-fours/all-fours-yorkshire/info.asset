        pages: [
          {
            title: 'All Fours (Yorkshire)',
            subtitle: 'Tap Room Tradition',
            content: [
              {
                type: 'paragraph',
                text: "West Yorkshire All Fours is a cherished pub league tradition in Northern England, particularly centered in the Heavy Woollen District (Batley, Heckmondwike). Unlike the classic game, it uses a 'Pitch' start with no turn-up card and features unique regional etiquette such as the 'First Trick Face Up' rule.",
              },
              {
                type: 'paragraph',
                text: 'Rooted in the industrial heartlands of Yorkshire, the game evolved alongside the textile mills. It became a formalized league sport in the mid-20th century.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace is high.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, All Fours pegging board (traditionally to 11 points).',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 6 cards in batches of 3. No card is turned for trump.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Heckmondwike League Standard: Played to 15 points instead of 11 to allow for longer, more strategic matches.',
                  },
                ],
              },
            ],
          },
        ],
