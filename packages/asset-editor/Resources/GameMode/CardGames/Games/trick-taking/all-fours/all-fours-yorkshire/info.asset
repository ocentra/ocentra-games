    aiContent: {
      difficulty: {
        easy: "Doesn't understand the 'no trumps no count' rule. Fails to protect Tens.",
        medium: 'Understands the importance of the first-trick face-up trump. Tracks basic pip-counts.',
        hard: "Collaborates across the partnership. Uses the 'Throw-in' to negate the opponents' momentum. Calculates optimal pitch suits based on partner's potential strength.",
      },
      considerations: [
        "AI must factor in the specific Yorkshire 'Low-to-Holder' rule.",
        'The throw-in option should only trigger during play when the player is not currently winning the trick.',
      ],
    },
