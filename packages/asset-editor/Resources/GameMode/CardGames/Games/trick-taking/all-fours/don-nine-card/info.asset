  data: {
    hero: {
      title: 'Nine-Card Don',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Nine-Card Don',
            subtitle: 'Trick-taking rules and play flow',
            content: [
              {
                type: 'paragraph',
                text: 'Nine-Card Don (also known as Big Don or Welsh Don) is a traditional British pub game for four players in fixed partnerships. It is a descendant of the 17th-century game All Fours. Unlike the Irish version, only nine cards are dealt to each player, leaving a significant portion of the deck unseen, which adds a layer of uncertainty and boneyard-tracking to the strategy.',
              },
              {
                type: 'paragraph',
                text: 'Don evolved from Dom Pedro in the 19th century. While Ireland developed the 13ndcard version, British players in Cheshire, Lancashire, and South Wales standardized the 9ndcard version.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships (2 vs 2).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck (only 36 cards are dealt).',
              },
              {
                type: 'paragraph',
                text: '52-card deck, peg board.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 9 cards (dealt in batches of 3). The remaining 16 cards are set aside and not used in the hand.',
              },
            ],
          },
        ],
      },
    ],
