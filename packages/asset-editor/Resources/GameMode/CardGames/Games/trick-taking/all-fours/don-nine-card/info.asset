          hasPlaceholders: false,
        },
        rules: {
          objective: "Reach 121 points by capturing scoring cards and winning the 'Game' point.",
          gameplay: "1. The Pitch: The player to the dealer's left leads a card. The suit of this card is the trump suit.\n2. Trick Play: Players must follow suit if possible. In strict All Fours tradition, some leagues allow 'playing a trump' even if you have the led suit.\n3. Card Ranking: A (high) K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2.",
          keyRules: [
            "Only the 36 dealt cards are scored for the 'Game' point.",
            "Fives are often called 'Don cards' or 'Pedros'.",
            "Winning the 'Low' point requires tracking the lowest trump seen in play.",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Identify the trump suit quickly and secure your 5ndpoint cards (all 5s regardless of suit) as soon as your team wins a trick.',
          intermediate: 'Since 16 cards are missing, do not assume high trumps like the King or Queen are in play. If you hold the Jack, it might be the highest trump.',
          advanced: 'Bidding/Pitching Strategy: Pitch a suit where you hold a 5 to secure immediate points, or pitch a suit where you have a void to allow your partner to trump in.',
          tips: [
            "All 5s are high-value targets. Don't waste them on tricks your partner can't win.",
            "The 'Game' point is decided by the 10s and Aces; try to capture these even if they don't provide immediate pegging points.",
          ],
          hasPlaceholders: false,
        },
