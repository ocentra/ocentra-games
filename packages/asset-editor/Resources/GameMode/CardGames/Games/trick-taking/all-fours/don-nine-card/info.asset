    historyContent: {
      origins: 'Don evolved from Dom Pedro in the 19th century. While Ireland developed the 13ndcard version, British players in Cheshire, Lancashire, and South Wales standardized the 9ndcard version.',
      originCountries: [
        'United Kingdom',
      ],
      timeline: [
        '1800s: All Fours variations like Dom Pedro spread through the UK.',
        "Early 20th Century: The 9-card version becomes a staple in industrial pub culture (the 'Black Country' and Welsh mining valleys).",
        'Modern Era: Maintained by dedicated leagues such as the Bolton Don League and the Abercarn Crib & Don League.',
      ],
      evolution: "The game is uniquely characterized by the immediate scoring ('pegging') of fives and trumps during play.",
      cultural: 'Used as a major social catalyst in the British regimental system and workingndclass social clubs.',
    },
    setupContent: {
      players: '4 players in fixed partnerships (2 vs 2).',
