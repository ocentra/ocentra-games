    historyContent: {
      origins: 'Game to Lose is documented as a West Midlands three-player reverse form of Chaser (Nine Card Don family).',
      originCountries: [
        'England',
      ],
      timeline: [
        'Traditional Don and Chaser variants were widely played in English pub culture.',
        'Game to Lose emerged as a local reverse-scoring adaptation for three active players.',
        'Published modern rules preserve the crib-board race-to-lose format.',
      ],
      evolution: 'The main innovation is inversion of value: cards that would normally be desirable become penalties.',
      cultural: 'It belongs to the local Midlands all-fours and Don orbit of pub and workplace card games.',
    },
    setupContent: {
      players: '3 players, playing individually.',
      deck: 'Standard 52-card deck. Rank high to low: A K Q J 10 9 8 7 6 5 4 3 2.',
      equipment: 'Score pegs or cribbage board lanes are commonly used.',
      dealing: 'Dealer deals four clockwise 13-card hands one card at a time: pitcher, next player, dealer, and a dummy hand. The dummy hand is set aside face down as sleeping cards.',
    },
    variationsContent: {
      list: [
        {
          id: 'tie_for_eight_house_rule',
          name: 'Tie for Eight',
          description: 'If two players tie for highest post-play card points, each pegs 4 instead of one player pegging 8.',
        },
      ],
      noVariationsReason: '',
