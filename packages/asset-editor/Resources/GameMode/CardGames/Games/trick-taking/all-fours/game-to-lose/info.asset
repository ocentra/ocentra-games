    routePath: 'game-to-lose',
    LLM: "Game: Game to Lose. Three active players plus one hidden dummy hand. Pitcher's first lead sets trump. Follow suit if possible. Immediate point pegs apply for specific trump honors and fives; post-play card count awards the Eight bonus.",
    Player: 'Game to Lose: take as few penalty points as possible and never be first to 121.',
    tagline: 'Avoid points, avoid tricks, avoid being first to 121.',
    gameCategory: 'Trick-taking',
