    aiContent: {
      difficulty: {
        easy: 'Overwins tricks and fails to avoid high-penalty cards.',
        medium: 'Tracks trump penalty cards and avoids unnecessary trick control.',
        hard: 'Balances immediate peg-risk and end-of-hand Eight risk while steering near-121 opponents into losses.',
      },
      considerations: [
        'Evaluation is inverse to normal trick-taking: taking point cards is usually bad.',
        'Both in-play pegging and end-of-hand Eight pegging must be modeled together.',
      ],
    },
