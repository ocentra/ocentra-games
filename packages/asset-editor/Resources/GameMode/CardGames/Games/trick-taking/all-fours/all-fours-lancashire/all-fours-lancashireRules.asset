    icon: '🃏',
  },
  data: {
    LLM: "1. **The Pitch**: The player to the dealer's left (the Pitcher) leads any card. The suit of this card immediately becomes trumps for the hand. 2. **Trick Play**: Follow suit if possible. You may trump instead of following suit, even if you hold a card of the led suit. 3. **The 'Low' Hunt**: Unlike other variants, the 'Low' point is awarded to the team that WINS the trick containing the lowest trump card that was dealt in that hand. 4. **Scoring Order**: Points are counted and pegged in the following order: High, Low, Jack, Game.",
    Player: "1. **The Pitch**: The player to the dealer's left (the Pitcher) leads any card. The suit of this card immediately becomes trumps for the hand. 2. **Trick Play**: Follow suit if possible. You may trump instead of following suit, even if you hold a card of the led suit. 3. **The 'Low' Hunt**: Unlike other variants, the 'Low' point is awarded to the team that WINS the trick containing the lowest trump card that was dealt in that hand. 4. **Scoring Order**: Points are counted and pegged in the following order: High, Low, Jack, Game.",
    objective: 'First partnership to 11 points by scoring High, Low (taken), Jack, and Game.',
    gameplay: "1. **The Pitch**: The player to the dealer's left (the Pitcher) leads any card. The suit of this card immediately becomes trumps for the hand. 2. **Trick Play**: Follow suit if possible. You may trump instead of following suit, even if you hold a card of the led suit. 3. **The 'Low' Hunt**: Unlike other variants, the 'Low' point is awarded to the team that WINS the trick containing the lowest trump card that was dealt in that hand. 4. **Scoring Order**: Points are counted and pegged in the following order: High, Low, Jack, Game.",
    keyRules: [
      'High (1 pt): Awarded to the team of the player dealt the highest trump.',
      'Low (1 pt): Awarded to the team that WINS the trick containing the lowest trump card dealt.',
      'Jack (1 pt): Awarded to the team that WINS the trick containing the Jack of trumps.',
      "Game (1 pt): Awarded to the team with the most 'pips' in their captured tricks (Ace=4, King=3, Queen=2, Jack=1, 10=10).",
      "Pitcher's partner must not look at their cards until the first card (The Pitch) is led.",
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
