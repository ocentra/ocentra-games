        nextPhase: 'trick_play',
        isMandatory: true,
        loopIndex: null,
        totalLoops: null,
        conditionalNext: [
          {
            condition: 'all_cards_played == true',
            nextPhase: 'settlement',
          },
        ],
        cardVisibilityChanges: {
          play_card: 'face_up',
        },
        notes: 'Non-dealer leads first trick; winner leads next.',
