        legalActions: [
          'pass',
          'bid',
        ],
        nextPhase: null,
        isMandatory: true,
        loopIndex: null,
        totalLoops: null,
        conditionalNext: [
          {
            condition: "action == 'pass'",
            nextPhase: 'trick_play',
          },
          {
            condition: "action == 'bid'",
            nextPhase: 'dealer_response',
          },
        ],
        cardVisibilityChanges: {},
        notes: 'Non-dealer accepts trump or begs for a new suit.',
      },
      {
        id: 'dealer_response',
        label: 'Gift or Run',
        actor: 'dealer',
        legalActions: [
          'check',
          'deal',
          'reveal_market',
        ],
        nextPhase: null,
        isMandatory: true,
        loopIndex: null,
        totalLoops: null,
        conditionalNext: [
          {
            condition: "action == 'check'",
            nextPhase: 'settlement',
          },
          {
            condition: "action == 'deal' && trump_changed == false",
            nextPhase: 'dealer_response',
          },
          {
            condition: "action == 'deal' && trump_changed == true",
            nextPhase: 'trick_play',
          },
        ],
        cardVisibilityChanges: {},
        notes: 'Dealer either gifts one point and throws in hand, or runs cards (3 each + new turn-up) until suit changes.',
      },
