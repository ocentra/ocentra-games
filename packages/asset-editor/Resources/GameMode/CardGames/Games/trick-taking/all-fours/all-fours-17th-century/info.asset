    aiContent: {
      difficulty: {
        easy: "Never begs. Ignores the 'Game' value of Tens, focusing only on winning tricks.",
        medium: 'Begs if they have no cards in the trump suit. Tries to play 10s on their own winning tricks.',
        hard: "Tracks which player has likely been dealt the 'Low' trump. Calculates if running the cards is beneficial based on current point spread.",
      },
      considerations: [
        "AI must understand the 'Gift or Run' choice from the dealer's perspective.",
        'The order of points (High/Low/Jack/Game) must be prioritized in the search tree for win-condition checking.',
      ],
    },
