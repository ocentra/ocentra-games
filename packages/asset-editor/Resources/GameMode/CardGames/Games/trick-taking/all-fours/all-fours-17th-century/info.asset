    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 2,
    routePath: 'all-fours-17th-century',
    LLM: 'Game: All Fours (1674). Type: point-trick. Players: 2. Flow: deal 6 each, reveal trump, non-dealer pass or beg, dealer gift-or-run, then trick play if not thrown in. Score High->Low->Jack->Game; target 11.',
    Player: 'Welcome to 17th-Century All Fours. You get six cards, then may accept trump or beg for a change. If dealer gifts, the hand ends; otherwise trick play decides High, Low, Jack, and Game points.',
    tagline: 'The game that conquered the pubs of Kent and the saloons of America.',
    gameCategory: 'Trick-taking',
    subcategory: 'Classic Point-scoring',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '15-30 minutes',
    origin: 'England (Kent)',
    originName: 'All Fours (17th Century English rules)',
    deck: 'Standard 52-card deck',
    alsoKnownAs: [
      'Old Sledge (Original)',
      'Seven Up (Original)',
      'High-Low-Jack (Historical)',
    ],
