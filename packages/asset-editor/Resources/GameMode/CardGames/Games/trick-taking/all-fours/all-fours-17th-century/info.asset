    historyContent: {
      origins: "All Fours originated in Kent, England, and was famously denounced as a 'common' or 'vulgar' game by high society, despite its deep tactical complexity.",
      originCountries: [
        'England',
      ],
      timeline: [
        "1674: First published rules in Charles Cotton's 'The Compleat Gamester'.",
        "1700s: Spreads to the American colonies, becoming the progenitor of 'Pitch' and 'Old Sledge'.",
        "1800s: Evolution into 'Seven Up' in the United States.",
      ],
      evolution: 'The 17th-century rules are strictly for 2 players. Later 19th-century variants added partnership play and expanded the scoring targets.',
      cultural: "Cotton noted the game was 'much played in Kent' and characterized it by the 'Begging' for trumps.",
    },
    setupContent: {
      players: 'Exactly 2 players.',
      deck: 'Standard 52-card deck. Ace is high.',
      equipment: 'Standard deck, counters or tokens for 11 points.',
      dealing: 'Each player receives 6 cards in batches of 3. The 13th card is turned up to set the potential trump suit.',
    },
    variationsContent: {
