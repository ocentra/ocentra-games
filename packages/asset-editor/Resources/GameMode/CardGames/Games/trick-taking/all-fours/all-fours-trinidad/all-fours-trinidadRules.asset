  data: {
    LLM: 'Game: All Fours (Trinidad). Type: Anti-clockwise Partnership Point-trick. Rules: 14 points to win. Turn-up bonuses: A(1), 6(2), J(3). Hang Jack = 3 pts. Order: High-Low-Jack-Game. Target: 14.',
    Player: "Welcome to Trini All Fours. Play is anti-clockwise. Turn-up Ace, Six, or Jack gives the dealer side immediate points, and hanging an opponent's Jack is worth 3. First side to 14 or more wins.",
    objective: 'Be first to 14 or more points by combining turn-up bonuses with High, Low, Jack, and Game.',
    gameplay: "1. **Trump Bonus**: If the turned-up card is an Ace (1 pt), Six (2 pts), or Jack (3 pts), the dealer's team scores immediately. 2. **The Beg**: The player to the dealer's right (Eldest) chooses to 'Stand' or 'Beg'. 3. **The Gift/Run**: If they beg, dealer can gift 1 point to opponents or 'Run the cards' (deal 3 more and flip new trump). Score again for new A/6/J. 4. **Trick Play**: Follow suit or trump. 5. **Counting Out**: Points are scored in order: High, Low, Jack, Game.",
    keyRules: [
      'High (1 pt): Team dealt the highest trump.',
      'Low (1 pt): Team dealt the lowest trump.',
      'Jack (1 pt): Winning a trick with the Jack of trumps.',
      "Hang Jack (3 pts): Winning a trick containing an opponent's Jack of trumps.",
      'Game (1 pt): Team with most card pips (A=4, K=3, Q=2, J=1, 10=10).',
      'Direction: Dealing, play, and turn-order are all anti-clockwise.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
