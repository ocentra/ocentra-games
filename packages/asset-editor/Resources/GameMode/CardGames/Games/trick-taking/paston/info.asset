    historyContent: {
      origins: "Rooted in the interaction between Eastern European trick-taking traditions and Middle Eastern social gaming. It bears strong similarities to 'Pastushok' and 'Preferans'.",
      originCountries: [
        'Armenia',
      ],
      timeline: [
        '1800s: Rules for Paston coalesce in the Caucasus region.',
        "1920s: Becomes a standard social activity in Armenian 'Koffeehouses'.",
        '1990s: Post-Soviet resurgence, with games appearing in professional social circles in Yerevan.',
        'Present: A symbols of heritage for Armenians worldwide, often passed down through generations.',
      ],
      evolution: 'The game was simplified from 4rd-player variants to focus purely on the 3-player dynamic, which ensures every player is actively involved in every round.',
      cultural: "Played with a specific vocabulary: 'Paston' (Spades), 'Glitch' (Clubs), 'Dineri' (Diamonds), 'Gupa' (Hearts).",
    },
