    },
    historyContent: {
      origins: "Developed in the Kashubian communities along the Baltic Sea. It is an adaptation of the German game 'Kop' (Head), which itself is a simplified version of Schafkopf. The name 'Baśka' is a Kashubian diminutive for 'Barbara'.",
      originCountries: [
        'Poland',
      ],
      timeline: [
        '1800s: High-honor variants of Schafkopf appear in Northern Europe.',
        'Early 1900s: Baśka becomes the dominant card game in the Kashubian region of Poland.',
        '1990s: Formalization of rules for regional tournaments in Poland.',
        'Present: Recognized as a cultural mascot of the Kashubian people, with numerous local clubs and championships.',
      ],
      evolution: 'The simplification down to 16 cards (from the traditional 32 or 24) makes the game exceptionally aggressive and requires perfect memory of all cards in play.',
      cultural: "Commonly played in traditional Kashubian 'karczma' (taverns). Knowing how to bid 'Gran' or 'Zolo' is a mark of local prestige.",
    },
    setupContent: {
      players: "4 players. Two are 'The Old Ones' (holders of Black Queens) and two are the opponents.",
      deck: '16 cards: Ace, 10, Queen, and Jack of each suit.',
      equipment: '16-card specific pack or a stripped 52-card deck (keep A, 10, Q, J only).',
      dealing: 'Each player is dealt 4 cards (usually 2 and 2).',
    },
    variationsContent: {
      list: [
        {
          id: 'baska-no-trumps',
          name: 'Bez Atu',
          description: 'A variation where only Aces and Tens are points, and no trumps exist (very rare).',
        },
        {
          id: 'baska-cicha',
          name: 'Silent Zolo',
          description: 'A player plays solo without announcing it until the first trick is played.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Does not understand the power of the Black Queens. Forgets that there are only 4 cards per player.',
        medium: 'Keeps a perfect count of the 16 cards. Understands the point values (Ace=11, 10=10) and prioritizes capturing Tens.',
        hard: "Expert at 'Psychological Bidding'. Will 'Kontra' aggressively if it detects the declarer is bluffing. Perfectly calculates the probability of a Gran succeeding.",
      },
      considerations: [
        "AI needs a 'Tiny Deck' logic model since the game state is resolved in only 4 tricks.",
        "Partnership deduction via 'Black Queen Tracking' must be implemented.",
      ],
    },
