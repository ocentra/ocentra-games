  data: {
    hero: {
      title: 'BAŚKA',
      subtitle: 'Kashubian Queens',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Baśka',
            subtitle: 'Kashubian Queens',
            content: [
              {
                type: 'paragraph',
                text: "Baśka (pronounced 'Bash-ka') is a distinctively fast-paced, 16-card trick-taking game from the Kashubian region of northern Poland. A member of the Schafkopf family, it is played with just the highest honors from a standard deck (A, 10, Q, J). The game is celebrated for its secret partnerships determined by the possession of 'Old Ones' (Black Queens) and its high-stakes solo bids.",
              },
              {
                type: 'paragraph',
                text: "Developed in the Kashubian communities along the Baltic Sea. It is an adaptation of the German game 'Kop' (Head), which itself is a simplified version of Schafkopf. The name 'Baśka' is a Kashubian diminutive for 'Barbara'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "4 players. Two are 'The Old Ones' (holders of Black Queens) and two are the opponents.",
              },
              {
                type: 'paragraph',
                text: '16 cards: Ace, 10, Queen, and Jack of each suit.',
              },
              {
                type: 'paragraph',
                text: '16-card specific pack or a stripped 52-card deck (keep A, 10, Q, J only).',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 4 cards (usually 2 and 2).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Bez Atu: A variation where only Aces and Tens are points, and no trumps exist (very rare).',
                  },
                  {
                    text: 'Silent Zolo: A player plays solo without announcing it until the first trick is played.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Baśka (pronounced 'Bash-ka') is a distinctively fast-paced, 16-card trick-taking game from the Kashubian region of northern Poland. A member of the Schafkopf family, it is played with just the highest honors from a standard deck (A, 10, Q, J). The game is celebrated for its secret partnerships determined by the possession of 'Old Ones' (Black Queens) and its high-stakes solo bids.",
    tags: [
