          hasPlaceholders: false,
        },
        rules: {
          objective: "The 'Old Ones' must capture a majority of the 104 available points in the round (or win all tricks in solo bids).",
          gameplay: "Players must follow suit. Trumps count as their own suit (The 'Trump' suit). If a trump is led, all others MUST play trumps. If an off-suit (e.g., Ace of Spades) is led, players must follow Spades.",
          keyRules: [
            'Point Values: Ace (11), 10 (10), Queen (3), Jack (2). Total = 104 points.',
            'Winning: The declarer/partnership needs 53 points (104 / 2 + 1) to win.',
            "Contra: Opponents can shout 'Kontra' to double the points for the round if they believe they can beat the bid.",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Identify your partner immediately. If you hold a Black Queen, watch who plays the other one.',
          intermediate: 'Counting the 16: You absolute MUST remember all 16 cards. If you see two Aces of off-suits played, you know the remaining two are high-risk targets for trumping.',
          advanced: "The Gran Lead: In a Gran bid, where only Jacks are trump, high-ranking suits (Aces and Tens) become much more powerful. Lead your strongest suit to flush out the opponents' Jacks.",
          tips: [
            "Don't bid 'Zolo' unless you hold at least two Queens OR the QC and another high trump.",
            "In standard play, the Ace of Hearts is the 9th highest trump. Don't be fooled into thinking it's a weak card.",
          ],
          hasPlaceholders: false,
        },
