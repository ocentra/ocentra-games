    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'ba-ka',
    LLM: 'Game: Baśka (Kashubian Kop). Type: Hidden-partnership point-trick. Rules: 16 cards (A, 10, Q, J). Trumps: Q > J > Hearts (A-10). Total: 104 pts. Goal: 53 pts. 4 tricks total.',
    Player: "Welcome to Baśka! You have just 4 cards. Do you hold a Black Queen? If so, you're an 'Old One'. Hearts are permanent trumps unless you bid 'Gran'. The total is 104 points—can you capture 53 and win?",
    tagline: 'The Black Queens decide your fate. Four tricks to win it all.',
    gameCategory: 'Trick-taking',
    subcategory: 'Schafkopf / Kop Family',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '5-10 minutes per round',
    origin: 'Poland (Kashubia)',
    originName: 'Baśka (Polish/Kashubian name; diminutive of Barbara)',
    deck: '16 cards (Standard deck ranks A, 10, Q, J)',
    alsoKnownAs: [
      'Kashubian Kop',
      'Polish Sheepshead',
    ],
    playersDisplay: '4',
    quality: 'complete',
    completeness: {
