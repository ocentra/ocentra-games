    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Joker (Exit Game)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Joker is a competitive 'exit' game popular in Bulgaria, Israel, and Central Europe. It is similar to games like 'Scum' or 'Durak' but with a unique twist: the Joker acts as a 'cursed' card. The goal is to get rid of your cards and exit the game. However, holding the Joker prevents you from exiting, meaning you must pass it to an opponent before you can win.",
              },
              {
                type: 'paragraph',
                text: "Part of the 'Jukha' or 'Chuchman' family of games. It developed in the Balkans and spread through social migration to Israel and Western Europe.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4-5 is optimal.',
              },
              {
                type: 'paragraph',
                text: '52 cards + 1 Joker.',
              },
              {
                type: 'paragraph',
                text: '52 cards + 1 Joker.',
              },
              {
                type: 'paragraph',
                text: 'Deal all cards face-down to the players. Some may have one more card than others.',
              },
            ],
          },
        ],
      },
