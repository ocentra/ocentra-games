        pages: [
          {
            title: 'Minimisere',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Minimisere is an original trick-taking card game designed by David Parlett. It is a game of 'controlled winning and losing', where the objective is to win a specific number of tricks (e.g., three or four)â€”or none at allâ€”but avoiding the middle ground and, crucially, avoiding winning everything. It is a tactical game that rewards precise hand evaluation and the ability to 'dump' high cards into other players' tricks.",
              },
              {
                type: 'paragraph',
                text: "Designed by the renowned card game historian David Parlett in the late 20th century as a study in 'Inverted Bidding' and 'Misere' mechanics.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '5 players (using 25 cards: A-K-Q-J-10-2).',
              },
              {
                type: 'paragraph',
                text: '25 cards (Ace to 10, plus a 2 in each suit, and one Joker).',
              },
              {
                type: 'paragraph',
                text: '25 cards (Ace to 10, plus a 2 in each suit, and one Joker).',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 5 cards. No trump suit.',
              },
            ],
          },
        ],
      },
