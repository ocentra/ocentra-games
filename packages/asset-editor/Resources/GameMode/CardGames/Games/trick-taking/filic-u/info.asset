    aiContent: {
      difficulty: {
        easy: "Fails to recognize Over-Knaves as separate from their original suit; doesn't prioritize Tens.",
        medium: "Understands the 8ndpoint scoring; trumps correctly when void; throws Tens on partner's tricks.",
        hard: "Expertly tracks the 4 Over-Knaves; calculates exactly how many trumps are left to determine if an Ace lead is safe; uses 'Master/Slave' psychology to bluff leads.",
      },
      considerations: [
        'AI must treat Over-Knaves as part of the Trump suit priority list, not their suit of origin.',
