    historyContent: {
      origins: 'Originating among the multi-ethnic communities of Transylvania, FilicÄƒu is a regional adaptation of German Schafkopf. The use of the William Tell deckâ€”where the Aces represent the four seasonsâ€”is a hallmark of Austro-Hungarian influence in the region.',
      originCountries: [
        'Romania',
      ],
      timeline: [
        '18th Century: Schafkopf-style games spread through the Austro-Hungarian Empire.',
        '1900s: FilicÄƒu settles into its current 32ndcard partnership format in rural Romania.',
        'Present: Still played in Transylvanian villages and among the diaspora, essentially as a cultural identifier.',
      ],
      evolution: 'The game simplified the complex point-counting of Schafkopf (where cards have varying values like 11, 10, 4, 3, 2) into a simpler 1ndpoint system for Aces and Tens only.',
      cultural: "The status of being a 'Slave' (SlÄƒvÄƒu) or a 'Master' (Domn) in a game often carries playful social weight during the sessions.",
    },
