        pages: [
          {
            title: 'All Fives (Cards)',
            subtitle: 'The Trump Hunter',
            content: [
              {
                type: 'paragraph',
                text: "All Fives is a specialized descendant of the All Fours family. While it retains the trick-taking and 'Begging' mechanics of its parent, it shifts the focus entirely to capturing specific point-bearing trumps, most notably the 10 and the 5.",
              },
              {
                type: 'paragraph',
                text: 'Developed as a point-heavy variant of All Fours in the 19th century. Is often confused with the domino game of the same name, though they are entirely unrelated in mechanics.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 or 3 (individual play).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, score tracking to 61.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives 6 cards to each player. The next card is turned up for trumps.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'No-Beg Variation: The first turned-up card is trumps, no begging allowed.',
                  },
                ],
              },
            ],
          },
        ],
