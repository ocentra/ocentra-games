    historyContent: {
      origins: 'Developed as a point-heavy variant of All Fours in the 19th century. Is often confused with the domino game of the same name, though they are entirely unrelated in mechanics.',
      originCountries: [
        'United States',
        'England',
      ],
      timeline: [
        '1800s: All Fives diverges from Seven-Up/All Fours in the United States.',
        '1900s: Becomes a popular gambling variant where point-capture requires tighter trump management.',
        'Present: Still played as a retro variant of the All Fours family.',
      ],
      evolution: "Replaces the 'High, Low, Jack, Game' points of All Fours with a fixed point schedule for specific cards (A, K, Q, J, 10, 5 of trumps).",
