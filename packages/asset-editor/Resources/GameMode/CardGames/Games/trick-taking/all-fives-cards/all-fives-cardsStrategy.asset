      {
        title: 'Tip',
        description: 'The 5 of trumps is a huge prize. It often gets lost in early tricks; keep track of it.',
      },
      {
        title: 'Tip',
        description: 'If you have the 10 and the Ace of trumps, you have a guaranteed 14 points if you lead correctly.',
