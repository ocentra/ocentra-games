  data: {
    LLM: 'Game: Botifarra. Type: Point-Trick. Rules: 48 cards. 12 tricks. Rank: 9(5)>A(4)>K(3)>Kn(2)>J(1). Must follow, must trump void. Dealer can delegate trump. No Trump = Botifarra.',
    Player: "You are the dealer. Your hand has no long suits and few high cards. Do you name a suit trumps, take the risk of 'Botifarra' (No Trump), or 'Delegar' the choice to your partner?",
    objective: 'Score more than 36 points (half of 72 total card points) in a deal. First team to reach a target (usually 101) wins.',
    gameplay: "1. **Trump Selection**: Dealer names a suit, No Trump ('Botifarra'), or delegates ('Delegar') to partner. 2. **Doubling**: Opponents can 'Contrar' to double the points. 3. **The Play**: Forehand leads. **Must Follow Suit**. If void, **Must Trump** if the opponent is winning the trick. 4. **Tricks**: Highest trump wins; else highest of led suit.",
    keyRules: [
      'Ranking is A-7-K-J-Q? No, in Botifarra: 9-A-K-Knight-Jack-others.',
      'Jack of Trumps is NOT the boss; the 9 is.',
      "The 'Botifarra' (No Trump) contract doubles the points of the deal automatically.",
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '4 players in two fixed partnerships.',
      deck: '48 cards (1-12 in Coins, Cups, Swords, Batons). Ranking: 9 (Manille, 5 pts), Ace (4 pts), King (3 pts), Knight (2 pts), Jack (1 pt), then 12, 11, 10, 8, 7, 6, 5, 4, 3, 2 (0 pts).',
      equipment: 'Spanish-suited deck, score pad.',
      dealing: 'Deal all 48 cards clockwise (12 to each player).',
    },
    turnFlow: "1. **Trump Selection**: Dealer names a suit, No Trump ('Botifarra'), or delegates ('Delegar') to partner. 2. **Doubling**: Opponents can 'Contrar' to double the points. 3. **The Play**: Forehand leads. **Must Follow Suit**. If void, **Must Trump** if the opponent is winning the trick. 4. **Tricks**: Highest trump wins; else highest of led suit.",
    moveValidityConditions: {
      ante: 'Botifarra is a point-based partnership game and does not utilize a monetary or chip-based ante system.',
      deal: 'The initial distribution of all 48 cards to the four players is performed automatically by the system dealer.',
      reveal_market: 'All cards are distributed among the players at the start; no public market or community cards exist.',
      buy_market: 'Players cannot purchase or swap cards from any external area; they must succeed using only their 12 cards.',
      buy_stock: 'The entire deck is exhausted during the deal phase; no cards remain in stock to be drawn or purchased.',
      fold: 'Partnerships must participate in all twelve tricks of the hand to determine the final point winner.',
      check: 'The game uses a trick-taking and doubling structure rather than a vying structure with checks.',
      call: 'There is no bet to match in this game; competition is based on contract points and trick wins.',
      bet: 'Success is determined by card point accumulation on a scorecard rather than through financial betting.',
      raise: 'Only available during the doubling phase after trump is named.',
      declare: 'Available only to the dealer or delegated partner.',
      reveal_hand: 'Hands remain private until individual cards are played into tricks; no separate reveal phase occurs.',
      award_pot: 'Winning points are added to a cumulative partnership total rather than awarded from a physical pot.',
      play_card: 'Must follow suit; must trump if void and opponent winning.',
      draw: 'All cards are distributed at the start; no drawing phase exists during the play of the twelve tricks.',
      discard: 'Every card in the hand must be played into a trick; no cards are discarded or buried.',
      pass: 'Allowed during the doubling phase.',
      bid: 'Trump selection is performed via direct naming rather than a competitive bidding auction.',
      meld: 'Botifarra is strictly a point-trick game and does not involve the formation of sequences or melds.',
      go_out: 'The hand terminates automatically once all twelve tricks have been played by all participants.',
    },
