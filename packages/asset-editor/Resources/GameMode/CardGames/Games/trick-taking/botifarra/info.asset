    historyContent: {
      origins: "Originating in rural Catalonia in the 19th century, Botifarra evolved from the older game of Manille. Its name literally refers to a type of Catalan sausage, though in the game it denotes the 'Botifarra' (No Trump) contract.",
      originCountries: [
        'Spain',
      ],
      timeline: [
        '1800s: Manille variants become popular in North-Eastern Spain.',
        'Early 1900s: Distinct Botifarra rules (delegating trump, doubling) stabilize.',
        '1980s: Codification of regional tournament rules by Catalan associations.',
        'Present: A symbol of Catalan national identity, played in every village and social club.',
      ],
      evolution: "The game's complexity grew with the addition of 'Contrar' (doubling) and 'Recontrar' (redoubling) mechanics, which add a gambling layer to the strategic play.",
      cultural: 'Played with extreme seriousness; many clubs forbid talking or signaling during play. It is an integral part of Catalan social life.',
    },
    setupContent: {
      players: '4 players in two fixed partnerships.',
      deck: '48 cards (1-12 in Coins, Cups, Swords, Batons). Ranking: 9 (Manille, 5 pts), Ace (4 pts), King (3 pts), Knight (2 pts), Jack (1 pt), then 12, 11, 10, 8, 7, 6, 5, 4, 3, 2 (0 pts).',
      equipment: 'Spanish-suited deck, score pad.',
      dealing: 'Deal all 48 cards clockwise (12 to each player).',
    },
