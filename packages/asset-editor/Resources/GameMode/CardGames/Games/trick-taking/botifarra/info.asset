    },
    aiContent: {
      difficulty: {
        easy: 'Follows suit and trump rules legally. Never delegates trump. Does not track point cards.',
        medium: 'Evaluates hand points for trump selection. Understands the value of the 9. Coordinates basic defense.',
        hard: "Expert at Delegar/Contrar decisions. Tracks all 48 cards and remaining points perfectly. Executes advanced finesses to capture the opponent's 9.",
      },
      considerations: [
        'Must implement the complex 9-A-K-Kn-J ranking engine.',
        'Trump delegation requires a partnership-value estimation model.',
      ],
