    historyContent: {
      origins: "Developed from the German Schafkopf game in the 19th century, Kop was adapted by Polish players in regions under Prussian influence. It became a distinct Polish identity game through the inclusion of the 'Wedding' (Wesele) contract.",
      originCountries: [
        'Poland',
      ],
      timeline: [
        'Late 1800s: Schafkopf variants evolve into the 16-card Kop in PoznaÅ„.',
        '1950s: Becomes a standard pub game across Greater Poland.',
        '2012: The Grand Prix of Poland in Kop is established.',
        'Present: Very popular in tournaments; standardized rules enforced by several regional associations.',
      ],
      evolution: "The game's evolution focused on maximizing the number of trumps (14 out of 16), creating a game where side-suit play is nearly non-existent.",
      cultural: "The game's terminology (Wesele, Zolo, Kontra) is a mix of Polish and German, reflecting the region's complex history.",
    },
