    historyContent: {
      origins: "Derived from the British game 'Nomination Whist' which gained popularity in the 1930s. The Dutch variant, Boerenbridge, introduced a structured trump rotation and specific scoring rules that became standardized in Dutch social clubs.",
      originCountries: [
        'United Kingdom',
        'Netherlands',
      ],
      timeline: [
        '1930s: Oh Hell! emerges in the UK and USA.',
        '1950s: Boerenbridge becomes a common family game in the Netherlands.',
        'Present: Remains one of the most played trick-taking games in Dutch schools and pubs.',
      ],
      evolution: "The game shifted from a simple 'Up the River' format to a symmetric 'Up and Down' cycle, ensuring that the highest skill testing occurs at the 1-card and maximum-card rounds.",
      cultural: 'A foundational game in Dutch society, often used to teach children the principles of suit following and trick valuation.',
    },
