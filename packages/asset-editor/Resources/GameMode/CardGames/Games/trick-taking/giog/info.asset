    historyContent: {
      origins: 'Giog is a Malaysian version of a game played with Chinese chess pieces used as playing-cards, with related forms across China and Southeast Asian Chinese communities.',
      originCountries: [
        'Malaysia',
        'China',
      ],
      timeline: [
        'Traditional era: Regional chess-piece trick games developed in Chinese communities.',
        '2019: Detailed Giog and related-variant documentation published.',
        '2024: Documentation updated with expanded variant references and details.',
      ],
      evolution: 'Local variants differ in distribution method, valid combinations, tie handling, and scoring, while retaining hidden-piece trick capture structure.',
      cultural: 'The game adapts the widely available Xiangqi piece set into a social competitive trick format.',
