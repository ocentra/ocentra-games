    historyContent: {
      origins: "Part of the ancient Italian 'Rovescino' (Reverse) game group, which prizes losing tricks over winning them. It became popularized in Northern Italy as a parlor game.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        "1800s: Games like 'Mattazza' are played as social drinking games.",
        "1920s: Rules for 'The Middle Path' (avoiding high and low scores) are standardized.",
        'Present: Remains a niche but beloved game in regional clubs and festivals.',
        "20th Century: The name 'Mattazza' (related to 'Mazzo' or 'Madness') reflects its unpredictable outcomes.",
      ],
      evolution: "The game's unique 'Middle Path' scoring distinguishes it from simpler avoidance games like Hearts.",
      cultural: 'A game that rewards humility and tactical restraint over aggressive winning.',
    },
