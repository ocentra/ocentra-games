        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mattazza',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mattazza is a traditional Italian trick-avoidance game, often described as a chaotic and humorous variant of the 'Loser Wins' family. Played with a 40-card Italian deck, the goal is specifically to NOT be the best or the worst player in terms of points captured. It is a game of social sabotage and precise point management, where being average is the key to survival.",
              },
              {
                type: 'paragraph',
                text: "Part of the ancient Italian 'Rovescino' (Reverse) game group, which prizes losing tricks over winning them. It became popularized in Northern Italy as a parlor game.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "4 players. Each starts with 5 'Life' points.",
              },
              {
                type: 'paragraph',
                text: '40 cards. Ranking: 3, 2, Ace, King, Knight, Jack, 7, 6, 5, 4.',
              },
              {
                type: 'paragraph',
                text: '40 cards. Ranking: 3, 2, Ace, King, Knight, Jack, 7, 6, 5, 4.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 10 cards. No trump suit.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Rovescino: The parent game where ONLY the high score loses.',
                  },
                  {
                    text: "Tressette a Perdere: The high-speed 'Loser Wins' variant.",
                  },
                ],
              },
            ],
          },
        ],
