    tips: [
      {
        title: 'Tip',
        description: 'Last Trick: Avoid winning the last trick at all costs, as it carries a 3-point penalty (plus whatever cards are in it).',
      },
      {
        title: 'Tip',
        description: "Suit Balance: If you have a long suit of 4-5-6, keep it for the end of the game to ensure you don't take unwanted tricks.",
