    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Traversone',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Traversone, also known as Ciapano, Rovescino, Tressette a non Prendere, Perdivinci, or Vinciperdi, is an Italian reverse Tressette trick-taking game. Players follow Tressette play but try to avoid taking point cards; the player who accumulates the penalty total loses unless a successful cappotto reverses the result.',
              },
              {
                type: 'paragraph',
                text: 'Traversone, also called Ciapano and Rovescino, is the reverse game of Tressette. It is a Lombardy and central Italian trick-taking game whose objective is to avoid taking point cards.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 5 players; 4 is typical.',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck. Rank high to low follows Tressette: 3, 2, Ace, King, Knight, Jack, 7, 6, 5, 4.',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck and score sheet.',
              },
              {
                type: 'paragraph',
                text: 'Deal all possible cards equally, anticlockwise; with four players each receives 10 cards.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Busca: Four-player variant in which players must take at least one point but avoid taking the most points; the Ace of Coins is a special high-value card.',
                  },
                  {
                    text: 'Mattazza: Four-player variant in which both the highest and lowest point totals can be punished, making the middle score safest.',
                  },
                ],
              },
            ],
          },
        ],
      },
