    historyContent: {
      origins: 'Busca is a variation of CiapanÃ² (also known as Rovescino, Traversone, or Tressette a non Prendere), a reverse trick-taking game from Lombardy, Italy. CiapanÃ² was very popular in Lombardy until the 1980s and is still played there.',
      originCountries: [
        'Italy',
      ],
      timeline: [
        'Traditional origins: CiapanÃ² played for generations in Lombardy',
        '1980s: Peak popularity of CiapanÃ² in Lombardy',
        'Modern era: Busca variation documented by Davide Gullo',
        'Contemporary: Still played in Italian regions',
      ],
      evolution: 'Busca modifies CiapanÃ² scoring by multiplying all points by three and introducing the special Pita card (Ace of Coins worth 8 points). The objective shifts from simply avoiding points to taking at least one but not the most.',
      cultural: "Busca and related games like CiapanÃ² are part of Italian regional card game traditions. The Milanese dialect name 'CiapanÃ²' translates roughly to 'Don't catch it!' reflecting the reverse nature of the game.",
    },
    setupContent: {
      players: '4 players, each playing for themselves',
      deck: '40-card pack: Italian suits (swords, batons, cups, coins) or Milanese/French suits (spades, clubs, hearts, diamonds). Cards rank: 3 (high), 2, Ace, King, Horse/Queen, Jack/Fante, 7, 6, 5, 4 (low).',
      equipment: '40-card Italian or Milanese pack, score sheet for tracking busche',
      dealing: 'Deal 10 cards to each player (anticlockwise). Turn to deal passes to the right after each hand.',
    },
