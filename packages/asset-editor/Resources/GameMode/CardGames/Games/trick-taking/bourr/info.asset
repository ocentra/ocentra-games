      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Plays every hand with a trump card. Never folds to pot odds. Follows suit legally.',
        medium: 'Folds weak hands. Understands basic over-trumping logic. Counts played trumps.',
        hard: "Calculates risk/reward of the Bourré penalty based on pot size. Exploits the 'must-trump' rule to force opponents into losing tricks.",
      },
      considerations: [
        "Must implement the 'Follow Suit -> Trump -> Over-trump' priority tree.",
        'Pot matching penalty logic is essential for EV calculation.',
      ],
    },
