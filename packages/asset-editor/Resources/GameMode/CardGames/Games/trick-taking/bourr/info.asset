    hero: {
      title: 'BOURRÉ',
      subtitle: "Louisiana's Pot Builder",
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bourré',
            subtitle: "Louisiana's Pot Builder",
            content: [
              {
                type: 'paragraph',
                text: "Bourré (pronounced 'boo-ray') is a high-stakes Cajun gambling game from Louisiana. A descendant of French Rams, it is a penalty trick-taking game for 2-8 players. Participants ante into a pot, receive five cards, and must win at least one trick to avoid being 'Bourréd'—a penalty that requires the player to match the entire current pot. This explosive mechanic leads to massive pots and intense psychological play, making it a legendary staple of Gulf Coast gaming culture.",
              },
              {
                type: 'paragraph',
                text: "Brought to Louisiana by French Acadians in the 18th century, Bourré evolved from the French game 'Bourre' or 'Vieux Garçon', which itself grew out of the Spanish game Burro. It was heavily adapted in the bayous of Louisiana, absorbing elements of African-American gambling traditions to become the high-action game it is today.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 8 players playing individually (5 is optimal for suit distribution).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack (No Jokers).',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, large central pot for chips or currency.',
              },
              {
                type: 'paragraph',
                text: 'Each player contributes an ante. Deal 5 cards each clockwise. Turn the next card face-up to set the trump suit.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'No Exchange Bourré: Players must play with the five cards they were originally dealt.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bourré (pronounced 'boo-ray') is a high-stakes Cajun gambling game from Louisiana. A descendant of French Rams, it is a penalty trick-taking game for 2-8 players. Participants ante into a pot, receive five cards, and must win at least one trick to avoid being 'Bourréd'—a penalty that requires the player to match the entire current pot. This explosive mechanic leads to massive pots and intense psychological play, making it a legendary staple of Gulf Coast gaming culture.",
    tags: [
      'card-game',
      'trick-taking',
      'traditional',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 8,
    routePath: 'bourr',
    LLM: 'Game: Bourré. Type: Rams/Gambling. Rules: Must follow, must trump, must overtrump. Evaluation: High Trump/Void = Auto-Play. Low Hand = Fold. Penalty: Match whole pot if zero tricks.',
    Player: "You have the King of Trumps and a void in Hearts. The pot is 100. Do you stay? With the King and a void, you're almost guaranteed a trick. Stay and play!",
    tagline: 'One trick for safety. All the tricks for glory. Zero tricks for ruin.',
    gameCategory: 'Trick-taking',
    subcategory: 'Rams / Gambling',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '15-45 minutes',
    origin: 'United States (Louisiana)',
