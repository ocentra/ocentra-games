    historyContent: {
      origins: "Brought to Louisiana by French Acadians in the 18th century, Bourré evolved from the French game 'Bourre' or 'Vieux Garçon', which itself grew out of the Spanish game Burro. It was heavily adapted in the bayous of Louisiana, absorbing elements of African-American gambling traditions to become the high-action game it is today.",
      originCountries: [
        'France',
        'Spain',
        'United States',
      ],
      timeline: [
        '1750s: Acadian settlers bring French trick-taking games to Louisiana.',
        'Early 1900s: Bourré develops from French Bourre and related Rams games in southwest France and Louisiana.',
        '1970s: Standardized rules emerge in New Orleans and Lafayette gaming halls, popularized by regional authors.',
        'Present: A cultural icon of the American South, famously played in poker rotations and social gatherings.',
      ],
      evolution: 'The introduction of the full-pot matching penalty and the strict must-follow, must-trump, and must-overtrump rules turned a polite parlor game into a high-stakes gambling phenomenon.',
      cultural: "Nickname: 'The game that builds pots'. It is as much about the 'smack talk' and bluffing during the exchange as it is about the card play in Cajun and Gulf Coast communities.",
    },
    setupContent: {
      players: '3 to 8 players playing individually (5 is optimal for suit distribution).',
      deck: 'Standard 52-card French pack (No Jokers).',
      equipment: 'Standard pack, large central pot for chips or currency.',
      dealing: 'Each player contributes an ante. Deal 5 cards each clockwise. Turn the next card face-up to set the trump suit.',
    },
    variationsContent: {
      list: [
        {
          id: 'bourre-no-exchange',
          name: 'No Exchange Bourré',
          description: 'Players must play with the five cards they were originally dealt.',
