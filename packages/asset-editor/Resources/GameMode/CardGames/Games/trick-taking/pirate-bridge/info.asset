        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: "Pirate's Bridge",
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Pirate's Bridge is a fascinating and revolutionary variant of Bridge that replaces 'Fixed Partnerships' with a dynamic, shifting alliance system. Conceived by R.F. Foster and popularized by Aleister Crowley, it allows players to choose their partner for each specific hand based on the bidding. This removes the 'Bad Partner' frustration of standard Bridge and introduces a layer of individual competition. It is Bridge with an 'Every Player for Themselves' mentality.",
              },
              {
                type: 'paragraph',
                text: "Developed by R.F. Foster in 1917 as a way to fix the 'Partner Problem' in Auction Bridge. The occultist Aleister Crowley was a major proponent and writer on the game's psychological depth.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players with no fixed partnerships. Each hand, the auction determines a temporary Declarer and Acceptor (dummy); the other two defend. All four score individually over the rubber.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French deck. All 52 cards are used; 13 cards are dealt to each of the four players. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French deck. All 52 cards are used; 13 cards are dealt to each of the four players. No jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard 13 cards per player. No fixed partners; players sit at four individual positions.',
              },
            ],
          },
