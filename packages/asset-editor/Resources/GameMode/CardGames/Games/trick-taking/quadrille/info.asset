          hero: {
            title: 'QUADRILLE',
            subtitle: 'Historic Hombre for Four',
            tagline: 'Bid, call a King, and take six.',
          },
          shortDescription: '18th-century four-player trick-taking game: Hombre calls a King, names trump, aims for six tricks.',
          uiThemes: [
            'classic',
