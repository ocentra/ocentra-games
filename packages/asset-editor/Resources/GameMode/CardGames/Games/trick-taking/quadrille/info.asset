  data: {
    hero: {
      title: 'QUADRILLE',
      subtitle: 'Historic Hombre for Four',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Quadrille',
            subtitle: 'Historic Hombre for Four',
            content: [
              {
                type: 'paragraph',
                text: 'Quadrille is a four-player trick-taking game adapted from the Spanish Ombre. The winner of the bidding becomes Hombre, names trump, and may call a King for a partner. The declarer aims to win six of ten tricks using a 40-card pack with inverted red-suit ranking and special matadors (Spadille, Manille, Basta).',
              },
              {
                type: 'paragraph',
                text: "Quadrille was introduced to the southern provinces of France around 1695 and shortly thereafter to Paris. It is an adaptation of the three-player Spanish game Ombre (Hombre) for four players. First English rules appeared in The Game of Quadrille; or Ombre by Four (1720), described as 'the favourite game at the French Court.'",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players. Each plays for herself; temporary alliances form per deal via the called King.',
              },
              {
                type: 'paragraph',
                text: '40 cards: A, K, Q, J, 7, 6, 5, 4, 3, 2 in each suit (8s, 9s, 10s removed).',
              },
              {
                type: 'paragraph',
                text: '40-card pack, counters or chips for stakes, score sheet.',
              },
              {
                type: 'paragraph',
                text: '1. Dealer shuffles; pone cuts. 2. Deal 10 cards each in batches of 4-3-3, 3-4-3, or 3-3-4. 3. Deal and play rotate right (counterclockwise).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Mediateur: Elaboration of Quadrille with Grandissimo, Nemo, Dimidiator, Casco, and favourite-suit concepts. French rules (1752).',
                  },
                  {
                    text: 'Forced Spadille: When all pass, holder of Spadille (Ace of Spades) becomes Hombre, calls a King for partner. Hombre or partner may name trump. No vole allowed.',
                  },
                  {
                    text: 'Solo / Vole: Solo: Hombre plays alone for six tricks. Vole: bid to take all ten tricks; requires extra stake to a separate pool.',
                  },
                  {
                    text: 'Casco: Bid when holding both Spadille and Basta. Declarer calls a King; the called player names trump. Both play as a team.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Quadrille is a four-player trick-taking game adapted from the Spanish Ombre. The winner of the bidding becomes Hombre, names trump, and may call a King for a partner. The declarer aims to win six of ten tricks using a 40-card pack with inverted red-suit ranking and special matadors (Spadille, Manille, Basta).',
    tags: [
      'card-game',
      'trick-taking',
      'traditional',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'quadrille',
    LLM: 'Game: Quadrille. Progression: [Ante -> Deal -> Auction -> Call King -> Play(10 tricks) -> Settlement]. Bidding: Solo, Casco, Dimidiator, Alliance; or Forced Spadille if all pass. Hombre names trump; in Alliance, calls a King for partner. Matadors: Spadille (Aâ™ ), Manille (lowest trump), Basta (Aâ™£). Red suits inverted. Declarer needs 6 tricks. Follow suit. Matadors may be held back when trumps led.',
    Player: 'Four players bid for the right to be Hombre. Win the auction, name trump, and call a King to find a secret partnerâ€”or play Solo. Win six of ten tricks to take the pool. Watch out for Spadille, Manille, and Basta: the matadors that rule the trumps.',
    tagline: 'Bid, call a King, and take six.',
    gameCategory: 'Trick-taking',
    subcategory: 'Hombre / Point-trick',
    playerMode: 'multiplayer',
    difficulty: 'Expert',
