        pages: [
          {
            title: 'Kentucky Rook',
            subtitle: 'Trick-taking',
            content: [
              {
                type: 'paragraph',
                text: 'Rook variant for four in fixed partnerships. 45 cards (2s-4s removed). Bid from 100 in multiples of 5, take nest, discard five (no point cards), name trump. Trick play; Rook highest trump; 180 points per deal. First team to 500 wins.',
              },
              {
                type: 'paragraph',
                text: 'Kentucky Rook derives from Rook (published 1906 by Parker Brothers). Popular in Eastern Kentucky; rules from contributor John Hay.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 fixed partnerships',
              },
              {
                type: 'paragraph',
                text: 'Rook deck with 2s, 3s, 4s removed (45 cards including Rook)',
              },
              {
                type: 'paragraph',
                text: 'Rook deck',
              },
              {
                type: 'paragraph',
                text: 'Ten cards each, one at a time; five cards to the nest. Dealer adds one card to the nest after each of the first five rounds.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Rook as lowest trump: Some play with the Rook as the lowest card of the trump color rather than the highest.',
                  },
                  {
                    text: 'Point cards in nest: Some allow the bidder to discard point cards; points in the nest go to the team that wins the last trick.',
                  },
                  {
                    text: 'Kentucky Discard: Official Rook Tournament variant: 41 cards (ones omitted), 9 each and 5 nest, dealer bids first, min bid 70, count cards may be discarded, game to 300.',
                  },
                ],
              },
            ],
          },
        ],
      },
