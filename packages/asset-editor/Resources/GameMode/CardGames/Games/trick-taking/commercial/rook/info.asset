    hero: {
      title: 'ROOK',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Rook',
            subtitle: 'Trick-taking',
            content: [
              {
                type: 'paragraph',
                text: 'Point-trick family using the Rook deck: four colors (black, red, green, yellow), ranks 1–14 per color plus the Rook bird card. Popular in Mennonite communities and Eastern Kentucky. This entry models the common form: four in fixed partnerships, bid for nest and trump, first team to 500 wins.',
              },
              {
                type: 'paragraph',
                text: 'Rook was introduced by Parker Brothers in 1906. The deck was designed for communities that avoided standard playing cards; the game became popular in Eastern Kentucky and among Mennonites in Southern Ontario, Manitoba, Pennsylvania, and Ohio.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in fixed partnerships, partners opposite.',
              },
              {
                type: 'paragraph',
                text: 'Rook deck: four suits (colors) 1–14 each plus Rook bird card. Common variant removes 2s, 3s, 4s for 45 cards.',
              },
              {
                type: 'paragraph',
                text: 'Rook deck',
              },
              {
                type: 'paragraph',
                text: 'Ten cards each, one at a time; five cards to the nest. Dealer adds one card to the nest after each of the first five rounds of the deal.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Rook as lowest trump: Some play with the Rook as the lowest card of the trump color rather than the highest.',
                  },
                  {
                    text: 'Point cards in nest: Some allow the bidder to discard point cards; points in the nest go to the team that wins the last trick.',
                  },
                  {
                    text: 'Kentucky Discard: Official Rook Tournament variant: 41 cards (ones omitted), 9 each and 5 nest, dealer bids first, min bid 70, count cards may be discarded, game to 300.',
                  },
                  {
                    text: 'Call Partner Rook: All 57 cards; bidder calls a card for partner; holder becomes partner for that hand. 13 each, 5 nest; 200 points per hand including last trick.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
