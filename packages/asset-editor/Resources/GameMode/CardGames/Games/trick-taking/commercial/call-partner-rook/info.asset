    historyContent: {
      origins: 'Call Partner Rook is a four-player Rook variant from the United States. Partner is determined each hand by the bidder naming a card; whoever holds it plays with the bidder for that hand.',
      originCountries: [
        'USA',
      ],
      timeline: [
        '1906: Rook deck introduced by Parker Brothers; games such as Call Partner developed as local variants using the full 57-card deck and partner-calling.',
      ],
      evolution: 'Rook was introduced by Parker Brothers in 1906. Call Partner evolved as one of many local Rook variants, using the full 57-card deck and the call-partner mechanism; it is distinct from Kentucky Rook and from the booklet games supplied with the deck.',
      cultural: 'Played in North American communities where Rook is popular, including Eastern Kentucky and Mennonite communities in Southern Ontario, Manitoba, Pennsylvania, and Ohio. The Rook deck was originally marketed to groups that avoided standard playing cards.',
    },
