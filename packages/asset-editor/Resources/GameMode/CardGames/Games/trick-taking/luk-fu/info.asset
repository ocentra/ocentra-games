    historyContent: {
      origins: 'Dates back centuries to the Hakka people in Southern China. It is related to other money-suited games like Khanhoo and Madiao.',
      originCountries: [
        'China',
        'Hong Kong',
        'Malaysia',
        'Singapore',
      ],
      timeline: [
        '1800s: Rules are documented among Hakka communities in Guangdong and Fujian.',
        '1950s: Becomes a popular social game in Hong Kong and Southeast Asia (Malaysia/Singapore).',
        'Present: Remains a niche but deeply traditional game among elderly Hakka speakers.',
        '2004: Featured in research by the International Playing-Card Society.',
      ],
      evolution: "The game's 38-card deck is a variation of the standard 40-card money deck, specifically omitting or modifying certain honor cards to create the 6-trick threshold.",
      cultural: "Winning is referred to as 'Eating PurÃ©e' (Sid Fu), a metaphor shared with Mahjong.",
