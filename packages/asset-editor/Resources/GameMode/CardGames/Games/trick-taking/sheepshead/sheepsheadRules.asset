  data: {
    LLM: 'Game: Sheepshead. Logic: See rules.objective and rules.gameplay.',
    Player: 'Sheepshead is a trick-taking card game that involves tricks, trump, following suit. The game originated in Europe and has become popular worldwide.',
    objective: 'Picker side must take at least 61 of 120 card points; defenders win if picker side stays below 61.',
    gameplay: 'After dealing, players may pass or pick the blind depending on table rules. The picker takes the blind, buries cards, and usually forms a hidden partnership (for example called-ace or jack-of-diamonds variants). Play is clockwise in tricks with mandatory suit following. Trump order is fixed with queens and jacks highest, plus diamonds as trumps in common five-player rules. After all tricks, card points determine whether picker side or defenders win.',
    keyRules: [
      'Players must follow suit when possible.',
      'If trump is led and you hold trump, you must play trump.',
      'Card points are counted from captured tricks; total points in hand are 120.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Standard game is five players with changing teams each hand; variants exist for 2-8 players.',
      deck: 'Use a 32-card piquet deck (remove 2-6 from each suit in a standard deck).',
      equipment: 'Cards and score tracking for game points.',
      dealing: 'In the common five-player form, deal 6 cards to each player and 2 cards face down to the blind.',
    },
    turnFlow: 'After dealing, players may pass or pick the blind depending on table rules. The picker takes the blind, buries cards, and usually forms a hidden partnership (for example called-ace or jack-of-diamonds variants). Play is clockwise in tricks with mandatory suit following. Trump order is fixed with queens and jacks highest, plus diamonds as trumps in common five-player rules. After all tricks, card points determine whether picker side or defenders win.',
