        pages: [
          {
            title: 'Tresillo',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Tresillo (also Rocambor) is a historic Spanish trick-taking game for three players. It is the Spanish descendant of L'Hombre (Ombre), which was once the most popular card game in Europe. The 'declarer' (El Hombre) plays alone against the other two. Uses a 40-card Spanish deck with the unusual A-3-K ranking.",
              },
              {
                type: 'paragraph',
                text: "Descended from Ombre/L'Hombre, the dominant European card game of the 17th-18th centuries.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '40-card Spanish deck. Rank varies by suit (Long vs Round). Matadors: Spadille (Aâ™ ), Manille (7/2 of trumps), Basto (Aâ™£) are always top trumps.',
              },
              {
                type: 'paragraph',
                text: 'Cards, pot/counters',
              },
              {
                type: 'paragraph',
                text: 'Deal 9 cards each. 13 remain in stock.',
              },
            ],
          },
        ],
      },
