  data: {
    hero: {
      title: 'CRAZY SOLO',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Crazy Solo',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Crazy Solo (often just called 'Solo' in parts of Eastern Europe and USA) is a trick-taking card game for 3 to 12 players, though 4 is standard. It features a bidding hierarchy where players can 'Go Alone' (Solo) against the others. The game is known for its escalating bids involving specific trump suits (Hearts high) and partnership calling.",
              },
              {
                type: 'paragraph',
                text: "Derived from L'Hombre via Solo Whist, but with Americanized bidding rules (using Hearts as a premium suit).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Three to twelve players; four or more is standard.',
              },
              {
                type: 'paragraph',
                text: '36 cards (standard); 30, 32, 33 or 35 depending on player count.',
              },
              {
                type: 'paragraph',
                text: '36 cards (standard); 30, 32, 33 or 35 depending on player count.',
              },
              {
                type: 'paragraph',
                text: "All cards distributed one at a time starting with the player to the left of the dealer. With 4, 6, 9 or 12 players use full 36-card deck; with 5 or 7 remove six of spades (35); with 8 remove all sixes (32); with 10 remove all sixes plus seven of spades and seven of clubs (30); with 11 remove sixes of spades, clubs and diamonds (33). Player to dealer's left is on the lead.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Going Blind: Player on the lead may declare blind before looking at cards; if they have at least one heart they must go under (be solo) with Hearts as trump; no other player may bid. If no heart, hand reverts to normal bidding. Typically played once per evening.',
                  },
                  {
                    text: 'Gang call-out: A gang player may call out that the gang is taking the trick to encourage others to dump point-cards; undiscovered partner may bluff by calling gang.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
