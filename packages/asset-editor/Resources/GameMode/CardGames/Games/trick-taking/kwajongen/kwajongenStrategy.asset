      {
        title: 'Tip',
        description: "If you 'Accept' trumps with a weak hand, you are likely to go 'Kapot'. Only bid if you have at least one Ace or two Kings.",
      },
      {
        title: 'Tip',
        description: "Watch for the 'Boer' (Jack) of trumps; it is often the deciding point in a close round.",
