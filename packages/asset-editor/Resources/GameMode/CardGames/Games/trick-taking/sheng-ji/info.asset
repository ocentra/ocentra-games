          hasPlaceholders: false,
        },
        rules: {
          objective: "Raise your partnership rank from 2 upward (often to Ace) by winning rounds while controlling opponents' trick points.",
          gameplay: "Each round establishes dominant rank and usually a dominant suit through bidding. Declarers take the kitty and discard back to kitty size. Trick play then proceeds with strict follow/combination constraints based on lead pattern and trump structure. Opponents' captured point cards (5s, 10s, Kings) determine whether declarers keep deal and advance or defenders seize momentum.",
          keyRules: [
            'Dynamic trump rank each round changes comparative card power.',
            'Only 5s, 10s, and Kings score points in tricks.',
            "Round control shifts based on opponents' point total thresholds.",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Track point cards and avoid giving away cheap 5/10/K captures in uncertain tricks.',
          intermediate: 'Use bidding pressure and trump timing to control lead and force weak combinations from defenders.',
          advanced: 'Plan long round tempo around rank advancement math, kitty information, and partnership signaling through legal pattern choices.',
          tips: [
            "Point counting (especially opponents' totals) is mandatory for strong play.",
            'Trump exhaustion timing often determines whether late point tricks swing the round.',
          ],
          hasPlaceholders: false,
        },
