    historyContent: {
      origins: 'Originating in the Ladin-speaking valleys of South Tyrol, Blind Watten represents a more disciplined and analytical branch of the Watten family tree. It was developed to test partnership intuition without the reliance on the overt physical gesturing common in Bavarian or Tyrolean Watten.',
      originCountries: [
        'Italy',
        'Austria',
      ],
      timeline: [
        '19th Century: Watten spreads through the Alpine regions of the Austro-Hungarian Empire.',
        'Early 20th Century: Blind (Ladinisch) variant solidifies in the South Tyrolean mountains.',
        "Present: Actively played in traditional 'Stuben' and card clubs throughout Alto Adige and parts of Austria.",
      ],
      evolution: 'The removal of partner signaling and the introduction of secret trump selection were the key evolutionary steps that defined this variant.',
      cultural: 'A symbol of regional identity in the Ladin valleys, reflecting a culture of quiet observation and deep communal trust.',
    },
    setupContent: {
