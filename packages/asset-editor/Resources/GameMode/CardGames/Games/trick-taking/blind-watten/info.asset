    aiContent: {
      difficulty: {
        easy: "Follows legal play rules. Does not attempt to deduce trumps from partner's plays. Plays high cards blindly.",
        medium: 'Deduces trump suit by the third trick. Understands basic hierarchy. Only raises when holding the top trumps.',
        hard: 'Full Bayesian deduction model. Identifies Schlag and Trump suit by the second card played with 90% accuracy. Optimizes signaling as forehand/dealer.',
      },
      considerations: [
        'Information asymmetry requires a state-estimation layer for the partners.',
        "Must implement the 'Guate/Rechte/Linken' dynamic ranking engine.",
      ],
