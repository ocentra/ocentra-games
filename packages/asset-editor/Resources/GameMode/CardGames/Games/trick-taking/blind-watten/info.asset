    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Blind Watten',
            subtitle: 'The Secret-Trump Alpine Game',
            content: [
              {
                type: 'paragraph',
                text: 'Blind Watten (Ladinisch Watten) is a fascinating South Tyrolean variation of the classic Alpine game. In this version, the Schlag (trump rank) and Trump suit are chosen in secret by the forehand and dealer, respectively. Their partners must deduce the trumps through observation of the play alone, as signaling is strictly prohibited. It transforms a lively social game into a high-stakes psychological puzzle of asymmetric information.',
              },
              {
                type: 'paragraph',
                text: 'Originating in the Ladin-speaking valleys of South Tyrol, Blind Watten represents a more disciplined and analytical branch of the Watten family tree. It was developed to test partnership intuition without the reliance on the overt physical gesturing common in Bavarian or Tyrolean Watten.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: '33 cards: A, K, O, U, 10, 9, 8, 7 in four suits plus the WELI (6 of Bells).',
              },
              {
                type: 'paragraph',
                text: 'German-suited deck, score pad.',
              },
              {
                type: 'paragraph',
                text: 'Deal 5 cards to each player. Forehand shows a card rank (Schlag) to the dealer in secret; the dealer shows a suit back to forehand in secret.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Watten with Kritische: Standard Watten where the three top cards (Max, Weli, Spitz) are permanent trumps above the Schlag.',
                  },
                ],
              },
            ],
          },
        ],
      },
