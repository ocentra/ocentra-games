            discardConfig: 'Cards are played directly to tricks; no separate waste or discard pile is utilized.',
            specialCards: 'Certain ranks have high point values but do not trigger automated secondary engine actions.',
            declarationMechanism: 'Trumps are established via a secret showing phase; no hidden tokens are required.',
            fishingConfig: 'Blind Watten is a trick-taking game and does not use a capture-from-tableau fishing mechanic.',
            meldConfig: 'Points are earned only through trick capture; no melding of card sets is part of the core gameplay.',
            shedding: 'This game is not a shedding game; players maintain their hands throughout the deal.',
          },
