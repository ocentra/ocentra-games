    hero: {
      title: 'RACEHORSE PITCH',
      subtitle: 'Pitch Variant',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Racehorse Pitch',
            subtitle: 'Pitch Variant',
            content: [
              {
                type: 'paragraph',
                text: 'Racehorse Pitch is a Pitch variant where the dealer bids and leads; players race to reach the target (e.g. 21) with bid and trump mechanics as in Pitch. High-Low-Jack-Game scoring. See Pitch for base rules.',
              },
              {
                type: 'paragraph',
                text: 'Racehorse is a cutthroat (individual-play) money variant of Pitch, documented by Patrick Mathews. Pitch is a North American game derived from the old English All Fours (Seven Up or Old Sledge); the modern form with bidding and setback arose in the mid-19th century. Racehorse is usually played by five or more people, each for themselves; the pitcher pays or receives money per point bid. Origins are US; cutthroat Pitch is often played on the coasts for money.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French deck, as in base Pitch: four suits, thirteen ranks each (Ace through King). Six cards are dealt to each player.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck.',
              },
              {
                type: 'paragraph',
                text: '6 each (as Pitch).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Pitch: Base game.',
                  },
                ],
              },
            ],
          },
        ],
      },
