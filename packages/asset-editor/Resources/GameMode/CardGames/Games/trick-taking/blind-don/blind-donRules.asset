  data: {
    LLM: 'Game: Blind Don. Type: Point-Trick. Rules: 2 players. 13+13 deal. Rank: A>K...2. Point values: 9=9, 5=5, A=4, K=3, Q=2, J=1. First lead sets trump. Memory of Part One is critical for Part Two.',
    Player: "You hold the 9 of Clubs, 5 of Clubs, and the Ace of Hearts. Your first lead sets trumps! Do you pitch the 5♣ to lock in Clubs, protecting your high-value 9♣ under your own 'Don'?",
    objective: 'Score points by capturing specific cards in tricks. Points: Nines (9 each), Fives (5 each), Aces (4 each), Kings (3), Queens (2), Jacks (1).',
    gameplay: '1. **Part One**: Play 13 tricks with the first deal. Trump is set by the first card led. 2. **Part Two**: Deal the remaining 26 cards (13 each). Play the remaining 13 tricks using the same trump suit. 3. **The Play**: Must follow suit if possible. If void, may trump or discard.',
    keyRules: [
      "The Five of Trumps is known as the 'Don'.",
      'Winning the last trick of the game (the 26th trick) scores no bonus points, but captures the cards.',
      'Players must follow suit if they can; trumps rank high.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Exactly 2 players.',
      deck: 'Standard 52-card French pack. Ranks: A, K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2.',
      equipment: 'Standard pack, score pad.',
      dealing: "Deal 13 cards to each player. The remaining 26 cards are set aside face-down for the second half of the game. The first card played (the 'pitch') by the non-dealer sets the trump suit for the entire hand.",
    },
    turnFlow: '1. **Part One**: Play 13 tricks with the first deal. Trump is set by the first card led. 2. **Part Two**: Deal the remaining 26 cards (13 each). Play the remaining 13 tricks using the same trump suit. 3. **The Play**: Must follow suit if possible. If void, may trump or discard.',
    moveValidityConditions: {
      ante: 'Blind Don is a point-trick game and does not utilize a monetary or chip-based ante system.',
      deal: 'The two-part distribution of 13 cards per phase is handled automatically by the system dealer.',
      reveal_market: "This is a closed-hand game where cards are either in players' hands or the face-down reserve.",
      buy_market: 'Players cannot purchase or swap cards from any market area; they must play with their dealt hands.',
      buy_stock: 'The entire deck is distributed in two fixed dealing phases; no cards can be bought from the stock.',
      fold: 'Both players must participate in all 26 tricks of the deal to determine the final point winner.',
      check: 'The game uses a trick-taking structure rather than a vying structure where checking would be an option.',
      call: 'There is no pot or bet to match in Blind Don; competition is based on card point accumulation.',
      bet: 'Success is determined by card points won in tricks rather than through financial or chip-based betting.',
      raise: 'There are no wagering rounds in this game, so the value of the deal cannot be increased via raises.',
      declare: 'Hand resolution is based on objective trick counts and point cards without a declaration phase.',
      reveal_hand: 'Hands remain private until individual cards are played into tricks; no full-hand reveal occurs.',
      award_pot: 'Winning is determined by cumulative match points rather than by awarding a physical or virtual pot.',
      play_card: 'Must follow suit; highest trump or highest led card wins.',
      draw: 'All cards are distributed in two dealing phases; no drawing phase exists during the play of tricks.',
      discard: 'Every card in the hand must be played into a trick; no cards are discarded or buried.',
      pass: 'Players must always play a card to every trick; passing a turn without action is not allowed.',
      bid: 'The trump suit is determined by the rank of the first card led rather than through a bidding auction.',
      meld: 'This is a point-trick game based on single cards rather than forming sequences or melds in hand.',
      go_out: 'The game ends automatically once all 26 tricks have been played by both participants.',
    },
