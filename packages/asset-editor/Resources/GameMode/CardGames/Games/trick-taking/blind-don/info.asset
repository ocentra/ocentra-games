    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Blind Don',
            subtitle: 'The Two-Part Lancashire Duel',
            content: [
              {
                type: 'paragraph',
                text: "Blind Don is the strategic two-player variation of Nine-Card Don, a traditional British pub game from the All Fours family. Popular in Lancashire and South Wales, it features a unique two-part deal where players play through the entire deck in two separate phases. The game centers on capturing high-point cards, particularly the Nines and the 'Don' (Five of Trumps). It is a game of perfect memory, as the cards played in the first half reveal the exact contents of the opponent's hand in the second half.",
              },
              {
                type: 'paragraph',
                text: "Descended from the 17th-century game All Fours via the Irish game Dom Pedro. 'Don' emerged as a distinct British regional variant, with Blind Don being the adaptation for two players to maintain the competitive tension of the partnership version.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly 2 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack. Ranks: A, K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, score pad.',
              },
              {
                type: 'paragraph',
                text: "Deal 13 cards to each player. The remaining 26 cards are set aside face-down for the second half of the game. The first card played (the 'pitch') by the non-dealer sets the trump suit for the entire hand.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Nine-Card Don: The standard 4-player partnership version using 9 cards each.',
                  },
                ],
              },
            ],
          },
        ],
      },
