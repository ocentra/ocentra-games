    historyContent: {
      origins: "Descended from the 17th-century game All Fours via the Irish game Dom Pedro. 'Don' emerged as a distinct British regional variant, with Blind Don being the adaptation for two players to maintain the competitive tension of the partnership version.",
      originCountries: [
        'United Kingdom',
      ],
      timeline: [
        '1800s: All Fours variants like Dom Pedro spread through the UK and Ireland.',
        '1900s: Nine-Card Don becomes a staple pub game in Lancashire.',
        'Present: Survival as a niche traditional game in British regional card clubs.',
      ],
      evolution: "The game's 'two-part' deal structure was developed to allow two players to use the full deck while maintaining small, manageable hand sizes.",
      cultural: "Reflects the 'Old School' British pub gaming culture where memory and card-counting are highly respected skills.",
    },
