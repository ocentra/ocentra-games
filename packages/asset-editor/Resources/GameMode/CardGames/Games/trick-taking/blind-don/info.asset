    aiContent: {
      difficulty: {
        easy: 'Follows suit legally. Plays high cards early. Does not track cards between Part One and Part Two.',
        medium: 'Tracks the played Nines. Deduces basic opponent voids. Remembers cards from the first half.',
        hard: "Perfect card counter. After Part One, uses full-knowledge of the opponent's hand to optimize Part Two play. Executes precise 'endplays' to capture remaining Nines.",
      },
      considerations: [
        'Must implement a cross-phase memory state.',
        'Hand evaluation must be point-centric (valuing Nines above Aces).',
