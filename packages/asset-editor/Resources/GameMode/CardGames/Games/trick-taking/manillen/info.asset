    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Manillen',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Manillen is a popular point-trick card game played extensively in West Flanders, Belgium. Derived from the French game Manille (which came from Spanish Malilla), it features the unique 'Manille' (10) as the highest card in each suit. The game is known for its simple rules but deep strategic possibilities, especially the 'Ik ga mee' (I go along) doubling mechanic.",
              },
              {
                type: 'paragraph',
                text: "Originated as a French game called Manille, derived from the Spanish game Malilla or Manilla. The term 'Manille' refers to the highest card (10) of each suit.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships, sitting across from each other. Variations exist for 2 and 6 players.',
              },
              {
                type: 'paragraph',
                text: '32 cards (7, 8, 9, 10, Jack, Queen, King, Ace in each suit). Ranking: 10 (Manille) > Ace > King > Queen > Jack > 9 > 8 > 7.',
              },
              {
                type: 'paragraph',
                text: '32 cards (7, 8, 9, 10, Jack, Queen, King, Ace in each suit). Ranking: 10 (Manille) > Ace > King > Queen > Jack > 9 > 8 > 7.',
              },
              {
                type: 'paragraph',
                text: "To determine first dealer: each player takes a pile of cards; highest bottom card deals. Dealer shuffles (max twice), player to dealer's right cuts. Deal clockwise in batches of 3-2-3 (8 cards each). Dealer's partner must NOT look at cards before trump is chosen.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Obligatory muuls: Each partnership must declare two no-trumps (muulen) and two blind no-trumps (blènde muul) per boam. Makes the game more exciting but shorter.',
                  },
                  {
                    text: 'Signalling penalty: If a partnership is caught signalling or cheating, they lose the deal and 20 points are given to the other team.',
                  },
                  {
                    text: 'Boerecoarte redeal: Some players redeal when a player has a boerecoarte or boerinnecoarte: a hand with one Jack (zot) and five 0-point cards (7s, 8s, 9s - klintjes).',
                  },
                  {
                    text: 'Two- or six-player variants: Two-player: dummy hands or face-up table cards; six-player: two teams of three, five cards each, two face up on table. Same trump and scoring rules.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
