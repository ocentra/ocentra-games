    historyContent: {
      origins: "Derived from the German Schafkopf games brought to the Baltics in the 19th century. It evolved into a distinct Estonian folk game, adopting the name 'Lambapea' (Sheep's Head) in parallel with its German ancestor.",
      originCountries: [
        'Estonia',
      ],
      timeline: [
        '1880s: Schafkopf variants are documented in Estonian university circles.',
        '1930s: Saskop emerges as a staple in rural Estonian social life.',
        '1990s: Post-independence resurgence as a traditional cultural pastime.',
        'Present: Played competitively in Estonian card clubs and online forums.',
      ],
      evolution: "The game simplified the complex 'Solo' bidding of German Schafkopf to prioritize the partnership experience, while retaining the '6-is-top' ranking logic.",
      cultural: 'In Estonia, Saskop is often associated with long social gatherings and communal strategy.',
    },
    setupContent: {
      players: '4 players in fixed partnerships (North-South, East-West).',
