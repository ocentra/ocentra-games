    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bauernstoss',
            subtitle: 'Palatinate Schafkopf',
            content: [
              {
                type: 'paragraph',
                text: "Bauernstoss is a regional variant of Schafkopf played almost exclusively in the Palatinate (Pfalz) region of Germany. Unlike the Bavarian national game, Bauernstoss simplifies the trump structure significantly: the four Jacks are always the highest trumps, followed by the permanent trump suit (usually Hearts or Diamonds depending on the village), and there are no variable 'Solo' or 'Wenz' games. It is a pure partnership point-trick game played with high velocity and heavy 'klopfen' (knocking) to double the stakes.",
              },
              {
                type: 'paragraph',
                text: "Originates from the village of Erfweiler and surrounding areas in Southwest Germany. It represents an older, more 'rustic' branch of the Schafkopf family tree that did not evolve into Skat.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships (partners sit opposite).',
              },
              {
                type: 'paragraph',
                text: '32-card German or French deck. Ranks: A, 10, K, Q(Ober), J(Unter), 9, 8, 7.',
              },
              {
                type: 'paragraph',
                text: 'Skat pack, chalk/slate for scoring.',
              },
              {
                type: 'paragraph',
                text: 'Deal 8 cards to each player (usually 4-4).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Alter Schoofkopp: A variant from Niederhochstadt where the Queens are also trumps (below Jacks), making a very long trump suit.',
                  },
                  {
                    text: 'Ramsch: Played if everyone passes (in bidding variants). Object is to lose points.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
