        rules: {
          objective: 'Score more over 6 deals. Rubicon: loser <100 pays sum+100; loser â‰¥100 pays difference+100.',
          gameplay: "1. Exchange: Elder 1-5, Younger 1 to remainder. 2. Declarations: Point (longest suit), Sequence (tierce to huitiÃ¨me), Set (trio, quatorze). Elder declares; Younger says good/not good/equal. 3. Play: No trump; follow suit. Point per lead; extra for winning opponent's lead; last trick +1. 10 for most tricks (40 capot). Repique: 30 in declarations before opponent = +60. Pique: 30 before opponent scores = +30 (elder only).",
          keyRules: [
            '32 cards. 12 each, 8 talon.',
            'Point, Sequence, Set declarations. Best wins category.',
            'No trump. Follow suit.',
            'Repique 60, Pique 30.',
            'Partie 6 deals. Rubicon 100.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Elder: exchange 5, go for best hand. Younger: keep stops (e.g. Qxx).',
          intermediate: 'Sink declarations when beaten. Track discards.',
          advanced: "Throw-in play. Last hand: minimise loser's score if <100.",
          tips: [
            'Elder rarely exchanges <5.',
            'Point compared by total face value.',
            'Carte blanche (no courts) = 10.',
          ],
