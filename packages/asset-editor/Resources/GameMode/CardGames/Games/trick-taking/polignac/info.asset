    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Polignac',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Polignac is a French reverse trick-taking game in which players try to avoid taking Jacks, especially the Jack of Spades, the Polignac.',
              },
              {
                type: 'paragraph',
                text: "Dates back to the early 19th century in France. It is named after the French Prime Minister Jules de Polignac, who was deeply unpopular at the timeâ€”hence why the most 'Penalty' card bears his name.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 is standard; 5 or 6 requires removing specific cards (like 7s) to make dealing even.',
              },
              {
                type: 'paragraph',
                text: '32 cards (remove 2s through 6s).',
              },
              {
                type: 'paragraph',
                text: '32 cards (remove 2s through 6s).',
              },
              {
                type: 'paragraph',
                text: '8 cards each (for 4 players).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Capot: Before the opening lead, a player may bid capot: an undertaking to win every trick. If they succeed, each opponent loses 5 points; if they fail, the bidder loses 5.',
                  },
                  {
                    text: 'General: A player may announce before leading to the first trick that they will try to take all tricks. Success: all other players score 5 penalty points each. Failure: Jacks score 5 points in the usual way against the players who take them.',
                  },
                  {
                    text: 'Ace high variant: If Ace is played as high (common in old French games), penalties attach to Queens instead of Jacks.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
