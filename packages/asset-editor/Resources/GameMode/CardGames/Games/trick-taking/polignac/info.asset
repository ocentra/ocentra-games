    historyContent: {
      origins: "Dates back to the early 19th century in France. It is named after the French Prime Minister Jules de Polignac, who was deeply unpopular at the timeâ€”hence why the most 'Penalty' card bears his name.",
      originCountries: [
        'France',
      ],
      timeline: [
        '1830: Named after the unpopular Polignac ministry.',
        '1870s: Becomes a popular game in the French military (Zouaves).',
        "1920s: Serves as the basis for the more complex game 'Barbu'.",
        "Present: Still played in regional France, often as 'Le Valet Noir'.",
      ],
      evolution: "The game was simplified from earlier French games like 'L'Ambigu' to focus purely on the psychological tension of avoiding the 'Dirty Jack'.",
      cultural: "In French culture, 'faire Polignac' means to accidentally catch the bad card, often resulting in good-natured mockery.",
    },
    setupContent: {
      players: '4 is standard; 5 or 6 requires removing specific cards (like 7s) to make dealing even.',
      deck: '32 cards (remove 2s through 6s).',
      equipment: '32 cards (remove 2s through 6s).',
      dealing: '8 cards each (for 4 players).',
    },
