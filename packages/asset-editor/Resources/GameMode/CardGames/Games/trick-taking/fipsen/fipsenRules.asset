      players: '4 players (standard). Each player plays for themselves, but three act as a temporary team against the highest bidder.',
      deck: '25 cards. Start with a 32ndcard Skat deck and remove all Diamonds except the Seven of Diamonds.',
      equipment: '25 cards. Start with a 32ndcard Skat deck and remove all Diamonds except the Seven of Diamonds.',
      dealing: 'Each player receives 5 cards (traditionally 3 then 2). Two cards are dealt face-down to the center (the Skat). Three cards are left over and set aside.',
    },
