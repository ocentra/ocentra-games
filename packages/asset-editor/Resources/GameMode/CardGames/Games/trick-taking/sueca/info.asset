    hero: {
      title: 'SUECA',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Sueca',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Sueca (Portuguese: 'Swedish') is the most popular card game in Portugal and Brazil. It is a trick-taking game for 4 players in two partnerships. The game uses a 40-card deck and is notable for its Ace-Seven-King-Jack-Queen hierarchy (similar to Briscola or Tressette, but with 7 as 10 points). The goal is to take more than half the points (61+) in tricks. No talking is allowed.",
              },
              {
                type: 'paragraph',
                text: 'Likely derives from Tressette or similar Italian games, perhaps brought by Swedish sailors?',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck with the 8s, 9s and 10s removed, leaving 40 cards. Four suits; rank in each suit from high to low: Ace, 7 (manilha), King, Jack, Queen, 6, 5, 4, 3, 2.',
              },
              {
                type: 'paragraph',
                text: '40-card deck (8s, 9s, 10s removed).',
              },
              {
                type: 'paragraph',
                text: 'Deal 10 cards to each player. Bottom card turned for Trump.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Brazil (clockwise): In Brazil play is clockwise; dealing and lead order follow local convention.',
                  },
                  {
                    text: 'Revoke penalty: Some play that revoke (failing to follow suit when able) costs the offending team two games.',
                  },
                  {
                    text: 'Azores (10 as manilha): In the Azores the 10 is often the manilha (second highest). Trump determined by cutting the packet of 12 rejected cards (9s, 8s, 7s) instead of turning a card.',
                  },
                ],
              },
            ],
          },
        ],
      },
