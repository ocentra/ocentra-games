    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'kalter-schlag',
    LLM: 'Game: Kalter Schlag. Type: Avoidance trick-taking. Deck: 32 cards (7-Ace). Hand: 8 cards. Card values: A=11, 10=10, K=4, Q=3, J=2 (trumps). Goal: Avoid points. Lose at 2000 points. Special: Durchmarsch (win all tricks) = others get 120 penalty.',
    Player: "Welcome to Kalter Schlag! In this Hamburg classic, points are your enemy. Avoid taking Aces (11) and Tens (10). Watch out for the Jacksâ€”they're trumps! Can you avoid being the first to 2000 points?",
    tagline: 'Dodge the points, avoid the tricks, and survive the Cold Stroke.',
