    icon: '🃏',
  },
  data: {
    LLM: "1. **Lead**: Player to dealer's right leads. 2. **Follow Suit**: Players MUST follow suit. 3. **Trump**: If void in led suit, you may play a Trump (rank rules apply) or discard. You are not forced to trump if you can discard (unlike some games). 4. **Winning**: Highest Trump wins. If no trump, highest card of led suit wins. 5. **Signals**: Players observe strict signaling rules when playing cards (e.g., knocking on the table).",
    Player: "1. **Lead**: Player to dealer's right leads. 2. **Follow Suit**: Players MUST follow suit. 3. **Trump**: If void in led suit, you may play a Trump (rank rules apply) or discard. You are not forced to trump if you can discard (unlike some games). 4. **Winning**: Highest Trump wins. If no trump, highest card of led suit wins. 5. **Signals**: Players observe strict signaling rules when playing cards (e.g., knocking on the table).",
    objective: 'Score game points by winning card points in tricks. First team to 41 Game Points wins.',
    gameplay: "1. **Lead**: Player to dealer's right leads. 2. **Follow Suit**: Players MUST follow suit. 3. **Trump**: If void in led suit, you may play a Trump (rank rules apply) or discard. You are not forced to trump if you can discard (unlike some games). 4. **Winning**: Highest Trump wins. If no trump, highest card of led suit wins. 5. **Signals**: Players observe strict signaling rules when playing cards (e.g., knocking on the table).",
    keyRules: [
      'The 3 is higher than the 2, which is higher than the Ace.',
      'You do not have to head the trick if you follow suit.',
      'Trumping is optional if void in led suit (you can undercut/discard).',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '4 players in two fixed partnerships (partners sit opposite).',
      deck: '40 cards. Ranking in all suits: 3 (Highest), 2, Ace, King, Knight (Cavallo), Jack (Fante), 7, 6, 5, 4 (Lowest).',
      equipment: 'Italian deck (or 52-card deck with 8s, 9s, 10s removed). Score sheet.',
      dealing: 'Dealer deals 10 cards to each player. The Trump suit is determined by turning the last card dealt to the dealer (or by dealer declaration in some variants).',
    },
    turnFlow: "1. **Lead**: Player to dealer's right leads. 2. **Follow Suit**: Players MUST follow suit. 3. **Trump**: If void in led suit, you may play a Trump (rank rules apply) or discard. You are not forced to trump if you can discard (unlike some games). 4. **Winning**: Highest Trump wins. If no trump, highest card of led suit wins. 5. **Signals**: Players observe strict signaling rules when playing cards (e.g., knocking on the table).",
