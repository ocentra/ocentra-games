      {
        title: 'Tip',
        description: "In Trumps, lead the 3 or 2 early to draw out the opponents' trumps.",
      },
      {
        title: 'Tip',
        description: 'Saving the Ace of Trumps for the last trick guarantees 2 points (1 for Ace + 1 for Final Trick).',
