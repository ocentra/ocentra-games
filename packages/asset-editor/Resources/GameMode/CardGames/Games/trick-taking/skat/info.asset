    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Skat',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Skat is widely regarded as Germany's national card game and one of the best 3-player trick-taking games ever devised. It features complex bidding based on 'Game Value', a unique trump hierarchy (Jacks are highest), and three main contract types (Suit, Grand, Null). The 'Soloist' plays against two defenders. The game combines luck, skill in hand evaluation, and precise card play.",
              },
              {
                type: 'paragraph',
                text: "Invented in Altenburg, Thuringia, around 1810 by members of the 'Brommesche Tarok-Gesellschaft'. It combined elements of Tarock (bidding), Schafkopf (Jacks), and L'Hombre (Solitaire).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 active players.',
              },
              {
                type: 'paragraph',
                text: '32 cards (Jacks High).',
              },
              {
                type: 'paragraph',
                text: '32 cards (Jacks High).',
              },
              {
                type: 'paragraph',
                text: "Deal 10 cards to each player (3-4-3). 2 cards face-down in the 'Skat' (blind).",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Hand game: Declarer does not pick up the Skat; plays with the 10 cards dealt. Higher multiplier.',
                  },
                  {
                    text: 'Suit, Grand, Null: Suit: one suit is trump (Jacks then A 10 K Q 9 8 7). Grand: only Jacks are trump. Null: no trump; declarer must lose every trick.',
                  },
                ],
              },
            ],
          },
        ],
      },
