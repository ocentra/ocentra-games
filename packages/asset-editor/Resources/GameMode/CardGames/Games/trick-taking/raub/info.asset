        rules: {
          objective: 'Declarer: make 2+ tricks. Defenders: make 1 each or drop. Start 21; lose for failure. Refa (all pass) doubles next hand.',
          gameplay: "1. Deal 4 each; turn trump. 2. Dealer: Raub (take trump, make 2) or Trick (7 up, make 1) before seeing hand. 3. Else bidding: 'I lead' = declarer; can exchange up to 4. 4. Defenders: Idem (play) or Nejdem (drop). Must make 1 if playing. 5. Play 4 tricks. 6. Scoring.",
          keyRules: [
            'Declarer: 2+ tricks. Defenders: 1 each or drop.',
            'Raub = take trump, make 2. Trick = 7 up, make 1.',
            'Refa = all pass; double next hand.',
            'Exchange up to 4 for declarer.',
          ],
          hasPlaceholders: false,
        },
