    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Raub',
            subtitle: 'Croatan Rams',
            content: [
              {
                type: 'paragraph',
                text: "Raub is a Croatan trick-taking game. 2-4 players. 32 cards (7-A). Declarer must make at least 2 of 4 tricks; each defender must make 1 or drop. Dealer can say 'Raub' (take face-up trump, make 2) or 'Trick' (7 up, make 1). Bidding: 'I lead'. Refusal (Refa) doubles next. Start 21; lose points for failures.",
              },
              {
                type: 'paragraph',
                text: 'Raub is played by Croatians in the United States, though the actual origin of the game is uncertain. This description was contributed by Davorin Fundak, who learned the game in Oregon, from a relative in Ohio.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to four active players; best with four. Play is clockwise.',
              },
              {
                type: 'paragraph',
                text: '32 cards (German or 52 minus 2-6).',
              },
              {
                type: 'paragraph',
                text: '32-card pack. Score sheet.',
              },
              {
                type: 'paragraph',
                text: '2 each, 1 face-up trump, 2 each = 4 each.',
              },
            ],
          },
        ],
      },
    ],
