    hero: {
      title: 'CANCELLATION HEARTS',
      subtitle: 'The Matching Variant',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Cancellation Hearts',
            subtitle: 'The Matching Variant',
            content: [
              {
                type: 'paragraph',
                text: 'Hearts variant: matching cards in a trick cancel (no points). Different scoring from base Hearts.',
              },
              {
                type: 'paragraph',
                text: 'Hearts first appeared at the end of the nineteenth century and is popular in many countries. Cancellation Hearts is an American variant for six to ten players using two 52-card packs shuffled together; when identical cards are played to the same trick they cancel each other for trick-taking but still carry penalty points if they are hearts or the Queen of Spades.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Cancellation Hearts is commonly played by six to ten players; this build uses four players with one deck. No partnerships; play is clockwise.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. The classic Cancellation form uses two 52-card packs shuffled together for six to ten players; this entry uses one pack for four players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. The classic Cancellation form uses two 52-card packs shuffled together for six to ten players; this entry uses one pack for four players.',
              },
              {
                type: 'paragraph',
                text: 'All cards are dealt out as far as they go; any leftover go to a face-down kitty taken by the winner of the first trick. For 4 players, 13 cards each, one at a time. After the deal, pass three cards (left, right, across, no pass by round).',
              },
            ],
          },
        ],
      },
