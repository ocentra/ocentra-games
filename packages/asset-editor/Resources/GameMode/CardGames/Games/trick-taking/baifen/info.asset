    historyContent: {
      origins: "Originating in Northern China as a simplified version of the older 'Zheng Fen' (Compete for Points) games. It standardized the '100 Point' economy of a single deck, making it accessible to a wider audience before the 1980s explosion of multi-deck 'Tractor' variants.",
      originCountries: [
        'China',
      ],
      timeline: [
        'Early 20th Century: Single-deck point games emerge in family social circles.',
        '1950s: Rules standardized across urban centers like Beijing and Shanghai.',
        "1980s: The game evolves into 'Ba Shi Fen' (80 Points) and 'Tractor' using two decks.",
        'Present: Still played in households that prefer the tighter, more mathematical constraints of a single deck.',
      ],
      evolution: "The transition from 'Bai Fen' to 'Tractor' marked a shift from individual card tracking to pattern-based 'sequential' play.",
      cultural: 'Frequently played at weddings and festivals; it is seen as a game of cooperation and shared fortune.',
    },
    setupContent: {
      players: '4 players in two fixed partnerships.',
      deck: 'One standard 52-card deck plus both Jokers (Red and Black).',
      equipment: 'Standard pack, score sheet.',
      dealing: 'The deck is shuffled and players draw one card at a time until the deck is exhausted. The dealer role rotates clockwise.',
    },
    variationsContent: {
      list: [
        {
          id: 'da-bai-fen',
          name: 'Da Bai Fen (Great 100)',
          description: "Uses a 'Leveling' system where winning a hand allows you to promote your Trump Rank (e.g., from 2 to 3).",
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Fails to save high trumps for point-heavy tricks. Discards Kings into tricks it cannot win.',
        medium: "Understands the 40-point threshold. Cooperates with partner by 'sloughing' points on partner's winning tricks.",
        hard: 'Simulates all possible distributions of the remaining 54 cards. Tracks the location of the Jokers and the Trump Rank cards with high precision.',
      },
      considerations: [
        "Needs a point-optimization heuristic: 'Is this trick worth spending a Joker on?'",
        "Must track partner's voids to know when to lead a specific suit.",
      ],
    },
