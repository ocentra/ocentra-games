          equipment: 'Standard pack, score sheet.',
          dealing: 'The deck is shuffled and players draw one card at a time until the deck is exhausted. The dealer role rotates clockwise.',
          hasPlaceholders: false,
        },
        rules: {
          objective: "The 'Attacking' team must collect at least 40 points in their tricks to 'win' the round. Collecting 100 points (all point cards) is a 'cleaning' victory.",
          gameplay: 'Standard trick-taking rules apply. Players must follow suit if possible. The highest trump wins the trick; if no trumps, the highest card of the led suit wins.',
          keyRules: [
            "The 'Kicker': On the final trick, if the Attacker wins, the points in the final trick are multiplied (doubled or tripled depending on the house rules).",
            'No Trump: In some variants, if no trump suit is declared, only Rank cards and Jokers are trumps.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Bankers should always lead their strongest non-trump suits early to force the Attackers to spend their trumps on low-value tricks.',
          intermediate: "Point Control: If you are the Attacker and know you can't win the trick, throw your point cards (5s, 10s) to your PARTNER if they are likely to win it.",
          advanced: "The Void Tactic: Try to empty your hand of a low-value suit early so you can 'Trump In' (ruff) when that suit is led, stealing the points from the Bankers.",
          tips: [
            'Count the 5s and 10s. There are only four of each rank. Knowing how many are left in play is the difference between a master and a novice.',
            'Never lead a King unless you are certain it is the highest card remaining; losing a King is a 10-point swing to the opponent.',
          ],
          hasPlaceholders: false,
        },
        variations: {
          list: [
            {
