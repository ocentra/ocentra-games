  data: {
    hero: {
      title: 'BÄ‚I FÄ’N',
      subtitle: 'The Battle for 100 Points',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bai Fen',
            subtitle: 'The Battle for 100 Points',
            content: [
              {
                type: 'paragraph',
                text: "Bai Fen (literally 'Hundred Points') is a foundational Chinese trick-taking game that serves as the progenitor to more complex multi-deck games like Tractor (Sheng Ji). Played with a single 54-card deck, it is a game of partnership survival where the Attacking team tries to capture specific point cards (5s, 10s, and Kings) while the Defending team protects their lead. It features a trump system where a trump rank is rotated and combined with jokers to create a powerful hierarchy.",
              },
              {
                type: 'paragraph',
                text: "Originating in Northern China as a simplified version of the older 'Zheng Fen' (Compete for Points) games. It standardized the '100 Point' economy of a single deck, making it accessible to a wider audience before the 1980s explosion of multi-deck 'Tractor' variants.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships.',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card deck plus both Jokers (Red and Black).',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, score sheet.',
              },
              {
                type: 'paragraph',
                text: 'The deck is shuffled and players draw one card at a time until the deck is exhausted. The dealer role rotates clockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Da Bai Fen (Great 100): Uses a 'Leveling' system where winning a hand allows you to promote your Trump Rank (e.g., from 2 to 3).",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bai Fen (literally 'Hundred Points') is a foundational Chinese trick-taking game that serves as the progenitor to more complex multi-deck games like Tractor (Sheng Ji). Played with a single 54-card deck, it is a game of partnership survival where the Attacking team tries to capture specific point cards (5s, 10s, and Kings) while the Defending team protects their lead. It features a trump system where a trump rank is rotated and combined with jokers to create a powerful hierarchy.",
    tags: [
      'card-game',
      'trick-taking',
      'social',
      'partnership',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'baifen',
    LLM: 'Game: BÄƒi FÄ“n. Type: Point-Collection Trick-taking. Rules: 54 cards (1 deck + jokers). Points: 5=5, 10=10, K=10. Total 100. Attackers need 40. Rotating Trump Rank.',
    Player: 'Welcome to the Hundred Point Challenge. You and your partner are the Attackers. You need 40 points to take the lead. The trump rank is 2. Will you use your Red Joker to steal this King, or safe it for the final trick?',
    tagline: 'Protect the Kings. Hunt the 5s. Conquer the hundred.',
    gameCategory: 'Trick-taking',
    subcategory: 'Point-Trick',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '30-45 minutes',
    origin: 'China',
    originName: 'Da Bai Fen (打百分)',
    deck: '54 cards (Standard 52 + 2 Jokers)',
    alsoKnownAs: [
      'Da Bai Fen',
      'Hundred Points',
      'Contesting 100 Points',
      'Dui Zhu',
      'Si Shi Fen',
      'Shuan Er',
    ],
    playersDisplay: '4 (Partnerships)',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
