    historyContent: {
      origins: 'Dates back to at least the early 1700s in France. It was a popular parlor game among the bourgeoisie before being overshadowed by BÃ©zique and Belote.',
      originCountries: [
        'France',
      ],
      timeline: [
        '1710s: First descriptions of Minette appear in gaming manuals.',
        '1800s: Remains a niche but respected game in regional France.',
        'Present: Rarely played, mostly of interest to historical card game researchers.',
        '20th Century: Documented by historians like David Parlett as a precursor to modern French partnership games.',
      ],
      evolution: "The game's 'Exchange' mechanic (discarding and drawing) served as a blueprint for the more famous Ã‰cartÃ©.",
      cultural: 'Reflects the formal, turn-based social play of the French Enlightenment.',
