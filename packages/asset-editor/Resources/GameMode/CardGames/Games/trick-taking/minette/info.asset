        pages: [
          {
            title: 'Minette (Minet)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Minette (or Minet) is a traditional 18th-century French card game for two players. It is a point-trick game played with a 32-card Piquet deck, sharing similarities with games like Ã‰cartÃ© and Mariage. It is notable for its 'Exchanges' phase and the focus on capturing specific high-value cards while navigating the constraints of a small deck.",
              },
              {
                type: 'paragraph',
                text: 'Dates back to at least the early 1700s in France. It was a popular parlor game among the bourgeoisie before being overshadowed by BÃ©zique and Belote.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players only. Minette is played exclusively by two players; each is dealt twelve cards and the remaining eight cards form the talon (stock), from which trump is determined. There are no partnerships.',
              },
              {
                type: 'paragraph',
                text: '32 cards (A, K, Q, J, 10, 9, 8, 7).',
              },
              {
                type: 'paragraph',
                text: '32 cards (A, K, Q, J, 10, 9, 8, 7).',
              },
              {
                type: 'paragraph',
                text: "Each player is dealt 12 cards. The remaining 8 cards form a 'Talon' (Stock).",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Standard: Standard two-player Minette with 12 cards each and 8-card talon; trump from talon.',
                  },
                  {
                    text: 'With exchange: Variant allowing players to discard and draw from the talon (exchange phase) before or during play.',
                  },
                  {
                    text: 'No exchange: Play without talon exchange; deal 12 each and play 12 tricks only.',
                  },
                ],
              },
            ],
          },
        ],
      },
