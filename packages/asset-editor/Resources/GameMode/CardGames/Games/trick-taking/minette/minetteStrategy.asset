    tips: [
      {
        title: 'Tip',
        description: 'Memory: Since 12 cards are dealt to each, and 8 are in the talon, you initially know 12/32 cards. Pay attention to the trump card!',
      },
      {
        title: 'Tip',
        description: "Focus on the 'Last Trick' (10 bonus points) as it often determines the winner in a close 60-point match.",
