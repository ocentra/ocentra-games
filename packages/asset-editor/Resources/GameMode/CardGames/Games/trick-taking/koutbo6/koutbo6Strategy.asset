    advanced: 'The Joker Lead: Lead the Black Joker if you want to flush out the Red Joker early. This clears the way for your Trump Ace to become the most powerful remaining card.',
    tips: [
      {
        title: 'Tip',
        description: "Never bid 'Bawan' (9) unless your team has at least 5 of the 9 trumps and both Jokers.",
      },
      {
        title: 'Tip',
        description: "Communication (within rules) is key. Watch your partners' discards to see which suits they are void in.",
