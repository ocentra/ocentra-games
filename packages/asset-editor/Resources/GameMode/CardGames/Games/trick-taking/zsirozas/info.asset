        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Zsírozás',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Zsírozás ('Greasing') is a traditional Hungarian trick game. 2-4 players. 32-card Hungarian deck. Suits are IRRELEVANT. Win trick by matching rank of led card (last match wins). Sevens are WILD. Capture 'zsír' (grease) cards: Aces + Tens (10pts each, 80 total). 40+ pts wins hand.",
              },
              {
                type: 'paragraph',
                text: "Zsírozás (Zsíros or Zsír) belongs to an unusual group of card games found only in Central and Eastern Europe. It is closely related to the Czech Sedma, Serbian/Bosnian Sedmice, Romanian Șeptică, and Hola; the name means 'to fatten' in Hungarian, referring to playing aces or tens into tricks. The game may have originated in Hungary or Poland and spread through the region; it has been played in Hungary at least since the 1930s.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '32 Hungarian cards (A-K-Felső-Alsó-10-9-8-7). 4 suits ignored.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: '2p: 4 each + stock. 4p: 8 each.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Long game: Play to 10 game points instead of 5.',
                  },
                ],
              },
            ],
          },
        ],
