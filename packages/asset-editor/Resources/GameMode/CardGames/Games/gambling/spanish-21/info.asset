    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Spanish 21',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Spanish 21 (known internationally as Pontoon in Australia, not UK classic Pontoon) is a variant of Blackjack played with 'Spanish' decks (48 cards, removing the 10s). The removal of 10s increases the house edge, but this is compensated by extremely player-friendly rules such as 'Player 21 always wins', 'Surrender after Double', and special bonus payouts for specific 21 combinations (6-7-8, 7-7-7). It is highly popular in casinos.",
              },
              {
                type: 'paragraph',
                text: 'Introduced in Nevada casinos in 1995 by Masque Publishing. Based on the lack of 10s which favors the house.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'One to seven players at the table, each playing independently against the dealer. Standard blackjack layout; six or eight Spanish decks in a shoe.',
              },
              {
                type: 'paragraph',
                text: 'Spanish Deck (No 10s).',
              },
              {
                type: 'paragraph',
                text: 'Spanish Deck (No 10s).',
              },
              {
                type: 'paragraph',
                text: 'Standard Blackjack deal. 2 cards each. Dealer gets hole card.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Dealer stands on soft 17: House rule: dealer stands on soft 17. Lower house edge (about 0.40%).',
                  },
                  {
                    text: 'Dealer hits soft 17: House rule: dealer hits soft 17. Redoubling allowed (up to three times) gives house edge about 0.42%; without redoubling about 0.76%.',
                  },
                ],
              },
            ],
          },
        ],
      },
