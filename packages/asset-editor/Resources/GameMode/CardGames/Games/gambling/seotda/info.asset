        rules: {
          objective: 'Form the highest-ranking two-card hand (GwangTtaeng, Ttaeng, or Geut) to beat opponents and win the pot; players may fold to minimize losses.',
          gameplay: '1. Card distribution: Each player is dealt two cards.\n2. Betting rounds: After receiving cards, players in turn may Call (match the current bet), Raise (increase the bet), or Fold (drop out and forfeit stakes).\n3. Showdown: After the final betting round, remaining players reveal their cards; the highest-ranking combination wins the pot.',
          keyRules: [
            'Hand rankings: GwangTtaeng (e.g. 3-8 Gwang) beats Ttaeng (pairs); Ttaeng beats Geut (sum of values, last digit); special hands 4-7 and 3-7 override certain combinations.',
            'Betting: Call, Raise, or Fold each round; the best hand at showdown wins.',
            'Traditional Seotda uses 20 Hwatu cards; LA Seotda uses a 52-card deck with poker-style bonuses (Ttaeng Value).',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Learn hand rankings (GwangTtaeng, Ttaeng, Geut, MangTong) and when to fold weak hands to limit losses.',
          intermediate: "Bet early with strong hands (Ttaeng or higher) to pressure opponents; fold weak hands early; watch opponents' betting patterns to infer hand strength.",
          advanced: 'Know special hands (47 Amhaeng Eosa, 37 Ttaeng Jabi) and when they apply; balance bluffing with value betting; exploit opponents who call or raise too often.',
          tips: [
            'If your hand is weak, fold early to minimize losses.',
            'With Ttaeng or higher, raise to pressure opponents.',
            "Pay attention to opponents' betting patterns to read hand strength.",
          ],
