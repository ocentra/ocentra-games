    tips: [
      {
        title: 'Tip',
        description: "In many variations, the 'King of Spades' is the absolute tie-breaker. If you hold it, you can never lose a tie.",
      },
      {
        title: 'Tip',
        description: "If playing online, watch for 'Super Niu Niu' side bets that pay for 5-card-face-card hands (Five Dukes).",
