    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Rang Milanti',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Rang Milanti (Bengali for 'Suit Matching') is a spirited children's game from Bengal that is part of the 'War' and 'Slap' family of card games. Unlike Western War which compares rank, Rang Milanti is purely about the visual recognition of suits. Players race to match the suit of the previously played card to claim the entire central pot. It is a game of luck, speed, and endurance, often used to introduce young children to the four suits of a standard deck.",
              },
              {
                type: 'paragraph',
                text: "Roots in traditional Bengali village play. It is a simplified domestic variant of more complex 'Rang' (trick-taking) games, designed so that children who cannot yet rank cards can still participate using color and shape recognition.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six players. The game is typically played with a full 52-card pack; when there are more players, two packs are often mixed together so cards divide evenly. Three or four players is common. Each player receives an equal share of the deck as a face-down pile.',
              },
              {
                type: 'paragraph',
                text: '52 cards (or 40 cards if removing 2s-6s). All cards are dealt face-down equally.',
              },
              {
                type: 'paragraph',
                text: '52 cards (or 40 cards if removing 2s-6s). All cards are dealt face-down equally.',
              },
              {
                type: 'paragraph',
                text: 'All cards dealt out equally to the players. Any remainder is stacked face up in the centre to begin the play pile. Each player holds their cards as a face-down deck.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Standard 52-card pack: Play with a full standard 52-card pack; most common today.',
                  },
                  {
                    text: '40-card pack: Traditional variant using the cards removed from packs for Twenty-Nine (2-6 of each suit from two packs combined); 10 cards per suit.',
                  },
                  {
                    text: 'Double pack: Two standard 52-card packs mixed together for a large number of players.',
                  },
                ],
              },
            ],
          },
        ],
