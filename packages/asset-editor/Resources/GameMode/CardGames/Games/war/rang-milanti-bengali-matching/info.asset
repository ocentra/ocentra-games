    historyContent: {
      origins: "Roots in traditional Bengali village play. It is a simplified domestic variant of more complex 'Rang' (trick-taking) games, designed so that children who cannot yet rank cards can still participate using color and shape recognition.",
      originCountries: [
        'India',
        'Bangladesh',
      ],
      timeline: [
        '1900s: Traditional Bengali oral history records this as a common fireside game.',
        "1960s: Standardized into the 'Bengali Children's Games' collections.",
        '1990s: Often played in schools during recess for its simplicity and fast turnover.',
        'Present: Remains a cultural staple in West Bengal and Bangladesh.',
      ],
      evolution: "The game moved from a purely luck-based 'War' variant into a faster 'Snap' style game in some regions, though the 'Suit Match' remains the core mechanic.",
      cultural: "The name 'Rang' translates to 'Color' or 'Suit', and 'Milanti' means 'to match' or 'to meet'.",
    },
