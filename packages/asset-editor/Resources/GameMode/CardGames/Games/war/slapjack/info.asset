  data: {
    hero: {
      title: 'Slapjack',
      subtitle: 'War',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Slapjack',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Slapjack (or 'Slaps') is a children's card game that tests speed and reflexes. Players take turns flipping cards onto a central pile. When a Jack appears, the first player to slap the pile wins all the cards in the center. The goal is to collect the entire deck.",
              },
              {
                type: 'paragraph',
                text: "Dates back to the 19th century as 'Beggar My Neighbor' variant. The physical act of slapping makes it a perennial favorite for kids.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to eight players; sources recommend about 4–10 for best play. Each player holds their cards as a face-down pile and takes turns flipping to a center pile. Play proceeds clockwise.',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card French deck. The pack is divided roughly equally between all players; everyone holds their cards as a face-down pile. No jokers or extra cards are used.',
              },
              {
                type: 'paragraph',
                text: 'Standard playing cards, table.',
              },
              {
                type: 'paragraph',
                text: 'Deal entirely to players face-down into personal piles.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Time limit: Set a time limit; the player with the most cards when time runs out wins.',
                  },
                  {
                    text: 'Double Slap: Slap on matching doubles (e.g. 6-6) as well as on Jacks.',
                  },
                  {
                    text: "Say Slapjack: Player must say 'Slapjack!' when covering the pile; if they fail, they do not get the pile. If they say it and the card is not a Jack, the other players divide the pile.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
