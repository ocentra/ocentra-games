    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Camicia',
            subtitle: 'Italian War',
            content: [
              {
                type: 'paragraph',
                text: "Camicia (Italian for 'Shirt') is a simple game of pure luck for two players. It is the Italian version of Beggar My Neighbour. Players turn over cards alternately; Aces, 2s and 3s are 'attack' cards that force the opponent to play 1, 2, or 3 cards respectively. If the defender cannot play an attack card in response, the attacker wins the pile.",
              },
              {
                type: 'paragraph',
                text: "Camicia is the Italian version of Beggar My Neighbour (also known as Strip Jack Naked or Beat Your Neighbor Out of Doors), a traditional children's card game played worldwide. The name 'Camicia' means 'shirt' in Italian, possibly referring to the idea of stripping your opponent of cards.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Camicia is played by exactly two players. Each player receives an equal share of the deck face down (20 cards each with a 40-card Italian deck, or 26 each with 52 cards). Players keep their cards in a packet and do not look at them; they take turns turning the top card face up onto the table.',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck (suits: swords, batons, cups, coins) or 52-card standard deck. Suits are ignored. Attack cards: Aces, 2s, 3s. Normal cards: 4-10, J, Q, K (or 4-7, J, Q, K in 40-card deck).',
              },
              {
                type: 'paragraph',
                text: '40 or 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'All cards dealt face down to the two players, 20 cards each (if 40-card deck) or 26 cards each (if 52-card deck). Players do not look at their cards.',
              },
            ],
          },
        ],
      },
    ],
