  data: {
    hero: {
      title: 'Animals',
      subtitle: 'Matching',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Animals',
            subtitle: 'The Noisiest Game in the World',
            content: [
              {
                type: 'paragraph',
                text: "Animals is a hilarious and chaotic reaction game derived from the classic Snap. While standard Snap requires players to shout 'Snap!' when ranks match, Animals requires each player to pick a specific animal and make that animal's sound (or shout its name) when a match occurs. It is a game of pure speed, observation, and auditory focus.",
              },
              {
                type: 'paragraph',
                text: "Originating as a parlor game variant of Snap in the late Victorian era, Animals became a popular children's party game due to its noisy and interactive nature.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-6 players. Each player MUST choose a distinct animal (e.g., Cat, Dog, Cow, Rooster) and tell the others.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Suits are irrelevant.',
              },
              {
                type: 'paragraph',
                text: 'Table, deck of cards.',
              },
              {
                type: 'paragraph',
                text: 'The entire deck is dealt out face down to the players as evenly as possible. Players keep their cards in a face-down pile and do not look at them.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'The Farmyard Snap: Instead of ranks, use a specialized deck where the animals are printed on the cards. You match the animal on the card to the sound you must make.',
                  },
                ],
              },
            ],
          },
        ],
      },
