      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kloepper',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Kloepper (literally 'Knocker' or 'Kloppen') is a high-energy German card game that blends rhythm, memory, and fast reaction times. Distinct from European trick-taking games, it is primarily a social shedding or 'slap' game where the objective is to hit the center pile when specific conditions are met (similar to 'Slapjack' or 'Taco Cat Goat Cheese Pizza'). It is often played as a fast-paced drinking or party game.",
              },
              {
                type: 'paragraph',
                text: "Part of the 'Slapjack' family of games found across Europe. It gained a distinct identity in German student circles and rural social gatherings ('Kneipen') during the 20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Best with 4 to 6 players.',
              },
              {
                type: 'paragraph',
                text: 'Usually a 32-card German deck (7 to Ace) or a standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Usually a 32-card German deck (7 to Ace) or a standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'All cards are dealt out evenly to the players face-down. Players may not look at their cards.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Kloppen (Bavarian): Uses German-suited cards with different chants (Unter, Ober, Sau).',
                  },
                  {
                    text: 'Slapjack: The international version where only Jacks are slapped.',
                  },
                  {
                    text: 'Stress: A two-player high-speed variant.',
                  },
                ],
              },
            ],
          },
        ],
