    hero: {
      title: 'LONGANA',
      subtitle: 'The Cuban Domino Classic',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Longana',
            subtitle: 'The Cuban Domino Classic',
            content: [
              {
                type: 'paragraph',
                text: "Longana is a vibrant and strategic Cuban domino game, often described as 'Domino Solitaire' for teams. Played with a double-nine set (55 tiles), it is famous for its 'arm' (train) mechanic where players build individual sequences extending from a central 'Spinner'. It is a game of blocking and opportunity, where players can force opponents to 'open' their arms, allowing others to dump unwanted tiles on them.",
              },
              {
                type: 'paragraph',
                text: "A regional evolution of the 'Mexican Train' and 'Matador' families, specifically adapted for the 55-tile double-nine deck in Cuba.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players individually (can be played with 2 or 3).',
              },
              {
                type: 'paragraph',
                text: '55 tiles (0-0 to 9-9).',
              },
              {
                type: 'paragraph',
                text: 'Double-nine domino set and flat surface.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 8 tiles (for 4 players) or 10 tiles (for 2-3 players). The rest form the boneyard.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Mexican Train: The American variant with a wider layout and custom 'train' tokens.",
                  },
                  {
                    text: 'Cuban Double-Six: Played with a 28-tile set and simpler matching.',
                  },
                  {
                    text: 'DominÃ³ Granma: A highly complex tournament variant.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Longana is a vibrant and strategic Cuban domino game, often described as 'Domino Solitaire' for teams. Played with a double-nine set (55 tiles), it is famous for its 'arm' (train) mechanic where players build individual sequences extending from a central 'Spinner'. It is a game of blocking and opportunity, where players can force opponents to 'open' their arms, allowing others to dump unwanted tiles on them.",
    tags: [
      'card-game',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 4,
    routePath: 'longana',
    LLM: "Game: Longana. Cuban dominoes, double-nine set (55 tiles). 2-4 players. Deal 8 each (4 players) or 10 each (2-3). Highest double leads = spinner. Each player has own arm. Play on your arm only. If cannot play, open your armâ€”others can then play on it. Close arm by playing on it. Winner scores opponents' pips. First to 100 wins.",
    Player: "Welcome to Longana! Build your personal 'arm' extending from the central spinner. If you can't play, you must OPEN your armâ€”then anyone can dump tiles on it! Close your arm by playing on it again. First to empty their hand wins the round and scores opponents' remaining pips. First to 100 wins!",
    tagline: "Build your train, but don't let others ride it.",
    gameCategory: 'Domino',
    subcategory: 'Connecting / Train',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-40 minutes',
    origin: 'Cuba',
    originName: 'Longana (juego de dominó cubano)',
    deck: 'Double-nine domino set (55 tiles)',
