    historyContent: {
      origins: "A regional evolution of the 'Mexican Train' and 'Matador' families, specifically adapted for the 55-tile double-nine deck in Cuba.",
      originCountries: [
        'Cuba',
      ],
      timeline: [
        'Early 20th Century: Double-nine dominoes become the standard in Cuban street culture.',
        '1950s: Longana rules stabilize as a distinct competitive variant in Havana social clubs.',
        'Present: A staple of the Cuban diaspora and the most popular domino variant in South Florida.',
        '2004: Standardized for international domino tournaments.',
      ],
      evolution: "The game's 'opening/closing' of arms was a strategic breakthrough that transformed dominoes from a simple matching game into a high-level psychological battle.",
      cultural: "In Cuba, Longana is often played at high speed with loud table-slapping, which is considered part of the game's intimidation and flair.",
    },
