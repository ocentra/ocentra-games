    tips: [
      {
        title: 'Tip',
        description: "The 0-0 (Double Blank) is the 'Lurker'. It carries 0 points but can block an entire arm if no one else has a blank. Play it early if your arm is open.",
      },
      {
        title: 'Tip',
        description: "Watch the 'Open' arms carefully. If someone opens an arm that matches a tile you have two of, play one there immediately to clear your hand.",
      },
