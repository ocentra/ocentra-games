  data: {
    LLM: 'Game: Jjak-mat-chu-gi. Logic: See rules.objective and rules.gameplay.',
    Player: "Jjak-mat-chu-gi (짝맞추기 - 'Making Pairs') is a traditional Korean domino game played with Gol-pae (bone tiles). Unlike Western dominoes where players match end-to-end, this is a 'pair-making' game where the objective is to form specific combinations (Civil and Military pairs). It is a draw-and-discard game similar in structure to Rummy but played with tiles.",
    objective: 'Be the first to form three complete pairs in your hand.',
    gameplay: "1. Players draw a tile from the reserve and discard one into the center.\n2. A player can 'chow' (claim) an opponent's discard ONLY if it completes a pair.\n3. Pairs are laid face-down until the hand is won.",
    keyRules: [
      "Each turn: either claim the previous player's discard to complete a pair, or draw one from the reserve.",
      'After acquiring a tile, lay down any completed pairs face down, then discard one tile face up.',
      'First to complete three pairs wins. With 2 or 3 players, 6-6 cannot be the third pair; with 4 players it can.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2 to 4 players.',
      deck: "32 tiles: 11 'Civil' pairs (matching) and 10 'Military' tiles (unique, paired by total spots).",
      equipment: "32 tiles: 11 'Civil' pairs (matching) and 10 'Military' tiles (unique, paired by total spots).",
      dealing: 'First player draws 6 tiles, others 5 each. Remaining tiles form a face-down reserve. First player is chosen by draw (tile 2-5 or highest spots plays first).',
    },
    turnFlow: "1. Players draw a tile from the reserve and discard one into the center.\n2. A player can 'chow' (claim) an opponent's discard ONLY if it completes a pair.\n3. Pairs are laid face-down until the hand is won.",
