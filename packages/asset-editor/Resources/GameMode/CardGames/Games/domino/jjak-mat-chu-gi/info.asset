  data: {
    hero: {
      title: 'JJAK-MAT-CHU-GI',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Jjak-mat-chu-gi',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Jjak-mat-chu-gi (짝맞추기 - 'Making Pairs') is a traditional Korean domino game played with Gol-pae (bone tiles). Unlike Western dominoes where players match end-to-end, this is a 'pair-making' game where the objective is to form specific combinations (Civil and Military pairs). It is a draw-and-discard game similar in structure to Rummy but played with tiles.",
              },
              {
                type: 'paragraph',
                text: "Dates back centuries in Korea, adapted from Chinese domino sets. It was first documented in Western literature by Stewart Culin in 1895 in his book 'Korean Games'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players.',
              },
              {
                type: 'paragraph',
                text: "32 tiles: 11 'Civil' pairs (matching) and 10 'Military' tiles (unique, paired by total spots).",
              },
              {
                type: 'paragraph',
                text: "32 tiles: 11 'Civil' pairs (matching) and 10 'Military' tiles (unique, paired by total spots).",
              },
              {
                type: 'paragraph',
                text: 'First player draws 6 tiles, others 5 each. Remaining tiles form a face-down reserve. First player is chosen by draw (tile 2-5 or highest spots plays first).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Win only by reserve: A player's third (winning) pair can only be made by matching a tile drawn from the reserve; winning by taking a discard is not allowed.",
                  },
                  {
                    text: 'Row draw: Shuffled tiles are placed in a row; tiles are drawn from one end of the row instead of a reserve pile.',
                  },
                  {
                    text: 'Alternative military pairing: Some sources use a different grouping for Military pairs: e.g. 2-6 with 3-6, 2-5 with 3-5, 2-4 with 3-4, 1-4 with 2-3, 1-2 with 4-5.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
