      ai: true,
      sources: true,
    },
    historyContent: {
      origins: "A modification of standard Block Dominoes that adds the 'spinner' mechanic â€” allowing play on all four sides of a double. This creates the cross-shaped layouts familiar from many American domino games.",
      originCountries: [
        'United States',
        'Netherlands',
      ],
      timeline: [
        'Traditional: Evolved from standard Block Dominoes as players sought more dynamic layouts.',
        '19th-20th century: Spinner mechanic becomes standard in many American and Dutch domino traditions.',
        'Present: One of the most common domino variants globally.',
      ],
      evolution: 'The spinner mechanic transforms the simple two-end block game into a multi-branch puzzle. American domino culture strongly favours spinners, while British and many European traditions play without them.',
      cultural: "The spinner mechanic is so dominant in American domino play that many Americans don't even know non-spinner variants exist. The 'chicken foot' layout style (angling tiles away from the spinner centre) reflects the practical table-space challenges of multi-spinner games.",
    },
    setupContent: {
      players: '2 to 4 players. Partnership play possible with 4.',
      deck: 'Double-six domino set (28 tiles). Can also use double-nine or double-twelve sets for more players.',
      equipment: 'Double-six domino set. Optional: Cribbage board for scoring.',
      dealing: '2 players: 7 tiles each. 3 players: 5 tiles each. 4 players: 5 tiles each. Remaining tiles stay in the boneyard.',
    },
    variationsContent: {
