        },
        {
          id: 'all-spinners',
          name: 'All Spinners',
          description: "Every double is a spinner â€” creates extremely branching layouts. Less strategic due to many open ends. Can require 'chicken foot' placement to fit on the table.",
        },
        {
          id: 'dutch-draw',
          name: 'Dutch Variant (with Draw)',
          description: 'When unable to play, draw 1-2 tiles from boneyard. Last two tiles remain undrawn. Double-zero counts as 13 pips.',
        },
        {
          id: 'double-nine-eight-arm',
          name: 'Double-Nine Eight-Arm',
          description: 'With double-nine set, play starts on all four sides AND four corners of the spinner, giving 8 arms.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Plays any legal tile on any open end. No end tracking.',
        medium: 'Tracks open ends and plans plays to maintain options. Basic suit control.',
        hard: 'Full tile counting. Optimal end management across all spinner arms. Partnership coordination. Blocking strategy.',
      },
      considerations: [
        'Multiple open ends (up to 4+) increase branching factor for AI search.',
        'Single-spinner vs all-spinners changes strategic depth significantly.',
        'Layout management: AI must consider physical table space constraints in all-spinners games.',
