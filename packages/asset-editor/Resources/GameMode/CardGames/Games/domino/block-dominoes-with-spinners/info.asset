  data: {
    hero: {
      title: 'BLOCK DOMINOES WITH SPINNERS',
      subtitle: 'The Cross-Layout Block Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Block Dominoes with Spinners',
            subtitle: 'The Cross-Layout Block Game',
            content: [
              {
                type: 'paragraph',
                text: "Block Dominoes with Spinners is a variant of Block Dominoes where the first double played becomes a 'spinner' â€” tiles can be placed on all four sides of it, creating a cross-shaped layout with up to four open ends. This dramatically increases the number of playable positions compared to the two-end standard block game. The key question is whether ONLY the first double is a spinner, or ALL doubles are spinners.",
              },
              {
                type: 'paragraph',
                text: "A modification of standard Block Dominoes that adds the 'spinner' mechanic â€” allowing play on all four sides of a double. This creates the cross-shaped layouts familiar from many American domino games.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players. Partnership play possible with 4.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set (28 tiles). Can also use double-nine or double-twelve sets for more players.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set. Optional: Cribbage board for scoring.',
              },
              {
                type: 'paragraph',
                text: '2 players: 7 tiles each. 3 players: 5 tiles each. 4 players: 5 tiles each. Remaining tiles stay in the boneyard.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Single Spinner: Only the first double is a spinner. Other doubles are placed crosswise but not expanded. The more strategic variant.',
                  },
                  {
                    text: "All Spinners: Every double is a spinner â€” creates extremely branching layouts. Less strategic due to many open ends. Can require 'chicken foot' placement to fit on the table.",
                  },
                  {
                    text: 'Dutch Variant (with Draw): When unable to play, draw 1-2 tiles from boneyard. Last two tiles remain undrawn. Double-zero counts as 13 pips.',
                  },
                  {
                    text: 'Double-Nine Eight-Arm: With double-nine set, play starts on all four sides AND four corners of the spinner, giving 8 arms.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Block Dominoes with Spinners is a variant of Block Dominoes where the first double played becomes a 'spinner' â€” tiles can be placed on all four sides of it, creating a cross-shaped layout with up to four open ends. This dramatically increases the number of playable positions compared to the two-end standard block game. The key question is whether ONLY the first double is a spinner, or ALL doubles are spinners.",
    tags: [
      'card-game',
      'domino',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 4,
    routePath: 'block-dominoes-with-spinners',
    LLM: "Game: Block Dominoes with Spinners. Double-six set. 2-4 players. First double = spinner (play on all 4 sides). Pass if can't play (block). Variant: single spinner vs all-spinners. Score by pip difference. Game to 61 or 101.",
    Player: 'The 6-6 spinner has been played on both long sides and one short side. Three open ends show: 3, 5, and 6 (the empty short side). You hold 6-2, 5-1, 3-3, and 4-4. Playing the 3-3 on the 3-end would open ANOTHER spinner if all-doubles-spin. Do you want more ends?',
    tagline: 'Doubles open four ways. More ends, more options, more chaos.',
    gameCategory: 'Domino',
    subcategory: 'Cross / Block Game',
    playerMode: 'multiplayer',
    difficulty: 'Beginner',
    duration: '10-25 minutes',
    origin: 'Western (traditional)',
    originName: 'Block Dominoes with Spinners',
    deck: 'Double-six domino set (28 tiles)',
    alsoKnownAs: [
      'Spinner Block',
      'Cross Block',
    ],
    playersDisplay: '2-4',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
