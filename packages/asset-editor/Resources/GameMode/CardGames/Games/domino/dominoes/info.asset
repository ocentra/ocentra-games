  data: {
    hero: {
      title: 'Dominoes',
      subtitle: 'Domino play and rules',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Dominoes',
            subtitle: 'Domino play and rules',
            content: [
              {
                type: 'paragraph',
                text: "Dominoes is a family of tile-based games played with rectangular 'domino' tiles. Each domino is a rectangular tile with a line dividing its face into two square ends. Each end is marked with a number of spots (also called pips, nips, or dobs) or is blank. The back of the dominoes in a set are indistinguishable, either blank or having some common design.",
              },
              {
                type: 'paragraph',
                text: "Dominoes originated in China in the 12th century (documented in the 'Customs and Traditions of Chu-chiang'). They were brought to Italy in the 18th century, likely by missionaries, where they were modified into the European double-six set.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players. Can be played in partnerships (2 vs 2).',
              },
              {
                type: 'paragraph',
                text: 'Standard double-six set (28 tiles).',
              },
              {
                type: 'paragraph',
                text: 'Domino set, flat surface.',
              },
              {
                type: 'paragraph',
                text: "Tiles are shuffled face-down ('washing'). Players draw a hand (usually 7 tiles for 2 players, 5 for 3-4 players). Remaining tiles form the 'boneyard'.",
              },
            ],
          },
        ],
      },
    ],
    description: "Dominoes is a family of tile-based games played with rectangular 'domino' tiles. Each domino is a rectangular tile with a line dividing its face into two square ends. Each end is marked with a number of spots (also called pips, nips, or dobs) or is blank. The back of the dominoes in a set are indistinguishable, either blank or having some common design.",
