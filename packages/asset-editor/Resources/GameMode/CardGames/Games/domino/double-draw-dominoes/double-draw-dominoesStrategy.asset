    tips: [
      {
        title: 'Tip',
        description: 'Both ends change on each successful play, so planning ahead is hard; focus on which suits will not be on the ends.',
      },
      {
        title: 'Tip',
        description: 'Calling blocked game stops play and scores hands; use it to limit how high scores get.',
