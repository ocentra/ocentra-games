  data: {
    hero: {
      title: 'Double Draw Dominoes',
      subtitle: 'Play two tiles per turn; draw when you cannot play.',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Double Draw Dominoes',
            subtitle: 'Play two tiles per turn; draw when you cannot play.',
            content: [
              {
                type: 'paragraph',
                text: 'Double Draw is a domino line game using a double-six set. Each turn a player must play two tiles at a time, one on each end of the line, matching by suit. If unable to play, the player draws one tile from the boneyard (when not empty) and passes. The round ends when someone empties their hand (dominoes), when the game is blocked, or when everyone has passed. Lowest pip count in hand wins the round; game is played to 100 points (two-player or partnership) or 61 points (three or four players).',
              },
              {
                type: 'paragraph',
                text: 'Variant of the standard draw domino game; documented in published rule references (Joe Celko, 2001). Requires playing two tiles at a time, one on each end of the line.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players. Best for two to four.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set (28 tiles).',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set.',
              },
              {
                type: 'paragraph',
                text: 'One player is dealer. Each player receives (8 minus the number of players) tiles. The dealer draws one tile at random from the remainder and turns it face up to start the line. Remaining tiles form the boneyard face down.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Partnership: Four players in two partnerships; partners sit opposite. Same rules; game to 100 points.',
                  },
                  {
                    text: '61 points (three or four-handed): When playing three or four-handed (non-partnership), game is played to 61 points so a cribbage board can be used for scoring.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
