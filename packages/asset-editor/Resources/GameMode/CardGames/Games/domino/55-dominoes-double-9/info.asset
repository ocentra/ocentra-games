      title: '55 DOMINOES (DOUBLE-9)',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: '55 dominoes (double-9)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: '55 dominoes (double-9) is a domino card game that involves tiles, matching, scoring. The game originated in China and has become popular worldwide.',
              },
              {
                type: 'paragraph',
                text: 'Double-9 set (55 tiles, 0-0 through 9-9). Block/draw dominoes; same matching rules as double-6. More players or longer games possible.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 4\nPartnerships: Optional',
              },
              {
                type: 'paragraph',
                text: 'Type: Standard 52-card deck\nNumber of Decks: 1\nJokers: Not included',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck\nScore sheet (optional)\nTable space',
              },
              {
                type: 'paragraph',
                text: 'Cards per Player: Varies by player count\nDealing Pattern: Clockwise\n--',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Double-9 block game: Standard double-9 block dominoes: players draw a starting hand from the 55-tile set, no further tiles are drawn during play, and the first to empty hand or hold the fewest pips when blocked wins.',
                  },
                  {
                    text: 'Double-9 draw game: Double-9 draw dominoes: players draw tiles from the boneyard whenever they cannot play to an open end until the stock is exhausted, then pass; the winner is the first out or the lowest pip total when blocked.',
                  },
                  {
                    text: 'Partnership double-9: Partnership version for four players seated in pairs, using the same double-9 set and block or draw rules but scoring and winning as teams instead of individuals.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
