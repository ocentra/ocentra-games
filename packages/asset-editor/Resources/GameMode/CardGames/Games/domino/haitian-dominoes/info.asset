    historyContent: {
      origins: 'Haitian Dominoes is part of Caribbean partnership domino traditions and is documented as a mainstream social game in Haiti.',
      originCountries: [
        'Haiti',
      ],
      timeline: [
        'Traditional era: Partnership dominoes become a staple social game in Haiti.',
        'Modern era: Standardized scoring terms such as Dekabes become widely documented.',
        'Current play: Home, street, and tournament variants continue with regional scoring differences.',
      ],
      evolution: 'The core structure stayed stable: anti-clockwise partnership play, blocked-round tie handling, and streak-based victory instead of long additive totals.',
      cultural: 'Table gestures between partners are commonly used in casual play, though some organized formats ban gestures.',
    },
    setupContent: {
      players: 'Exactly 4 players in fixed partnerships; partners sit opposite.',
      deck: 'One double-six domino set (28 tiles), shuffled face down.',
