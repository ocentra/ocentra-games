    hero: {
      title: 'HAITIAN DOMINOES',
      subtitle: 'Dekabes Partnership Rules',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Haitian Dominoes',
            subtitle: 'Dekabes Partnership Rules',
            content: [
              {
                type: 'paragraph',
                text: 'Haitian Dominoes is a 4-player partnership domino game using a double-six set. Teams race to build a 4-point streak where losing a round resets the loser score to zero.',
              },
              {
                type: 'paragraph',
                text: 'Haitian Dominoes is part of Caribbean partnership domino traditions and is documented as a mainstream social game in Haiti.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly 4 players in fixed partnerships; partners sit opposite.',
              },
              {
                type: 'paragraph',
                text: 'One double-six domino set (28 tiles), shuffled face down.',
              },
              {
                type: 'paragraph',
                text: 'Domino set and score tracker.',
              },
              {
                type: 'paragraph',
                text: 'Each player draws 7 tiles. Any player with 5 or more doubles may demand a full reshuffle and redeal. In first round, holder of the double-six tile starts by playing it. In later rounds, a member of the team that won the previous round starts.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'No Gestures: Championship or strict tables disallow partner gestures during play.',
                  },
                  {
                    text: 'Three-Point Dekabes After Tie: Some tables score 3 (not 4) for Dekabes immediately after a tied blocked round.',
                  },
                  {
                    text: 'Redeal Threshold Variant: Some groups use a different minimum number of doubles needed to force reshuffle.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Haitian Dominoes is a 4-player partnership domino game using a double-six set. Teams race to build a 4-point streak where losing a round resets the loser score to zero.',
