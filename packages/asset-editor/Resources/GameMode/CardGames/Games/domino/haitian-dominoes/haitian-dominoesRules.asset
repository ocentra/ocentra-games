    gameId: 'haitian-dominoes',
    icon: '🃏',
  },
  data: {
    LLM: 'Play proceeds anti-clockwise. On each turn a player must play one tile matching either open end of the layout if possible; otherwise they pass. A round ends when a player empties their hand or when the game is blocked and no one can play. Partners may communicate strength via pre-agreed gestures in casual play.',
    Player: 'Play proceeds anti-clockwise. On each turn a player must play one tile matching either open end of the layout if possible; otherwise they pass. A round ends when a player empties their hand or when the game is blocked and no one can play. Partners may communicate strength via pre-agreed gestures in casual play.',
    objective: 'Be the first team to reach 4 or more points while keeping the opposing team at zero through consecutive round wins.',
    gameplay: 'Play proceeds anti-clockwise. On each turn a player must play one tile matching either open end of the layout if possible; otherwise they pass. A round ends when a player empties their hand or when the game is blocked and no one can play. Partners may communicate strength via pre-agreed gestures in casual play.',
    keyRules: [
      'No drawing from stock after deal in the standard 4-player Haiti partnership game.',
      'Normal round win scores 1 point for the winning team.',
      'Dekabes: if final winning tile is non-double and can legally fit both open ends, score 2 instead of 1.',
      'Blocked round is won by team of player with fewest pips in hand; that team scores 1.',
      'If blocked round tie occurs between opponents on lowest pip count, the round is scoreless and next round winner gets 2 (or 4 if Dekabes).',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Exactly 4 players in fixed partnerships; partners sit opposite.',
      deck: 'One double-six domino set (28 tiles), shuffled face down.',
      equipment: 'Domino set and score tracker.',
      dealing: 'Each player draws 7 tiles. Any player with 5 or more doubles may demand a full reshuffle and redeal. In first round, holder of the double-six tile starts by playing it. In later rounds, a member of the team that won the previous round starts.',
    },
    turnFlow: 'Play proceeds anti-clockwise. On each turn a player must play one tile matching either open end of the layout if possible; otherwise they pass. A round ends when a player empties their hand or when the game is blocked and no one can play. Partners may communicate strength via pre-agreed gestures in casual play.',
    moveValidityConditions: {
      ante: 'Haitian Dominoes has no ante or betting; it is a partnership line game.',
      deal: 'Start of each round; if reshuffle condition triggers, redeal before play.',
      reveal_market: 'No market reveal; tiles are dealt to players only, no face-up market.',
      buy_market: 'No market purchase; all tiles are dealt to players at start of round.',
      buy_stock: 'No stock to buy; all tiles are dealt, no draw pile in standard Haiti rules.',
      fold: 'No folding; players must play or pass each turn until round ends.',
      check: 'No checking; Haitian Dominoes has no betting rounds.',
      call: 'No calling; this is a partnership domino game with no betting.',
      bet: 'No betting; scoring is by round wins and Dekabes, not chips.',
      raise: 'No raising; no betting in this partnership domino game.',
      declare: 'Allowed only in gesture-enabled variants; declaration cannot include explicit tile identity.',
      reveal_hand: 'Hands are not revealed during play; tiles are played to the line.',
      award_pot: 'Executed when round ends by empty hand or block.',
      play_card: 'Tile must match one current open end. If at least one legal play exists, pass is not allowed.',
      draw: 'No drawing after deal; each player has exactly 7 tiles per round.',
      discard: 'Tiles are played to the line, not discarded; no discard pile.',
      pass: 'Allowed only when hand contains no tile matching either open end.',
      bid: 'No bidding; play order and opener are determined by deal or prior round.',
      meld: 'No melding; dominoes are played to the line by matching ends.',
      go_out: 'Round ends when a player empties hand or line is blocked; no explicit go-out.',
    },
    exampleHands: [
      'Setup example: 7 card(s) per player.',
      'Rule example: Be the first team to reach 4 or more points while keeping the opposing team at zero through consecutive round wins.',
      'Turn-flow example: Play proceeds anti-clockwise. On each turn a player must play one tile matching either open end of the layout if possible; otherwise they pass. A round ends when a player empties their hand or when the game is blocked and no one can play. Partners may communicate strength via pre-agreed gestures in casual play.',
      'Scoring example: Streak scoring by team. Normal win gives 1 point; Dekabes gives 2. After a tied blocked round, next winner gets 2 (or 4 with Dekabes). Losing team resets to 0 each round. First team to reach 4 or more points wins the game..',
