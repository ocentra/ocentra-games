          {
            title: 'Domijong',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Domijong is a western domino variant that uses four double-six sets to produce a large duplicated-tile supply. This entry models the core as a connecting domino game; the enlarged supply shifts strategy toward mobility and robust end control rather than precise unique-tile inference.',
              },
              {
                type: 'paragraph',
                text: 'Domijong is encountered as a modern large-supply domino format that combines multiple standard sets to support larger groups and longer sessions.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 12 players.',
              },
              {
                type: 'paragraph',
                text: 'Four double-6 domino sets combined and mixed.',
              },
              {
                type: 'paragraph',
                text: 'Domino sets and optional score tracking by table profile.',
              },
              {
                type: 'paragraph',
                text: 'Deal tiles by player count; remaining tiles may form a boneyard by table profile.',
              },
            ],
          },
