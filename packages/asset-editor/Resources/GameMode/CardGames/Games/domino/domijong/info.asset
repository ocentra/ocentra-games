        rules: {
          objective: 'Play legal matching tiles and end hands under the table profile with the best resulting score.',
          gameplay: 'Players place a legal tile to a matching open end of the shared layout. When blocked, the table profile determines whether to draw or pass. Hands end when a player empties their hand or when play becomes blocked, and the match profile determines scoring.',
          keyRules: [
            'Tile placement must match an exposed open end value.',
            'Blocked turns resolve by a draw-or-pass profile.',
            'Hand-end and scoring depend on the match profile in use.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Preserve mobility and avoid accumulating high-pip tiles late in the hand.',
          intermediate: 'Duplication is extreme, so plan for probabilistic availability rather than unique-tile tracking.',
          advanced: 'Shape the layout to keep your own exit options wide while narrowing opponent mobility at critical moments.',
          tips: [
            'Avoid narrow dependencies on a single value; with many players, the table state can swing quickly.',
            'Prioritize flexible connectors and safe exits over speculative traps.',
          ],
          hasPlaceholders: false,
        },
