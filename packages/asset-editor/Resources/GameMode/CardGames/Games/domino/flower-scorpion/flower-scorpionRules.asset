  data: {
    LLM: 'Game: Flower & Scorpion (Bergen domino variant with dice). Setup: Double-six dominoes (28 tiles), 2-4 players, 5-6 tiles dealt per player. Roll phase: Caravan Master rolls dice to determine Flower (bonus) and Scorpion (penalty) values. Play phase: Players match domino ends to the Caravan line. Scoring: +2 for pair match, +3 for triple, +1 if end matches Flower number, -1 if end matches Scorpion number. Win: First to exhaust hand (domino). Draw: One tile from Oasis if no legal play exists.',
    Player: "Welcome to Flower & Scorpion, the desert caravan game. Roll the dice to set the Flower and Scorpion for this round. Match dominoes to the caravan, score points for pairs, and hit the Flower for bonuses. Avoid the Scorpion's sting. First to empty your hand wins the round.",
    objective: 'Score points by matching the exposed ends of the domino line (The Caravan) and hitting the Flower number, while avoiding the Scorpion number.',
    gameplay: "1. Caravan Master: Rolls all four dice to set the Flower and Scorpion values for the round.\n2. The Lead: The Caravan Master plays any tile to start the line.\n3. Matching: Players must match one end of the 'Caravan'. If unable, they must draw from the 'Oasis'.\n4. Doubles: Played across the line, creating more matching combinations for scoring.",
    keyRules: [
      "The Scorpion's Sting: You can be forced to play a 'Scorpion' tile if no other legal moves exist, taking the penalty points.",
      "Domino: The first player to exhaust their hand ('dominoes') wins the round and receives a bonus (usually 2 chips).",
      'Winning condition: Score points by matching the exposed ends of the domino line (The Caravan) and hitting the Flower number, while avoiding the Scorpion number.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2 to 4 players. Best with 4 (playing as individuals).',
      deck: 'Double-six domino set. 28 tiles.',
      equipment: "One pair of 'Flower' dice (e.g., Green) and one pair of 'Scorpion' dice (e.g., Red).",
      dealing: "Each player receives 5 or 6 tiles (depending on player count). Remaining tiles are placed face-down in the 'Oasis'.",
    },
    turnFlow: "1. Caravan Master: Rolls all four dice to set the Flower and Scorpion values for the round.\n2. The Lead: The Caravan Master plays any tile to start the line.\n3. Matching: Players must match one end of the 'Caravan'. If unable, they must draw from the 'Oasis'.\n4. Doubles: Played across the line, creating more matching combinations for scoring.",
