  data: {
    hero: {
      title: 'FLOWER & SCORPION',
      subtitle: 'The Desert Caravan Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Flower and Scorpion',
            subtitle: 'The Desert Caravan Game',
            content: [
              {
                type: 'paragraph',
                text: "Flower & Scorpion is an exotic variation of the domino game Bergen, traditionally associated with North African and Middle Eastern social circles. It combines standard domino-matching mechanics with the unpredictable element of dice rolling. Before each round, two pairs of dice are rolled to determine the 'Flower' (a lucky number that grants bonuses) and the 'Scorpion' (a cursed number that imposes penalties). Players act as members of a caravan, trying to match ends of the line (The Caravan) while navigating the hazards of the Scorpion's sting.",
              },
              {
                type: 'paragraph',
                text: 'The game is believed to have developed in Morocco and the surrounding Maghreb region during the colonial era. It likely blended French/German domino games (Bergen) with local gambling traditions involving Backgammon dice found in local bars and cafes.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players. Best with 4 (playing as individuals).',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set. 28 tiles.',
              },
              {
                type: 'paragraph',
                text: "One pair of 'Flower' dice (e.g., Green) and one pair of 'Scorpion' dice (e.g., Red).",
              },
              {
                type: 'paragraph',
                text: "Each player receives 5 or 6 tiles (depending on player count). Remaining tiles are placed face-down in the 'Oasis'.",
              },
            ],
          },
        ],
      },
    ],
    description: "Flower & Scorpion is an exotic variation of the domino game Bergen, traditionally associated with North African and Middle Eastern social circles. It combines standard domino-matching mechanics with the unpredictable element of dice rolling. Before each round, two pairs of dice are rolled to determine the 'Flower' (a lucky number that grants bonuses) and the 'Scorpion' (a cursed number that imposes penalties). Players act as members of a caravan, trying to match ends of the line (The Caravan) while navigating the hazards of the Scorpion's sting.",
    tags: [
      'card-game',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 4,
    routePath: 'flower-scorpion',
    LLM: 'Game: Flower & Scorpion (Bergen domino variant with dice). Setup: Double-six dominoes (28 tiles), 2-4 players, 5-6 tiles dealt per player. Roll phase: Caravan Master rolls dice to determine Flower (bonus) and Scorpion (penalty) values. Play phase: Players match domino ends to the Caravan line. Scoring: +2 for pair match, +3 for triple, +1 if end matches Flower number, -1 if end matches Scorpion number. Win: First to exhaust hand (domino). Draw: One tile from Oasis if no legal play exists.',
    Player: "Welcome to Flower & Scorpion, the desert caravan game. Roll the dice to set the Flower and Scorpion for this round. Match dominoes to the caravan, score points for pairs, and hit the Flower for bonuses. Avoid the Scorpion's sting. First to empty your hand wins the round.",
    tagline: "Roll for fortune. Match for points. Watch for the Scorpion's sting.",
    gameCategory: 'Matching',
    subcategory: "Children's",
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '15-30 minutes',
    origin: 'Middle East / North Africa / Morocco',
    originName: 'Flower and Scorpion',
    deck: 'Double-six Dominoes (28 tiles) + 2 sets of colored dice',
    alsoKnownAs: [
      'The Caravan Game',
      'Bergen with Dice',
      'Oasis',
      'Flower and Snake',
    ],
    playersDisplay: '2-4',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
