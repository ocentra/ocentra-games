    historyContent: {
      origins: 'The game is believed to have developed in Morocco and the surrounding Maghreb region during the colonial era. It likely blended French/German domino games (Bergen) with local gambling traditions involving Backgammon dice found in local bars and cafes.',
      originCountries: [
        'Morocco',
        'Algeria',
        'Tunisia',
      ],
      timeline: [
        'Early 20th Century: Variations of Bergen spread across North Africa.',
        '1940s-50s: The addition of dice and regional terminology (Oasis, Caravan Master) becomes standardized in local gambling dens.',
        '1990s: Documented by domino researchers like Joe Celko after interviewing players with North African heritage.',
        'Present: Played as a social game in Mediterranean cafes.',
      ],
      evolution: "Naming the boneyard the 'Oasis' and the dealer the 'Caravan Master' adds a thematic layer of survival in the desert to a mathematically focusnd game.",
      cultural: "Represented as a 'bar game' where matchsticks or small coins are used for the scoring pot.",
    },
    setupContent: {
      players: '2 to 4 players. Best with 4 (playing as individuals).',
      deck: 'Double-six domino set. 28 tiles.',
      equipment: "One pair of 'Flower' dice (e.g., Green) and one pair of 'Scorpion' dice (e.g., Red).",
      dealing: "Each player receives 5 or 6 tiles (depending on player count). Remaining tiles are placed face-down in the 'Oasis'.",
    },
    variationsContent: {
      list: [],
      noVariationsReason: 'Base ruleset only.',
    },
    aiContent: {
      difficulty: {
        easy: 'Ignores the Scorpion dice and takes penalty points constantly; draws from the Oasis prematurely.',
        medium: 'Tracks the Flower and tries to match it; avoids playing Scorpion tiles if possible; understands basic Bergen scoring.',
        hard: "Calculates the probability of forcing an opponent to sting themselves with the Scorpion; manages the Oasis count to induce a block on their own terms; perfectly tracks played tiles to know which 'ends' are safe.",
      },
      considerations: [
        'AI must weigh the +1/-1 dice bonuses against the higher value 2/3 point Bergen matches.',
      ],
    },
