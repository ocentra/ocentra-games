  data: {
    hero: {
      title: 'DOMINO CRIBBAGE',
      subtitle: 'Tile Pegging Duel',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Domino Cribbage',
            subtitle: 'Tile Pegging Duel',
            content: [
              {
                type: 'paragraph',
                text: 'Domino Cribbage is a hybrid game for two players that adapts the rules of the classic card game Cribbage to a set of double-six dominoes. Players score points by creating combinations of tiles (pairs, runs, and sums of 15) both during play and in their remaining hands. It is traditionally played with a cribbage board for scoring.',
              },
              {
                type: 'paragraph',
                text: 'Derived from Six-Card Cribbage, which dates back to the early 17th century (invented by Sir John Suckling). The domino adaptation emerged as a portable alternative for pub play.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players. One is designated the dealer, the other the non-dealer; they exchange roles after each hand. All 28 tiles are mixed, each player draws six tiles, then each discards two face down into the crib.',
              },
              {
                type: 'paragraph',
                text: 'A standard set of 28 double-six dominoes.',
              },
              {
                type: 'paragraph',
                text: 'Dominoes, Cribbage board (or score sheet).',
              },
              {
                type: 'paragraph',
                text: "All 28 tiles are face-down and shuffled. Each player draws 6 tiles. Two from each hand are discarded into a four-tile 'Crib' belonging to the dealer. One tile is turned over from the boneyard as the 'Starter'.",
              },
            ],
          },
        ],
      },
    ],
