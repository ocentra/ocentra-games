  data: {
    LLM: 'Game: Domino Cribbage. Deal 6, discard 2 to crib, peg totals, then score hands with starter tile.',
    Player: 'Manage crib discards and pegging totals to race along the scoring track.',
    objective: 'Be the first to reach 61 or 121 points on the cribbage board.',
    gameplay: '1. Pegging Phase: Starting with the non-dealer, players play one tile at a time, keeping a running total of the pips (0-31 limit). Points scored for reaching exactly 15 or 31, and for sequences or blocks of same-value tiles.\n2. The Show: After pegging, players score their remaining 4 tiles + the starter tile for combinations.\n3. The Crib: The dealer scores the 4 discarded tiles + the starter tile.',
    keyRules: [
      'The value of a tile is the SUM of its two ends (e.g., 5-3 = 8).',
      'Blank tiles (0-0) are valid and have value 0 for sums and sequences.',
      "Rules for 'Go' and '31' are identical to card cribbage.",
    ],
