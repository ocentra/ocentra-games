            title: '7-Toed Pete (Dominoes Variant)',
            subtitle: 'Domino game',
            content: [
              {
                type: 'paragraph',
                text: 'Seven-Toed Pete is a connecting domino game in the Fives family played with a double-six set. Four players build a cross-shaped layout from a single spinner, scoring whenever the open ends total a multiple of five and taking extra turns for scoring plays or doubles.',
              },
              {
                type: 'paragraph',
                text: 'Seven-Toed Pete is an American domino game in the Fives family, using a double-six set and scoring on multiples of five.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in the basic game; two or three players can play a draw variant with a boneyard.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set (28 tiles)',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set, scoring chips or markers',
              },
              {
                type: 'paragraph',
                text: 'For four players, each receives seven tiles and there is no boneyard. For two or three players, each receives seven tiles and the remaining tiles form a boneyard to draw from when unable to play.',
              },
            ],
          },
