    historyContent: {
      origins: 'Pai Gow (牌九) dates back to the Song Dynasty and is the ancestor of many modern partition games including Pai Gow Poker.',
      originCountries: [
        'China',
      ],
      timeline: [
        '960–1279: Origins in Song Dynasty China.',
        '19th Century: Widespread in Cantonese gambling houses.',
        '1980s: Adapted into Pai Gow Poker in California.',
        'Present: A core high-stakes game in Asian and global casino markets.',
      ],
      evolution: "The game transitioned from traditional bone tiles to acrylic casino tiles, with standardized 'House Way' rules added for modern dealer play.",
      cultural: 'Regarded as a game of high prestige; skilled players can identify tiles by feeling the indentations on the tile faces.',
    },
    setupContent: {
      players: 'Up to eight players sit around a table; the role of banker rotates among players counter-clockwise.',
      deck: 'A unique set of thirty-two tiles where eleven specific tiles are duplicated to form matched pairs.',
