        pages: [
          {
            title: 'Dice and Dominoes',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Dice and Dominoes is a western domino table game that combines domino connecting play with an auxiliary dice-driven table profile for pace or scoring. This entry models the connecting core using two double-six sets; dice effects are treated as a configurable profile layer rather than changing tile legality.',
              },
              {
                type: 'paragraph',
                text: 'Dice-and-domino formats are encountered as modern table variants that add a dice layer to classic connecting play for pacing, constraints, or scoring tweaks.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 8 players.',
              },
              {
                type: 'paragraph',
                text: 'Two double-6 domino sets combined and mixed.',
              },
              {
                type: 'paragraph',
                text: 'Domino sets plus dice as required by the active table profile.',
              },
              {
                type: 'paragraph',
                text: 'Deal tiles by player count; remaining tiles may form a boneyard by table profile.',
              },
            ],
          },
        ],
      },
