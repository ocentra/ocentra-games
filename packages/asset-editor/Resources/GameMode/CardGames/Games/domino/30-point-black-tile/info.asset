        rules: {
          objective: 'Avoid taking tricks containing penalty tiles; 30 points in penalties per deal. Lowest total score wins.',
          gameplay: 'Leader plays a tile and nominates suit (0-6 or doubles). Others follow suit if possible; highest in led suit wins trick. Same as 11 and 21 Point Black Tile but 30 penalty points.',
          keyRules: [
            'Pass 3 tiles left before play',
            'Leader nominates suit each trick',
            'Follow suit when possible',
            '30 penalty points per deal; lowest wins',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Mark penalty tiles; use double-0 (lead as blank to win, as double to dump). Moon shots more frequent than in Hearts.',
          intermediate: "Lead low blanks to force 0-0 out; when passing, passing high tiles left helps neighbour's moon-shot.",
          advanced: 'Holding doubles and penalty tiles can defend against moon-shots. Same family as 11 and 21 Point Black Tile.',
          tips: [
            'Paint penalty-suit pips a different color.',
            '11, 21, and 30 Point Black Tile share the same core rules.',
          ],
