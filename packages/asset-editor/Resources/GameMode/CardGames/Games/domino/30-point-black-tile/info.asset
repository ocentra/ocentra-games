          {
            title: '30 Point Black Tile',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: '30 Point Black Tile is a Hearts-style domino game using a double-six set: 30 penalty points per deal. Three or four players pass three tiles left; leader nominates suit each trick. Lowest total score wins. Same family as 11 Point and 21 Point Black Tile.',
              },
              {
                type: 'paragraph',
                text: 'Hearts-style adaptation for double-six dominoes; 30 penalty points per deal. Same family as 11 Point and 21 Point Black Tile.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Three or four players use a double-six domino set. With three players each receives nine tiles and one tile remains face down; with four players each receives seven tiles. First player is chosen by drawing from the boneyard for highest pip total.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set (28 tiles)',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set',
              },
              {
                type: 'paragraph',
                text: 'Tiles dealt; each player passes 3 face-down to the left before play.',
              },
            ],
          },
        ],
      },
