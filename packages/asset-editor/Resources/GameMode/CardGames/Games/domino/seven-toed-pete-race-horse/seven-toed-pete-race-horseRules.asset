    icon: '🃏',
  },
  data: {
    LLM: 'Lead is by lot in the first hand and then rotates. Opening lead must be a double or a scoring starter tile such as 0-5, 1-4, 2-3, 4-6, or 5-5; if unavailable, lead passes onward. Players match open ends or pass if blocked. Any scoring play or any double gives an immediate extra turn. If a player uses their last tile on a scoring play or double, they are washed up and play continues among others. A hand ends when a player dominoes on a non-scoring non-double play, or when the game blocks.',
    Player: 'Lead is by lot in the first hand and then rotates. Opening lead must be a double or a scoring starter tile such as 0-5, 1-4, 2-3, 4-6, or 5-5; if unavailable, lead passes onward. Players match open ends or pass if blocked. Any scoring play or any double gives an immediate extra turn. If a player uses their last tile on a scoring play or double, they are washed up and play continues among others. A hand ends when a player dominoes on a non-scoring non-double play, or when the game blocks.',
    objective: 'Outscore opponents by making scoring plays and winning hands through domino or lowest blocked-hand pip total.',
    gameplay: 'Lead is by lot in the first hand and then rotates. Opening lead must be a double or a scoring starter tile such as 0-5, 1-4, 2-3, 4-6, or 5-5; if unavailable, lead passes onward. Players match open ends or pass if blocked. Any scoring play or any double gives an immediate extra turn. If a player uses their last tile on a scoring play or double, they are washed up and play continues among others. A hand ends when a player dominoes on a non-scoring non-double play, or when the game blocks.',
    keyRules: [
      'Opening lead must be a double or listed scoring starter.',
      'Any scoring play or double grants an immediate extra turn.',
      'No boneyard in the standard four-player game.',
      'A scoring/double final tile causes washed-up continuation, not immediate hand end.',
      'West Coast Race Horse style often uses all doubles as spinners.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Four players in the standard game; some groups also use partnership or 2-3 player variants.',
