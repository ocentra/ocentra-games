        rules: {
          objective: 'Be first to 101 (2p/partnership) or 61 (3-4p). Lowest pip total wins each hand.',
          gameplay: "1. Draw for lead. 2. Each turn: (a) add tile to either end of train, or (b) draw from boneyard (unless only 2 left), or (c) pass. 3. Doubles played across; not spinners. 4. Hand ends when one dominoes or nobody can play. 5. Score: lowest gets sum of losers' pips minus own total. Tie = no score.",
          keyRules: [
            'Three options: play, draw, or pass.',
            'Cannot draw when boneyard has only 2 tiles.',
            'Doubles across line; not spinners.',
            '101 target (2p/partnership); 61 (3-4p).',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Know when to pass, draw, or play. Stack two boneyard tiles to remember not to draw them.',
          intermediate: 'Bluff with draw or pass. Block opponents.',
          advanced: 'Optimal pass/draw/play sequencing.',
          tips: [
            'Passing can bluff opponents.',
            'Drawing can be strategic when you have no play.',
          ],
