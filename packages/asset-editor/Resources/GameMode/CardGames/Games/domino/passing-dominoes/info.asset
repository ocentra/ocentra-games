    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Passing Dominoes',
            subtitle: 'Draw Variant',
            content: [
              {
                type: 'paragraph',
                text: 'Passing Dominoes is a variant of Draw Dominoes in which players may pass instead of playing or drawing. Play to the train; lowest pip total wins the hand. First to 101 (2p/partnership) or 61 (3-4p) wins.',
              },
              {
                type: 'paragraph',
                text: 'Passing Dominoes (The Passing Game) is a common variation of Draw Dominoes, one of the early European line domino games that became established in England from the late 1700s alongside the Block Game. This variant adds a third option each turn—to pass instead of playing or drawing—which gives the game its name and introduces bluffing. The rules were contributed by Joe Celko and published online in September 2001.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4. Four can play partnership or individuals.',
              },
              {
                type: 'paragraph',
                text: 'Double-six set. Last two tiles cannot be drawn.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set.',
              },
              {
                type: 'paragraph',
                text: '2-3 players: 7 each. 4 players: 6 each. Remainder = boneyard.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Partnership: Four players as two teams.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
