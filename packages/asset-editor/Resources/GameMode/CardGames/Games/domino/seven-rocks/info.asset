            title: 'Seven Rocks',
            subtitle: 'Partnership Dominoes',
            content: [
              {
                type: 'paragraph',
                text: 'Seven Rocks is a four-player partnership domino game in the Fives family. Players build a cross-shaped layout, score when open ends total a multiple of five, and race to 250 points.',
              },
              {
                type: 'paragraph',
                text: 'Seven Rocks is a Fives-family domino game that became popular in California and the Southwestern United States, where tournament and book publication helped standardize play.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly 4 players in fixed partnerships (partners sit opposite).',
              },
              {
                type: 'paragraph',
                text: 'Standard 28-tile double-six set, from 0-0 to 6-6.',
              },
              {
                type: 'paragraph',
                text: 'Domino set and running score tracker (cribbage board or score sheet).',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 7 tiles; all tiles are dealt, so there is no boneyard.',
              },
            ],
          },
        ],
      },
