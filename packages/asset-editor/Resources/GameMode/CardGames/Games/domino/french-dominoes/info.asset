        prompts: {
          human: "Welcome to French Dominoes. You are one of four players. The first player to play the double-zero starts the game. Your goal is to empty your hand of all dominoes, or if that's not possible, to have the lowest remaining pip count. First player to reach 100 points is eliminated. Last player standing wins. Watch out for blocking plays from your opponents!",
          ai: 'Game: French Dominoes (Caribbean Domino Cross Game). Setup: 4 players, 7 dominoes each from double-six set (28 total). Opening: Double-zero holder poses double-zero to start the cross. Cross Formation: Four blank-ended dominoes must be played on the four sides of the center double before other dominoes extend. Arm Development: Dominoes are played to open ends, with doubles creating new arms. Scoring: Unplayed pips count as points; unplayed doubles count double. Winner: First to empty hand = 0 points; others sum pips. Game target: First player reaching 100+ points eliminated; last player standing wins. Draw rules: One tile from pile if no legal play; three consecutive passes end round.',
        },
        scoring: {
          description: 'Points are awarded based on remaining pips (dots) on dominoes. Lower scores are better. Players accumulate points across multiple rounds.',
          winCondition: "Last player remaining with a score below 100 points wins the entire game. When a player's cumulative score reaches 100+, they are eliminated.",
          cardValues: {
            pips: '1',
