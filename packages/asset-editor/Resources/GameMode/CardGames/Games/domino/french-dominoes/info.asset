    historyContent: {
      origins: 'French Dominoes originated in the Caribbean, particularly Jamaica, despite its European name. It likely developed from European domino traditions adapted to Caribbean gaming culture.',
      originCountries: [
        'Jamaica',
      ],
      timeline: [
        '18th-19th Century: European domino games brought to Caribbean by colonial traders.',
        'Early-Mid 20th Century: French Dominoes becomes standardized in Jamaican communities.',
        'Present: Remains a popular social game in Caribbean regions and among diaspora communities worldwide.',
      ],
      evolution: 'The game evolved from standard domino layouts by introducing the cross-formation rule, which adds strategic complexity by forcing players to first establish a foundation before extending plays.',
      cultural: 'French Dominoes is deeply embedded in Jamaican and Caribbean social culture, often played in bars, community centers, and family gatherings. It represents a blend of European game mechanics with Caribbean social gaming traditions.',
    },
    setupContent: {
      players: 'Exactly 4 players, competing individually (cut-throat style).',
      deck: 'Standard double-six domino set (28 tiles/bones).',
      equipment: 'Dominoes, paper and pencil for scoring.',
      dealing: 'Shuffle all 28 dominoes face-down. Each player draws 7 dominoes and places them in their rack. Remaining 0 dominoes stay as the draw pile.',
    },
    variationsContent: {
      list: [
        {
          id: 'zero_tile_value_ten',
          name: 'Alternative Zero Scoring',
          description: 'The double-zero domino counts as 10 points instead of 0, preventing anomalies where a player with only a blank tile in hand wins the round scoring 0.',
        },
        {
          id: 'no_blocking_penalty',
          name: 'Casual Rules (No Pass Penalty)',
          description: 'Three consecutive passes do not incur a 10-point penalty; the game simply passes back to the first player.',
        },
        {
          id: 'two_player_variant',
          name: 'Two-Player French Dominoes',
          description: 'Each player draws 12-13 dominoes. Play proceeds similarly but with only two competitors. Winning scores and blocking rules may be adjusted.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Plays randomly without tracking tiles. Ignores opponent hand sizes. Always plays first legal match found. No strategic blocking.',
        medium: 'Tracks approximate opponent hand sizes. Attempts to block common endings. Holds onto high doubles longer. Makes conscious decisions about which dominoes to extend.',
        hard: 'Maintains exact count of all played dominoes. Calculates tile probabilities for all players. Plays optimally to either empty hand first or achieve lowest score. Uses positional dominoes to maximize blocking potential. Recognizes endgame scenarios and switches strategy accordingly.',
      },
      considerations: [
        'AI must implement domino-counting (memorizing all 28 tiles and tracking which have been played).',
        'AI must evaluate two simultaneous win conditions: emptying hand vs. achieving lowest remaining pip count.',
        'AI must track opponent hand sizes and estimate their tile composition based on plays and draw patterns.',
        'Cross-blocking strategy: AI must recognize when limiting cross extensions favors its position.',
        'Penalty awareness: AI must account for 10-point penalties when evaluating pass vs. play decisions.',
      ],
    },
