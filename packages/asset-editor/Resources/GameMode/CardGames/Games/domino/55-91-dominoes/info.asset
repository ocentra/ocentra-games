            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: '55-91 dominoes is a domino card game that involves tiles, matching, scoring. The game originated in China and has become popular worldwide.',
              },
              {
                type: 'paragraph',
                text: 'Block/draw dominoes with double-9 (55 tiles) to double-12 (91 tiles). Same matching rules; set size and player count vary.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players depending on domino set size.',
              },
              {
                type: 'paragraph',
                text: 'Double-9 (55) or double-12 (91) domino set.',
              },
              {
                type: 'paragraph',
                text: 'Domino set and a playing surface or table.',
              },
              {
                type: 'paragraph',
                text: 'Draw tiles; the number per player depends on set size and player count, with any remainder forming a boneyard in draw games.',
              },
            ],
          },
