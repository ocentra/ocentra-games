        rules: {
          objective: 'Be first to empty your hand, or finish with the lowest remaining pip burden if play blocks.',
          gameplay: "A starting tile opens the layout. On turn, a player places one legal matching tile to an open end. If no legal play exists, the player follows the table's draw-or-pass rule. The deal ends when a player goes out or all players are blocked.",
          keyRules: [
            'Play one legal matching tile to an open end each turn.',
            'If blocked, follow draw-or-pass procedure defined by table rules.',
            'Deal ends on first empty hand or complete block.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Keep flexible tiles so you can answer multiple end states.',
          intermediate: 'Track exposed high-impact tiles to predict likely dead ends.',
          advanced: 'Shape end values to force opponents into low-probability responses.',
          tips: [
            'Avoid exposing a line end that only you can currently satisfy unless it also advances your exit.',
            'Preserve at least one flexible response tile for late hand.',
          ],
