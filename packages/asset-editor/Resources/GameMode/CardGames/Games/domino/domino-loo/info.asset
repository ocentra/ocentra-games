    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Domino Loo',
            subtitle: 'The Trick-Taking Domino Game',
            content: [
              {
                type: 'paragraph',
                text: "Domino Loo is a trick-taking game for 2 to 4 players, adapted from the classic 17th-century card game Loo. It uses a standard set of double-six dominoes and features a unique trump-selection process along with a 'widow' hand called the Miss.",
              },
              {
                type: 'paragraph',
                text: "Loo was a high-society gambling card game in the 17th century. The domino version emerged in the late 19th century, first documented in Berkeley's 'Dominoes and Solitaire' (1899).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2, 3, or 4 players.',
              },
              {
                type: 'paragraph',
                text: '28 standard double-six dominoes.',
              },
              {
                type: 'paragraph',
                text: 'Dominoes and gaming chips for the pool.',
              },
              {
                type: 'paragraph',
                text: "Each player receives 5 tiles. A 'turn-up' tile is flipped from the boneyard to determine trumps.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Point Loo: Played for 15 points instead of a chip pool.',
                  },
                  {
                    text: 'Five-card Loo: Standard version (described here).',
                  },
                  {
                    text: 'Three-card Loo: Faster variation with 3-tile hands.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Domino Loo is a trick-taking game for 2 to 4 players, adapted from the classic 17th-century card game Loo. It uses a standard set of double-six dominoes and features a unique trump-selection process along with a 'widow' hand called the Miss.",
    tags: [
      'card-game',
      'social',
      'trick-taking',
      'trump',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 4,
    routePath: 'domino-loo',
    LLM: "Game: Domino Loo. 2-4 players, double-six dominoes (28 tiles). Deal 5 each, turn up 1 for trumps (higher end = trump suit). Can swap for The Miss widow hand or drop out. Dealer may swap one tile for turn-up. 5 tricks. Must follow suit; must trump if void. Each trick = 1/5 of pool. Zero tricks = 'Looed' (penalty = pool amount).",
    Player: "Welcome to Domino Loo! I'll deal you 5 tiles and turn up one to set trumps. You can keep your hand, swap for The Miss (a mystery widow hand), or drop out. Win tricks to earn pool sharesâ€”but win zero tricks and you're 'Looed', paying a penalty! Follow suit if you can, trump if you can't. Dealer gets to swap for the turn-up trump tile.",
    tagline: 'Avoid the Loo, or pay the price.',
    gameCategory: 'Domino',
    subcategory: 'Trick-taking / Chinese Dominoes',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-40 minutes',
    origin: 'UK / USA',
    originName: 'Loo',
    deck: 'Double-six set (28 tiles)',
    alsoKnownAs: [],
    playersDisplay: '2-4',
    quality: 'complete',
    completeness: {
