    historyContent: {
      origins: "Loo was a high-society gambling card game in the 17th century. The domino version emerged in the late 19th century, first documented in Berkeley's 'Dominoes and Solitaire' (1899).",
      originCountries: [
        'UK',
        'USA',
      ],
      timeline: [
        '1600s: Card game Loo (originally Lanterloo) becomes popular in Europe.',
        "1899: George Bell ('Berkeley') documents the domino adaptation.",
        "Modern Era: Popular in 'Dealer's Choice' gaming nights as a variant of Boo-Ray.",
      ],
      evolution: "The game moved from elite salons to lower-class gambling houses over three centuries, simplifying its rules while maintaining the 'Loo' penalty.",
      cultural: 'Connected to the French game Lanterloo and the modern American game BourrÃ© (Boo-Ray).',
    },
