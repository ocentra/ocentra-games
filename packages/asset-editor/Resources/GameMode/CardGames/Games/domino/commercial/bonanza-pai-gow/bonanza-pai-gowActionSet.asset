    customActions: [
      {
        supported: true,
        description: 'Place a wager in the circle with the seat number; standard Pai Gow bet against the Banker. Win both hands to win; lose both to lose; one win and one lose pushes.',
        cost: '0',
        constraints: 'Optional; table min and max apply per circle. Player may skip main and play only Bonus or Tie.',
        isTerminating: false,
        effectType: 'bet',
        id: 'place_main_bet',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Place a wager in the circle labeled B. Player wins if their four tiles form one of eight Bonus hands (e.g. Supreme Pair and Heaven Pair 200:1, Lame Duck 20:1, Wong 1:1); does not compete against the Banker.',
        cost: '0',
        constraints: 'Optional; table limits apply. Pays on hand composition regardless of how hands are set.',
        isTerminating: false,
        effectType: 'bet',
        id: 'place_bonus_bet',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Place a wager in the circle labeled T. Player wins if their hand ties the Banker (even money, or 25:1/20:1 if low hand is at least a Gong).',
        cost: '0',
        constraints: 'Optional; same hand setting used for main and Tie adjudication.',
        isTerminating: false,
        effectType: 'bet',
        id: 'place_tie_bet',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Do not place the regular Pai Gow bet; player may still place Bonus and Tie bets.',
        cost: '0',
        constraints: 'Legal when player chooses not to wager on the main bet.',
        isTerminating: false,
        effectType: 'play',
        id: 'skip_main_bet',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Roll three dice to determine dealing order for the round.',
        cost: '0',
        constraints: 'Dealer only; performed at start of deal phase.',
        isTerminating: false,
        effectType: 'play',
        id: 'roll_dice',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Shuffle the 32-tile set and deal four tiles to each player and the Banker in order determined by the dice.',
        cost: '0',
        constraints: 'Dealer only; after dice roll.',
        isTerminating: false,
        effectType: 'play',
        id: 'deal_tiles',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Form two hands from four tiles: a High Hand (two tiles) and a Low Hand (two tiles). High Hand must rank at least equal to Low Hand per Pai Gow tile rankings.',
        cost: '0',
        constraints: 'Each player sets once; same setting used for main and Tie bet resolution.',
        isTerminating: false,
        effectType: 'play',
        id: 'split_tiles_high_low',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Banker reveals their four tiles and forms High Hand and Low Hand according to house way or optimal setting.',
        cost: '0',
        constraints: 'System or dealer; after all players have set.',
        isTerminating: false,
        effectType: 'play',
        id: 'set_banker_hands',
        effectHints: {},
      },
      {
        supported: true,
        description: "Compare each player's High Hand to the Banker's High Hand using Pai Gow tile rankings; ties broken by highest-ranking tile, then Banker wins.",
        cost: '0',
        constraints: 'System; during compare_resolve phase.',
        isTerminating: false,
        effectType: 'play',
        id: 'compare_high',
        effectHints: {},
      },
      {
        supported: true,
        description: "Compare each player's Low Hand to the Banker's Low Hand; when both low hands total 0, Banker wins the low hand.",
        cost: '0',
        constraints: 'System; during compare_resolve phase.',
        isTerminating: false,
        effectType: 'play',
        id: 'compare_low',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Resolve main bet: win both hands pays 1:1 minus commission; lose both loses bet; one win one lose pushes.',
        cost: '0',
        constraints: 'System; after high and low comparison.',
        isTerminating: false,
        effectType: 'play',
        id: 'settle_main',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Resolve Bonus bet per paytable (Supreme+Heaven 200:1 down to Wong 1:1); no commission. Paid regardless of hand setting if player also had main bet.',
        cost: '0',
        constraints: 'System; based on four-tile composition.',
        isTerminating: false,
        effectType: 'play',
        id: 'settle_bonus',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Resolve Tie bet: when player hand ties Banker hand, Tie bettors win even money or 25:1/20:1 for Gong or better on low.',
        cost: '0',
        constraints: 'System; when player hand ties Banker hand.',
        isTerminating: false,
        effectType: 'play',
        id: 'settle_tie',
        effectHints: {},
      },
    ],
