        rules: {
          objective: 'Be the first player to domino by playing all tiles.',
          gameplay: 'Highest double leads; if no one has a double, redeal. Players then place tiles into the Sevens triangle pattern: doubles progress by adjacent rank on the top row, while non-doubles are placed beneath according to the one-step pip progression pattern. If a player can play, they must play. If not, they draw one tile from boneyard; when boneyard is empty and no play is possible, they pass.',
          keyRules: [
            'Highest double starts the hand.',
            'If no double is held by any player, redeal.',
            'Must play if able.',
            'Draw from boneyard when blocked; pass only when boneyard is empty.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Prioritize moves that keep future placement options open in multiple triangle lanes.',
          intermediate: 'Track missing doubles and near-needed connector tiles to anticipate forced draws.',
          advanced: 'Steer play toward branches where opponents are likely to stall and draw repeatedly.',
          tips: [
            'Early control of top-row doubles strongly shapes the lower triangle development.',
            'Preserve flexible tiles that can satisfy multiple potential placements.',
          ],
          hasPlaceholders: false,
        },
