        tabLabel: 'About',
        pages: [
          {
            title: "Twist'em",
            subtitle: 'Domino Game',
            content: [
              {
                type: 'paragraph',
                text: "Twist'em (Double-Hand Dominoes) is a casino banking game played with a double-six domino set. Each player and the banker receive three tiles and arrange them into a top hand and a bottom hand (pip totals mod 10, nine high). Players bet against the banker; both hands must outrank the banker's two hands to win. Based on Pai Gow but with Western dominoes.",
              },
              {
                type: 'paragraph',
                text: 'Casino table game designed and patented by Olympian Gaming; Western domino version of Pai Gow.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-9 (one banker or house banks; up to eight others bet).',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set (28 tiles).',
              },
              {
                type: 'paragraph',
                text: 'Double-six dominoes, gaming table, chips.',
              },
              {
                type: 'paragraph',
                text: 'Each player places a bet and receives three tiles; banker receives three tiles.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'House bank: House or casino is the permanent bank; collects percentage of wins.',
                  },
                  {
                    text: 'Player bank: Player-banker position rotates; fee collected prior to deal.',
                  },
                ],
              },
            ],
          },
        ],
      },
