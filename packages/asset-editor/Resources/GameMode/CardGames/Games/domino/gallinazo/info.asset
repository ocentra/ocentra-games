    historyContent: {
      origins: "Gallinazo is particularly associated with San Lorenzo, Puerto Rico, and Guadalajara, Mexico. It represents an informal, highndvelocity version of dominoes that prioritizes social interaction and 'secret' scoring to keep the tension high until the final round.",
      originCountries: [
        'Puerto Rico',
        'Mexico',
      ],
      timeline: [
        'Mid-20th Century: Regional popularity grows in Caribbean and Mexican social clubs.',
        '1990s: Documented by researchers Jose Carrillo and Alfonso Garcia.',
        "Present: Remains a popular 'tavern game' for determining social obligations.",
      ],
      evolution: 'The game simplifies the branching paths of many domino variants into a single line of play, focusing the strategic depth on pip management rather than board control.',
      cultural: "The tradition of keeping scores secret until the 7th deal is a specific cultural trait of Gallinazo, designed to prevent players from 'teaming up' against the leader prematurely.",
    },
    setupContent: {
      players: 'Exactly 4 players, each playing for themselves.',
      deck: 'One double-six domino set (28 tiles).',
      equipment: 'One double-six domino set (28 tiles).',
      dealing: 'Each player receives 7 tiles, leaving no boneyard.',
    },
    variationsContent: {
      list: [],
      noVariationsReason: 'Base ruleset only.',
