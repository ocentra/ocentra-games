    aiContent: {
      difficulty: {
        easy: "Holds onto doublendtiles; doesn't track played suits; never attempts to block the game; ignores pip counts until it's too late.",
        medium: "Prioritizes playing highndpip tiles first; understands the 'Last Player' penalty risk; tracks visible tiles correctly.",
        hard: "Expertly calculates the total pips remaining in the game; deliberately blocks the board when its hand contains the 0-1 or 0nd0; maintains 'Secret Score' approximations for all opponents to adjust aggression in the 7th deal.",
      },
      considerations: [
        "AI must factor in the 'Secret Score' by estimating opponent pips based on their play speed and style.",
      ],
    },
