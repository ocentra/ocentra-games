          deckDescription: 'One standard 28-tile double-six domino set. Each tile has two ends showing zero to six pips; every combination from 0-0 through 6-6 appears exactly once. No playing cards or jokers; used for Bergen where matching and doubles score.',
          suitDescription: 'Tiles are matched by pip value at the open ends of the layout. There are no traditional suits; each end value zero through six can connect to any tile sharing that value. In Bergen, doubles and certain matches score points.',
          rankDescription: 'There is no rank hierarchy between tiles; play legality is determined by matching the pip value at an open end. Doubles (same pips on both ends) are often played crosswise and may score in Bergen.',
          dealPattern: 'Each player draws six tiles initially; two tiles are reserved in the boneyard.',
          bettingLimits: 'None',
          actions: {},
          handRankingSystem: 'None; points are awarded for matching open ends of the domino line.',
          rankingSystem: 'Header Scoring (2/3 pts)',
          useTrump: false,
          notApplicableReasons: {
            discardConfig: 'Tiles are played to the line or held; no discard or recycling pile exists in the game.',
            specialCards: 'Certain tiles score higher when creating matching ends but do not trigger automated effects.',
            declarationMechanism: 'Scoring is calculated immediately and publicly by all players; no hidden tokens are required.',
            trickConfig: 'Bergen is a line-matching domino game rather than a trick-taking competition.',
            fishingConfig: 'Bergen is a line domino game; tiles are played to the line, not captured in a fishing mechanic.',
          },
        },
        synthesis: {
          hero: {
            title: 'BERGEN',
            subtitle: 'The Double Header Domino Game',
            tagline: 'Match the ends. Score the headers. Empty your hand.',
          },
          shortDescription: 'A classic domino scoring game where you earn points every time both ends of the line match the same number. Two points for a double header. Three for a triple header (when one end is a double tile itself). First to 15 wins.',
          uiThemes: [
            'classic',
          ],
          uiLayout: {
            zones: [
              'hand',
              'stock',
              'custom:line',
