        rules: {
          objective: 'Play legal matching tiles and finish the hand or match with the best score under the table profile.',
          gameplay: 'Players place a legal tile to a matching open end of the shared layout. When blocked, the table profile determines whether to draw from a boneyard or pass. Hands end when a player empties their hand or play is blocked, and scoring follows the match profile.',
          keyRules: [
            'A played tile must match the value of an exposed open end.',
            'Blocked turns are resolved by draw-or-pass profile rules.',
            'Hand-end and scoring depend on the match profile in use.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Avoid being trapped with high-number tiles; keep connectors that match multiple common end values.',
          intermediate: 'Because the set is large, track which high values are scarce and avoid opening them without support.',
          advanced: 'Control the open ends to force opponents into awkward values while maintaining your own safe exits across a wider value range.',
          tips: [
            'Treat high-number tiles as both power and risk; do not expose them without a plan.',
            'Preserve flexible tiles that connect to multiple mid-range values.',
          ],
