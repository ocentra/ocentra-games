        tabLabel: 'About',
        pages: [
          {
            title: 'Thats It',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "That's It! is a western domino game played with a double-15 set, providing a very large tile pool for longer sessions and larger tables. Players use standard matching placements while managing mobility and pip exposure with higher-number tiles that increase blocking complexity and swingy end control.",
              },
              {
                type: 'paragraph',
                text: 'Double-15 domino games are encountered as modern North American-style expansions that use very large domino sets for long sessions and larger groups.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 10 players.',
              },
              {
                type: 'paragraph',
                text: 'One double-15 western domino set.',
              },
              {
                type: 'paragraph',
                text: 'Domino set and optional score tracking by match profile.',
              },
              {
                type: 'paragraph',
                text: 'Deal tiles by player count; remaining tiles form a boneyard if the profile uses draws.',
              },
            ],
          },
        ],
      },
