  data: {
    LLM: "Game: Austrian Dominoes. Type: Match-and-Draw. Rules: Double-8 set, 9 doubles removed (36 total). Matching: Side-to-side brick style. Goal: 100 points (opponents' pips).",
    Player: "Welcome to Austrian Dominoes! We've removed all nine doubles, so you have 36 tiles in play. The 8-7 is the highest card out there. Match your tiles to the sides of the bricks and see if you can reach 100 points first!",
    objective: 'To be the first player to reach 100 points across multiple rounds.',
    gameplay: "1. **Leading**: The player with the heaviest tile (8-7 being the heaviest in this set) leads first. 2. **Matching**: On your turn, you must place a tile where one of its ends matches an available end on the board. 3. **The Draw**: If you cannot play, you must draw from the boneyard until you find a playable tile. (Common house rule: maximum of 3 draws). 4. **Passing**: If the boneyard is empty and you cannot play, you pass. 5. **Ending**: A round ends when one player 'Dominoes' (empties their hand) or when the game is blocked.",
    keyRules: [
      'No Doubles: The absence of doubles means every tile is distinct and has two different numbers.',
      'The 8-7 Lead: The highest tile in play (8-7) always starts the first hand.',
      'Brick Formation: The tableau grows in two directions from the starting tile, but specifically in a side-by-side matching manner.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
