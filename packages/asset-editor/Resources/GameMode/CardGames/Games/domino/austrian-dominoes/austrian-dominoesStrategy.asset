    tips: [
      {
        title: 'Tip',
        description: 'If you are playing the 4-player block variant, remember that there is no boneyard. Information is perfect if you can track all 36 tiles.',
      },
      {
        title: 'Tip',
        description: "The 'Brick' layout can sometimes be confusing; visualize the ends as 'slots' that must match.",
