        rules: {
          objective: 'Be the first player to empty your hand, or minimize remaining pips in a blocked finish.',
          gameplay: 'A starting tile opens the layout. On each turn a player places one legal matching tile to an open end. If a player cannot move, the table profile determines whether they draw from a boneyard or pass. The hand ends when a player goes out or all players are blocked.',
          keyRules: [
            'Tiles must match an exposed pip value at an open end of the layout.',
            'A turn normally consists of placing one legal tile.',
            'Blocked turns resolve via draw-or-pass handling defined by the table profile.',
            'Hand ends on first empty hand or complete block resolution.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Keep a range of pip values available so you can respond to changing ends.',
          intermediate: 'Track which values are drying up to avoid getting trapped holding dead tiles.',
          advanced: 'Control end values to reduce opponent options while preserving your own safe exits.',
          tips: [
            'Avoid spending highly flexible connectors too early.',
            'In late hand, prioritize guaranteed plays over speculative end shaping.',
          ],
          hasPlaceholders: false,
        },
