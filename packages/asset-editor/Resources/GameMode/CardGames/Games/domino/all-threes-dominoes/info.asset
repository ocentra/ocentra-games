      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Makes any legal move, ignoring the multiples of three unless by accident.',
        medium: 'Always takes the move that yields the highest multiple of three available in their hand.',
        hard: 'Tracks which tiles have been played to predict what values are left in the boneyard. Blocks opponents from high-scoring end-totals.',
      },
      considerations: [
        "AI must perform 'Sum / 3' checks on every valid play.",
        "Weighting the 'Domino' bonus (ending the round) against the immediate 'Multiple' points.",
      ],
    },
