    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'All Threes (Dominoes)',
            subtitle: 'The Arithmetic Choice',
            content: [
              {
                type: 'paragraph',
                text: "All Threes is a classic 'point-scoring' domino game from the Muggins family. While the more common 'All Fives' focuses on multiples of five, All Threes requires players to calculate multiples of three to score. It is a game of quick mental arithmetic and positional blocking.",
              },
              {
                type: 'paragraph',
                text: "Part of the European layout games that emerged in the 18th and 19th centuries. It is the direct sibling to All Fives and the combined game 'Fives and Threes', which is a staple of British pub culture.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 (7 tiles each), 3 (5 tiles each), or 4 (5 tiles each).',
              },
              {
                type: 'paragraph',
                text: 'Standard Double-six set of 28 tiles.',
              },
              {
                type: 'paragraph',
                text: 'Domino tiles, cribbage board or score sheet.',
              },
              {
                type: 'paragraph',
                text: "Tiles are 'shuffled' face down (the 'wash'). Players draw their hand; remainders go to the 'Boneyard'.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Fives and Threes: The combined British favorite. Points are scored for multiples of 3 AND multiples of 5.',
                  },
                  {
                    text: "Block All Threes: No boneyard drawing. If you can't play, you simply pass.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "All Threes is a classic 'point-scoring' domino game from the Muggins family. While the more common 'All Fives' focuses on multiples of five, All Threes requires players to calculate multiples of three to score. It is a game of quick mental arithmetic and positional blocking.",
    tags: [
      'card-game',
      'domino',
      'social',
      'strategy',
      'traditional',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 4,
    routePath: 'all-threes-dominoes',
    LLM: 'Game: All Threes (Dominoes). Type: Scoring Layout. Rules: Doubles crosswise; Sum open ends; If Sum % 3 == 0, Score = Sum / 3. Boneyard drawing allowed. Goal: 250 points.',
    Player: "Welcome to All Threes. You have your tiles. Play them so the TWO ends of the line add up to 3, 6, 9, 12, 15, or 18. You'll get 1 point for every 3 in that total. If you can't play, you've got to visit the boneyard!",
    tagline: 'Master the multiples. Dominate the line.',
    gameCategory: 'Domino',
    subcategory: 'Fives and Threes Family',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '15-30 minutes',
    origin: 'United Kingdom / Europe',
    originName: 'All Threes',
    deck: 'Double-six set (28 tiles)',
    alsoKnownAs: [
      'Threes',
      'Multiple Threes',
      'Muggins (Threes Variant)',
    ],
    playersDisplay: '2-4',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
      variations: true,
      ai: true,
      sources: true,
    },
    historyContent: {
      origins: "Part of the European layout games that emerged in the 18th and 19th centuries. It is the direct sibling to All Fives and the combined game 'Fives and Threes', which is a staple of British pub culture.",
      originCountries: [
        'Europe',
        'United Kingdom',
      ],
      timeline: [
        '1800s: Muggins games (scoring layouts) gain popularity in Europe.',
        '1900s: All Threes becomes a recognized standalone variant in domino strategy books.',
        'Present: Popular in digital domino suites and European social clubs.',
      ],
      evolution: "The game simplified the complex 'spinner' rules of American All Fives to focus on a standard two-ended line layout, emphasizing the 'Threes' math.",
      cultural: "Commonly played alongside 'All Fives' as a training game for the more complex combined version popular in British leagues.",
    },
    setupContent: {
      players: '2 (7 tiles each), 3 (5 tiles each), or 4 (5 tiles each).',
      deck: 'Standard Double-six set of 28 tiles.',
      equipment: 'Domino tiles, cribbage board or score sheet.',
      dealing: "Tiles are 'shuffled' face down (the 'wash'). Players draw their hand; remainders go to the 'Boneyard'.",
    },
    variationsContent: {
      list: [
        {
          id: 'fives-and-threes',
