    tips: [
      {
        title: 'Tip',
        description: 'The highest possible score in one turn is 6 points (Sum 18). This happens if one end is a Double-6 (12) and the other is a 6.',
      },
      {
        title: 'Tip',
        description: "Memorize the 'Multiple of 3' totals: 3, 6, 9, 12, 15, 18.",
