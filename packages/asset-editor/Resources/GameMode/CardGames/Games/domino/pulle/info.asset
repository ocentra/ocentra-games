  data: {
    hero: {
      title: 'PULLE DOMINOES',
      subtitle: 'Austrian block domino',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pulle Dominoes',
            subtitle: 'Austrian block domino',
            content: [
              {
                type: 'paragraph',
                text: 'Pulle is a four-player block domino game from Austria using a double-8 set of 36 tiles (doubles removed). Players contribute an equal stake to the pool (Pulle). Each round, unplayed pip counts are added to running scores; players exceeding 100 are eliminated. Last survivor wins the pool. Buy-back and broken-pool rules apply.',
              },
              {
                type: 'paragraph',
                text: 'Austrian domino variant; described in Domino in vielen Spielarten (Fritz Beck, Vienna, 1960). Traditionally played for money.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players play as individuals. Each receives seven tiles from a 36-tile set (double-8 with nine doubles removed). No boneyard is used; it is a block game.',
              },
              {
                type: 'paragraph',
                text: 'Double-8 set with nine doubles removed (36 tiles).',
              },
              {
                type: 'paragraph',
                text: 'Double-8 domino set; optional stakes for the pool.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 7 tiles. No boneyard is used (block game). First round: holder of heaviest tile leads; thereafter the winner of the previous round leads.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Per-game payment: Winner of each round receives an amount from each opponent (e.g. 1.00 each); blocked-game winner receives half (e.g. 0.50 each). Tied blocked game: no payment, pip totals not added to running scores.',
                  },
                ],
              },
            ],
          },
        ],
      },
