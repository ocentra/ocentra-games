          deckDescription: 'One standard 28-tile double-six domino set. Each tile has two ends showing zero to six pips; every combination from 0-0 through 6-6 appears exactly once. No playing cards or jokers; used for Billitonnen (blocking domino) where the line is extended by matching ends.',
          suitDescription: 'Tiles are matched by pip value at the open ends of the layout. There are no traditional suits; each end value zero through six can connect to any tile sharing that value on one of its two ends.',
          rankDescription: 'There is no rank hierarchy between tiles; play legality is determined by matching the pip value at an open end. Doubles (same pips on both ends) may be played crosswise. The first player to empty their hand wins in this block game.',
          dealPattern: 'Tiles are drawn clockwise and placed in a hidden row.',
          bettingLimits: 'None',
          actions: {},
          handRankingSystem: 'None; victory is determined by being the first to empty the face-down row.',
          rankingSystem: 'Shedding / Blind Memory',
          useTrump: false,
          notApplicableReasons: {
            drawConfig: 'All tiles are distributed to the player rows at the start; no draw pile exists during the game.',
            discardConfig: 'Tiles are played to the line or returned face-down; no waste or discard pile is utilized.',
            specialCards: 'Domino tiles contribute only their pip values; no individual tile has a secondary action effect.',
            declarationMechanism: 'Results are determined by immediate physical tile matches; no hidden declaration tokens are required.',
            fishingConfig: 'Billitonnen is a line-matching game and does not use a capture-from-tableau fishing mechanic.',
            trickConfig: 'The game is a line-building shedding race rather than a competitive trick-taking game.',
          },
        },
        synthesis: {
          hero: {
            title: 'BILLITONNEN',
            subtitle: 'The Dutch Blind Domino Game',
            tagline: "You can't see your tiles. Turn, match, or remember.",
          },
          shortDescription: 'A charming Dutch blind domino game. Your tiles sit face-down in a row — turn over the leftmost one and hope it matches. If not, flip it back and remember where it is. Memory is your only weapon in this luck-heavy, laugh-filled game.',
