    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Billitonnen',
            subtitle: 'The Dutch Blind Domino Game',
            content: [
              {
                type: 'paragraph',
                text: "Billitonnen is a traditional Dutch domino game belonging to the 'Blind Hughie' family. Players draw their tiles but keep them face-down in a row, turning them over one at a time to play. The strong element of luck is tempered by memory—if you can remember the positions of tiles you've seen others fail to play, you gain a significant advantage. Traditionally played as light relief after a session of the more serious Dutch game Nos.",
              },
              {
                type: 'paragraph',
                text: 'Originating in the Netherlands, Billitonnen takes its name from Billiton (Belitung), an Indonesian island formerly part of the Dutch East Indies. It is a lighthearted variant of European line games, prized for its chaotic and social nature.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard double-six domino set (28 tiles).',
              },
              {
                type: 'paragraph',
                text: 'Standard pack.',
              },
              {
                type: 'paragraph',
                text: 'Players draw tiles based on count (2p=7, 3p=7, 4p=6). Tiles are placed in a face-down row in front of each player. No one may look at their tiles.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Blind Hughie: The English variant where players may sometimes choose which tile to flip instead of the leftmost.',
                  },
                ],
              },
            ],
          },
        ],
      },
