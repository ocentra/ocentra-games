    historyContent: {
      origins: 'Originating in the Netherlands, Billitonnen takes its name from Billiton (Belitung), an Indonesian island formerly part of the Dutch East Indies. It is a lighthearted variant of European line games, prized for its chaotic and social nature.',
      originCountries: [
        'Netherlands',
      ],
      timeline: [
        '19th Century: Blind domino games become popular in European cafes.',
        "Early 20th Century: Billitonnen establishes itself as the standard Dutch 'wind-down' game.",
        'Present: Still played in traditional Dutch gaming circles and recorded in national heritage archives.',
      ],
      evolution: "The game follows the 'Blind Hughie' template but introduces the strict 'Leftmost First' rule, which increases the frustration and humor of the game.",
      cultural: "A classic 'after-match' game, meant to be played with drinks and conversation rather than intense competitive focus.",
    },
