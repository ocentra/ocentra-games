  data: {
    LLM: 'Game: Billitonnen. 28 dominoes (double-6). 2-4 players. Tiles drawn face-down in a row. On turn: flip leftmost unflipped tile. If it matches either open end of the line, play it. If not, return it face-down. First to empty hand or fewest tiles at block wins. Memory of returned tiles is key advantage.',
    Player: '1. **Start**: A tile is drawn from the boneyard to start the line. 2. **The Turn**: On your turn, flip over the LEFTMOST face-down tile in your row. 3. **The Match**: If the tile matches either open end of the central line, you must play it. 4. **The Failure**: If the tile does not match, you must turn it face down again in its original position. 5. **Boneyard**: Unused tiles are not drawn; the game relies only on the initial hand.',
    objective: 'Be the first player to empty your face-down row by matching tiles to the central line.',
    gameplay: '1. **Start**: A tile is drawn from the boneyard to start the line. 2. **The Turn**: On your turn, flip over the LEFTMOST face-down tile in your row. 3. **The Match**: If the tile matches either open end of the central line, you must play it. 4. **The Failure**: If the tile does not match, you must turn it face down again in its original position. 5. **Boneyard**: Unused tiles are not drawn; the game relies only on the initial hand.',
    keyRules: [
      'You must always turn the leftmost tile first.',
      'Memory is your only tool: you must remember what tiles were returned face-down.',
      'The game ends when someone goes domino (empties row) or when no one can move (blocked).',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2 to 4 players.',
      deck: 'Standard double-six domino set (28 tiles).',
      equipment: 'Standard pack.',
      dealing: 'Players draw tiles based on count (2p=7, 3p=7, 4p=6). Tiles are placed in a face-down row in front of each player. No one may look at their tiles.',
    },
    turnFlow: '1. **Start**: A tile is drawn from the boneyard to start the line. 2. **The Turn**: On your turn, flip over the LEFTMOST face-down tile in your row. 3. **The Match**: If the tile matches either open end of the central line, you must play it. 4. **The Failure**: If the tile does not match, you must turn it face down again in its original position. 5. **Boneyard**: Unused tiles are not drawn; the game relies only on the initial hand.',
    moveValidityConditions: {
      ante: 'Billitonnen is a casual social game played for pride and memory rather than monetary antes.',
      deal: 'The initial distribution of tiles into face-down rows is performed by the system automated dealer.',
      reveal_market: 'This is a closed-tile memory game where all tiles are face-down; no public market exists.',
      buy_market: 'Players cannot purchase or swap tiles from any external area; they must play from their face-down row.',
      buy_stock: 'The boneyard is not used during play in this variant; every tile must come from the initial deal.',
      fold: 'Participation is mandatory for every turn until a player goes domino or the game becomes blocked.',
      check: 'The game uses a matching structure rather than a vying structure where checking would be appropriate.',
      call: 'There is no bet to match in Billitonnen; competition is based on tile matching and memory.',
      bet: "Progress is measured by emptying the player's row rather than through the wagering of chips or currency.",
      raise: 'There are no wagering rounds in this game, so the value of the hand cannot be increased via raises.',
      declare: 'Results are immediate upon flipping a matching tile; no separate declaration phase is required.',
      reveal_hand: "Tiles remain face down even from their owner until they are flipped for the turn's play attempt.",
      award_pot: 'Winner is determined by emptying their row rather than by awarding a physical or virtual pot.',
      play_card: 'Billitonnen is a domino game where tiles are placed on a line; card playing engine logic does not apply.',
      draw: 'All tiles are distributed at the start; no drawing phase exists once the play loop begins.',
      discard: 'Tiles must be matched to the line to be removed from the player row; no separate discard pile is used.',
      pass: 'Players must flip a tile every turn until they have no tiles left or the game is blocked.',
      bid: 'The game does not use a bidding system to determine the dealer or game objectives.',
      meld: 'This is a line-matching game based on single tiles rather than creating sets or sequences.',
      go_out: 'The round concludes automatically when a player flips and plays their final face-down tile.',
    },
    exampleHands: [
      'Opening deal: 2-4 player(s), 7 card(s) per player, 1 deck(s), initial visibility face_down.',
      'Opening flow: start in dealing; system may use deal_tiles_facedown before play_loop.',
      "Scoring check: The player who empties their hand first wins the round. In a blocked game, the player with the fewest remaining tiles wins. Expected outcome: Emptying the player's row or having the fewest tiles at a block..",
