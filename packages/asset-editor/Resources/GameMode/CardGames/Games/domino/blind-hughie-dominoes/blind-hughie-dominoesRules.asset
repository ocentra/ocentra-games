  data: {
    LLM: 'Game: Blind Hughie. Domino block variant. Tiles face-down in row. Flip rightmost each turn. Play if matches train end, else return face-down to left. Double-six set. 2-4 players. Score by pip count. Memory-based advantage. Game to 61 or 100.',
    Player: 'Your row has 3 tiles left. You remember that the tile now on the right was a 3-5 that failed two turns ago. The train ends are 3 and 6. The 3 end matches! Will it come up?',
    objective: 'Be the first player to play all tiles from your face-down row.',
    gameplay: '1. **Start**: A tile is turned from the boneyard to start the central line. 2. **Turn**: Flip over the RIGHTMOST face-down tile in your row. 3. **Match**: If the tile matches either open end of the line, you must play it. 4. **Cycle**: If the tile does not match, return it face-down to the LEFT end of your row. 5. **Boneyard**: Tiles in the boneyard are not used after the start.',
    keyRules: [
      'You must always flip the rightmost tile first.',
      'Returned tiles must be placed at the opposite end of the row to preserve their cycle order.',
      'The game ends when a player goes domino or the line is blocked.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2 to 4 players playing individually.',
      deck: 'Standard double-six domino set (28 tiles).',
      equipment: 'Standard pack, score sheet.',
      dealing: 'Players draw tiles based on player count (2p=7, 3p=5, 4p=5). Tiles are placed in a face-down row in front of each player. No one may look at their cards.',
    },
    turnFlow: '1. **Start**: A tile is turned from the boneyard to start the central line. 2. **Turn**: Flip over the RIGHTMOST face-down tile in your row. 3. **Match**: If the tile matches either open end of the line, you must play it. 4. **Cycle**: If the tile does not match, return it face-down to the LEFT end of your row. 5. **Boneyard**: Tiles in the boneyard are not used after the start.',
    moveValidityConditions: {
      ante: 'Blind Hughie is a casual social game and does not utilize a monetary or chip-based ante system.',
      deal: 'The initial distribution of tiles into face-down rows is handled automatically by the system dealer.',
      reveal_market: 'This is a closed-tile memory game where all tiles are face-down; no public market exists.',
      buy_market: 'Players cannot purchase or swap tiles from any external area; they must play from their face-down row.',
      buy_stock: 'The boneyard is not used during play in this variant; every tile must come from the initial hand.',
      fold: 'Participation is mandatory for every turn until a player goes domino or the game becomes blocked.',
      check: 'The game uses a matching structure rather than a vying structure where checking would be appropriate.',
      call: 'There is no pot or bet to match in Blind Hughie; competition is based on tile matching and memory.',
      bet: "Progress is measured by emptying the player's row rather than through the wagering of chips or currency.",
      raise: 'There are no wagering rounds in this game, so the value of the hand cannot be increased via raises.',
      declare: 'Results are determined by immediate physical tile matches; no separate declaration phase is required.',
      reveal_hand: "Tiles remain face down even from their owner until they are flipped for the turn's play attempt.",
      award_pot: 'Winner is determined by emptying their row rather than by awarding a physical or virtual pot.',
      play_card: 'Blind Hughie is a domino game where tiles are placed on a line; card playing engine logic does not apply.',
      draw: 'All tiles are distributed at the start; no drawing phase exists once the play loop begins.',
      discard: 'Tiles must be matched to the line to be removed from the player row; no separate discard pile is used.',
      pass: 'Players must flip a tile every turn until they have no tiles left or the game is blocked.',
      bid: 'The game does not use a bidding system to determine the dealer or game objectives.',
      meld: 'This is a line-matching game based on single tiles rather than creating sets or sequences.',
      go_out: 'The round concludes automatically when a player flips and plays their final face-down tile.',
    },
    exampleHands: [
      'Opening deal: 2-4 player(s), 7 card(s) per player, 1 deck(s), initial visibility face_down.',
      'Opening flow: start in dealing; system may use deal_tiles_facedown before play_loop.',
      "Scoring check: Winner scores sum of losers' pip totals minus their own remaining pips. Game to 100 (2-player) or 61 (3-4 player). Expected outcome: 100.",
