    tips: [
      {
        title: 'Tip',
        description: 'Keep track of the 0-0 (double-blank) tile. It is a powerful reset for end totals.',
      },
      {
        title: 'Tip',
        description: 'If playing partnerships, try to leave ends that your partner has expressed interest in by their previous draws.',
      },
