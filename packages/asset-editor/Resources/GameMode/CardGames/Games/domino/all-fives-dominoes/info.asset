    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'All Fives (Dominoes)',
            subtitle: 'The King of Stones',
            content: [
              {
                type: 'paragraph',
                text: "All Fives is the quintessential American domino game. Played with a double-six set, it challenges players to create 'scoring ends' that sum to a multiple of five. It is a game of rapid math, blocking, and tactical placement.",
              },
              {
                type: 'paragraph',
                text: "Derived from traditional European tile games, All Fives gained immense popularity in North America in the late 19th century. It is often referred to as 'Muggins' when played without the rule to call out scores.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players (7 tiles each) or 4 players in partnerships (5 tiles each).',
              },
              {
                type: 'paragraph',
                text: 'Standard 28-tile double-six set, from 0-0 to 6-6.',
              },
              {
                type: 'paragraph',
                text: 'Domino set, score sheet or scoreboard.',
              },
              {
                type: 'paragraph',
                text: "Tiles are 'washed' (shuffled) face down. Players draw their hand; remaining tiles are the 'Boneyard'.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Five Up: West Coast variant where every double is a spinner, potentially creating a many-armed layout.',
                  },
                  {
                    text: 'Sniff: A variant where the first double *can* be used as a spinner, but only after it has been played off of.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "All Fives is the quintessential American domino game. Played with a double-six set, it challenges players to create 'scoring ends' that sum to a multiple of five. It is a game of rapid math, blocking, and tactical placement.",
