      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: "Leads high tiles early to win 'meaningless' tricks. Runs out of ammunition before the 16th trick.",
        medium: "Maintains a 'Reserve' of Civil tiles for the final 3 tricks. Understands the basic tile hierarchy but fails to follow partner's leads.",
        hard: "Perfect tile-tracking. Knows exactly which 6-6 and 1-1 tiles are remaining. Will 'sacrifice' a high Military tile to force an opponent to play their final Civil high-rank.",
      },
      considerations: [
        'Must handle the Civil/Military dual-suit logic.',
        'Requires a group-play evaluator (can I beat 3 tiles at once?).',
      ],
    },
