    historyContent: {
      origins: 'Rooted in the ancient trade routes between Tibet and China. While it shares the civil/military tile hierarchy with Chinese Tien Gow, Bagchen evolved in the monasteries and aristocrat circles of Lhasa into a distinct game with unique scoring and grouping rules.',
      originCountries: [
        'Tibet',
      ],
      timeline: [
        '12th Century: Chinese dominoes (dice-based) reach Tibet.',
        '17th Century: Bagchen becomes a favorite pastime of the Tibetan nobility.',
        '1950s: Tibetan diaspora brings Bagchen to India, Nepal, and the West.',
        'Present: Still played with traditional hand-carved bone or plastic tiles in Tibetan communities worldwide.',
      ],
      evolution: 'The game shifted from a gambling-focused single-trick payout system to a more strategic session-based game where team cooperation is vital.',
      cultural: "Regarded as a game of high prestige. In traditional Tibetan society, a player's skill in Bagchen was seen as a reflection of their intellect and character.",
    },
    setupContent: {
      players: '4 players. No partnerships; play is clockwise.',
      deck: 'Two sets of Chinese dominoes (32 x 2 = 64). Each tile represents two dice faces.',
      equipment: '64 tiles, traditionally stored in a carved wooden box. A bowl for tokens/chips.',
      dealing: "Each player receives 16 tiles. Tiles are usually arranged in 'stacks' or 'walls' before being drawn.",
