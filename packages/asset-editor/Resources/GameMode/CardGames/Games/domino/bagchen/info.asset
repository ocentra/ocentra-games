    hero: {
      title: 'BAGCHEN',
      subtitle: 'The Great Game of Tibet',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bagchen',
            subtitle: 'The Great Game of Tibet',
            content: [
              {
                type: 'paragraph',
                text: "Bagchen (meaning 'Great Game' or 'Bird Game') is the national domino game of Tibet. Played with a double set of Chinese dominoes (64 tiles), it is a sophisticated trick-taking game similar to the Chinese classic Tien Gow. However, Bagchen introduces a brutal 'Scorched Earth' victory condition: winning individual tricks is merely a means to an end; the only trick that truly matters is the very last one. It involves complex 'set' leading, where players can play up to four tiles at once in coordinated formations.",
              },
              {
                type: 'paragraph',
                text: 'Rooted in the ancient trade routes between Tibet and China. While it shares the civil/military tile hierarchy with Chinese Tien Gow, Bagchen evolved in the monasteries and aristocrat circles of Lhasa into a distinct game with unique scoring and grouping rules.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players. No partnerships; play is clockwise.',
              },
              {
                type: 'paragraph',
                text: 'Two sets of Chinese dominoes (32 x 2 = 64). Each tile represents two dice faces.',
              },
              {
                type: 'paragraph',
                text: '64 tiles, traditionally stored in a carved wooden box. A bowl for tokens/chips.',
              },
              {
                type: 'paragraph',
                text: "Each player receives 16 tiles. Tiles are usually arranged in 'stacks' or 'walls' before being drawn.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Lhasa Short Game: A version where only 12 tricks are played (8 tiles per player) for faster sessions.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bagchen (meaning 'Great Game' or 'Bird Game') is the national domino game of Tibet. Played with a double set of Chinese dominoes (64 tiles), it is a sophisticated trick-taking game similar to the Chinese classic Tien Gow. However, Bagchen introduces a brutal 'Scorched Earth' victory condition: winning individual tricks is merely a means to an end; the only trick that truly matters is the very last one. It involves complex 'set' leading, where players can play up to four tiles at once in coordinated formations.",
    tags: [
      'card-game',
      'trick-taking',
      'social',
      'domino',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'bagchen',
    LLM: 'Game: Bagchen (Tibetan Dominoes). Type: Trick-taking. Rules: 64 tiles (double Chinese set). Civil/Military suits. Win ONLY if you take the 15th/16th (final) trick. Sets of 1-4 tiles lead. Scoring: 1 pt per final trick win.',
    Player: 'Welcome to the Bagchen wall. You hold 16 tiles of bone and destiny. The first 15 tricks are but shadowsâ€”everything depends on the 16th. Will you lead your Heaven tiles early, or wait for the supreme moment?',
    tagline: 'Many tricks are played, but only the last one decides the fate of the Bird.',
    gameCategory: 'Trick-taking',
    subcategory: 'Trick-taking / Chinese Dominoes',
    playerMode: 'multiplayer',
    difficulty: 'Expert',
