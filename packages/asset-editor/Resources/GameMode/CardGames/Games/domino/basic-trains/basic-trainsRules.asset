      raise: 'This game has no raise or betting.',
      declare: 'This game has no declare phase.',
      reveal_hand: 'Hands are not revealed in this phase.',
      award_pot: 'This game has no pot to award.',
      play_card: 'Tile end must match the open end of the target train. You may only play on your train, a train marked with a penny, or the Mexican Train. You must play if you have a legal move.',
      draw: 'Only when you have no legal play; boneyard must have tiles. You may not draw if you had a playable tile. After drawing, if the tile is playable you must play it.',
      discard: 'This game has no discard pile.',
      pass: 'This game has no pass action.',
