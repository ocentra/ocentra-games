    aiContent: {
      difficulty: {
        easy: 'Extends its own train when possible and sheds high tiles without considering opponents.',
        medium: 'Balances own-train continuity with pip reduction and takes safe optional plays on other trains.',
        hard: 'Tracks blocked numbers and opponent train ends to force passes while preserving its own exit route.',
      },
      considerations: [
        'AI must model multiple personal train ends.',
        'There is no boneyard, so inability to play provides strong information.',
        'Optional plays on other trains create sequencing choices after the own-train play.',
      ],
    },
