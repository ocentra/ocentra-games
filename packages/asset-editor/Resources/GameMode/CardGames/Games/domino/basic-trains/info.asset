    historyContent: {
      origins: 'Basic Trains belongs to the disconnected-layout train family of domino games. It uses the personal-train idea without the shared public train and without a boneyard, making it a simpler relative of later train games.',
      originCountries: [
        'International',
      ],
      timeline: [
        'Traditional era: Domino train games develop around personal lines of matching tiles.',
        'Modern era: Basic Trains is documented as a simple train-family ruleset for double-nine and double-twelve sets.',
      ],
      evolution: 'The game keeps the train-family structure but removes boneyard drawing and the shared Mexican Train, emphasizing the opening double and each player’s private train.',
      cultural: 'It is suitable for larger domino groups because the deal table supports four to ten players with larger double-nine or double-twelve sets.',
    },
    setupContent: {
      players: 'Four to ten players. The rules table gives hand sizes for double-nine and double-twelve sets according to player count.',
