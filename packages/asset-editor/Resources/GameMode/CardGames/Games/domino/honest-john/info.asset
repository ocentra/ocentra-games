    historyContent: {
      origins: 'A traditional North of England pub game. Recorded by Arthur Taylor in the Guinness Book of Traditional Pub Games.',
      originCountries: [
        'United Kingdom',
      ],
      timeline: [
        '19th-20th Century: Played widely in Bolton and surrounding Lancashire towns.',
        "1970s: Documented as a distinct 'star' variant in pub game lore.",
        'Present: Remains a localized tradition in specific English pubs.',
      ],
      evolution: "Likely evolved from standard 'block' dominoes but adapted to allow more players (up to 8) using a double-9 set.",
      cultural: "The name 'Honest John' refers to the honesty required when asking neighbors for specific tiles to complete your line.",
    },
    setupContent: {
      players: '4 to 8 players.',
      deck: 'Double-9 domino set (55 tiles).',
      equipment: 'Dominoes and a supply of chips or counters for scoring/buying (usually 20 per player).',
