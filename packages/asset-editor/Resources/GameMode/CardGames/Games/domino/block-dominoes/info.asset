        rules: {
          objective: 'Be the first player to play all tiles from your hand, or have the lowest pip count in a blocked game.',
          gameplay: '1. **Start**: The player with the highest double (usually 6-6) plays first. 2. **Turn**: Each player in turn must place one tile that matches the pip value of an open end of the line. 3. **Doubles**: Doubles are played crosswise but are not spinners; they only provide two matching ends. 4. **Passing**: If you cannot play, you must pass your turn. 5. **End**: The round ends when a player is out of tiles or no player can make a move.',
          keyRules: [
            'The line always has exactly two open ends.',
            'No drawing from the boneyard during play.',
            'In a blocked game, the player with the lowest total pips wins the round.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Lead with your strongest suit (the number you have the most of). This ensures you have more opportunities to play on the ends you create.',
          intermediate: 'Suit Control: Try to keep your strong suits at both ends of the line. This forces opponents to pass while you continue to shed tiles.',
          advanced: 'Blocking: If you have a hand with low pip counts, you may deliberately block the game if you know opponents have high cards they cannot play. Tracking played tiles is essential to know which suits are exhausted.',
          tips: [
            'Play your doubles as early as possible, as they are the hardest tiles to match late in the game.',
            'Keep a diverse range of suits in your hand to avoid being forced to pass.',
          ],
          hasPlaceholders: false,
        },
