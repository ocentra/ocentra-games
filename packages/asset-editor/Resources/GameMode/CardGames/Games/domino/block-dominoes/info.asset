          deckDescription: "One standard 28-tile double-six domino set. Each tile has two ends showing zero to six pips; every combination from 0-0 through 6-6 appears exactly once. No playing cards or jokers; used for Block dominoes where the object is to empty one's hand by matching to the train.",
          suitDescription: 'Tiles are matched by pip value at the open ends of the layout (the train). There are no traditional suits; each end value zero through six can connect to any tile sharing that value on one of its two ends.',
          rankDescription: 'There is no rank hierarchy between tiles; play legality is determined by matching the pip value at an open end. Doubles (same pips on both ends) are typically played crosswise. The first player to run out of tiles wins.',
          dealPattern: 'Tiles are drawn clockwise until hands reach seven.',
          bettingLimits: 'None',
          actions: {},
          handRankingSystem: 'None; victory is determined by being the first to empty the hand.',
          rankingSystem: 'Line Matching / Pip Counting',
          useTrump: false,
          notApplicableReasons: {
            drawConfig: 'Standard Block variant does not include drawing from the boneyard during play.',
            discardConfig: 'Tiles are played to the train or held; no separate waste or discard pile exists.',
            specialCards: 'Domino tiles contribute only their pip values; no individual tile has a secondary action effect.',
            declarationMechanism: 'Results are determined by immediate physical tile matches; no hidden declaration tokens are used.',
            fishingConfig: 'Block Dominoes is a line-matching game and does not use a capture-from-tableau fishing mechanic.',
            trickConfig: 'The game is a line-building shedding race rather than a competitive trick-taking game.',
          },
        },
