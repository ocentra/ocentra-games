    hero: {
      title: 'BLOCK DOMINOES',
      subtitle: 'The Foundational Line Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Block Dominoes',
            subtitle: 'The Foundational Line Game',
            content: [
              {
                type: 'paragraph',
                text: "Block Dominoes is the foundational Western domino game and the simplest form of line play. Players take turns matching tiles from their hand to one of the two open ends of the central 'train'. If a player cannot move, they must pass—there is no drawing from a boneyard in the block variant. The round ends when someone 'dominoes' (empties their hand) or when the game is blocked. It is a game of simple arithmetic, hand management, and tactical blocking.",
              },
              {
                type: 'paragraph',
                text: "Modern dominoes likely originated in China before being introduced to Europe in the 18th century. Block Dominoes represents the most direct adaptation of card-matching mechanics to tile components and serves as the 'mother game' for nearly all Western variants like Draw and Muggins.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players (4 players usually play in fixed partnerships).',
              },
              {
                type: 'paragraph',
                text: 'Standard double-six domino set consisting of 28 tiles.',
              },
              {
                type: 'paragraph',
                text: 'One domino set, score sheet.',
              },
              {
                type: 'paragraph',
                text: '2 players: 7 tiles each. 3 players: 5 tiles each. 4 players: 5 or 7 tiles each (depending on whether the boneyard is used). Remaining tiles are set aside face down.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Draw Dominoes: Identical to Block, but players must draw from the boneyard when they cannot move.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Block Dominoes is the foundational Western domino game and the simplest form of line play. Players take turns matching tiles from their hand to one of the two open ends of the central 'train'. If a player cannot move, they must pass—there is no drawing from a boneyard in the block variant. The round ends when someone 'dominoes' (empties their hand) or when the game is blocked. It is a game of simple arithmetic, hand management, and tactical blocking.",
