    tips: [
      {
        title: 'Tip',
        description: 'The 4-2 tile is extremely powerful in the Big variant because it can bridge both 10 and 20 target sums depending on whether you count it as 6 or 3.',
      },
      {
        title: 'Tip',
        description: "Don't wait for a 'Three Nobles' combination unless you have 3/4 of the pieces; it's too slow for this fast variant.",
