    historyContent: {
      origins: "Developed as a social club variant of K'ap Shap in Hong Kong and Guangdong, where large groups needed a game that could accommodate everyone at a single table.",
      originCountries: [
        'China',
      ],
      timeline: [
        "Early 20th Century: Popularized in Cantonese gambling halls ('Fan-Tan' houses).",
        '1950s: Becomes a staple in Southeast Asian Chinese communities.',
        "Present: Still played in traditional social clubs ('Tongs') and elders' associations.",
      ],
      evolution: "The 'Tái' (Big) refers both to the number of players and the 'Big' sets of dominoes used.",
      cultural: 'Reflects the collectivist and high-entropy nature of Chinese social gaming.',
    },
