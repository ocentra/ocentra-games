  data: {
    hero: {
      title: "K'ap Tai Shap",
      subtitle: 'Domino',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: "K'ap Tai Shap",
            subtitle: 'Big Collecting Tens',
            content: [
              {
                type: 'paragraph',
                text: "K'ap Tái Shap (Big Collecting Tens) is an expanded version of K'ap Shap, designed for larger groups (up to 20 players) and utilizing multiple sets of Chinese dominoes (up to 8 sets). It is a high-stakes, fast-paced game where the goal is to form a specific combination of identical pairs and 10/20-sum pairs. The use of multiple sets introduces high duplication, changing the strategy from simple matching to probability-based hoarding.",
              },
              {
                type: 'paragraph',
                text: "Developed as a social club variant of K'ap Shap in Hong Kong and Guangdong, where large groups needed a game that could accommodate everyone at a single table.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically 6 to 15 players.',
              },
              {
                type: 'paragraph',
                text: 'Usually one set per every 2-3 players. For 10 players, 4 sets (128 tiles) is standard.',
              },
              {
                type: 'paragraph',
                text: 'Multiple sets of Chinese dominoes, flat playing surface, chips or counters for stakes',
              },
              {
                type: 'paragraph',
                text: "Standard 10/9 tile split. Tiles are shuffled face-down and built into a long wall (the 'Dragon').",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Ch'i Tái Shap: A variant with 'Seven Big Sets' using 7 sets of dominoes.",
                  },
                  {
                    text: "Wild K'ap: A version where the Red Soldiers (from Xiangqi) are added as wildcards.",
                  },
                  {
                    text: "K'ap Shap (Small): The standard 32-tile two-player version.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
