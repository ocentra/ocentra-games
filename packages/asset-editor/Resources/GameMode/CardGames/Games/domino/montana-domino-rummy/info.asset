          {
            title: 'Montana Domino Rummy',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Montana Domino Rummy is a western domino rummy-style game typically played with multiple double-six sets to provide sufficient tile supply. This entry models the shared tile family and supply using four double-six sets; the rummy-style sequencing and layout objectives are expressed as a table profile layered on top of the tile set.',
              },
              {
                type: 'paragraph',
                text: 'Montana-style domino rummy formats are encountered as modern table games that use dominoes in structured layouts resembling rummy sequencing goals.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 8 players.',
              },
              {
                type: 'paragraph',
                text: 'Four double-6 domino sets combined and mixed.',
              },
              {
                type: 'paragraph',
                text: 'Domino sets and an agreed layout/scoring profile.',
              },
              {
                type: 'paragraph',
                text: 'Tiles are distributed according to the chosen layout profile; any remaining tiles may be held aside or used as a draw pool by table rules.',
              },
            ],
          },
        ],
      },
