        rules: {
          objective: 'Avoid taking tricks containing penalty tiles; 21 points in penalties per deal. Lowest total score wins.',
          gameplay: 'Leader plays a tile and nominates suit (0–6 or doubles). Others follow suit if possible; highest in led suit wins trick. Winner leads next. Same as 11 Point but penalty total is 21.',
          keyRules: [
            'Pass 3 tiles left before play',
            'Leader nominates suit each trick',
            'Follow suit when possible',
            '21 penalty points per deal; lowest wins',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Mark penalty tiles; moon shots more frequent than in Hearts. Use double-0: lead as blank to win trick, or as double to dump it if another double is out.',
          intermediate: "Lead low blanks to force 0-0 onto others; beware helping a moon-shot. When passing, passing high/penalty tiles left helps neighbour's moon-shot—sometimes keep them.",
          advanced: 'Holding doubles and penalty tiles can defend against moon-shots. Penalty tiles can fall to other suits; hard to defend. Same family as 11 Point and 30 Point Black Tile.',
          tips: [
            'Paint penalty-suit pips a different color to spot them.',
            '0-0 as blank wins the trick; as double can lose it.',
            'Passing high tiles left may give neighbour a moon-shot.',
            'Same Hearts-style strategy as 11 Point; 21 points in play.',
          ],
          hasPlaceholders: false,
        },
