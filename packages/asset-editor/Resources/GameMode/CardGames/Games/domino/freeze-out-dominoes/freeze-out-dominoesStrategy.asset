    tips: [
      {
        title: 'Tip',
        description: 'This is fundamentally a game of luck, not skill. Focus on entertainment rather than competitive advantage.',
      },
      {
        title: 'Tip',
        description: 'Young children learn domino matching and taking turns, which is the educational value of the game.',
      },
      {
        title: 'Tip',
        description: 'Play multiple rounds to give all players a chance to win, regardless of early luck.',
