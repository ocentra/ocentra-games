  data: {
    hero: {
      title: 'FREEZE-OUT DOMINOES',
      subtitle: 'The Lucky Match Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Freeze Out Dominoes',
            subtitle: 'The Lucky Match Game',
            content: [
              {
                type: 'paragraph',
                text: "Freeze-Out Dominoes is a simple children's domino game similar to the card game War. Players arrange dominoes face-down in a line and reveal tiles in turn. The player whose tile matches one of the suits shown in a trick takes all revealed dominoes. It emphasizes chance over strategy, making it ideal for young players learning domino games.",
              },
              {
                type: 'paragraph',
                text: "Freeze-Out Dominoes is a modern children's game modeled after the card game War. It was likely designed to teach young players the fundamentals of domino games and matching mechanics.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 6 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard double-six domino set (28 tiles).',
              },
              {
                type: 'paragraph',
                text: 'Dominoes, flat playing surface.',
              },
              {
                type: 'paragraph',
                text: "Shuffle all dominoes face-down. Distribute evenly among players. If dominoes don't divide evenly, remove extras from play. Each player arranges their dominoes face-down in a horizontal line.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Highest Tile in Suit: The lead player announces a single suit, and the trick is won by the highest-value domino in that suit among those revealed (not the first match).',
                  },
                  {
                    text: 'Cumulative Score Variant: Instead of playing until one player has all dominoes, play multiple rounds (5-10) and award 1 point per domino captured each round. Highest score after all rounds wins.',
                  },
                  {
                    text: 'Two-Player Freeze-Out: Standard rules with just two players. Each draws 7-10 dominoes depending on preference.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Freeze-Out Dominoes is a simple children's domino game similar to the card game War. Players arrange dominoes face-down in a line and reveal tiles in turn. The player whose tile matches one of the suits shown in a trick takes all revealed dominoes. It emphasizes chance over strategy, making it ideal for young players learning domino games.",
    tags: [
      'card-game',
      'social',
      'trick-taking',
      'matching',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'freeze-out-dominoes',
    LLM: "Game: Freeze-Out Dominoes (Children's Domino Game). Setup: Double-six dominoes, evenly distributed to 2-6 players; extras removed. Turn Sequence: Lead player reveals rightmost domino and announces its suits. Other players reveal their rightmost dominoes in turn. Trick Winner: Player whose domino matches one of the lead suits collects all revealed dominoes. Collected dominoes placed at left of line, face-down. Next Lead: Trick winner leads the next round. Game End: Last player remaining with dominoes wins. Win Condition: Accumulate all dominoes.",
    Player: 'Welcome to Freeze-Out Dominoes! You are playing a simple matching game. On your turn, reveal your rightmost domino. Try to match the suits from the lead tile to win the trick and collect all dominoes revealed. Be the first to gather all dominoes and you win!',
    tagline: 'Reveal, match, and collect. Simple, fast, and fun!',
    gameCategory: 'Domino',
    subcategory: 'Line / Block Game',
    playerMode: 'multiplayer',
    difficulty: 'Beginner',
    duration: '10-20 minutes',
    origin: 'Modern Western',
    originName: 'Freeze Out',
    deck: 'Double-six dominoes (28 tiles)',
    alsoKnownAs: [],
    playersDisplay: '2-6',
    quality: 'complete',
    completeness: {
      overview: true,
