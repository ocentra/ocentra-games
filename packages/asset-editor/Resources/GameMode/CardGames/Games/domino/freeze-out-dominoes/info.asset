    },
    historyContent: {
      origins: "Freeze-Out Dominoes is a modern children's game modeled after the card game War. It was likely designed to teach young players the fundamentals of domino games and matching mechanics.",
      originCountries: [
        'USA',
        'United Kingdom',
      ],
      timeline: [
        'Mid-20th Century: Freeze-Out emerges as an educational game for children.',
        "1970s-Present: Included in children's domino game compilations and educational resources.",
      ],
      evolution: 'Simplification of traditional domino rules to make the game accessible to young children while maintaining the core matching mechanic.',
      cultural: 'Primarily a family and educational game, used to teach children about domino matching, turn-taking, and basic luck-based gameplay.',
    },
    setupContent: {
      players: '2 to 6 players.',
      deck: 'Standard double-six domino set (28 tiles).',
      equipment: 'Dominoes, flat playing surface.',
      dealing: "Shuffle all dominoes face-down. Distribute evenly among players. If dominoes don't divide evenly, remove extras from play. Each player arranges their dominoes face-down in a horizontal line.",
    },
    variationsContent: {
      list: [
