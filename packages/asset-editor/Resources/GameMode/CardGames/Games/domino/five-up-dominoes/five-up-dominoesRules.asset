  data: {
    LLM: 'Domino game in the Fives family. All doubles are spinners. Score when layout pip total is a multiple of 5. Play to 61 points.',
    Player: 'Domino game in the Fives family. All doubles are spinners. Score when layout pip total is a multiple of 5. Play to 61 points.',
    objective: 'Be the first player or partnership to reach 61 points. Score during play by making the open ends of the layout total a multiple of five; at end of each hand, subtract penalty points for pips left in hand (rounded to nearest multiple of five, divided by five).',
    gameplay: 'Domino game in the Fives family. All doubles are spinners. Score when layout pip total is a multiple of 5. Play to 61 points.',
    keyRules: [
      'Five tiles each; rest is boneyard. Lead plays any tile; others match open ends. All doubles are spinners (crosswise). If you cannot play, draw from boneyard until you can play or it is empty; if you draw a playable tile, play it immediately and turn ends. Hand ends when one player dominoes or all are blocked. After each play, if open-end total is a multiple of 5, score that total divided by 5. At hand end, pips in hand rounded to nearest 5, divided by 5, subtracted from your score. First to 61 wins.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Two or more players.',
      deck: 'Double-6 domino set',
      equipment: 'Double-six domino set; cribbage board recommended for scoring.',
      dealing: 'Each player receives five tiles. The remaining tiles form the boneyard (stock).',
    },
    turnFlow: 'Domino game in the Fives family. All doubles are spinners. Score when layout pip total is a multiple of 5. Play to 61 points.',
