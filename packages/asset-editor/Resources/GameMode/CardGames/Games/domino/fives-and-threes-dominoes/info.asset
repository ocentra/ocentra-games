    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Fives and Threes dominoes',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Fives and Threes is a connecting domino game in which points are scored when the open ends of the layout add up to multiples of three or five. Popular in British pubs and in the British National Dominoes Championship; play is clockwise and the first player or team to reach exactly 61 wins.',
              },
              {
                type: 'paragraph',
                text: 'Fives and Threes is a line domino game from the UK; score when open ends total a multiple of 3 or 5.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to four players; four typically play as two against two in partnership.',
              },
              {
                type: 'paragraph',
                text: 'Standard Western double-six dominoes, 28 tiles.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set; cribbage board recommended for scoring.',
              },
              {
                type: 'paragraph',
                text: 'Tiles mixed face down; two players draw 7 tiles each, three or four players draw 5 tiles each. Remaining tiles form the boneyard and are out of play (no drawing).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Championship deal: Two players take 9 tiles each; four players take 6 tiles each.',
                  },
                  {
                    text: 'Play to 31 or 121: Game played to 31 or 121 points instead of 61.',
                  },
                  {
                    text: 'No score for chipping out: Last tile scores only if it makes a total divisible by 3 or 5; no extra point for chipping out.',
                  },
                  {
                    text: 'First tile cannot win: The first tile played in a hand cannot be used to reach 61 and win the game.',
                  },
                  {
                    text: 'Bounce scoring: If a play would score over 61, the excess is scored as negative (e.g. 59 + 8 goes to 55).',
                  },
                ],
              },
            ],
          },
        ],
      },
