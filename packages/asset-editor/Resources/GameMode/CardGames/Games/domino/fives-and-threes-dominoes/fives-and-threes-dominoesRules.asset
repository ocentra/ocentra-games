  data: {
    LLM: 'Game: Fives and Threes dominoes. Logic: See rules.objective and rules.gameplay.',
    Player: 'Line domino; score when open ends total multiple of 3 or 5.',
    objective: 'Be the first player or team to reach exactly 61 points by making the open ends of the layout total multiples of 3 or 5 (and optionally scoring for chipping out).',
    gameplay: 'First hand starter is determined by lot (e.g. each draws a tile, highest starts); in later hands the turn to start passes left. Play is clockwise. Each turn a player adds one tile to an end of the layout, matching the inward end of the played tile to the outward end of the tile it touches; doubles are placed crosswise and count as the total of their pips when at an open end. A player who cannot play must knock and the turn passes. The hand ends when one player chips out (plays their last tile) or all players are blocked; in the four-player partnership game both members of one team must chip out. After each play the two open ends are totalled: if the total is a multiple of 5, 3 or both, the player scores immediately (e.g. 3→1, 5→1, 6→2, 9→3, 10→2, 12→4, 15→8, 18→6, 20→4). Chip-out scores 1 point. First to exactly 61 wins; a score that would exceed 61 is disregarded.',
    keyRules: [
      'Score when open ends total a multiple of 3 or 5 (or both); possible scores 3→1, 5→1, 6→2, 9→3, 10→2, 12→4, 15→8, 18→6, 20→4.',
      'Doubles at an end count as the sum of their pips for scoring.',
      'Cannot draw from the boneyard; must play a matching tile or knock.',
      'First to exactly 61 wins; going over 61 that deal is disregarded and a new hand is played.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Two to four players; four typically play as two against two in partnership.',
      deck: 'Standard Western double-six dominoes, 28 tiles.',
      equipment: 'Double-six domino set; cribbage board recommended for scoring.',
      dealing: 'Tiles mixed face down; two players draw 7 tiles each, three or four players draw 5 tiles each. Remaining tiles form the boneyard and are out of play (no drawing).',
    },
    turnFlow: 'First hand starter is determined by lot (e.g. each draws a tile, highest starts); in later hands the turn to start passes left. Play is clockwise. Each turn a player adds one tile to an end of the layout, matching the inward end of the played tile to the outward end of the tile it touches; doubles are placed crosswise and count as the total of their pips when at an open end. A player who cannot play must knock and the turn passes. The hand ends when one player chips out (plays their last tile) or all players are blocked; in the four-player partnership game both members of one team must chip out. After each play the two open ends are totalled: if the total is a multiple of 5, 3 or both, the player scores immediately (e.g. 3→1, 5→1, 6→2, 9→3, 10→2, 12→4, 15→8, 18→6, 20→4). Chip-out scores 1 point. First to exactly 61 wins; a score that would exceed 61 is disregarded.',
