  data: {
    LLM: 'Game: Tsung Shap. Logic: See rules.objective and rules.gameplay.',
    Player: 'Tsung Shap (Disputing Tens) is a Chinese domino game adapted for cards. 2 players capture pairs of identical cards and sets of 3 cards summing to multiples of 10 from the ends of a row. Pairs score 10x pip value. Sweeps score 40 bonus. Can be played with standard card deck using Fishing mechanics.',
    objective: 'Score more points than the opponent by capturing pairs of identical tiles (ten times pip value), triplets that sum to a multiple of ten (pip total), and sweeps (last two table tiles for 40 bonus).',
    gameplay: 'Row of tiles on table. Draw and capture from ends. Identical pair = capture (score 10x pips). Triplet summing to 10 = capture. Sweep (take last 2) = 40 bonus. Missed captures can be claimed by opponent.',
    keyRules: [
      'Capture from row ends only',
      'Pairs and multiples-of-10 triplets',
      'Sweep bonus = 40',
      'Opponent claims missed captures',
    ],
