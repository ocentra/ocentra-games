  data: {
    LLM: 'Game: Auction Draw Dominoes. Type: Match-and-Draw Gambling. Rules: Double-6 set. Draw cost: 1 chip. Special: Auction for last 2 tiles. Goal: Domino first to win the pool.',
    Player: "Welcome to Auction Draw Dominoes! Match your tiles to the board or pay a chip to draw. If you're patient, you might win the final auction. Do you have enough chips to stay in the game?",
    objective: "Be the first to 'Domino' (play all tiles) to win the chip pool. If the game is blocked, the player with the lowest total pips wins.",
    gameplay: "1. **Matching**: On your turn, you must match one end of a tile in your hand to an open end on the board. 2. **Drawing**: If you cannot play, you must draw tiles from the boneyard one at a time. For each tile drawn, you must pay 1 chip into the pool. 3. **The Auction**: When the boneyard is reduced to exactly **two tiles**, play freezes. An auction begins for those two tiles. 4. **Bidding**: Every player has a chance to bid twice (or check) in clockwise order. The highest bidder takes BOTH tiles into their hand and adds their bid to the pool. 5. **Ending**: A player wins by playing their last tile. If no one can play and the boneyard is empty, the game is 'Blocked'.",
    keyRules: [
      'Bid Limit: You cannot bid more chips than you currently possess.',
      'Blocked Win: In a blocked game, the player with the lowest pip total on their remaining tiles wins the pool.',
      "No Passing: You MUST play if you can. You MUST draw if you can't play and tiles are available.",
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
