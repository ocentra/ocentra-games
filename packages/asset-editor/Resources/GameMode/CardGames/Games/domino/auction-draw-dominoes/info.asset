    hero: {
      title: 'AUCTION DRAW',
      subtitle: 'Dominoes for High Rollers',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Auction Draw Dominoes',
            subtitle: 'Dominoes for High Rollers',
            content: [
              {
                type: 'paragraph',
                text: 'Auction Draw Dominoes is a high-stakes gambling variant of the classic Draw Dominoes game. It introduces a chip-based economy where players pay to draw tiles from the boneyard, and most uniquely, participate in a competitive auction for the final two remaining tiles in the boneyard. The winner of the hand claims the entire accumulated chip pool.',
              },
              {
                type: 'paragraph',
                text: "A derivative of the standard 'Draw' domino game, adding elements of poker-style betting and auction theory. Likely developed in tavern settings where gambling on dominoes was a common pastime, and documented in English domino circles.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 players. Each starts with an equal stack of chips.',
              },
              {
                type: 'paragraph',
                text: 'Standard Double-Six set (28 tiles, 0-0 to 6-6).',
              },
              {
                type: 'paragraph',
                text: 'Domino set, poker chips, table.',
              },
              {
                type: 'paragraph',
                text: "2-3 players: 7 tiles each. 4 players: 6 tiles each. Remaining tiles form the 'Boneyard'.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Heavy Ante: Players contribute a larger initial amount, making the auction bid relatively less significant.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Auction Draw Dominoes is a high-stakes gambling variant of the classic Draw Dominoes game. It introduces a chip-based economy where players pay to draw tiles from the boneyard, and most uniquely, participate in a competitive auction for the final two remaining tiles in the boneyard. The winner of the hand claims the entire accumulated chip pool.',
    tags: [
