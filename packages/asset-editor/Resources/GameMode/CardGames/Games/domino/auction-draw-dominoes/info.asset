    aiContent: {
      difficulty: {
        easy: "Never bids in the auction. Spends all its chips drawing tiles even when it's statistically better to 'pass' if the rules allowed it.",
        medium: 'Bids 1-3 chips in the auction. Prioritizes playing tiles that reduce its pip total.',
        hard: 'Simulates the content of the boneyard based on visible tiles and opponent draws. Bids aggressively if it identifies the two auction tiles likely contain its winning number.',
      },
      considerations: [
        "AI needs a 'Pay-to-Draw' logic that weights the cost of a chip vs. current hand strength.",
        'Auction bidding engine must use Monte Carlo simulation for boneyard content probability.',
      ],
