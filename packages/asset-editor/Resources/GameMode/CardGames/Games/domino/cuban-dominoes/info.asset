    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Cuban Dominoes',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Partnership block domino game for four players using a double-nine set of 55 tiles. Partners sit opposite; play proceeds counter-clockwise. Players add tiles to a line matching ends; first to empty hand or lowest pips when blocked wins the round. First team to 100 points wins the game.',
              },
              {
                type: 'paragraph',
                text: 'Cuban dominoes originated in Cuba; the principal form is partnership dominoes (Dominó de Parejas) for four players using a double-nine set, played with great enthusiasm.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in two partnerships; partners sit opposite.',
              },
              {
                type: 'paragraph',
                text: 'Double-nine set of 55 tiles (fichas).',
              },
              {
                type: 'paragraph',
                text: '55 tiles; each player typically has a rack.',
              },
              {
                type: 'paragraph',
                text: 'Tiles are mixed face down (darle agua). Each player in turn draws 10 tiles and places them on their rack hidden from others. The remaining 15 tiles stay face down and are not used during the round. Before the first deal, one player from each team draws a tile at random; the team whose tile has more spots plays first.',
              },
            ],
          },
        ],
      },
    ],
