    hero: {
      title: 'Draw Dominoes',
      subtitle: 'Domino rules and play flow',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Draw Dominoes',
            subtitle: 'Domino rules and play flow',
            content: [
              {
                type: 'paragraph',
                text: 'One of the simplest and most common domino games: form a single line by matching ends; if you cannot play, draw from the boneyard until you can play or only two tiles remain. First to empty hand or lowest pips in a blocked game wins the hand; play to 100 (2P/partnership) or 61 (3–4P).',
              },
              {
                type: 'paragraph',
                text: 'Draw Dominoes is documented in published rule references and long-running table play traditions. Modern dominoes first appeared in France in the mid-18th century and spread to Great Britain, Austria, Germany and Italy; Draw Dominoes is one of the simplest and most common Western domino games.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players.',
              },
              {
                type: 'paragraph',
                text: 'Double-6 domino set; 7 tiles each for 2–3 players, 6 for 4; remainder stays in the boneyard.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set.',
              },
              {
                type: 'paragraph',
                text: '7 tiles each for 2–3 players, 6 for 4 players; remainder stays in the boneyard. Players draw for lead; turn to lead passes to the left of the previous leader after each hand.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Dutch: Player draws one or two tiles from the boneyard and passes if no playable tile; the double blank tile counts as 13 points.',
                  },
                  {
                    text: "Puerto Rico: Holder of double six (or highest double dealt) starts and must lead with it; illegal to draw when able to play. Winner scores total pips in all opponents' hands; blocked game: lowest pips wins.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
