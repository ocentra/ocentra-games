    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Milo',
            subtitle: 'Partnership domino',
            content: [
              {
                type: 'paragraph',
                text: 'Milo is a partnership domino game played in Africa and parts of Indonesia. It uses the same equipment and basic play as Latin Partnership Dominoes, but with different scoring: the winning partnership gets one point for domino; if blocked, the partnership with the smallest total of pips on their tiles gets one point; if the tile that made domino causes both ends of the train to end in the same suit, the partnership scores two points (called a Milo). A game is five points.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: Africa and parts of Indonesia\nTime Period: Not specified\nHistorical Development: Milo is a scoring variant of Latin Partnership Dominoes, popular in Spain and Latin America; the Milo variant is played under this name in Africa and Indonesia.\nCultural Significance: Social and family partnership game.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in fixed partnerships. Partners sit facing each other.',
              },
              {
                type: 'paragraph',
                text: 'Type: Double-six domino set\nNumber of tiles: 28\nAll tiles dealt to the four players.',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set (28 tiles)\nTable space',
              },
              {
                type: 'paragraph',
                text: 'All 28 tiles are dealt; seven tiles each. Play is normally counter-clockwise.',
              },
            ],
          },
        ],
      },
