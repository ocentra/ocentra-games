    historyContent: {
      origins: "Originating in Southern China (Cantonese culture), K'ap Shap is one of the most popular social domino games. It occupies a similar cultural space to Gin Rummy in the West.",
      originCountries: [
        'China',
      ],
      timeline: [
        '1800s: Widespread in Guangdong and Fujian.',
        '1900s: Follows the Chinese diaspora to San Francisco, Malaysia, and Hong Kong.',
        'Present: A staple in community centers and family gatherings.',
      ],
      evolution: "The game's rules for 'Supreme' tiles (4-2 counting as 3 instead of 6) developed to maintain the 'Tens' theme.",
      cultural: 'Commonly played during New Year celebrations for small-stakes betting.',
    },
