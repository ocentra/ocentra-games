    aiContent: {
      difficulty: {
        easy: 'Only looks for identical pairs; ignores sum-to-10 logic until late game.',
        medium: 'Tracks discarded tiles; basic sum-balancing heuristic.',
        hard: "Expert probability calculation for wall draws; perfectly balances the 'Sum' and 'Eye' requirements; bluffs discards to mislead opponents about needed totals.",
      },
      considerations: [
