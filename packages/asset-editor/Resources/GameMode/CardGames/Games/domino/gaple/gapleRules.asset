  data: {
    LLM: 'Game: Gaple. Use a double-six set with 4-5 players. Play one matching tile to either open end each turn. If blocked, either discard a dead tile or pass depending on table rule. Hand ends when someone goes out or line is blocked; lowest pip total wins with tie-break by lowest single tile then lowest end.',
    Player: 'Gaple: build the line with matching ends and keep your hand pip total lower than everyone else when the hand ends.',
    objective: 'Be left with the lowest pip total when the hand ends, either by going out or by blocked play.',
    gameplay: 'Play proceeds on a single train, adding one matching tile to either open end. In hands with undealt center tiles, one center tile is exposed to start the line. In 4-player 7-tile play, the double blank 0-0 starts the first hand and later hands begin with a double from the previous winner side. A blocked player usually discards one dead tile face down; some tables use pass-only handling.',
    keyRules: [
      'Unplayed tiles, including dead tiles, count as penalty pips at hand end.',
      'Common tie-breaker: lowest single tile wins ties on total pips; if still tied, lowest end wins.',
      'Some tables count the double blank 0-0 as 25 only when no other blank tile remains in that hand.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Four or five players. With four, play can be individual or partnerships; with five, individual play.',
      deck: 'One double-six domino set (28 tiles).',
      equipment: 'One double-six domino set (28 tiles).',
      dealing: 'Four-player variants use either 6 each (4 face-down in center) or 7 each (no center tiles). Five-player game deals 5 each (3 face-down in center).',
    },
    turnFlow: 'Play proceeds on a single train, adding one matching tile to either open end. In hands with undealt center tiles, one center tile is exposed to start the line. In 4-player 7-tile play, the double blank 0-0 starts the first hand and later hands begin with a double from the previous winner side. A blocked player usually discards one dead tile face down; some tables use pass-only handling.',
