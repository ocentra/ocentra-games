      award_pot: 'System action at deal resolution.',
      play_card: 'Tile must match the pip value at one open line end.',
      draw: 'No drawing occurs after the initial deal because there is no boneyard.',
      discard: 'Only valid when no legal play exists and table uses dead-tile variant.',
      pass: 'Only legal when no playable match exists.',
      bid: 'Gaple has no bidding system.',
