        },
        rules: {
          objective: 'Play all your tiles first, or in a blocked position finish with the lowest remaining pip total.',
          gameplay: 'Correlativa follows a train-style domino layout from a central opening double. Players extend legal train ends by matching pips. If a player cannot play, they draw one tile from the boneyard and continue drawing until they can play or the boneyard is exhausted. The deal ends when a player empties their hand or all players are blocked with no draw available.',
          keyRules: [
            'Tiles must match the exposed train end by pip value.',
            'Blocked players draw from boneyard until playable or boneyard is empty.',
            'Deal ends on a player going out or full block with no available draws.',
            "Scoring is based on pip totals remaining in players' hands at deal end.",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Keep playable numbers flexible and avoid being forced to draw repeatedly from the boneyard.',
          intermediate: 'Track which numbers are nearly exhausted to guide safer plays and reduce block risk.',
          advanced: 'Steer branch ends toward numbers opponents are unlikely to hold while preserving your own exit routes.',
          tips: [
            'Use doubles to control train direction when the board is tight.',
            'Protect low-pip exits for endgame to reduce blocked-hand penalties.',
            'When ahead, prefer low-risk plays that preserve guaranteed matches.',
          ],
          hasPlaceholders: false,
        },
