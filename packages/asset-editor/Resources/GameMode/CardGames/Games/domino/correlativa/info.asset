        tabLabel: 'About',
        pages: [
          {
            title: 'Correlativa',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Correlativa is a Mexican domino game in the trains family, related to Garrafina. Players build matching trains from a central double and, when blocked, draw from a boneyard until they can play or the boneyard is empty.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: Mexico (variant of Spanish Garrafina)\nTime Period: Early 1900s\nHistorical Development: Correlativa is a Mexican variant of Garrafina, a Spanish domino game of the Trains family.\nCultural Significance: Popular social and family game in Mexico.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 3-4\nPartnerships: No fixed partnership structure',
              },
              {
                type: 'paragraph',
                text: 'Type: Double-6 dominoes\nNumber of sets: 1\nTotal tiles: 28',
              },
              {
                type: 'paragraph',
                text: 'Double-6 domino set\nTable space\nOptional score sheet for multi-deal sessions',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 7 tiles. In smaller-player games, remaining tiles stay face down as the boneyard for draw-when-blocked play.',
              },
            ],
          },
        ],
      },
