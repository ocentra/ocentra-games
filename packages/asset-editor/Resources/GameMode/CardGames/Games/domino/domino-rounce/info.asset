        pages: [
          {
            title: 'Domino Rounce',
            subtitle: 'Domino rules and play flow',
            content: [
              {
                type: 'paragraph',
                text: "Domino Rounce is a competitive trick-taking game for 2 to 4 players, played with a double-six set of dominoes. Similar to the card game Rounce, players start with a positive score and compete to reduce it to zero by winning tricks. It features a unique 'dummy' hand and high-penalty mechanics for failing to win tricks.",
              },
              {
                type: 'paragraph',
                text: 'Rounce is a German-American variation of the 17th-century game Loo. The domino adaptation was popular in American social clubs in the late 19th and early 20th centuries.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2, 3, or 4 players.',
              },
              {
                type: 'paragraph',
                text: '28 standard double-six dominoes.',
              },
              {
                type: 'paragraph',
                text: 'Dominoes, score sheet.',
              },
              {
                type: 'paragraph',
                text: "Each player receives 5 tiles. A 'dummy' hand of extra tiles is dealt. The player to the right of the dealer turns up a tile to determine the trump suit.",
              },
            ],
          },
        ],
      },
