    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Memory',
            subtitle: 'Domino game',
            content: [
              {
                type: 'paragraph',
                text: 'Memory (Concentration) is a domino adaptation of the card game Pelmanism. All double-6 tiles are laid face down in a 4×7 grid. On your turn you turn up two tiles; if they total 12 you remove them and take another turn; otherwise you turn them face down and the next player goes. The first to capture 50 tiles (25 pairs) or an agreed total wins. It is a test of memory.',
              },
              {
                type: 'paragraph',
                text: 'Concentration is an adaptation for dominoes of the card game Pelmanism, also known as Concentration or Memory. The card version originated in Europe; the domino version follows the same memory-matching principle with tiles laid in a grid. The game is also the basis for a popular American television quiz show using pairs of prizes.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6 (any number can play)\nOptimal Players: 2\nPartnerships: No',
              },
              {
                type: 'paragraph',
                text: 'Type: Double-6 domino set\nNumber of Tiles: 28\nAll tiles used in the grid',
              },
              {
                type: 'paragraph',
                text: 'Double-6 domino set\nTable space for 4×7 grid',
              },
              {
                type: 'paragraph',
                text: 'Players get no hands. All 28 tiles are dealt face down into a grid layout of 4 by 7 tiles.',
              },
            ],
          },
        ],
      },
