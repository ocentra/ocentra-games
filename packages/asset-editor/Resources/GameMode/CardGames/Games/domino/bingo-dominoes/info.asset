    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bingo (Dominoes)',
            subtitle: 'The King of Domino Games',
            content: [
              {
                type: 'paragraph',
                text: "Bingo is a historic domino trick-taking game for 2 players based on the card game Sixty-Six. Hailed as the 'king of domino games' in 19th-century America, it features a unique hierarchy where the double-blank tile, named 'Bingo', is the supreme trump. Players win tricks to collect point-values from the tiles, aiming to reach 70 points and claim the deal. This game predates the popular lottery-style Bingo and represents a high-skill adaptation of card mechanics to dominoes.",
              },
              {
                type: 'paragraph',
                text: "Developed in 19th-century America as a response to religious prohibitions on playing cards. Trick-taking card games like Sixty-Six were adapted to use domino tiles, with 'Bingo' emerging as the most complex and respected of these variants.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly 2 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard double-six domino set (28 tiles).',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, score sheet.',
              },
              {
                type: 'paragraph',
                text: 'Tiles are shuffled face-down. Each player draws 7 tiles. The remaining 14 tiles form the face-down stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Single Point Bingo: A simplified version where every deal is worth exactly 1 point, ignoring the margin of victory.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bingo is a historic domino trick-taking game for 2 players based on the card game Sixty-Six. Hailed as the 'king of domino games' in 19th-century America, it features a unique hierarchy where the double-blank tile, named 'Bingo', is the supreme trump. Players win tricks to collect point-values from the tiles, aiming to reach 70 points and claim the deal. This game predates the popular lottery-style Bingo and represents a high-skill adaptation of card mechanics to dominoes.",
    tags: [
      'card-game',
      'domino',
      'trick-taking',
      'traditional',
      'strategy',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 2,
    routePath: 'bingo-dominoes',
    LLM: "Game: Bingo (Dominoes). 28 tiles (double-6). 2 players. Trick-taking. Blanks are trump; double-blank (Bingo) is highest. Tile point values: doubles worth pip total, others 0 or pip of non-blank end. Win 70+ points in tricks, then claim. Game points: 1/2/3 based on loser's score. Match to 7 game points.",
    Player: 'Your tiles: [6|6] (12 pts!), [5|3], [0|4] (trump!), [2|1], [6|2], [3|3] (6 pts), [0|0] (BINGO — the ultimate trump!). Your opponent leads [5|5] (10 pts). You can follow with [5|3], but you lose the 10 points. Or play Bingo [0|0] to capture it — but is it worth burning your best tile this early?',
    tagline: 'Trick-taking with tiles. The double-blank rules all.',
    gameCategory: 'Domino',
    subcategory: 'Trick-taking / Chinese Dominoes',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-40 minutes',
    origin: 'United States (19th Century)',
    originName: 'Bingo',
    deck: '28 dominoes (Double-6 Set)',
    alsoKnownAs: [
      'Domino Bingo',
    ],
    playersDisplay: '2',
    quality: 'complete',
    completeness: {
