    historyContent: {
      origins: "Developed in 19th-century America as a response to religious prohibitions on playing cards. Trick-taking card games like Sixty-Six were adapted to use domino tiles, with 'Bingo' emerging as the most complex and respected of these variants.",
      originCountries: [
        'United States',
      ],
      timeline: [
        "1868: First described by William Brisbane Dick in 'Hoyle's Games'.",
        '1880s: Widely played in the American South and Midwest.',
        '1920s: Declines in popularity as card-playing taboos fade.',
        'Present: A rare specialty game studied by domino historians and hobbyists.',
      ],
      evolution: "The game essentially mirrors the mechanics of Sixty-Six (or 66), including the 'Closing' mechanic and the 'Marriage' (double) equivalents.",
      cultural: 'A unique cultural artifact showing the adaptability of card game engines to alternative components when social or religious constraints applied.',
    },
    setupContent: {
      players: 'Exactly 2 players.',
      deck: 'Standard double-six domino set (28 tiles).',
      equipment: 'Standard pack, score sheet.',
      dealing: 'Tiles are shuffled face-down. Each player draws 7 tiles. The remaining 14 tiles form the face-down stock.',
    },
    variationsContent: {
      list: [
        {
          id: 'single-point',
          name: 'Single Point Bingo',
          description: 'A simplified version where every deal is worth exactly 1 point, ignoring the margin of victory.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Follows trick rules legally. Does not track points or count tiles. Never closes the stock.',
        medium: 'Counts points toward 70. Prioritizes winning high-value doubles. Saves the Bingo tile for late-game captures.',
        hard: "Full tile tracking model. Calculates the probability of opponent being void based on stock draw counts. Perfectly times the stock closing for a 'win on lead'.",
      },
      considerations: [
        "Must implement Sixty-Six style 'Closing' logic.",
        'Hand tracking is essential due to the small total tile count.',
      ],
    },
