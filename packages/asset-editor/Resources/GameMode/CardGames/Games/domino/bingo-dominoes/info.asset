          deckDescription: 'One standard 28-tile double-six domino set. Each tile has two ends showing zero to six pips; every combination from 0-0 through 6-6 appears exactly once. No playing cards or jokers; in Bingo dominoes the blank (zero) end may act as trump and tiles are drawn to fill a layout.',
          suitDescription: 'Tiles are matched by pip value at the open ends. The blank (zero) end may establish a trump or special role; other end values zero through six connect to matching tiles. There are no traditional suits; pip value determines matching.',
          rankDescription: 'There is no single rank order; doubles (same pips on both ends) may rank by total pips and tiles with a trump (blank) end may have a special rank. Play legality is determined by matching the pip value at an open end.',
          dealPattern: 'Each player draws seven tiles face-down.',
          bettingLimits: 'None',
          actions: {},
          handRankingSystem: 'None; points are awarded based on pip totals of tiles captured in tricks.',
          rankingSystem: 'Point-Trick (70 Claim)',
          useTrump: true,
          notApplicableReasons: {
            discardConfig: 'Tiles are played directly to tricks; no separate waste or discard pile is utilized.',
            specialCards: 'The Bingo tile (double-blank) has supreme trump rank but no secondary engine effect.',
            declarationMechanism: 'Victory claims and stock closing are performed openly; no hidden tokens are required.',
            fishingConfig: 'Bingo is a trick-taking game and does not use a capture-from-tableau fishing mechanic.',
            shedding: 'The goal is point accumulation through tricks rather than being the first to empty the hand.',
          },
        },
