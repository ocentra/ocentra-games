  data: {
    hero: {
      title: 'Eighty-Eight (Texas 88)',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Eighty-Eight (Texas 88)',
            subtitle: 'Trick-taking',
            content: [
              {
                type: 'paragraph',
                text: "Eighty-Eight (also known as Texas 88) is an expansive, 6-player variation of the classic Texan domino game 'Texas 42'. Played with two full sets of Double-Six dominoes, the game scales up the complexity and the math, with 88 points available in every hand. Two teams of three players compete to outbid each other and reach 500 points first. It is a game of high communication, careful tracking of identical tiles, and intense partnership coordination, making it a favorite for large gatherings in its home state.",
              },
              {
                type: 'paragraph',
                text: "Developed as a way to expand the 4-player 'Texas 42' into a game suitable for larger social groups. The specific rules were popularized by domino manufacturers like Puremco to encourage the use of double sets.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '6 players divided into two teams of three. Players from opposite teams sit in alternating order around the table.',
              },
              {
                type: 'paragraph',
                text: '56 Dominoes (Two Double-Six sets mixed together).',
              },
              {
                type: 'paragraph',
                text: '56 Dominoes (Two Double-Six sets mixed together).',
              },
              {
                type: 'paragraph',
                text: "Each player is dealt 9 tiles. 2 tiles are left face-down as 'The Kitty'.",
              },
            ],
          },
        ],
      },
    ],
