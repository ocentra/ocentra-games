    customActions: [
      {
        supported: true,
        description: 'Determine which player holds the lowest double (excluding [0-0]); that player leads the first round. In later rounds the previous round loser leads and must lead a double other than [0-0].',
        cost: '0',
        constraints: 'Dealer or system; before play phase.',
        isTerminating: false,
        effectType: 'play',
        id: 'identify_lowest_double',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Place a tile on an arm of the cross. Regular tiles: the arm end and the adjacent end of the played tile must total seven (1-6, 2-5, 3-4). Matadors [1-6], [2-5], [3-4], [0-0] may be played on any end. First double is the spinner; first four plays start the four arms.',
        cost: '0',
        constraints: 'Current player; tile must match Rule of Seven or be a Matador; doubles played in line.',
        isTerminating: false,
        effectType: 'play',
        id: 'play_tile',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Draw one or more tiles from the boneyard (stock). Player may draw as many as desired but must leave at least two tiles in the boneyard. A player with no legal play must draw until they have a playable tile or the boneyard is reduced to two tiles.',
        cost: '0',
        constraints: 'On your turn; at least two tiles must remain in the boneyard; neither player may draw when only two remain.',
        isTerminating: false,
        effectType: 'draw',
        id: 'draw_tile',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Round ends when a player plays their last tile (dominoes). That player wins the round.',
        cost: '0',
        constraints: "System outcome when current player's hand is empty after a play.",
        isTerminating: true,
        effectType: 'play',
        id: 'domino',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Round ends in a block when no player can play and the boneyard has two or fewer tiles. Winner is the player with fewer pips in hand; if equal, no score and same player leads next round.',
        cost: '0',
        constraints: 'System outcome when no legal play exists and boneyard is depleted to two tiles.',
        isTerminating: true,
        effectType: 'play',
        id: 'blocked',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Round continues; play passes to the next player.',
        cost: '0',
        constraints: 'System outcome when round has not ended by domino or block.',
        isTerminating: false,
        effectType: 'play',
        id: 'continue',
        effectHints: {},
      },
      {
        supported: true,
        description: "Score the round: winner receives the total pips in opponent's hand (or both hands in blocked equal-points case per variant). First to 100 points loses; if both over 100 in same round, lowest score wins.",
        cost: '0',
        constraints: 'System; after round end.',
        isTerminating: false,
        effectType: 'play',
        id: 'calculate',
