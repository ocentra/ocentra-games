    tips: [
      {
        title: 'Tip',
        description: "Always check the count of '4s' and '3s' on the board. Since they match each other, a shortage of one rank makes the other rank unplayable.",
      },
      {
        title: 'Tip',
        description: 'If you are the starting player, lead with a double-3 or double-4 to create immediate branching paths.',
      },
      {
        title: 'Tip',
        description: "Don't go crazy drawing tiles. Getting stuck with a big hand will cost you points if your opponent dominoes.",
      },
      {
        title: 'Tip',
        description: 'The  Matador is the most flexibleâ€”save it for emergencies.',
