            content: [
              {
                type: 'paragraph',
                text: 'Partnership Dominoes is a four-player line domino game. All 28 tiles are dealt, seven each. Partners sit opposite. The double-six tile leads first; the match ends by playing out or by block. First team to 100 wins.',
              },
              {
                type: 'paragraph',
                text: 'Classic partnership dominoes. Popular in Spain and Latin America. FID (FederaciÃ³n Internacional de Domino) standardizes rules.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 in fixed partnerships. Partners sit opposite.',
              },
              {
                type: 'paragraph',
                text: 'Double-six set, 28 tiles.',
              },
              {
                type: 'paragraph',
                text: '28 double-six tiles.',
              },
              {
                type: 'paragraph',
                text: 'All tiles dealt; 7 each.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Score All Unplayed: Winners score total pips on all unplayed tiles (including partner's).",
                  },
                  {
                    text: 'Doscientos: Play to 200. Score all unplayed. Winner starts next. Bonus for first pass (20), subsequent (10).',
                  },
                  {
                    text: 'Quinientos: Play to 500. Bonuses: first 4 games (100/75/50/25). CapicÃºa, chuchazo (100).',
