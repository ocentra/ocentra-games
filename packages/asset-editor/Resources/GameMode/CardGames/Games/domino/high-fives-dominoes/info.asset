        rules: {
          objective: 'Play legal matching tiles and end hands with the best score under the match profile.',
          gameplay: 'Players place a legal tile to a matching open end of the shared layout. When blocked, the match profile determines whether to draw from a boneyard or pass. Hands end when a player empties their hand or play is blocked, and scoring follows the profile in use.',
          keyRules: [
            'A played tile must match the value of an exposed open end.',
            'Blocked turns are resolved by draw-or-pass profile rules.',
            'Hand-end and scoring depend on the match profile.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Keep connectors that cover multiple values and avoid holding high-number tiles too long.',
          intermediate: 'Track which high values have appeared so you do not open values you cannot reliably answer.',
          advanced: 'Shape open ends to pressure opponents while keeping safe exits across the broad range of values.',
          tips: [
            'Do not expose a high value unless you can keep responding to it.',
            'Preserve mid-range flexibility to avoid being forced into a single dangerous value.',
          ],
