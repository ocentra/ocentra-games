  data: {
    LLM: 'Game: Doscientos. Logic: See rules.objective and rules.gameplay.',
    Player: "Doscientos ('Two Hundred') is a highly strategic partnership domino game widely played in Spain and Latin America. It is a straight-forward matching game where all 28 tiles of a double-six set are dealt, requiring teams to carefully track played suits and manage their remaining pips to win the round and reach the target score.",
    objective: 'Be the first team to reach a cumulative score of 200 points.',
    gameplay: "1. Starting: In the first round, the holder of the 6-6 leads it. In subsequent rounds, the lead rotates.\n2. Matching: Players take turns adding a tile to either end of the line, matching the pips on the open ends.\n3. Passing: If a player cannot move, they must 'knock' (tap the table) and pass their turn.\n4. Ending: The round ends when a player goes 'domino' (empties their hand) or the game is 'blocked' (no one can move).",
    keyRules: [
      'Anti-clockwise rotation is the standard for play.',
      'Partners sit facing each other and are not allowed to show their tiles to one another.',
      "A 'Trout' (closing the ends so no one can move) is a key strategic maneuver.",
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '4 players in fixed partnerships (2 vs 2).',
      deck: 'Standard 28-tile double-six domino set.',
      equipment: 'Domino set, score sheet.',
      dealing: 'The set is shuffled face-down. Each player is dealt exactly 7 tiles.',
    },
    turnFlow: "1. Starting: In the first round, the holder of the 6-6 leads it. In subsequent rounds, the lead rotates.\n2. Matching: Players take turns adding a tile to either end of the line, matching the pips on the open ends.\n3. Passing: If a player cannot move, they must 'knock' (tap the table) and pass their turn.\n4. Ending: The round ends when a player goes 'domino' (empties their hand) or the game is 'blocked' (no one can move).",
