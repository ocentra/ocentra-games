        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: '11 Point Black Tile',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: '11 Point Black Tile is a Hearts-style trick-taking game played with a double-six domino set. It uses negative scoring: the double-0 counts 4 points and each of the seven tiles in the 3-suit counts 1 point (11 points total per deal). Lower score wins. Three or four players pass three tiles left before play; the leader nominates the suit for each trick.',
              },
              {
                type: 'paragraph',
                text: 'Adaptation of the card game Hearts for double-six dominoes; eight suits (0-6 plus doubles).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 players: 9 tiles each (one face-down); 4 players: 7 tiles each',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set (28 tiles)',
              },
              {
                type: 'paragraph',
                text: 'Double-six domino set',
              },
              {
                type: 'paragraph',
                text: 'Each player passes 3 tiles face-down to the player on their left before play',
              },
            ],
          },
        ],
      },
    ],
