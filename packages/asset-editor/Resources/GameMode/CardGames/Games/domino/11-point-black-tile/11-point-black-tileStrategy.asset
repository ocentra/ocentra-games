      {
        title: 'Tip',
        description: 'Passing high tiles left may give your neighbour a moon-shot; sometimes keep them.',
      },
      {
        title: 'Tip',
        description: 'Lead low blanks to force 0-0 out, similar to leading low spades in Hearts to force the Queen.',
