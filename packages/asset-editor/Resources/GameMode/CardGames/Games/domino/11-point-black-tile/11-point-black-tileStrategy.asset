      {
        title: 'Tip',
        description: 'Paint 3-suit pips a different color (e.g. red) so penalty tiles are obvious.',
      },
      {
        title: 'Tip',
        description: 'Leading 0-0 as blank wins the trick; as double you can lose it if another double exists.',
