                  {
                    text: 'Barbu: The international variant with 8 specific rounds per dealer.',
                  },
                  {
                    text: 'Double Kingen: Played with two decks for more chaos.',
                  },
                  {
                    text: 'Student Kingen: Simplified scoring for faster play.',
                  },
                ],
              },
