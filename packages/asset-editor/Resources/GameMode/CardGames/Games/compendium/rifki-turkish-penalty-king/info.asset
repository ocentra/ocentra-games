    historyContent: {
      origins: 'Derived from the French game Barbu (The Bearded Man, referring to the King of Hearts). It was adapted in Turkey with specific scoring weights that emphasize the penalty of the King of Hearts (Rıfkı).',
      originCountries: [
        'Turkey',
        'France',
      ],
      timeline: [
        "1900s: Traditional 'King' reaches the Ottoman Empire.",
        '1950s: The name Rıfkı becomes synonymous with the King of Hearts in Turkish slang.',
        '1980s: Becomes a social staple for university students and tea-house culture.',
        'Present: One of the top-rated social strategy games in Turkey, often played digitally.',
      ],
      evolution: "The scoring system transformed into a zero-sum (or near zero-sum) balance where the massive negatives are offset by high-value positive 'Trump' rounds.",
      cultural: 'In Turkey, taking Rıfkı (the King of Hearts) is often met with lighthearted ridicule and high-intensity social commentary.',
