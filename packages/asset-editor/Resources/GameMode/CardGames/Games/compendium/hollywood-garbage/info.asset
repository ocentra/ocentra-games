    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Hollywood Garbage',
            subtitle: 'Poker + Bingo Hybrid',
            content: [
              {
                type: 'paragraph',
                text: 'Hollywood Garbage (also known as Junk Poker or Garbage) is a multi-phase social gambling game played with a massive deck (often 2-3 standard decks). It combines elements of Poker, Bingo, and simple card-matching. It is designed for large groups and operates through a sequence of phases that slowly deplete a shared pot of coins or chips.',
              },
              {
                type: 'paragraph',
                text: "A traditional American 'parlor' game, likely emerging in the mid-20th century as a more complex version of simple matching games for small stakes.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 10 players.',
              },
              {
                type: 'paragraph',
                text: '2 decks (4-5 players) or 3+ decks (6+ players). Shuffled together.',
              },
              {
                type: 'paragraph',
                text: '2 decks (4-5 players) or 3+ decks (6+ players). Shuffled together.',
              },
              {
                type: 'paragraph',
                text: 'The dealer deals 5 cards face up to each player.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Four-flush in Poker: A four-flush (four cards of one suit) beats a pair but loses to two pairs in the poker phase.',
                  },
                  {
                    text: 'Buy extra card (Poker): A player may buy an extra card for a set amount of coins and discard one card in exchange.',
                  },
                  {
                    text: 'Five-card Put and Take: Some play with only 5 cards turned in each part of Put and Take, so maximum put or take is 5 per card rather than 10.',
                  },
                ],
              },
            ],
          },
        ],
      },
