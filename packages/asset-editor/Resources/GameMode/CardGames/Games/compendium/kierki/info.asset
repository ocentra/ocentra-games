    historyContent: {
      origins: "Derived from the pan-European 'Hearts' family (like Black Lady in the US and Gong Zhu in China), Kierki was standardized in Poland in the late 20th century.",
      originCountries: [
        'Poland',
      ],
      timeline: [
        'Mid-1900s: Hearts variants circulate in Eastern Europe.',
        "1970s: The characteristic 7-hand 'Series' structure of Kierki becomes standard.",
        "Present: One of Poland's most popular social card games; widely available on Polish gaming portals.",
      ],
      evolution: "The game evolved to include several 'Penalty Hands' before the final 'Positive Hand', creating a long-form competitive format.",
      cultural: "In Poland, the term 'Kierki' (meaning Hearts) is synonymous with tactical defensive play.",
