        pages: [
          {
            title: 'Kierki',
            subtitle: 'Avoidance',
            content: [
              {
                type: 'paragraph',
                text: 'Kierki (Polish Hearts) is the Polish variant of the classic avoidance trick-taking game Hearts. Played by four players, it features a unique multi-hand structure where the objective changes each roundâ€”from avoiding hearts to avoiding queens, or taking no tricks at all. It is a game of high strategic depth and defensive maneuvering.',
              },
              {
                type: 'paragraph',
                text: "Derived from the pan-European 'Hearts' family (like Black Lady in the US and Gong Zhu in China), Kierki was standardized in Poland in the late 20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players playing individually.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are high, 2s are low.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are high, 2s are low.',
              },
