    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Petteia',
            subtitle: 'Board Game',
            content: [
              {
                type: 'paragraph',
                text: "Petteia (also known as Poleis or 'Cities') is an ancient Greek board game of pure strategy and military logic. Featured in the writings of Plato and Aristotle, it is one of the world's first 'Pure Reason' games, containing no elements of chance. Players command 'Stones' on a grid, attempting to capture the opponent's forces by surrounding them from two sides (Custodian Capture). It is the direct ancestor of the Roman 'Ludus Latrunculorum' and is celebrated as a training tool for soldiers and philosophers alike.",
              },
              {
                type: 'paragraph',
                text: "Believed to have been invented around the 5th century BCE in Athens. It was so integral to Greek life that Homer mentions it being played by suitors in 'The Odyssey'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '8x8 grid (Standard) or 12x8 (Grand). One player uses White stones, the other Black.',
              },
              {
                type: 'paragraph',
                text: '8x8 grid (Standard) or 12x8 (Grand). One player uses White stones, the other Black.',
              },
              {
                type: 'paragraph',
                text: 'No cards; place stones on the board according to the chosen variant (standard or grand).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Standard (8x8): Played on an 8x8 grid; each player has a set of stones (typically 16). Initial placement and move rules as in main description.',
                  },
                  {
                    text: 'Grand (12x8): Played on a 12x8 grid; larger board with more stones (e.g. 32 total). Same custodian capture and movement rules; prioritise flanks.',
                  },
                  {
                    text: 'Reconstructed (modern): Historians have partially reconstructed rules from ancient texts; exact board size and initial setup vary among reconstructions.',
                  },
                ],
              },
            ],
          },
        ],
      },
