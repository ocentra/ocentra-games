    historyContent: {
      origins: 'Brag emerged in 16th-century England as a three-card vying game. It became the parent of Indian Teen Patti and influenced betting structures used by later poker-family games.',
      timeline: [
        "1500s: early versions of Post and Pair and Brag are documented in England.",
        '1700s: bragger wild-card variants appear, often using the Jack of Clubs.',
        '1900s: Brag remains common in British military, social club, and pub play.',
        'Present: the game survives as a compact high-pressure gambling and social card game.',
      ],
      evolution: 'The core hand rankings and half-price blind betting have stayed recognizable for centuries even as poker became globally dominant.',
      cultural: "Brag is often treated as a working-class British poker relative and appears in British gambling fiction and film culture.",
    },
