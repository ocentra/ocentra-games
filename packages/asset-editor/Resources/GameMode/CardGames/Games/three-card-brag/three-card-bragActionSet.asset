    actions: {
      setup_round: {
        supported: true,
        description: 'Collect boot and deal three private cards to each player.',
        constraints: 'System action at the start of each hand.',
        effectType: 'setup_round',
        cost: 'boot',
        effectHints: {
          dealCountPerPlayer: 3,
          boot: 'baseBet',
        },
        isTerminating: false,
      },
      ante: {
        supported: true,
        description: 'Contribute the agreed boot to seed the pot.',
        constraints: 'Required from every active player before the deal.',
        effectType: 'pay',
        cost: 'table_ante',
        effectHints: {
          targetZone: 'pot',
        },
        isTerminating: false,
      },
      bet: {
        supported: true,
        description: 'Put chips into the pot during the betting round.',
        constraints: 'Current active player only; amount must be positive.',
        effectType: 'bet',
        cost: 'variable',
        effectHints: {
          pot: 'roundPot',
        },
        isTerminating: true,
      },
      bet_blind: {
        supported: true,
        description: 'Bet without looking at the hand for the lower blind price.',
        constraints: 'Available only while the player remains blind.',
        effectType: 'bet',
        cost: 'blind_stake',
        effectHints: {
          state: 'blind',
          priceMultiplier: 1,
        },
        isTerminating: true,
      },
      see_cards: {
        supported: true,
        description: 'Look at the private three-card hand and become a seeing player.',
        constraints: 'May only happen before choosing a seeing bet.',
        effectType: 'reveal_private_to_self',
        cost: '0',
        effectHints: {
          stateChange: 'seeing',
        },
        isTerminating: false,
      },
      bet_seeing: {
        supported: true,
        description: 'Bet after seeing the hand, normally at the higher seeing price.',
        constraints: 'Available only after the player has seen their cards.',
        effectType: 'bet',
        cost: 'seeing_stake',
        effectHints: {
          state: 'seeing',
          priceMultiplier: 2,
        },
        isTerminating: true,
      },
      fold: {
        supported: true,
        description: 'Leave the current pot.',
        constraints: 'Folded players cannot win the current hand.',
        effectType: 'fold',
        cost: '0',
        effectHints: {
          removeFromPotContest: true,
        },
        isTerminating: true,
      },
      call_showdown: {
        supported: true,
        description: 'Move active players to hand reveal and rank comparison.',
        constraints: 'At least two active players must remain.',
        effectType: 'call_showdown',
        cost: '0',
        effectHints: {
          reveal: 'active_players',
        },
        isTerminating: true,
      },
      request_showdown: {
        supported: true,
        description: 'Force a comparison according to the current table stakes.',
        constraints: 'Usually requires matching the required comparison cost.',
        effectType: 'showdown',
        cost: 'table_showdown_cost',
        effectHints: {
          evaluator: 'three_card_brag_hand_rank',
        },
        isTerminating: true,
      },
      reveal_hand: {
        supported: true,
        description: 'Reveal a three-card hand during showdown.',
        constraints: 'Showdown phase only.',
        effectType: 'reveal_hand',
        cost: '0',
        effectHints: {},
        isTerminating: false,
      },
      score_round: {
        supported: true,
        description: 'Rank active hands and award the pot.',
        constraints: 'System action after folds or showdown reveal.',
        effectType: 'score_round',
        cost: '0',
        effectHints: {
          scoringType: 'three_card_brag_hand_rank',
