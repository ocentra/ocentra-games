    historyContent: {
      origins: "Rooted in the Sephardic and Mizrahi communities in Israel who brought 'passing' games from the Balkans and Turkey. The name 'Jukha' (or 'Juxa') is a common moniker for the Joker card in these regions.",
      originCountries: [
        'Israel',
        'Bulgaria',
      ],
      timeline: [
        '1950s: Game variants arrive in Israel with Bulgarian immigrants.',
        '1980s: Standardizes in Israeli secondary schools and military bases.',
        'Present: A ubiquitous family and group game in Israel.',
      ],
      evolution: "The game's primary evolution is the 'Double Out' rule where the last two players remaining compete in a final high-stakes duel.",
      cultural: "In Israel, being left with the Joker (the 'Jukha') is a lighthearted social embarrassment, often leading to a 'punishment' task like clearing the table.",
    },
    setupContent: {
      players: 'Optimal with 4-6 players.',
