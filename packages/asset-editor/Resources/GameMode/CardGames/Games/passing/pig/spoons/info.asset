    historyContent: {
      origins: "A family of simple card-passing games played in a circle; players pass one card left and try to collect four of a kind. The group has no single documented inventor. Pig uses a nose-touch signal; Spoons uses one fewer spoon than players in the center. Regional variants include Bouchon (France, with corks), Donkey (Australia, sometimes called Hog), Vatra and Magarac (Bosnia and Herzegovina), and Popa Prostul (Romania). More dangerous variants use forks or knives instead of spoons. Widely played as a parlor and children's game, with many contributors to the documented rules.",
      originCountries: [
        'USA',
      ],
      timeline: [
        '1950s: Becomes a staple at summer camps.',
        '1990s: Played as a drinking game in colleges.',
      ],
      evolution: "The use of 'Spoons' is arbitrary; it could be pens, coins, or anything grab-able.",
      cultural: 'Known for chaotic scrambles and bruised knuckles.',
    },
    setupContent: {
      players: '2 to 13 (up to 13 with one 52-card pack; more with multiple packs).',
