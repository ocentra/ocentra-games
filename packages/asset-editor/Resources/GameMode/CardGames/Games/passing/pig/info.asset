    historyContent: {
      origins: "Derived from traditional Victorian-era children's games. It evolved into a popular parlor game alongside 'Spoons' in the mid-20th century.",
      originCountries: [
        'UK',
        'USA',
      ],
      timeline: [
        "1890s: Games like 'Nosey Parker' and 'Snip-Snap-Snorum' introduce the collection mechanic.",
        "1940s: 'Pig' becomes a standard summer camp and dormitory game in the US and UK.",
        "1990s: Rebranded commercially in various 'Grab' and 'Reaction' card sets.",
        "Present: A staple ICE-breaker and party game universally known under names like 'Donkey' or 'Spoons'.",
      ],
      evolution: "The card-passing mechanic shifted from turn-based to simultaneous play to create the 'Speed-Chaos' effect that defines the modern game.",
      cultural: "Used as a metaphor for the 'Bandwagon Effect' in social psychologyâ€”people follow a leader often without knowing why the leader started.",
    },
    setupContent: {
