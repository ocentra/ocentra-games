    historyContent: {
      origins: "Derived from the merging of Briscola mechanics with the 'Marriage' (King-Queen) bonuses of the Mariagespiel family.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        '1800s: Briscola-based marriage games spread through Southern Italy.',
        "1920s: The name 'Mariaccio' becomes common in Naples and surrounding provinces.",
        'Present: A staple of Neapolitan cafe culture and family gatherings.',
        '20th Century: Variations for 4 players (partnerships) emerged, but the 2-player game remains the classic.',
      ],
      evolution: "The game moved from a 60-point target to a 250-point target to allow the 'Accuse' (marriages) to decide the outcome rather than just high cards.",
      cultural: "In Naples, 'Mariaccio' is often played with a sense of theater and loud 'Accuse' declarations.",
