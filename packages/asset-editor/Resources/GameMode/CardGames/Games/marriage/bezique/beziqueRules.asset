  data: {
    LLM: 'Phase 1 (The Draw): 1. Non-dealer leads. 2. You do NOT need to follow suit. 3. Winner of trick captures cards. 4. Winner *declares one meld* (places face up on table) if possible. 5. Both draw back up to 8 cards. Phase 2 (The End): When the stock is empty, players pick up their melded cards. Rules change: Must follow suit, must win trick if possible.',
    Player: 'Phase 1 (The Draw): 1. Non-dealer leads. 2. You do NOT need to follow suit. 3. Winner of trick captures cards. 4. Winner *declares one meld* (places face up on table) if possible. 5. Both draw back up to 8 cards. Phase 2 (The End): When the stock is empty, players pick up their melded cards. Rules change: Must follow suit, must win trick if possible.',
    objective: "First to reach 1000 points via Melds and Trick 'Brisques' (Aces and Tens).",
    gameplay: 'Phase 1 (The Draw): 1. Non-dealer leads. 2. You do NOT need to follow suit. 3. Winner of trick captures cards. 4. Winner *declares one meld* (places face up on table) if possible. 5. Both draw back up to 8 cards. Phase 2 (The End): When the stock is empty, players pick up their melded cards. Rules change: Must follow suit, must win trick if possible.',
    keyRules: [
      'You can only declare a meld AFTER winning a trick.',
      'Cards used in a meld remain on the table but can be played to subsequent tricks (breaking the meld).',
      'A card can be used in multiple different melds but not the same meld twice without re-melding.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Two players only. The standard two-handed game is played head-to-head; players cut for deal with the highest card having preference (rank order A, 10, K, Q, J, 9, 8, 7). No partnerships.',
      deck: '64 cards. Take two 52-card decks, remove all 2s, 3s, 4s, 5s, and 6s. Combine remaining. Start with 8 cards each.',
      equipment: 'Bezique markers (scoring dials or pegs).',
      dealing: 'Deal 8 cards to each player (3-2-3). Turn the next card for Trump. Place the remaining deck (Talon) face down.',
    },
    turnFlow: 'Phase 1 (The Draw): 1. Non-dealer leads. 2. You do NOT need to follow suit. 3. Winner of trick captures cards. 4. Winner *declares one meld* (places face up on table) if possible. 5. Both draw back up to 8 cards. Phase 2 (The End): When the stock is empty, players pick up their melded cards. Rules change: Must follow suit, must win trick if possible.',
    moveValidityConditions: {
      ante: 'Bezique is a point-based melding game and does not utilize a monetary or chip-based ante.',
      deal: 'The initial distribution of eight cards per player and the talon setup is handled by the system dealer.',
      reveal_market: 'The talon is a face-down stock; the only public card is the trump proposal turned up at the start.',
      buy_market: 'Players acquire new cards by drawing from the talon for free rather than purchasing from a market.',
      buy_stock: 'Drawing from the talon is a free mandatory phase action and does not involve a purchase cost.',
      fold: 'Both players must participate in the dual-phase trick play until all 64 cards have been played.',
      check: 'The game uses a trick-taking and melding structure rather than a vying structure with checks.',
      call: 'There is no pot or bet to match in Bezique; competition is based on point accumulation.',
      bet: 'Success is measured by points on a scorecard rather than through financial or chip-based betting.',
      raise: 'There are no wagering rounds in Bezique, so the value of the deal cannot be increased via raises.',
      declare: 'Only available to the winner of the previous trick during Phase 1.',
      reveal_hand: 'Hands remain private until played; melded cards are displayed publicly on the tableau.',
      award_pot: 'Winning is determined by cumulative match points rather than by awarding a physical pot.',
      play_card: 'Phase 1: Any card. Phase 2: Must follow suit and win if possible.',
      draw: 'Only during Phase 1 after each trick.',
      discard: 'Every card in the hand must be played into a trick; no cards are discarded to a waste pile.',
      pass: 'Players must always play a card to every trick; passing a turn without action is not allowed.',
      bid: 'The trump suit is determined by a random flip rather than through a bidding auction.',
      meld: 'Must win a trick immediately prior to the declaration.',
      go_out: 'The game terminates only after the talon is exhausted and the final eight tricks are played.',
    },
    exampleHands: [
      'Setup example: 8 card(s) per player.',
