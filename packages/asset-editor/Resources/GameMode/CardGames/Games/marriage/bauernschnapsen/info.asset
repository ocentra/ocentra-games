          deckDescription: 'One standard 24-card deck (or 20-card subset): only ace, ten, king, queen, and jack in each of four suits. No lower ranks; used for Bauernschnapsen (Farmer Schnapsen) with simplified trick-taking and trump calling.',
          suitDescription: 'Four French suits (spades, hearts, diamonds, clubs). Each suit has five cards (A, 10, K, Q, J). Trump is called by the player who holds the relevant card; follow suit when able.',
          rankDescription: 'Five ranks per suit: ace (high), ten, king, queen, jack (low). In trump the order may differ. No sixes through nines; this stripped deck is used for the short Bauernschnapsen variant.',
          dealPattern: '3 cards each, then 2 cards each after trump is called.',
          bettingLimits: 'None',
          actions: {},
          handRankingSystem: 'None; card value comparison (A=11, 10=10, K=4, Q=3, J=2) determines trick winner.',
          rankingSystem: 'A-10-K-Q-J',
          useTrump: true,
          notApplicableReasons: {
            drawConfig: 'All cards are distributed via the system deal; no draw pile exists during trick play.',
            discardConfig: 'Cards are played directly to tricks; no waste or discard pile is utilized in this variant.',
            specialCards: 'Cards contribute only their point and rank values to tricks without triggering secondary effects.',
            declarationMechanism: 'Contract bidding is performed verbally around the table; no hidden declaration is required.',
            fishingConfig: 'Bauernschnapsen is a trick-taking game and does not use a capture-from-tableau fishing mechanic.',
            shedding: 'Goal is to reach 66 points via tricks and melds; hands are played out in tricks, not emptied as in shedding games.',
