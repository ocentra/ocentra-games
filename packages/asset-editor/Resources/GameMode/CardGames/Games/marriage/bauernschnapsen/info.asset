    hero: {
      title: 'Bauernschnapsen',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bauernschnapsen',
            subtitle: 'Austrian Four-Player Schnapsen',
            content: [
              {
                type: 'paragraph',
                text: "Bauernschnapsen (Viererschnapsen) is the premier four-player partnership variant of the Austrian national game Schnapsen. Played with a stripped 20-card deck, it combines the intense card-point counting of the original game with complex partnership bidding and higher stakes. Each round is a battle to reach 66 points through tricks and marriages, while the overall session is a race to reach 24 game points. Famous for its 'Stechzwang' (trump compulsion) and various special contracts like 'Gang' and 'Bauern', it is a cornerstone of Central European tavern culture.",
              },
              {
                type: 'paragraph',
                text: "Originating in Austria as an evolution of 2-player Schnapsen (and the earlier 66), Bauernschnapsen adapted the 'short deck' mechanics to a four-player format. It emerged as a distinct social tradition in Austrian rural communities ('Bauern' meaning farmers) where partnership play was preferred for social gatherings.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships; partners sit opposite each other.',
              },
              {
                type: 'paragraph',
                text: '20 cards. Ranks: Ace (11), 10 (10), King (4), Queen (Ober, 3), Jack (Unter, 2) in four suits.',
              },
              {
                type: 'paragraph',
                text: 'Standard 20-card deck (French or German suited), score sheet.',
              },
              {
                type: 'paragraph',
                text: 'Dealer deals 3 cards to each player. Forehand (left of dealer) calls trump or knocks. Then 2 more cards are dealt to each player.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Talonschnapsen: A variant for 3 players where a small 'Talon' (stock) remains on the table.",
                  },
                  {
                    text: 'Bettel: A negative contract where the goal is to take no tricks at all.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
