    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mariáš',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Mariáš is the national card game of the Czech Republic and Slovakia, derived from the historical Mariagespiel. It is a highly competitive trick-taking and bidding game typically played by three players with a 32-card German-suited deck. The game involves complex bidding for different contracts (Standard, Seven, Betl, Durch) and is famous for its strict play rules: you must follow suit, you must trump, and you must win the trick if possible.',
              },
              {
                type: 'paragraph',
                text: "Developed from 18th-century Austrian/German games, it solidified into its current 'Marias' form in the Czech lands during the 19th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "3 players. One is the 'Declarer' (Solo), playing against the other two (Defenders).",
              },
              {
                type: 'paragraph',
                text: '32 cards: Ace, 10, King, Queen, Jack, 9, 8, 7.',
              },
              {
                type: 'paragraph',
                text: '32 cards: Ace, 10, King, Queen, Jack, 9, 8, 7.',
              },
              {
                type: 'paragraph',
                text: "Dealer deals 12-10-10 cards or 7-5-5-5-5-5. The declarer gets a 'Talon' (2 cards) to discard.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Suit: Ordinary game with trumps. Declarer aims to take more card points than the two defenders together. Bonuses for seven (last trick with trump 7), 100+ points, and marriages (king+over).',
                  },
                  {
                    text: 'Betl: No trumps. Declarer must lose every trick to win. Opponents win if they force the declarer to take any trick.',
                  },
                  {
                    text: 'Durch: No trumps. Declarer must win every trick. If opponents take any trick, declarer loses.',
                  },
                  {
                    text: "Open Betl: Like Betl but after the first trick the declarer's cards are placed face up; all remaining cards must be the lowest outstanding in their suits.",
                  },
                  {
                    text: "Open Durch: Like Durch but after the first trick the declarer's cards are face up; all remaining must be the highest outstanding in their suits.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
