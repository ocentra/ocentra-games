    historyContent: {
      origins: "Developed from 18th-century Austrian/German games, it solidified into its current 'Marias' form in the Czech lands during the 19th century.",
      originCountries: [
        'Czech Republic',
        'Slovakia',
      ],
      timeline: [
        '1890s: Marias clubs appear in Prague and Bratislava.',
        "1920: Rules for the 'Betl' and 'Durch' variants are standardized.",
        'Present: Remains the most popular card game in pubs across both countries, with national and international tournaments.',
        '20th Century: Influenced by bridge and skat to include more complex bidding trees.',
      ],
      evolution: "The game's 'Seven' (Sedma) contract is a unique feature where the player must win the LAST trick with the Seven of Trumps.",
      cultural: 'Commonly played for small stakes (e.g., Koruna or Euro-cents) in a loud, social pub atmosphere.',
    },
