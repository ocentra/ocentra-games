    customActions: [
      {
        supported: true,
        description: 'Deal cards according to player count: 6p dealer gives 8 each to other five (dealer sits out); 5p eight each; 4p ten each; 3p thirteen each plus one to centre. First hand coins are trumps; later hands turn last card to mano for trump (or centre card for 3p).',
        cost: '0',
        constraints: 'Dealer acts during deal phase. Deal and play counter-clockwise.',
