    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Marianna',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Marianna is a fast-paced Italian partnership card game, widely considered a strategic evolution of Briscola. Played by four players in two fixed teams, it is unique because the 'Trump' suit is not predetermined by the dealer. Instead, the first team to declare a 'Marianna' (a King and Knight of the same suit) simultaneously scores bonus points and chooses the trump suit for the remainder of the round. This dynamic makes the start of every hand a high-speed race to find and declare a marriage.",
              },
              {
                type: 'paragraph',
                text: "Emerging in Sicily and Southern Italy as a variation of the French/Spanish 'Mariage' games, it was refined into a 4-player team game in the early 20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: '40 cards. Ranking: Ace, 3, King, Knight, Jack, 7, 6, 5, 4, 2.',
              },
              {
                type: 'paragraph',
                text: '40 cards. Ranking: Ace, 3, King, Knight, Jack, 7, 6, 5, 4, 2.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 5 cards at a time. No card is turned for trumps.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Declaration at start of trick: Marianne may be declared before any card is led; the player leading to the trick pauses to allow declarations. Once a card is led, no more declarations until next trick.',
                  },
                  {
                    text: 'Lower marianna scores: First marianna 20, second 40, third 60, fourth 80 points instead of 40, 60, 80, 100.',
                  },
                  {
                    text: 'First marianna sets trump only: Later marianna declarations score points but do not change the trump suit.',
                  },
                ],
              },
            ],
          },
        ],
      },
