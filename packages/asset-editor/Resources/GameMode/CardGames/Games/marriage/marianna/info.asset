    historyContent: {
      origins: "Emerging in Sicily and Southern Italy as a variation of the French/Spanish 'Mariage' games, it was refined into a 4-player team game in the early 20th century.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        '1910s: Becomes the most popular competitive card game in Sicilian social clubs (Circoli).',
        "1950s: Rules for 'Cinquecento' (500) and partnership 'Accuse' are standardized.",
        'Present: A cultural staple of Southern Italy, frequently played in bars and piazzas.',
        '2004: Digitized for online card game platforms specializing in Italian regional games.',
      ],
      evolution: "The game's 'shifting trump' mechanic (where the trump suit can change if a SECOND Marianna is declared) is a rare feature in trick-taking history.",
      cultural: "In Sicily, declaring a Marianna is often called 'Cantare' (to sing).",
    },
    setupContent: {
