              {
                type: 'paragraph',
                text: '40-card Spanish pack.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: 'Six cards each; 13th card face up for trump; rest form stock.',
              },
            ],
