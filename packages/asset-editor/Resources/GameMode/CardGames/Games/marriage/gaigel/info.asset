          hero: {
            title: 'GAIGEL',
            subtitle: 'The Swabian Tradition',
            tagline: 'Masters track every card. Partnerships signal through discards. First to 101 wins.',
          },
          shortDescription: 'A partnership trick-taking game from Southwest Germany combining strategic play in two distinct phases: free play while cards remain in the Talon, then strict suit-following once the Talon is exhausted.',
          uiThemes: [
            'classic',
          ],
          uiLayout: {
            zones: [
