    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Gaigel',
            subtitle: 'The Swabian Tradition',
            content: [
              {
                type: 'paragraph',
                text: "Gaigel is a traditional trick-taking game hailing from Swabia in Southwest Germany. Closely related to the game 'Sixty-Six' (Sechsundsechzig), Gaigel is played with a double-deck of 48 cards, typically featuring the distinct German-suited WÃ¼rttemberg pattern. It is primarily a partnership game where the goal is to reach 101 card points through captured tricks and 'marriages' (King and Ober pairs). The game is famous for its midndgame shift, where strict following-suit rules only apply once the draw pile (Talon) is exhausted.",
              },
              {
                type: 'paragraph',
                text: "Gaigel originated in the 19th century in the Swabian region of Germany. It is named after its highest rank (the 'Gaigel' or Ace in some dialects). It co-evolved with Binokel and represents a rich tradition of Southwestern German pub games.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two partnerships (North/South vs East/West).',
              },
              {
                type: 'paragraph',
                text: '48 cards (WÃ¼rttemberg pattern). Two copies of Ace, 10, King, Ober, Unter, and 7 per suit.',
              },
              {
                type: 'paragraph',
                text: '48 cards (WÃ¼rttemberg pattern). Two copies of Ace, 10, King, Ober, Unter, and 7 per suit.',
              },
              {
                type: 'paragraph',
                text: 'Done counter-clockwise in batches of 3 then 2. The 21st card is turned face-up as the trump suit indicator.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Six-Player Partnership: Uses the same core rules with three-player teams seated opposite each other; the talon is exhausted much earlier.',
                  },
                  {
                    text: 'Five Sevens: Some tables allow a player with five sevens to claim an immediate single game win for their side.',
                  },
                  {
                    text: 'Auf Siebener: A player with four sevens may announce and attempt to draw the fifth from talon before opponents reach 101.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Gaigel is a traditional trick-taking game hailing from Swabia in Southwest Germany. Closely related to the game 'Sixty-Six' (Sechsundsechzig), Gaigel is played with a double-deck of 48 cards, typically featuring the distinct German-suited WÃ¼rttemberg pattern. It is primarily a partnership game where the goal is to reach 101 card points through captured tricks and 'marriages' (King and Ober pairs). The game is famous for its midndgame shift, where strict following-suit rules only apply once the draw pile (Talon) is exhausted.",
    tags: [
      'card-game',
      'trick-taking',
      'traditional',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'gaigel',
    LLM: 'Game: Gaigel (German trick-taking). Setup: 4 players in two partnerships. 48-card German deck (WÃ¼rttemberg pattern). 12 cards dealt (3 then 2 batches). 21st card shown as trump. Gameplay: Two phases: (1) Talon phase: players can play any card, no suit-following. (2) Talon empty: must follow suit, must trump if unable. Marriages (K+O of same suit) declare for 20 (non-trump) or 40 (trump) points. Scoring: Ace=11, 10=10, K=4, O=3, U=2, 7=0. Win: First team to 101 points.',
    Player: "Welcome to Gaigel, where German tradition meets strategy. You and your partner must work together to reach 101 points first. Early in the hand, you can play any cardâ€”use this freedom wisely. When the Talon runs dry, you must follow suit or trump. Declare marriages (matching King and Ober) for 20 or 40 points. Count carefully, and call 'Out!' when you believe you've reached 101.",
    tagline: 'Masters track every card. Partnerships signal through discards. First to 101 wins.',
    gameCategory: 'Trick-taking',
    subcategory: 'Marriage / Ace-Ten',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '15-30 minutes',
    origin: 'Swabia, Germany',
    originName: 'Gaigel (Swabian/German)',
    deck: 'Gaigel/Binokel pack (48 cards: 2x A, 10, K, O, U, 7)',
    alsoKnownAs: [
      'WÃ¼rttemberg Gaigel',
      'Binocle (Swiss variant)',
    ],
    playersDisplay: '4 (Partnerships), 2-6',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
