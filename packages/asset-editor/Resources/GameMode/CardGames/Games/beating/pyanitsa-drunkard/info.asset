    historyContent: {
      origins: 'Dates back to the 19th century in the Russian Empire. It was originally played with the standard 36-card deck used for Durak and other traditional Russian games.',
      originCountries: [
        'Russia',
      ],
      timeline: [
        '1850s: First documented rules in Russian game manuals.',
        "1917: Survives the revolution as a popular 'proletariat' game due to its simplicity.",
        "1960s: Standardized children's version ('Drunkard') becomes a household name in the USSR.",
        'Present: Still the first game taught to most Russian children.',
      ],
      evolution: "The '6 beats Ace' rule was likely added to simulate folk stories of the 'little guy' overcoming the powerful.",
      cultural: "The name 'P'yanitsa' (Drunkard) comes from the way the cards 'toss and turn' without player control, much like a person in an intoxicated state.",
    },
    setupContent: {
