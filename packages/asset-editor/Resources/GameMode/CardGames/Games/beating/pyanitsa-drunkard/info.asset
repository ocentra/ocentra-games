  data: {
    hero: {
      title: "P'YANITSA",
      subtitle: 'Russian Drunkard',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: "P'yanitsa (Russian Drunkard)",
            subtitle: 'Russian Drunkard',
            content: [
              {
                type: 'paragraph',
                text: "P'yanitsa (The Drunkard) is the most popular children's card game in Russia, acting as the Eastern European equivalent to the western game of 'War'. It is a game of pure chance and endurance where players aim to capture the entire deck. Its unique characteristic is the '6 beats Ace' rule, which prevents the highest card from being invincible. It is exceptionally simple, making it a staple of Russian childhood and social gatherings.",
              },
              {
                type: 'paragraph',
                text: 'Dates back to the 19th century in the Russian Empire. It was originally played with the standard 36-card deck used for Durak and other traditional Russian games.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 is standard; up to 4 is possible.',
              },
              {
                type: 'paragraph',
                text: '36 cards (6, 7, 8, 9, 10, J, Q, K, A).',
              },
              {
                type: 'paragraph',
                text: '36-card deck.',
              },
              {
                type: 'paragraph',
                text: 'The entire deck is dealt face-down to all players. Players do not look at their cards.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Drunkard (Giveaway): The first person to run out of cards wins.',
                  },
                  {
                    text: '52-Card Drunkard: Uses a full deck; 2 beats Ace.',
                  },
                  {
                    text: 'Group Drunkard: 4 players; creates massive win piles.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "P'yanitsa (The Drunkard) is the most popular children's card game in Russia, acting as the Eastern European equivalent to the western game of 'War'. It is a game of pure chance and endurance where players aim to capture the entire deck. Its unique characteristic is the '6 beats Ace' rule, which prevents the highest card from being invincible. It is exceptionally simple, making it a staple of Russian childhood and social gatherings.",
