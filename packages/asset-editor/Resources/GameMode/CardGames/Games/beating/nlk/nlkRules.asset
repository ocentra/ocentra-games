      deck: 'Variable size: 4 players=32 cards (A-7), 5 players=36 cards (A-6), 6 players=40 cards (A-5), 9 players=52 cards (A-2). Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2.',
      equipment: 'Variable deck size based on player count.',
      dealing: 'One card dealt face-up to each player. Remaining cards form the talon (face-down stack).',
