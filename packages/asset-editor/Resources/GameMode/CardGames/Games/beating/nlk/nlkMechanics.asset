    customActions: [
      {
        supported: true,
        description: "Draw the top card of the talon. You may give it to an opponent's stack if it fits (next rank above); if you do, draw again until you place a card on your own stack. Your turn ends when you place a card on your own stack.",
        cost: '0',
        constraints: 'Legal at start of your turn in Phase One. Once you have drawn from the talon you may no longer move cards from your own stack this turn.',
        isTerminating: false,
        effectType: 'draw',
        id: 'draw_talon',
        effectHints: {},
      },
      {
        supported: true,
        description: "Move the top card of your stack onto the top of another player's stack if it fits (your card is next rank above the card it covers; lowest rank fits on Ace). You may continue giving away from your stack as long as each card fits somewhere.",
        cost: '0',
        constraints: 'Legal at start of your turn in Phase One, before drawing from the talon. You are never obliged to give away cards.',
        isTerminating: false,
        effectType: 'play',
        id: 'give_away_card',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a card that beats the previous card played to the trick: either a higher card of the same suit or any trump.',
        cost: '0',
        constraints: 'Legal in Phase Two when it is your turn to play to the trick. No obligation to follow suit; you may instead pick up the lowest card in the trick.',
        isTerminating: false,
        effectType: 'play',
        id: 'beat_card',
        effectHints: {},
      },
      {
        supported: true,
        description: "Pick up the lowest card in the trick and add it to your hand. It is then the next player's turn to lead to a new trick.",
        cost: '0',
        constraints: 'Legal in Phase Two when you are unable or unwilling to beat the previous card. You are never forced to play; you can always choose to pick up the lowest card instead.',
        isTerminating: false,
        effectType: 'play',
        id: 'pick_up_lowest',
