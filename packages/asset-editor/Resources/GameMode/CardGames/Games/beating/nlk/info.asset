    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'NLK',
            subtitle: 'Hungarian Two-Phase Beating Game',
            content: [
              {
                type: 'paragraph',
                text: "NLK is a Hungarian beating/shedding card game for 4-9 players in two phases. Phase One: players accumulate cards by drawing from a talon and giving away cards that fit on opponents' stacks (next rank higher). Phase Two: players try to shed their accumulated cards by beating cards in tricks. The last player holding cards loses.",
              },
              {
                type: 'paragraph',
                text: "NLK is a Hungarian card game learned from students at Szeged University. The initials stand for an obscene Hungarian phrase: N=nagy (big), L=any nationality starting with L (litvÃ¡n, lengyel, luxemburgi), K=kibaszÃ³s (roughly 'screwing'). The game is light-hearted and best with about six players.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4-9 players. Deal and play are anticlockwise.',
              },
              {
                type: 'paragraph',
                text: 'Variable size: 4 players=32 cards (A-7), 5 players=36 cards (A-6), 6 players=40 cards (A-5), 9 players=52 cards (A-2). Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2.',
              },
              {
                type: 'paragraph',
                text: 'Variable deck size based on player count.',
              },
              {
                type: 'paragraph',
                text: 'One card dealt face-up to each player. Remaining cards form the talon (face-down stack).',
              },
            ],
          },
        ],
      },
