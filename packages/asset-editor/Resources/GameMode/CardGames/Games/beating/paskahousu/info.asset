    hero: {
      title: 'PASKAHOUSU',
      subtitle: 'Finnish Shedding Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Paskahousu',
            subtitle: 'Finnish Shedding Game',
            content: [
              {
                type: 'paragraph',
                text: "Paskahousu (Finnish for 'shit pants') is a Finnish shedding game related to Shithead. Play cards equal or higher than the pile; 2s, 10s, and Aces have special effects. Last player with cards loses.",
              },
              {
                type: 'paragraph',
                text: 'Finnish game; name means a coward. Related to Shithead, which spread via backpackers. Face-up version; face-down version is Valepaska.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players. Best 3-5.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards. Rank: 2 (high), A, K, Q, J, 10...3 (low). 2s, 10s, Aces are special.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck. Remainder = stock.',
              },
              {
                type: 'paragraph',
                text: 'Deal 2+2+1 = 5 cards each. Remainder stacked face down = stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Pöytäpaska: Table shit: 4 face-down + 4 face-up per player. Play hand first, then face-up, then blind face-down. Like Shithead.',
                  },
                  {
                    text: 'Ruotsalainen: Swedish: all cards dealt; no stock.',
                  },
                  {
                    text: 'Two Decks: With 6+ players, use two decks. Four-of-a-kind may not clear (house rule).',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
