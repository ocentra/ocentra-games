    hero: {
      title: "Kryt'-Navalivat' (Крыть-наваливать)",
      subtitle: 'Shedding',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: "Kryt'-Navalivat' (Крыть-наваливать)",
            subtitle: 'Russian Cover and Pile',
            content: [
              {
                type: 'paragraph',
                text: "Kryt'-Navalivat' (Russian for 'Covering and Piling Up') is a traditional Russian card game for two players, although it can accommodate more. It is a descendant of the 'Durak' (Fool) family, specifically influenced by 'Duraki s nakladkoy'. The game focuses on the tactical choice between beating a card (Covering) and forcing more cards onto the opponent (Piling Up). The objective is to empty your hand; the last player left with cards is the 'Fool'.",
              },
              {
                type: 'paragraph',
                text: "Originates in 18th-century Russia, predating the modern standardized 'Podkidnoy Durak'. It belongs to the 'Nakladka' branch of games which emphasizes the volume of cards in the play pile.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players is the standard competitive format.',
              },
              {
                type: 'paragraph',
                text: '36 cards. Rank: A (High) > K > Q > J > 10 > 9 > 8 > 7 > 6 (Low).',
              },
              {
                type: 'paragraph',
                text: '36 cards. Rank: A (High) > K > Q > J > 10 > 9 > 8 > 7 > 6 (Low).',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 3 cards. The next card is turned up to set the Trump suit. The rest form a draw stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Duraki s nakladkoy: The direct parent game with more complex piling rules.',
                  },
                  {
                    text: 'Vsyak svoi kozyri: A variant where each player chooses their own trump suit.',
                  },
                  {
                    text: 'Podkidnoy Durak: The modern international standard.',
                  },
                ],
              },
            ],
          },
        ],
      },
