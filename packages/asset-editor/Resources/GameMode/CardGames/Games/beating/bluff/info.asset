    hero: {
      title: 'Bluff',
      subtitle: 'Vying',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bluff',
            subtitle: 'The Art of Deception',
            content: [
              {
                type: 'paragraph',
                text: "Bluff (also known as 'I Doubt It' or IDI) is a tactical shedding game based on deception and rank counting. Players take turns playing cards face-down, claiming they all match the current required rank. Anyone can challenge a claim; if the liar is caught, they take the entire central pile, but if the challenger is wrong, they take it instead. It is a universal social game that rewards a 'poker face' and sharp memory.",
              },
              {
                type: 'paragraph',
                text: "Bluff is a regional variant of the children's game I Doubt It, played in West Bengal, India, where players may lay several cards while claiming they all match the required rank. It belongs to the broader family of 'Cheat' games based on deception and card counting.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 6 players playing individually.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack (No Jokers).',
              },
              {
                type: 'paragraph',
                text: 'Standard pack.',
              },
              {
                type: 'paragraph',
                text: 'Deal the entire deck as evenly as possible clockwise. Players keep their hands private but their card count visible.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Bullshit (Sequential): Rank increments every turn (Aces, then 2s, then 3s...) rather than staying the same for a round.',
                  },
                ],
              },
            ],
          },
        ],
      },
