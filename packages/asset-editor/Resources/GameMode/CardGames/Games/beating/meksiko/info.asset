    hero: {
      title: 'Meksiko',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Meksiko',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Meksiko is the most popular trick-taking game in Serbia, played by three players with a 32-card deck. It is an Auction Whist variant where players bid on the number of tricks they will take, with the highest bid 'Meksiko' being an undertaking to win all tricks without the talon and with no trumps. The game combines bidding strategy with precise trick-taking play.",
              },
              {
                type: 'paragraph',
                text: "Meksiko was likely inspired by Preference, a similar game popular in Eastern Europe. The game has no actual connection to Mexico - 'Meksiko' is simply the Serbian spelling used as the name of the highest bid.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 players (standard). Can be played with 4 if the dealer sits out each hand.',
              },
              {
                type: 'paragraph',
                text: '32-card pack (7 through Ace in each suit). Ranking: A (high), K, Q, J, 10, 9, 8, 7 (low). Often played with Hungarian cards (William Tell pattern).',
              },
              {
                type: 'paragraph',
                text: '32-card deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: '10 cards to each player, dealt in packets. The remaining 2 cards form the talon (kup).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "No Five Bid: Some variants don't allow an explicit bid of 5; minimum is 6.",
                  },
                  {
                    text: 'Short Game: Played to 31 points rather than 51 for a faster game.',
                  },
                  {
                    text: 'Pub Scoring: Alternative scoring method sometimes used in casual play.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
