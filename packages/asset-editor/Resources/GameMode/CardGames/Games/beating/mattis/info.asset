    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mattis',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mattis (also known as Skitgubbe in Sweden) is a unique two-phase card game popular in Scandinavia. The first phase involves collecting cards by winning tricks, while the second phase reverses the objective - players try to get rid of their collected cards by beating opponents' cards. The last player holding cards loses. It is a game of strategic timing and card management.",
              },
              {
                type: 'paragraph',
                text: 'The game originated in Finland as Myllymatti (mentioned in 19th century newspaper articles) and spread to Sweden where it became known as Skitgubbe. The Norwegian variant is called Mattis.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 players (standard). Can be adapted for 2 or 4 with modifications.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: A (high), K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2 (low).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, score sheet optional.',
              },
              {
                type: 'paragraph',
                text: 'Three cards each; remainder forms face-down stock. With three players one card remains in the stock or is set aside.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Myllymatti (Finnish): The original Finnish version with slightly different dealing rules.',
                  },
                  {
                    text: 'Skitgubbe (Swedish): Swedish variant with optional rules for compulsory ties.',
                  },
                  {
                    text: 'Four-Player Mattis: Played with partnerships or each player for themselves with a double deck.',
                  },
                ],
              },
            ],
          },
        ],
      },
