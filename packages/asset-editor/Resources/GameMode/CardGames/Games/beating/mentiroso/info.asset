    historyContent: {
      origins: 'Dates back centuries as a gambling folk game. The Spanish version is distinct due to the use of the 40-card deck (Oros, Copas, Espadas, Bastos).',
      originCountries: [
        'Spain',
      ],
      timeline: [
        '1700s: Bluffing games documented in Spanish military camps.',
        "1800s: The 'Mentiroso' name and the 40-card deck standard become unified.",
        'Present: One of the most common family card games across the Spanish-speaking world.',
        '20th Century: Digital versions for social media and mobile apps have revitalized the game for younger generations.',
      ],
      evolution: "The game's use of a smaller deck (40 vs 52) makes 'Card Counting' significantly easier and more rewarding than in the international version.",
      cultural: "Used as a playful way to call out dishonesty among friends (the 'Mentiroso' title is a badge of dishonor or cleverness).",
    },
