        rules: {
          objective: 'Get rid of all your cards by playing them to the central pile; play cards equal to or higher than the top card or pick up the whole pile. The last player left holding cards is the loser (the shithead).',
          gameplay: 'Players take turns playing cards (or sets) equal to or higher than the top of the pile. If unable or unwilling, they pick up the whole pile. While stock remains, players refill hand back to three cards. Special cards commonly include 2 (wild/reset), 10 (burn pile), and four-of-a-kind pile clear. After hand cards are gone, players use face-up table cards, then unknown face-down cards.',
          keyRules: [
            'Failing to play requires taking the entire pile.',
            '10 and certain quartet conditions clear the pile in common rulesets.',
            'Last player with remaining cards is the loser.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Preserve strong utility cards (especially 2s and 10s) for emergency escapes and pile control.',
          intermediate: 'Manage hand refill tempo so opponents are forced to pick up large piles.',
          advanced: 'Sequence same-rank plays to threaten quartet clears and control transition from hand to table cards.',
          tips: [
            'Do not spend all recovery cards before entering face-down phase.',
            'Large pile pressure can force opponents into losing lines even with strong ranks.',
          ],
          hasPlaceholders: false,
        },
