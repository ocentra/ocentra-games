        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pan (Polish)',
            subtitle: '24-Card Shedding',
            content: [
              {
                type: 'paragraph',
                text: 'Pan is a Polish shedding game with a 24-card pack. The 9 of hearts starts the play pile. Players play cards equal to or higher than the top, or pick up. Last player holding cards gets a letter (P-A-N); first to spell the word loses.',
              },
              {
                type: 'paragraph',
                text: "Polish card game. 'Pan' means gentleman (euphemism). Unrelated to American Panguingue.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players. Best 2-4.',
              },
              {
                type: 'paragraph',
                text: '24-card French pack (A-K-Q-J-10-9). Rank: A (high) to 9 (low). Suits irrelevant except 9â™¥.',
              },
              {
                type: 'paragraph',
                text: '24-card pack.',
              },
              {
                type: 'paragraph',
                text: 'Deal all cards as equally as possible: 2 players = 12 each, 3 = 8 each, 4 = 6 each, 5 = 4+5 each, 6 = 4 each.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Max Three Pickup: When 3+ cards on 9â™¥, must take exactly 3 (not more).',
                  },
                  {
                    text: 'Three Equals Higher: Allow playing any three equal cards higher than the top (some find this too easy).',
                  },
                ],
              },
            ],
          },
        ],
      },
