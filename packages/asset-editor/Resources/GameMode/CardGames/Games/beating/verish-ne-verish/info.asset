    hero: {
      title: "Verish' Ne Verish'",
      subtitle: 'Vying',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: "Verish' Ne Verish'",
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Verish' Ne Verish' ('Believe It or Not') is the Russian version of BS/Cheat. 2-6+ players. Deal all cards. Play face-down declaring rank. Players call 'Ne Veryu!' to challenge. Wrong challengee picks up pile; wrong challenger picks up pile. Shed all cards to win.",
              },
              {
                type: 'paragraph',
                text: "Verish' Ne Verish' is the Russian equivalent of I Doubt It (Cheat/BS). The name means 'Trust - don't trust'. It belongs to the worldwide family of shedding games where players play face-down, declare ranks, and may be challenged. The game is played in Russia as a family and casual game.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '36 or 52 cards. Deal all evenly.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: 'All cards dealt.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'I trust and expose: Player may say I trust and expose previous play; if lied they pick up, if truth cards go to discard and they start next round. Often no four-of-a-kind discard.',
                  },
                  {
                    text: 'No fours discard: Players may not discard sets of four equal cards; legal to start a round by playing four cards.',
                  },
                  {
                    text: 'Last card wait: When a player plays their last cards they must wait until turn comes again and then trust or not trust; if wrong they pick up and stay in the game.',
                  },
                ],
              },
            ],
          },
        ],
      },
