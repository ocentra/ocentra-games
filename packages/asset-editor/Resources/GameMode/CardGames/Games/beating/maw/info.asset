    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Maw',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Maw is a historic trick-taking card game that was popular in 16th century Britain and Ireland. It is the ancestor of the Irish game Spoil Five and other related games. Played with a distinctive 52-card deck where the 5 and 9 of trumps have special powers, Maw features unique ranking orders and the ability to renege (not follow suit) under specific circumstances.',
              },
              {
                type: 'paragraph',
                text: 'Maw was extremely popular in 16th century Britain, played at the court of James I. It spread to Ireland where it evolved into Spoil Five and related games like Twenty-Five, Forty-Five, and One Hundred and Ten.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-10 players (best with 5-7). Can be played individually or in partnerships.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. In trump suits, cards rank: 5 (highest), J, A, K, Q, 10, 9, 8, 7, 6, 4, 3, 2. In non-trump suits: K (high), Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2, A (low).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, chips or counters for scoring.',
              },
              {
                type: 'paragraph',
                text: '5 cards to each player, dealt in packets. Remaining cards form the stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Spoil Five: The Irish descendant of Maw with more complex scoring and the 'spoiling' mechanic.",
                  },
                  {
                    text: 'Twenty-Five: Modern Irish game descended from Maw, played to 25 points.',
                  },
                  {
                    text: 'Forty-Five: Popular in Atlantic Canada, descended from Maw traditions.',
                  },
                ],
              },
            ],
          },
        ],
      },
