    icon: '🃏',
  },
  data: {
    LLM: 'Play is clockwise. The player to the left of the dealer leads any card face-up to start the play pile. On your turn you may either beat the top card (play a higher card of the same suit or one of your own trumps on a different suit) and then play a second card of your choice on top, or pick up cards from the pile (3 if the top is not your trump, 5 if it is your trump but not the ace, or the whole pile if it is the ace of your trump). After a pick-up, the next player must beat the new top card or pick up. If the pile is empty, the next player leads any card. Each player has one assigned trump suit; only your own trumps can beat other suits.',
    Player: 'Play is clockwise. The player to the left of the dealer leads any card face-up to start the play pile. On your turn you may either beat the top card (play a higher card of the same suit or one of your own trumps on a different suit) and then play a second card of your choice on top, or pick up cards from the pile (3 if the top is not your trump, 5 if it is your trump but not the ace, or the whole pile if it is the ace of your trump). After a pick-up, the next player must beat the new top card or pick up. If the pile is empty, the next player leads any card. Each player has one assigned trump suit; only your own trumps can beat other suits.',
    objective: 'Get rid of all your cards. The last player left holding cards is the loser.',
    gameplay: 'Play is clockwise. The player to the left of the dealer leads any card face-up to start the play pile. On your turn you may either beat the top card (play a higher card of the same suit or one of your own trumps on a different suit) and then play a second card of your choice on top, or pick up cards from the pile (3 if the top is not your trump, 5 if it is your trump but not the ace, or the whole pile if it is the ace of your trump). After a pick-up, the next player must beat the new top card or pick up. If the pile is empty, the next player leads any card. Each player has one assigned trump suit; only your own trumps can beat other suits.',
    keyRules: [
      'Each player has a different trump suit agreed before play.',
      'Before play, players give any sixes to the player who has that suit as trumps.',
      'Beat with higher same suit or your trump; then play a second card.',
      'Cannot or will not beat: pick up 3, 5, or whole pile depending on top card.',
      'Last player holding cards loses and deals the next hand.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Two, three, or four players; best for four. Each player has a different trump suit agreed before play.',
      deck: 'Standard Russian 36-card pack: A, K, Q, J, 10, 9, 8, 7, 6 in each of the four French suits.',
      equipment: 'Standard Russian 36-card pack: A, K, Q, J, 10, 9, 8, 7, 6 in each of the four French suits.',
      dealing: "Any player deals first; then the loser of each hand deals. Dealer shuffles, optional cut by player to dealer's right, then deals all 36 cards clockwise one at a time. Before play, players with sixes give them to the player who has that suit as trumps so each player has at least one trump.",
    },
    turnFlow: 'Play is clockwise. The player to the left of the dealer leads any card face-up to start the play pile. On your turn you may either beat the top card (play a higher card of the same suit or one of your own trumps on a different suit) and then play a second card of your choice on top, or pick up cards from the pile (3 if the top is not your trump, 5 if it is your trump but not the ace, or the whole pile if it is the ace of your trump). After a pick-up, the next player must beat the new top card or pick up. If the pile is empty, the next player leads any card. Each player has one assigned trump suit; only your own trumps can beat other suits.',
