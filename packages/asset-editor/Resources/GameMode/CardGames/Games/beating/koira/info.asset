    historyContent: {
      origins: 'Originates from 19th-century Finnish folk traditions, closely related to the Swedish game Skitgubbe and the Norwegian Mattis. It was historically a common game among forestry workers and farming families.',
      originCountries: [
        'Finland',
      ],
      timeline: [
        '1800s: Emerges as a folk variation of Northern European beating games.',
        '1950s: Standardized rules appear in Finnish game books.',
        "Present: Remains a popular 'last person loses' social game in Finland.",
      ],
      evolution: "The game's unique 'Barking' penalty evolved as a way to add humor and stakes to what is otherwise a simple math/memory game.",
      cultural: "In Finnish culture, being the 'Koira' is a humorous mark of bad luck in cards.",
    },
