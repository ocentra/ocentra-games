    historyContent: {
      origins: 'Dates to the early 20th century in Russia. It shares DNA with Bura and common Russian gambling games developed in naval and prison environments.',
      originCountries: [
        'Russia',
      ],
      timeline: [
        '1910s: Early variants emerge in Saint Petersburg.',
        '1940s-1950s: Becomes a staple backyard and social game during the Soviet era.',
        'Present: One of the most common casual card games in Russia and Central Asia.',
      ],
      evolution: "The game evolved to allow for 'Combinations' (like Moscow or Bura) which permit a player to seize the lead regardless of the previous trick winner.",
      cultural: "The term 'Kozel' is a playful insult in Russia; losing the game usually results in being called the 'Goat' until the next round.",
