    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kozel (Russian Goat)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Kozel (Russian for 'Goat') is a highly aggressive Russian trick-taking game played with 36 cards. It is a descendant of the German game 'Bura' and is distinguished by its unique rule allowing players to lead multiple cards of the same suit simultaneously. It is an 'Ace-Ten' game where the objective is to capture point cards, and the loser is mocked as the 'Goat'.",
              },
              {
                type: 'paragraph',
                text: 'Dates to the early 20th century in Russia. It shares DNA with Bura and common Russian gambling games developed in naval and prison environments.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Optimal with 2 or 4 (in partnerships).',
              },
              {
                type: 'paragraph',
                text: '36 cards. Rank: Ace (11), Ten (10), King (4), Queen (3), Jack (2). 9s, 8s, 7s, 6s = 0 points.',
              },
              {
                type: 'paragraph',
                text: '36 cards. Rank: Ace (11), Ten (10), King (4), Queen (3), Jack (2). 9s, 8s, 7s, 6s = 0 points.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 4 cards (some variants 3). The remaining cards form the stock.',
              },
            ],
          },
        ],
      },
