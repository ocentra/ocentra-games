    setup: {
      players: '2-6 players. Best with 3-4 to ensure the Secret Trump phase is reached.',
      deck: '36-card Russian pack (6, 7, 8, 9, 10, J, Q, K, A).',
      equipment: '36-card deck.',
      dealing: '1. Each player is dealt 6 cards.\n2. One card is placed FACE-DOWN in the center.\n3. The next card is placed FACE-UP on top of it (The Initial Trump Suit).\n4. The stock is placed on top of these two cards.',
    },
