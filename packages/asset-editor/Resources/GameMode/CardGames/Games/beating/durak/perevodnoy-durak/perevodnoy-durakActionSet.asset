    customActions: [
      {
        supported: true,
        description: 'Lead one or more cards to attack the defender; may lead two or more cards of the same rank. Attack passes to next player if defender transfers.',
        cost: '0',
        constraints: "Attacker must have cards; attack size cannot exceed six cards or defender's hand size for transfer.",
        isTerminating: false,
        effectType: 'play',
        id: 'attack',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a higher card of the same suit or any trump to beat an attack card; once beaten, that card can no longer be transferred.',
        cost: '0',
        constraints: 'Card must be same suit and higher, or trump; defender may beat all attack cards or pick up.',
        isTerminating: false,
        effectType: 'play',
        id: 'beat',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a card of the same rank as the first attack card to transfer the attack to the next player; you become attacker, they defend the combined attack.',
        cost: '0',
        constraints: 'Only if you have a card matching the rank of the first attack card; cannot transfer if the next player has fewer cards than the number of attack cards.',
        isTerminating: false,
        effectType: 'play',
        id: 'transfer',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Take all attack cards (and any beaten cards) into your hand; you become the next attacker.',
