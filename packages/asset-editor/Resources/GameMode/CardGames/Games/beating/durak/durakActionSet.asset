    customActions: [
      {
        supported: true,
        description: 'Deal six cards to each player face down, one at a time clockwise. Turn the next card face up for trump; place remaining cards face down on top of it crosswise so the trump suit stays visible (prikup/talon).',
        cost: '0',
        constraints: 'Dealer only, at hand start.',
        isTerminating: false,
        effectType: 'custom',
        id: 'deal_6_set_trump',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play one card face up in front of the defender to start or continue an attack. Non-trump is beaten by a higher card of the same suit or any trump; trump only by a higher trump.',
        cost: '0',
        constraints: "Attacker's turn; first attack may be any card; further attacks only with a card whose rank matches some card already in the current bout. Maximum six attack cards per bout (or defender's hand size if smaller).",
        isTerminating: false,
        effectType: 'custom',
        id: 'attack',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Add another attack card whose rank matches any card already played in the current bout (attack or defence). Principal attacker has priority; other opponents may join with permission.',
        cost: '0',
        constraints: "Only after defender has beaten the previous attack card. Same rank as some card in the bout; total attack cards not more than six or defender's hand size.",
        isTerminating: false,
        effectType: 'custom',
        id: 'throw_in',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Decline to add more attack cards. In Perevodnoy variant, defender may instead transfer the attack to the next player by playing a card matching the attack rank.',
        cost: '0',
        constraints: 'Legal when it is your turn to attack or throw in and you choose not to play a card.',
        isTerminating: false,
        effectType: 'custom',
        id: 'pass_attack',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Beat an attack card by playing a higher card of the same suit or any trump from hand. Place the defending card on top of the attack card. No requirement to follow suit; trump may be used to beat non-trump.',
        cost: '0',
        constraints: 'Defender only. Card must be higher same suit or any trump (trump beats non-trump; higher trump beats lower trump).',
        isTerminating: false,
        effectType: 'custom',
        id: 'defend',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Pick up all attack cards and any cards already played to beat them into your hand. Attack succeeds; you do not get the next attack. Other attackers may give you additional legal attack cards face up, which you also take.',
        cost: '0',
        constraints: 'Defender only, when unable or unwilling to beat the current attack card.',
        isTerminating: false,
        effectType: 'custom',
        id: 'take_cards',
        effectHints: {},
      },
    ],
