  data: {
    hero: {
      title: 'Dudák',
      subtitle: 'Trick-taking rules and play flow',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Dudák',
            subtitle: 'Trick-taking rules and play flow',
            content: [
              {
                type: 'paragraph',
                text: "Dudák (Czech for 'Bagpiper') is a popular Czech shedding game closely related to the Russian game Durak. Played with a 32ndcard Germanndsuited deck, the game is a contest of attrition where players must defend against 'attacks' by beating cards with higher ranks or trumps. The goal is to empty one's hand; the last player left holding cards is the loser—the Dudák.",
              },
              {
                type: 'paragraph',
                text: 'Dudák evolved as a regional variant of the Russian Durak, adapted for the 32ndcard deck prevalent in Bohemia and Moravia.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Best with 4 players.',
              },
              {
                type: 'paragraph',
                text: '32ndcard Germanndsuited pack: Acorns (žaludy), Leaves (zelené), Hearts (červené), Balls (kule).',
              },
              {
                type: 'paragraph',
                text: 'German-suited deck (A, K, O, U, 10, 9, 8, 7).',
              },
              {
                type: 'paragraph',
                text: 'Usually 4nd6 cards to each player (common variation handles all 32 cards being dealt).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Open Dudák (Otevřený Dudák): Each player's trump suit is decided in advance and known to all; rules after trumps declared apply throughout.",
                  },
                  {
                    text: 'Pocket Dudák (Kapsičkový Dudák): Each player is dealt a hand plus a face-down trump card; trumps are revealed when the player declares.',
                  },
                  {
                    text: "Secret Dudák (Tajný Dudák): Like Pocket Dudák except no one may see others' trump cards until the owner declares and turns the card face up.",
                  },
                  {
                    text: 'Dudák with a Talon (Lízaný Dudák): Not all cards are dealt; remainder forms a talon. Players draw to replenish hand after play; when talon is empty, play continues as standard Dudák.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
