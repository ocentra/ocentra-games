        rules: {
          objective: 'Be the first to shed all cards. Avoid being the last player left with cards.',
          gameplay: '1. Attacking: One player leads a card (the attack).\n2. Defending: The defender must play a higher card of the same suit or a trump.\n3. Beating cards: If a defender beats all attacking cards, the cards are discarded (Vejbit).\n4. Failure: If a defender cannot beat a card, they must pick up common pile.',
          keyRules: [
            'Hearts are often the permanent trump suit.',
            'Attacking cards must match the rank of any card currently on the table to continue an attack.',
            "In 'Secret Dudák,' trumps are revealed midndhand by the first player who chooses to do so.",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Save your trumps for late in the game to avoid picking up a large pile of cards when the deck is empty.',
          intermediate: 'Teamwork: If you are the attacker, lead ranks that your partner (another attacker) can follow up with, to overwhelm the defender.',
          advanced: 'Card Counting: Essential in a 32ndcard deck. Know which Queens (Overs) and Kings have been discarded to gauge when your 10s or 9s become safe beats.',
          tips: [
            "Avoid 'dirtying' your hand by picking up too many suit cards early.",
            'In Secret Dudák, revealing your trump suit too early gives opponents an advantage in planning their attacks.',
          ],
          hasPlaceholders: false,
        },
