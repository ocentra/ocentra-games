    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Swoop',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Swoop is a multi-deck shedding game (3-5 decks) similar to Crazy Eights or Palace, played by 3-8 players. It features 'Mystery Cards' (face-down) and 'Swoop Cards' (Tens/Jokers) that clear the pile. The goal is to get rid of all cards in your hand, then your face-up pile, then your mystery pile.",
              },
              {
                type: 'paragraph',
                text: 'Likely a home-rule adaptation of Palace/Shithead or a rebranded commercial game.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Three to eight players. Three or four use two decks (108 cards), five or six use three decks (162 cards), seven or eight use four decks (216 cards). Direction of play is clockwise.',
              },
              {
                type: 'paragraph',
                text: 'Multiple standard decks.',
              },
              {
                type: 'paragraph',
                text: 'Standard cards; table.',
              },
              {
                type: 'paragraph',
                text: '19 cards per player. Each player places 4 cards face down (mystery), then 4 face up on top of those, and keeps the remaining 11 in hand. Undealt cards are set aside. First player may be chosen by drawing high card from the leftover pile; in subsequent deals the turn to start passes clockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Alternate Scoring: Ace-9: 5 points each; J/Q/K: 10 each; 10s and Jokers: 20 each.',
                  },
                  {
                    text: '20 cards each: 12 in hand, 4 mystery, 4 face up.',
                  },
                  {
                    text: 'Only Jokers are Swoop cards: 10s are ordinary cards ranking between 9 and Jack, worth 10 points.',
                  },
                  {
                    text: 'Swoop with more than 4 cards: Swoop can be made with at least four equal cards on top, not necessarily exactly four.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
