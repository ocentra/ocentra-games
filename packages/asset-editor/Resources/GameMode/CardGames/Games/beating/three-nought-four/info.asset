        tabLabel: 'About',
        pages: [
          {
            title: 'Three Nought Four',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: '304 is a trick-taking partnership game for four. 32-card deck. Card values: J=30, 9=20, A=11, 10=10, K=3, Q=2, 8=7=0. Total 304 points. Bid from 160 in tens; highest bidder sets trump face-down then remaining cards dealt. Follow suit; bidding team must make bid in points. Popular in Sri Lanka and India.',
              },
              {
                type: 'paragraph',
                text: 'Sri Lanka and coastal India (Karnataka, Tamil Nadu, Maharashtra). Named after 304 total points.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in two fixed partnerships; partners sit opposite (e.g. North-South vs East-West). Deal and play are counter-clockwise.',
              },
              {
                type: 'paragraph',
                text: 'A standard 32-card pack: 7, 8, 9, 10, J, Q, K, A in all four suits (spades, clubs, diamonds, hearts). Total point value in the pack is 304.',
              },
              {
                type: 'paragraph',
                text: '32-card deck, score sheet',
              },
              {
                type: 'paragraph',
                text: 'Four cards at a time counter-clockwise; after bid, rest dealt; trump face-down.',
              },
            ],
          },
        ],
      },
