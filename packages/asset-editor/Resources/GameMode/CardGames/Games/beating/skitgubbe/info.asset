    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Skitgubbe',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Skitgubbe (Swedish: 'Shit Old Man', also known simply as 'Skit' or 'Mattis') is a traditional Swedish card game for 3 players. It is divided into two distinct phases: Phase 1 (Trick-Taking/Collection) where players try to gather good cards, and Phase 2 (Shedding/Battle) where the goal is to get rid of all cards. The loser is the last player holding cards and is declared the 'Skitgubbe'.",
              },
              {
                type: 'paragraph',
                text: "Dates back to the 19th century in rural Sweden. Related to Finnish 'Paskahousu' (Shit Pants).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to four players; best for three.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack without joker.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack without joker.',
              },
              {
                type: 'paragraph',
                text: 'Deal three cards to each player clockwise, starting with forehand. Place the remainder face down as the stock (talon).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'All play to each trick (phase 1): In phase 1 all players play to each trick; highest rank wins; ties resolved by replay. Can use sluffing. Often played 2–6 players.',
                  },
                  {
                    text: 'Mas with turned up trump: Trump turned up after deal; phase 1 beat by higher led suit or trump. Player with three trumps may store them and draw three new; two of trumps may exchange for turnup.',
                  },
                ],
              },
            ],
          },
        ],
      },
