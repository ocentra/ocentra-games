        pages: [
          {
            title: 'Panjpar',
            subtitle: 'Five Cards â€” Afghan Beating Game',
            content: [
              {
                type: 'paragraph',
                text: "Panjpar (Five Cards) is a two-player Afghan beating game related to Durak. Players attack with 1, 3, or 5 cards; the defender beats or picks up. Draw to five from stock. First to empty hand wins. Featured in Khaled Hosseini's The Kite Runner.",
              },
              {
                type: 'paragraph',
                text: "Popular Afghan two-player card game. 'Panjpar' means five cards. Closely related to Russian Prostoy Durak but uses a full 52-card pack.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players. A standard 52-card pack is used; each player receives five cards. The next card is turned face up for trump and the remainder form the stock. Before the deal, one player guesses the trump colour; the correct guesser attacks first.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Rank A (high) to 2 (low).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck.',
              },
              {
                type: 'paragraph',
                text: 'Five cards to each player. Next card turned face up = trump. Remainder stacked face down on trump card (trump visible) = stock. Before deal, one player guesses trump colour; correct guesser attacks first.',
              },
            ],
          },
          {
