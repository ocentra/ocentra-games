  data: {
    hero: {
      title: 'LAUGAVATNSMANNI',
      subtitle: "Iceland's Strategic Contract Game",
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Laugavatnsmanni',
            subtitle: "Iceland's Strategic Contract Game",
            content: [
              {
                type: 'paragraph',
                text: "Laugavatnsmanni is a popular Icelandic trick-taking game for three players, part of the 'Manni' family of games (Manni means 'little man' or 'chap'). Played over 18 rounds, each player must declare one of six different contracts in each rotation, aiming for specific trick targets. The game is unique for its use of a 4-card 'Manni' (dummy) pile that players can use to improve their hands before the round begins.",
              },
              {
                type: 'paragraph',
                text: "Developed in the mid-20th century in the Laugavatn region of Iceland. It is a refinement of older Icelandic 'Vista' and 'Manni' games, standardized for school and social club competitive play.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 players individually (no partnerships).',
              },
              {
                type: 'paragraph',
                text: '48 cards (remove all four 2s from a standard 52-card deck). Ace is high in all contracts EXCEPT Nullo.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck and score sheet.',
              },
              {
                type: 'paragraph',
                text: "Each player is dealt 16 cards in packets of 4. The remaining 4 cards form the 'Manni' pile, placed face-down in the center.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'HornafjarÃ°armanni: Popular variant where the cut card determines the contract (10+ = no trumps, 6-9 = suit of cut card, 5- = nullo). Features larger Manni (16 cards) and different exchange rules.',
                  },
                  {
                    text: 'TrjÃ¡mann: Variant using full 52-card deck with 16 cards dealt to each player and only 4 in the Manni.',
                  },
                  {
                    text: 'Basic Manni: Simpler version with rotating trump suit and only positive scoring (no negative points).',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Laugavatnsmanni is a popular Icelandic trick-taking game for three players, part of the 'Manni' family of games (Manni means 'little man' or 'chap'). Played over 18 rounds, each player must declare one of six different contracts in each rotation, aiming for specific trick targets. The game is unique for its use of a 4-card 'Manni' (dummy) pile that players can use to improve their hands before the round begins.",
    tags: [
