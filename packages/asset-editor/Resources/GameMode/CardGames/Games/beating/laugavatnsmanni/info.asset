    ],
    comingSoon: false,
    minPlayers: 3,
    maxPlayers: 3,
    routePath: 'laugavatnsmanni',
    LLM: 'Game: Laugavatnsmanni. 3 players, 48-card deck (no 2s), 16 cards each, 4 in Manni. 18 rounds, 6 contracts each (Nullo, Grand, Spades, Hearts, Diamonds, Clubs). Nullo: Ace low, target 4 tricks. Grand/Suits: Ace high, target 8 tricks for declarer, 4 for defenders. Exchange with Manni before play. Score +/-1 per trick from target.',
    Player: "Welcome to Laugavatnsmanni, Iceland's favorite three-player card game! Over 18 rounds, you'll play each of six contracts once: Nullo (lose tricks), Grand (win tricks), and each suit as trumps. Before each round, you can exchange cards with the mysterious Manni pile. Choose your contracts wiselyâ€”save Nullo for a weak hand!",
    tagline: 'Eighteen rounds, six contracts, one winner.',
    gameCategory: 'Trick-taking',
    subcategory: 'Contracts',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '45-60 minutes',
