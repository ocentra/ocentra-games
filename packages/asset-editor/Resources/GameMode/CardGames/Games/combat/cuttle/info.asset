  data: {
    hero: {
      title: 'CUTTLE',
      subtitle: 'The Ancient Card Combat Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Cuttle',
            subtitle: 'The Ancient Card Combat Game',
            content: [
              {
                type: 'paragraph',
                text: "Cuttle is a 2-player card game where players use a standard 52-card deck as both resources and attacks. Each card can be played as a 'point card' (placed face-up contributing its rank to your score) or as an 'effect card' (using its special ability against the opponent). The goal is to accumulate 21 or more points in your tableau. Cuttle is one of the oldest card games still actively played in competitive circuits, with origins possibly dating to the 17th century.",
              },
              {
                type: 'paragraph',
                text: "Cuttle's exact origins are unclear but it is believed to be an extremely old English card game, possibly dating to the 17th century. It gained a modern following through the online platform cuttle.cards which created a standardised ruleset and competitive scene.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '52 standard cards. No jokers.',
              },
              {
                type: 'paragraph',
                text: "52-card deck. Play area for each player's tableau.",
              },
              {
                type: 'paragraph',
                text: '5 cards each. Remaining deck is the draw pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'cuttle.cards Standard: The ruleset standardised for competitive online play at cuttle.cards. Slight clarifications to card interactions.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Cuttle is a 2-player card game where players use a standard 52-card deck as both resources and attacks. Each card can be played as a 'point card' (placed face-up contributing its rank to your score) or as an 'effect card' (using its special ability against the opponent). The goal is to accumulate 21 or more points in your tableau. Cuttle is one of the oldest card games still actively played in competitive circuits, with origins possibly dating to the 17th century.",
    tags: [
      'card-game',
      'social',
      'strategy',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 2,
    routePath: 'cuttle',
    LLM: 'Game: Cuttle. 2-player. 52-card deck. Draw 1 card per turn, then play 1.  Win = 21+ pts in tableau. Cards: A=1pt, 2-10=face, J=11, Q=12, K=13. Special abilities: J steals opponent point card, Q protects, K lowers win target by 7, scuttle destroys equal/lower rank point card.',
    Player: 'Board: You have K(13pts)+Q(12pts)=25pts but need 21 to WIN â€” you have it! Wait â€” opponent has a Jack in hand (could steal your King). Play your Queen first to protect. With Queen on field, your King is safe from Jack. Then your 25 pts > target 21: you win.',
    tagline: 'Score 21. Scuttle their plans. Steal their kings.',
    gameCategory: 'Shedding',
    subcategory: '2-Player / Card Battle',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '15-30 minutes',
    origin: 'England (possibly 17th century)',
    originName: 'Cuttle',
    deck: '52 cards',
    alsoKnownAs: [],
    playersDisplay: '2',
    quality: 'complete',
    completeness: {
