    aiContent: {
      difficulty: {
        easy: 'Plays point cards freely. Scuttles randomly.',
        medium: 'Evaluates point totals. Uses Jacks to steal high-value cards. Protects with Queens.',
        hard: 'Full game-tree search. Optimal scuttle and steal decisions. King-lowering strategy based on current board state. Effect card prioritisation.',
      },
      considerations: [
        'Dual-use cards (play as points OR use as effects) creates large branching factor.',
        'Queen protection must be tracked for valid scuttle/Jack targets.',
        'King tracking â€” current winning threshold changes the entire game calculus.',
        'Glasses (8, Queen) create persistent board state modifiers.',
      ],
