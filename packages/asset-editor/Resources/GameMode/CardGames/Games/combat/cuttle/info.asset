    historyContent: {
      origins: "Cuttle's exact origins are unclear but it is believed to be an extremely old English card game, possibly dating to the 17th century. It gained a modern following through the online platform cuttle.cards which created a standardised ruleset and competitive scene.",
      originCountries: [
        'USA',
      ],
      timeline: [
        'Possibly 17th century: Origins in England.',
        '20th century: Documented in American card game books.',
        '2010s-present: Revival via online competitive play at cuttle.cards.',
      ],
      evolution: 'The modern standardised ruleset clarified card abilities and made the game competitive. A growing online community now runs tournaments.',
      cultural: 'One of the few ancient card games with a thriving modern competitive digital community.',
    },
    setupContent: {
