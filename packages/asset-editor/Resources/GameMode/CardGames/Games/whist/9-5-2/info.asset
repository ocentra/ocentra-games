        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Nine Five Two (9-5-2)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: '9-5-2: trick-taking game; name may refer to card ranks or deal (e.g. 9, 5, 2 cards). Trump and follow suit; point or trick count to win. Played in India and elsewhere.',
              },
              {
                type: 'paragraph',
                text: 'Related to Sergeant Major (RAF: 3p, 16 cards, targets 8-5-3). 9-5-2 and its close relative 3-2-5 (Teen Do Panch) are played in India, Pakistan and Nepal using a reduced pack with trick quotas.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 4\nPartnerships: Optional',
              },
              {
                type: 'paragraph',
                text: 'Type: Standard 52-card deck\nNumber of Decks: 1\nJokers: Not included',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck\nScore sheet (optional)\nTable space',
              },
              {
                type: 'paragraph',
                text: 'Cards per Player: Varies by player count\nDealing Pattern: Clockwise\n--',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Clockwise Deal and Play: Deal and play can proceed clockwise instead of counter-clockwise, with the player to dealer's left taking the higher trick quota, choosing trumps, and leading to the first trick while the player to dealer's right takes the lower quota.",
                  },
                  {
                    text: 'Sevens as Permanent Trumps: In some circles both Sevens are permanent trumps: the 7 of hearts is the highest trump, followed by the 7 of spades, then the remaining cards of the chosen trump suit in their usual order.',
                  },
                ],
              },
            ],
          },
        ],
      },
