                type: 'paragraph',
                text: '52 standard cards. Spades are permanent trump.',
              },
              {
                type: 'paragraph',
                text: '52-card deck. Score sheet.',
              },
              {
                type: 'paragraph',
                text: '13 cards each. Entire deck dealt.',
              },
            ],
          },
