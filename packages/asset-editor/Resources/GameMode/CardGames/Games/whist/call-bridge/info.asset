        rules: {
          objective: 'Score the most points over agreed rounds (usually 5) by winning at least your bid each hand.',
          gameplay: '1. Deal 13 cards each. 2. Each player bids number of tricks they will win (min 1). 3. Player left of dealer leads. 4. Follow suit; must trump if void and holding spades. 5. Spades are permanent trump. 6. Highest card of led suit or trump wins trick. 7. Win at least your bid: +bid; fail: -bid; over-tricks +0.1 each.',
          keyRules: [
            'Spades are ALWAYS trump â€” no other suit can be called.',
            'You MUST trump if you cannot follow suit and hold spades.',
            'Over-tricks count as 0.1 points each (minor bonus).',
            'Under-bidding (failing to make your bid) results in a penalty of -bid.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Bid conservatively based on your spades (trump) â€” each spade is likely to win a trick. Bid 1 for a weak hand.',
          intermediate: 'Count your high cards carefully: Ace, King, Queen of any suit + all spades. Bid your confident tricks only.',
          advanced: "Position Awareness: In later bidding positions, you know (partially) what others have bid. If three players bid 8 tricks total, the remaining distribution gives you endgame information. Trump Forcing: Lead low spades to exhaust opponents' trump supply.",
          tips: [
            'Never bid 0 â€” minimum bid is 1.',
            "Over-tricks only earn 0.1 pts each â€” don't chase them at the cost of failing your bid.",
          ],
          hasPlaceholders: false,
        },
