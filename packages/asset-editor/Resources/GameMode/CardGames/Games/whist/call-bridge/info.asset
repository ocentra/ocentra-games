        pages: [
          {
            title: 'Call Bridge',
            subtitle: "Call Break Â· Nepal's Card Game",
            content: [
              {
                type: 'paragraph',
                text: 'Call Bridge (also known as Call Break in South Asia) is a 4-player trick-taking card game enormously popular in Nepal, India, and Bangladesh. It resembles Spades but with individual bidding â€” each player bids the number of tricks they will win, and Spades are permanent trump. Unlike exact-bid games, players must win AT LEAST their bid (over-tricks are allowed but under-tricks are penalised). It is one of the most widely played card games in Nepal.',
              },
              {
                type: 'paragraph',
                text: 'Call Bridge/Call Break is deeply embedded in Nepali card culture and is widely played throughout South Asia. It likely developed from Whist-family games introduced during the British colonial period, merged with local bidding traditions.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4. Individual play (no fixed partnerships).',
              },
