    historyContent: {
      origins: 'Rooted in the Slavic tradition of trick-taking games like preference and thousand (1000). It became a standardized parlor game in Poland during the 20th century.',
      originCountries: [
        'Poland',
      ],
      timeline: [
        'Mid-20th Century: Mizerka emerges as a preferred 3-player alternative to Bridge in Poland.',
        '1980s: Standardized rules for the 18-round cycle are established.',
        '2000s: Online implementations popularize the game among the Polish diaspora.',
        "Present: A staple of 'Skata' (card game clubs) across Poland.",
      ],
      evolution: 'The requirement to play every contract exactly three times (once per player rotation) makes it a game of long-term endurance and point-averaging.',
      cultural: "Known for its 'Mizerka' (Misery) rounds which are often the most tense and competitive parts of the game.",
    },
