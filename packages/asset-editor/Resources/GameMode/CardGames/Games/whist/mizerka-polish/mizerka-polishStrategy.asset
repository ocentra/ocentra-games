    tips: [
      {
        title: 'Tip',
        description: 'If you have a hand full of middle-cards (7s, 8s, 9s), save them for a trump contract where you have at least 4 trumps to protect them.',
      },
      {
        title: 'Tip',
        description: "Never pick 'No Trump' if you have a wide suit distribution with many losers; save it for a 'solid' hand with multiple Aces.",
