  data: {
    LLM: 'Game: 3-2-5. Logic: See rules.objective and rules.gameplay.',
    Player: "3-2-5 (Teen Do Panch, also 2-3-5 or 5-3-2) is a trick-taking card game played in India, Pakistan, and Nepal. Three players use a 30-card deck. Each has a trick quota: dealer 2, player to dealer's right 5, player to dealer's left 3. The 5-trick player chooses trump and leads. Players above quota can 'pull' cards from those below in the next deal.",
    objective: 'Win at least your quota of tricks. Dealer 2, right of dealer 5, left of dealer 3. Player with 5-trick quota chooses trump and leads. Those above quota can pull one card per excess trick from those below quota before the next deal.',
    gameplay: 'Follow suit when possible; otherwise play any card. Highest trump wins the trick, else highest card of led suit. Trick winner leads next. After the deal, players above quota may take one card from players below quota (card pulling).',
    keyRules: [
      '30-card pack; three players',
      'Quotas: dealer 2, right 5, left 3',
      '5-trick player chooses trump and leads',
      'Follow suit; highest trump or led suit wins',
      'Above quota can pull cards from below quota for next deal',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: "Exactly 3. Dealer has quota 2 tricks; player to dealer's right 5 tricks (chooses trump, leads); player to dealer's left 3 tricks.",
      deck: '30-card pack: remove 2s through 6s from 52, plus remove two 7s (usually keep 7♥ and 7♠). Rank A-K-Q-J-10-9-8-7 high to low.',
      equipment: '30-card deck.',
      dealing: 'Three batches: 5 cards, then 3, then 2 to each player (10 each). Deal and play usually counter-clockwise.',
    },
    turnFlow: 'Follow suit when possible; otherwise play any card. Highest trump wins the trick, else highest card of led suit. Trick winner leads next. After the deal, players above quota may take one card from players below quota (card pulling).',
