    hero: {
      title: 'SPADES (STANDARD)',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Spades (Standard)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Spades is a trick-taking card game devised in the United States in the 1930s. It is played by four players in partnerships, using a standard 52-card deck. Spades are always the trump suit. The object is to score points by winning at least the number of tricks bid in each hand. Bids are made before play begins. 'Bags' (overtricks) and 'Nil' bids add strategic depth.",
              },
              {
                type: 'paragraph',
                text: 'Developed in Cincinnati, Ohio, or Indiana in the late 1930s. Became popular among college students.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French deck. Spades may also be played with one or two Jokers or with predetermined cards removed; with six or more players a second deck is often used.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French deck. Spades may also be played with one or two Jokers or with predetermined cards removed; with six or more players a second deck is often used.',
              },
              {
                type: 'paragraph',
                text: 'Deal 13 cards each.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Blind Nil: Nil bid declared before looking at cards; may exchange two cards with partner after bids. Scores ±200. Often allowed only when team is 100+ points behind.',
                  },
                  {
                    text: '10-for-200: Bid of 10 tricks: score 200 if exactly 10 (or at least 10) tricks taken; lose 200 otherwise. Also called wheels.',
                  },
                  {
                    text: 'Partnership Bidding: Partners discuss and agree a single team bid instead of bidding in turn. Minimum bid often 4. No Nil in some house rules.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
