    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'LÃ³rum (Hungarian)',
            subtitle: 'The Hungarian Compendium',
            content: [
              {
                type: 'paragraph',
                text: "LÃ³rum is a classic Hungarian compendium game played with a 32-card German-suited pack. It consists of a series of diverse 'contracts' or mini-games, traditionally eight in total. Each player takes a turn as the 'declarer' who chooses the round. It is a game of variety, where players must switch from trick-avoidance (negative) to shedding (positive) strategies within a single session. It is deeply rooted in Central European cafe culture.",
              },
              {
                type: 'paragraph',
                text: "Developed from the 19th-century 'Quodlibet' and 'King' families of games, tailored for the 32-card Hungarian Tell deck.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players individually.',
              },
              {
                type: 'paragraph',
                text: '32 cards (Hearts, Bells, Leaves, Acorns). Ace is high.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck and counters.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 8 cards. The dealer rotation ensures everyone gets to lead each contract type once.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Lora (Balkan): The related South Slavic version.',
                  },
                  {
                    text: 'King: The French parent game.',
                  },
                  {
                    text: 'Quodlibet: The academic version with 16+ contracts.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "LÃ³rum is a classic Hungarian compendium game played with a 32-card German-suited pack. It consists of a series of diverse 'contracts' or mini-games, traditionally eight in total. Each player takes a turn as the 'declarer' who chooses the round. It is a game of variety, where players must switch from trick-avoidance (negative) to shedding (positive) strategies within a single session. It is deeply rooted in Central European cafe culture.",
