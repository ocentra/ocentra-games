    historyContent: {
      origins: "Developed from the 19th-century 'Quodlibet' and 'King' families of games, tailored for the 32-card Hungarian Tell deck.",
      originCountries: [
        'Hungary',
      ],
      timeline: [
        '1880s: Compendium games using Tell cards become popular in Budapest.',
        "1920s: The 'LÃ³rum' name and specific 8-round sequence are standardized.",
        'Present: A beloved social game often played in Hungarian families and university clubs.',
        '2004: Digitized for online card game archives.',
      ],
      evolution: "The game's 'Suta' (Train) round became so popular that it is sometimes played as a standalone game, but in LÃ³rum, it remains just one part of the journey.",
