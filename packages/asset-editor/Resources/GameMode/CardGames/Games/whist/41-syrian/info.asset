    hero: {
      title: '41 Syrian',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: '41 Syrian',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: '41 Syrian also known as 400 or Arba3meyeh. Four-player partnership trick-taking. 52 cards, Hearts permanent trump. 13 cards each, counter-clockwise. Bid tricks minimum 1; total bids at least 11 or redeal. Bids 1-6 score face value, 7+ double. Fail is negative. Win when one partner reaches 41 and the other positive.',
              },
              {
                type: 'paragraph',
                text: 'This trick-taking game is often known as 400 (arba3meyeh). It is much played in Syria and to some extent in Lebanon; the name 400 does not arise in the scoring. The rules were documented from multiple contributors in the early 2000s.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in two fixed partnerships; partners sit as in Bridge (North-South versus East-West).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack, ranking A-K-Q-J-10 down to 2; Hearts is the permanent trump suit.',
              },
              {
                type: 'paragraph',
                text: 'Deck, score sheet',
              },
              {
                type: 'paragraph',
                text: '13 cards each, dealt anticlockwise in batches of 1-2-2-2-2-2-2; dealer rotates anticlockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Lebanese 400 scoring variation: Lebanese 400 follows the same core structure as 41 but uses a different minimum bid, higher mandatory minimum bids at certain score bands, and a non-linear trick-bid to points table.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
