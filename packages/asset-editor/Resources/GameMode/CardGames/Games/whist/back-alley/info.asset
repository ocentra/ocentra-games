      'team',
      'social',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'back-alley',
    LLM: 'Game: Back Alley. Type: Partnership trick-taking. Rules: 54 cards (2 Bloopers high). Schedule: 13-1-13. Turn-up trump. Scoring: +5 per bid/made, +1 per overtrick, -5 per bid if failed.',
    Player: "Welcome to the Back Alley. We're starting with 13 cards each. The trump card is flipping now... it's a Heart. Partner, how many can we take? Careful—miss the bid and the points come right off our total.",
    tagline: '25 hands. 2 Bloopers. One objective: Make the bid or take the hit.',
    gameCategory: 'Trick-taking',
    subcategory: 'Evolving-Hand Bidding',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '45-60 minutes',
    origin: 'Military (USA)',
    originName: 'Back Alley Bridge',
    deck: '54 cards (52 standard + 2 Jokers)',
    alsoKnownAs: [
      'Back Alley Bridge',
      'Back Street Bridge',
