    historyContent: {
      origins: 'Back Alley, also called Back Alley Bridge or Back Street Bridge, originated in the American military, probably during World War II. It grew out of servicemen’s barracks games and spread through off-base social circles as a high-intensity partnership trick-taking game.',
      originCountries: [
        'United States',
      ],
      timeline: [
        '1940s: Early versions played in the US Army and Navy.',
        "1960s: Deployment of 'Bloopers' (Jokers) becomes standard during the Vietnam War era.",
        '1980s: Standardized rules appear in military recreation handbooks.',
        'Present: Popular in veteran communities and regional US trick-taking circles.',
      ],
      evolution: "The game was originally played without Jokers (using 2s as high trumps), but the modern 'Blooper' version is now the definitive standard.",
      cultural: "Known for vocal 'trash talking' and intense partnership coordination, reflecting its military social upbringing.",
    },
    setupContent: {
      players: '4 players in North-South and East-West partnerships.',
      deck: '54 cards including Big Joker and Little Joker.',
      equipment: 'Standard deck, 2 distinct Jokers, score sheet.',
      dealing: 'Deal starts at 13 cards each. Subsequent hands decrease by 1 until the 1-card hand, then increase back to 13, for a full 26-deal 13‑1‑13 schedule.',
    },
    variationsContent: {
      list: [
        {
          id: 'army-straight',
          name: 'Army Straight',
          description: 'Played without Jokers; the 2 of the trump suit is the highest card in the game.',
        },
        {
          id: 'back-alley-bridge',
          name: 'Back Alley Bridge',
          description: 'Bidding is done by teams simultaneously using signals rather than in rotation.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: "Bids based only on high cards (A/K). Doesn't understand the power of the Bloopers in short hands.",
        medium: "Calculates trump length and adjusts bids. Knows to 'throw off' points in losing tricks (though points don't matter per card, only the trick count).",
        hard: "Simulates the probability of the 'turn-up' card based on cards in hand. Expertly manages 'throw-away' cards to secure the exact combined partnership bid.",
      },
      considerations: [
        "AI must handle the 'Board' (Blind-13) bidding logic.",
        'Requires a dynamic bidding engine that scales confidence with hand size (1 to 13).',
      ],
    },
