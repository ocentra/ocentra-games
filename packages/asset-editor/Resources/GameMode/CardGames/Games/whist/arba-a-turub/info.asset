    historyContent: {
      origins: "A unique Somali evolution of European Whist, likely developed during periods of colonial influence and adapted to local social settings. Its name 'Arba'a Turub' signifies the four decks required to play.",
      originCountries: [
        'Somalia',
      ],
      timeline: [
        '20th Century: Developed as a competitive adult game in Somali urban centers like Mogadishu.',
        '1990s: Documented by historians like Alexey Lobashev through Somali diaspora accounts.',
        'Present: Remains a culturally significant game in East Africa and the Somali diaspora.',
      ],
      evolution: 'The game expanded hands from the standard 13 to 36 cards to create a much longer, more endurance-based strategic game.',
      cultural: 'Typically played by adults in social clubs. It is known for its physical signalling (knocks and clicks) and intense partnership collaboration.',
    },
    setupContent: {
      players: '4 players in two fixed partnerships (North-South vs East-West).',
      deck: '144 cards. Prepared by taking four 52-card decks and removing all 2s, 3s, 4s, and 5s. Ranks: A(high), K, Q, J, 10, 9, 8, 7, 6(low).',
      equipment: 'Four identical decks, table space large enough for 144 cards.',
      dealing: "Deal starts clockwise. Each player receives 36 cards in batches of 3. **Crucial**: After the first 3 cards are dealt to the player on the dealer's left (Eldest Hand), they must declare trumps immediately.",
    },
    variationsContent: {
