      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: "Forgets that identical cards are tie-broken by play order. Fails to track the '4-card count' for each rank.",
        medium: "Uses basic knocks/clicks to coordinate. Attempts the 'Progressive Win' by playing conservatively in the first hand.",
        hard: 'Expertly tracks all 144 cards. Calculates the probability of finding specific cards in the remaining 33 cards of the deal based on the first 3 cards shown.',
      },
      considerations: [
        'AI must factor in the identical card logic for every single trick.',
        "The '36-card hand' requires significant memory management for the AI's card-tracking module.",
      ],
    },
