    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Le Neuf',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Le Neuf ('Nines') is a French-Canadian trick-taking game from Quebec/Acadian communities. 3 players (4-player variant exists). 52-card deck, 13 each + 13-card 'Chômeur' spare hand. Start at 9 points, subtract to 0. Quota = 4 tricks: each trick above -1pt, below +1pt. Rotating trump cycle: Hearts-Diamonds-Clubs-Spades-No Trump. Can swap hand with Chômeur.",
              },
              {
                type: 'paragraph',
                text: 'Le Neuf is a trick-taking game from Eastern Canada, played mainly in French-speaking Quebec (as Le Neuf or Chômeur) and by Acadians in Nova Scotia, and in Newfoundland and Eastern Ontario under the name Nines. It belongs to the quota-whist family; the name refers to each player starting with 9 points.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 (4 with partnerships)',
              },
              {
                type: 'paragraph',
                text: '52 cards. A high. 13 each + 13-card Chômeur.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: '13 each + 13-card spare hand (Chômeur).',
              },
            ],
          },
        ],
      },
