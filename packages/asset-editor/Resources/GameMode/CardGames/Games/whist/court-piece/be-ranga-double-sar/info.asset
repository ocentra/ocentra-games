    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Be-Ranga Double Sar',
            subtitle: 'Be-Ranga',
            content: [
              {
                type: 'paragraph',
                text: "Be-Ranga Double Sar (often called just 'Double Sir' or 'Coat Piece') is the premier partnership trick-taking game of South Asia (India and Pakistan). Unlike Western whist, tricks are not collected immediately after winning. Instead, they pile up in the center (the 'Heap') and can only be captured by a player who wins TWO consecutive tricks (a 'Double Sar'). This unique mechanic creates immense tension, as a heap of 10 or 12 cards can be stolen by a single well-timed King.",
              },
              {
                type: 'paragraph',
                text: "Derived from the game 'Court Piece' (or Kot Pees), which likely evolved from Whist introduced by the British but adapted with local 'accumulation' mechanics found in games like Iranian 'Ganjifa'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. A-K-Q-J-10...2.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack.',
              },
              {
                type: 'paragraph',
                text: "Deal 5 cards to each player. The 'Trump Caller' (usually right of dealer) looks at their 5 cards and calls the Trump Suit (Rung). Then the remaining cards are dealt (8 more to each) for a total of 13 each.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Single Sar (Court Piece): Standard game where every trick is collected immediately. No accumulation.',
                  },
                  {
                    text: 'Hidden Rung (Chup): The trump is not announced. The Caller places a trump card face down. It is revealed only when a player cannot follow suit.',
                  },
                ],
              },
            ],
          },
        ],
      },
