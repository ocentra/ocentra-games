  data: {
    hero: {
      title: 'AMERIKANER',
      subtitle: 'The Norwegian Mystery',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Amerikaner',
            subtitle: 'The Norwegian Mystery',
            content: [
              {
                type: 'paragraph',
                text: "Amerikaner is a highly popular Norwegian trick-taking game that combines elements of bidding, secret partnerships, and a kitty exchange. Despite its name, the game is uniquely Scandinavian and features a distinct 'trump-on-the-lead' mechanic where the bidder's first card determines the trump suit and their partner simultaneously.",
              },
              {
                type: 'paragraph',
                text: "Originating in Norway, the game's name 'Amerikaner' is a mystery to historians, as it bears little resemblance to standard American card games. It belongs to the broader 'Boston' family of bidding games that were fashionable in Northern Europe in the late 19th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly 4 players (standard).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace is high.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: "Each player is dealt 12 cards, one at a time. The remaining 4 cards are placed face down in the center to form the 'Kitty'.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'No-Kitty Variant: All 52 cards are dealt (13 each). The minimum bid is increased to 7.',
                  },
                  {
                    text: 'Joker Variant: Jokers are added. A led Joker wins the trick automatically. If discarded when void, it has no power.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Amerikaner is a highly popular Norwegian trick-taking game that combines elements of bidding, secret partnerships, and a kitty exchange. Despite its name, the game is uniquely Scandinavian and features a distinct 'trump-on-the-lead' mechanic where the bidder's first card determines the trump suit and their partner simultaneously.",
    tags: [
      'card-game',
      'trick-taking',
      'social',
      'bidding',
    ],
    comingSoon: false,
    minPlayers: 3,
    maxPlayers: 5,
    routePath: 'amerikaner',
    LLM: 'Game: Amerikaner. Type: Secret Partnership Trick-taking. Players: 4. Rules: 12 cards each, 4 card kitty. Bid 6-12. Amerikaner = 12 solo. Lead sets trump and names partner card. Goal: Reach 100 points.',
    Player: "Welcome to Amerikaner. You have 12 cards. There's a 4-card kitty in the middle. Bid how many tricks you think you can take with a partner. If you win the bid, your first lead will set the trumps and name your secret partner. Be careful with those 52-point Amerikaner bids!",
    tagline: 'Bid your tricks, call your partner, and keep the secret until the first trick.',
    gameCategory: 'Trick-taking',
    subcategory: 'Secret Partnership (Boston)',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-40 minutes',
    origin: 'Norway',
    originName: 'Amerikaner (Norwegian)',
    deck: 'Standard 52-card deck',
    alsoKnownAs: [
      'Norwegian Amerikaner',
      'Scandinavian American',
      'Call-Partner Boston',
    ],
    playersDisplay: '4 (Primary), 3-5 (Variants)',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
      variations: true,
      ai: true,
      sources: true,
    },
    historyContent: {
      origins: "Originating in Norway, the game's name 'Amerikaner' is a mystery to historians, as it bears little resemblance to standard American card games. It belongs to the broader 'Boston' family of bidding games that were fashionable in Northern Europe in the late 19th century.",
      originCountries: [
        'Norway',
      ],
      timeline: [
        'Early 20th C.: Emerges as a staple social game in Norway.',
        '1950s-70s: Becomes a popular variant in Scandinavian student clubs.',
        'Present: Widely played in Norway, often in casual social settings.',
      ],
      evolution: "The game evolved to include a 'Kitty' (Talon) phase, which allows the bidder to significantly strengthen their hand before play.",
      cultural: "In Norway, 'Amerikaner' refers specifically to this game, whereas in other countries it might be confused with 'American' versions of Whist or Bridge.",
    },
    setupContent: {
      players: 'Exactly 4 players (standard).',
      deck: 'Standard 52-card deck. Ace is high.',
      equipment: 'Standard deck, score sheet.',
      dealing: "Each player is dealt 12 cards, one at a time. The remaining 4 cards are placed face down in the center to form the 'Kitty'.",
    },
    variationsContent: {
      list: [
        {
          id: 'no-kitty',
          name: 'No-Kitty Variant',
          description: 'All 52 cards are dealt (13 each). The minimum bid is increased to 7.',
        },
        {
          id: 'joker-amerikaner',
          name: 'Joker Variant',
          description: 'Jokers are added. A led Joker wins the trick automatically. If discarded when void, it has no power.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: "Bids 6 randomly. Fails to discard effectively from the kitty. Doesn't recognize who their partner is until revealed.",
        medium: 'Bids based on suit length. Calls the Ace of their longest suit to find a partner.',
        hard: "Calculates the probability of cards in the kitty based on the bidding patterns. Strategically discards to create a 'Long Trump' scenario. As an opponent, counts tricks to ensure the bidder falls one short.",
      },
      considerations: [
        "AI must factor in the 'Secret Partner' mechanicâ€”they may be playing against their own partner for the first trick.",
        "The 'Kitty' exchange is a major optimization point for the AI.",
      ],
    },
