    tips: [
      {
        title: 'Tip',
        description: "Don't bid 12 unless you have a near-perfect hand. If you lose even one trick, you lose 12 points while your opponents gain from their captured tricks.",
      },
      {
        title: 'Tip',
        description: 'Remember: the bidder MUST lead the trump suit first.',
