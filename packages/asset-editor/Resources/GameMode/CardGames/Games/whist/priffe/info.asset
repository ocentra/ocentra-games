        rules: {
          objective: 'As a partnership, win the contracted number of tricks or avoid tricks in the Noll misere contract.',
          gameplay: 'Players sit in fixed partnerships, bid or choose contracts, then play tricks with follow-suit obligations. Trump or suit games reward trick capture while Noll reverses the goal toward taking as few tricks as possible.',
          keyRules: [
            'Four players form two fixed partnerships.',
            'Bidding selects the trump or suit game contract.',
            'The Noll contract is a misere deal where the goal is to avoid tricks.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Focus first on the visible objective in Priffe: conserve cards or resources that directly advance the win condition.',
