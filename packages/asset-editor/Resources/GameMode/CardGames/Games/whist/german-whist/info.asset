        rules: {
          objective: 'Win the majority of the 13 tricks in stage two after stock is exhausted.',
          gameplay: 'Non-dealer leads first trick. For each trick, second player follows suit if possible in standard form. Higher card of led suit wins unless a trump is played to a non-trump lead. In stage one, trick winner takes the exposed stock card and trick loser takes next hidden stock card; winner then leads next trick. After 13 tricks, stock is empty and stage two begins with no replenishment. Play 13 final tricks; these determine winner in standard scoring.',
          keyRules: [
            'Trump suit is fixed by the initial face-up stock card and does not change.',
            'Stage one tricks are for hand improvement, not usually for scoring the hand outcome.',
            'Stage two is a normal closed-hand trick contest with 13 tricks.',
            'Variant tables may count all 26 tricks or relax follow-suit in stage one.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'In stage one, avoid spending strong winners to collect weak exposed stock cards.',
          intermediate: 'Time trump expenditure to secure high-value exposed cards and deny them to opponent.',
          advanced: 'Plan stage-two shape during stage one by controlling suit length and preserving tactical entries.',
          tips: [
            'Evaluate each stage-one trick by card gain, not immediate trick count.',
            'Track revealed stock quality and infer opponent hand upgrades from contested tricks.',
          ],
          hasPlaceholders: false,
