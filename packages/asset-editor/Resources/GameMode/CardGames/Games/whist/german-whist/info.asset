  data: {
    hero: {
      title: 'GERMAN WHIST',
      subtitle: 'Two-Player Whist',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'German Whist',
            subtitle: 'Two-Player Whist',
            content: [
              {
                type: 'paragraph',
                text: 'German Whist is a two-player trick-taking game with a stock phase and an end phase. Early tricks are used to draft better cards from stock; only the second 13 tricks determine the standard hand winner.',
              },
              {
                type: 'paragraph',
                text: "German Whist is a two-player trick-taking game of British origin despite its name. It appears to have originated in England and was popular among diplomats in Vienna in the late 19th century. Rules were first published in London in Home Notes (1894) and in R.F. Foster's Encyclopedia of Games in America (1897).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly two players; standard 52-card pack, ace high. Deal alternates after each hand.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack, ace high.',
              },
              {
                type: 'paragraph',
                text: 'No additional equipment required.',
              },
              {
                type: 'paragraph',
                text: 'Deal 13 cards each one by one. Place remaining 26-card stock face down and turn top stock card face up; its suit is trump for the hand.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'No Follow-Suit in Stage One: Common variant allows any response card in stage one, while stage two uses strict follow-suit.',
                  },
                  {
                    text: 'Count All 26 Tricks: Winner is player taking majority of all tricks across both stages, not only stage two.',
                  },
                  {
                    text: 'Honeymoon Whist: Related designed variant with extra modifications and jokers.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
