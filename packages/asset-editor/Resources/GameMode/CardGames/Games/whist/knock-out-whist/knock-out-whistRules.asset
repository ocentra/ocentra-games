  data: {
    LLM: "Player to dealer's left leads. Must follow suit if able; otherwise any card. Highest trump wins the trick, else highest card of the led suit. Trick winner leads next. A player who takes no tricks is knocked out (first such player gets one dog's life hand of one card). Seven hands per game with 7, 6, 5, 4, 3, 2, 1 cards dealt respectively.",
    Player: "Player to dealer's left leads. Must follow suit if able; otherwise any card. Highest trump wins the trick, else highest card of the led suit. Trick winner leads next. A player who takes no tricks is knocked out (first such player gets one dog's life hand of one card). Seven hands per game with 7, 6, 5, 4, 3, 2, 1 cards dealt respectively.",
    objective: 'Be the last player remaining by avoiding taking zero tricks in any hand; players who take no tricks are knocked out. Win the final one-trick hand or be the sole survivor.',
    gameplay: "Player to dealer's left leads. Must follow suit if able; otherwise any card. Highest trump wins the trick, else highest card of the led suit. Trick winner leads next. A player who takes no tricks is knocked out (first such player gets one dog's life hand of one card). Seven hands per game with 7, 6, 5, 4, 3, 2, 1 cards dealt respectively.",
    keyRules: [
      'Must follow suit if able.',
      'Highest trump in trick wins; otherwise highest card of led suit.',
      'Trick winner leads to the next trick.',
      "Zero tricks in a hand knocks you out; first time only you get a dog's life (one card next hand).",
      'Winner of most tricks chooses trumps for next hand; tie resolved by cutting.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
