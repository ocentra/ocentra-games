  data: {
    LLM: 'Game: Bid Whist. Type: Auction Trick-taking. Rules: 54 cards (incl. 2 Jokers). Bid = books over 6 (e.g. 4 = 10 tricks). Direction determines ranking (Uptown A-high, Downtown A-low).',
    Player: "You have the Big Joker and two Aces. The current bid is '3 Uptown'. With your hand and the potential Kitty, can you take 10 tricks? Raise the stakes to '4 Uptown' and call your partner's best suit!",
    objective: 'First partnership to reach a set score (typically 7 or 21) by fulfilling trick-taking contracts.',
    gameplay: "1. **Auction**: Players bid a number of 'books' (tricks over 6) from 3 to 7, plus a direction (Uptown, Downtown, or No Trump). 2. **Kitty**: High bidder takes the 6-card Kitty into their hand and discards 6 cards. 3. **Trump**: High bidder names the trump suit. 4. **Tricks**: 12 tricks are played. Must follow suit. 5. **Direction**: Uptown (A high), Downtown (A low), No Trump (No trump suit). 6. **Jokers**: Big Joker is the highest card in the game, followed by Little Joker.",
    keyRules: [
      "A bid of '4 Uptown' means the team must win 10 tricks (6+4) with high cards ranking best.",
      'In Downtown, Aces are low and 2s are high.',
      "Failing a contract (getting 'set') results in losing points equal to the bid.",
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '4 players in two fixed partnerships.',
      deck: '54 cards: Standard 52-card pack plus two distinct Jokers (Big Joker and Little Joker).',
      equipment: 'Standard pack with jokers, score pad.',
      dealing: "Deal 12 cards to each player. 6 cards are dealt face down to the center to form the 'Kitty'.",
    },
    turnFlow: "1. **Auction**: Players bid a number of 'books' (tricks over 6) from 3 to 7, plus a direction (Uptown, Downtown, or No Trump). 2. **Kitty**: High bidder takes the 6-card Kitty into their hand and discards 6 cards. 3. **Trump**: High bidder names the trump suit. 4. **Tricks**: 12 tricks are played. Must follow suit. 5. **Direction**: Uptown (A high), Downtown (A low), No Trump (No trump suit). 6. **Jokers**: Big Joker is the highest card in the game, followed by Little Joker.",
    moveValidityConditions: {
      ante: 'Bid Whist is a point-based partnership game and does not utilize a monetary or chip-based ante.',
      deal: 'The distribution of twelve cards per player and the six-card kitty is handled automatically by the system dealer.',
      reveal_market: 'There is no public market in Bid Whist; the kitty is only revealed to the winning bidder.',
      buy_market: 'Players cannot purchase cards from any external area; they must succeed using their dealt hand and the kitty.',
      buy_stock: 'There is no stock pile to draw from during play; the entire deck is distributed at the start of the round.',
      fold: 'All players are committed to participating in every trick of the hand to determine the final point tally.',
      check: 'The game uses a trick-taking and bidding structure rather than a vying structure with checks.',
      call: 'There is no bet to match in this game; competition is based on bidding trick counts and winning tricks.',
      bet: 'Success is measured by total points accumulated on a scorecard rather than through financial betting.',
      raise: 'The value of the deal is fixed by the bid and cannot be raised through further wagering rounds.',
      declare: 'Only available to the highest bidder.',
      reveal_hand: 'Hands stay private until individual cards are played into tricks; no full-hand reveal phase occurs.',
      award_pot: 'Winning points are added to a cumulative partnership total rather than distributed from a physical pot.',
      play_card: 'Must follow suit; highest card of led suit or highest trump wins.',
      draw: 'All cards are distributed at the start; no drawing phase exists during the play of the twelve tricks.',
      discard: 'Only available to the winning bidder after taking the kitty.',
      pass: 'Allowed during bidding when choosing not to increase the contract.',
      bid: 'Must be higher than the current high bid.',
      meld: 'Bid Whist is strictly a trick-taking game and does not involve the formation of sequences or melds.',
      go_out: 'The hand terminates automatically once all twelve tricks have been played by all participants.',
    },
    exampleHands: [
      'Opening deal: 4-4 player(s), 12 card(s) per player, 1 deck(s), initial visibility face_down.',
      'Opening flow: start in dealing; system may use deal_12_kitty_6 before auction.',
      'Scoring check: Points are awarded for making the bid (bid amount) or subtracted for getting set. Expected outcome: 7.',
