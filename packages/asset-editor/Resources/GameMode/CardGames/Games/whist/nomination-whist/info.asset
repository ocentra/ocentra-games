    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Nomination Whist',
            subtitle: 'Oh Hell!',
            content: [
              {
                type: 'paragraph',
                text: "Nomination Whist (commonly known as Oh Hell!) is an exact-bidding trick-taking game where players must predict exactly how many tricks they will win. The game features a unique dealing pattern that goes 'up and down the river'â€”starting with 1 card each, increasing to the maximum, then decreasing back to 1. The scoring rewards exact bids with a 10-point bonus plus tricks taken.",
              },
              {
                type: 'paragraph',
                text: 'Nomination Whist is known worldwide under many names including Oh Hell!, Oh Pshaw, Blackout, Up and Down the River, The Ten, and Grip. The game emerged in the early 20th century and spread internationally. The exact origin is unclear, but it became popular in Britain, America, and elsewhere.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-7 players, each playing for themselves.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, score pad.',
              },
              {
                type: 'paragraph',
                text: "'Up and down the river': Deal 1 card each (round 1), then 2, 3, etc. up to maximum (typically 7-10 depending on players), then back down to 1. Total rounds = 2 Ã— max - 1.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Blackout: American variant name; same rules.',
                  },
                  {
                    text: 'No Trump Rounds: Some play designated rounds with no trump suit.',
                  },
                  {
                    text: 'Zero for Miss: Some variants score 0 points for missing bid (instead of 1 per trick).',
                  },
                ],
              },
            ],
          },
        ],
      },
