        pages: [
          {
            title: 'Kleurenwiezen',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Kleurenwiezen (Belgian Colour Whist) is the national card game of Belgium. It is a highly competitive trick-taking game where players bid to decide the contract (objective) for the round. Contracts range from winning most tricks with a partner to winning all tricks solo ('Abondance') or even winning zero tricks ('MisÃ¨re'). It is characterized by its complex bidding hierarchy and the social use of specific 'whist' signals.",
              },
              {
                type: 'paragraph',
                text: "Derived from 18th-century Whist and influenced by English Solo Whist. It became a distinct Belgian variant in the late 19th century, with the addition of more complex bidding labels like 'Troel' and 'Miserie'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players playing individually until partnerships are formed during bidding.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are high, 2s are low.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are high, 2s are low.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 13 cards (dealt 4-4-5 or 3-3-3-4).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Wiezen: The traditional Brussels variant.',
                  },
                  {
                    text: 'Goudwiezen: High-stakes version with doubled points.',
                  },
                  {
                    text: 'Pandoeren: A Dutch-influenced variant.',
                  },
                ],
              },
            ],
          },
