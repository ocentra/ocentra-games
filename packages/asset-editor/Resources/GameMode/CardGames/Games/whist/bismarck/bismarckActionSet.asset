        constraints: 'Forehand only; must not have used this contract yet in the 12-deal game; chosen after seeing the 4 face-up cards.',
        isTerminating: false,
        effectType: 'declare',
        id: 'choose_pass',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Forehand declares Spader: spades are trumps, aim is to win tricks. Quota 8 for forehand, 4 each for others.',
        cost: '0',
        constraints: 'Forehand only; must not have used this contract yet in the 12-deal game; chosen after seeing the 4 face-up cards.',
        isTerminating: false,
        effectType: 'declare',
        id: 'choose_spader',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Forehand declares Valfri (Trumf): forehand chooses any suit as trumps, aim is to win tricks. Quota 8 for forehand, 4 each for others.',
        cost: '0',
        constraints: 'Forehand only; must not have used this contract yet; must also announce chosen trump suit; chosen after seeing the 4 face-up cards.',
        isTerminating: false,
        effectType: 'declare',
        id: 'choose_valfri',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Forehand picks up the four face-up table cards, adding them to their 16 dealt cards for a total of 20 cards.',
        cost: '0',
        constraints: 'Forehand only; after contract is announced; must be done before discarding 4.',
        isTerminating: false,
        effectType: 'draw',
        id: 'pickup_table_cards',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Forehand discards any four cards from their 20-card hand face down, keeping 16 for play.',
        cost: '0',
        constraints: 'Forehand only; after picking up the 4 table cards; must discard exactly 4 cards face down.',
        isTerminating: false,
        effectType: 'discard',
        id: 'discard_4',
        effectHints: {},
      },
