    customActions: [
      {
        supported: true,
        description: 'Dealer places the top four cards of the deck face up on the table for forehand to see before choosing contract.',
        cost: '0',
        constraints: 'Dealer only; performed at start of deal phase before dealing to players.',
        isTerminating: false,
        effectType: 'deal',
        id: 'deal_4_faceup',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Dealer deals the remainder of the pack face down to the three players, one card at a time, so everyone has 16 cards.',
        cost: '0',
        constraints: 'Dealer only; after the 4 face-up cards are on the table; 48 cards dealt 16 each.',
        isTerminating: false,
        effectType: 'deal',
        id: 'deal_16_each',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Forehand declares Sang (Spel): no trumps, aim is to win as many tricks as possible. Quota 8 for forehand, 4 each for others.',
        cost: '0',
        constraints: 'Forehand only; must not have used this contract yet in the 12-deal game; chosen after seeing the 4 face-up cards.',
        isTerminating: false,
        effectType: 'declare',
        id: 'choose_sang',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Forehand declares Pass: no trumps, aim is to win as few tricks as possible. Quota 4 for forehand, 6 each for others.',
