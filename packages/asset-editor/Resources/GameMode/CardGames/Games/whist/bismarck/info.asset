  data: {
    hero: {
      title: 'BISMARCK',
      subtitle: 'The Swedish Quota Whist',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bismarck',
            subtitle: 'The Swedish Quota Whist',
            content: [
              {
                type: 'paragraph',
                text: "Bismarck is a Swedish three-player trick-taking game where players score based on the number of tricks they win compared to a 'quota.' Over 12 deals, each player must play each of four different contracts exactly once as forehand: Sang (no trumps, win tricks), Pass (no trumps, avoid tricks), Spader (spades trump), and Valfri (choose your trump suit). Similar to the Polish game Mizerka.",
              },
              {
                type: 'paragraph',
                text: 'The first known description of Bismarck appeared in 1944 in Sweden. According to Sten Helmfrid (Kartofilen, July 2024), the game was likely named after the famous German battleship Bismarck, which was sunk in 1941 â€” making this a WW2-era card game.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly 3 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck, no Jokers. Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2.',
              },
              {
                type: 'paragraph',
                text: '52-card deck. Score sheet with grid (rows: players, columns: contracts).',
              },
              {
                type: 'paragraph',
                text: "Dealer shuffles; player to dealer's right cuts. Dealer deals the top 4 cards face-up on the table, then deals the remaining 48 cards face-down to the three players (16 each). Forehand (left of dealer) picks up the 4 face-up cards (total 20 cards) and discards any 4 face-down.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'British Bismarck: The British version with minor rule differences in contract choice and scoring, as the game spread from Sweden to the UK.',
                  },
                  {
                    text: 'Four-Player Finnish Bismarck: A 4-player adaptation of the game, adjusting hand sizes and quotas for an additional player.',
                  },
                  {
                    text: 'Bismarck in Portugal: Portuguese adaptation with local rule variations.',
                  },
                  {
                    text: 'Bismarck in Estonia: Estonian version with regional variations in contracts and scoring.',
                  },
                  {
                    text: 'Mizerka (Related â€” Poland): A similar Polish three-player quota trick-taking game that may share common ancestry with Bismarck.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bismarck is a Swedish three-player trick-taking game where players score based on the number of tricks they win compared to a 'quota.' Over 12 deals, each player must play each of four different contracts exactly once as forehand: Sang (no trumps, win tricks), Pass (no trumps, avoid tricks), Spader (spades trump), and Valfri (choose your trump suit). Similar to the Polish game Mizerka.",
