  data: {
    hero: {
      title: 'BOSTON',
      subtitle: 'The Enlightenment Duel',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Boston',
            subtitle: 'The Enlightenment Duel',
            content: [
              {
                type: 'paragraph',
                text: "Boston is an 18th-century French trick-taking game that represents a pivotal transition from Whist to modern Bridge. Played by four individuals with a standard 52-card deck, it introduced a sophisticated bidding system where players compete for contracts ranging from winning a few tricks to 'Misère' (winning none) or 'Grand Slam' (winning all). It is famous for its complex scoring tables and the use of two decks to track game state, embodying the intellectual rigor of Enlightenment-era social card play.",
              },
              {
                type: 'paragraph',
                text: 'Despite its name, Boston likely originated in France during the American Revolutionary War (circa 1770s), named in honor of the siege of Boston. It was a favorite of French naval officers and rapidly spread to the United States and across Europe.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players playing individually (cut-throat style).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack. Two packs are often used: one for play and one for determining trump rotation.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, extensive scoring counters (fiches), and a specific Boston score table.',
              },
              {
                type: 'paragraph',
                text: 'Deal 13 cards to each player (usually in batches of 4-4-5).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Boston de Fontainebleau: A more elaborate 19th-century French version with even more contract levels and complex scoring.',
                  },
                  {
                    text: 'Russian Boston: Favored by the Russian nobility; uses a simplified auction but higher stakes for Misère.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Boston is an 18th-century French trick-taking game that represents a pivotal transition from Whist to modern Bridge. Played by four individuals with a standard 52-card deck, it introduced a sophisticated bidding system where players compete for contracts ranging from winning a few tricks to 'Misère' (winning none) or 'Grand Slam' (winning all). It is famous for its complex scoring tables and the use of two decks to track game state, embodying the intellectual rigor of Enlightenment-era social card play.",
