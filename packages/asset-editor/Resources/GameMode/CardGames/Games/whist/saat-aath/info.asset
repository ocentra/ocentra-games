    historyContent: {
      origins: 'Saat-Aath is a two-player adaptation of the South Asian three-player quota game 3-2-5.',
      originCountries: [
        'India',
      ],
      timeline: [
        'Traditional play: Develops in India as a compact head-to-head quota game.',
        'Modern documentation: Published in English on international card-game references.',
        'Present: Taught through online rule pages and Hindi-language video explainers.',
      ],
      evolution: 'Compared with 3-2-5, Saat-Aath changes to two players and uses a tableau-plus-hand structure that creates 15 tricks from a short initial hand.',
      cultural: "The game uses the term 'hands' for tricks in Indian play culture and remains recognizable as a local skill game with bluff and memory elements.",
    },
    setupContent: {
      players: 'Exactly 2 players; dealer alternates by deal.',
      deck: 'Start from 52 cards and remove all 2-6 plus 7 of clubs and 7 of diamonds. Trumps rank: 7 of hearts (highest), 7 of spades, then A K Q J 10 9 8 of trump suit. Non-trump suits rank A K Q J 10 9 8.',
      equipment: '30-card pack and optional score sheet for match play.',
      dealing: 'Dealer gives 5 hand cards to each player. Non-dealer calls trump. Dealer then deals 5 face-down table cards in a row to each player and places 1 face-up card on each stack, giving each player 15 playable cards over time.',
    },
    variationsContent: {
      list: [
        {
          id: 'no-special-sevens',
          name: 'No Special Sevens',
          description: '7 of hearts and 7 of spades lose permanent trump privilege and become normal low cards of their printed suits.',
        },
        {
          id: 'winner-draws-next-deal',
          name: 'Winner Draw Advantage',
          description: 'As in some 3-2-5 circles, previous winner draws cards from loser before next deal according to margin over quota.',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Follows suit correctly and uses obvious trumps, but misses long-term quota planning.',
        medium: 'Tracks visible table cards and adjusts aggression by role quota.',
        hard: 'Performs hidden-card inference from reveal timing, models trump exhaustion, and optimizes leads for quota EV.',
      },
      considerations: [
        'AI must treat 7 of hearts and 7 of spades as trumps under base rules.',
        'Role-specific win thresholds require asymmetric policy for dealer vs non-dealer.',
        'Decision quality depends on jointly evaluating hand cards and currently face-up table cards.',
      ],
    },
