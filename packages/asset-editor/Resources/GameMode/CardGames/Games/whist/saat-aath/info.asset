  data: {
    hero: {
      title: 'Saat-Aath',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Saat-Aath',
            subtitle: 'Indian 7-8 Quota Duel',
            content: [
              {
                type: 'paragraph',
                text: 'Saat-Aath is a two-player Indian trick-taking game in the 3-2-5 family. A 30-card pack is used, the non-dealer calls trumps, and players contest 15 tricks with quotas of 7 for the dealer and 8 for the non-dealer.',
              },
              {
                type: 'paragraph',
                text: 'Saat-Aath is a two-player adaptation of the South Asian three-player quota game 3-2-5.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Exactly 2 players; dealer alternates by deal.',
              },
              {
                type: 'paragraph',
                text: 'Start from 52 cards and remove all 2-6 plus 7 of clubs and 7 of diamonds. Trumps rank: 7 of hearts (highest), 7 of spades, then A K Q J 10 9 8 of trump suit. Non-trump suits rank A K Q J 10 9 8.',
              },
              {
                type: 'paragraph',
                text: '30-card pack and optional score sheet for match play.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives 5 hand cards to each player. Non-dealer calls trump. Dealer then deals 5 face-down table cards in a row to each player and places 1 face-up card on each stack, giving each player 15 playable cards over time.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'No Special Sevens: 7 of hearts and 7 of spades lose permanent trump privilege and become normal low cards of their printed suits.',
                  },
                  {
                    text: 'Winner Draw Advantage: As in some 3-2-5 circles, previous winner draws cards from loser before next deal according to margin over quota.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
