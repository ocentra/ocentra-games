    customActions: [
      {
        supported: true,
        description: 'Dealer shuffles, offers cut to non-dealer, and deals five cards face down to each player.',
        cost: '0',
        constraints: 'Only dealer acts; performed once at start of deal.',
        isTerminating: false,
        effectType: 'play',
        id: 'deal_initial_hand',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Non-dealer (caller) chooses and announces the trump suit after seeing the initial five cards.',
        cost: '0',
        constraints: 'Only non-dealer acts; must name one suit; performed once after initial deal.',
        isTerminating: false,
        effectType: 'play',
        id: 'choose_trump',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Dealer deals a row of five cards face down in front of each player.',
        cost: '0',
        constraints: 'Only dealer acts; after trump is called.',
        isTerminating: false,
        effectType: 'play',
        id: 'deal_face_down_rows',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Dealer places one card face up on top of each of the five face-down table cards for each player.',
        cost: '0',
        constraints: 'Only dealer acts; each player ends with five stacks of one face-down and one face-up card.',
        isTerminating: false,
        effectType: 'play',
        id: 'reveal_table_tops',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play one card from hand or from a face-up table card to start the trick; non-dealer leads first trick, then trick winner leads.',
        cost: '0',
        constraints: 'Any available card; when a face-up table card is played, the face-down card under it may be turned up after the trick.',
        isTerminating: false,
        effectType: 'play',
        id: 'lead_card',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Second player must follow suit if possible (from hand or face-up table cards); if void, may play any card including trump to cut.',
        cost: '0',
        constraints: 'Must follow suit if able; 7H and 7S count as trumps for follow-suit; otherwise may discard or trump.',
        isTerminating: false,
        effectType: 'play',
        id: 'follow_or_cut',
        effectHints: {},
      },
      {
        supported: true,
        description: 'When a face-up table card is played, the face-down card underneath is turned face up and becomes available for future tricks.',
        cost: '0',
        constraints: 'Occurs when a player plays from a table stack that had a face-down card; may be done after both have played to the trick.',
        isTerminating: false,
        effectType: 'play',
        id: 'reveal_under_card',
        effectHints: {},
      },
      {
        supported: true,
        description: 'After 15 tricks, compare trick totals: dealer wins with more than 7, non-dealer with more than 8; exactly 7-8 is a tie.',
        cost: '0',
        constraints: 'System evaluates after last trick; no player action.',
        isTerminating: false,
        effectType: 'play',
        id: 'compare_quotas',
        effectHints: {},
      },
    ],
