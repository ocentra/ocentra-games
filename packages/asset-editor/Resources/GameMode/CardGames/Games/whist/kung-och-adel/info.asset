        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kung och Adel',
            subtitle: 'Swedish Social Hierarchy Game',
            content: [
              {
                type: 'paragraph',
                text: "Kung och Adel (Swedish for 'King and Nobility') is a social card game of the 'President' or 'Asshole' family, flavored with historical Swedish social estates. Players compete to shed their cards and climb the social ladder from Bonden (The Peasant) to Kunegen (The King). The top-ranked players receive bonuses in the form of the best cards from the lower-ranked players in subsequent rounds.",
              },
              {
                type: 'paragraph',
                text: "Derived from the ancient 'Warlords' or 'Dai Hin Min' families of games, it was adapted in the late 19th/early 20th century to reflect the Swedish Estate system (StÃ¥ndsriksdagen).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Best with 4 to 6 players.',
              },
              {
                type: 'paragraph',
                text: "Standard 52-card deck. 2s are usually 'clearing' cards or wildcards.",
              },
              {
                type: 'paragraph',
                text: "Standard 52-card deck. 2s are usually 'clearing' cards or wildcards.",
              },
              {
                type: 'paragraph',
                text: 'The whole deck is dealt out evenly among players.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'President / Asshole: The international version.',
                  },
                  {
                    text: 'Skitgubbe: A related Swedish game (sometimes the names are used interchangeably).',
                  },
                  {
                    text: 'Warlords: The complex strategy variant.',
                  },
                ],
              },
            ],
          },
