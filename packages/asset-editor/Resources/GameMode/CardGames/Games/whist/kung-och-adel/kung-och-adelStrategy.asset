    tips: [
      {
        title: 'Tip',
        description: 'Always know who is next to finish. If the person to your left is the Burgher, they are your biggest threat to promotion.',
      },
      {
        title: 'Tip',
        description: "Keep a 2 (or a 10) for your very last card. It's the most reliable way to clear your hand and ensure you finish first.",
