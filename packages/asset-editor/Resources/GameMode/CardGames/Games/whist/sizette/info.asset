        prompts: {
          human: 'Whist is the classic English partnership trick-taking game and ancestor of Bridge. 4 players, 2 teams. 52 cards, 13 each. Last card dealt (to dealer) turned face-up = trump. Eldest hand leads. Follow suit. Each trick over 6 = 1 point. Honours (A-K-Q-J of trump): 3 held = 2pts, 4 held = 4pts. Game to 5 (British) or 7 (American). Rubber = best of 3.',
          ai: 'Game: Whist. Logic: See rules.objective and rules.gameplay.',
        },
        scoring: {
          description: 'Odd tricks (over 6) = 1pt each. Honours bonus. Game: 5pts (British) or 7pts (American). Rubber: best of 3 games.',
          winCondition: 'Win majority of tricks. First to 5/7 points.',
          cardValues: {
            A: '11',
            T: '10',
            K: '4',
            Q: '3',
            J: '2',
          },
