    hero: {
      title: 'HORNAFJARÐARMANNI',
      subtitle: 'The Icelandic Regional Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Hornafjarðarmanni',
            subtitle: 'The Icelandic Regional Game',
            content: [
              {
                type: 'paragraph',
                text: "Hornafjarðarmanni is a regional Icelandic trick-taking game, a variant of the broader 'Manni' family. It is distinctively played in the Hornafjörður region of south-east Iceland. It is a three-player game using a full deck and features a unique 'Manni' (Man) - a set of face-down cards that players can exchange with their hands to optimize their play.",
              },
              {
                type: 'paragraph',
                text: "Derived from the Danish game 'Manni' or similar Scandinavian trick-taking games. It has been preserved as a localized tournament tradition in Hofn and Hornafjörður.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "Three players only. The player to dealer's left may exchange up to 7 cards with the Manni, then the player to dealer's right up to 5, then the dealer with the remainder; left of dealer leads to the first trick.",
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: A (high) to 2 (low).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: A (high) to 2 (low).',
              },
              {
                type: 'paragraph',
                text: "Dealer deals 16 cards to each player (in batches of 4) and 4 cards face-down in the center to form the 'Manni'.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Spilabók AB version: Þ. Guðmundsson's Spilabók AB describes six contracts: Nullo, Grand, Spades, Hearts, Clubs, Diamonds. Aces high in all. 18 deals; declarer chooses from remaining contracts each time.",
                  },
                  {
                    text: 'Other regional variants: Other local Manni variants may differ in deal size or contract rules; document from sources when available.',
                  },
                  {
                    text: 'Reserved: Reserved for future variant from sources.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Hornafjarðarmanni is a regional Icelandic trick-taking game, a variant of the broader 'Manni' family. It is distinctively played in the Hornafjörður region of south-east Iceland. It is a three-player game using a full deck and features a unique 'Manni' (Man) - a set of face-down cards that players can exchange with their hands to optimize their play.",
