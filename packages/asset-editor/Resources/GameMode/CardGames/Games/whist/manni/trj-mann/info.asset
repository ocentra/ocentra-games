    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Trjámann',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Trjámann is an Icelandic trick-taking game for 3 players using a 48-card deck (no 2s). Features 4 contract types (Nullo, Grand, Spades, Other) chosen in rotation. The contract chooser exchanges with a 4-card 'Manni' (widow). Each player must play all 4 contracts once over 12 rounds. First to 10+ points wins.",
              },
              {
                type: 'paragraph',
                text: "Trjámann is an Icelandic trick-taking game whose name means 'tree-man'. It is a variant of Manni, in which the spare hand of cards is called the Manni. The rules are based on translations from Spilabók AB by Þ. Guðmundsson (1989, Reykjavík) and information from Icelandic players. It uses a 52-card pack, four contracts (Nullo, Grand, Spades, Other), and twelve deals with each player acting as declarer for each contract once.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "Three players. The player to dealer's left is the declarer for each deal and chooses one of the four contracts (Nullo, Grand, Spades, Other). Each player must choose each contract once over the twelve deals.",
              },
              {
                type: 'paragraph',
                text: '48 cards (remove 2s). 16 each + 4 Manni.',
              },
              {
                type: 'paragraph',
                text: 'Cards, score sheet',
              },
              {
                type: 'paragraph',
                text: '16 cards each. 4 card Manni face down.',
              },
            ],
          },
        ],
      },
