  data: {
    LLM: 'Game: Hornafjarðarmanni (Icelandic Manni). 3-player trick-taking. Setup: 52-card deck, 16 cards per player, 4-card Manni. Bidding: Player left of dealer bids (Trump/No-Trump/Grand). Contract winner exchanges up to 7 cards with Manni. Play: 16 tricks, follow suit, highest trump/led suit wins. Scoring: 1 point per trick above 4. Target: 30-50 points.',
    Player: 'Welcome to Hornafjarðarmanni, the pride of south-east Iceland. Bid your contract carefully—trump suit, No-Trump, or Grand. Then exchange cards with the face-down Manni to optimize your hand. Play 16 tricks and score points for each trick won above four. Regional tournaments have preserved this game for generations.',
    objective: 'Score points by winning more than 4 tricks in a hand. Points are awarded for each trick over 4.',
    gameplay: "1. Lead: Player to dealer's left.\n2. Must follow suit. If unable, can play any card (including trump).\n3. Highest trump (or highest card of suit led) wins the trick.",
    keyRules: [
      'Follow the legal action constraints defined for Hornafjarðarmanni.',
      'Round outcome is resolved by the scoring method: - 5 tricks: 1 point.',
      'Winning condition: Score points by winning more than 4 tricks in a hand.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: "Three players only. The player to dealer's left may exchange up to 7 cards with the Manni, then the player to dealer's right up to 5, then the dealer with the remainder; left of dealer leads to the first trick.",
