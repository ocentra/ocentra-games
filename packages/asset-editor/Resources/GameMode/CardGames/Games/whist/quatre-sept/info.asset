  data: {
    hero: {
      title: 'Quatre Sept',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Quatre Sept',
            subtitle: 'La Politaine / La Poule',
            content: [
              {
                type: 'paragraph',
                text: 'Quatre Sept is a French-Canadian four-player partnership point-trick game with no trumps, descended from Italian Tressette. Players use a 32-card pack (10-9-A-K-Q-J-8-7). Holding all four sevens wins the game immediately; winning three consecutive tricks with 10-9-A of a suit (La Politaine) scores an 11-point bonus.',
              },
              {
                type: 'paragraph',
                text: 'Quatre Sept is played in the French-speaking provinces of Canada. It descends from the Italian game Tressette, which was fashionable throughout Europe in the 18th century. French players adapted Tressette to the 32-card pack (no 3 or 2), substituting 10 and 9 for those ranks. The game was exported to Canada with the ranking 10-9-A-K-Q-J-8-7.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships. Partners sit opposite each other.',
              },
              {
                type: 'paragraph',
                text: '32-card French pack: 10, 9, A, K, Q, J, 8, 7 in each suit. No trumps.',
              },
              {
                type: 'paragraph',
                text: '32-card deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: '1. Deal 8 cards each in batches of 3-2-3. 2. Deal and play clockwise. 3. If any player has all four sevens, that team wins the game immediately.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Capot: A team that wins all 8 tricks wins the whole game immediately.',
                  },
                  {
                    text: 'Four 8s: Player dealt all four 8s declares before the first lead; that team wins the game. Replaces or supplements four 7s rule.',
                  },
                  {
                    text: 'Target 32: Game ends at 32 points. If both reach 32 in the same deal, first to claim wins.',
                  },
                  {
                    text: 'Long Game: Play to 200 points for a longer session.',
                  },
                  {
                    text: 'Signals: Tap table = good cards in led suit; slide card = good in same-color suit. Used to signal partner.',
                  },
                  {
                    text: 'Redeal: Hand with no 10s, 9s, or Aces may demand a redeal before first lead.',
                  },
                  {
                    text: 'Pollack: German variant; declarations (Pollack 10-9-A, four of a kind, triplets) score before play; game to 21. No four-7s win.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
