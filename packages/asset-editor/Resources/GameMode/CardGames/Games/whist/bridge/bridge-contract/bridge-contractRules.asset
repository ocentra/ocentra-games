  data: {
    LLM: 'Game: Contract Bridge. Type: Auction Trick-taking. Rules: 4 players, fixed partnerships. 13 cards each. Auction determines trump and target. One hand revealed as Dummy.',
    Player: 'You hold a strong spade suit and 17 HCP. Your partner bids 2 Hearts. Do you support their Hearts, or raise the stakes with a 3 Spade overcall? Trust the convention!',
    objective: 'Fulfill the trick count specified in the contract or prevent opponents from fulfilling theirs to score points.',
    gameplay: "1. **Auction**: Players bid for the contract. 2. **Opening Lead**: Player to the left of the declarer plays the first card. 3. **Dummy**: Declarer's partner (the Dummy) lays their hand face-up on the table. 4. **Tricks**: 13 tricks are played. Must follow suit. Highest trump or highest led card wins.",
    keyRules: [
      "Only tricks bid and made score 'below the line' towards winning a game.",
      "Vulnerability: Teams that have won one game become 'Vulnerable', increasing both bonuses and penalties.",
      'Double/Redouble: Bids that increase the scoring stakes if the contract is made or broken.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '4 players. Partners sit opposite each other (North-South vs East-West).',
      deck: 'Standard 52-card French pack (No Jokers). Suit rankings for bidding: No Trump > Spades > Hearts > Diamonds > Clubs.',
      equipment: 'Standard pack, bidding boxes, score pad.',
      dealing: 'The entire deck is dealt out clockwise: 13 cards per player.',
