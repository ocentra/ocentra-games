    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Auction Bridge',
            subtitle: 'The Edwardian Classic',
            content: [
              {
                type: 'paragraph',
                text: 'Auction Bridge is the historic bridge variant that bridged the gap between Bridge Whist and modern Contract Bridge. Unlike modern Bridge, in Auction Bridge, all tricks won above six count toward the game score if the contract is fulfilled, making the bidding process less about strict precision and more about competition for the trump suit.',
              },
              {
                type: 'paragraph',
                text: 'Developed in the late 19th century as an improvement over Bridge Whist, where the dealer chose trumps. Auction introduced competitive bidding. It was reportedly formalized by members of the Bath Club in London and popularized in India.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two partnerships (North-South, East-West).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranks A(high)-2(low). Suit priorities: No Trumps, Spades, Hearts, Diamonds, Clubs.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, score sheet with a line drawn horizontally in the middle.',
              },
              {
                type: 'paragraph',
                text: 'The entire deck is dealt out, 13 cards per player.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Nullos: A variation where a player bids to lose tricks. Ranking usually falls between Spades and No Trump.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Auction Bridge is the historic bridge variant that bridged the gap between Bridge Whist and modern Contract Bridge. Unlike modern Bridge, in Auction Bridge, all tricks won above six count toward the game score if the contract is fulfilled, making the bidding process less about strict precision and more about competition for the trump suit.',
    tags: [
      'card-game',
      'trick-taking',
      'traditional',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'auction-bridge',
    LLM: 'Game: Auction Bridge. Type: Partnership bidding. Rules: 52 cards. Ranks: NT=10, S=9, H=8, D=7, C=6. All tricks over 6 count for game if contract made. Goal: Win two games (30 pts each) for the Rubber.',
    Player: 'Welcome to Auction Bridge. You have 13 cards. Unlike modern Bridge, every trick you win above six will count toward the game if you make your contract. The target is 30 points. Will you start with 1 Heart or try for a No Trump?',
    tagline: 'The game that defined a generation. Bidding made competitive, all tricks count.',
    gameCategory: 'Trick-taking',
    subcategory: 'Bridge Family',
    playerMode: 'multiplayer',
