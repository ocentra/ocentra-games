    historyContent: {
      origins: 'Developed in the late 19th century as an improvement over Bridge Whist, where the dealer chose trumps. Auction introduced competitive bidding. It was reportedly formalized by members of the Bath Club in London and popularized in India.',
      originCountries: [
        'England',
        'India',
      ],
      timeline: [
        '1904: First formal rules of Auction Bridge published.',
        '1910s: Becomes the most popular social card game in English-speaking countries.',
        '1925: Gradually superseded by Contract Bridge, which rewarded precise bidding more heavily.',
        'Present: Occasionally played by bridge historians and in traditional social circles.',
      ],
      evolution: "The most significant evolution was moving the scoring of overtricks 'below the line', a rule changed in Contract Bridge to penalize under-bidding.",
      cultural: "A staple of the Edwardian era, Auction Bridge was the definitive 'Game of the Elite' before the Great Depression.",
    },
    setupContent: {
      players: '4 players in two partnerships (North-South, East-West).',
