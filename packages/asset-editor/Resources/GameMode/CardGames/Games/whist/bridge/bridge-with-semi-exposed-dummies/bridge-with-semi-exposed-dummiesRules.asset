  data: {
    LLM: 'Game: Bridge with Semi-Exposed Dummies. Type: 2-Player Bridge. Rules: 13 cards in hand + 13 in stacked table dummy per player. Auction sets contract. Play involves hand and dummy cards. Uncovering hidden cards adds variance.',
    Player: "Your dummy has the Ace of Spades face-up, covering a hidden card. Should you play it now to win the lead, or keep it to trap the opponent's King later?",
    objective: 'Win enough tricks to fulfill the contract, using both your hand and your designated dummy hand.',
    gameplay: "1. **Auction**: Players bid for trumps as in standard Bridge. 2. **Play**: Each turn involves playing two cards—one from the player's hand and one from their dummy. 3. **Uncovering**: When a face-up dummy card is played, the face-down card beneath it is flipped over and becomes available for the next trick.",
    keyRules: [
      'Must follow suit from the specific source hand (Player Hand or Dummy Hand).',
      'The highest card among the four cards played wins the trick for the team.',
      'Standard Bridge bidding and scoring applies.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Exactly 2 players.',
      deck: 'Standard 52-card French pack (No Jokers).',
      equipment: 'Standard pack, score pad.',
      dealing: 'Each player receives 13 cards in hand. Two dummy hands of 13 cards each are dealt to the table in stacks: 6 face-down cards each covered by a face-up card, with one extra face-up card.',
    },
    turnFlow: "1. **Auction**: Players bid for trumps as in standard Bridge. 2. **Play**: Each turn involves playing two cards—one from the player's hand and one from their dummy. 3. **Uncovering**: When a face-up dummy card is played, the face-down card beneath it is flipped over and becomes available for the next trick.",
    moveValidityConditions: {
      ante: 'This game is a point-based Bridge variant and does not utilize a monetary or chip-based ante system.',
      deal: 'The complex distribution of hand cards and semi-exposed dummy cards is performed automatically by the system.',
      reveal_market: 'This is a closed-hand game where only the dummy top cards are public; no shared community market exists.',
      buy_market: 'Players cannot purchase or swap cards from any external area; they must succeed with their dealt cards.',
      buy_stock: 'The entire 52-card deck is distributed at the start; no cards remain in stock to be drawn during play.',
      fold: 'Both players are committed to playing out all 13 tricks to determine the final point winner of the deal.',
      check: 'The game uses a trick-taking and bidding structure rather than a vying structure where checking would apply.',
      call: 'There is no pot or bet to match in this game; competition is based strictly on contract point accumulation.',
      bet: 'Success is determined by trick wins and bidding precision rather than through financial or chip-based betting.',
      raise: 'Bids are escalated during the auction phase via bidding rather than through wagering rounds during play.',
      declare: 'Hand strength is established during the showdown comparison rather than through a formal declaration phase.',
      reveal_hand: 'Hands stay private until cards are played into tricks; dummy top cards are already public information.',
      award_pot: 'Winning points are added to a cumulative partnership total rather than awarded from a physical pot.',
      play_card: 'Must follow suit; highest card of led suit or highest trump wins.',
      draw: 'Each player receives their complete set of cards at the start; no drawing phase exists during play.',
      discard: 'Every card in the hand and dummy must be played into a trick; no cards are discarded or buried.',
      pass: 'Allowed during the bidding phase.',
      bid: 'Must exceed the current high bid in rank or level.',
      meld: 'This is strictly a trick-taking game based on card values rather than forming sequences or melds.',
      go_out: 'The hand terminates automatically once all thirteen tricks have been played by both participants.',
