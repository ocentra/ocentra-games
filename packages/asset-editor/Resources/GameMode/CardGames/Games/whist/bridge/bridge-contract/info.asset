    historyContent: {
      origins: 'Bridge evolved from 16th-century Whist via Auction Bridge. Contract Bridge was revolutionized by Harold S. Vanderbilt in 1925 who introduced the scoring system that rewards only tricks actually bid and made, adding a new layer of mathematical precision to the game.',
      originCountries: [
        'UK',
        'USA',
      ],
      timeline: [
        '1890s: Bridge Whist replaces standard Whist in London card clubs.',
        '1904: Auction Bridge emerges as the standard bidding variant.',
        '1925: Harold Vanderbilt formalizes Contract Bridge scoring on a steamship cruise.',
        '1930s: International matches popularize the game as a global intellectual sport.',
        'Present: Governed by the World Bridge Federation (WBF) with Olympic observed status.',
      ],
      evolution: "The decisive shift to Contract Bridge scoring made the auction as important as the card play, necessitating the development of elaborate bidding 'conventions' and partnership signals.",
      cultural: 'A symbol of peak mental skill, famously played by world leaders, scientists, and business icons. It is one of the few card games recognized as a competitive sport globally.',
    },
    setupContent: {
      players: '4 players. Partners sit opposite each other (North-South vs East-West).',
