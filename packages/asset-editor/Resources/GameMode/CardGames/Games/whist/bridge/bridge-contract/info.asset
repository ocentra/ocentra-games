  data: {
    hero: {
      title: 'Contract Bridge',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Contract Bridge',
            subtitle: 'The Ultimate Mind Sport',
            content: [
              {
                type: 'paragraph',
                text: "Contract Bridge is the world's premier trick-taking card game, demanding extreme levels of logic, partnership cooperation, and psychological depth. Played by four players in two fixed partnerships, it consists of a complex auction (bidding) phase to determine the trump suit and trick goal, followed by the play of the hand where one player's cards (the dummy) are revealed. It is a game of intellectual mastery with a standardized global competitive circuit.",
              },
              {
                type: 'paragraph',
                text: 'Bridge evolved from 16th-century Whist via Auction Bridge. Contract Bridge was revolutionized by Harold S. Vanderbilt in 1925 who introduced the scoring system that rewards only tricks actually bid and made, adding a new layer of mathematical precision to the game.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players. Partners sit opposite each other (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack (No Jokers). Suit rankings for bidding: No Trump > Spades > Hearts > Diamonds > Clubs.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, bidding boxes, score pad.',
              },
              {
                type: 'paragraph',
                text: 'The entire deck is dealt out clockwise: 13 cards per player.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Duplicate Bridge: The standard competitive format where the same hands are played at multiple tables to eliminate the luck of the deal.',
                  },
                  {
                    text: 'Rubber Bridge: The traditional home format where play continues until one side wins two games (the Rubber).',
                  },
                  {
                    text: 'Goulash deal: Friendly bridge dealing style where cards are intentionally not fully shuffled between deals, producing highly uneven distributions.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
