  data: {
    hero: {
      title: 'Minibridge',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Minibridge',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Minibridge is a simplified version of Contract Bridge, developed specifically to introduce beginners to the logic of trick-taking and card play without the daunting complexity of bridge bidding. It replaces the auction phase with a straightforward High Card Point (HCP) count. It is widely used by bridge federations globally (like the EBU and ABF) as an educational tool, focusing on the tactical interaction between declarer and the dummy.',
              },
              {
                type: 'paragraph',
                text: "Developed in France (as 'Mini-Bridge') in the 1980s by the French Bridge Federation to lower the entry barrier for students.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players (N+S vs E+W).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: 'Standard bridge deal (13 cards each). Players count their High Card Points (HCP): A=4, K=3, Q=2, J=1.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Simple (HCP announcement): Players in turn announce their High Card Point count. Partnership with higher total plays; declarer is the one with more points in that partnership. Declarer chooses part-score or game and trump or no trumps.',
                  },
                  {
                    text: "Written slip (European): Each player writes point count and suit lengths on a slip. In turn players say pass or I open. Opener sees partner's slip and chooses contract; opponent may overcall. Bidding continues until one passes.",
                  },
                  {
                    text: 'Part-score vs Game: Declarer announces whether contract is part-score (7+ tricks) or game (e.g. 10+ in majors, 9+ in no trumps). Part-score bonus 50; game bonus 300; undertricks 50 each.',
                  },
                ],
              },
            ],
          },
        ],
      },
