    historyContent: {
      origins: "Developed in France (as 'Mini-Bridge') in the 1980s by the French Bridge Federation to lower the entry barrier for students.",
      originCountries: [
        'France',
        'UK',
      ],
      timeline: [
        '1980s: First introduced in French schools.',
        '1990s: Adopted by the English Bridge Union (EBU) and expanded internationally.',
        '2010s: Becomes the standard first-step for bridge education in clubs worldwide.',
        'Present: Extensively played in online formats for bridge learners.',
      ],
      evolution: 'The game moved from a teaching aid to a recognized competitive format for junior players.',
      cultural: "Symbolizes the 'Democratization of Bridge', making it accessible to those who find traditional bidding too math-heavy.",
    },
