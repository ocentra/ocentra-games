    tips: [
      {
        title: 'Tip',
        description: "In No Trump hands, prioritize long suits to set up 'low' trick-winners after high cards are gone.",
      },
      {
        title: 'Tip',
        description: "Don't ignore the honors. In Auction, the honor bonus (e.g., 4 honors in one hand = 80-100 pts) is often larger than the trick score.",
