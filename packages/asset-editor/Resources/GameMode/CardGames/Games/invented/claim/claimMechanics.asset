    "phases": [
      {
        "id": "setup_round",
        "label": "Setup Round",
        "actor": "system",
        "legalActions": [
          "setup_round"
        ],
        "nextPhase": "turn_loop",
        "isMandatory": true,
        "loopIndex": null,
        "totalLoops": null,
        "conditionalNext": [],
        "cardVisibilityChanges": {
          "stock": "top_face_up",
          "discard": "top_face_up",
          "hand": "private",
          "declarations": "secret_until_showdown"
        },
        "notes": "Fresh 52-card deal, 3 cards to each active player, no opening discard."
      },
      {
        "id": "turn_loop",
        "label": "Turn Loop",
        "actor": "current_player",
        "legalActions": [
          "take_stock",
          "take_discard",
          "discard_card",
          "declare_suit",
          "end_turn",
          "timeout_turn",
          "call_showdown"
        ],
        "nextPhase": null,
        "isMandatory": true,
        "loopIndex": null,
        "totalLoops": null,
        "conditionalNext": [],
        "cardVisibilityChanges": {
          "stock": "top_face_up",
          "discard": "top_face_up"
        },
        "notes": "Player may take one card and discard one card in either order, privately declare, then end the turn."
      },
      {
        "id": "score_round",
        "label": "Score Round",
        "actor": "system",
        "legalActions": [
          "score_round"
        ],
        "nextPhase": null,
        "isMandatory": true,
        "loopIndex": null,
        "totalLoops": null,
        "conditionalNext": [
          {
            "condition": "game_end_reached",
            "nextPhase": null
          },
          {
            "condition": "start_next_round",
            "nextPhase": "setup_round"
          }
        ],
        "cardVisibilityChanges": {
          "hand": "revealed",
          "declarations": "public"
        },
        "notes": "Auto-reveal, score, settle bankrolls, eliminate bankrupt players, and advance if the game continues."
      }
    ],
    "actions": {
      "take_stock": {
        "supported": true,
        "description": "Take the public top card from the stock.",
        "constraints": "Current player only; at most one take per turn; stock must not be empty.",
        "effectType": "draw",
        "cost": "0",
        "effectHints": {
          "sourceZone": "stock",
          "visibility": "top_face_up"
        },
        "isTerminating": false
      },
      "take_discard": {
        "supported": true,
        "description": "Take the public top card from the discard pile.",
        "constraints": "Current player only; at most one take per turn; discard pile must not be empty.",
        "effectType": "draw",
        "cost": "0",
        "effectHints": {
          "sourceZone": "discard",
          "visibility": "top_face_up"
        },
        "isTerminating": false
      },
      "discard_card": {
        "supported": true,
        "description": "Discard one card from hand to the public discard pile.",
        "constraints": "Current player only; at most one discard per turn; player must keep at least 3 cards.",
        "effectType": "discard",
        "cost": "0",
        "effectHints": {
          "destinationZone": "discard",
          "minHandSize": 3
        },
        "isTerminating": false
      },
      "declare_suit": {
        "supported": true,
        "description": "Privately commit to a suit for this round.",
        "constraints": "Current player only; player must hold at least one card of the declared suit; declaration is locked.",
        "effectType": "declare",
        "cost": "0",
        "effectHints": {
          "declarationType": "secret_suit_contract",
          "public": false
        },
        "isTerminating": false
      },
      "end_turn": {
        "supported": true,
        "description": "Finish the current turn.",
        "constraints": "Adds highest-card debt if the player acted and still has not declared.",
        "effectType": "pass",
        "cost": "0",
        "effectHints": {
          "appliesPenaltyIfUndeclared": true,
          "timeoutSafeWhenNoAction": true
        },
        "isTerminating": true
      },
      "timeout_turn": {
        "supported": true,
        "description": "Resolve timer expiry.",
        "constraints": "No-action timeout has no penalty; timeout after action counts as ending undeclared.",
        "effectType": "timeout",
        "cost": "0",
        "effectHints": {
          "timerSeconds": 60
        },
        "isTerminating": true
      },
      "call_showdown": {
        "supported": true,
        "description": "Force auto-reveal and scoring once the caller qualifies.",
        "constraints": "Caller must be declared, hold at least 3 cards, and have final score >= 27.",
        "effectType": "call_showdown",
        "cost": "0",
        "effectHints": {
          "minimumFinalScore": 27,
          "requiresDeclaration": true
        },
        "isTerminating": true
      },
      "deal": {
        "supported": false,
        "description": "Round setup is performed by the system.",
        "constraints": "System-only setup_round action.",
        "effectType": "setup",
        "cost": "0",
        "effectHints": {},
        "isTerminating": false,
        "reason": "Deal is not a direct Claim player action."
      },
      "draw": {
        "supported": false,
        "description": "Use take_stock or take_discard.",
        "constraints": "Claim exposes exact source actions.",
        "effectType": "draw",
        "cost": "0",
        "effectHints": {},
        "isTerminating": false,
        "reason": "Generic draw is ambiguous for Claim."
      },
      "discard": {
        "supported": false,
        "description": "Use discard_card.",
        "constraints": "Claim tracks one discard action per turn.",
        "effectType": "discard",
        "cost": "0",
        "effectHints": {},
        "isTerminating": false,
        "reason": "Generic discard is replaced by discard_card."
      },
      "pass": {
        "supported": false,
        "description": "Use end_turn.",
        "constraints": "Claim distinguishes no-action timeout from a normal end turn.",
        "effectType": "pass",
        "cost": "0",
        "effectHints": {},
        "isTerminating": true,
        "reason": "Legacy pass is replaced by end_turn."
      },
      "declare": {
        "supported": false,
        "description": "Use declare_suit.",
        "constraints": "Claim declaration is secret and family-state owned.",
        "effectType": "declare",
        "cost": "0",
        "effectHints": {},
        "isTerminating": false,
        "reason": "Legacy declare is replaced by declare_suit."
      },
      "reveal_hand": {
        "supported": false,
        "description": "Showdown auto-reveals all hands.",
        "constraints": "No manual reveal in Claim v1.",
        "effectType": "reveal",
        "cost": "0",
        "effectHints": {},
        "isTerminating": false,
        "reason": "Claim v1 uses automatic showdown reveal."
      }
    },
    "customActions": [
