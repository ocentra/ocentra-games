    "edgeCaseRules": [
      {
        "id": "claim.edge.discard_then_take_same_card",
        "text": "Discard before taking is legal, so the same public top discard may be taken back during that turn."
      },
      {
        "id": "claim.edge.no_max_hand",
        "text": "There is no rules-level maximum hand size beyond physical card availability."
      },
      {
        "id": "claim.edge.all_negative",
        "text": "If every player has a negative final score, only raw scores apply and no winner-difference payout is created."
      },
      {
        "id": "claim.edge.tied_top",
        "text": "If multiple players tie for top positive score, they split one positive difference payout pool."
      }
    ],
    "useTrump": false,
    "playerCount": {
      "min": 4,
      "max": 4,
      "reason": "Claim is locked to four seats, one for each standard French suit."
    },
