    "rules": [
      {
        "id": "claim.players.four_only",
        "text": "Claim requires exactly four active seats, matching the four standard French suits."
      },
      {
        "id": "claim.players.bankrupt_observer",
        "text": "A player whose bankroll reaches zero or below becomes an observer for later rounds."
      },
      {
        "id": "claim.setup.standard_52",
        "text": "Each round uses one shuffled Standard_52 deck with StandardCardRanking."
      },
      {
        "id": "claim.setup.three_cards",
        "text": "Deal three cards to every active player at the start of the round."
      },
      {
        "id": "claim.setup.empty_discard",
        "text": "The discard starts empty; stock top and discard top are public when present."
      },
      {
        "id": "claim.turn.take_once",
        "text": "The current player may take at most one card from stock or discard each turn."
      },
      {
        "id": "claim.turn.discard_once",
        "text": "The current player may discard at most one card each turn and must keep at least three cards."
      },
      {
        "id": "claim.turn.declare_once",
        "text": "A player may privately declare one suit once per round if they hold at least one card of that suit."
      },
      {
        "id": "claim.turn.timer_60",
        "text": "Each turn has a 60 second timer; timeout after action resolves as ending undeclared."
      },
      {
        "id": "claim.score.declared_positive",
        "text": "Cards in the declared suit score positive."
      },
      {
        "id": "claim.score.offsuit_negative",
        "text": "Cards outside the declared suit score negative."
      },
      {
        "id": "claim.score.undeclared_negative",
        "text": "An undeclared hand scores all cards as negative."
      },
      {
        "id": "claim.score.circular_runs",
        "text": "Same-suit maximal circular runs score sum of values multiplied by run length; singles score face value."
      },
      {
        "id": "claim.score.debt",
        "text": "Acting while undeclared and ending or timing out after that action adds highest-card debt, and debt persists after discard."
      },
      {
        "id": "claim.showdown.minimum_27",
        "text": "A caller must be declared, hold at least three cards, and have final score at least 27."
      },
      {
        "id": "claim.showdown.highest_score_wins",
        "text": "If someone else has a higher final score after reveal, that higher scorer wins the round; the caller receives no extra penalty."
      },
      {
        "id": "claim.settlement.raw_and_difference",
        "text": "Raw final scores apply to bankrolls. A positive top score also receives winner-difference payouts; tied top scores share the payout pool."
      }
    ],
