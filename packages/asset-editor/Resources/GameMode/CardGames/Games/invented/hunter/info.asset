        pages: [
          {
            title: 'Young Hunter',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Young Hunter (also known as Hunter, German: JÃ¤ger) is a specialized German trick-taking game for four players. The game revolves entirely around the Jacks (the 'Youngs'), who act as both the 'Hunters' and the 'Prey'. Scoring is achieved not by winning tricks generally, but specifically by capturing or 'hitting' Jacks within tricks.",
              },
              {
                type: 'paragraph',
                text: 'A regional variant of traditional German trick-taking games like Skat and Schafkopf, but simplified to focus on specific cards.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 individual players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: A (High) to 2 (Low).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: A (High) to 2 (Low).',
              },
              {
                type: 'paragraph',
                text: 'Deal all 52 cards (13 per player).',
              },
            ],
          },
        ],
      },
