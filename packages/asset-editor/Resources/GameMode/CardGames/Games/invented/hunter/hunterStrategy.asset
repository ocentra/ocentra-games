    tips: [
      {
        title: 'Tip',
        description: "If you are leading and have no Jacks, lead a suit where you have high cards to flush out an opponent's Jack.",
      },
      {
        title: 'Tip',
        description: 'In the middle and end-game, avoid leading low cards, as it gives neighbors a free chance to dump their Jacks safely.',
