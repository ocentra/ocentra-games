  data: {
    hero: {
      title: 'U-G-O',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'U-G-O',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "U-G-O is a combat card game for two or more players where each player uses their own 52-card deck (different backs). Cards are played vertically (attack) or horizontally (defense). Players attack opponents' cards by playing higher-valued cards. Defense cards may be played face-up or face-down. Goal: exhaust your opponent's deck before yours runs out. Special abilities on Aces, Kings, Queens, Jacks, 8s, 9s, and 10s; Equip cards (Diamonds) and suit abilities (Spades, Hearts, Clubs).",
              },
              {
                type: 'paragraph',
                text: 'U-G-O was invented in 2003 by Michael Daniel as an affordable home alternative to trading-card games like Yu-Gi-Oh. Daniel created it because his children wanted collectible card games but he could not afford them; he designed U-G-O so that each player uses a standard 52-card deck with different backs. The game proved popular with his children and their school friends, in part because many schools allow standard playing cards but prohibit trading cards. It has no earlier folk or commercial lineage.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '1 deck per player (different backs). Shuffle, pass to left. Draw 5.',
              },
              {
                type: 'paragraph',
                text: 'Multiple 52-card decks',
              },
              {
                type: 'paragraph',
                text: 'Each player shuffles their deck, passes it to the left, and draws five cards from the deck they received.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Standard: Default rules as described: one Attack/Defense card per turn, special cards, equip cards, attack/defense positions.',
                  },
                  {
                    text: 'Ace variants (optional): Aces can be given suit-specific targets: Spades on all attack-position cards, Hearts on all defense-position, Clubs on all A/D cards, Diamonds on all Equip cards.',
                  },
                  {
                    text: 'Nine counter (optional): When a Special card is used on you, you may take their card and use it on them instead. Especially good for two-player.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "U-G-O is a combat card game for two or more players where each player uses their own 52-card deck (different backs). Cards are played vertically (attack) or horizontally (defense). Players attack opponents' cards by playing higher-valued cards. Defense cards may be played face-up or face-down. Goal: exhaust your opponent's deck before yours runs out. Special abilities on Aces, Kings, Queens, Jacks, 8s, 9s, and 10s; Equip cards (Diamonds) and suit abilities (Spades, Hearts, Clubs).",
