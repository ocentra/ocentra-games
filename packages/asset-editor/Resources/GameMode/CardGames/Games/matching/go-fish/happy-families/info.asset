    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Happy Families',
            subtitle: 'The Original Quartet Game',
            content: [
              {
                type: 'paragraph',
                text: 'Happy Families is a traditional British matching game, famously illustrated by John Tenniel. It is a progenitor to games like Go Fish and Authors. Players attempt to collect complete sets (families) of four characters by asking opponents for specific cards. If successful, they continue their turn; if not, the turn passes to the person asked.',
              },
              {
                type: 'paragraph',
                text: "First published in 1851 by Jaques of London, the game featured characters who have since become iconic in British culture, such as 'Master Bun the Baker' and 'Mr. Dose the Doctor'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 6 players.',
              },
              {
                type: 'paragraph',
                text: '44 characters divided into 11 families of 4 (Father, Mother, Son, Daughter).',
              },
              {
                type: 'paragraph',
                text: 'Standard Happy Families deck.',
              },
              {
                type: 'paragraph',
                text: 'Deal all cards face-down to all players. Some players may have one more card than others; this is acceptable.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Quartets: A European variant using a similar 32-card deck (8 sets of 4) often with educational themes like animals or cars.',
                  },
                ],
              },
            ],
          },
        ],
      },
