    customActions: [
      {
        supported: true,
        description: 'Ask one opponent for a specific card by value and suit. Valid only if you hold another card in that half-suit, the asked player has at least one card, and you do not ask for a card in your own hand. If they have it they give it to you and you keep the turn; if not, turn passes to them.',
        cost: '0',
        constraints: 'Must ask a player from the other team. You must have at least one other card in the same half-suit. Cannot ask for a card you hold. Cannot ask a teammate.',
        isTerminating: false,
        effectType: 'play',
        id: 'ask_for_card',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Claim that your team holds all six cards of a half-suit by saying Claim and naming exactly who has which cards. Correct claim scores the half-suit for your team; wrong distribution cancels it for both; if an opponent holds any card in that half-suit they get it.',
        cost: '0',
        constraints: 'On your turn. You may claim even without holding any cards in the half-suit. After claim is resolved your turn continues.',
        isTerminating: false,
        effectType: 'play',
        id: 'claim_half_suit',
        effectHints: {},
      },
      {
        supported: true,
        description: 'If you have the requested card, pass it face-up to the asker. They take it into their hand and keep the turn.',
        cost: '0',
        constraints: 'You are the player who was asked. You must give the card if you hold it.',
        isTerminating: false,
        effectType: 'play',
        id: 'give_card',
        effectHints: {},
      },
      {
        supported: true,
        description: 'If you do not have the requested card, say so. Turn passes to you and you must ask the next question.',
        cost: '0',
        constraints: 'You are the player who was asked. You do not have the requested card.',
        isTerminating: false,
        effectType: 'play',
        id: 'deny',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Verify the claim by having players reveal the stated cards. Award the half-suit to the claiming team if correct, to opponents if they held a card, or cancel for both if distribution was wrong. Stack the six cards in front of a member of the winning team.',
        cost: '0',
        constraints: 'System resolves after a claim was made.',
        isTerminating: false,
        effectType: 'play',
        id: 'resolve_claim',
        effectHints: {},
      },
      {
        supported: true,
        description: 'No claim to resolve; continue to the ask phase. Same player keeps turn after a successful ask.',
        cost: '0',
        constraints: 'No claim was made in the current resolution.',
        isTerminating: false,
        effectType: 'play',
        id: 'continue',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Count claimed half-suits per team. Team with more wins; tie at 4-4.',
        cost: '0',
        constraints: 'Game has ended when all eight half-suits are claimed.',
        isTerminating: false,
        effectType: 'play',
        id: 'tally_score',
        effectHints: {},
      },
    ],
