    tips: [
      {
        title: 'Tip',
        description: "Don't hold onto a Joker too long. Use it to complete a Book and get it out of your hand before someone 'fishes' it from you.",
      },
      {
        title: 'Tip',
        description: 'If the Ocean is small, fishing is more effective than asking. The probability of a hit increases significantly in the late game.',
      },
