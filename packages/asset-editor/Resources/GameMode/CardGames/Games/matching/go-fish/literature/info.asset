    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Literature',
            subtitle: "The Memory Master's Game",
            content: [
              {
                type: 'paragraph',
                text: "Literature is a highly intellectual team-based deduction game, similar to Go Fish or Authors, but significantly more complex. Popular in Indian schools and universities (often called 'Lit'), it requires players to recall every card asked for by every player. The objective is to correctly identify and 'declare' all six cards of a specific half-suit (e.g., Low Hearts A-6 or High Clubs 9-K) to score points for the team.",
              },
              {
                type: 'paragraph',
                text: "Derived from the traditional game 'Authors', it was adapted and complexified in South Asia during the mid-20th century. The most likely place of origin based on reports is southern Indiaâ€”Tamil Nadu and Kerala.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '6 or 8 players divided into two teams of equal size. Teams sit alternately, each player between two opponents.',
              },
              {
                type: 'paragraph',
                text: "Remove the four 8s from a standard 52-card deck, leaving 48 cards. These form eight 'half-suits' (also called sets or books).",
              },
              {
                type: 'paragraph',
                text: 'Standard deck. No writing materials allowed.',
              },
              {
                type: 'paragraph',
                text: 'Shuffle thoroughly and deal all cards one at a time face down. For 6 players: 8 cards each. For 8 players: 6 cards each.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Authors: The 19th-century educational version using special cards with authors and their works.',
                  },
                  {
                    text: "Go Fish: Simplified children's version without teams or formal claiming.",
                  },
                  {
                    text: 'Canasta Literature: Variant using multiple decks for larger groups.',
                  },
                  {
                    text: 'Eight-Player Literature: Version for 8 players (4 vs 4), dealing 6 cards each.',
                  },
                ],
              },
            ],
          },
        ],
      },
