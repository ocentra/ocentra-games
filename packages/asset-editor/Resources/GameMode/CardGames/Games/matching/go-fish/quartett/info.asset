  data: {
    hero: {
      title: 'QUARTETT',
      subtitle: 'Collect Families of Four',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Quartett',
            subtitle: 'Collect Families of Four',
            content: [
              {
                type: 'paragraph',
                text: "Quartett is a German and Austrian matching game where players collect complete quartets (families of four cards) by asking others for specific cards. You must hold at least one card of the quartet to ask. If the asked player has it, they give it and you continue; if not, they say 'not at home' and their turn begins.",
              },
              {
                type: 'paragraph',
                text: 'Games of this type first appeared in the mid-19th century with special cards. In Britain, Spade the Gardener (families of five) was superseded by Happy Families (John Jaques Jr., before 1851), with four-card families. In the USA, Dr Busby (1843) and Authors (1861) followed. Quartett is the German/Austrian equivalent, also called Ablegspiel in Upper Austria and Styria.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2â€“6 players (optimal 3â€“4). 2-player uses a stock.',
              },
              {
                type: 'paragraph',
                text: '32-card German pack (A,K,D,B,10,9,8,7) or dedicated Quartett pack (typically 8 quartets, 32 cards).',
              },
              {
                type: 'paragraph',
                text: 'Quartett or 32-card deck. Optional: pool for stakes (Happy Families variant).',
              },
              {
                type: 'paragraph',
                text: '1. 3+ players: Deal all cards evenly, one at a time, clockwise (some may have one more). 2. 2 players: 10 cards each; remaining 12 form a face-down stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Happy Families: British version with 44 cards (11 families of 4). Pool; winner of first phase takes half; second phase: players ask for complete families; winner takes the rest.',
                  },
                  {
                    text: 'Authors: American version; all cards dealt, no stock. Same core rules. Originally with educational author cards.',
                  },
                  {
                    text: "Go Fish: Uses a stock; when the asked player doesn't have the card, the asker says 'Go fish!' and draws. Turn passes left if the drawn card doesn't match. Ask for rank, not specific card.",
                  },
                  {
                    text: 'Specific Card: Must ask for a specific card (e.g. 7 of diamonds) rather than a rank. Can optionally allow asking for a card you already hold (to mislead).',
                  },
                  {
                    text: 'Target Score: Play multiple hands; one point per quartet. First to reach an agreed total (e.g. 10) wins.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Quartett is a German and Austrian matching game where players collect complete quartets (families of four cards) by asking others for specific cards. You must hold at least one card of the quartet to ask. If the asked player has it, they give it and you continue; if not, they say 'not at home' and their turn begins.",
    tags: [
      'card-game',
