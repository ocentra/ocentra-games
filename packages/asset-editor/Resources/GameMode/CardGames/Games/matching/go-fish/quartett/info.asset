    aiContent: {
      difficulty: {
        easy: 'Randomly selects a player and a card from an incomplete quartet. No memory.',
        medium: "Tracks which players have said 'not at home' for which quartets. Prefers asking for cards that complete quartets.",
        hard: 'Full inference: models card distribution from all asks and gives. Optimizes ask order to complete quartets while limiting opponent information.',
