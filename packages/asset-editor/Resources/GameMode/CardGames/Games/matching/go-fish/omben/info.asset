        pages: [
          {
            title: 'Omben',
            subtitle: 'Indonesian Go Fish',
            content: [
              {
                type: 'paragraph',
                text: "Omben (Javanese) or Minuman (Indonesian)â€”both meaning 'drink'â€”is a two-player Go Fish variant from Indonesia. Players ask for ranks; the opponent gives all cards of that rank or the asker 'drinks' by drawing until they find one. First to discard all cards wins.",
              },
              {
                type: 'paragraph',
                text: "Omben is the Indonesian/Javanese variant of the quartet-collection family that includes Go Fish and Authors. The name 'drink' may refer to the penalty of drawing when the opponent has no card of the requested rank.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players. Omben (Indonesian Go Fish) is played by exactly two players; each begins with 4 or 5 cards by agreement drawn from a 52-card pack, and the remainder forms the face-down stock.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 4 or 5 cards (by agreement). Remaining cards form a face-down stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: '4 Cards Each: Shorter game; 4 cards per player.',
                  },
                  {
                    text: '5 Cards Each: Slightly longer game; 5 cards per player.',
                  },
                ],
              },
            ],
          },
        ],
      },
