    historyContent: {
      origins: "Omben is the Indonesian/Javanese variant of the quartet-collection family that includes Go Fish and Authors. The name 'drink' may refer to the penalty of drawing when the opponent has no card of the requested rank.",
      originCountries: [
        'Indonesia',
      ],
      timeline: [
        'Quartet games originated mid-19th century with special packs (Happy Families, Authors).',
        'Omben/Minuman documented as the Indonesian adaptation, best for two players.',
        "Present: Played in Indonesia as a children's and family game.",
      ],
      evolution: "Differs from standard Go Fish: two players only, asker continues drawing until finding the requested rank when opponent has none (the 'drink'), and first to empty hand wins (not most books).",
