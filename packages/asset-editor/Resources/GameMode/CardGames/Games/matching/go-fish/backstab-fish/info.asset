    historyContent: {
      origins: 'Backstab Fish is a modern large-group variant of Go Fish, played with two decks and four jokers. It builds on 19th-century quartet and Go Fish family games but scales them for louder, more competitive tables.',
      originCountries: [
        'Australia',
      ],
      timeline: [
        "19th Century: 'Authors' and other quartet games establish the core 'ask and take' mechanic.",
        "Mid 20th Century: Single-deck 'Go Fish' becomes a widely played children's game using standard packs.",
        'Modern era: Backstab Fish is played in Adelaide, Australia, using 108 cards and quantity-based asking.',
        'Present: Played as a loud, social party variant for large groups that keeps the memory and book-collecting core of Go Fish.',
      ],
      evolution: 'Backstab Fish takes the basic Go Fish structure and extends it to a 108-card pack, with players tracking up to eight copies of each rank and using quantity asks to swing large numbers of cards at once.',
      cultural: 'Around Adelaide tables it is treated as a vocal, social deduction variant where calling specific opponents and quantities is part strategy and part performance.',
    },
    setupContent: {
      players: '4-10 players. Best with 5-7.',
      deck: 'Two identical 52-card decks + 4 Jokers.',
      equipment: 'Comfortable seating where all players can be heard clearly.',
      dealing: "For 4-6 players, deal 7 cards each. For 7-10 players, deal 5 cards each. The remainder forms the 'Ocean' (Stock).",
    },
