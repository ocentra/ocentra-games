    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Backstab Fish',
            subtitle: 'Go Fish for Adults',
            content: [
              {
                type: 'paragraph',
                text: "Backstab Fish is a high-octane, multi-deck evolution of the classic Go Fish. Designed for large groups (up to 10 players), it utilizes two full decks and four Jokers to create a chaotic environment where memory and deception are paramount. Unlike the child's version, Backstab Fish features aggressive 'Quantity Bidding' and rules that allow players to 'backstab' opponents by stealing specific duplicates or utilizing Jokers as wild 'spies'.",
              },
              {
                type: 'paragraph',
                text: 'Backstab Fish is a modern large-group variant of Go Fish, played with two decks and four jokers. It builds on 19th-century quartet and Go Fish family games but scales them for louder, more competitive tables.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4-10 players. Best with 5-7.',
              },
              {
                type: 'paragraph',
                text: 'Two identical 52-card decks + 4 Jokers.',
              },
              {
                type: 'paragraph',
                text: 'Comfortable seating where all players can be heard clearly.',
              },
              {
                type: 'paragraph',
                text: "For 4-6 players, deal 7 cards each. For 7-10 players, deal 5 cards each. The remainder forms the 'Ocean' (Stock).",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Full Backstab: Players can ask for a card by rank AND suit. This makes the game move much slower but increases the 'memory' stakes.",
                  },
                ],
              },
            ],
          },
        ],
      },
