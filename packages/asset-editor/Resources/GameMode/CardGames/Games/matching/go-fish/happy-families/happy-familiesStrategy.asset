  data: {
    LLM: "Remember which players asked for which families. If someone asks for a 'Bun' card, they hold at least one.\n\nIf you are asked for a card you don't have, pay close attention to where that card eventually surfaces. Track which families are 'active' at the table.\n\nDeduction: If Player A asks Player B for a card and Player B doesn't have it, you can safely assume Player C holds it if you don't have it yourself.",
    Player: "Remember which players asked for which families. If someone asks for a 'Bun' card, they hold at least one.\n\nIf you are asked for a card you don't have, pay close attention to where that card eventually surfaces. Track which families are 'active' at the table.\n\nDeduction: If Player A asks Player B for a card and Player B doesn't have it, you can safely assume Player C holds it if you don't have it yourself.",
    aggressiveness: 0.5,
    riskTolerance: 0.5,
    bluffFrequency: 0.3,
    bluffSettings: {
      profile: 'balanced',
