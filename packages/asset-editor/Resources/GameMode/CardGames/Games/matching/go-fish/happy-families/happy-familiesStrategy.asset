    basic: "Remember which players asked for which families. If someone asks for a 'Bun' card, they hold at least one.",
    intermediate: "If you are asked for a card you don't have, pay close attention to where that card eventually surfaces. Track which families are 'active' at the table.",
    advanced: "Deduction: If Player A asks Player B for a card and Player B doesn't have it, you can safely assume Player C holds it if you don't have it yourself.",
    tips: [
      {
        title: 'Tip',
        description: 'Try to complete families you already have three of quickly before others guess your hand.',
      },
      {
        title: 'Tip',
        description: 'Watch for players who have few cards left; they are close to completing sets.',
      },
      {
        title: 'Tip',
        description: "Listen to the 'Not at home' responses - they tell you who DOESN'T have a card just as much as a 'Yes' tells you who does.",
      },
