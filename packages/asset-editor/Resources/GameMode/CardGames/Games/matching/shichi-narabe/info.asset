        rules: {
          objective: 'Empty your hand as early as possible while avoiding bankruptcy from overusing passes.',
          gameplay: 'The player associated with the seven of diamonds starts, then play continues clockwise. On a turn, play one legal adjacent rank in a suit row or pass. Legal plays extend each suit outward from 7 toward K and A. Each player may pass at most three times; a player who must pass again while still holding cards goes bankrupt and is ranked behind active finishers.',
          keyRules: [
            'All sevens are laid out before normal turns begin.',
            'Each player has a strict pass limit (typically three).',
            'Finishing order determines ranking; bankrupt players are last.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Avoid spending passes too early unless doing so meaningfully blocks opponents' key exits.",
          intermediate: 'Control choke cards near 7s to force opponents into pass pressure.',
          advanced: 'Time releases of blocked suit branches to avoid becoming the final trapped holder.',
          tips: [
            "Track each player's remaining passes as a primary tempo resource.",
            'Do not over-block if it leaves you with isolated high/low cards at endgame.',
          ],
          hasPlaceholders: false,
        },
