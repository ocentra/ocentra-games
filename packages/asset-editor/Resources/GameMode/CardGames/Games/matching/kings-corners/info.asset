    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kings Corners',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Kings Corners is a social, Solitaire-like card game played by 2 to 4 players. Unlike competitive trick-taking games, it focuses on building sequences of alternating colors onto a central cross-shaped layout. The goal is to be the first to empty your hand. It is widely considered one of the best family games for all ages due to its simple rules and visual layout.',
              },
              {
                type: 'paragraph',
                text: 'Dates to the early 20th century in America. It evolved as a communal version of standard Solitaire (Klondike), enabling multiple people to play on a shared board.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to four players. The game is said to be good for four players. A standard 52-card pack is used; the first dealer is chosen at random and the turn to deal passes clockwise after each hand.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are low (sequencing on Kings is King-Queen-Jack...2). No, wait. Standard Kings Corners Ranking: K-Q-J-10-9-8-7-6-5-4-3-2-A.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are low (sequencing on Kings is King-Queen-Jack...2). No, wait. Standard Kings Corners Ranking: K-Q-J-10-9-8-7-6-5-4-3-2-A.',
              },
              {
                type: 'paragraph',
                text: "Each player is dealt 7 cards. Four cards are placed face-up in a cross (the 'T' or '+' shape). The rest form the draw pile.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Double Kings Corners: Played with two decks for up to 8 players.',
                  },
                  {
                    text: "No Draw Variant: Players don't draw at the start of their turn after the first round.",
                  },
                  {
                    text: 'Aces High: Aces rank above Kings.',
                  },
                ],
              },
            ],
          },
        ],
      },
