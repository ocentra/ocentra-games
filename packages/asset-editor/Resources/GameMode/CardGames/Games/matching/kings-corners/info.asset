          equipment: '',
          dealing: "Each player is dealt 7 cards. Four cards are placed face-up in a cross (the 'T' or '+' shape). The rest form the draw pile.",
          hasPlaceholders: false,
        },
        rules: {
          objective: 'Be the first player to play all cards from your hand onto the table piles.',
          gameplay: "1. Players take turns. Each turn begins with drawing 1 card from the stock.\n2. You can play any card from your hand onto a pile if it is one rank lower and a different color (e.g., a Red 7 onto a Black 8).\n3. You can move an entire pile onto another pile if the bottom card of the first fits on the top card of the second.\n4. **Kings**: If you have a King, it *must* be played into one of the empty 'Corner' slots (diagonals of the cross). Once there, it forms a new foundation pile.\n5. Empty Slots: If one of the original 4 foundation slots becomes empty, you can place any card (or sequence) there.",
          keyRules: [
            'Build sequences in descending order',
            'Alternate colors when building',
            'Kings must go to corner slots',
            'Can move entire piles onto other piles',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Prioritize emptying the 4 main slots by moving sequences. Every empty slot is a massive opportunity to play cards that don't fit elsewhere.",
          intermediate: "The 'King Save': If you already have cards that fit on a King, wait for an opponent to play their King into a corner first so you don't have to waste your turn filling a corner slot.",
          advanced: 'Sequence Consolidation: Always look for ways to merge existing table piles. This frees up the 4 main slots, which can then be filled with any card, potentially dumping a large part of your hand at once.',
          tips: [
            "Don't build too deep on the 4 main piles if you have a King; you want the Corners to be most accessible.",
            "Watch your opponents' colors. If they are primarily drawing Red cards, try to play Black cards to the board to entice them to 'tack' their cards onto yours.",
          ],
          hasPlaceholders: false,
        },
