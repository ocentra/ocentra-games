          objective: 'Cooperatively build each coloured firework sequence in order while avoiding too many failed plays.',
          gameplay: 'Players give limited colour or number clues, discard to regain clue tokens, or play cards to the shared firework stacks in ascending order.',
          keyRules: [
            'Players cannot see their own cards.',
            'Clues are limited.',
            'Fireworks build upward by colour.',
            'Bad plays consume fuse tokens.',
            'The group shares one final score.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Give clues that identify action, not just information; a clue should usually tell a partner what to play, save, or discard.',
