          {
            title: '7 Wonders Duel',
            subtitle: 'Matching',
            content: [
              {
                type: 'paragraph',
                text: '7 Wonders Duel is a two-player commercial card-drafting strategy game where players take visible and hidden cards from a shared structure to build civilizations.',
              },
              {
                type: 'paragraph',
                text: '7 Wonders Duel was designed by Antoine Bauza and Bruno Cathala as a dedicated two-player reworking of the 7 Wonders card-drafting system.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players face a shared card structure and personal civilization area.',
              },
              {
                type: 'paragraph',
                text: 'Use the dedicated Age decks, guild cards, wonder cards, tokens, and military/science tracks.',
              },
              {
                type: 'paragraph',
                text: 'Dedicated civilization cards, guild cards, wonder cards, science tokens, and military track, score area, and enough table space for play.',
              },
              {
                type: 'paragraph',
                text: 'Lay out the current Age in its prescribed overlapping structure, with some cards face down and some cards face up.',
              },
            ],
          },
        ],
      },
    ],
