  data: {
    hero: {
      title: 'JAMES BOND (CARD GAME)',
      subtitle: 'Card game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'James Bond (Card Game)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "James Bond is a high-speed, frantic card game that tests memory and reaction time. Unlike turn-based games, everyone plays simultaneously. Each player manages several 'books' (piles) of cards, racing to turn each book into a set of four-of-a-kind by swapping cards with a shared central pool. The first player to complete all their sets and shout 'James Bond!' wins.",
              },
              {
                type: 'paragraph',
                text: "A variation of children's 'Speed' and 'Spoons' games. The name likely comes from the '007' high-stakes imagery and the intense, rapid pace of the game.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '- 2 players: 24 cards each (6 books of 4).\n- 3 players: 16 cards each (4 books of 4).\n- 4 players: 12 cards each (3 books of 4).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Remove Jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Remove Jokers.',
              },
              {
                type: 'paragraph',
                text: "Deal all cards into piles of 4, leaving exactly 4 cards face-up in the center (the 'Pond').",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Book announcement: Some players say 'book' each time they complete a pile of four equal cards, and 'book, James Bond' when they complete the last pile. Saying 'book' is not required and may give away information.",
                  },
                  {
                    text: 'Win-call name: The word used to claim a win varies by region: James Bond, Chanhassen, Atlantis, or the name of the game in other versions.',
                  },
                  {
                    text: 'Multi-card trade: Some groups allow more than one card to be traded simultaneously (e.g. grab both fours at once in exchange for two cards from the pile).',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "James Bond is a high-speed, frantic card game that tests memory and reaction time. Unlike turn-based games, everyone plays simultaneously. Each player manages several 'books' (piles) of cards, racing to turn each book into a set of four-of-a-kind by swapping cards with a shared central pool. The first player to complete all their sets and shout 'James Bond!' wins.",
