        rules: {
          objective: "Be the first player to have four-of-a-kind in all of your books and shout 'James Bond!'.",
          gameplay: "1. Players start simultaneously at the signal 'Go!'.\n2. You may pick up and look at ONE of your books at a time.\n3. **Swapping**: You can swap one card from your book with one card from the Pond. You must place your card face-up in the Pond before taking the new one.\n4. You cannot have more or fewer than 4 cards in your hand/book at any time.\n5. You can put down a book and pick up another at any point to continue swapping.",
          keyRules: [
            'Follow the legal action constraints defined for James Bond (Card Game).',
            'Round outcome is resolved by the scoring method: Scoring summary: Scoring follows the game-specific point or pot rules.',
            "Winning condition: Be the first player to have four-of-a-kind in all of your books and shout 'James Bond!'.",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Memory is key. Remember which cards are in your other books so when a useful card appears in the Pond, you know exactly which book to pick up.',
          intermediate: 'Blocking: If you see your opponent is hoarding 7s, keep a 7 in your current book to prevent them from finishing their set.',
          advanced: 'Dual-Processing: Skilled players can track the contents of 2-3 books simultaneously, swapping cards in rapid succession between the Pond and their books with almost no pause.',
          tips: [
            "Don't get tunnel-visioned on one book. If the Pond doesn't have what you need, check your other books immediately.",
            "If you win, shout 'James Bond!' loudly to stop the other players from continuing.",
          ],
          hasPlaceholders: false,
        },
