        supported: true,
        description: 'Arrange the remaining deck into a pyramid of face-down cards: 6 on bottom row, then 5, 4, 3, 2, 1 on top.',
        cost: '0',
        constraints: 'Dealer only; after initial deal.',
        isTerminating: false,
        effectType: 'play',
        effectHints: {},
        id: 'build_pyramid_layout',
      },
      {
        supported: true,
        description: 'Turn over one pyramid card (reveal order: bottom row left to right, then next row, until top card).',
        cost: '0',
        constraints: 'Dealer or system; one card per reveal step.',
        isTerminating: false,
        effectType: 'play',
        effectHints: {},
        id: 'reveal_pyramid_card',
      },
      {
        supported: true,
        description: "Claim you hold a card matching the revealed pyramid card's rank and assign a penalty (e.g. drinks) to another player; if they call bluff and you were lying, you take double penalty.",
        cost: '0',
        constraints: 'Legal when a pyramid card is revealed; you must name the rank and choose an opponent to penalise.',
        isTerminating: false,
        effectType: 'play',
        effectHints: {},
        id: 'claim_match_assign_drink',
      },
      {
        supported: true,
        description: 'Accept the assigned penalty (e.g. take the drinks) without calling bluff.',
        cost: '0',
        constraints: 'Only the player who was assigned the penalty may choose this; penalty amount often equals pyramid row number.',
        isTerminating: false,
        effectType: 'play',
        effectHints: {},
        id: 'accept_drink',
      },
      {
        supported: true,
        description: 'Challenge the claimer: they must show the matching card. If they had it, you take double the penalty; if they were bluffing, they take double.',
        cost: '0',
        constraints: 'Only the player who was assigned the penalty may call bluff.',
        isTerminating: false,
