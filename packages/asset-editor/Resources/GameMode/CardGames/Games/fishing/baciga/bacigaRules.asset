      award_pot: 'Scoring is by points (Oros, Cartas, Setenta); no pot to award.',
      play_card: 'One card per turn; capture sum 15 or leave card on table.',
      draw: 'New cards only when dealer redeals after hands empty; no in-turn draw.',
      discard: 'Cards are played to capture or to table, not discarded to a pile.',
