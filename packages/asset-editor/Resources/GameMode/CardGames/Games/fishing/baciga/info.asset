    },
    historyContent: {
      origins: "Derived from the Spanish game 'Escoba de 15' which was brought to South America by immigrants. In Uruguay, it merged with elements of the game 'Chorizo' to become the modern Báciga.",
      originCountries: [
        'Uruguay',
        'Spain',
      ],
      timeline: [
        '1800s: Escoba introduced to the Rio de la Plata region.',
        "Early 20th Century: 'Chorizo' variant emerges in Uruguay with point-heavy hand declarations.",
        "1950s: Báciga rules stabilize as a 'lite' version of Chorizo, becoming a staple in Uruguayan 'clubes sociales'.",
        "Present: One of the 'Big Two' traditional card games in Uruguay alongside Truco.",
      ],
      evolution: "The game moved from a simple arithmetic capture game to a high-scoring strategy game where a single 'Chorizo' (three-of-a-kind) can end the session.",
      cultural: "In Uruguay, Báciga is often played over coffee or matte, known for its rapid-fire arithmetic and the dramatic 'cantar' (announcement) of hand bonuses.",
    },
    setupContent: {
      players: '2-4 players. 4-player games are usually partnerships (North-South vs East-West).',
      deck: '40-card Spanish deck (1-7, 10-12). Note: 10 (Sota), 11 (Caballo), 12 (Rey).',
      equipment: 'Standard Spanish deck, pen and paper for 21-point tracking.',
      dealing: '1. Dealer deals 3 cards to each player face down. 2. 4 cards are dealt face up to the table. 3. Dealing is counter-clockwise.',
