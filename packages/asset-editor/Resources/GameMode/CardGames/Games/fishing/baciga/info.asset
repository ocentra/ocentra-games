  data: {
    hero: {
      title: 'BÁCIGA',
      subtitle: 'The Soul of Uruguay',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Báciga',
            subtitle: 'The Soul of Uruguay',
            content: [
              {
                type: 'paragraph',
                text: "Báciga is the distinct Uruguayan evolution of the Spanish fishing game 'Escoba'. While it retains the core mechanic of capturing cards that sum to 15, Báciga adds a layer of 'declarations' (hand combinations) similar to Poker or Rummy. Points are scored through table captures, 'Escobas' (clearing the table), and special three-card combos like the 'Chorizo'. It is widely celebrated in Uruguay as a faster, more combo-driven alternative to Truco.",
              },
              {
                type: 'paragraph',
                text: "Derived from the Spanish game 'Escoba de 15' which was brought to South America by immigrants. In Uruguay, it merged with elements of the game 'Chorizo' to become the modern Báciga.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 players. 4-player games are usually partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: '40-card Spanish deck (1-7, 10-12). Note: 10 (Sota), 11 (Caballo), 12 (Rey).',
              },
              {
                type: 'paragraph',
                text: 'Standard Spanish deck, pen and paper for 21-point tracking.',
              },
              {
                type: 'paragraph',
                text: '1. Dealer deals 3 cards to each player face down. 2. 4 cards are dealt face up to the table. 3. Dealing is counter-clockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Chorizo (Traditional): The 'parent' game where the declaration values are much higher and the session usually goes to 31 points.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Báciga is the distinct Uruguayan evolution of the Spanish fishing game 'Escoba'. While it retains the core mechanic of capturing cards that sum to 15, Báciga adds a layer of 'declarations' (hand combinations) similar to Poker or Rummy. Points are scored through table captures, 'Escobas' (clearing the table), and special three-card combos like the 'Chorizo'. It is widely celebrated in Uruguay as a faster, more combo-driven alternative to Truco.",
    tags: [
      'card-game',
      'fishing',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 4,
    routePath: 'baciga',
    LLM: 'Game: Báciga. Type: Fishing (Spanish Deck). Rules: Capture cards summing to 15. Sota=8, Cab=9, Rey=10. Scoring: Escobas, Coins, 7-of-Coins, Cartas, Setenta. Declarations: Flor, Escalera, Báciga, Chorizo. Target: 21.',
    Player: 'Welcome to Báciga! The table is set with four cards. Before you play your first card, do you have a declaration? A Flor, a Báciga, or maybe the legendary Chorizo? Speak now, then take your turn to find a 15-sum.',
    tagline: 'Capture the table. Declare the Flor. And hope for the Chorizo that wins it all.',
    gameCategory: 'Fishing',
    subcategory: 'Scopa Family',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '30-45 minutes',
    origin: 'Uruguay',
    originName: 'Báciga',
    deck: '40-card Spanish-suited deck',
    alsoKnownAs: [
      'Escoba Uruguaya',
      'Chorizo (parent variant)',
    ],
    playersDisplay: '2-4',
    quality: 'complete',
    completeness: {
      overview: true,
