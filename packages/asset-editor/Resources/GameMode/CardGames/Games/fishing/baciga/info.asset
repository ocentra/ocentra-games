    aiContent: {
      difficulty: {
        easy: 'Only checks for single-card captures (e.g., played 5 takes a 10). Miscalculates multi-card captures.',
        medium: "Checks all possible combinations for a 15-sum. Recognizes Báciga and Flor combos but doesn't bluff.",
        hard: 'Tracks the 7 of Coins precisely. Calculates the statistical likelihood of the dealer hitting an Escoba and plays to deny the last-trick sweep.',
      },
      considerations: [
        "Calculation of the 'Setenta' score involves a specific ranking of suits (Coins > Swords > ...).",
        'Declaration logic must be triggered before the first card is played in every sub-deal.',
      ],
    },
