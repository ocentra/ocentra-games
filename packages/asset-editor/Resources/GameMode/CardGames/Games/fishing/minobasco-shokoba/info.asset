    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Minobasco (Shokoba)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Minobasco (often associated with the name 'Shokoba') is a specialized, modern variant of the traditional Italian fishing game 'Escoba' (or Scopa). It is unique for its use of colorful plastic 'Gemstones' as scoring tokens and its simplified point-capture rules aimed at a faster, more competitive pace. Like Scopa, players use cards from their hand to capture sums of cards from the table, but with an emphasis on 'Shokoba'â€”clearing the entire table for a bonus point.",
              },
              {
                type: 'paragraph',
                text: "A modern evolution of 'Escoba de 15' (Spanish/Italian fishing). The 'Minobasco' branding emerged in Central Europe (Liechtenstein/Switzerland) as a boutique card set in the late 20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players or 4 in teams.',
              },
              {
                type: 'paragraph',
                text: '40 cards. Ranks: 1 (Ace) to 10.',
              },
              {
                type: 'paragraph',
                text: '40 cards. Ranks: 1 (Ace) to 10.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 3 cards. 4 cards are placed face-up on the table. The deal is repeated until the deck is empty.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Standard Minobasco: Two to four players; capture by value or sum; Shokoba (sweep) awards 1 Gemstone; first to 11 Gemstones wins.',
                  },
                  {
                    text: 'Scopa (Italian): Parent game; same capture and sweep rules, scored with traditional Scopa points (cards, coins, settebello, primiera, scope).',
                  },
                  {
                    text: 'Team play (4 players): Four players in two teams; partners sit opposite; same rules, team score first to 11 Gemstones.',
                  },
                ],
              },
            ],
          },
        ],
      },
