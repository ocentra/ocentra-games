    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mura',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Mura is an unusual Hungarian card game for four players. It is a trick-avoidance game where players try not to win tricks, but with a twist: only certain cards (figures) have value, and winning tricks without figures is actually beneficial. The game uses a 32-card Hungarian deck with unique ranking.',
              },
              {
                type: 'paragraph',
                text: 'Mura originated in Hungary, with a 1937 article claiming it was played by rural aristocrats and judicial officials in a patriarchal region of old Hungary. The inventor and exact origins are unknown.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players, each playing for themselves.',
              },
              {
                type: 'paragraph',
                text: '32-card Hungarian pack. Suits: Hearts (Piros), Gourds (Tok), Leaves (Zold), Acorns (Makk). Ranking: X, IX, Ace, King, Over (Felso), Under (Also), VIII, VII. Note: X and IX are high, Ace is third highest.',
              },
              {
                type: 'paragraph',
                text: 'Hungarian deck or modified standard deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: '8 cards to each player, dealt in packets. Deal and play are counter-clockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Point Scoring Variant: Some variants use point-based scoring rather than direct figure counting.',
                  },
                ],
              },
            ],
          },
        ],
