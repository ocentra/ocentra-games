  data: {
    LLM: 'Game: Kasino (Swedish). See rules.objective and rules.gameplay for details.',
    Player: "Kasino (Swedish Casino) is a classic fishing game played in Sweden. While sharing the 'Royal' capture values of its Finnish counterpart, the Swedish version features distinct scoring (1 point for most spades instead of 2) and emphasizes a 16-point winning match. It is a game of strategic capture where the 10 of Diamonds ('Storan') and the 2 of Spades ('Lillan') are the primary targets.",
    objective: 'Capture scoring cards to reach 16 cumulative points.',
    gameplay: "Each turn play one card from hand. Capture a table card of the same capture value, or a set of table cards whose values sum to your card's value; you may take multiple such captures with one play. Capture is optional. Ace counts as 1 or 14. Clearing the table (tabbe) scores 1; last player to capture gets remaining table cards and 1 point (sistan).",
    keyRules: [
      "Capture by same value or by a set of table cards summing to the played card's value; multiple captures allowed in one turn.",
      'Capture is never compulsory; you may leave capturable cards or trail without capturing.',
      'First to 16 or more points wins; tie-break by most points then most spades.',
      'Tabbe (sweep): clearing the table scores 1; sistan: last capture gets remaining table cards and 1 point.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Usually 2 or 4 (in partnerships).',
      deck: 'Standard 52-card deck.',
      equipment: 'Standard 52-card deck.',
      dealing: 'Deal 4 cards to each player and 4 face-up to the table. This is repeated until the deck is empty.',
    },
    turnFlow: "Each turn play one card from hand. Capture a table card of the same capture value, or a set of table cards whose values sum to your card's value; you may take multiple such captures with one play. Capture is optional. Ace counts as 1 or 14. Clearing the table (tabbe) scores 1; last player to capture gets remaining table cards and 1 point (sistan).",
