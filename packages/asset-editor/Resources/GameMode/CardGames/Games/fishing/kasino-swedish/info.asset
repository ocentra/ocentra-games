        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kasino (Swedish)',
            subtitle: 'Nordic Casino',
            content: [
              {
                type: 'paragraph',
                text: "Kasino (Swedish Casino) is a classic fishing game played in Sweden. It uses Royal capture values (J=11, Q=12, K=13; Ace 1 or 14). Players capture table cards by matching rank or by a set that sums to the played card's value; captures are optional. First to 16 points wins. The 10 of Diamonds (Storan) and 2 of Spades (Lillan) score extra; sweeps (tabbe) and last capture (sistan) also score.",
              },
              {
                type: 'paragraph',
                text: "Part of the larger North European 'Nordic Casino' group, it was brought to Sweden in the 19th century. It diverged from traditional English and Russian Casino through the inclusion of 'Royal' face card values (J=11, Q=12, K=13).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Usually 2 or 4 (in partnerships).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Deal 4 cards to each player and 4 face-up to the table. This is repeated until the deck is empty.',
              },
            ],
          },
