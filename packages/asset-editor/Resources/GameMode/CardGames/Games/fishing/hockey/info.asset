  data: {
    hero: {
      title: 'HOCKEY',
      subtitle: 'The Canadian Card Sport',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Hockey',
            subtitle: 'The Canadian Card Sport',
            content: [
              {
                type: 'paragraph',
                text: "Hockey is an ingenious Canadian card game that simulates the flow of an ice hockey match. It is a 'fishing' game where two players attempt to capture cards from a central pile by matching their ranks. The game is known for its thematic terminology, including 'breakaways', 'saves', and 'goals'.",
              },
              {
                type: 'paragraph',
                text: 'Invented by Ida L. Spence in Eddystone, Manitoba, during the 1961-62 hockey season. It gained popularity in Winnipeg and spread through the Canadian Prairies.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players (opposing teams).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No Jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Pencil and paper optional for keeping score.',
              },
              {
                type: 'paragraph',
                text: "A match consists of three 'periods'. In each period, the entire 52-card deck is dealt in batches of 5 cards per player. The final deal of the period is 6 cards each.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Original game: Jacks had no special property; only matching the previous card cleared the ice. After a goal the ice was cleared so the scorer could score again immediately by matching the opponent's next card, allowing multiple goals in a row.",
                  },
                  {
                    text: "Third match cancels only: When your opponent creates a breakaway by matching your card, if you then play a third matching card it cancels your opponent's breakaway but does not create a new breakaway for you.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Hockey is an ingenious Canadian card game that simulates the flow of an ice hockey match. It is a 'fishing' game where two players attempt to capture cards from a central pile by matching their ranks. The game is known for its thematic terminology, including 'breakaways', 'saves', and 'goals'.",
    tags: [
      'card-game',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 2,
    routePath: 'hockey',
    LLM: 'Game: Hockey (Canadian fishing game, 1961). 2-player, 52-card deck. Periods: 3 (plus sudden death if tied). Deal: 5 cards per player per deal, 6 in final deal of period. Turn: Play card to pile. Breakaway: Match top card rank OR play Jack. Goal: Opponent matches your card after your breakaway = 1 goal. Scoring: Most goals after 3 periods wins match.',
    Player: "Welcome to Hockey, the Canadian card game that brings ice hockey to your table. Play three periods, each using the full 52-card deck. Create a 'breakaway' by playing a card matching the top pile card or any Jack. Then, if your opponent's next play matches your card, you score a goal! Most goals after three periods wins the match. Shout 'Breakaway!' and 'Goal!' for thematic fun.",
    tagline: 'Create breakaways. Score goals. Win the match in three periods.',
    gameCategory: 'Fishing',
    subcategory: 'Capture / Matching',
    playerMode: 'multiplayer',
    difficulty: 'Beginner',
    duration: '15-30 minutes',
    origin: 'Canada',
