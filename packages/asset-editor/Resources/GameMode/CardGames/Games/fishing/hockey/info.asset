    historyContent: {
      origins: 'Invented by Ida L. Spence in Eddystone, Manitoba, during the 1961-62 hockey season. It gained popularity in Winnipeg and spread through the Canadian Prairies.',
      originCountries: [
        'Canada',
      ],
      timeline: [
        '1961: Original game created by Ida Spence.',
        '1965: Popularized in Winnipeg social circles.',
        'Present: A niche but beloved regional pastime in Canada.',
      ],
      evolution: 'The game was specifically designed to mirror the scoring cadence of ice hockey, using card ranks to represent positions and plays.',
      cultural: 'Reflects the deep integration of hockey culture into Canadian winter social activities.',
