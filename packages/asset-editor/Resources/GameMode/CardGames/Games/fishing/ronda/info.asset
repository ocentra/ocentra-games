      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Ronda',
            subtitle: 'Moroccan Fishing Game',
            content: [
              {
                type: 'paragraph',
                text: 'Ronda is a Moroccan fishing game played with a 40-card Spanish pack. Players capture cards by playing matching ranks or ascending sequences. Ronda (pair) and Tringa (three of a kind) announced at deal score 1 and 5 pts. Este/caida (matching last played) scores 1-11. Target 41.',
              },
              {
                type: 'paragraph',
                text: 'Popular in Morocco: Rabat, Marrakesh, Fez, Tangier. French, Spanish, Arabic terms.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 (4 in partnerships).',
              },
              {
                type: 'paragraph',
                text: '40 Spanish (clubs, cups, swords, coins; 1-7, 10-12). 10 adjacent to 7.',
              },
              {
                type: 'paragraph',
                text: '40-card pack. Chips.',
              },
              {
                type: 'paragraph',
                text: '3 each; 4 face up on table. No pairs or 4-card sequence in layout. Deal 3 more when hands empty. Anticlockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Card transfer: Score by transferring cards.',
                  },
                ],
              },
            ],
          },
        ],
      },
