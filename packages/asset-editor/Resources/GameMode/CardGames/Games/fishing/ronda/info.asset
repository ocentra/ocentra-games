        rules: {
          objective: 'Capture cards; score ronda/tringa, caida, mesa. First to 41 wins.',
          gameplay: '1. Before play: announce Ronda (pair) = 1 pt or Tringa (triplet) = 5 pts. Best wins all. 2. Play one card. If matches table card: capture pair + all higher in ascending sequence. If no match: trail. 3. Este/caida: capture last played = 1 pt. Third same rank = 5; fourth = 10. 4. Mesa: clear table = 1 pt.',
          keyRules: [
            'Match = capture pair + ascending sequence.',
            'Ronda 1 pt, Tringa 5. Este 1/5/10. Mesa 1.',
            'Target 41. Must announce ronda/tringa.',
          ],
