  data: {
    LLM: '1. Must play exactly one card. 2. Capture: match loose card or sum; or capture build. 3. Build: combine with table cards; owner must hold matching card. 4. Trail: leave card on table if no match. Cannot trail if played card equals loose card. Owner of build cannot trail. 5. Sweeps (clearing table) score extra.',
    Player: '1. Must play exactly one card. 2. Capture: match loose card or sum; or capture build. 3. Build: combine with table cards; owner must hold matching card. 4. Trail: leave card on table if no match. Cannot trail if played card equals loose card. Owner of build cannot trail. 5. Sweeps (clearing table) score extra.',
    objective: 'Capture cards; score points. First to 21 (Dominican) wins.',
    gameplay: '1. Must play exactly one card. 2. Capture: match loose card or sum; or capture build. 3. Build: combine with table cards; owner must hold matching card. 4. Trail: leave card on table if no match. Cannot trail if played card equals loose card. Owner of build cannot trail. 5. Sweeps (clearing table) score extra.',
    keyRules: [
      'K=13, Q=12, J=11, A=1 or 14. Number cards = face value.',
      'Capture, build, or trail. Owner of build must hold matching card.',
      'Cannot trail when played card matches loose card. Target 21.',
    ],
