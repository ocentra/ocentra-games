    historyContent: {
      origins: 'Casino Dominican is a variant of Royal Casino played in the Dominican Republic. Royal Casino (where picture cards have numerical values) is the standard form in many countries outside Britain and North America. The Dominican version was documented by Humbernio Lockward.',
      originCountries: [
        'Dominican Republic',
      ],
      timeline: [
        '18th century: Casino first appears in London and Germany',
        '19th century: Royal Casino variants develop with picture card values',
        'Current: Dominican version played with unique building rules and endgame scoring',
      ],
      evolution: 'The Dominican variant differs from Anglo-American Casino in several ways: different building/capturing restrictions, unique sweep scoring, and modified endgame scoring when nearing 21. Counter-clockwise play and Spanish terminology (captura, forma, dejado, pisado) reflect local culture.',
      cultural: 'Popular in the Dominican Republic. Uses Spanish terms for game actions. Often played socially and in family settings. The game to 21 points with special endgame rules creates exciting finishes.',
    },
