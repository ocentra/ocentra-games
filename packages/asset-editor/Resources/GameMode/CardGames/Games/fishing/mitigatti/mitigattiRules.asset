  data: {
    LLM: 'Game: Mitigatti (Gatti). Logic: See rules.objective and rules.gameplay.',
    Player: "Mitigatti (also known as Gatti) is a traditional Italian trick-taking game played with a Tarot deck (Tarocchi). Popular in the Piedmont and Liguria regions, it is a complex game involving 78 cards, including 21 trumps and the Joker-like 'Matto'. It features a unique 'Bargaining' phase where players can negotiate to end a hand early based on their card strength, and scoring is based on both captured tricks and specific card combinations (declarations).",
    objective: 'Score the most points through tricks, declarations, and ending-bonuses.',
    gameplay: "Must follow suit. If you can't, you MUST trump. The 'Matto' (Fool) can be played at any time and cannot win a trick, but stays with the player who played it.",
    keyRules: [
      'Must follow suit; if void in led suit, must trump.',
      'The Matto (Fool) may be played at any time and does not win the trick; it remains with the player who played it.',
      'Scoring is based on captured tricks and declaration combinations (declarations).',
      'Bargaining (andare a monte) allows players to negotiate to end a hand early based on card strength.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
