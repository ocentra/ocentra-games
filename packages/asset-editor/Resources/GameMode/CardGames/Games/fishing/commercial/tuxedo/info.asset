        tabLabel: 'About',
        pages: [
          {
            title: 'Tuxedo',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Tuxedo is a card-capturing game invented by George Parker, played with a 56-card Rook deck (no Rook card). 4 cards per player + 4 face-up in the 'pond'. Capture by matching number or matching sums. Sweeps (clearing the pond) score bonus. 'Orange' call bonus for capturing red+yellow together. First to 100 wins.",
              },
              {
                type: 'paragraph',
                text: 'Tuxedo is an American Casino variant often attributed to George Parker (Parker Brothers). It is played by 2 to 6 players using a Rook deck, with mechanics matching American or Royal Casino and distinct scoring: most cards, orange captures (red and yellow together), sweeps, and fives; first to 100 wins. The HOYLE Card Games collection includes a Tuxedo program.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '56-card Rook deck (no Rook card). 4 colors, values 1-14.',
              },
              {
                type: 'paragraph',
                text: 'Rook cards',
              },
              {
                type: 'paragraph',
                text: '4 each + 4 face-up (pond). Redeal 4 when hands empty.',
              },
            ],
          },
        ],
      },
