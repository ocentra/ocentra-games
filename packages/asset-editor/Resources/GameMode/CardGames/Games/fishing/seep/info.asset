    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Seep',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Seep is a four-player partnership fishing game played in the Punjab and other parts of India and Pakistan. Players capture cards from a layout; building piles called houses and scoring for sweeps. Related to Casino and Royal Casino.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: India, Pakistan (Punjab).\nTime Period: Traditional; 30-point version is possibly older and very popular in the Punjab.\nHistorical Development: Fishing game related to Casino and Royal Casino; northern India version has 100-point total; Punjab version 30 points.\nCultural Significance: Popular partnership game in Punjab (India and Pakistan).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in fixed partnerships (partners opposite). Deal and play counter-clockwise. Two-player variant exists.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack, no jokers. English pattern.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck, score sheet (optional), table space.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives 4 cards to player on right and 4 face down on table. That player bids (9–13) and plays one card from the four; dealer then deals the rest in groups of four counter-clockwise. Bidder ends with 11 cards, others 12.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Two-Player Game: Four hands dealt; two to players, two face down. Play 12 cards each; remaining loose cards stay. Each player picks up one face-down hand and play continues. Transition is vulnerable to sweeps.',
                  },
                  {
                    text: 'Limited Houses: Only two houses allowed on the floor at once. Creating a third is illegal; player must throw or pick up.',
                  },
                  {
                    text: 'Scoring variation: 10♦ worth 2 instead of 6; 4 points for majority of cards (more than 26); total still 100. Some allow breaking a house with a floor card plus hand card to cement.',
                  },
                  {
                    text: '30-point Seep: Punjab version: 10♦=12, 9♠=9, 2♠=1, each ace=1; 4 for majority of cards (total 30). Sweep worth capture value of card played. Deal restarted if table has 10♦ or 9♠. Satthi (all 30 in one deal) = 60 points.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
