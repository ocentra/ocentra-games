    historyContent: {
      origins: "Originates from the Goshogawara and Tsugaru regions of Aomori. It belongs to the 'Etori' (picture-taking) family of Japanese trick-taking games, which were influenced by 18th-century Western card games via Nagasaki.",
      originCountries: [
        'Japan',
      ],
      timeline: [
        "Mid-20th Century: Regional tournaments in Aomori standardize the 'Gonin-Kan' (5-person Kan) rules.",
        '1980s: Recognized as a unique regional cultural activity in Northern Japan.',
        "Present: Actively played in community centers and regional clubs; specialized 'Kan' decks are sometimes used.",
      ],
      evolution: "The game evolved from simpler 'Etori' variants into a highly competitive partnership game where the Joker serves as a master trump but with restricted play across tricks.",
      cultural: "In Aomori, Kani is more than a game; it is a social bond, with the 'Kankei' (Related) and 'Mukankei' (Unrelated) roles mirroring community hierarchies.",
    },
