  data: {
    hero: {
      title: 'KANI',
      subtitle: 'Five Players, Two Secrets',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kani (Gonin-Kan)',
            subtitle: 'Five Players, Two Secrets',
            content: [
              {
                type: 'paragraph',
                text: "Kani (also known as Gonin-Kan or Etori) is a sophisticated partnership trick-taking game popular in Aomori Prefecture, Japan. Played by 5 or 6 players, it uses a 50-card deck and features a hidden partnership system where the holder of the Joker and the Ace of trumps work together (the 'Kankei') against the other three players (the 'Mukankei'). It is known for its intense card-counting and localized tournament culture.",
              },
              {
                type: 'paragraph',
                text: "Originates from the Goshogawara and Tsugaru regions of Aomori. It belongs to the 'Etori' (picture-taking) family of Japanese trick-taking games, which were influenced by 18th-century Western card games via Nagasaki.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '5 active players. (In 6-player games, the dealer sits out).',
              },
              {
                type: 'paragraph',
                text: '50 cards (A, K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2, but remove 2H, 2D, 2C) + 1 Joker.',
              },
              {
                type: 'paragraph',
                text: 'Standard cards, score sheet, chips for scoring.',
              },
              {
                type: 'paragraph',
                text: 'Counter-clockwise. Each player receives 10 cards. Trumps (Yaku) rotate: Clubs -> Diamonds -> Hearts -> Spades.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Gonin-Kan: The standard 5-player version.',
                  },
                  {
                    text: 'Yonin-Kan: 4-player variant with a smaller deck.',
                  },
                  {
                    text: 'Shippo-Jo: An informal variant allowing a restart if 4 Aces and the Joker are held by one team.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Kani (also known as Gonin-Kan or Etori) is a sophisticated partnership trick-taking game popular in Aomori Prefecture, Japan. Played by 5 or 6 players, it uses a 50-card deck and features a hidden partnership system where the holder of the Joker and the Ace of trumps work together (the 'Kankei') against the other three players (the 'Mukankei'). It is known for its intense card-counting and localized tournament culture.",
