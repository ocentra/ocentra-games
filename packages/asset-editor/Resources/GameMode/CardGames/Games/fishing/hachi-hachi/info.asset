    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Hachi-Hachi (八八)',
            subtitle: 'Classic Japanese Hanafuda',
            content: [
              {
                type: 'paragraph',
                text: "Hachi-Hachi (八八, '88') is the most representative Japanese Hanafuda fishing game. The name refers to the par score of 88 points (one-third of the 264 total points in the deck). Played by 3-6 players with a bidding phase to determine the three active players each round. Features complex scoring with teyaku (initial hand combinations) and deki-yaku (combinations formed during play). Players can stop early if they form valuable combinations.",
              },
              {
                type: 'paragraph',
                text: 'Traditional Japanese game using Hanafuda (flower cards), which originated in the 18th century. Hachi-Hachi is considered the most representative Hanafuda fishing game.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-6 players. Only 3 play actively each round; others sit out after bidding.',
              },
              {
                type: 'paragraph',
                text: '48-card Hanafuda deck (12 suits/months, 4 cards each).',
              },
              {
                type: 'paragraph',
                text: "Two denominations of chips: 'Kan' and 'Mon' (1 Kan = 12 Mon typically).",
              },
              {
                type: 'paragraph',
                text: "Deal cards to the 3 active players. Place cards face-up in the center (the 'field').",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Regional Yaku Variations: Regional variations in yaku values and rules.',
                  },
                  {
                    text: '2-Player and 7-Player Adaptations: Adapted versions for 2 or 7 players.',
                  },
                  {
                    text: 'Different Chip Denominations: Some play with different chip denominations or scoring systems.',
                  },
                ],
              },
            ],
          },
