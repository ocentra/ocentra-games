    hero: {
      title: 'DILOTI',
      subtitle: 'Greek Declaration Capture',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Diloti',
            subtitle: 'Greek Declaration Capture',
            content: [
              {
                type: 'paragraph',
                text: "Diloti (Î”Î·Î»Ï‰Ï„Î®, from the verb Î´Î·Î»ÏŽÎ½Ï‰ meaning 'to declare') is the most popular and complex Greek fishing game. It combines mechanics from Kontsina and Xeri with a 'declaration' (build) system inspired by Casino. Players capture cards by matching or summing values, protected by declarations that define specific capture sets.",
              },
              {
                type: 'paragraph',
                text: 'Diloti originated in Greece and is a cornerstone of Greek coffee-shop (kafeneio) gaming culture. It evolved by merging older fishing games (Kontsina) with matching bonuses (Xeri) and strategic declarations.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players or 4 in fixed partnerships.',
              },
              {
                type: 'paragraph',
                text: '52 cards. Aces rank as 1 for sums, but otherwise have high point value.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: "6 cards per player; 4 face-up on table. If 3 or 4 face cards of same value are on the table, it's a misdeal.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Long Game Target: Use 121 points instead of 61 as the game target.',
                  },
                  {
                    text: 'Forced Capture: If a played card can capture, the play must include a legal capture rather than laying.',
                  },
                  {
                    text: 'Three Face Cards Keep: When initial table cards include exactly three equal face cards, keep deal and allow capture by the fourth matching face card.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
