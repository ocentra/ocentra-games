    historyContent: {
      origins: 'Diloti originated in Greece and is a cornerstone of Greek coffee-shop (kafeneio) gaming culture. It evolved by merging older fishing games (Kontsina) with matching bonuses (Xeri) and strategic declarations.',
      originCountries: [
        'Greece',
        'Cyprus',
      ],
      timeline: [
        'Early 20th Century: Developed as a competitive alternative to simpler fishing games.',
        '1950s-Present: Established as a major social game across Greece and Cyprus.',
        'Modern Era: Widely played online and in tournaments.',
      ],
      evolution: "The game's name identifies the 'declaration' phase as its unique selling point, separating it from the purely reactive nature of older fishing games.",
      cultural: 'In Greece, Diloti is considered a game of high skill and memory, often compared to bridge in terms of the partnership awareness required.',
    },
    setupContent: {
      players: '2 players or 4 in fixed partnerships.',
      deck: '52 cards. Aces rank as 1 for sums, but otherwise have high point value.',
