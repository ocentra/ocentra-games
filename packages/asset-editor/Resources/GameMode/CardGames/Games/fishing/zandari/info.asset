        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Žandari',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Žandari (Pishpirik) is a Serbian/Balkan fishing card game. 2-4 players. 52-card deck. 4 face-up table + hand cards. Capture by matching rank or summing to played card value. Jack clears entire table. Score: most cards=2pts, most clubs=1pt, 2♣=1pt, 10♦=1pt. First to 11.',
              },
              {
                type: 'paragraph',
                text: 'Žandari is a fishing game played in Bosnia and Herzegovina. The name Žandari is also used for the Jack, which can capture all the cards from the table. The name is thought to derive from the French or Italian word gendarme (policeman). This page is based on information from Veselko Kelava.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '52 cards. A=1, 2-10=face. K/Q have no capture value.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: '4 face-up center. Hand cards dealt. Jacks in initial 4 go to cutter.',
              },
            ],
          },
        ],
      },
