    historyContent: {
      origins: 'Gharat was documented in Iran as a fishing game whose name means loot, reflecting rank-match theft from visible pile tops.',
      originCountries: [
        'Iran',
      ],
      timeline: [
        'Traditional era: Played as a local Iranian rank-matching capture game.',
        'Modern era: Documented in international rule collections and English-language card-game references.',
      ],
      evolution: 'Core rules remained stable; some tables add a pair-play convenience variant.',
      cultural: 'The game emphasizes hidden stack memory and tactical stealing from opponents.',
    },
