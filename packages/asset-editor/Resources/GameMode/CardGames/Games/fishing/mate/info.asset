    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mate',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mate is a traditional Italian fishing card game played with a 40-card Italian deck. Players capture cards from a central layout by matching values, with special scoring for capturing the 'Mate' cards (Kings). It is a game of memory and timing, where players must remember which cards have been played to maximize their captures.",
              },
              {
                type: 'paragraph',
                text: 'Originating in Italy, Mate belongs to the family of fishing games popular throughout the Mediterranean. It shares mechanics with Scopa and other Italian card games.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 players (best with 2).',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck (remove 8s, 9s, 10s from standard deck). Suits: Coins, Cups, Swords, Clubs. Ranking: King (highest), Queen, Jack, 7, 6, 5, 4, 3, 2, Ace (lowest).',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck or modified standard deck.',
              },
              {
                type: 'paragraph',
                text: '4 cards to each player and 4 cards face-up to the table. Remaining cards form the stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Mate with Combinations: Allow capturing multiple cards that sum to the played card's value.",
                  },
                  {
                    text: 'Team Mate: 4 players in partnerships, combining captured cards with partner.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
