    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Porrazo',
            subtitle: 'Fishing Game',
            content: [
              {
                type: 'paragraph',
                text: "Porrazo (Parosso, Parear) is a fishing game from Mexico/Southwest USA. Play a card; if it matches a table card, capture it and any cards in ascending sequence. Matching the previous player's card = porrazo (bonus). First to 61 wins.",
              },
              {
                type: 'paragraph',
                text: "Introduced from Mexico to Southwest USA end of 19th century. First reference: Philip Firmin 'Contra Parazzo' (San Francisco Argonaut 1900). C. D. Willard rules (1901). Table Talk (1903), In and Out Door Card Games (1904). USPCC Parosso/Parear 1909-1924.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-8. Best 2; 4 can play partnership (opposite).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards. A (low) to K (high). Suits irrelevant.',
              },
              {
                type: 'paragraph',
                text: '52 cards, cribbage board or paper for score.',
              },
              {
                type: 'paragraph',
                text: '3 cards each, then play. Repeat until deck exhausted. Once per dealer turn: deal tendido (4 face-up) after a 3-card deal.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Cards in Excess of 26: 2p/2 teams: card score = excess over 26 (half normal).',
                  },
                  {
                    text: 'No Ace Above King: USPCC: sequences end at K; A always low.',
                  },
                  {
                    text: 'No Ronda Declaration: Claim ronda/rondine after play; no pre-announce.',
                  },
                  {
                    text: 'Tendido Last: Tendido = last 4 of deck; dealer has no choice of when.',
                  },
                ],
              },
            ],
          },
        ],
      },
