    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mambassa',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mambassa is a lively Italian card game played on the coast of the Marche province. It is a four-card variant of Petrangola (also known as 31), where players aim to collect cards of high value in a single suit, with a maximum of 41 points. The game features a unique 'monte' (table cards) exchange mechanic and knocking system similar to Schwimmen.",
              },
              {
                type: 'paragraph',
                text: "Played on the coast of the Italian province of Marche. The name 'Mambassa' is of uncertain origin but the game is essentially a four-card version of Petrangola.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-8 players (optimal with 5-6). Each player starts with 4 tokens (vite/lives).',
              },
              {
                type: 'paragraph',
                text: '40-card Italian-suited Piacentine deck. Rank: Ace (11), King (10), Horse (10), Jack (10), 7, 6, 5, 4, 3, 2 (face value). No 8s, 9s, or 10s.',
              },
              {
                type: 'paragraph',
                text: '40-card Italian Piacentine deck; tokens (four per player, one agreed value).',
              },
              {
                type: 'paragraph',
                text: "4 cards face down to each player. Dealer looks at next 4 cards and either places them face up as the 'monte' or takes them as a hand (which counts as a knock).",
              },
            ],
          },
        ],
      },
