  data: {
    LLM: 'On turn, play one hand card to match month cards in the center layout and capture according to matching rules, then reveal the top stock card and resolve captures again. Special capture events and bonus transfers apply when specific board states occur. When your captures reach the minimum score, you may stop to end the hand and collect, or choose go to continue and increase potential payout while risking a loss to an opponent.',
    Player: 'On turn, play one hand card to match month cards in the center layout and capture according to matching rules, then reveal the top stock card and resolve captures again. Special capture events and bonus transfers apply when specific board states occur. When your captures reach the minimum score, you may stop to end the hand and collect, or choose go to continue and increase potential payout while risking a loss to an opponent.',
    objective: 'Reach a valid scoring state through captures, then decide to stop for payout or continue by declaring go.',
    gameplay: 'On turn, play one hand card to match month cards in the center layout and capture according to matching rules, then reveal the top stock card and resolve captures again. Special capture events and bonus transfers apply when specific board states occur. When your captures reach the minimum score, you may stop to end the hand and collect, or choose go to continue and increase potential payout while risking a loss to an opponent.',
    keyRules: [
      'Cards match by month (flower), not by conventional suit and rank.',
      'Each turn resolves both a hand play and a stock reveal, with captures after each step.',
      "Go-stop choice is only available after reaching the table's minimum scoring threshold.",
      'Exact bonus and penalty multipliers (including jokers and bombs) must be agreed before play.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
