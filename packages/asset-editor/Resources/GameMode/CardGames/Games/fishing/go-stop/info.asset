    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Go Stop',
            subtitle: 'The Korean Holiday Classic',
            content: [
              {
                type: 'paragraph',
                text: 'Go Stop is a Korean flower-card fishing game in which players capture matching month cards, build scoring combinations, and choose whether to stop for payout or go on for higher risk and reward.',
              },
              {
                type: 'paragraph',
                text: 'Go Stop developed in Korea from Japanese flower-card traditions and became the best-known Korean hwatu fishing game.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 or 3 active players; larger groups may rotate players between hands.',
              },
              {
                type: 'paragraph',
                text: '48 hwatu cards (12 months x 4 cards), with optional jokers depending on table rules.',
              },
              {
                type: 'paragraph',
                text: 'Score sheet or chips for multi-hand accounting.',
              },
              {
                type: 'paragraph',
                text: 'Two-player game: 10 cards each and 8 to table. Three-player game: 7 cards each and 6 to table. Remaining cards form stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Matgo (Two-Player): Two-player rules use different deal size and commonly higher stop threshold than three-player play.',
                  },
                  {
                    text: 'No-Joker Table: Play with the base 48-card deck and no joker cards or joker-specific bonuses.',
                  },
                ],
              },
            ],
          },
        ],
      },
