          hasPlaceholders: false,
        },
        rules: {
          objective: 'Reach a valid scoring state through captures, then decide to stop for payout or continue by declaring go.',
          gameplay: 'On turn, play one hand card to match month cards in the center layout and capture according to matching rules, then reveal the top stock card and resolve captures again. Special capture events and bonus transfers apply when specific board states occur. When your captures reach the minimum score, you may stop to end the hand and collect, or choose go to continue and increase potential payout while risking a loss to an opponent.',
          keyRules: [
            'Cards match by month (flower), not by conventional suit and rank.',
            'Each turn resolves both a hand play and a stock reveal, with captures after each step.',
            "Go-stop choice is only available after reaching the table's minimum scoring threshold.",
            'Exact bonus and penalty multipliers (including jokers and bombs) must be agreed before play.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Prioritize the 'Godori' (3 Birds) and 'Gwang' cards. They offer the fastest points.",
          intermediate: "Go/Stop Calculus: If you have 3 points but your opponent is close to a 'Godori', STOP. Don't risk a 'Go' unless your hand is overwhelming.",
          advanced: "Defensive Discarding: If you have a 'Gwang' in hand but there is no match on the table, holding it prevents opponents from getting the 5 Gwang bonus. However, you risk getting stuck with it if the game ends.",
          tips: [
            'Always capture the bonus Jokers immediately if possible.',
            "In 3-player games, don't let the leader 'Go' too many times; sometimes you must win with a small score just to stop them.",
          ],
          hasPlaceholders: false,
        },
