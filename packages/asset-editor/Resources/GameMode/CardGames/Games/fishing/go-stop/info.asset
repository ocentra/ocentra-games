    historyContent: {
      origins: 'Go Stop developed in Korea from Japanese flower-card traditions and became the best-known Korean hwatu fishing game.',
      originCountries: [
        'Korea',
      ],
      timeline: [
        'Late 19th Century: Hanafuda cards introduced to Korea.',
        '1950s: Plastic Hwatu cards mass-produced, replacing paper ones.',
        "1980s: Go-Stop rules normalized, distinct from Japanese rules (e.g., introduction of 'Jokers' and 'Bomb' rules).",
        'Present: Played universally during Chuseok (Korean Thanksgiving) and Lunar New Year.',
      ],
      evolution: 'Modern Korean tables added local bonuses and optional jokers while preserving month-matching capture play.',
      cultural: 'It is widely played during Korean holidays and social gatherings, often in multi-hand sessions.',
    },
    setupContent: {
      players: '2 or 3 active players; larger groups may rotate players between hands.',
      deck: '48 hwatu cards (12 months x 4 cards), with optional jokers depending on table rules.',
      equipment: 'Score sheet or chips for multi-hand accounting.',
      dealing: 'Two-player game: 10 cards each and 8 to table. Three-player game: 7 cards each and 6 to table. Remaining cards form stock.',
    },
