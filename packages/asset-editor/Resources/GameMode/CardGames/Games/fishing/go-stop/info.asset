    aiContent: {
      difficulty: {
        easy: "Matches cards greedily; random 'Go' decisions.",
        medium: 'Prioritizes Godori/Gwang captures; Stops if opponent has high potential score.',
        hard: "Calculates probability of drawing specific months from stock; tracks 'Gobak' risk; executes Bombs strategically to steal initiative.",
      },
      considerations: [
        'AI must evaluate go-versus-stop expected value under hidden stock uncertainty.',
        'Month-composition tracking and opponent capture inference are core to strong play.',
      ],
    },
