  data: {
    LLM: 'Game: Matgo (Korean Go-Stop). Logic: See rules.objective and rules.gameplay.',
    Player: "Matgo is the quintessential two-player variant of 'Go-Stop', a popular Korean fishing game played with Hwatu ('Flower Cards'). Using a 48-card deck where each group of four represents a month/flower, players attempt to capture cards to form scoring combinations (Yaku). The name 'Matgo' distinguishes the 2-player competitive style from the 3-player 'Go-Stop'. It is arguably the most popular mobile and online game in South Korea.",
    objective: "Score 7 or more points to 'Go' (continue for more points) or 'Stop' (end and win).",
    gameplay: "1. Match a card from your hand with a card on the table of the same month.\n2. Flip the top card of the deck; if it matches a table card, take that pair too.\n3. **The Kiss**: If you match your hand card AND the deck flip matches the same pair, it's a 'Kiss' (Sseok), and you take all three.",
    keyRules: [
      'Cards match by month (flower); capture matching cards to your area.',
      'Each turn: flip top card of stock to table, then play one card from hand; resolve captures after each step.',
      'Reach agreed target (usually 5 or 7 points) then declare Stop to win the hand or Go to continue for higher score at risk of opponent winning.',
      'Scoring from captured combinations: brights (kwang), animals (yul), ribbons (tti), junk (pi); special events (bomb, shake) apply.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Matgo is played by exactly two players: one dealer (seon) and one opponent. Play proceeds counterclockwise from the dealer. The two-player variant uses a higher point target (typically seven) than three-player Go-Stop (typically three).',
      deck: '48 cards: 12 months, 4 cards each. Themes: Pine (Jan), Plum (Feb), Cherry (Mar)... Paulownia (Dec).',
