    historyContent: {
      origins: "Likely brought to the Indonesian archipelago by Portuguese or Dutch traders, the game evolved into its modern 'Red focus' in the 20th century.",
      originCountries: [
        'Indonesia',
      ],
      timeline: [
        '1900s: Fishing games are popular across the Dutch East Indies.',
        '1970s: Main Merah becomes a staple of social gatherings in Java and Sumatra.',
        "Present: Remains a common pastime, especially in rural areas where it's played for small wagers or bragging rights.",
      ],
      evolution: 'The point system was simplified to focus on red cards to make scoring faster and more visually intuitive.',
      cultural: 'The name reflects the Indonesian obsession with the number 10 and the color red (symbolizing luck and bravery).',
    },
