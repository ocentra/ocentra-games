    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Main Merah',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Main Merah (Indonesian for 'Playing Red') is a traditional fishing card game popular in Indonesia. It is a variant of the broader 'Fishing' family (like Scopa or Kou-Shuu) but with a specific focus on color. In this game, only the RED cards (Hearts and Diamonds) have point value, leading to a unique secondary economy where players prioritize capturing red cards while using black cards as purely functional tools.",
              },
              {
                type: 'paragraph',
                text: "Likely brought to the Indonesian archipelago by Portuguese or Dutch traders, the game evolved into its modern 'Red focus' in the 20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players (10 cards each) or 3 players (7 cards each).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: '2 players: 10 cards each; 3 players: 7 cards each.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Two players: 10 cards each, 12 on table, 20 in draw pile. Standard setup.',
                  },
                  {
                    text: 'Three players: 7 cards each, 10 on table, 21 in draw pile. First deal: dealer plays first; subsequently player with worst score in previous deal plays first.',
                  },
                  {
                    text: 'Table sweep bonus: In many Indonesian house rules, clearing the table entirely (taking the last cards) grants a point bonus.',
                  },
                ],
              },
            ],
          },
        ],
      },
