  data: {
    LLM: 'Game: Hanafuda (花札). Logic: See rules.objective and rules.gameplay.',
    Player: "Hanafuda (花札, 'flower cards') are traditional Japanese playing cards comprising a 48-card deck divided into 12 suits, each representing a month and featuring a specific flower or plant. Hanafuda is not a single game but a family of games, most commonly fishing/capture games where players match cards from their hand with cards on the field. Popular games include Koi-Koi, Hachi-Hachi, and Hana-Awase. Cards are categorized as Brights, Animals, Ribbons, and Plains, with varying point values.",
    objective: 'Varies by game; in fishing games capture matching cards; in Koi-Koi form yaku and decide to continue or stop for points.',
    gameplay: 'Varies by game. In fishing games players match hand cards with table cards to capture. In Koi-Koi players form point combinations (yaku) and choose to continue or stop.',
    keyRules: [
      'Hanafuda is a family of games; each variant has its own rules.',
      '48 cards in 12 suits (months), 4 cards per suit.',
      'Card types: Brights, Animals, Ribbons, Plains.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2 to 6 players depending on the specific Hanafuda game (e.g. Koi-Koi typically 2).',
      deck: '48 cards divided into 12 suits (months):\n- January (Pine), February (Plum), March (Cherry), April (Wisteria), May (Iris), June (Peony), July (Bush Clover), August (Pampas Grass), September (Chrysanthemum), October (Maple), November (Willow), December (Paulownia).\n\nEach suit has 4 cards, categorized as:\n- **Brights** (20 points): Special high-value cards.\n- **Animals** (10 points): Cards featuring animals.\n- **Ribbons** (5 points): Cards with ribbons or poetry.\n- **Plains/Chaff** (1 point): Simple flower cards.',
      equipment: 'Hanafuda deck (48 cards).',
      dealing: 'Varies by game; typically dealer distributes cards to hands and table.',
    },
    turnFlow: 'Varies by game. In fishing games players match hand cards with table cards to capture. In Koi-Koi players form point combinations (yaku) and choose to continue or stop.',
