    historyContent: {
      origins: 'Hanafuda cards originated in 18th-century Japan, evolving from Portuguese playing cards. The Japanese government banned Western-style cards, leading to the development of Hanafuda as a workaround.',
      originCountries: [
        'Japan',
      ],
      timeline: [
        '16th Century: Portuguese traders introduce playing cards to Japan.',
        '18th Century: Hanafuda cards developed to circumvent gambling bans.',
        '19th Century: Hanafuda becomes widespread in Japan.',
        '1889: Nintendo founded as a Hanafuda card manufacturer.',
        'Present: Hanafuda remains popular in Japan, Korea (Hwatu), and Hawaii.',
      ],
      evolution: 'Hanafuda evolved from Portuguese cards, with Japanese artisans replacing Western suits with seasonal flowers and plants. The 12-suit structure represents the 12 months of the year.',
      cultural: 'Hanafuda is deeply embedded in Japanese culture, associated with traditional festivals and family gatherings. Nintendo, now a video game giant, started as a Hanafuda card company.',
    },
