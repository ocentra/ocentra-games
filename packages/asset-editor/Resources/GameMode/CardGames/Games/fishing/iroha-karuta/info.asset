    historyContent: {
      origins: 'Originates from 18th-century Japan. Hanafuda cards were developed as a way to circumvent government bans on Western-style gambling cards, using floral imagery instead of numbers.',
      originCountries: [
        'Japan',
      ],
      timeline: [
        '1889: Nintendo is founded specifically to produce Hanafuda cards.',
        'Early 20th Century: Koi-Koi emerges as the competitive standard for two-player Hanafuda.',
        "1980s-Present: Featured prominently in Japanese pop culture (e.g., the film 'Summer Wars').",
        'Modern: Standardized as a competitive mind sport with national rankings in Japan.',
      ],
      evolution: "The game's signature 'Koi-Koi' doubling mechanic was a later addition designed to increase the psychological pressure and high-stakes nature of the game.",
      cultural: "Koi-Koi is deeply tied to Japanese aesthetics, with yaku names like 'Tsukimi-zake' (Moon Viewing Sake) and 'Hanami-zake' (Flower Viewing Sake).",
    },
    setupContent: {
      players: 'Players listen to reading cards and race to capture matching picture cards according to karuta rules.',
      deck: '48 cards. Suits by month: January (Pine), February (Plum), March (Cherry)... to December (Paulownia). Each suit has 4 cards of varying value (Bright, Animal, Ribbon, Chaff).',
      equipment: '48 cards. Suits by month: January (Pine), February (Plum), March (Cherry)... to December (Paulownia). Each suit has 4 cards of varying value (Bright, Animal, Ribbon, Chaff).',
      dealing: "Each player is dealt 8 cards face-down; 8 cards are placed face-up in the 'field' (ba). The rest form the draw pile.",
