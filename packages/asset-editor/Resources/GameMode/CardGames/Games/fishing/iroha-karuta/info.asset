    routePath: 'iroha-karuta',
    LLM: 'Game: Koi-Koi. Logic: See rules.objective and rules.gameplay.',
    Player: "Koi-Koi is the most popular card game played with traditional Japanese 'Hanafuda' (Flower Cards). Played between two people, it is a fishing (capture) game where players aim to form specific combinations of cards called 'Yaku'. The name 'Koi-Koi' refers to the strategic choice a player makes after forming a Yaku: either to end the round and take their points, or to call 'Koi-Koi' (Come On!) to continue play in hopes of a higher score at the risk of losing it all.",
    tagline: "Koi-Koi is the most popular card game played with traditional Japanese 'Hanafuda...",
    gameCategory: 'Fishing',
    subcategory: 'Capture / Matching',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-45 minutes',
    origin: 'Japan',
    originName: 'Iroha Karuta',
    deck: '96-card Iroha Karuta deck',
