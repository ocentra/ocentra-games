    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Iroha Karuta',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Iroha Karuta is a traditional Japanese matching and proverb-capture game using paired reading and picture cards in the karuta tradition.',
              },
              {
                type: 'paragraph',
                text: 'Originates from 18th-century Japan. Hanafuda cards were developed as a way to circumvent government bans on Western-style gambling cards, using floral imagery instead of numbers.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Players listen to reading cards and race to capture matching picture cards according to karuta rules.',
              },
              {
                type: 'paragraph',
                text: '48 cards. Suits by month: January (Pine), February (Plum), March (Cherry)... to December (Paulownia). Each suit has 4 cards of varying value (Bright, Animal, Ribbon, Chaff).',
              },
              {
                type: 'paragraph',
                text: '48 cards. Suits by month: January (Pine), February (Plum), March (Cherry)... to December (Paulownia). Each suit has 4 cards of varying value (Bright, Animal, Ribbon, Chaff).',
              },
              {
                type: 'paragraph',
                text: "Each player is dealt 8 cards face-down; 8 cards are placed face-up in the 'field' (ba). The rest form the draw pile.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: '6 rounds: Play 6 hands instead of 12; players may agree before the game.',
                  },
                  {
                    text: 'Koi-Koi once per hand: Player may call Koi-Koi only once per hand (not on every yaku-forming turn).',
                  },
                  {
                    text: 'Tsukimi-zake and Hanami-zake optional: Some rulesets omit the Moon Viewing and Flower Viewing yaku.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Iroha Karuta is a traditional Japanese matching and proverb-capture game using paired reading and picture cards in the karuta tradition.',
