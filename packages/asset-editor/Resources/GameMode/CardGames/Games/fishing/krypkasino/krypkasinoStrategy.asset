    tips: [
      {
        title: 'Tip',
        description: "The 'Tabbe' (Table Clearing) is your best friend. Even if you take a few cards, a Tabbe removes 1 penalty point from your total.",
      },
      {
        title: 'Tip',
        description: "Watch the Spades. Since capturing the 'Most Spades' is a penalty, try to feed your Spades to your opponents by building sums they likely have.",
