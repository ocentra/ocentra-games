        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Krypkasino',
            subtitle: 'Swedish Avoidance Casino',
            content: [
              {
                type: 'paragraph',
                text: "Krypkasino (Swedish for 'Crawl Casino') is the popular misere (avoidance) variant of the card game Casino, widely played in Sweden. Unlike standard Casino where the goal is to capture high-point cards, in Krypkasino, players aim to avoid capturing any cards, especially those with point values. It is a game of avoidance, forced capture, and tactical hand-dumping.",
              },
              {
                type: 'paragraph',
                text: "Developed in Sweden in the late 19th century as a 'reverse' adaptation of the international fishing game Casino. Misere variants are a characteristic feature of Swedish card culture (e.g., Krypkille).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players individually.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. **Special Capture Values**: 10 of Diamonds = 16, 2 of Spades = 15, Aces = 14 or 1.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. **Special Capture Values**: 10 of Diamonds = 16, 2 of Spades = 15, Aces = 14 or 1.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 4 cards; 4 cards are placed face-up on the table. The rest form a draw pile.',
              },
            ],
          },
          {
            title: 'Variations',
