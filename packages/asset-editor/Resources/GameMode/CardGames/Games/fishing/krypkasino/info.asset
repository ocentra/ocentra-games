    historyContent: {
      origins: "Developed in Sweden in the late 19th century as a 'reverse' adaptation of the international fishing game Casino. Misere variants are a characteristic feature of Swedish card culture (e.g., Krypkille).",
      originCountries: [
        'Sweden',
      ],
      timeline: [
        '1890s: Reverse Casino games appear in Swedish social circles.',
        "1930s: 'Krypkasino' becomes the dominant name for the Swedish avoidance variant.",
        'Present: A staple family game in Sweden, often played with children to teach number values through a reverse-incentive system.',
      ],
      evolution: "The game evolved to include the 'In-Hand Casino' rule (specific to Swedish Kasino), where 10D and 2S have modified capture values (16 and 15).",
      cultural: "In Sweden, Krypkasino is often viewed as more 'fair' than standard Casino because it rewards careful play even with a weak hand.",
    },
