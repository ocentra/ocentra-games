    tips: [
      {
        title: 'Tip',
        description: '7+ clubs is a large swing (7 points), so avoid donating clubs to tableau unless it creates a high-value capture.',
      },
      {
        title: 'Tip',
        description: 'When multiple captures are possible, choose the line that removes opponent sur threats and secures scoring cards.',
