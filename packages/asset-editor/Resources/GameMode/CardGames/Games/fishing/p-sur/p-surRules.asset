    gameId: 'p-sur',
    icon: '🃏',
  },
  data: {
    LLM: "Players act anticlockwise, playing one card from hand to the tableau. A played card either captures cards (played card plus captured cards move to that player's capture pile) or remains on tableau if no legal capture is taken. Face cards capture by rank (Q takes Q, K takes K). Number cards A-10 capture any chosen set of tableau cards summing with the played card to 11. Jacks capture all tableau cards except kings and queens. At end of final deal, remaining tableau cards go to the last player who made a capture.",
    Player: "Players act anticlockwise, playing one card from hand to the tableau. A played card either captures cards (played card plus captured cards move to that player's capture pile) or remains on tableau if no legal capture is taken. Face cards capture by rank (Q takes Q, K takes K). Number cards A-10 capture any chosen set of tableau cards summing with the played card to 11. Jacks capture all tableau cards except kings and queens. At end of final deal, remaining tableau cards go to the last player who made a capture.",
    objective: 'Be the first player or team to reach at least 62 cumulative points.',
    gameplay: "Players act anticlockwise, playing one card from hand to the tableau. A played card either captures cards (played card plus captured cards move to that player's capture pile) or remains on tableau if no legal capture is taken. Face cards capture by rank (Q takes Q, K takes K). Number cards A-10 capture any chosen set of tableau cards summing with the played card to 11. Jacks capture all tableau cards except kings and queens. At end of final deal, remaining tableau cards go to the last player who made a capture.",
    keyRules: [
      'If your played card can capture, you must take one legal capture set; if multiple sets are legal, you choose one.',
      'A sur is scored by clearing the tableau with a non-jack capture, except where sur restrictions apply.',
      'Playing a jack never scores a sur, even if it clears the tableau.',
      'No sur can be scored in the final deal after the last cards are dealt.',
      'A side at 50 or more points cannot score a new sur or cancel an opponent sur.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2 to 4 players. Two-player is standard; 4-player partnership is common with partners opposite.',
      deck: 'Single standard 52-card deck without jokers.',
      equipment: 'Cards and a visible running score.',
      dealing: 'Deal anticlockwise in packets of 4: four to each player face down, then four face up to the tableau. If tableau starts with more than one jack, more than two queens, or more than two kings, redeal. If exactly one jack appears in tableau, bury it and replace from stock. After all players play their 4 cards, deal 4 more to each player; no new tableau cards are added. Continue until deck is exhausted.',
    },
    turnFlow: "Players act anticlockwise, playing one card from hand to the tableau. A played card either captures cards (played card plus captured cards move to that player's capture pile) or remains on tableau if no legal capture is taken. Face cards capture by rank (Q takes Q, K takes K). Number cards A-10 capture any chosen set of tableau cards summing with the played card to 11. Jacks capture all tableau cards except kings and queens. At end of final deal, remaining tableau cards go to the last player who made a capture.",
    moveValidityConditions: {
      ante: 'This game has no ante or betting.',
      deal: 'Dealer action at start and whenever all players have exhausted current four-card batch while stock remains.',
      reveal_market: 'Performed only on first deal of the round to place four cards face up on table.',
      buy_market: 'This game has no market purchase.',
      buy_stock: 'This game has no buying from stock.',
      fold: 'This game has no fold action.',
      check: 'This game has no check or betting.',
      call: 'This game has no call or betting.',
      bet: 'This game has no bet action.',
      raise: 'This game has no raise or betting.',
      declare: 'This game has no declare phase.',
      reveal_hand: 'Hands are not revealed in this phase.',
      award_pot: 'After all cards are played and leftover tableau cards are awarded to last capturer.',
      play_card: 'Current player must play exactly one card each turn. If played card can capture, one legal capture must be taken.',
      draw: 'This game has no draw-from-stock action.',
      discard: 'This game has no discard pile.',
      pass: 'This game has no pass action.',
      bid: 'This game has no bid action.',
      meld: 'This game has no meld action.',
      go_out: 'This game has no go-out action.',
    },
    exampleHands: [
      'Setup example: 4 card(s) per player.',
      'Rule example: Be the first player or team to reach at least 62 cumulative points.',
      "Turn-flow example: Players act anticlockwise, playing one card from hand to the tableau. A played card either captures cards (played card plus captured cards move to that player's capture pile) or remains on tableau if no legal capture is taken. Face cards capture by rank (Q takes Q, K takes K). Number cards A-10 capture any chosen set of tableau cards summing with the played card to 11. Jacks capture all tableau cards except kings and queens. At end of final deal, remaining tableau cards go to the last player who made a capture.",
      'Scoring example: At round end score captured cards and sur markers: 7 points for clubs majority (Haft Khaj), 1 each Ace, 1 each Jack, 2 for 2 of Clubs, 3 for 10 of Diamonds, and 5 per sur. First player or team with 62 or more cumulative points wins; if multiple reach 62+ simultaneously, highest score wins and ties continue..',
