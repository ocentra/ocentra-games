    aiContent: {
      difficulty: {
        easy: 'Prefers immediate captures and ignores long-term club majority and sur interactions.',
        medium: 'Prioritizes key-point cards and blocks obvious opponent sur opportunities.',
        hard: 'Evaluates capture sets by expected point swing, sur state, club majority race, and last-capture endgame control.',
      },
      considerations: [
        'Capture resolution supports multiple legal sum-to-11 subsets; AI must evaluate alternatives.',
        'Jack capture sweeps non-face tableau but never grants sur.',
        'Sur scoring is stateful and can cancel existing opponent sur markers.',
        'Three-player tie for most clubs gives the 7-point club bonus to the third player, not to tied leaders.',
      ],
