    historyContent: {
      origins: 'Pasur is one of the best-known Iranian card games and belongs to the fishing family. It is traditionally played with a standard 52-card deck and is known by several local names.',
      originCountries: [
        'Iran',
      ],
      timeline: [
        'Traditional era: Pasur develops as a popular social card game in Iran.',
        'Late 20th century: Regional naming conventions such as Chahar barg and Haft khaj remain in active use.',
        '21st century: Online rule references and web archives document standardized scoring and sur conventions.',
      ],
      evolution: 'Core capture logic stayed stable while table conventions vary on target score (61, 62, or 100) and sur restrictions.',
      cultural: "The game is a common household and cafe game in Iran; in modern colloquial use, 'pasur' can also refer broadly to card play.",
    },
    setupContent: {
      players: '2 to 4 players. Two-player is standard; 4-player partnership is common with partners opposite.',
      deck: 'Single standard 52-card deck without jokers.',
      equipment: 'Cards and a visible running score.',
      dealing: 'Deal anticlockwise in packets of 4: four to each player face down, then four face up to the tableau. If tableau starts with more than one jack, more than two queens, or more than two kings, redeal. If exactly one jack appears in tableau, bury it and replace from stock. After all players play their 4 cards, deal 4 more to each player; no new tableau cards are added. Continue until deck is exhausted.',
    },
