  data: {
    hero: {
      title: 'PASUR',
      subtitle: 'Iranian Fishing Classic',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pasur',
            subtitle: 'Iranian Fishing Classic',
            content: [
              {
                type: 'paragraph',
                text: 'Pasur is an Iranian fishing game where captures are made by exact rank pairing or by making sums of 11. Players score for aces, jacks, key cards, most clubs, and table-clearing surs, racing to 62 points.',
              },
              {
                type: 'paragraph',
                text: 'Pasur is one of the best-known Iranian card games and belongs to the fishing family. It is traditionally played with a standard 52-card deck and is known by several local names.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players. Two-player is standard; 4-player partnership is common with partners opposite.',
              },
              {
                type: 'paragraph',
                text: 'Single standard 52-card deck without jokers.',
              },
              {
                type: 'paragraph',
                text: 'Cards and a visible running score.',
              },
              {
                type: 'paragraph',
                text: 'Deal anticlockwise in packets of 4: four to each player face down, then four face up to the tableau. If tableau starts with more than one jack, more than two queens, or more than two kings, redeal. If exactly one jack appears in tableau, bury it and replace from stock. After all players play their 4 cards, deal 4 more to each player; no new tableau cards are added. Continue until deck is exhausted.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Alternative Target Score: Some tables play to 61 or 100 instead of 62.',
                  },
                  {
                    text: 'Lower Sur Threshold: Some tables disallow scoring sur after 40 points rather than 50.',
                  },
                  {
                    text: 'Last Deal Sur Cancel Allowed: Some groups allow clearing in last deal to cancel opponent sur even when not scoring your own.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Pasur is an Iranian fishing game where captures are made by exact rank pairing or by making sums of 11. Players score for aces, jacks, key cards, most clubs, and table-clearing surs, racing to 62 points.',
