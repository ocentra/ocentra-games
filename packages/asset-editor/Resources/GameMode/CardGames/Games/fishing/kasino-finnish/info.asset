        pages: [
          {
            title: 'Kasino (Finnish)',
            subtitle: 'Nordic Casino',
            content: [
              {
                type: 'paragraph',
                text: "Kasino (Finnish Casino) is the most popular fishing card game in Finland. Unlike standard Casino, it uses 'Royal' capture values (J=11, Q=12, K=13) and features a unique 'In-Hand Value' system where Aces and the two Kasino cards (10D and 2S) have higher values when held in the hand than when on the table. It is a game of calculation, memory, and defensive stalling.",
              },
              {
                type: 'paragraph',
                text: 'Derived from the Italian game Scopa and the international Casino, it was localized in Finland in the early 20th century. The Finnish additions (like the MÃ¶kkis) make it more aggressive than the Russian or American versions.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Optimal with 2 players (heads-up) or 4 in pairs.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No Jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No Jokers.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 4 cards (in two batches of 2). 4 cards are dealt face-up to the table. Rounds continue until the deck is empty.',
              },
            ],
          },
