    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kontsina (Koltsina)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Kontsina (also spelled Koltsina or Kolitsina) is the primary Greek fishing card game. Played by two to four players, it is a game of capture where players aim to take cards from a central layout by matching ranks or summing values. It is deeply ingrained in Greek social life, particularly in kafenio (coffee house) culture, and is valued for its balance of luck and tactical calculation.',
              },
              {
                type: 'paragraph',
                text: 'Dates to the early 20th century in Greece. It is a descendant of the international Casino family of games, localized with specific scoring points for Clubs and the Diamond 10.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Best with 2 players or 4 in partnerships.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace = 1. Jacks/Queens/Kings have no numerical sum value (rank-only).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace = 1. Jacks/Queens/Kings have no numerical sum value (rank-only).',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 4 cards. 4 cards are placed face-up in the center field. The rest form a stock pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Points to target: Record points each round; first to an agreed total (e.g. 21) wins. Tie on same round: higher score wins; exact tie plays another round.',
                  },
                  {
                    text: "Three or four players: Play anticlockwise; first to play is to dealer's right. Three players: 4 deals per round; four players: 3 deals per round.",
                  },
                  {
                    text: 'Four players in partnerships: Two against two; partners sit opposite; combine captured cards into a single pile per team.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
