    historyContent: {
      origins: 'Dates to the early 20th century in Greece. It is a descendant of the international Casino family of games, localized with specific scoring points for Clubs and the Diamond 10.',
      originCountries: [
        'Greece',
      ],
      timeline: [
        '1920s: Kontsina becomes common in cafes across Athens and the islands.',
        '1960s: Standard gambling variants emerge with specific coin stakes.',
        'Present: A very common family and holiday game in Greece and the Greek diaspora.',
      ],
      evolution: "The game evolved to have a 'Last Trick' collection rule, which discourages defensive stalling at the end of the round.",
      cultural: "In Greece, 'Koltsina' is often the first card game children learn from their grandparents.",
    },
    setupContent: {
