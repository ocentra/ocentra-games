        rules: {
          objective: 'Be the first partnership to reach 104 or more cumulative points. Points are scored by bidding and making tricks; failed bids score for the opponents.',
          gameplay: "1. Deal: 13 cards each, counterclockwise; dealer may cut but not shuffle after first deal. 2. Bidding: From dealer's right, each player speaks once (pass/ter/behi ter or bid 8-13 tricks or double 13). Highest bidder is declarer, chooses trump, leads first trick with a trump. 3. Play: Follow suit; winner of trick leads next. Play ends when declarer's side makes or loses the bid. 4. Scoring: Won bid scores tricks bid; lost bid scores twice that many to opponents. Double 13 scores 26 or 52. First to 104 wins.",
          keyRules: [
            'Declarer must lead trump to first trick',
            'Follow suit if possible; no requirement to win the trick after the first',
            'Game is 104 points; won bid = tricks bid, lost bid = twice that to opponents',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Use pass (ter, behi ter) to signal hand strength to partner; bid when holding trumps and high cards.',
          intermediate: 'Count trumps and key cards; use allowed signals (slam for suit lead, edge tap for associated suit, release to show void).',
          advanced: 'Coordinate with partner through legal signals; press bids when the hand supports raising.',
          tips: [
            'Slamming a card requests partner to lead that suit; edge tap requests the associated suit (hearts-spades, diamonds-clubs).',
          ],
          hasPlaceholders: false,
