  data: {
    LLM: 'Game: Tjuv. Logic: See rules.objective and rules.gameplay.',
    Player: "Tjuv (Swedish for 'Thief') is a fishing card game for two or more players. It is sometimes known as Tattare. Unlike traditional Casino, capturing is based on suit and rank hierarchy rather than numerical value. A unique feature is the ability to 'steal' captured piles from opponents if you have a matching card of higher rank.",
    objective: 'Capture the most cards by playing cards of the same suit and higher rank than table cards or opponent pile tops; the player with the most captured cards at the end wins.',
    gameplay: "1. Play a card. If it matches suit of a table card and is HIGHER rank, capture it. 2. Can also capture an opponent's pile if your card matches the top card's suit and is higher. 3. If no capture, place card on table. 4. Draw to maintain 3 cards. 5. Game ends when talon is empty.",
    keyRules: [
      'Must be HIGHER rank in SAME suit to capture.',
      "Can steal opponent's pile (top card rule).",
      'Draw to refill hand.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Two or more players.',
      deck: '36-card deck: A, K, Q, J, 10, 9, 8, 7, 6 in each suit (no 2-5). Rank: A (high) to 6 (low).',
      equipment: 'Cards',
      dealing: 'Three cards to each player. Each player places their lowest card face up on the table (or one of equal lowest). With two players the dealer adds one card from the deck to the table; with three or more the dealer reduces the table to three cards then deals one more to each. Three cards face up on table; remainder forms the talon.',
    },
    turnFlow: "1. Play a card. If it matches suit of a table card and is HIGHER rank, capture it. 2. Can also capture an opponent's pile if your card matches the top card's suit and is higher. 3. If no capture, place card on table. 4. Draw to maintain 3 cards. 5. Game ends when talon is empty.",
