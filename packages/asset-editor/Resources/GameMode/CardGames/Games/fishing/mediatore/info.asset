    historyContent: {
      origins: "Mediatore is a variant of Tressette, one of Italy's most popular card games. It developed as a way to add bidding complexity to the base game, allowing for more strategic depth.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        'Traditional: Evolved from Tressette in Italian card-playing circles',
        '20th Century: Rules formalized in Italian game collections',
        'Present: Played in Italy, particularly in regions where Tressette is popular',
      ],
      evolution: 'The key innovation of Mediatore is the bidding system that creates variable partnerships, unlike the fixed partnerships in standard Tressette.',
      cultural: 'A game for serious card players in Italy, often played in social clubs and family gatherings. The bidding adds a poker-like element to the traditional trick-taking format.',
