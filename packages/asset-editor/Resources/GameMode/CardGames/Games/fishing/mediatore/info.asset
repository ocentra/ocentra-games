      title: 'MEDIATORE',
      subtitle: 'Card game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mediatore',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mediatore is an Italian trick-taking game for four players, closely related to Tressette. It features a unique bidding system where the final bidder plays alone against a team of three, or chooses a partner by calling a card. The game uses a 40-card Italian deck and includes a 'monte' of undealt cards that can improve the bidder's hand.",
              },
              {
                type: 'paragraph',
                text: "Mediatore is a variant of Tressette, one of Italy's most popular card games. It developed as a way to add bidding complexity to the base game, allowing for more strategic depth.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players, playing individually or in variable partnerships based on bidding.',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck (or standard deck minus 8s, 9s, 10s). Suits: Coins, Cups, Swords, Clubs. Ranking: 3 (high), 2, Ace, King, Queen, Jack, 7, 6, 5, 4 (low).',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck or modified standard deck.',
              },
              {
                type: 'paragraph',
                text: "9 cards to each player in batches of 3. The remaining 4 cards form the 'monte' (talon) placed face down.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Tressette: The parent game with fixed partnerships and no bidding.',
                  },
                  {
                    text: 'Restricted Mediatore: Some variants restrict which cards can be called (e.g., only 3s or 2s).',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
