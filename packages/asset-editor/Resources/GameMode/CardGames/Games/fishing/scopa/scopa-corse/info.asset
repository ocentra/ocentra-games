    hero: {
      title: 'SCOPA CORSE',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Scopa Corse',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Scopa Corse is the Corsican variant of Scopa, played with a 36-card Italian deck (no 2s). Players capture table cards by matching rank or by sum; unlike basic Scopa, capturing is optional. First to 21 points wins.',
              },
              {
                type: 'paragraph',
                text: 'Scopa originated in Italy and was especially popular in Naples by the 18th century; it spread to Corsica where it is played as Scopa Corse with a 36-card deck (twos removed) and optional capture. The Corsican form is played alongside related games in Spain and North Africa and is documented with EREDI-brand rules; the stripped deck adds tactical depth by making sums of 7 harder to form.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 or 4 in fixed partnerships.',
              },
              {
                type: 'paragraph',
                text: '36-card Italian deck: each suit has Ace, 3, 4, 5, 6, 7, Jack, Queen, King (no 2s).',
              },
              {
                type: 'paragraph',
                text: '36-card Italian deck.',
              },
              {
                type: 'paragraph',
                text: '3 cards to each player, 4 face-up on the table. Two players: next three deals 3 cards each, last two deals 4 cards each. Four players: second deal 3 each, third deal 2 each.',
              },
            ],
          },
        ],
      },
