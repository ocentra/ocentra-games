  data: {
    hero: {
      title: 'ASSO PIGLIATUTTO',
      subtitle: 'Ace Takes All',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Asso Pigliatutto',
            subtitle: 'Ace Takes All',
            content: [
              {
                type: 'paragraph',
                text: "Asso Pigliatutto ('Ace Takes All') is a variant of the classic Italian game Scopa. The defining twist is that playing an Ace allows a player to capture ALL cards on the table instantly. While it simplifies the math for beginners, it adds a layer of 'Ace-hoarding' strategy that changes the flow of the game significantly.",
              },
              {
                type: 'paragraph',
                text: "Developed in Italy as a simplified or faster variation of Scopa. The name explicitly translates to 'Ace Takes All' (Pigliatutto). It is often taught to children as a gateway to standard Scopa because the Ace rule provides exciting, easy captures.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players (heads-up) or 4 players (two partnerships).',
              },
              {
                type: 'paragraph',
                text: '40-card Italian deck (Coins, Cups, Swords, Batons). If using a standard 52-card deck, remove 8s, 9s, and 10s. Kings=10, Queens=9, Jacks=8.',
              },
              {
                type: 'paragraph',
                text: 'Standard Italian deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives 3 cards to each player and places 4 cards face-up on the table. When players run out of cards, 3 more are dealt until the deck is empty.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Sbarazzino: Playing an Ace to sweep the table ALWAYS awards a Scopa point.',
                  },
                  {
                    text: "Napola (Naples): Additional points for capturing the Ace, Two, and Three of Coins (the 'Little Ladder').",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Asso Pigliatutto ('Ace Takes All') is a variant of the classic Italian game Scopa. The defining twist is that playing an Ace allows a player to capture ALL cards on the table instantly. While it simplifies the math for beginners, it adds a layer of 'Ace-hoarding' strategy that changes the flow of the game significantly.",
