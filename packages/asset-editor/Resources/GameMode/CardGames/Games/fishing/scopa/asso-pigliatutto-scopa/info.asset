    aiContent: {
      difficulty: {
        easy: 'Plays Aces immediately whenever possible. Captures strictly based on card count.',
        medium: 'Saves Aces for table clearing (3+ cards). Prioritizes Coins (Denari).',
        hard: "Tracks played cards to calculate Primiera probability. baits opponents into playing cards that sum to their held ranks. Maximizes 'last touch' logic to win remaining cards.",
      },
      considerations: [
        "AI must distinguish between 'Capture by Rank' (priority) and 'Capture by Sum'.",
        "The Ace Rule logic must check for 'Ace on Table' before triggering 'Sweep All'.",
      ],
    },
