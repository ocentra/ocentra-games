    historyContent: {
      origins: "Developed in Italy as a simplified or faster variation of Scopa. The name explicitly translates to 'Ace Takes All' (Pigliatutto). It is often taught to children as a gateway to standard Scopa because the Ace rule provides exciting, easy captures.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        '1800s: Scopa evolves from earlier fishing games like Primiera.',
        '1900s: Asso Pigliatutto emerges as a popular regional variant, particularly in Southern Italy.',
        "Present: Widely played in Italian cafes and digital apps as 'Scopa d'Assi'.",
      ],
      evolution: "The introduction of the 'Ace Sweep' mechanic reduced the mental math required for sweeping the table, making the game faster and more aggressive.",
      cultural: "A staple of Italian social life. 'Scaracoccia' is a regional name used in some dialects.",
    },
    setupContent: {
      players: '2 players (heads-up) or 4 players (two partnerships).',
      deck: '40-card Italian deck (Coins, Cups, Swords, Batons). If using a standard 52-card deck, remove 8s, 9s, and 10s. Kings=10, Queens=9, Jacks=8.',
      equipment: 'Standard Italian deck, score sheet.',
      dealing: 'Dealer gives 3 cards to each player and places 4 cards face-up on the table. When players run out of cards, 3 more are dealt until the deck is empty.',
    },
