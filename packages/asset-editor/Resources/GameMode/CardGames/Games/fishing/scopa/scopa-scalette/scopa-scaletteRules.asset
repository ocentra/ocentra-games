  data: {
    LLM: 'Game: Scopa con le Scalette. Logic: See rules.objective and rules.gameplay.',
    Player: 'Scopa variant with Scalette scoring.',
    objective: "Capture cards from the table by matching a single card's value or a set of cards that sum to the played card's value; score points for sweeps (scopa), most cards, most coins/diamonds, settebello, primiera, and Scalette sequences in coins/diamonds. First to the target (typically 11 or more) wins.",
    gameplay: "Play as normal Scopa or Scopa d'Assi. Each turn play one card: capture one table card of equal value or a set of table cards whose values sum to the played card (if both match, take the single card). If no capture is possible, leave the card on the table. Clearing the table is a scopa (1 point). After each player has played their three cards, the dealer deals three more to each player until the deck is exhausted. Scoring adds Scalette: low sequence (A-2-3 coins) = 3 points, extend upward for more; high sequence (K-Q-J coins) = 5 points, extend downward for more; taking all coins/diamonds (Scala) wins the game outright.",
    keyRules: [
      'Scalette',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Two, or four in partnerships; three possible but less satisfactory.',
      deck: '40-card Italian or French-suited pack (coins/cups/swords/batons or diamonds/hearts/clubs/spades). Capture values: K=10, Horse/Q=9, J=8, 7-2 face value, A=1.',
      equipment: '40-card pack.',
      dealing: 'Deal three cards to each player and four face-up on the table. After all play their three cards, deal three more to each (no new table cards). Repeat until deck is exhausted. If three or four Kings appear in the initial table layout, redeal.',
    },
    turnFlow: "Play as normal Scopa or Scopa d'Assi. Each turn play one card: capture one table card of equal value or a set of table cards whose values sum to the played card (if both match, take the single card). If no capture is possible, leave the card on the table. Clearing the table is a scopa (1 point). After each player has played their three cards, the dealer deals three more to each player until the deck is exhausted. Scoring adds Scalette: low sequence (A-2-3 coins) = 3 points, extend upward for more; high sequence (K-Q-J coins) = 5 points, extend downward for more; taking all coins/diamonds (Scala) wins the game outright.",
