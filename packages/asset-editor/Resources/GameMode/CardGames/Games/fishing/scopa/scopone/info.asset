  data: {
    hero: {
      title: 'SCOPONE',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Scopone',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Scopone is a skilful Italian four-player partnership card game in which cards or sets of cards are captured from the table by playing cards of equal value. It is closely related to Scopa.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: Italy\nTime Period: Early 1900s\nHistorical Development: The game evolved from traditional Italian card games (related to Scopa).\nCultural Significance: Popular social and family game in Italy.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in fixed partnerships; partners sit opposite each other. Play is anticlockwise.',
              },
              {
                type: 'paragraph',
                text: 'Italian 40-card pack (Latin suits: swords, clubs, cups, coins). Ranks Re, Cavallo, Fante, 7–2, A. Can use standard 52-card pack with 10s, 9s and 8s removed.',
              },
              {
                type: 'paragraph',
                text: 'Italian 40-card deck or stripped 52-card deck; score sheet (optional).',
              },
              {
                type: 'paragraph',
                text: "Dealer chosen at random; deal passes right after each hand. Deal three cards to each player (anticlockwise from dealer's right), two face down to table centre, three more to each, two more to centre, three more to each. Four table cards are turned face up. If three or all four table cards are kings, redeal.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Scopone Scientifico (10-card): Ten cards dealt to each player, none to the table. Some play that the dealer's team does score one point for a sweep if the dealer's last card captures all remaining table cards.",
                  },
                  {
                    text: 'Re bello: The king of coins (re bello) awards an extra point to the team that captures it; five points per deal (plus sweeps) instead of four.',
                  },
                  {
                    text: 'Napola / Napoli: Team capturing A-2-3 of coins in sequence scores points equal to the highest coin in that unbroken sequence (e.g. A-2-3-4-5-6 scores 6). Capturing all ten coins (Napoleone/Cappotto) wins the game outright.',
                  },
                  {
                    text: 'Target score 21: Some play to 21 points instead of 11, especially when using extra point variants.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
