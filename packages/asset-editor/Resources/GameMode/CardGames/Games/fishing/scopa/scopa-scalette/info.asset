    hero: {
      title: 'SCOPA CON LE SCALETTE',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Scopa con le Scalette',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Scopa variant with Scalette scoring: play as normal Scopa (or Scopa d'Assi) with extra points for sequences in coins/diamonds. Scaletta bassa (A-2-3) scores 3 points; Scaletta alta (K-Q-J) scores 5; taking all coins wins the game outright.",
              },
              {
                type: 'paragraph',
                text: 'Scalette is an Italian Scopa variant where sequence-capture rules are emphasized.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two, or four in partnerships; three possible but less satisfactory.',
              },
              {
                type: 'paragraph',
                text: '40-card Italian or French-suited pack (coins/cups/swords/batons or diamonds/hearts/clubs/spades). Capture values: K=10, Horse/Q=9, J=8, 7-2 face value, A=1.',
              },
              {
                type: 'paragraph',
                text: '40-card pack.',
              },
              {
                type: 'paragraph',
                text: 'Deal three cards to each player and four face-up on the table. After all play their three cards, deal three more to each (no new table cards). Repeat until deck is exhausted. If three or four Kings appear in the initial table layout, redeal.',
              },
            ],
          },
        ],
      },
    ],
