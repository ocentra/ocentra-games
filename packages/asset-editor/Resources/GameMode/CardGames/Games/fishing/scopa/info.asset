  data: {
    hero: {
      title: 'SCOPA',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Scopa',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Scopa is an Italian fishing card game where players capture table cards by matching rank or sum; points for sweeps, most cards, coins suit, sette bello and prime. First to 11+ points wins.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: Italy\nTime Period: 18th century (popular in Naples); roots in 15th-century Spanish games in Naples\nHistorical Development: Evolved from Spanish games Primero and Scarabucion in Naples port area; one of three major national card games in Italy with Briscola and Tresette\nCultural Significance: Popular social and family game in Italy; spread to Argentina, Brazil, and former Italian colonies via diaspora',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 2 or 4 (partnerships)\nPartnerships: Optional for 4 or 6 players',
              },
              {
                type: 'paragraph',
                text: 'Type: 40-card Italian or stripped 52-card deck (no 8s, 9s, 10s). Suits: coins, cups, swords, batons (Latin) or diamonds, hearts, clubs, spades (French). Ranks: King=10, Horse/Queen=9, Jack=8, 7–2 face value, Ace=1.\nNumber of Decks: 1\nJokers: Not included',
              },
              {
                type: 'paragraph',
                text: '40-card deck\nScore sheet (optional)\nTable space',
              },
              {
                type: 'paragraph',
                text: 'Three cards to each player, then four cards face up to the table; deal one at a time. After each round of three plays, deal three more to each player (no new table cards). Direction: counter-clockwise with 3+ players.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Asso Pigliatutto: Playing an Ace captures all table cards (and scores a scopa) unless an Ace is on the table, in which case only the Ace is captured. Ace on empty table stays on table.',
                  },
                  {
                    text: "Scopa d'Assi: Like Asso Pigliatutto except capturing all cards with an Ace does not count as a scopa. Often played with four players (Scopone-style) with 9 or 10 cards each.",
                  },
                  {
                    text: 'Scopa di Quindici: Capture only when the played card plus captured card(s) sum to 15 (e.g. play 4 to take 4+5+6). Popular in Argentina and Brazil. Some versions also allow equal-value capture.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
