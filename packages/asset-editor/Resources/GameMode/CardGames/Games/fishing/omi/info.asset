    historyContent: {
      origins: 'Omi is a popular card game in Sri Lanka; in some regions it is known as Oombi. The name suggests a distant connection with Hombre, but little trace of that influence remains.',
      originCountries: [
        'Sri Lanka',
      ],
      timeline: [
        'Unknown origins; likely colonial-era introduction or local development.',
        'Present: Widely played across Sri Lanka as a social and family game.',
      ],
      evolution: 'A straightforward partnership plain-trick game similar to Court Piece (Rang) in that the first player chooses trumps on the basis of only the first few cards.',
      cultural: 'A staple of Sri Lankan card play, often played in homes and social gatherings.',
    },
