  data: {
    hero: {
      title: 'OMI',
      subtitle: 'Sri Lankan Partnership Whist',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Omi',
            subtitle: 'Sri Lankan Partnership Whist',
            content: [
              {
                type: 'paragraph',
                text: 'Omi is a Sri Lankan partnership plain-trick game of the Whist type. Four players in fixed partnerships bid trumps after seeing only their first four cards, then receive four more. Play is counter-clockwise. The 20 unused cards (2-6) serve as scoring tokens; the first team to collect 10 tokens wins.',
              },
              {
                type: 'paragraph',
                text: 'Omi is a popular card game in Sri Lanka; in some regions it is known as Oombi. The name suggests a distant connection with Hombre, but little trace of that influence remains.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships; partners sit opposite (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack; only 32 cards used (A-K-Q-J-10-9-8-7). Rank A high to 7 low.',
              },
              {
                type: 'paragraph',
                text: '32 playing cards; 20 token cards (2-6 of each suit). One player holds black tokens (clubs, spades 2-6); an opponent holds red tokens (hearts, diamonds 2-6).',
              },
              {
                type: 'paragraph',
                text: "Dealer shuffles and offers cut to opponent on left. Dealer deals 4 cards to each player. Player to dealer's right announces trump (without consulting partner). Dealer then deals 4 more cards to each (8 total).",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Announced Kapothi: To win 3 tokens for taking all 8 tricks, you must announce before the seventh trick that you intend to win all eight. If you then lose one of the last two tricks, you give 4 tokens to the opponents.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Omi is a Sri Lankan partnership plain-trick game of the Whist type. Four players in fixed partnerships bid trumps after seeing only their first four cards, then receive four more. Play is counter-clockwise. The 20 unused cards (2-6) serve as scoring tokens; the first team to collect 10 tokens wins.',
