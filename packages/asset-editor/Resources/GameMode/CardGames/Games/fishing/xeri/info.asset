    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Xeri',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Xeri (Ξερή, 'dry') is a popular Greek fishing card game. 2 or 4 players. 52 cards. 6 each + 4 face-up on table. Match rank to capture entire pile. Jack captures any pile. 'Xeri' = capturing lone card (10pts bonus, Jack Xeri = 20pts). Score: most cards=3pts, A/K/Q/J/10=1pt each, 10♦=1pt extra, 2♣=1pt.",
              },
              {
                type: 'paragraph',
                text: 'Xeri (from Greek ξερή, meaning dry or plain) is a well-known Greek card game in which players capture the play pile by matching its top card. Play is similar to the Turkish game Pişti though scoring differs; the xeri (capturing a lone card) idea also appears in Kontsina and in Diloti. Documented from Greek contributors and widely played in Greece.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 or 4 (partnerships)',
              },
              {
                type: 'paragraph',
                text: '52 cards. 6 each. 4 face-up on table.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: '6 each + 4 face-up center. Redeal 6 when hands empty.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Four players: Played by four in partnerships, partners opposite; direction of play anticlockwise; opponent to dealer's left cuts, opponent to dealer's right leads.",
                  },
                  {
                    text: 'Point scoring to 151: Instead of counting games won, keep cumulative points; first player or team to reach 151 or more at end of a round wins; if both reach 151 in same round, play to 251.',
                  },
                ],
              },
            ],
          },
        ],
      },
