              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No Jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. No Jokers.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 7 cards. One card is placed face-up to start the foundations pile.',
              },
