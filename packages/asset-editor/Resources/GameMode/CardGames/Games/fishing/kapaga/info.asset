        rules: {
          objective: 'Be the first player to discard all cards from your hand.',
          gameplay: '1. Players must play a card that matches either the suit or the rank of the top card on the foundation pile.\n2. If a player cannot match, they must draw from the stock until they can play (or draw exactly once, depending on house variant).',
          keyRules: [
            'Play a card matching the suit or rank of the top card on the foundation pile.',
            'If you cannot play, draw from the stock until you can (or once per turn in some variants).',
            'An 8 may be played on anything and lets you choose the new suit.',
            'An Ace skips the next player.',
            'Call when you have one card left (e.g. Kapaga); failure may incur a draw penalty.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Save your 8s until you are stuck with a single card and no matching suit. Use Aces to skip opponents who only have 1 or 2 cards left.',
          intermediate: 'Suit Control: If you have many Hearts, use an 8 to change the suit to Hearts, forcing others to draw until they find matching cards.',
          advanced: 'Observation: Watch which suits your opponents are drawing for. If an opponent draws multiple times, they are likely void in the current suitâ€”prevent them from changing it.',
          tips: [
            "Always call 'Kapaga!' (or the local equivalent) when you have one card left. Failing to do so often results in a 2-card draw penalty.",
            "If playing with the '2' draw rule, try to chain them with other players to force a massive draw on the last person in the chain.",
          ],
