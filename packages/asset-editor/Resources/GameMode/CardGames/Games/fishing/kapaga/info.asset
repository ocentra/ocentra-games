    historyContent: {
      origins: "Brought to Greenland by Danish settlers and Arctic explorers, the game was adapted from European Crazy Eights (Olsen or Mau-Mau) to fit local social dynamics. The name 'Kapaga' is a localized phonetic name for a similar regional variant.",
      originCountries: [
        'Greenland',
        'Denmark',
      ],
      timeline: [
        'Early 20th Century: Shedding games spread via trade outposts in Greenland.',
        '1950s: Becomes a distinct variant with standardized Greenlandic house rules.',
        "2000s: Documented in Arctic travelogues (e.g., 'A Viking Voyage' by Hodding Carter).",
        'Present: One of the most common family games in modern Greenland.',
      ],
      evolution: "The game simplified some of the more complex European 'Mau-Mau' rules to emphasize speed and social interaction over complex scoring.",
      cultural: "Commonly played alongside coffee and storytelling; the game's fast pace reflects the social warmth of indoor life during the Arctic winter.",
