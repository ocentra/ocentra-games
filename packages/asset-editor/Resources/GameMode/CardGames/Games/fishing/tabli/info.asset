    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Tablić',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Tablić (or Tablanette) is a fishing-style card game popular in the Balkans (Serbia, Croatia, Bosnia). Players capture face-up cards from the table by matching their value or summing to their value. Points are awarded for capturing specific high-value cards (face cards, 10s, Aces) and for having the most cards. The game is similar to Casino.',
              },
              {
                type: 'paragraph',
                text: 'Derived from the Casino family of fishing games; widely played in the former Yugoslavia.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Normally two players, or four in fixed partnerships with partners sitting opposite. A three-player game is also possible but less usual; in Serbia deal and play are counter-clockwise.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Cards, score sheet',
              },
              {
                type: 'paragraph',
                text: 'Dealer deals 6 cards to each player and 4 face up on the table. Only the first deal places cards on the table. Subsequent deals refill hands until the deck is exhausted.',
              },
            ],
          },
        ],
      },
    ],
