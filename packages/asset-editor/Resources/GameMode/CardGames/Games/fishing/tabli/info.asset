        rules: {
          objective: 'Score points by capturing cards. Scores: A, K, Q, J, 10 = 1 point. 10 of Diamonds (Double Ten) = 2 points. 2 of Clubs (Little Two) = 1 point. Most cards = 3 points. Tabla (clearing the table) = 1 point.',
          gameplay: 'Players play one card from hand. If it matches a card on table (by rank) or a sum of cards (e.g. 9 captures 9, or 5+4), the player captures them. If no capture, the card stays on table. The player who makes the last capture takes any remaining cards at the end.',
          keyRules: [
            'Capture by equality or sum',
            'K=14, Q=13, J=12, A=1/11',
            'Tabla bonus for clearing table',
            'Last capture takes remainder',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Capture as many point cards as possible (10, J, Q, K, A, 2♣). Prioritize the 10♦ (2 points). Try to clear the table (Tabla) for bonus points.',
          intermediate: 'Do not leave cards on the table that sum to easily captured numbers (like 11-14) if opponents likely hold face cards. Save high cards to make large captures.',
          advanced: 'Track the 10♦ and 2♣. Calculate remaining points. In endgame, try to make the last capture to sweep the board.',
          tips: [
            'Kings (14), Queens (13), Jacks (12) can capture sums.',
            'Aces can be 1 or 11 - flexible.',
            'Clearing the table is worth a point (Tabla) - except at the very end.',
          ],
          hasPlaceholders: false,
        },
