  data: {
    LLM: 'Game: Tablić. Logic: See rules.objective and rules.gameplay.',
    Player: 'Tablić (or Tablanette) is a fishing-style card game popular in the Balkans (Serbia, Croatia, Bosnia). Players capture face-up cards from the table by matching their value or summing to their value. Points are awarded for capturing specific high-value cards (face cards, 10s, Aces) and for having the most cards. The game is similar to Casino.',
    objective: 'Score points by capturing cards. Scores: A, K, Q, J, 10 = 1 point. 10 of Diamonds (Double Ten) = 2 points. 2 of Clubs (Little Two) = 1 point. Most cards = 3 points. Tabla (clearing the table) = 1 point.',
    gameplay: 'Players play one card from hand. If it matches a card on table (by rank) or a sum of cards (e.g. 9 captures 9, or 5+4), the player captures them. If no capture, the card stays on table. The player who makes the last capture takes any remaining cards at the end.',
    keyRules: [
      'Capture by equality or sum',
      'K=14, Q=13, J=12, A=1/11',
      'Tabla bonus for clearing table',
      'Last capture takes remainder',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Normally two players, or four in fixed partnerships with partners sitting opposite. A three-player game is also possible but less usual; in Serbia deal and play are counter-clockwise.',
      deck: 'Standard 52-card deck',
      equipment: 'Cards, score sheet',
      dealing: 'Dealer deals 6 cards to each player and 4 face up on the table. Only the first deal places cards on the table. Subsequent deals refill hands until the deck is exhausted.',
    },
    turnFlow: 'Players play one card from hand. If it matches a card on table (by rank) or a sum of cards (e.g. 9 captures 9, or 5+4), the player captures them. If no capture, the card stays on table. The player who makes the last capture takes any remaining cards at the end.',
