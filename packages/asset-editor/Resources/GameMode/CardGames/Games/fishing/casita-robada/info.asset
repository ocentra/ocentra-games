        tabLabel: 'About',
        pages: [
          {
            title: 'Casita Robada',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Casita Robada (Stolen House) is a children's fishing game popular in Argentina. Also known as Steal the Old Man's Bundle or Rubamazzo in Italy. Players capture cards by matching ranks and can steal opponents' entire bundles by matching the top card.",
              },
              {
                type: 'paragraph',
                text: "Casita Robada is the Argentinean name for this children's fishing game. It's also known as Steal the Old Man's Bundle, Steal the Old Man's Pack, or Steal Pile in English-speaking countries. In Italy it's called Rubamazzo. The game is popular among children for its simple rules and exciting 'stealing' mechanic.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 players, each playing individually.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Suits are irrelevant - only ranks matter.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck',
              },
              {
                type: 'paragraph',
                text: 'Highest card draws to deal first. Dealer gives 4 cards face down to each player and 4 face up to the center (layout). Remaining deck held by dealer for subsequent deals.',
              },
            ],
          },
        ],
      },
