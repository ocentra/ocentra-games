    historyContent: {
      origins: "Derived from ancient Central Asian card games and formalized in Turkey during the Ottoman era. It shares roots with the Spanish game 'Escoba'.",
      originCountries: [
        'Turkey',
      ],
      timeline: [
        '1900s: Becomes a staple in Turkish tea houses (Kahvehane).',
        '1960s: Standard rules (151-point target) are established in social clubs.',
        '1990s: First digital versions appear in early Turkish PC gaming.',
        'Present: The most common game played during family gatherings (Bayram) and in digital cafes.',
      ],
      evolution: "The'Double Pişti' rule (capturing a Jack with a Jack) was added to increase the volatility and excitement of the endgame.",
      cultural: "In Turkey, scoring a Pişti is often accompanied by the player slapping the card down with a loud bang to celebrate 'Cooking' the opponent.",
    },
