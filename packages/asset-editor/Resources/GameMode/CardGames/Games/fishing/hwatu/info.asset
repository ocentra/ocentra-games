    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Hwatu (Go-Stop)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Hwatu (í™”íˆ¬ - Flower Cards) refers to the 48-card Korean deck and the various 'fishing' games played with it, most notably Go-Stop (ê³ ìŠ¤í†±). It is a game of high tension and strategic risk-taking where players capture floral cards representing the 12 months to form specific combinations (Jokbo). The game is famous for the 'Go' or 'Stop' decision, where a winning player can choose to risk their points to double them or stop immediately to secure victory.",
              },
              {
                type: 'paragraph',
                text: "Derived from the Japanese Hanafuda deck introduced to Korea in the late 19th century. Koreans adapted the rules, significantly increasing the complexity and adding the signature 'Go/Stop' mechanic.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Usually 3 players (Go-Stop) or 2 players (Mat-go).',
              },
              {
                type: 'paragraph',
                text: '48 cards (12 months x 4 cards each) + optional 2-5 bonus/joker cards.',
              },
              {
                type: 'paragraph',
                text: '48 cards (12 months x 4 cards each) + optional 2-5 bonus/joker cards.',
              },
              {
                type: 'paragraph',
                text: 'For 3 players: 7 cards each, 6 on the table. For 2 players: 10 cards each, 8 on the table.',
              },
            ],
          },
        ],
      },
