    },
    basic: 'Keep middle-range cards (ranks 5-8). These are rarely high enough to win a trick and rarely low enough to lose an exchange round.',
    intermediate: "The 'Hus' Block: If you have a 'Hus' (Rank 11), use it to block exchanges from your right-hand neighbor. This forces them to keep their potentially bad card.",
    advanced: "Harlekin Timing: If you are the leader, play the Harlekin to win the trick immediately if you suspect the trick contains zero penalty points. If you play it second, ensure it's on a trick you *don't* want to win, as it will be the lowest card.",
    tips: [
      {
        title: 'Tip',
        description: "Pay attention to the sounds! 'Kuku', 'Mjau' (Cat), and 'Home stays' tell you exactly which high/blocking cards are in play.",
      },
      {
        title: 'Tip',
        description: "If you receive the 'Katt' (Cat), try to pass it on immediately; holding it until the end usually leads to a 'Mjau' penalty.",
      },
