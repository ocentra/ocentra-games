    icon: '🃏',
  },
  data: {
    LLM: "Each turn a player plays one card from hand. They may (1) capture one or more table cards that match its rank and add them to their bundle, (2) steal an opponent's entire bundle by playing a card that matches the top card of that bundle (the stolen bundle is added to their own), or (3) trail by placing the card face-up on the table if they cannot or choose not to capture. Play continues until all hands are empty. The player with the most cards in their bundle wins.",
    Player: "Each turn a player plays one card from hand. They may (1) capture one or more table cards that match its rank and add them to their bundle, (2) steal an opponent's entire bundle by playing a card that matches the top card of that bundle (the stolen bundle is added to their own), or (3) trail by placing the card face-up on the table if they cannot or choose not to capture. Play continues until all hands are empty. The player with the most cards in their bundle wins.",
    objective: 'Have the most cards in your bundle when all cards have been played; the player with the largest bundle wins.',
    gameplay: "Each turn a player plays one card from hand. They may (1) capture one or more table cards that match its rank and add them to their bundle, (2) steal an opponent's entire bundle by playing a card that matches the top card of that bundle (the stolen bundle is added to their own), or (3) trail by placing the card face-up on the table if they cannot or choose not to capture. Play continues until all hands are empty. The player with the most cards in their bundle wins.",
    keyRules: [
      'Capture table cards by matching rank; captured cards go to your bundle.',
      "Steal an opponent's bundle by playing a card that matches the top card of their bundle.",
      'If you cannot or do not capture, trail your card face-up to the table.',
      'Most cards in your bundle at game end wins.',
    ],
    bonusRuleGuids: [],
