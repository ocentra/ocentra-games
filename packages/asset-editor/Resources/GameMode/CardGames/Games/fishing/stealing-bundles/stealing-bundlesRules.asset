  data: {
    LLM: 'Game: Stealing Bundles. Logic: See rules.objective and rules.gameplay.',
    Player: "Stealing Bundles (also known as Stealing the Old Man's Bundle) is a simple fishing card game for two or more players, popular with children. It is similar to Casino but simplified. Players capture face-up cards from the table by matching their rank. Captured cards are stacked in a 'bundle'. The unique twist is that players can steal an opponent's entire bundle by matching the top card.",
    objective: 'Have the most cards in your bundle when all cards have been played; the player with the largest bundle wins.',
    gameplay: "Each turn a player plays one card from hand. They may (1) capture one or more table cards that match its rank and add them to their bundle, (2) steal an opponent's entire bundle by playing a card that matches the top card of that bundle (the stolen bundle is added to their own), or (3) trail by placing the card face-up on the table if they cannot or choose not to capture. Play continues until all hands are empty. The player with the most cards in their bundle wins.",
    keyRules: [
      'Capture table cards by matching rank; captured cards go to your bundle.',
      "Steal an opponent's bundle by playing a card that matches the top card of their bundle.",
      'If you cannot or do not capture, trail your card face-up to the table.',
      'Most cards in your bundle at game end wins.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2, 3 or 4 players. First dealer is chosen by everyone drawing a card; highest card deals (tied players draw again).',
      deck: 'Standard 52-card pack; suits are ignored for matching (only rank matters).',
      equipment: 'Standard 52-card pack; suits are ignored for matching (only rank matters).',
      dealing: 'Dealer gives each player 5 cards; remaining cards are dealt face-up to the table. Play starts to the left of the dealer.',
    },
    turnFlow: "Each turn a player plays one card from hand. They may (1) capture one or more table cards that match its rank and add them to their bundle, (2) steal an opponent's entire bundle by playing a card that matches the top card of that bundle (the stolen bundle is added to their own), or (3) trail by placing the card face-up on the table if they cannot or choose not to capture. Play continues until all hands are empty. The player with the most cards in their bundle wins.",
