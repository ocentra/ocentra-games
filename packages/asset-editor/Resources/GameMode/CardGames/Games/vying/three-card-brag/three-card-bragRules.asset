    LLM: 'Game: Three Card Brag. Logic: See rules.objective and rules.gameplay.',
    Player: 'Three Card Brag is a British three-card vying game. Each player antes, receives three private cards, and then chooses whether to stay blind, see cards, bet, fold, or force a showdown. The pot is won by the last active player or by the best three-card Brag hand.',
    objective: 'Win the pot by having the best three-card hand or by being the last player remaining after all others have folded.',
    gameplay: '1. Ante/Boot Phase\nAll players place the agreed minimum stake (boot) into the pot\nThis ensures there is something to play for in each hand',
    keyRules: [
      'Blind Player: Has not looked at their cards',
      'Must bet at least the current stake (minimum) or up to twice the current stake (maximum)',
      'Can bet less than a seen player',
      'Seen Player: Has looked at their cards',
      'Must bet at least twice the current stake (minimum) or up to four times the current stake (maximum)',
      'Must bet double what a blind player bets',
    ],
    moveValidityConditions: {
      ante: 'All players post the boot before cards are dealt.',
      deal: 'Deal is performed by the dealer; not a player action.',
      reveal_market: 'This game does not use a market to reveal.',
      buy_market: 'This game has no market purchase.',
      buy_stock: 'This game has no buying from stock.',
      fold: 'An active player may fold and surrender claim to the pot.',
      check: 'Check is only legal when no unmatched stake is pending.',
      call: 'An active player may call the current stake.',
      bet: 'An active player may bet a positive amount into the pot.',
      raise: 'An active player may raise within the table stake limits.',
      declare: 'This game has no declare phase.',
      reveal_hand: 'Active players reveal three-card hands during showdown.',
      award_pot: 'The pot is awarded to the best active hand or the last unfolded player.',
      play_card: 'Three Card Brag compares complete three-card hands; individual card play is not used.',
