    "historyContent": {
      "origins": "Brag emerged in 16th-century England as a three-card vying game. It became the parent of Indian Teen Patti and influenced betting structures used by later poker-family games.",
      "timeline": [
        "1500s: early versions of Post and Pair and Brag are documented in England.",
        "1700s: bragger wild-card variants appear, often using the Jack of Clubs.",
        "1900s: Brag remains common in British military, social club, and pub play.",
        "Present: the game survives as a compact high-pressure gambling and social card game."
      ],
      "evolution": "The core hand rankings and half-price blind betting have stayed recognizable for centuries even as poker became globally dominant.",
      "cultural": "Brag is often treated as a working-class British poker relative and appears in British gambling fiction and film culture."
    },
    "setupContent": {
      "players": "Typically 3 to 7 players play individually around one pot.",
      "deck": "One Standard 52-card French deck with no jokers.",
      "equipment": "A standard pack plus chips, coins, or another agreed stake unit.",
      "dealing": "Each player antes. The dealer gives three face-down cards to every active player, then betting begins."
    },
    "variationsContent": {
      "list": [
        {
          "id": "brag-with-braggers",
          "name": "Brag with Braggers",
          "description": "A common wild-card variant where selected cards such as Jack of Clubs, 9 of Diamonds, and Ace of Diamonds can act as braggers."
        }
      ]
    },
    "aiContent": {
      "difficulty": {
        "easy": "Looks at cards immediately, bets only with a pair or better, and folds to major raises.",
        "medium": "Stays blind for a short window, uses pot odds before folding, and understands the Brag hand hierarchy.",
        "hard": "Manages blind state deliberately, pressure-bets strong made hands, and estimates opponent strength from blind duration and bet sizing."
      },
      "considerations": [
        "The action model must distinguish blind and seeing betting prices.",
        "The ranking evaluator needs a three-card hand hierarchy, including special prial treatment.",
        "Bot policy should reason about pot pressure as well as raw hand strength."
      ]
    },
