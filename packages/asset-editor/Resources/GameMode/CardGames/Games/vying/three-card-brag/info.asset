      "bluffing",
      "british"
    ],
    "comingSoon": false,
    "minPlayers": 3,
    "maxPlayers": 7,
    "routePath": "three-card-brag",
    "LLM": "Game: Three Card Brag. Logic: ante, deal three cards, manage blind and seeing bets, then award the pot by fold-out or three-card hand ranking.",
    "Player": "3-Card Brag is a fast British pot game where every player has three cards and every betting choice asks whether staying blind, seeing, raising, or folding creates the best pressure.",
    "tagline": "Blind pressure. Three cards. One pot.",
