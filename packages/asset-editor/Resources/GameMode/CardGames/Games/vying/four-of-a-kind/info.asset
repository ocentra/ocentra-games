  data: {
    hero: {
      title: 'FOUR OF A KIND',
      subtitle: 'The Poker Waiting Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Four of a Kind',
            subtitle: 'The Poker Waiting Game',
            content: [
              {
                type: 'paragraph',
                text: "Four of a Kind is a unique pokerndstyle betting game, traditionally played as a 'dealer's choice' option in home poker games. Unlike standard poker where you build a hand through drawing or communal cards, players in this game are each assigned a unique starting rank and wait for the deck to provide the matching cards. It is a game of high tension and split pots, where victory is divided between the first person to complete their set of four and the person holding the mathematically lowest hand at that moment.",
              },
              {
                type: 'paragraph',
                text: "The game was documented by William Moore of New York, whose family introduced it as a 'poker night' variation in the late 1950s. It represents a genre of 'waiting games' where betting is driven by the visible progression of one's hand toward a fixed goal.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 to 8 players. Optimal at 6-8.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces rank high.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces rank high.',
              },
              {
                type: 'paragraph',
                text: 'deal and betting Each player places the agreed ante into the pot.',
              },
            ],
          },
        ],
      },
    ],
    description: "Four of a Kind is a unique pokerndstyle betting game, traditionally played as a 'dealer's choice' option in home poker games. Unlike standard poker where you build a hand through drawing or communal cards, players in this game are each assigned a unique starting rank and wait for the deck to provide the matching cards. It is a game of high tension and split pots, where victory is divided between the first person to complete their set of four and the person holding the mathematically lowest hand at that moment.",
    tags: [
      'card-game',
      'poker',
      'vying',
      'betting',
      'social',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 8,
    routePath: 'four-of-a-kind',
    LLM: 'Game: Four of a Kind (Vying / Betting). Setup: 4-8 players, ante. Deal: 1 unique face-up card per player. Win condition: First to 4 matching cards wins 50% of pot. Other 50%: lowest total hand value (by card ranks). Play: Cards revealed one at a time. Matches go to owner. Betting rounds after initial deal and each match. Fold is legal. Card values: A=14, K=13, Q=12, J=11, 10-2=face value.',
    Player: "Welcome to Four of a Kind. Each player starts with one unique card face-up. You're trying to collect all four cards of your rank. As cards are revealed, if yours match you take them. Betting happens at the start and after each match. Winner takes 50% of the pot. Lowest total hand takes the other 50%.",
    tagline: 'Get your four. Or be lowest. Split the pot.',
    gameCategory: 'Poker',
    subcategory: 'Poker-based',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '10-20 minutes',
    origin: 'USA',
    originName: 'Four of a Kind',
    deck: 'Standard 52-card deck',
    alsoKnownAs: [
      'Four of a Kind Poker',
      'FOAK',
      'Quad Poker',
      'Four Kinds',
    ],
    playersDisplay: '4-8 (Best with 6-8)',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
      variations: true,
      ai: true,
      sources: true,
    },
    historyContent: {
      origins: "The game was documented by William Moore of New York, whose family introduced it as a 'poker night' variation in the late 1950s. It represents a genre of 'waiting games' where betting is driven by the visible progression of one's hand toward a fixed goal.",
      originCountries: [
        'USA',
      ],
      timeline: [
        '1950s: First played in family poker circles in New York state.',
        '1960s: Spread to college campuses as a social gambling game.',
        "Present: Remains a niche but beloved 'wildcard' variant in home poker rotations.",
      ],
      evolution: "The game simplifies the complex bluffing of poker into a straightforward race, using betting rounds to allow players to 'buy in' to their luck as matches appear.",
      cultural: "Often played for small stakes (nickels and dimes), emphasizing the social aspect of 'waiting for your card' rather than calculated highndstakes bluffing.",
    },
    setupContent: {
      players: '4 to 8 players. Optimal at 6-8.',
      deck: 'Standard 52-card deck. Aces rank high.',
      equipment: 'Standard 52-card deck. Aces rank high.',
      dealing: 'deal and betting Each player places the agreed ante into the pot.',
    },
    variationsContent: {
      list: [],
      noVariationsReason: 'Sources describe only the standard form; no regional or rule variations documented.',
    },
    aiContent: {
      difficulty: {
        easy: "Never folds; doesn't recognize when its rank cards are already discarded; bets randomly regardless of hand strength.",
        medium: 'Pivots to Low-hand strategy if High-hand is impossible; bets more heavily when holding 2 or 3 of its rank.',
        hard: "Performs real-time deck counting to calculate exact probability of winning the High pot; avoids betting if its rank is 'dead'; bluffs with midndrange cards to force Low-hand favorites to fold.",
      },
      considerations: [
        "AI must maintain a 'Dead Card' list to track which ranks can no longer reach Fourndofnknd.",
      ],
    },
