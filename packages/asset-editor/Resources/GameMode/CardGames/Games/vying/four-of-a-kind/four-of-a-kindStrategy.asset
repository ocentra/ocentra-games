    tips: [
      {
        title: 'Tip',
        description: "Stay in if you have a low rank (2s or 3s) even if you aren't getting matches; you are the favorite for the Lowndhalf of the pot.",
      },
      {
        title: 'Tip',
        description: "Fold early if you have a midndrange card (7s or 8s) and you aren't getting matches, as you are unlikely to win either the High or the Low pot.",
