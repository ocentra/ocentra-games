            content: [
              {
                type: 'paragraph',
                text: 'A Game of Thrones The Card Game is a commercial customizable card game of political conflict, deck construction, plot selection, and challenges between Westeros factions.',
              },
              {
                type: 'paragraph',
                text: 'The game began as a collectible or living card game adaptation of George R. R. Martins setting and later received a second edition with revised card pools and rules.',
              },
            ],
          },
