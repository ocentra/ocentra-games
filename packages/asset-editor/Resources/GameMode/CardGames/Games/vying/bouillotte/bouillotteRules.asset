  data: {
    LLM: '1. **Ante**: Each player puts a fixed amount in the pot. 2. **Deal**: Players receive 3 cards and see the retourné. 3. **Vying**: Starting left of dealer, players bet, call, or fold. 4. **Showdown**: Best hand wins. Hand hierarchy: Brelan Carré (four of a kind using retourné), Brelan Favori (three of a kind including retourné), simple Brelan (three of a kind), then highest point-total in a suit.',
    Player: '1. **Ante**: Each player puts a fixed amount in the pot. 2. **Deal**: Players receive 3 cards and see the retourné. 3. **Vying**: Starting left of dealer, players bet, call, or fold. 4. **Showdown**: Best hand wins. Hand hierarchy: Brelan Carré (four of a kind using retourné), Brelan Favori (three of a kind including retourné), simple Brelan (three of a kind), then highest point-total in a suit.',
    objective: 'Win the pot by holding the highest hand or by forcing all other players to fold during the vying rounds.',
    gameplay: '1. **Ante**: Each player puts a fixed amount in the pot. 2. **Deal**: Players receive 3 cards and see the retourné. 3. **Vying**: Starting left of dealer, players bet, call, or fold. 4. **Showdown**: Best hand wins. Hand hierarchy: Brelan Carré (four of a kind using retourné), Brelan Favori (three of a kind including retourné), simple Brelan (three of a kind), then highest point-total in a suit.',
    keyRules: [
      "The 'Cave' rule: You cannot bet more than the chips you have on the table.",
      'If no Brelan is held, the player with the highest total value in a single suit wins.',
      'Aces are worth 11, face cards 10, others face value.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '4 players are standard (using 20 cards). 3 players remove Queens (16 cards). 5 players add Jacks (24 cards).',
      deck: 'A stripped piquet pack: Ace, King, Queen, 9, 8 in each suit. Ranking: A-K-Q-9-8.',
      equipment: 'Stripped pack, gambling chips (the Cave).',
      dealing: 'Players ante into the pot. Dealer deals 3 cards to each player and turns the next card face-up (the retourné).',
    },
    turnFlow: '1. **Ante**: Each player puts a fixed amount in the pot. 2. **Deal**: Players receive 3 cards and see the retourné. 3. **Vying**: Starting left of dealer, players bet, call, or fold. 4. **Showdown**: Best hand wins. Hand hierarchy: Brelan Carré (four of a kind using retourné), Brelan Favori (three of a kind including retourné), simple Brelan (three of a kind), then highest point-total in a suit.',
    moveValidityConditions: {
      ante: 'Allowed only during the ante phase.',
      deal: 'The initial distribution of three cards and the turning of the retourné are handled by the system dealer.',
      reveal_market: 'The only public card is the retourné turned from the stock; no separate market area exists in the game.',
      buy_market: 'Players cannot purchase cards from a market; hand strength is determined solely by the deal and retourné.',
      buy_stock: 'There is no drawing or buying from the stock during play; the cards are distributed in a fixed deal.',
      fold: 'Allowed during the vying phase when facing a bet or raise.',
      check: 'Only available when no previous bet has been made in the round.',
      call: 'Allowed only during the vying phase when a bet is active.',
      bet: "Must be within the limits of the player's Cave (chips on table).",
      raise: "Must not exceed the player's available Cave.",
      declare: 'Hand resolution is based on public card reveal at showdown rather than a formal declaration phase.',
      reveal_hand: 'Hands remain private until the system triggers the showdown reveal logic at the end of vying.',
      award_pot: 'System automated action.',
      play_card: 'Bouillotte is a vying/betting game where cards are held for comparison rather than played to tricks.',
      draw: 'The entire hand is distributed at the start; no drawing phase exists during the play of the hand.',
      discard: 'Players must keep all cards dealt to them; cards are only removed to the muck after the round ends.',
      pass: 'Players must check, bet, or fold during their turn; a simple pass without action is not supported.',
      bid: 'Bouillotte uses a wagering system rather than an auction-style bidding system for contracts.',
      meld: 'Hand resolution is based on five-card combinations rather than forming and laying melds on the table.',
      go_out: 'The round concludes automatically after the final showdown and pot distribution are completed.',
