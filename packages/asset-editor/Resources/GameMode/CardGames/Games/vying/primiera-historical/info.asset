    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Primiera',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Primiera (often confused with the related Spanish 'Primero') is a prestigious 16th-century Italian card game that is mathematically and strategically recognized as a direct ancestor of modern Poker. It is a betting and card-comparing game where players aim to form combinations from a 4-card hand. Known for its unique 'Primiera' combination (one card of each suit) and its high-stakes 'Vying' (betting) system, it was a game of status and intellect across Renaissance Europe.",
              },
              {
                type: 'paragraph',
                text: "First appearing in the early 1500s. Its name means 'First' and refers to the primacy of the 'Primiera' hand. It was a favorite of monarchs, including Henry VIII and Catherine de' Medici.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four to six players. The game works best with four to six at the table; period sources describe both four-player and six-player play. Deal and vying proceed counter-clockwise from the dealer. Each player receives four cards and participates in the ante before the deal.',
              },
              {
                type: 'paragraph',
                text: '40 cards. Remove 8s, 9s, 10s from a standard deck.',
              },
              {
                type: 'paragraph',
                text: '40 cards. Remove 8s, 9s, 10s from a standard deck.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 4 cards, usually dealt two at a time.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'English version: Ante, deal 4 cards in 2s, betting after first two and after second two; eight cards face down on table or stock; knock (Vada) for showdown; dealer bets first.',
                  },
                  {
                    text: 'Italian version: Regional variants (Rome 52 cards; Florence 7s8s9s removed; Venice/Lombardy/Naples differ). Rest at second card; flush, primiera, punto; four of a kind beats both.',
                  },
                  {
                    text: 'Spanish version: Four cards dealt one by one; 7=21, 6=18, ace=6 or 16 by variant; quinola optional; best hand wins prime or flush.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
