    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Seven Card Brag',
            subtitle: 'The Master Partition',
            content: [
              {
                type: 'paragraph',
                text: 'Seven Card Brag is a partition variant related to Crash and Six Card Brag. Each player receives seven cards, normally discards one, and divides the remaining six into two three-card Brag hands for comparison.',
              },
              {
                type: 'paragraph',
                text: 'Developed as a high-skill extension of standard 3-Card Brag, 7-Card Brag appeared in card rooms as a faster-playing alternative to 9-Card Brag (Crash). It emphasizes the tactical discard of the seventh card to perfectly balance two hands.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically 3 to 6 players playing individually.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack (No Jokers).',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, betting chips or currency.',
              },
              {
                type: 'paragraph',
                text: 'Deal seven cards face-down to each player. Players divide their cards into two three-card hands and muck the seventh card.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
