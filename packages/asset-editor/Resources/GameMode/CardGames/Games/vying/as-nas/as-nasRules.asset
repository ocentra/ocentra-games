  data: {
    LLM: 'Game: As-Nas. Logic: Win the pot either by holding the strongest ranked hand at showdown or by causing all opponents to fold.',
    Player: 'As-Nas is a historical Persian vying game played with a small five-suit pack, using poker-like betting and ranked combinations before modern poker standardized.',
    objective: 'Win the pot either by holding the strongest ranked hand at showdown or by causing all opponents to fold.',
    gameplay: 'Players receive hidden cards and bet on the strength of their combinations. Calling leads to comparison of ranked hands; folding concedes the pot. The small deck makes rank frequency and opponent behavior central.',
    keyRules: [
      'Uses a dedicated Persian As-Nas pack.',
      'Players bet, call, raise, or fold around hidden hands.',
      'Best ranked hand wins at showdown.',
      'A player can win uncontested if all others fold.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Two to five players can take part in a betting round.',
      deck: 'Use the traditional As-Nas pack, commonly twenty cards with five copies of ranked court-style cards.',
      equipment: 'Traditional 20 or 25-card As-Nas pack, score area, and enough table space for play.',
      dealing: 'Deal a small hand to each player, then conduct betting rounds around the table.',
    },
