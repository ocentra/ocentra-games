    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Ging',
            subtitle: 'Seventeenth-Century Declaration Game',
            content: [
              {
                type: 'paragraph',
                text: 'Ging, also called Seven Cards, is a 17th-century English declaration gambling game for four players using a 28-card stripped pack, where players claim counters for most suit points or sweeping special combinations.',
              },
              {
                type: 'paragraph',
                text: "Ging is known from Francis Willughby's 17th-century game collection and is also referenced as Seven Cards.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players clockwise, with eldest hand left of dealer and dealer as youngest hand.',
              },
              {
                type: 'paragraph',
                text: '28 cards made by removing aces and cards below seven from a standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'A square layout area and counters (chips).',
              },
              {
                type: 'paragraph',
                text: 'Each player contributes two counters to dress the layout, then dealer gives 7 cards to each player clockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Bankrupt End: Session can end when a player loses their last counter; remaining layout is then divided as agreed.',
                  },
                  {
                    text: 'Fixed Number of Deals: Alternative session structure plays a predetermined number of deals and splits pool at the end.',
                  },
                ],
              },
            ],
          },
        ],
      },
