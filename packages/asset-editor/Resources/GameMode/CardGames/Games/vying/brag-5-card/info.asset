  data: {
    hero: {
      title: '5-CARD BRAG',
      subtitle: 'The High-Powered Vyer',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: '5-Card Brag',
            subtitle: 'The High-Powered Vyer',
            content: [
              {
                type: 'paragraph',
                text: '5-Card Brag is a high-powered strategic variation of standard 3-Card Brag. In this version, every player is dealt five cards and must select the best three to form their Brag hand, discarding the other two. This choice phase leads to much higher average hand rankings (Running Flushes and Prials are common) and significantly reduces the luck of the draw. Once hands are set, play proceeds with the classic half-price blind betting and Brag hierarchies.',
              },
              {
                type: 'paragraph',
                text: 'Part of the traditional British multi-card Brag family, 5-Card Brag emerged as a way to provide more strategic depth than the original 3-card game. It shares roots with partition games like Crash and 9-Card Brag.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically 3 to 8 players playing individually.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack (No Jokers).',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, betting chips or currency.',
              },
              {
                type: 'paragraph',
                text: 'Every player contributes an ante. Dealer deals five cards face-down to each player. Players choose three to keep and place the other two face-down in a shared muck pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Brag with Braggers: Standard variant where J♣, 9♦, and A♦ are wild cards (Braggers).',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: '5-Card Brag is a high-powered strategic variation of standard 3-Card Brag. In this version, every player is dealt five cards and must select the best three to form their Brag hand, discarding the other two. This choice phase leads to much higher average hand rankings (Running Flushes and Prials are common) and significantly reduces the luck of the draw. Once hands are set, play proceeds with the classic half-price blind betting and Brag hierarchies.',
