    historyContent: {
      origins: 'Part of the traditional British multi-card Brag family, 5-Card Brag emerged as a way to provide more strategic depth than the original 3-card game. It shares roots with partition games like Crash and 9-Card Brag.',
      originCountries: [
        'United Kingdom',
      ],
      timeline: [
        'Mid-20th Century: Multi-card Brag variants gain popularity in British card clubs.',
        "1980s: Becomes a standard Dealer's Choice option in social gambling.",
        'Present: Popular in both physical card rooms and online implementations.',
      ],
      evolution: 'The game retains the core vying and blind-betting rules but introduces a pre-play hand optimization phase.',
      cultural: "Reflects the British preference for 'choice' based gambling games that allow for more tactical discarding.",
    },
    setupContent: {
      players: 'Typically 3 to 8 players playing individually.',
      deck: 'Standard 52-card French pack (No Jokers).',
