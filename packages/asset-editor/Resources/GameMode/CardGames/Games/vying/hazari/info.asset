    hero: {
      title: 'HAZARI',
      subtitle: 'The Thousand Point Challenge',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Hazari',
            subtitle: 'The Thousand Point Challenge',
            content: [
              {
                type: 'paragraph',
                text: "Hazari (meaning 'One Thousand') is a highly strategic partitioning game popular in Bangladesh and Bhutan. Players receive 13 cards and must divide them into four sets (composed of 3, 3, 3, and 4 cards). These sets are then compared against opponents' sets in a fixed order. The game combines the hand-ranking logic of Brag and Teen Patti with a unique structural challenge and a long-term scoring goal of 1000 points.",
              },
              {
                type: 'paragraph',
                text: "Originating in South Asia, Hazari is closely related to the British game 'Crash' (or Thirteen-card Brag). It has become the most popular card game in Bangladesh, often played in tea stalls and social clubs.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players playing individually.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace is high.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: 'Dealer deals 13 cards to each player in batches (e.g., 4-4-5 or all at once).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Hazarey (Bhutan): A variant popular in Bhutan with slightly different scoring for numeral cards.',
                  },
                ],
              },
            ],
          },
        ],
      },
