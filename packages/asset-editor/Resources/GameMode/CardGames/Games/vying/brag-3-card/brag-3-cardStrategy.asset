      {
        title: 'Tip',
        description: "Never 'See' your cards too early; the psychological pressure of a Blind player is your best weapon.",
      },
      {
        title: 'Tip',
        description: "If you are a Seeing player, don't chase a Blind bet unless you have at least a Flush.",
