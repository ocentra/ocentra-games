    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: '3-Card Brag',
            subtitle: "Britain's Poker",
            content: [
              {
                type: 'paragraph',
                text: "3-Card Brag is Britain's premier vying (betting) card game and a direct ancestor of modern Poker. Each player receives three cards and competes for a central pot. Its most distinctive feature is the 'Blind' betting system, where a player can bet without looking at their cards for half the cost, maintaining a psychological and mechanical advantage over 'Seeing' players. It is fast, aggressive, and deeply rooted in British pub and gambling traditions.",
              },
              {
                type: 'paragraph',
                text: 'Brag emerged in 16th-century England as a three-card vying game. It evolved into the parent of Indian Teen Patti and influenced the betting structures of early American Poker variants like Three-Card Poker.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically 3 to 8 players playing individually.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French pack (No Jokers).',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, betting chips or currency.',
              },
              {
                type: 'paragraph',
                text: 'Every player contributes an ante. Dealer deals three cards face-down to each player.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Brag with Braggers: Standard variant where J♣, 9♦, and A♦ are wild cards (Braggers).',
                  },
                ],
              },
            ],
          },
        ],
