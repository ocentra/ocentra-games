    displayName: 'claim-strategy',
    category: 'Game',
    gameId: 'claim',
    treePath: 'Resources/GameMode/CardGames/Games/Claim/claimStrategy.asset',
  },
  data: {
    strategyProfileId: 'claim.strategy.deterministic-bot.v1',
    mechanicsId: 'claim-hoarder',
    mechanicsVersion: '2.0.0',
    executorId: 'claim.bot.deterministic.v1',
    legalActionEvaluator: {
      inputs: ['public_state', 'own_private_hand', 'declared_suit', 'undeclared_debt', 'discard_top', 'stock_count', 'turn_flags'],
      outputs: ['declare_suit', 'discard_card', 'take_discard', 'take_stock', 'call_showdown', 'end_turn'],
      hiddenInformationPolicy: 'Bots only use their own hand plus public stock/discard/table state.',
    },
    botProfile: {
      deterministic: true,
      seedSource: 'mechanics.runtimeIntegration.deterministicSeed + round + playerId + handSize',
      preferredSuitPolicy: 'highest_same_suit_projected_score',
      declarationPolicy: 'declare at two cards in a preferred suit, after acting undeclared, or when risk/aggression thresholds allow early declaration',
      discardPolicy: 'discard lowest-liability off-suit card first; may keep blockers according to bluffFrequency',
      takePolicy: 'prefer discard top when it matches preferred suit; otherwise draw from stock if available',
      showdownPolicy: 'call when final score reaches mechanics showdown minimum adjusted by riskTolerance and aggressiveness',
      timeoutPolicy: 'timeout_turn uses the same debt rule as end_turn after action',
    },
    weights: {
      declaredSuitScore: 1,
      offSuitLiability: -1,
      undeclaredDebtAvoidance: 0.9,
      blockerValue: 0.25,
      discardTopSignalRisk: 0.35,
      stockUnknownValue: 0.45,
      showdownConfidence: 0.7,
    },
    LLM: '- Declare once you can protect a suit plan; every acted undeclared turn adds persistent debt.\n- Use discard-only turns to dump off-suit liability while staying above the three-card minimum.\n- Taking from discard is public information and can reveal what suit you are chasing.\n- Holding off-suit cards can block opponents, but those cards score against you at showdown.\n- A declared player should call showdown when final score is safely at least 27 after off-suit negatives and debt.\n- Watch stock and discard exhaustion because the round auto-showdowns when both are empty.\n',
    Player: '- Pick one suit to collect and declare it before debt gets too expensive.\n- Discard cards from other suits unless you are deliberately blocking someone.\n- You can take from stock or discard once per turn and discard once per turn.\n- Keep at least three cards. There is no maximum hand size, but big mixed hands can score badly.\n- Call Showdown only when your declared hand is worth at least 27 after penalties.\n',
    aggressiveness: 0.6,
    riskTolerance: 0.5,
    bluffFrequency: 0.25,
    bluffSettings: {
      default: 'A declaration is secret, so bluffing mostly happens through public stock/discard behavior.',
      frequency: 'Moderate deception should come from taking blockers and delaying obvious suit signals.',
      success: 'Successful misdirection can deny opponents key cards or trigger a profitable showdown.',
      failure: 'Failed deception leaves off-suit cards and undeclared debt in the player hand.',
    },
  },
}
