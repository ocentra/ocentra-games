    modelVersion: '1.0.0',
    familyKernel: 'claim',
    familyVariant: 'hoarder',
    executorId: 'claim.hoarder.v1',
    actionModel: {
      actionIds: [
        'take_stock',
        'take_discard',
        'discard_card',
        'declare_suit',
        'end_turn',
        'timeout_turn',
        'call_showdown',
      ],
      payloadSchemas: {
        declare_suit: {
          required: [
            'suit',
          ],
        },
        discard_card: {
          required: [
            'cardId',
          ],
        },
      },
      actionEndsTurn: {
        take_stock: false,
        take_discard: false,
        discard_card: false,
        declare_suit: false,
        end_turn: true,
        timeout_turn: true,
        call_showdown: true,
      },
    },
    actions: {
      take_stock: {
        supported: true,
        description: 'Take the public top card from the stock.',
        constraints: 'Current player only; at most one take per turn; stock must not be empty.',
        effectType: 'draw',
        cost: '0',
        effectHints: {
          sourceZone: 'stock',
          visibility: 'top_face_up',
        },
        isTerminating: false,
      },
      take_discard: {
        supported: true,
        description: 'Take the public top card from the discard pile.',
        constraints: 'Current player only; at most one take per turn; discard pile must not be empty.',
        effectType: 'draw',
        cost: '0',
        effectHints: {
          sourceZone: 'discard',
          visibility: 'top_face_up',
        },
        isTerminating: false,
      },
      discard_card: {
        supported: true,
        description: 'Discard one card from hand to the public discard pile.',
        constraints: 'Current player only; at most one discard per turn; player must keep at least 3 cards.',
        effectType: 'discard',
        cost: '0',
        effectHints: {
          destinationZone: 'discard',
          minHandSize: 3,
        },
        isTerminating: false,
      },
      declare_suit: {
        supported: true,
        description: 'Privately commit to a suit for this round.',
        constraints: 'Current player only; player must hold at least one card of the declared suit; declaration is locked.',
        effectType: 'declare',
        cost: '0',
        effectHints: {
          declarationType: 'secret_suit_contract',
          public: false,
        },
        isTerminating: false,
      },
      end_turn: {
        supported: true,
        description: 'Finish the current turn.',
        constraints: 'Adds highest-card debt if the player acted and still has not declared.',
        effectType: 'pass',
        cost: '0',
        effectHints: {
          appliesPenaltyIfUndeclared: true,
          timeoutSafeWhenNoAction: true,
        },
        isTerminating: true,
      },
      timeout_turn: {
        supported: true,
        description: 'Resolve timer expiry.',
        constraints: 'No-action timeout has no penalty; timeout after action counts as ending undeclared.',
        effectType: 'timeout',
        cost: '0',
        effectHints: {
          timerSeconds: 60,
        },
        isTerminating: true,
      },
      call_showdown: {
        supported: true,
        description: 'Force auto-reveal and scoring once the caller qualifies.',
        constraints: 'Caller must be declared, hold at least 3 cards, and have final score >= 27.',
        effectType: 'call_showdown',
        cost: '0',
        effectHints: {
          minimumFinalScore: 27,
          requiresDeclaration: true,
        },
        isTerminating: true,
      },
    },
    customActions: [
      {
        id: 'setup_round',
        supported: true,
        description: 'Shuffle, deal three cards to each active player, and leave discard empty.',
        cost: '0',
        constraints: 'System action at the start of each round.',
        effectType: 'setup_round',
        effectHints: {
          dealCountPerPlayer: 3,
          openingDiscard: false,
          dealerRole: 'rotating',
        },
        isTerminating: false,
      },
      {
        id: 'score_round',
        supported: true,
        description: 'Resolve Hoarder scoring, raw score deltas, winner-difference payouts, and bankruptcy.',
        cost: '0',
        constraints: 'System action after showdown or table exhaustion.',
        effectType: 'score_round',
        effectHints: {
          scoringType: 'claim_hoarder_circular_runs',
          settlement: 'raw_plus_positive_winner_differences',
        },
        isTerminating: false,
      },
    ],
  },
