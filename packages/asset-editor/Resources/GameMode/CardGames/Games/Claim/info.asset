                type: 'rule-block',
                content: [
                  {
                    type: 'heading',
                    level: 4,
                    text: 'Action 4: Showdown',
                  },
                  {
                    type: 'paragraph',
                    text: 'Call for a Showdown (must meet minimum 27 points requirement)',
                  },
