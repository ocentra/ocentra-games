    synthesisManifest: {
      lastSynthesizedAt: null,
      dependencies: [],
    },
    LLM: 'Claim is a four-player original card game using the Standard_52 deck asset and StandardCardRanking. Each active player starts a round with three cards and tries to build score in one privately declared suit. Off-suit cards and undeclared hands score negative. A player may take from stock or discard, discard while keeping at least three cards, declare one suit, and call showdown when their final score is at least 27.',
    Player: 'Claim is about choosing a suit, collecting that suit, and not getting trapped with cards you cannot score. You can wait to declare, but if you act while undeclared you collect debt that stays until showdown.',
    sections: [
      {
        type: 'about',
        tabLabel: 'How Claim Plays',
        pages: [
          {
            title: 'Overview',
            subtitle: 'The pilot rule set',
            content: [
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'heading',
                    level: 3,
                    text: 'Goal',
                  },
                  {
                    type: 'paragraph',
                    text: 'Collect cards in one suit, secretly declare that suit, and call Showdown once your final score is at least 27. Declared-suit cards score positive. All other suits score negative. Undeclared players score every card as negative.',
                  },
                  {
                    type: 'paragraph',
                    text: 'Claim is locked to four players. A player who runs out of bankroll becomes an observer. The match ends after ten rounds or when only one active player remains.',
                  },
                ],
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'How each round starts',
            content: [
              {
                type: 'setup-grid',
                items: [
                  {
                    label: 'Players',
                    value: '4',
                  },
                  {
                    label: 'Deck',
                    value: 'Standard 52 French',
                  },
                  {
                    label: 'Ranking',
                    value: 'A=14, K=13, Q=12, J=11, 2-10 face value',
                  },
                  {
                    label: 'Starting hand',
                    value: '3 cards',
                  },
                  {
                    label: 'Bankroll',
                    value: '1352',
                  },
                  {
                    label: 'Timer',
                    value: '60 seconds',
                  },
                ],
              },
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'paragraph',
                    text: 'Claim uses Resources/GameMode/CardGames/Decks/Standard_52.asset with Resources/GameMode/CardGames/CardRanking/StandardCardRanking.asset. There is no opening discard. The stock top and discard top are public zones on the table. The discard starts empty.',
                  },
                ],
              },
            ],
          },
          {
            title: 'Turn',
            subtitle: 'What a player can do',
            content: [
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'list',
                    style: 'unordered',
                    items: [
                      {
                        text: 'Take at most one card from stock or discard.',
                      },
                      {
                        text: 'Discard at most one card while keeping at least three cards.',
                      },
                      {
                        text: 'Declare one suit if holding at least one card in that suit.',
                      },
                      {
                        text: 'End the turn, or call Showdown if declared and qualified.',
                      },
                    ],
                  },
                  {
                    type: 'paragraph',
                    text: 'The take and discard can happen in either order. Discard-only and take-only turns are legal. A same-turn discard can be taken back if the player discards before taking.',
                  },
                  {
                    type: 'paragraph',
                    text: 'If a player acts and ends the turn undeclared, they add debt equal to the highest card currently in their hand. That debt persists even if the card is discarded later.',
                  },
                ],
              },
            ],
          },
          {
            title: 'Showdown And Scoring',
            subtitle: 'How points are counted',
            content: [
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'paragraph',
                    text: 'A declared player can call Showdown on their own turn with at least three cards and final score of 27 or higher. If stock and discard are both empty, the round auto-showdowns.',
                  },
                  {
                    type: 'list',
                    style: 'unordered',
                    items: [
                      {
                        text: 'Cards are grouped into maximal same-suit circular runs.',
                      },
                      {
                        text: 'Ace bridges both King and 2, so A-K-Q, 3-2-A, and K-A-2-3 are valid runs.',
                      },
                      {
                        text: 'Ace is worth 14, face cards are J=11, Q=12, K=13, and numbered cards use face value.',
                      },
                      {
                        text: 'Run score is sum of card values multiplied by run length.',
                      },
                      {
                        text: 'Singles score their face value.',
                      },
                      {
                        text: 'Declared suit groups are positive. Other suits are negative. Undeclared hands are all negative.',
                      },
                      {
                        text: 'Persistent undeclared debt is subtracted from the final score.',
                      },
                    ],
                  },
                ],
              },
              {
                type: 'example',
                title: 'Circular run example',
                text: 'A player declared Spades and holds A, K, 2, 3, 4, 5 of Spades. The whole set is one circular run: (14 + 13 + 2 + 3 + 4 + 5) * 6 = 246 positive points.',
              },
            ],
          },
          {
            title: 'Settlement',
            subtitle: 'How bankroll moves',
            content: [
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'paragraph',
                    text: 'Every player applies their raw final score directly to their bankroll. If the highest final score is positive, the winner also receives difference payouts against the other players. If top score is tied, tied winners share one payout pool. If every score is negative, there is no winner-difference payout.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'A four-player suit-collection card game about secret declaration, circular runs, debt, and aggressive showdown timing.',
    tagline: 'Declare your suit. Build your hand. Survive the debt.',
    tagline2: 'A fast original card-game pilot for the Ocentra shared mechanics system.',
    shortDescription: 'Four-player suit-collection showdown game.',
