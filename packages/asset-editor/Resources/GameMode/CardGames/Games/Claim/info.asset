      {
        type: 'scoring',
        tabLabel: 'Scoring',
        pages: [
          {
            title: "💰 Hoarder's Multiplier",
            subtitle: 'The core scoring system',
            content: [
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'heading',
                    level: 4,
                    text: 'For Players Who Declared a Suit',
                  },
                  {
                    type: 'list',
                    style: 'ordered',
                    items: [
                      {
                        text: 'Find all sequences of consecutive cards in your declared suit',
                      },
                      {
                        text: 'For each sequence: (Sum of card values) × (Number of cards)',
                      },
                      {
                        text: 'Total Positive Points = Sum of all sequence scores',
                      },
                      {
                        text: 'Subtract penalties from non-declared suit cards',
                      },
                      {
                        text: 'Final Score = Positive Points - Penalty',
                      },
                    ],
                  },
                ],
              },
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'heading',
                    level: 4,
                    text: 'Key Rules',
                  },
                  {
                    type: 'list',
                    style: 'unordered',
                    items: [
                      {
                        text: 'Sequences can wrap around (A-K or 3-2-A)',
                      },
                      {
                        text: 'Each sequence calculated separately',
                      },
                      {
                        text: 'Only cards of your declared suit count as positive',
                      },
                    ],
                  },
                ],
              },
            ],
          },
          {
            title: 'Scoring Example 1',
            subtitle: 'Multiple sequences',
            content: [
              {
                type: 'example',
