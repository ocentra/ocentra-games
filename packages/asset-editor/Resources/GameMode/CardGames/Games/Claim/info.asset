                    items: [
                      {
                        text: 'The dealer is not a player but a role that rotates',
                      },
                      {
                        text: 'Randomly select a player to act as the dealer',
                      },
                      {
                        text: 'Dealer shuffles and deals 3 cards to each player',
                      },
                      {
                        text: 'Remaining 40 cards form the draw pile',
                      },
                    ],
                  },
                ],
              },
            ],
