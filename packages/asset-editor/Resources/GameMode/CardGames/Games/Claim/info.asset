            ],
          },
          {
            title: 'Undeclared Players',
            subtitle: 'Heavy penalties',
            content: [
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'heading',
                    level: 4,
                    text: 'For Players Who Did NOT Declare',
                  },
