                    text: 'Action 2: Pass',
                  },
                  {
                    type: 'paragraph',
                    text: 'Decline the Floor Card (but accumulate penalty if not declared)',
                  },
                ],
              },
              {
                type: 'rule-block',
                content: [
                  {
                    type: 'heading',
                    level: 4,
                    text: 'Action 3: Declare',
                  },
                  {
                    type: 'paragraph',
                    text: 'Publicly commit to a suit. Two options:',
                  },
                  {
                    type: 'list',
                    style: 'unordered',
                    items: [
                      {
                        text: 'Partial: Simply declare a suit without showing cards',
                      },
                      {
                        text: 'Full: Place one or more face-up cards of the same suit',
