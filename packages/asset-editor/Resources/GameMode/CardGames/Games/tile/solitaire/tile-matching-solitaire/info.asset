        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Tile Matching Solitaire',
            subtitle: 'Solitaire',
            content: [
              {
                type: 'paragraph',
                text: 'Solitaire game using around 144 tiles (traditionally Mah Jong). Tiles are stacked in layers with horizontal rows; each row rests on the row below. Remove all tiles by taking matching pairs of exposed tiles (a tile is exposed when at the end of a row and not covered).',
              },
              {
                type: 'paragraph',
                text: 'Tile matching solitaire originated as a computer game and exists in many versions (e.g. Shanghai, Taipei, Kyodai), using Mah Jong or similar tiles in matching sets of four.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Single player. This solitaire is played by one person, who clears the layout by removing matching pairs of exposed tiles (tiles at the end of a row and not covered).',
              },
              {
                type: 'paragraph',
                text: 'Set of around 144 tiles (Mah Jong traditionally).',
              },
              {
                type: 'paragraph',
                text: 'Cards or tiles',
              },
              {
                type: 'paragraph',
                text: 'Tiles are stacked in layers; each layer has horizontal rows. Tiles in a row rest on the row below. Remove pairs of exposed (uncovered) matching tiles until the layout is clear.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Mahjong Connect: Pairs of tiles can only be removed if they can be connected by a clear orthogonal path, often with not more than a given number of right-angle bends.',
                  },
                ],
              },
            ],
          },
        ],
      },
