    tips: [
      {
        title: 'Tip',
        description: 'Wait for the dealer to take any mournivals from the pool first. Every card taken by the dealer is one less you can use to stay in the game.',
      },
      {
        title: 'Tip',
        description: "Pay attention to the ranks already captured. If all four Kings are captured, a King in your hand is a 'dead card' that will eventually force you to Lie Down.",
      },
      {
        title: 'Tip',
        description: 'The player to your left is your biggest threatâ€”watch what they capture to predict what ranks they no longer hold.',
      },
      {
        title: 'Tip',
        description: "If you have a prial (three of a kind), claim two immediately but keep the third as a 'save' card.",
