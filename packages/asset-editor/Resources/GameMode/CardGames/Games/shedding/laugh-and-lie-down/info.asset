    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Laugh and Lie Down',
            subtitle: "England's Ancient Fishing Game",
            content: [
              {
                type: 'paragraph',
                text: "Laugh and Lie Down is the earliest documented European fishing card game, dating back to 16th-century England. Played by five players, it is a game of capture where players aim to win pairs from a central pool. The game's name comes from its most famous mechanic: if a player cannot make a capture on their turn, they must discard their entire hand ('Lie Down') while the other players literally 'Laugh' at their misfortune.",
              },
              {
                type: 'paragraph',
                text: "First recorded in 1522 in a poem by John Skelton ('Why not to Court'). It is mentioned by Shakespeare and described in detail by Francis Willughby in his 17th-century 'Book of Games' (c. 1665), which is the only known historical description of the rules.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "5 players is the standard historical format (Willughby's rules). Easily adapted for 3-6 players.",
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ace is low for determining the dealer (lowest card deals).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck and counters for stakes.',
              },
              {
                type: 'paragraph',
                text: 'Deal 8 cards to each player (one at a time, face down). Place the remaining 12 cards face-up on the table as the pool. The pool cards should be clearly visible but not arranged in any particular order.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Four Player Variant: Pot of 9p (3-2-2-2). Deal 10 each and 12 to the table. Last in hand wins 3p. Win/lose 1p per 2 cards above or below 10.',
                  },
                  {
                    text: 'Three Player Variant: Pot of 10p (4-3-3). Deal 13 each and 13 to the table. Last in hand wins 5p. Win/lose 1p per 2 cards above or below 14.',
                  },
                  {
                    text: 'Six Player Variant: Pot of 13p (3-2-2-2-2-2). Deal 7 each and 10 to the table. Last in hand wins 5p. Win/lose 1p per 2 cards above or below 6.',
                  },
                  {
                    text: 'Tournament Version: Adaptation for tournament play with written scores. Mournivals go to eventual winner. Score 1 point per pair won in excess of original 8 cards.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
