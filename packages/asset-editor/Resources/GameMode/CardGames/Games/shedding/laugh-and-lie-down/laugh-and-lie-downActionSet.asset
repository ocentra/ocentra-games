        constraints: 'Only when you hold four of a kind before play begins.',
        isTerminating: false,
        effectType: 'play',
        id: 'claim_mournival',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play one card from hand to capture one table card of the same rank from the pool.',
        cost: '0',
        constraints: 'At least one table card of that rank must be in the pool.',
        isTerminating: false,
        effectType: 'play',
        id: 'capture_single',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play one card from hand to capture three table cards of the same rank; or play a pair from hand to capture a pair on the table.',
        cost: '0',
        constraints: 'For one card: three of that rank on table. For pair: a pair of that rank on table.',
        isTerminating: false,
        effectType: 'play',
        id: 'capture_three',
        effectHints: {},
      },
      {
        supported: true,
        description: 'When you cannot capture, add your entire hand face up to the pool and exit the round.',
        cost: '0',
        constraints: 'Only when no capture is possible (no card matches any table card or table is empty).',
        isTerminating: true,
        effectType: 'discard',
        id: 'lie_down',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Proceed to next player; round continues.',
        cost: '0',
        constraints: 'When more than one player still has cards in hand.',
        isTerminating: false,
        effectType: 'pass',
        id: 'continue',
        effectHints: {},
      },
      {
        supported: true,
        description: 'End the round and proceed to scoring.',
        cost: '0',
        constraints: 'When only one player has cards left in hand.',
        isTerminating: false,
        effectType: 'pass',
