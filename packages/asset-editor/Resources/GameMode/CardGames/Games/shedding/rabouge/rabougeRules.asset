  data: {
    LLM: 'Game: Crazy Eights. Logic: See rules.objective and rules.gameplay.',
    Player: 'Crazy Eights is a popular shedding card game, especially beloved by children. The objective is simple: be the first player to discard all your cards. Players take turns playing cards to a central discard pile, matching either the rank or suit of the top card. The eponymous "crazy" 8s are wild cards that can be played on anything and allow the player to change the suit.',
    objective: 'Discard all cards to the central pile before the other players.',
    gameplay: 'Players play cards from hand to a central pile according to the allowed sequence and pile rules. The game resembles an easier multiplayer relative of Russian Bank style patience.',
    keyRules: [
      'Any number of players may participate.',
      'The central pile is the main place where cards are shed.',
      'The first player to get rid of all cards wins.',
    ],
    bonusRuleGuids: [],
