    tips: [
      {
        title: 'Tip',
        description: "Don't build too many 'Draw 2' rules, or the deck will run out before anyone can win.",
      },
      {
        title: 'Tip',
        description: "Assign one player as the 'Rule Keeper' to prevent arguments about the wording of old rules.",
