    },
    historyContent: {
      origins: "Originating in Australia in the mid-20th century as a social variant of 'Eights' or 'Uno'. It was designed to maintain interest over long sessions by allowing the game to evolve, becoming more difficult as the night progressed.",
      originCountries: [
        'Australia',
      ],
      timeline: [
        '1950s: First recorded play in Sydney and Melbourne university circles.',
        "1970s: Becomes a popular choice in international hostels as 'Warthog'.",
        '2004: Widely published rules appear on online card game archives.',
        "Present: A staple of the 'Meta-Rule' genre, where the game design is part of the play.",
      ],
      evolution: "The game moved from oral tradition to a standardized format where the 'Rule List' is often transcribed on a piece of paper (or mentally tracked in 'Hardcore' modes).",
      cultural: 'Regarded as a test of mental endurance and creative trap-making.',
    },
    setupContent: {
      players: '2-12 players. Best with 4-6.',
      deck: 'One standard 52-card deck for 2-5 players. Two decks for 6 or more.',
      equipment: 'Standard pack, score sheet, and a pen/paper to record the new rules.',
      dealing: 'Dealer (rotating) deals 7 cards to each player. The next card is turned face up to start the discard pile; the remainder is the draw pile.',
    },
    variationsContent: {
      list: [
        {
          id: 'secret-bartok',
          name: 'Secret Bartok',
          description: 'Only the rule-maker knows the new rule. Others must deduce it through penalty cards (Mao-style).',
        },
        {
          id: 'progressive-bartok',
          name: 'Progressive Bartok',
          description: "Rules only last for 3 rounds then expire, preventing the 'rule-clog' of late games.",
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: "Forgets stacking rules 30% of the time. Fails to call 'Bartok'. Plays cards based only on suit/rank matching.",
        medium: "Maintains a 'Rule Array' and never forgets a rule. Predicts opponent needs. Strategic card saving.",
        hard: "Optimal Rule Design: When it wins, it creates rules that have the highest probability of triggering based on the current deck state. Expert at 'Linguistic Traps' if the game allows verbal rules.",
      },
      considerations: [
        'The engine must allow for dynamic rule injection (functions added to the play-logic at runtime).',
        "Requires a persistent 'Global Rules' state that modifiers can hook into.",
      ],
    },
