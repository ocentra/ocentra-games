  data: {
    hero: {
      title: 'BARTOK',
      subtitle: 'The Evolving Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bartok',
            subtitle: 'The Evolving Game',
            content: [
              {
                type: 'paragraph',
                text: "Bartok is a high-speed shedding game belonging to the Crazy Eights family, famous for its 'Meta-Game' mechanic. While it begins as a simple match-suit-or-rank contest, the winner of each round earns the right to add a new permanent rule to the game. These rules accumulate across rounds, turning a simple children's game into a complex, rule-heavy nightmare of memory and trap-setting. Unlike its more secretive cousin 'Mao', the new rules in Bartok are explicitly announced, but the sheer volume of stacking triggers quickly leads to chaos and penalties.",
              },
              {
                type: 'paragraph',
                text: "Originating in Australia in the mid-20th century as a social variant of 'Eights' or 'Uno'. It was designed to maintain interest over long sessions by allowing the game to evolve, becoming more difficult as the night progressed.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-12 players. Best with 4-6.',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card deck for 2-5 players. Two decks for 6 or more.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, score sheet, and a pen/paper to record the new rules.',
              },
              {
                type: 'paragraph',
                text: 'Dealer (rotating) deals 7 cards to each player. The next card is turned face up to start the discard pile; the remainder is the draw pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Secret Bartok: Only the rule-maker knows the new rule. Others must deduce it through penalty cards (Mao-style).',
                  },
                  {
                    text: "Progressive Bartok: Rules only last for 3 rounds then expire, preventing the 'rule-clog' of late games.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Bartok is a high-speed shedding game belonging to the Crazy Eights family, famous for its 'Meta-Game' mechanic. While it begins as a simple match-suit-or-rank contest, the winner of each round earns the right to add a new permanent rule to the game. These rules accumulate across rounds, turning a simple children's game into a complex, rule-heavy nightmare of memory and trap-setting. Unlike its more secretive cousin 'Mao', the new rules in Bartok are explicitly announced, but the sheer volume of stacking triggers quickly leads to chaos and penalties.",
    tags: [
      'card-game',
      'shedding',
      'traditional',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 12,
    routePath: 'bartok',
    LLM: "Game: Bartok. Type: Shedding Meta-Game. Rules: Match suit/rank. 7 cards each. Features: Penultimate card requires 'Bartok' call. Round winner creates a new permanent rule for subsequent rounds.",
    Player: "The 5 of Spades is on the pile. You have 3 cards. It's round 4, and remember the rule from round 2: 'You must clap before playing a Spade'. Do you have a match? And don't forget to call Bartok when you're down to your last card.",
    tagline: 'Win the round. Make the rules. Chaos is your ally.',
    gameCategory: 'Shedding',
    subcategory: 'Crazy Eights Variant',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '15-60 minutes',
    origin: 'Australia',
    originName: 'Bartok',
    deck: '52-card standard deck (use 104 for 6+ players)',
    alsoKnownAs: [
      'Bartog',
      'Warthog',
      'Rule Maker',
    ],
    playersDisplay: '2-12',
    quality: 'complete',
    completeness: {
