    tips: [
      {
        title: 'Tip',
        description: 'Sixes beat Aces in the Púkk hand ranking (not the Play ranking). This is a common point of confusion for beginners.',
      },
      {
        title: 'Tip',
        description: "If the board is 'Dressed' but not won, the chips carry over—be more aggressive when the pots are 'Fat'.",
