    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Konijnen',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Konijnen (Dutch for 'Rabbits') is a fast-paced, family-friendly shedding game popular in the Netherlands and Scandinavia (where it is known as 'Kanin'). The objective is to be the first to empty your hand by playing cards into numerical sequences on the table. It is known for its speed and the 'tactical shifting' rules that allow players to rearrange table piles to fit their cards.",
              },
              {
                type: 'paragraph',
                text: "Part of the broader European family of 'Solitaire-style' shedding games. It gained popularity in the Netherlands in the mid-20th century as a social game between neighbors.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 5 players; 3 to 4 is optimal.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are low (1).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are low (1).',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 7 to 10 cards. The remainder forms the draw pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Team Kanin: Played in teams; adds cooperation as partners work together to empty hands.',
                  },
                  {
                    text: 'Kanin with Jokers: Jokers included as wildcards; may represent any card in a sequence (e.g. Ace or 2 to start, or any rank to build).',
                  },
                  {
                    text: 'Basic (no shifting): No tactical shifting; players may only add to existing sequences or start new ones with A or 2, without rearranging table piles.',
                  },
                ],
              },
            ],
          },
        ],
      },
