    historyContent: {
      origins: "Part of the broader European family of 'Solitaire-style' shedding games. It gained popularity in the Netherlands in the mid-20th century as a social game between neighbors.",
      originCountries: [
        'Netherlands',
        'Norway',
      ],
      timeline: [
        '1950s: First variants emerge in Dutch social clubs.',
        '1980s: Standardized rules appear in Dutch family game anthologies.',
        '2010s: Gains a second life as a popular app-based game in Norway (Kanin).',
        "Present: A staple children's and family game in the Benelux region.",
      ],
      evolution: "The game evolved to allow for the 'Switch' rule, where players can break existing sequences to create new ones, adding a light mathematical challenge.",
      cultural: "The name 'Konijnen' likely refers to the speed of the gameâ€”players must 'hop' their turns quickly or lose their opportunity to play.",
