    tips: [
      {
        title: 'Tip',
        description: "Watch the table carefully! Sequences move fast and a pile that was a 3 might be a 10 by the time it's your turn again.",
      },
      {
        title: 'Tip',
        description: 'If playing with Jokers, use them as wildcards for 2s or Aces to get the game moving.',
