  data: {
    LLM: "1. Lead: Dealer's left leads any card to start the trick. 2. Follow: Players must follow suit if they hold a card of that suit. 3. Draw: If unable to follow suit, draw one-by-one until a playable card is found. 4. Joker: Can be played anytime to win the trick; if led, the next player sets the suit. 5. Next: Winner of the trick leads the next one. 6. Page One!: Call 'Page One!' when down to one card.",
    Player: "1. Lead: Dealer's left leads any card to start the trick. 2. Follow: Players must follow suit if they hold a card of that suit. 3. Draw: If unable to follow suit, draw one-by-one until a playable card is found. 4. Joker: Can be played anytime to win the trick; if led, the next player sets the suit. 5. Next: Winner of the trick leads the next one. 6. Page One!: Call 'Page One!' when down to one card.",
    objective: 'Be the first player to successfully shed all cards from your hand by playing them to the central pile.',
    gameplay: "1. Lead: Dealer's left leads any card to start the trick. 2. Follow: Players must follow suit if they hold a card of that suit. 3. Draw: If unable to follow suit, draw one-by-one until a playable card is found. 4. Joker: Can be played anytime to win the trick; if led, the next player sets the suit. 5. Next: Winner of the trick leads the next one. 6. Page One!: Call 'Page One!' when down to one card.",
    keyRules: [
      'Must follow the led suit if a playable card is held in the hand.',
      'If unable to follow suit, players must draw from the stock until a card of the led suit or Joker is obtained.',
      'The Joker always wins the trick; if led, the next card determines the suit for all following players.',
      "Players must declare 'Page One!' when playing their second-to-last card to avoid a five-card draw penalty.",
      'The first player to empty their hand of all cards wins the round immediately.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Typically four players sit in a circle; play and dealing proceed in a clockwise direction.',
