  data: {
    hero: {
      title: 'LAST ONE',
      subtitle: "Don't Forget to Call It!",
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Last One',
            subtitle: "Don't Forget to Call It!",
            content: [
              {
                type: 'paragraph',
                text: "Last One (also known as Last Card) is a popular shedding-type card game from the Crazy Eights family. Played across many Commonwealth countries, particularly New Zealand and Australia, it involves players trying to empty their hands by matching cards on a central pile. The game is famous for its 'special cards' that force opponents to draw or skip turns, and the mandatory requirement to announce 'Last One' when holding a single card.",
              },
              {
                type: 'paragraph',
                text: 'Dates to the early 20th century as a localized expansion of Crazy Eights. It gained popularity in New Zealand, Australia, the UK, and parts of the United States as a faster, more aggressive social game.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players (4-5 is optimal).',
              },
              {
                type: 'paragraph',
                text: "Standard 52-card deck + 2 Jokers. Jokers are typically 'Draw 5' or 'Draw 6' penalty cards.",
              },
              {
                type: 'paragraph',
                text: 'Standard deck and a flat surface.',
              },
              {
                type: 'paragraph',
                text: "Each player receives 7 cards (or 4-9 cards at dealer's choice). One card is turned up to start the discard pile. Remaining cards form the stock.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Crazy Eights: The American standard variant, typically with fewer special cards (usually just 8s as wilds).',
                  },
                  {
                    text: 'Mau-Mau: German variant with slightly different special card rules.',
                  },
                  {
                    text: 'UNO: Commercial proprietary version with custom cards and standardized rules.',
                  },
                  {
                    text: "Taki: Israeli variant with 'Super' cards and additional special actions.",
                  },
                  {
                    text: 'Switch: UK variant with Black Jack (draw 5) and Red Jack (cancel draw) rules.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Last One (also known as Last Card) is a popular shedding-type card game from the Crazy Eights family. Played across many Commonwealth countries, particularly New Zealand and Australia, it involves players trying to empty their hands by matching cards on a central pile. The game is famous for its 'special cards' that force opponents to draw or skip turns, and the mandatory requirement to announce 'Last One' when holding a single card.",
    tags: [
      'card-game',
      'shedding',
      'matching',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'last-one',
    LLM: "Game: Last One (Last Card). Shedding game. Match rank or suit to discard. Special cards: 2=draw 2, 3=play again, 4=melee sequence, 8=wild, J=skip, A=reverse, Joker=draw 5. Must call 'Last One' at 1 card or draw penalty. First to empty hand wins.",
    Player: "Welcome to Last One! Match cards by suit or rank, use special cards to mess with your opponents, and don't forget to yell 'Last One' when you have just one card leftâ€”or you'll draw a penalty! Watch out for 2s (draw 2), 8s (wild), and Jokers (draw 5). First to empty their hand wins!",
    tagline: 'Shed your cards, but remember to shoutâ€”or pay the price.',
    gameCategory: 'Shedding',
    subcategory: 'Matching / Eights Family',
    playerMode: 'multiplayer',
    difficulty: 'Beginner',
    duration: '10-20 minutes',
    origin: 'International (Commonwealth)',
    originName: 'Last One (Last Card)',
    deck: '52-card + 2 Jokers',
    alsoKnownAs: [
      'Last Card',
      'Mau-Mau',
      'Switch',
    ],
    playersDisplay: '2-6',
    quality: 'complete',
    completeness: {
