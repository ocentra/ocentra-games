    aiContent: {
      difficulty: {
        easy: "Fails to call 'Last One'; plays special cards too early; doesn't stack penalty cards; plays randomly without considering opponents' card counts.",
        medium: "Excellent special card timing; consistent suit tracking; remembers to call 'Last One'; uses 8s strategically to change suits favorably.",
        hard: "Expert at 'Last One' detection (never misses a penalty call); uses 8s to manipulate suit-denial; perfectly stacks 2s and Jacks; tracks opponent hand sizes to time penalty cards optimally; anticipates suit changes.",
      },
