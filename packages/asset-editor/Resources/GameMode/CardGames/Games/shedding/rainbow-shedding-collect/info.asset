    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Rainbow',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Rainbow is a vibrant, strategic card game that focuses on completing a spectrum of colors while avoiding 'Clouds'. Players place cards into a shared central line to build a six-color rainbow. It is a game of careful hand management and risk assessment: if you add a duplicate color or a cloud card to the line, you are forced to collect all the cards currently on the table (which is bad for scoring). The winner is the player who collects the most 'Natural' rainbows or the fewest penalty cards, depending on the variant.",
              },
              {
                type: 'paragraph',
                text: "Developed by Piatnik and other European manufacturers in the late 20th century as a 'Pure' color-focused alternative to number-heavy games like UNO.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Optimal at 2 or 3.',
              },
              {
                type: 'paragraph',
                text: '60-72 card specialized deck (6 colors x 10 cards + 6 Wilds + 6 Clouds).',
              },
              {
                type: 'paragraph',
                text: '60-72 card specialized deck (6 colors x 10 cards + 6 Wilds + 6 Clouds).',
              },
              {
                type: 'paragraph',
                text: "Each player starts with 6 cards. A central 'Rainbow Line' starts empty.",
              },
            ],
          },
        ],
      },
