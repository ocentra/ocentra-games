    hero: {
      title: 'Donkey (South Indian)',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Donkey (South Indian)',
            subtitle: 'Trick-taking rules and play flow',
            content: [
              {
                type: 'paragraph',
                text: "Donkey (known as 'Kazhuda' in Tamil/Malayalam or 'Gaadida' in Telugu) is a popular shedding card game played in South India. Unlike many Western card games where winning a trick is desirable, in Donkey, the goal is simply to get rid of your cards. Failing to follow suit results in the 'Donkey' penalty: taking all the cards from the current trick into your hand.",
              },
              {
                type: 'paragraph',
                text: "Donkey is a localized variant of the international family of 'Get Away' or 'Spoons' games. It has been a staple in Indian households for generations, specifically across Tamil Nadu, Kerala, Andhra Pradesh, and Karnataka.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 6 players. Best with 4.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck (Jokers removed).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck of cards.',
              },
              {
                type: 'paragraph',
                text: 'All cards are dealt out as equally as possible. Some players may have one card more than others.',
              },
            ],
          },
        ],
      },
    ],
