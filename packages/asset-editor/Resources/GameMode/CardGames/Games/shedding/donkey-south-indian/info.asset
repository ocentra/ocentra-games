    historyContent: {
      origins: "Donkey is a localized variant of the international family of 'Get Away' or 'Spoons' games. It has been a staple in Indian households for generations, specifically across Tamil Nadu, Kerala, Andhra Pradesh, and Karnataka.",
      originCountries: [
        'India',
      ],
      timeline: [
        '20th Century: Becomes a standard family game across the Indian subcontinent.',
        'Modern Era: Often played by children and students during festivities or social gatherings.',
      ],
      evolution: "The game evolved to emphasize the 'shame' of being the last player (the Donkey), often involving lighthearted penalties or nicknames for the loser.",
      cultural: "In South India, the game is highndenergy and vocal, with players shouting 'Kazhuda!' (Donkey) as soon as someone is forced to pick up cards.",
    },
