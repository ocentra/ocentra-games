    historyContent: {
      origins: "Eleusis was created by Robert Abbott, a mathematician and puzzle designer. It first gained international fame when it was featured in Martin Gardner's 'Mathematical Games' column in Scientific American (June 1959).",
      originCountries: [
        'United States',
      ],
      timeline: [
        "1956: First conceived by Abbott as a 'poker-like' reasoning game.",
        '1959: Published in Scientific American; becomes a cult classic among mathematicians.',
        "1970s: Abbott releases 'The New Eleusis' with revised scoring and the 'Prophet' mechanic.",
        'Present: Taught in science and logic courses to demonstrate the scientific method.',
      ],
      evolution: "The game evolved from a simple hidden-rule game to a complex social interaction where 'God' must balance the difficulty of the rule to maximize their own score.",
      cultural: 'Often cited as the ultimate example of a game that mimics the process of scientific discovery and pattern recognition.',
    },
