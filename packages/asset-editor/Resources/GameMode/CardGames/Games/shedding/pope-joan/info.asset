    historyContent: {
      origins: 'Dates back at least to the 1700s. It is named after the mythical female Pope Joan (the Nine of Diamonds), reflecting 18th-century anti-clerical humor.',
      originCountries: [
        'UK',
      ],
      timeline: [
        "1730s: First mentioned in gaming literature as a derivation of the French game 'ComÃ¨te'.",
        "1837: Charles Dickens famously describes a game of Pope Joan in 'The Pickwick Papers'.",
        '1900s: Gradually declined in popularity as games like Rummy and Bridge took over the social scene.',
        'Present: A favorite for historical reenactment groups and collectors of antique game boards.',
      ],
      evolution: "The removal of the 8 of Diamonds was a deliberate mechanic to create a 'Stop' at the 7 of Diamonds, ensuring the 9 of Diamonds (the Pope) would always be a special card.",
      cultural: 'In Victorian England, Pope Joan boards were often elaborate family heirlooms made of lacquered wood or papier-mÃ¢chÃ©.',
    },
