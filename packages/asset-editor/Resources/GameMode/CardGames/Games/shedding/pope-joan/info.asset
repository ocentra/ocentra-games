    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pope Joan',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Pope Joan is a quintessentially English historical card game that was immensely popular in the 18th and 19th centuries. A 'Stops' game played with a specialized rotating board, it blends sequence-building with 'Lucky Card' rewards. The game centers on the 'Pope Joan' cardâ€”the Nine of Diamondsâ€”which serves as a permanent wild card. It is a game of social interaction, anticipation, and the thrill of clearing a 'Stakes' board.",
              },
              {
                type: 'paragraph',
                text: 'Dates back at least to the 1700s. It is named after the mythical female Pope Joan (the Nine of Diamonds), reflecting 18th-century anti-clerical humor.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Optimal at 4 or 5.',
              },
              {
                type: 'paragraph',
                text: '52 cards, REMOVE the 8 of Diamonds.',
              },
              {
                type: 'paragraph',
                text: 'Staking board with eight compartments (Ace, King, Queen, Jack, Game, Pope, Matrimony, Intrigue); counters or chips.',
              },
              {
                type: 'paragraph',
                text: "Deal the cards evenly, plus an extra hand (the 'Stop' hand) which remains face-down.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Standard stakes: Dealer places six counters in Pope, two each in Matrimony and Intrigue, one in each of Ace, King, Queen, Jack, Game.',
                  },
                  {
                    text: 'Agreed counter value: Counter or chip value is agreed by the players before the game.',
                  },
                  {
                    text: 'Split Matrimony or Intrigue: When King-Queen or Queen-Jack of trumps are in different hands, stakes in those compartments are sometimes divided.',
                  },
                ],
              },
            ],
          },
        ],
      },
