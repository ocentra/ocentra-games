    historyContent: {
      origins: "Dates to the early 1900s. It was popularized as a 'social' card game that simplified the complexity of Bridge or Whist, adding a more humorous 'hot potato' element with the penalty Jacks.",
      originCountries: [
        'United Kingdom',
        'USA',
      ],
      timeline: [
        '1910s: First appears in English card game anthologies.',
        '1950s: Becomes a staple family game in the UK.',
        'Present: Occasionally played as a lighter alternative to Hearts or Skat.',
      ],
      evolution: "The game's point structure (Positive for tricks, Negative for Jacks) was designed to prevent 'sandbagging' (winning no tricks), a common issue in pure-avoidance games.",
      cultural: "The word 'Knave' is the archaic English term for a Jack, and the game preserves this terminology to emphasize the cards as 'villains'.",
    },
    setupContent: {
