        rules: {
          objective: 'Score points for tricks won while avoiding winning tricks that contain Jacks.',
          gameplay: '1. Standard trick-taking. Must follow suit. If unable, play any card.\n2. No trumps are used.\n3. Highest card of the led suit wins the trick.',
          keyRules: [
            'Each trick won: +1 point',
            'Knave of Hearts: -20 points',
            'Knave of Diamonds: -15 points',
            'Knave of Clubs: -10 points',
            'Knave of Spades: -5 points',
            'Must follow suit',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Avoid high cards in the Heart suit. Since the Knave of Hearts is the most expensive penalty, holding the Ace or King of Hearts is a major risk.',
          intermediate: "The 'Trick Buffer': Since each trick is worth +1 point, you can afford to take a few 'clean' tricks to offset the -5 penalty of the Knave of Spades. Never take a Heart trick if you can avoid it.",
          advanced: 'Voiding for Safety: Try to exhaust one suit (e.g., Clubs) as quickly as possible. This allows you to discard your high cards in other suits safely throughout the hand.',
          tips: [
            'Pay attention to who won the last trick. If a player is leading Hearts, they are likely trying to flush out the Knave from someone else.',
            "If you are forced to win a trick, try to ensure it doesn't contain a Jack by leading a low card in a suit where you think others have high cards.",
          ],
          hasPlaceholders: false,
        },
