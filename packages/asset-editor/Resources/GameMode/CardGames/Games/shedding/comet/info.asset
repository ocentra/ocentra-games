            title: 'Comet',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Comet is an old French stops-family card game for two to five players, formerly called Manille and renamed after the appearance of Halley's Comet in 1682.",
              },
              {
                type: 'paragraph',
                text: 'Comet descends from the 17th-century French Hoc family, especially Hoc de Mazarin, and its sequential shedding phase influenced later stops games.',
              },
            ],
          },
