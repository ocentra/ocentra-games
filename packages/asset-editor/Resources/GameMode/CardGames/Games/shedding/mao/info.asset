    historyContent: {
      origins: 'Its exact origin is shrouded in mystery, intentional or otherwise. It appeared in various US university campuses in the 1960s and 70s.',
      originCountries: [
        'USA',
        'Germany',
      ],
      timeline: [
        "1960s: Mao emerges as an underground 'cult' game in academic circles.",
        "1980s: Variations appear with names like 'Mau' or 'The Game of the Great Helmsman'.",
        'Present: A staple of theater troupes, summer camps, and math/science olympiads.',
        "2004: Standardized 'Public' Mao rules are occasionally published, much to the annoyance of purists.",
      ],
      evolution: "The game's rules are deliberately kept unwritten to preserve the 'Rite of Passage' aspect for new players.",
      cultural: 'Often associated with surrealist humor and a lighthearted disdain for authority.',
    },
    setupContent: {
      players: "3-8 players. One player is the 'Chairman' (dealer/moderator).",
      deck: 'Two shuffled standard decks. All cards face down.',
