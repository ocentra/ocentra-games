        tabLabel: 'About',
        pages: [
          {
            title: 'Fool (Milton Bradley)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Fool is a classic card game published by Milton Bradley (MB Games) that combines shedding mechanics with bluffing and social deduction. Similar to 'Cheat' or 'I Doubt It', the objective is to discard all your cards by playing them face-down and declaring their rank. However, if another player suspects you are lying, they can shout 'Fool!'. It is a fast-paced game of deception, memory, and psychological warfare.",
              },
              {
                type: 'paragraph',
                text: "Derived from the much older international game 'Cheat' (also known as Bullshit). Milton Bradley branded it as 'Fool' to make it a family-friendly parlor game.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-5 players is optimal.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards.',
              },
              {
                type: 'paragraph',
                text: 'The entire deck is dealt out to all players as evenly as possible.',
              },
            ],
          },
        ],
      },
