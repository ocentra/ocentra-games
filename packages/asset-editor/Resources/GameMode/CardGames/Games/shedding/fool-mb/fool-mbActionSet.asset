    customActions: [
      {
        supported: true,
        description: 'Play one or more cards face-down onto the center pile and declare they are the current required rank (Aces, then 2s, 3s, up to Kings, then back to Aces). You may lie; if challenged and caught you take the pile; if the challenger is wrong they take the pile.',
        cost: '0',
        constraints: 'Must declare the current rank in sequence. Must play at least one card. First player typically starts with Aces.',
        isTerminating: false,
        effectType: 'play',
        effectHints: {
          from: 'hand',
          to: 'trick',
        },
        id: 'play_declare',
      },
      {
        supported: true,
        description: 'Challenge the previous play by calling Fool. The played cards are revealed. If the declarer was lying they take the entire center pile; if the declarer was truthful you take the pile.',
        cost: '0',
        constraints: 'Only the next player may challenge before play continues.',
        isTerminating: false,
        effectType: 'play',
        effectHints: {
          target: 'trick',
        },
        id: 'call_fool',
      },
      {
        supported: true,
        description: 'Do not challenge; accept the declaration and let play continue to the next player in rank order.',
        cost: '0',
        constraints: 'Available when it is your turn to respond to the previous play.',
        isTerminating: false,
        effectType: 'play',
        effectHints: {},
        id: 'accept_declaration',
      },
      {
        supported: true,
        description: 'Game ends; no player action required. First player to empty hand wins.',
        cost: '0',
        constraints: 'System phase; triggered when a player has no cards left.',
        isTerminating: true,
        effectType: 'play',
        effectHints: {},
        id: 'end_game',
      },
