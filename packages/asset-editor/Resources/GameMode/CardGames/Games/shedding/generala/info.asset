    hero: {
      title: 'GENERALA',
      subtitle: 'Cameroon Elimination Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Generala',
            subtitle: 'Cameroon Elimination Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Generala is a Cameroonian multi-player elimination card game played in tricks with a 54-card deck including two jokers. Players try to shed all cards; in each game the last player with cards is eliminated from the next game of the series.',
              },
              {
                type: 'paragraph',
                text: 'First English rules were published in August 2011 from a report by Alexey Lobashev, who learned the game from Takam Ludovic Thierry; a corrected version was published in August 2012 after clarifying misunderstood trick and pickup rules. The game is a popular family game in Cameroon.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 10 players.',
              },
              {
                type: 'paragraph',
                text: 'One 54-card international pack with two jokers.',
              },
              {
                type: 'paragraph',
                text: 'No extra equipment required.',
              },
              {
                type: 'paragraph',
                text: 'Deal all cards one by one counterclockwise. Some players may receive one more card than others.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Series Elimination: Standard multi-player form where loser of each game sits out next game until one champion remains.',
                  },
                  {
                    text: 'Two-Player Loop: With two players, each individual game has a winner and loser; loser deals next game.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
