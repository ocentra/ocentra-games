            content: [
              {
                type: 'paragraph',
                text: 'Ligretto is a commercial real-time shedding game where players race simultaneously to play numbered color cards to shared piles.',
              },
              {
                type: 'paragraph',
                text: 'The current form was designed by Michael Michaels and published in 1988 by Rosengarten Spiele; later editions were published by Schmidt-Spiele and Playroom Entertainment.',
              },
