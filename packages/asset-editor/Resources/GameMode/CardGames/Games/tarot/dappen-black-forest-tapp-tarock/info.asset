  data: {
    hero: {
      title: 'DAPPEN',
      subtitle: 'Black Forest Tarock',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Dappen Black Forest Tapp Tarock',
            subtitle: 'Black Forest Tarock',
            content: [
              {
                type: 'paragraph',
                text: "Dappen is a complex trick-taking Tarock game for 6 or 7 players, traditional to the Upper Black Forest region of southwest Germany. It is played with Cego cards and features one player (the 'Dappener') playing alone against a team formed by all other participants, using a 12-card talon known as the 'Dapp'.",
              },
              {
                type: 'paragraph',
                text: 'Dappen originated in the early 19th century in the Upper Black Forest region of Germany. It remained a local oral tradition, undocumented by card game scholars outside the region until 2024.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 6\nMaximum Players: 7\nOptimal Players: 6 or 7\nPartnerships: One vs. Team',
              },
              {
                type: 'paragraph',
                text: 'Type: Cego Tarot deck\nNumber of Cards: 54 (22 trumps/Tarocks, 32 suit cards)\nSuits: French (Clubs, Spades, Hearts, Diamonds)',
              },
              {
                type: 'paragraph',
                text: '54 Cego cards, scoring chips or paper.',
              },
              {
                type: 'paragraph',
                text: 'A 12-card talon (Dapp) is dealt first (usually in two batches of 6). The remaining cards are dealt to the players (7 cards each for 6 players, 6 cards each for 7 players).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Furtwangen (Klausmann): Full rules with Solo and Dappen bidding, compulsory dappen, Ulti, gstiesieren, and full or half game scoring.',
                  },
                  {
                    text: 'Breitnau: No compulsory dappen; if all pass the hand is thrown in. No Ulti or gstiesieren. Stupfen (push) over strecken. Payment: difference from 40 multiplied by contract factor then rounded up to next 10.',
                  },
                  {
                    text: 'Buchenbach: Six players only. Extra bids: Ein Hannes (one king), Zwei Hannes (two kings), Geiß (trump 1). First three tricks: Gstieß, then 21, then 1 must be played by holder; others must play 1-point trumps if able.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Dappen is a complex trick-taking Tarock game for 6 or 7 players, traditional to the Upper Black Forest region of southwest Germany. It is played with Cego cards and features one player (the 'Dappener') playing alone against a team formed by all other participants, using a 12-card talon known as the 'Dapp'.",
