    historyContent: {
      origins: 'Dappen originated in the early 19th century in the Upper Black Forest region of Germany. It remained a local oral tradition, undocumented by card game scholars outside the region until 2024.',
      originCountries: [
        'Germany',
      ],
      timeline: [
        'Early 19th Century: Game emerges in the Upper Black Forest.',
        '1800s-1900s: Traditional play continues in families and social clubs in southwest Germany.',
        '20th Century: Related to other regional Tarock games like Cego and Dreierles.',
        '2024: Formally documented and researched by card game historians.',
      ],
      evolution: 'Dappen is historically related to the Swiss game Troggu (played in Canton Wallis) and is one of the four genuine games played with Cego cards in the Baden region.',
      cultural: 'It is a popular social and family game in specific villages of the Upper Black Forest, often played in tournaments since at least 2017.',
    },
    setupContent: {
      players: 'Minimum Players: 6\nMaximum Players: 7\nOptimal Players: 6 or 7\nPartnerships: One vs. Team',
      deck: 'Type: Cego Tarot deck\nNumber of Cards: 54 (22 trumps/Tarocks, 32 suit cards)\nSuits: French (Clubs, Spades, Hearts, Diamonds)',
      equipment: '54 Cego cards, scoring chips or paper.',
      dealing: 'A 12-card talon (Dapp) is dealt first (usually in two batches of 6). The remaining cards are dealt to the players (7 cards each for 6 players, 6 cards each for 7 players).',
    },
    variationsContent: {
      list: [
        {
          id: 'furtwangen',
          name: 'Furtwangen (Klausmann)',
          description: 'Full rules with Solo and Dappen bidding, compulsory dappen, Ulti, gstiesieren, and full or half game scoring.',
        },
        {
          id: 'breitnau',
          name: 'Breitnau',
          description: 'No compulsory dappen; if all pass the hand is thrown in. No Ulti or gstiesieren. Stupfen (push) over strecken. Payment: difference from 40 multiplied by contract factor then rounded up to next 10.',
        },
        {
          id: 'buchenbach',
          name: 'Buchenbach',
          description: 'Six players only. Extra bids: Ein Hannes (one king), Zwei Hannes (two kings), Geiß (trump 1). First three tricks: Gstieß, then 21, then 1 must be played by holder; others must play 1-point trumps if able.',
        },
      ],
      noVariationsReason: '',
    },
