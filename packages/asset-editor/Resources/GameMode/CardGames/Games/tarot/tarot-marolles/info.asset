    historyContent: {
      origins: 'Michel de Marolles, Abbot of Villeloin, recorded in 1637 that he played Tarot at Nevers with Princess Louise-Marie de Gonzague-Nevers (later Queen of Poland). She had added innovations and asked him to have the rules printed; these are the oldest known printed Tarot rules.',
      originCountries: [
        'France',
      ],
      timeline: [
        '1637: Rules printed in Nevers (Regles dv iev des tarots).',
        '18th century: Similar three-player Tarot spread in Europe.',
      ],
      evolution: "Princess Marie-Louise's version used a 66-card pack and had all three players discard before play; the 78-card variant (25 each to opponents, 28 to dealer, dealer discards 3) may be the earlier form.",
      cultural: 'Played in French aristocratic circles; Nevers lay between Paris and Lyon.',
    },
    setupContent: {
      players: 'Three players, each playing for themselves; no partnerships.',
