        pages: [
          {
            title: 'Neunzehnerrufen',
            subtitle: 'Austrian tarock game',
            content: [
              {
                type: 'paragraph',
                text: 'Neunzehnerrufen is a four-player Austrian tarock partnership game in the Industrie und Glueck family. It uses a 54-card deck and distinguishes itself by calling Tarock XIX in partner contracts rather than calling a king.',
              },
              {
                type: 'paragraph',
                text: 'Neunzehnerrufen appears in tarot-family references as a regional tarock game in the broader Industrie und Glueck tradition.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players, usually in temporary partnership structures determined by called contracts.',
              },
              {
                type: 'paragraph',
                text: '54-card Industrie und Glück pack with 22 permanent trumps and 32 suited cards.',
              },
              {
                type: 'paragraph',
                text: 'Tarock deck and score tracking.',
              },
              {
                type: 'paragraph',
                text: 'Cards are dealt with a talon packet according to local rules before contract decisions and trick play.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
