    customActions: [
      {
        supported: true,
        description: 'Place six cards from the deal into the talon (middle). Dealt in packets: first 6 to each player, then 6 to talon, then 6 more to each player.',
        cost: '0',
        constraints: 'Dealer only; during deal phase.',
        isTerminating: false,
        effectType: 'deal',
        id: 'form_talon',
        effectHints: {},
      },
      {
        supported: true,
        description: "Name a suit; the holder of the king of that suit becomes declarer's partner but does not reveal themselves until the king is played. Legal to call own king (play alone vs three).",
        cost: '0',
        constraints: 'Declarer only; in contracts that allow a partner (Rufer, Solo, Besserrufer).',
        isTerminating: false,
        effectType: 'play',
        id: 'call_king',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Talon is shown in two sets of three. Declarer chooses one set, adds to hand, and discards three face-down into own tricks. Other set goes to opponents. Kings and Trull (Sküs, XXI, I) may never be discarded.',
        cost: '0',
        constraints: 'Declarer only; in contracts that allow talon exchange (Rufer, Sechserdreier, Besserrufer, Dreier, Farbendreier).',
        isTerminating: false,
        effectType: 'play',
        id: 'talon_exchange',
        effectHints: {},
      },
      {
        supported: true,
        description: "Declare a bonus (e.g. Pagat Ultimo, Trull, Valat) for double value, or say kontra/rekontra to double opponents' game or bonus. Round continues until three consecutive passes.",
        cost: '0',
        constraints: "After talon exchange; declarer starts. Bonus announcements only if partner is known or you are declarer's partner.",
        isTerminating: false,
        effectType: 'play',
        id: 'announce',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a card of the suit led. Required if you hold that suit.',
        cost: '0',
        constraints: 'When you have at least one card of the led suit; must follow suit if possible.',
        isTerminating: false,
        effectType: 'play',
        id: 'follow_suit',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a trump when you cannot follow suit. You must play a trump if you have no card of the led suit.',
        cost: '0',
        constraints: 'When you cannot follow suit; trumps beat any led suit (except in Farbensolo/Farbendreier).',
        isTerminating: false,
        effectType: 'play',
        id: 'trump',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Sum card points in tricks: each set of three cards sum values minus 2; one or two odd cards count one less than their total. Pack totals 70 points.',
        cost: '0',
        constraints: 'After all 12 tricks played; determines whether declarer made contract (36+ in positive).',
        isTerminating: false,
        effectType: 'play',
        id: 'count_points',
        effectHints: {},
      },
