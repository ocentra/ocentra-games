    customActions: [
      {
        supported: true,
        description: 'Place two packets of 3 cards face down in the middle of the table to form the talon (at start of deal or between the two rounds of 6 cards).',
        cost: '0',
        constraints: 'Dealer only; during deal phase.',
        isTerminating: false,
        effectType: 'deal',
        id: 'form_talon',
        effectHints: {},
      },
      {
        supported: true,
        description: "Say 'Erster' (first) to pass the bid without undertaking a contract; if first player says Erster and all others pass, a Fahren is played.",
        cost: '0',
        constraints: 'First player only in bidding; alternative to bidding a contract.',
        isTerminating: false,
        effectType: 'pass',
        id: 'erster',
        effectHints: {},
      },
      {
        supported: true,
        description: "Name a King; the holder of that King is the bidder's partner (in Rufer). If the called King is in the talon or in the bidder's hand, bidder plays alone.",
        cost: '0',
        constraints: 'Bidder only after a Rufer bid; before talon exchange.',
        isTerminating: false,
        effectType: 'bid',
        id: 'call_king',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Take 3 or 6 cards from the talon (according to contract), add to hand, and discard same number face down. In Rufer/Dreier choose one 3-card packet; in Sechserdreier take all 6. 5-point cards and most trumps cannot be discarded.',
        cost: '0',
        constraints: 'Bidder only after bidding; discard rules restrict which cards may be discarded.',
        isTerminating: false,
        effectType: 'draw',
        id: 'talon_exchange',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Announce a bonus (Trull, Four Kings, Pagat Ultimo, Uhu, King Ultimo, Valat) to double its score if made, or announce Kontra/Rekontra/Subkontra to double game or bonus scores.',
        cost: '0',
        constraints: 'In announcement round after discard; Spatz/Uhu/King Ultimo only by holder of the card.',
        isTerminating: false,
        effectType: 'declare',
        id: 'announce',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a card of the suit that was led when possible.',
        cost: '0',
        constraints: 'Must follow suit if able; otherwise must play a Tarock if holding any.',
        isTerminating: false,
        effectType: 'play',
        id: 'follow_suit',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a Tarock when unable to follow suit; must trump if you have no card of the led suit.',
        cost: '0',
        constraints: 'Only when unable to follow suit and holding at least one Tarock.',
        isTerminating: false,
        effectType: 'play',
        id: 'trump',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Add up the value of counting cards in tricks (and talon share) for your team; total is 71, 36+ wins the game.',
        cost: '0',
        constraints: 'After all 12 tricks are played.',
        isTerminating: false,
        effectType: 'custom',
        id: 'count_points',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Compute net game points from contract result and bonuses (won or lost); losers pay winners (e.g. stake per game point).',
        cost: '0',
        constraints: 'After counting points and checking bonuses.',
        isTerminating: false,
        effectType: 'custom',
        id: 'calculate_scores',
        effectHints: {},
      },
