    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Zwanzigerrufen',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Zwanzigerrufen ('Call the Twenty') is an Austrian Tarot game. 4 players. 40-card deck (from 54-card Industrie und Glück). 20 Tarocks + 20 suit cards. Declarer calls Tarock XX to find secret partner. Win 45+ of 88 card points. Simpler than Königrufen. Trull cards: Pagát(I), Mond(XXI), Sküs = 5pts each.",
              },
              {
                type: 'paragraph',
                text: "Zwanzigerrufen (or Zwanz'gerrufen) is the leading trick-taking Tarock game in many regions of eastern Austria. It belongs to the European Tarot card game family and uses a 40-card pack derived from the 54-card Industrie und Glück deck. The game is simpler than Königrufen, which is more widely played across Austria, and has been a major regional variant since the 20th century. It influenced Hungarian Tarokk and related Central European Tarock games.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '40 cards: 20 Tarocks (I-XXI minus II,III + Sküs) + 20 suit.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: "Dealer shuffles; player to dealer's left cuts. Each player receives 10 cards in two packets of five, forehand first. No talon. Optionally, cutter may knock and dealer places four stacks of 10 for players to choose from, forehand first.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Trischaken: Optional forehand contract variant in some Zwanzigerrufen circles.',
                  },
                  {
                    text: 'Zusammenwerfen: Optional rule: after deal, players may throw in all cards (no tarocks, or only Trulls) and same dealer redeals; game does not count.',
                  },
                ],
              },
            ],
          },
        ],
      },
