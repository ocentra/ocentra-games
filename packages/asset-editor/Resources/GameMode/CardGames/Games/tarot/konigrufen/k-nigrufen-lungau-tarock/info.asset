        pages: [
          {
            title: 'Königrufen Lungau Tarock',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Königrufen Lungau Tarock is a streamlined version of Austrian Tarock played in the Salzburger Lungau region. It features regular tournaments and simplified rules compared to traditional Königrufen. The reduced choice of contracts and simplified card counting lead to a sharper game where valuable cards are more important relative to empty cards.',
              },
              {
                type: 'paragraph',
                text: 'Developed in the Lungau region of Salzburg as a tournament-friendly variant of KÃ¶nigrufen. The streamlined rules were designed to make the game faster and more suitable for competitive play.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four active players. Five can participate with dealer sitting out each hand.',
              },
              {
                type: 'paragraph',
                text: 'Standard Austrian 54-card Tarock pack: 22 trumps (Tarocks), 8 cards each in four suits.',
              },
              {
                type: 'paragraph',
                text: 'Standard Austrian 54-card Tarock pack: 22 trumps (Tarocks), 8 cards each in four suits.',
              },
              {
                type: 'paragraph',
                text: "Dealer shuffles, player to left cuts. Deal 12 cards to each player in batches of 6, anticlockwise, starting with player to dealer's right. Place two packets of 3 cards face down in middle as talon.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Five Players: Dealer sits out each hand. Otherwise same rules.',
                  },
                  {
                    text: 'Solorufer Variant: Some regions play with Solorufer (Solo Rufer) as an additional contract.',
                  },
                  {
                    text: 'Tournament Rules: Specific scoring and timing rules for official Lungau tournaments.',
                  },
