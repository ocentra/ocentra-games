    historyContent: {
      origins: 'Developed in the Lungau region of Salzburg as a tournament-friendly variant of KÃ¶nigrufen. The streamlined rules were designed to make the game faster and more suitable for competitive play.',
      originCountries: [
        'Austria',
      ],
      timeline: [
        '19th Century: Traditional KÃ¶nigrufen played throughout Austria',
        'Early 20th Century: Lungau variant develops with simplified rules',
        '1990s: Regular tournaments established in Lungau',
        'Present: One of the most competitive Tarock variants in Austria',
      ],
      evolution: "The Lungau variant simplified the complex contract hierarchy of traditional KÃ¶nigrufen, reducing the number of available contracts and standardizing bonus values. The 'Fahren' (Trischaken) contract became the default when all players pass, adding tension to the bidding phase.",
      cultural: 'The Lungau region hosts prestigious Tarock tournaments. The game is considered a sharper, more tactical version of KÃ¶nigrufen due to the increased importance of high-value cards.',
    },
