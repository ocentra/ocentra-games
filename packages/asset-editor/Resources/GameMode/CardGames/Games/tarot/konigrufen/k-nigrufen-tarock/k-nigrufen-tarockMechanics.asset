    customActions: [
      {
        supported: true,
        description: 'Place six cards into the talon (middle) during the deal. Deal is in packets of six: one to each player, one to talon, then another six to each player.',
        cost: '0',
        constraints: 'Dealer only; during deal phase.',
        isTerminating: false,
        effectType: 'deal',
        id: 'form_talon',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Name a contract (e.g. Rufer, Solo, Bettel) to bid. Auction runs anticlockwise; must bid higher than previous bidder if lower priority, or equal/higher if higher priority. Last bidder becomes declarer.',
        cost: '0',
        constraints: 'When it is your turn in bidding; once passed you may not re-enter.',
        isTerminating: false,
        effectType: 'bid',
        id: 'bid_contract',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Forehand may reserve the right to name any contract by saying Mein Spiel. If all others pass, forehand then names a contract (only case Rufer, Trischaken, Sechserdreier are available).',
        cost: '0',
        constraints: 'Forehand only; at start of bidding.',
        isTerminating: false,
        effectType: 'bid',
        id: 'mein_spiel',
        effectHints: {},
      },
      {
        supported: true,
        description: "Declarer names a suit; the holder of the king of that suit becomes declarer's partner but does not reveal. If declarer holds three kings they may call the fourth without naming suit. If called king is in talon, declarer plays alone.",
        cost: '0',
        constraints: 'Declarer only; in contracts that allow a partner (Rufer, Solo, Besserrufer).',
        isTerminating: false,
        effectType: 'declare',
        id: 'call_king',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Talon is exposed in two sets of three. Declarer chooses one set and adds to hand; other set goes to opponents. Declarer discards three cards face down (kings and Trull cards may never be discarded).',
        cost: '0',
        constraints: 'Declarer only; in contracts that allow talon exchange (e.g. Rufer, Dreier).',
        isTerminating: false,
        effectType: 'draw',
        id: 'talon_exchange',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Declarer starts; each player may pass or announce a bonus (e.g. Pagat Ultimo, Trull) or say kontra/rekontra to double scores. Round continues until three consecutive passes.',
        cost: '0',
        constraints: "During announcement phase; bonus announcements only if you are declarer's partner or side is known.",
        isTerminating: false,
        effectType: 'declare',
        id: 'announce_bonuses',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a card of the suit led when you have one. If you cannot follow suit you must play a trump (except in Farbensolo/Farbendreier where trumps do not win).',
        cost: '0',
        constraints: 'When playing to a trick; must follow suit if possible.',
        isTerminating: false,
        effectType: 'play',
        id: 'follow_suit',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a tarock (trump). Required when you cannot follow suit (unless leading trumps is forbidden and you have other cards). In negative contracts must beat highest card on table if possible; Pagat only when last trump.',
        cost: '0',
        constraints: 'When playing to a trick; must trump if cannot follow suit.',
        isTerminating: false,
        effectType: 'play',
        id: 'play_tarock',
        effectHints: {},
      },
      {
        supported: true,
        description: "Count card points in tricks: each set of three cards sum minus 2; one or two odd cards worth one less than total. Pack totals 70. Declarer's side needs 36+ in positive contracts.",
        cost: '0',
        constraints: 'After all tricks are played; at start of scoring phase.',
        isTerminating: false,
        effectType: 'custom',
        id: 'count_points',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Settle game points: losing team pays winning team the game score per player. In solo contracts declarer pays or is paid by each opponent. Bonuses (Trull, birds, etc.) scored independently; kontras double announced scores.',
        cost: '0',
        constraints: 'After counting; each partnership pays or receives according to contract and bonuses.',
        isTerminating: false,
        effectType: 'award',
        id: 'calculate_payments',
        effectHints: {},
      },
