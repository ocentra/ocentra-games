    historyContent: {
      origins: "Developed in the late 19th and early 20th centuries as Hungarian players sought to add more tactical variety to the traditional Paskievics-tarokk. It became the 'Illustrated' version because of the numerous 'figures' (bonuses) that decorate the scoring sheet.",
      originCountries: [
        'Hungary',
      ],
      timeline: [
        "1900-1920: Scoring bonuses like 'Uhu' and 'Kismadár' are added to the basic game.",
        '1950s: Rules are standardized for tournament play.',
        'Present: The standard variant for serious competitive Hungarian Tarokk players.',
      ],
      evolution: "The game shifted focus toward anticipating and declaring bonuses. A player receiving a powerful hand doesn't just try to win; they try to 'illustrate' their hand by declaring as many bonuses as possible.",
      cultural: "Regarded as the 'Queen of Games' in Hungary; requires deep focus and partnership intuition.",
    },
    setupContent: {
      players: '4 players in hidden partnerships (established by calling the XX).',
