  data: {
    hero: {
      title: 'TAROCCHI SICILIANO',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Tarocchi Siciliano',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Tarocchi Siciliano (Sicilian Tarot) is a traditional card game played with a unique 63-card deck. It features ranks and suits distinct from other Tarot decks (Portuguese-style pips). The game is a point-trick game, often played by 4 players. Features the 'Fugitive' (Fool) and 'Miseria' (low trump).",
              },
              {
                type: 'paragraph',
                text: 'Developed in Sicily; retained Portuguese-style suits after they disappeared elsewhere.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '63 cards: 4 suits (King, Queen, Knight, Page, 10-5, Coins has 4) + 21 Trumps + Fugitive.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: 'Deal varies by variant.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Mineo three-player: 20 cards each, 3-card monte; soloist takes monte and discards three. Solo or abandon with mischio/pago/prendo. Vado solo possible after 5 or 20 cards.',
                  },
                  {
                    text: 'Mineo four-player: 15 cards each, 3-card monte. Bidding: pass, chiamo (call a trump for secret partner), or vado solo. Caller names highest trump not held; holder is partner.',
                  },
                  {
                    text: 'Barcellona: Three- or four-player versions; Barcellona four-player uses all 64 cards, 16 each, no monte, fixed or individual play.',
                  },
                  {
                    text: 'Tortorici: Three-player Vanto: chiamo or solo; four-player with fixed partnerships, dealer takes monte.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
