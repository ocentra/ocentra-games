    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Tarocchi Bolognesi',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Tarocchi Bolognesi (or Tarocchino Bolognese) refers to the family of games played with the specific 62-card Tarot deck from Bologna. The most common variant is Ottocento, but the term covers the deck and system itself. The deck removes ranks 2-5 from each suit of a standard Tarot pack.',
              },
              {
                type: 'paragraph',
                text: 'The Tarocco Bolognese is one of the oldest tarot decks in continual use. Tarocchi were mentioned in connection with Bologna by 1442 and in Bologna itself by 1459. The deck was reduced from 78 to 62 cards during the 16th century by removing ranks 2 to 5 from each suit; in 1725 the imperial and papal trumps were converted to four Moors. The deck and its games have historically been confined to Bologna.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two to six depending on variant; Ottocento (the main game) is for four players in fixed partnerships, two against two.',
              },
              {
                type: 'paragraph',
                text: '62 cards: Trumps 0-20 + Matto. 4 Suits (10 cards each).',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: 'Depends on variant.',
              },
            ],
          },
        ],
      },
