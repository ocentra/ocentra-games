    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Piedicavallo Tarocchi',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Piedicavallo Tarocchi is a rare and highly localized variant of Italian Tarot played exclusively in the Valle Cervo of the Piedmont region. It uses a modified 62-card 'Tarocco Piemontese' deck. The game is famous for its 'Open Communication' system, where partners are legally allowed to speak to each other and signal their cards (using taps and code words) as long as the information is audible to the opponents. It is a game of deep tactical coordination, memory, and traditional heritage.",
              },
              {
                type: 'paragraph',
                text: 'Rooted in the 15th-century tradition of Tarot (Tarocchi), specifically the Piedmontese branch. Piedicavallo developed its own dialect and rule-variants due to its isolation in the Alpine valleys.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two teams. Partners sit opposite.',
              },
              {
                type: 'paragraph',
                text: '62 cards (22 trumps + 40 suit cards). Low cards (1-4 Swords/Batons, 7-10 Cups/Coins) are removed.',
              },
              {
                type: 'paragraph',
                text: '62 cards (22 trumps + 40 suit cards). Low cards (1-4 Swords/Batons, 7-10 Cups/Coins) are removed.',
              },
              {
                type: 'paragraph',
                text: "Dealer gets 17 cards, others 15 cards. The dealer discards 2 cards face-down (the 'Scarto').",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Tournament pick-up: In tournament play, players other than the dealer may not pick up their cards until after the dealer has discarded.',
                  },
                  {
                    text: 'Informal pick-up: In informal games, players usually pick up and sort their cards as soon as they are dealt, before the dealer discards.',
                  },
                  {
                    text: 'Tie break: If the result is a tie after four deals, two more deals are played to decide the winner.',
                  },
                ],
              },
            ],
          },
        ],
      },
