    historyContent: {
      origins: 'Rooted in the 15th-century tradition of Tarot (Tarocchi), specifically the Piedmontese branch. Piedicavallo developed its own dialect and rule-variants due to its isolation in the Alpine valleys.',
      originCountries: [
        'Italy',
      ],
      timeline: [
        '1700s: Standard Tarocco Piemontese rules circulate in Turin.',
        '1800s: Piedicavallo valley residents adapt the deck to 62 cards (removing specific low suits).',
        "1970s: The 'Communal Talk' rules are documented as a unique cultural asset.",
        'Present: Designated as a UNESCO Intangible Heritage activity in the Biella province.',
      ],
      evolution: "The game removed several low-rank 'Scartini' (cards of little value) to speed up play and focus on the power of the Trumps (Tarocchi).",
      cultural: "Played in local cafes (osterie) with a specific Piedmontese vocabulary (e.g., 'Batto' for 'I have the high card').",
    },
    setupContent: {
      players: '4 players in two teams. Partners sit opposite.',
      deck: '62 cards (22 trumps + 40 suit cards). Low cards (1-4 Swords/Batons, 7-10 Cups/Coins) are removed.',
