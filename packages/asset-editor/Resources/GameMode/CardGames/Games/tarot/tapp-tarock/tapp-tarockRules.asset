  data: {
    LLM: 'Game: Tapp Tarock. Logic: rules.objective and rules.gameplay; Tarock point scoring and contract values.',
    Player: 'Tapp Tarock is a three-player Austrian Tarock game. Deal 16 each and 6 in the talon. Bid Dreier, Unterer, Oberer, or Solo. Declarer exchanges with three talon cards in lower contracts or plays alone in Solo. Follow suit or trump; declarer needs 36 points to win.',
    objective: 'As declarer, score at least 36 card points (35⅔ rounded up) from tricks and talon to win the contract; defenders win if declarer fails. Optional announcements (win last trick with Trump I, or Valat) add bonus risk and reward.',
    gameplay: 'Bidding: Forehand opens; players pass or bid Dreier, Unterer, Oberer, or Solo in ascending order; overcall or hold. Highest bidder is declarer. In Dreier/Unterer/Oberer the declarer exposes both talon halves, picks one, discards three cards (no Kings or Trull; tarocks only if no option, then shown to defenders); unused half counts to defenders. In Solo, talon is set aside for defenders. Announcements: win last trick with Trump I, or Valat (win every trick). Play: Anticlockwise from forehand. Must follow suit if able; otherwise must play a trump; otherwise may discard. Scoring: Tarock packet scheme; declarer needs 36+ points to win.',
    keyRules: [
      'Follow suit if able; otherwise trump; otherwise discard.',
      'Declarer needs 36 card points to win (70 total, 35⅔ rounded up).',
      'Discards may not include Kings or Trull (Sküs, Mond, or Trump I).',
      'Game values: Dreier 3, Unterer 4, Oberer 5, Solo 8, Valat 12 or 24 if announced.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
