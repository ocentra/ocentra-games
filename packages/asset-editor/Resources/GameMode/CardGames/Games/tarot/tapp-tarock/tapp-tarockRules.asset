    icon: '🃏',
  },
  data: {
    LLM: 'Bidding: Forehand opens; players pass or bid Dreier, Unterer, Oberer, or Solo in ascending order; overcall or hold. Highest bidder is declarer. In Dreier/Unterer/Oberer the declarer exposes both talon halves, picks one, discards three cards (no Kings or Trull; tarocks only if no option, then shown to defenders); unused half counts to defenders. In Solo, talon is set aside for defenders. Announcements: win last trick with Trump I, or Valat (win every trick). Play: Anticlockwise from forehand. Must follow suit if able; otherwise must play a trump; otherwise may discard. Scoring: Tarock packet scheme; declarer needs 36+ points to win.',
    Player: 'Bidding: Forehand opens; players pass or bid Dreier, Unterer, Oberer, or Solo in ascending order; overcall or hold. Highest bidder is declarer. In Dreier/Unterer/Oberer the declarer exposes both talon halves, picks one, discards three cards (no Kings or Trull; tarocks only if no option, then shown to defenders); unused half counts to defenders. In Solo, talon is set aside for defenders. Announcements: win last trick with Trump I, or Valat (win every trick). Play: Anticlockwise from forehand. Must follow suit if able; otherwise must play a trump; otherwise may discard. Scoring: Tarock packet scheme; declarer needs 36+ points to win.',
    objective: 'As declarer, score at least 36 card points (35⅔ rounded up) from tricks and talon to win the contract; defenders win if declarer fails. Optional announcements (win last trick with Trump I, or Valat) add bonus risk and reward.',
    gameplay: 'Bidding: Forehand opens; players pass or bid Dreier, Unterer, Oberer, or Solo in ascending order; overcall or hold. Highest bidder is declarer. In Dreier/Unterer/Oberer the declarer exposes both talon halves, picks one, discards three cards (no Kings or Trull; tarocks only if no option, then shown to defenders); unused half counts to defenders. In Solo, talon is set aside for defenders. Announcements: win last trick with Trump I, or Valat (win every trick). Play: Anticlockwise from forehand. Must follow suit if able; otherwise must play a trump; otherwise may discard. Scoring: Tarock packet scheme; declarer needs 36+ points to win.',
    keyRules: [
      'Follow suit if able; otherwise trump; otherwise discard.',
      'Declarer needs 36 card points to win (70 total, 35⅔ rounded up).',
      'Discards may not include Kings or Trull (Sküs, Mond, or Trump I).',
      'Game values: Dreier 3, Unterer 4, Oberer 5, Solo 8, Valat 12 or 24 if announced.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Three players. Seating and first dealer may be determined by lot.',
      deck: '54-card Industrie und Glück Tarot pack: 22 trumps (Sküs, XXI down to I) and 32 suit cards in four French suits (K, Q, Cavalier, Jack, and four pip cards per suit). Black suits rank K>Q>C>J>10>9>8>7; red suits K>Q>C>J>1>2>3>4.',
      equipment: '54-card Austrian Tarock deck, score sheet or chips.',
      dealing: "Dealer shuffles and offers cut. Top six cards are placed face down in two crosswise packets of three as the talon. Then 16 cards to each player anticlockwise in packets of four, starting with forehand (to dealer's right). If the cutter knocks, all 16 are dealt in one packet.",
    },
    turnFlow: 'Bidding: Forehand opens; players pass or bid Dreier, Unterer, Oberer, or Solo in ascending order; overcall or hold. Highest bidder is declarer. In Dreier/Unterer/Oberer the declarer exposes both talon halves, picks one, discards three cards (no Kings or Trull; tarocks only if no option, then shown to defenders); unused half counts to defenders. In Solo, talon is set aside for defenders. Announcements: win last trick with Trump I, or Valat (win every trick). Play: Anticlockwise from forehand. Must follow suit if able; otherwise must play a trump; otherwise may discard. Scoring: Tarock packet scheme; declarer needs 36+ points to win.',
    moveValidityConditions: {
      ante: 'Tapp Tarock has no ante; scoring is by contract and card points.',
      deal: 'Dealer only at start of hand.',
      reveal_market: 'This game has no market; talon is used by declarer in non-Solo contracts.',
      buy_market: 'Players do not buy from a market.',
      buy_stock: 'No stock purchase; talon is exchanged by declarer only.',
      fold: 'Trick-taking game; no fold action.',
      check: 'No betting or check.',
