    historyContent: {
      origins: 'Dobbm is a hyper-local tradition centered in the village of Fulpmes. It was documented in 1996 by John McLeod and Remigius Geiser.',
      originCountries: [
        'Austria',
      ],
      timeline: [
        'Traditional: Played for generations in the Stubai Valley.',
        '1960s: Transition from Salzburger pattern cards to Doppeldeutsche (Tell) cards.',
        '1996: formally documented for card game historians at Gasthof Jenewein.',
      ],
      evolution: 'Related to Brixental Bauerntarock and Zuger Tapp. It remains popular in Fulpmes while being virtually unknown in neighboring valleys like Wipptal.',
      cultural: 'Used as a major social catalyst in the Stubaital region across all generations.',
    },
    setupContent: {
