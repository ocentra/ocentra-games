          {
            title: 'Andar Bahar',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Andar Bahar is a traditional Indian banking game of pure chance from Bangalore, Karnataka. One card is dealt face up (house card); players bet on Andar (inside) or Bahar (outside). The dealer deals alternately to each pile until a card matching the house card's rank appears; that pile wins. Also known as Mangatha or Ullae Veliyae in Tamil.",
              },
              {
                type: 'paragraph',
                text: 'Originated in Bengaluru (Bangalore), Karnataka. Also known in Tamil as Mangatha or Ullae Veliyae.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Dealer banks; any number of players bet',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Table, chips',
              },
              {
                type: 'paragraph',
                text: 'One card dealt face up (house card). If house card is black, first card goes to Andar; if red, to Bahar. Then cards dealt alternately to Andar and Bahar until match.',
              },
            ],
          },
        ],
