    tips: [
      {
        title: 'Tip',
        description: 'The House edge comes entirely from splits. Even on an even-money game, you face a ~1.4% house edge on average due to splits.',
      },
      {
        title: 'Tip',
        description: "Never play against a 'gaffed' (cheating) dealing box. Optical tricks, thumb movements, and mechanical boxes can manipulate outcomes.",
      },
      {
        title: 'Tip',
        description: 'If tracking becomes overwhelming, simply avoid splits by betting only on ranks with very few cards remaining.',
      },
      {
        title: 'Tip',
        description: 'The psychological edge: Bankers profit by inducing players to chase losses. Maintain discipline and quit when ahead.',
