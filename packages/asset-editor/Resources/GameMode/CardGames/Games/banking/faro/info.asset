    aiContent: {
      difficulty: {
        easy: 'Places random bets on any layout rank; ignores Case Keeper; frequently bets on exhausted cards.',
        medium: 'Consults Case Keeper before each bet; avoids exhausted cards; makes standard 1:1 bets on remaining ranks.',
        hard: "Calculates exact split probability for every rank based on remaining cards. Optimizes bet placement to favor low-split-probability ranks. Uses Calling the Turn strategically. Models the rare case where deck skew makes certain ranks mathematically favored despite House edge. Recognizes 'gaffed' patterns in dealing box.",
      },
