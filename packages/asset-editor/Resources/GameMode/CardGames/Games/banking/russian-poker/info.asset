    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Russian Poker',
            subtitle: 'Casino Poker',
            content: [
              {
                type: 'paragraph',
                text: 'Russian Poker is a casino game (not traditional poker). Player vs house. Ante, 5 cards dealt. Dealer must qualify with A-K or better; if not, bets cancelled. Player bets on beating dealer. Payout table. Option to exchange cards or buy 6th. Unusual: two different combinations from 5 or 6 cards can be paid. 1990s Russian casinos.',
              },
              {
                type: 'paragraph',
                text: 'The game first appeared in Russia in the early 1990s, soon after the dissolution of the Soviet Union. At that time newly rich Russian gamblers were given VIP status and casino managers encouraged play with new games; in this context Russian Poker was developed. Boris Smith contributed the documented rules and history. Exact place and date of invention are not known.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Dealer (house) + up to 6 players (boxes).',
              },
              {
                type: 'paragraph',
                text: 'A single standard 52-card pack is used; no jokers.',
              },
              {
                type: 'paragraph',
                text: 'Table. Cards.',
              },
              {
                type: 'paragraph',
                text: '5 each. Dealer qualifies A-K+.',
              },
            ],
          },
        ],
      },
    ],
