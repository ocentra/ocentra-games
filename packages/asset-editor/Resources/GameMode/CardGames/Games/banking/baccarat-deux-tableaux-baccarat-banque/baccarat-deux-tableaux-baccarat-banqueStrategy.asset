    tips: [
      {
        title: 'Tip',
        description: "In Banque, the Banker's edge is slightly higher than in Chemin de Fer because they have more information before making their final move.",
      },
      {
        title: 'Tip',
        description: "Watch the 'Representative Player'. Their drawing patterns (especially on 5s) tell you everything about the tableau's strength.",
