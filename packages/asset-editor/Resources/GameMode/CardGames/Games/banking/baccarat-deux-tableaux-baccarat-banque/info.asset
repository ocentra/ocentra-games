    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Baccarat Banque',
            subtitle: 'The Grand Baccarat',
            content: [
              {
                type: 'paragraph',
                text: "Baccarat Banque (also known as Baccarat à Deux Tableaux) is the most prestigious and intellectually challenging form of Baccarat. Played at massive kidney-shaped tables in Europe's most exclusive casinos, it features a single Banker who handles the shoe and plays against two separate hands—representing the left and right sides of the table—simultaneously. It is a game of immense bankrolls, complex drawing choices, and high-altitude gambling psychology.",
              },
              {
                type: 'paragraph',
                text: 'The oldest form of Baccarat, dating back to 19th-century France. While Chemin de Fer was for private salons, Baccarat Banque was the game of the great public casinos in Vichy, Dieppe, and Monte Carlo.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "Variable. One Banker, sitting in the middle. Players sit at 'Tableau 1' (Left) and 'Tableau 2' (Right).",
              },
              {
                type: 'paragraph',
                text: 'Three standard 52-card decks shuffled together (156 cards).',
              },
              {
                type: 'paragraph',
                text: "Oval baccarat table with two betting wings, a massive shoe, and a Banker's palette.",
              },
              {
                type: 'paragraph',
                text: 'The Banker deals three hands: one for the players on the left, one for the players on the right, and one for themselves.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Banque Limitée: The Banker specifies a fixed amount they are willing to risk; once gone, the bank closes.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Baccarat Banque (also known as Baccarat à Deux Tableaux) is the most prestigious and intellectually challenging form of Baccarat. Played at massive kidney-shaped tables in Europe's most exclusive casinos, it features a single Banker who handles the shoe and plays against two separate hands—representing the left and right sides of the table—simultaneously. It is a game of immense bankrolls, complex drawing choices, and high-altitude gambling psychology.",
