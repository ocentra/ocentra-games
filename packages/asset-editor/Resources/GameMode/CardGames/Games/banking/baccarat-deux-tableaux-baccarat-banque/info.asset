    historyContent: {
      origins: 'The oldest form of Baccarat, dating back to 19th-century France. While Chemin de Fer was for private salons, Baccarat Banque was the game of the great public casinos in Vichy, Dieppe, and Monte Carlo.',
      originCountries: [
        'France',
      ],
      timeline: [
        '1800s: Standardized in French gambling law.',
        "1910: Becomes the 'king of games' in the Mediterranean gaming circuit.",
        "1953: Ian Fleming meticulously describes Bond's session against Le Chiffre in 'Casino Royale'.",
        'Present: Still played in elite circles in London and the French Riviera, though Punto Banco has overtaken its volume.',
      ],
      evolution: "The transition from 3 decks (Banque) to 6 or 8 decks (Chemin de Fer / Punto Banco) changed the math, but the 'Two Tableau' layout remains the peak of 'Old World' gambling.",
      cultural: "Symbolizes the ultimate confrontation between the 'Bank' (capital) and the 'Table' (the public).",
    },
    setupContent: {
      players: "Variable. One Banker, sitting in the middle. Players sit at 'Tableau 1' (Left) and 'Tableau 2' (Right).",
