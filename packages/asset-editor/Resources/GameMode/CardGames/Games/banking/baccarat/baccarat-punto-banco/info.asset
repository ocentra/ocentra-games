        pages: [
          {
            title: 'Baccarat Punto Banco',
            subtitle: 'The Vegas & Macau Standard',
            content: [
              {
                type: 'paragraph',
                text: 'Baccarat Punto Banco is the modern casino form of Baccarat. Players bet on the Player hand, Banker hand, or tie; after the wager, all drawing decisions are automatic and resolved by the table rules.',
              },
              {
                type: 'paragraph',
                text: 'Developed in Havana, Cuba in the 1940s as a simplified, casino-banked version of Baccarat. It removed the rotating banker and player choices found in Chemin de Fer.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: "Up to 14 players at a 'Big Table' or 7 at a 'Mini' table.",
              },
              {
                type: 'paragraph',
                text: '8 decks shuffled into a single shoe.',
              },
              {
                type: 'paragraph',
                text: 'Baccarat table with Punto (Player) and Banco (Banker) betting areas, shoe, indicator markers, and scorecards (Roadmaps).',
              },
              {
                type: 'paragraph',
                text: "Two cards are dealt face-up (or face-down to be squeezed) for 'Player' and 'Banker'.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Mini-Baccarat: A faster, lower-limit version played on a standard blackjack-sized table where the dealer handles all cards.',
                  },
                  {
                    text: 'Super 6 / No Commission: Winning Banker bets pay 1:1 unless the Banker wins with a 6, which pays 50% of the bet.',
                  },
                ],
              },
            ],
          },
        ],
      },
