        pages: [
          {
            title: 'Indonesian Baccarat',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Indonesian Baccarat (locally known as Bakarat) refers to the standard European Baccarat game as played and adapted in Indonesian card rooms and social gambling circles. It is a game of pure chance where players bet on the 'Player' or 'Banker' hands to reach a total closest to nine.",
              },
              {
                type: 'paragraph',
                text: 'Baccarat was introduced to Indonesia via international trade and colonial influence. It became a staple in private clubs and regulated casinos (when they were operational).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Multiple bettors against a Banker (Dealer).',
              },
              {
                type: 'paragraph',
                text: 'Typically 8 standard decks (~416 cards) shuffled together.',
              },
              {
                type: 'paragraph',
                text: 'Typically 8 standard decks (~416 cards) shuffled together.',
              },
              {
                type: 'paragraph',
                text: 'Dealer shuffles 6–8 standard decks; two cards each to Player and Banker (and optional side bets).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Punto Banco: Standard house-banked form; fixed tableau; no player choices. Indonesian play often follows this.',
                  },
                  {
                    text: 'Mini-baccarat: Smaller table, lower minimums; same rules; popular with casual and Asian-market players.',
                  },
                  {
                    text: 'Tie and side bets: Local tie-payout and Southeast Asian side bets (e.g. Dragon, pairs) vary by venue.',
                  },
                ],
              },
            ],
          },
        ],
