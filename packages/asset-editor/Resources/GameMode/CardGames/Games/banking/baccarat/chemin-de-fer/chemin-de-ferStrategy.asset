    gameId: 'chemin-de-fer',
    icon: '💡',
  },
  data: {
    LLM: "As the Player, always draw on a 0-4 and stand on 6-7. On a 5, the standard tactical choice is to draw, but standing can be used as a bluff to make the Banker think you have a 6 or 7.\n\nAs the Banker, monitor the Punters' patterns. If a Punter always draws on a 5, you know they hold a 0-5 hand. If they stand, they likely have a 6 or 7.\n\nBankroll Management: Don't 'Banco' unless you are prepared to lose the stake. In Chemin de Fer, the Banker has a slight mathematical advantage, so holding the shoe as long as possible is generally profitable.",
    Player: "As the Player, always draw on a 0-4 and stand on 6-7. On a 5, the standard tactical choice is to draw, but standing can be used as a bluff to make the Banker think you have a 6 or 7.\n\nAs the Banker, monitor the Punters' patterns. If a Punter always draws on a 5, you know they hold a 0-5 hand. If they stand, they likely have a 6 or 7.\n\nBankroll Management: Don't 'Banco' unless you are prepared to lose the stake. In Chemin de Fer, the Banker has a slight mathematical advantage, so holding the shoe as long as possible is generally profitable.",
    aggressiveness: 0.5,
    riskTolerance: 0.5,
    bluffFrequency: 0.3,
    bluffSettings: {
      profile: 'balanced',
    },
    basic: 'As the Player, always draw on a 0-4 and stand on 6-7. On a 5, the standard tactical choice is to draw, but standing can be used as a bluff to make the Banker think you have a 6 or 7.',
    intermediate: "As the Banker, monitor the Punters' patterns. If a Punter always draws on a 5, you know they hold a 0-5 hand. If they stand, they likely have a 6 or 7.",
    advanced: "Bankroll Management: Don't 'Banco' unless you are prepared to lose the stake. In Chemin de Fer, the Banker has a slight mathematical advantage, so holding the shoe as long as possible is generally profitable.",
    tips: [
      {
        title: 'Tip',
        description: "In 'James Bond' style play, psychology is as important as the cards. Use your 5-draw choice to vary your 'vibe'.",
      },
      {
        title: 'Tip',
        description: "If you are the Banker and win several hands in a row, consider 'cashing out' and passing the shoe to protect your profit.",
      },
