      reveal_market: 'Banking game with no market or tableau reveal mechanic.',
      buy_market: 'Cards are dealt from the shoe only; there is no market to buy from.',
      buy_stock: 'Third card is dealt on request; players do not buy from stock.',
      fold: 'Players commit to bets before the deal and cannot fold.',
      check: 'No check; punters either bet or pass when the bank is offered.',
      call: 'No raise or call; bets are placed once per coup.',
      bet: "Betting phase. Counter-clockwise from banker's right.",
      raise: 'Single betting opportunity per coup; no raising.',
      declare: 'Naturals (8 or 9) are shown by turning cards; no separate declare phase.',
      reveal_hand: 'Natural check or showdown phase.',
      award_pot: 'Resolution phase after both hands are final.',
      play_card: 'Hands are dealt and optionally draw a third card; no card-by-card play.',
      draw: 'Player or banker choice phase when total is 7 or less.',
      discard: 'No discard pile; only draw or stand on the third card.',
