    historyContent: {
      origins: 'Emerging in late 19th-century France as a modification of the older Baccarat Banque. It became the preferred game of European high society during the Belle Ã‰poque.',
      originCountries: [
        'France',
      ],
      timeline: [
        '1837: Baccarat is outlawed in France, leading to the rise of games like Chemin de Fer in private clubs.',
        '1900s: Becomes the flagship game of Monte Carlo and the French Riviera.',
        "1953: Iconic appearance in Ian Fleming's 'Casino Royale'.",
        'Late 20th Century: Largely replaced in American casinos by Punto Banco, but remains popular in European salons.',
      ],
      evolution: 'The game shifted the role of the banker from the house to the players themselves, turning Baccarat into a game of psychological maneuvering between participants.',
      cultural: "Regarded as the 'purest' form of Baccarat, requiring both capital and the nerve to make the right drawing call on a total of 5.",
    },
    setupContent: {
