    historyContent: {
      origins: 'Card Bingo adapts the traditional number-based Bingo lottery game to use standard playing cards. The basic concept of matching called items to a card grid translates naturally to matching called cards to a hand. Various versions have evolved with different dealing patterns, betting structures, and win conditions.',
      originCountries: [
        'USA',
        'UK',
        'Canada',
      ],
      timeline: [
        'Traditional Bingo: Lottery game with numbered balls/grid cards',
        'Card adaptation: Playing cards used instead of numbers',
        'Evolution: Multiple variants developed with betting, jackpots, high-low scoring',
        'Current: Played socially and in clubs (e.g., Doncaster Whist Club version with 60 players)',
      ],
      evolution: 'Started as simple matching game. Variants added: 13-card version for larger groups, suit-ignored version (call rank only), betting rounds, jackpot accumulation, high-low split pots, and Canadian variant with payment for uncalled cards.',
      cultural: 'Played in social clubs and homes. The Doncaster Whist Club version with 60 players uses multiple tables. Also known as Bango! or Hoy! in some regions (based on the win call).',
    },
    setupContent: {
      players: 'Basic game: up to 10 players plus caller. Large groups: 60+ players possible with multiple decks and tables. Caller can be a player or dedicated.',
      deck: 'Basic: Two standard 52-card packs without jokers (one for dealing, one for calling). Large groups: Multiple packs as needed. Some variants use one deck with suits ignored.',
      equipment: '2+ decks of cards, chips/money for betting variants',
      dealing: 'Basic: 5 cards face up to each player (6 cards if 8 or fewer players). One pack used for dealing. Second pack used by caller. Thirteen-card version: 13 cards each for larger games.',
