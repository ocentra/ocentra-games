  data: {
    hero: {
      title: 'Card Bingo',
      subtitle: 'Matching',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Card Bingo',
            subtitle: 'Matching',
            content: [
              {
                type: 'paragraph',
                text: 'Card Bingo is a lottery-style card game where players try to match called cards to their hand. A caller draws cards and announces them; players turn down matching cards in their hand. First player to turn down all cards wins. Similar to traditional number Bingo but using playing cards.',
              },
              {
                type: 'paragraph',
                text: 'Card Bingo adapts the traditional number-based Bingo lottery game to use standard playing cards. The basic concept of matching called items to a card grid translates naturally to matching called cards to a hand. Various versions have evolved with different dealing patterns, betting structures, and win conditions.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Basic game: up to 10 players plus caller. Large groups: 60+ players possible with multiple decks and tables. Caller can be a player or dedicated.',
              },
              {
                type: 'paragraph',
                text: 'Basic: Two standard 52-card packs without jokers (one for dealing, one for calling). Large groups: Multiple packs as needed. Some variants use one deck with suits ignored.',
              },
              {
                type: 'paragraph',
                text: '2+ decks of cards, chips/money for betting variants',
              },
              {
                type: 'paragraph',
                text: 'Basic: 5 cards face up to each player (6 cards if 8 or fewer players). One pack used for dealing. Second pack used by caller. Thirteen-card version: 13 cards each for larger games.',
              },
            ],
          },
        ],
      },
    ],
