        rules: {
          objective: "Beat the dealer's hand with a higher 3-card poker hand.",
          gameplay: '1. Ante bet (and optional Pair Plus). 2. Deal 3 cards. 3. Player decides to Play (match Ante) or Fold (lose Ante). 4. Dealer reveals hand. Dealer must qualify with Queen High or better. 5. Compare hands. Scoring: Straight Flush > Three of a Kind > Straight > Flush > Pair > High Card. (Note: Straight beats Flush in 3-card poker, usually).',
          keyRules: [
            'Dealer qualifies with Queen High',
            'Straight beats Flush (usually)',
            'Three of a Kind beats Straight',
            'Play bet must equal Ante',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Simple optimal strategy: Play if you have Q-6-4 or better. Fold anything worse.',
          intermediate: 'Pair Plus is a high-variance bet with a house edge usually higher than Ante/Play.',
          advanced: "Hole-carding (seeing dealer's card) can alter strategy slightly, but Q-6-4 is the mathematical baseline.",
          tips: [
            "Don't fold Q-7-x.",
            "Don't play blind.",
            'Manage bankroll for Pair Plus variance.',
