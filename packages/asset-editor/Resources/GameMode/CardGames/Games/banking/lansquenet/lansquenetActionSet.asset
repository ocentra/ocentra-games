    customActions: [
      {
        supported: true,
        description: "Place a stake on the Player's card (the second card turned). If that rank appears first in the draw, the banker pays you even money.",
        cost: '0',
        constraints: "During place_bets phase; total player stakes cannot exceed banker's stake.",
        isTerminating: false,
        effectType: 'bet',
        id: 'bet_player',
        effectHints: {},
      },
      {
        supported: true,
        description: "Place a stake on the Banker's card (the first card turned). If that rank appears first in the draw, the banker wins all player stakes.",
        cost: '0',
        constraints: "During place_bets phase; total player stakes cannot exceed banker's stake.",
        isTerminating: false,
        effectType: 'bet',
        id: 'bet_banker',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Turn up a card from the deck; system action performed by the banker.',
        cost: '0',
        constraints: "Banker reveals first card as Banker's card, second as Player's card.",
        isTerminating: false,
        effectType: 'reveal',
        id: 'reveal',
        effectHints: {},
      },
      {
        supported: true,
        description: 'When the first two cards match in rank, the banker wins all stakes immediately; no draw occurs.',
        cost: '0',
        constraints: "Only when Banker's card and Player's card have the same rank.",
        isTerminating: false,
        effectType: 'play',
        id: 'resolve_tie',
        effectHints: {},
      },
      {
        supported: true,
        description: 'When the first two cards differ in rank, proceed to the draw phase.',
        cost: '0',
        constraints: 'Only when the two revealed cards are of different ranks.',
        isTerminating: false,
        effectType: 'play',
        id: 'continue',
        effectHints: {},
      },
      {
        supported: true,
        description: "Turn up the next card from the deck; when it matches either the Banker's or Player's card rank, resolve all bets.",
        cost: '0',
        constraints: 'Repeated until a card matches one of the two initial ranks; suits are ignored.',
        isTerminating: false,
        effectType: 'play',
        id: 'draw_card',
        effectHints: {},
      },
      {
        supported: true,
        description: "Banker pays each Player bettor at even money when the Player's card rank was matched first in the draw.",
        cost: '0',
        constraints: "System action after draw when Player's rank appeared before Banker's.",
        isTerminating: false,
        effectType: 'award',
