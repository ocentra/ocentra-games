  data: {
    LLM: 'Game: Skin. Logic: See rules.objective and rules.gameplay.',
    Player: "Skin (or 'Georgia Skin') is a legendary high-stakes gambling game from the American South. It is a banking game, but not in the traditional sense where the bank has an edge; the edge comes purely from chance, nerve, and 'side bets'. Cards are dealt from a shoe one by one. Players bet on their card being matched by a card from the deck. If your card is matched (falls), you lose. The last card standing ('The Skin') is the winner unless all bets are resolved earlier. It is famous for its slow, tension-filled reveal ('Skinning').",
    objective: 'Have your card survive while others fall (are matched).',
    gameplay: "Players buy a case card from the dealer; the dealer also takes a card. Cards are then revealed one by one from the shoe. When a revealed card matches a player's card (same rank), that player is eliminated. The last card remaining wins unless all bets are resolved earlier. Side bets are common.",
    keyRules: [
      'Each player buys one case card from the dealer; the dealer takes one.',
      'Cards are revealed one by one from the shoe (skinning).',
      "When a revealed card matches your card's rank, you are eliminated.",
      'The last card standing (The Skin) wins unless all bets are resolved earlier.',
      'Side bets between players are common.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Two or more players; Scarne describes it as best for about six. One player is the banker (dealer). The first banker is chosen by dealing cards one at a time until an Ace appears; the turn to be banker passes to the right after each deal. Each player may accept one case card from the dealer to bet on, or refuse; the dealer also holds one card. Cards are revealed one by one from a dealing box or shoe.',
      deck: '52 cards (or Shoe of 6 decks).',
      equipment: '52 cards (or Shoe of 6 decks).',
      dealing: "Players buy a card from the dealer (the 'Case Card'). Dealer takes a card too.",
    },
