    historyContent: {
      origins: "Originating in the 19th century, it was frequently played in American mining camps and on riverboats. The name 'Red Dog' originally referred to this specific pool-based betting game before being co-opted by the 'In-Between' casino game.",
      originCountries: [
        'USA',
        'Europe',
      ],
      timeline: [
        '1800s: Popular in American frontier gambling.',
        '1930s: Described in gaming cyclopedias as a staple of informal banking games.',
        'Present: Mostly played in home games and as a novelty in some casinos.',
      ],
      evolution: "The game branched into versions like 'Slippery Sam' (where the dealer provides a bank) and 'Shoot' (a more aggressive betting variant).",
      cultural: "Known for rapidly growing pots that can deplete a table's stakes quickly.",
    },
