    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'High Card Pool',
            subtitle: 'The Betting Game',
            content: [
              {
                type: 'paragraph',
                text: 'High Card Pool, often called Red Dog or Slippery Sam, is a fast-paced banking game where players bet on whether a card dealt after their initial hand will match a suit in their hand and have a higher rank. It is a game of probability and betting psychology, common in both casual social settings and older casino environments.',
              },
              {
                type: 'paragraph',
                text: "Originating in the 19th century, it was frequently played in American mining camps and on riverboats. The name 'Red Dog' originally referred to this specific pool-based betting game before being co-opted by the 'In-Between' casino game.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 8 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. A (high) to 2 (low).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. A (high) to 2 (low).',
              },
              {
                type: 'paragraph',
                text: 'The dealer deals 5 cards face down to each player (4 or 3 cards in some variants to accommodate more players).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Four cards: Only four cards are dealt to each player to allow a larger number of players without running out of cards.',
                  },
                  {
                    text: 'Three cards: Only three cards are dealt to each player to accommodate more players.',
                  },
                  {
                    text: 'Dealer bank: Red Dog can be played with a bank put up by the dealer (as in Shoot or Slippery Sam); players do not ante, and if the pot becomes empty the deal immediately passes to the next player.',
                  },
                ],
              },
            ],
          },
        ],
      },
