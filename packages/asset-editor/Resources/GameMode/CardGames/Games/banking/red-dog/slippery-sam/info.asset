  data: {
    hero: {
      title: 'SLIPPERY SAM',
      subtitle: 'Card Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Slippery Sam',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Banking game: dealer puts up a stake; dealer deals three cards face-down to each player (players do not look), then turns cards face up until a six or lower appears; each player in turn bets on having a higher card of the same suit than that spot card; after betting, the hand is exposed and the player wins from or pays into the pot.',
              },
              {
                type: 'paragraph',
                text: 'Slippery Sam is a variant of Red Dog (also called High Card Pool), a banking game in which players bet on having a card of the same suit and higher rank than a card dealt from the pack. In Slippery Sam, also known as Six-Spot Red Dog, the dealer turns cards face up until a six or lower appears; players bet on that spot card without having seen their own hands. The card games literature varies on how the names Red Dog, Slippery Sam and Shoot are assigned to the different versions.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players; one is dealer and banker each hand.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Chips or money for the pot and bets.',
              },
              {
                type: 'paragraph',
                text: 'Dealer deals three cards face-down to each other player; players must not look at their cards. Dealer then turns cards face up from the deck until a six or lower appears; that card is the spot card for the hand.',
              },
            ],
          },
        ],
      },
    ],
    description: 'Banking game: dealer puts up a stake; dealer deals three cards face-down to each player (players do not look), then turns cards face up until a six or lower appears; each player in turn bets on having a higher card of the same suit than that spot card; after betting, the hand is exposed and the player wins from or pays into the pot.',
