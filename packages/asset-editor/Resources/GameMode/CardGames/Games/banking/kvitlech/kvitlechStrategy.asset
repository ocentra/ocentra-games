    tips: [
      {
        title: 'Tip',
        description: "Always take the Banker role if the 'Framed Cards = 21' rule is in effect; it statistically favors the house in most rotations.",
      },
      {
        title: 'Tip',
        description: 'Remember that the Ace (1) is only 1 point; it is a very weak card for building a high total fast.',
