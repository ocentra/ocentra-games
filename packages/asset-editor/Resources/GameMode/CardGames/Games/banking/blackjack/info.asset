    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Blackjack',
            subtitle: 'The Casino Classic',
            content: [
              {
                type: 'paragraph',
                text: 'Blackjack (also known as 21) is the most iconic casino banking game in the world. Players compete individually against the dealer to reach a hand value as close to 21 as possible without exceeding it (busting). Known for its combination of chance and mathematical strategy, it is the only casino game where a skilled player can systematically gain an edge over the house through basic strategy and card counting.',
              },
              {
                type: 'paragraph',
                text: "Descended from the 17th-century French game 'Vingt-et-Un' (Twenty-One). The name 'Blackjack' originated in American gambling halls that offered a special 10-to-1 payout for an Ace of Spades and a black Jack (Spades or Clubs).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Typically 1 to 7 players seated at a semi-circular table, all playing against a central Dealer.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card French decks (usually 6 or 8 decks in a shoe).',
              },
              {
                type: 'paragraph',
                text: 'Casino table, chips, card shoe, discard tray.',
              },
              {
                type: 'paragraph',
                text: "After bets are placed, players and the dealer receive two cards each. Usually, one of the dealer's cards is face up (upcard) and one is face down (hole card).",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Spanish 21: Played with 48-card decks (10s removed). Offers various bonus payouts for specific 21 combinations.',
                  },
                  {
                    text: 'Blackjack Switch: Players play two hands and can switch the second cards dealt to each hand.',
                  },
                ],
              },
            ],
          },
        ],
      },
