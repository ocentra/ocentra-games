        rules: {
          objective: "Achieve a hand value closer to 21 than the dealer's hand, without exceeding 21.",
          gameplay: "1. **Wagering**: Players place bets. 2. **Deal**: Players and dealer receive two cards. 3. **Player Turn**: Players choose to 'Hit' (take card), 'Stand' (keep hand), 'Double Down' (double bet for one card), or 'Split' (split pairs). 4. **Dealer Turn**: Dealer reveals hole card and must hit until reaching 17+. 5. **Settlement**: Higher hand wins; dealer bust pays all remaining players.",
          keyRules: [
            'Aces count as 1 or 11.',
            'Face cards (K, Q, J) count as 10.',
            'Blackjack (Natural 21) typically pays 3-to-2.',
            "Insurance is offered if the dealer's upcard is an Ace.",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Follow the 'Basic Strategy' chart: always hit on 11 or less, always stand on hard 17 or more. Stand on 12-16 if the dealer shows a 2-6 (bust cards).",
          intermediate: 'Double Down Timing: Always double down on a total of 11 unless the dealer shows an Ace. Double on 10 against a dealer 2-9.',
          advanced: "Card Counting: Use the Hi-Lo system to track the ratio of high cards (10s, Aces) to low cards. Increase your bet when the 'True Count' is positive, as this increases the probability of a player blackjack.",
          tips: [
            "Never take insurance; it is a 'sucker bet' with a high house edge.",
            'Avoid 6-to-5 payout tables; always look for traditional 3-to-2 blackjack payouts.',
          ],
          hasPlaceholders: false,
