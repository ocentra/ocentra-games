        tabLabel: 'About',
        pages: [
          {
            title: 'Petit Paquet',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Petit Paquet (also known as 'Turkish Packets' or 'Paquets Turcs') is an 18th-century French game of pure chance and high-stakes gambling. It pits a single 'Banker' against a group of players. The game is played with several small piles (packets) of face-down cards. Players bet on specific piles, and the top cards are revealed one by one. It is a precursor to modern casino games like Baccarat and Pharaoh, known for its elegant simplicity and rapid wealth transfer.",
              },
              {
                type: 'paragraph',
                text: "Dates back to the royal courts of France in the 1700s. It was particularly popular during the 'Turkish Fad' (Turquerie) in Europe, hence the alternative name.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'One Banker and any number of Punters (Players).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards. Rank: A (High) to 2 (Low).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52 cards. Rank: A (High) to 2 (Low).',
              },
              {
                type: 'paragraph',
                text: "The Banker splits the deck into several small face-down packets (usually 5 to 10 piles) and one 'Banker Pile' for themselves.",
              },
            ],
          },
        ],
      },
