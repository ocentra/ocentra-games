    historyContent: {
      origins: "Dates back to the royal courts of France in the 1700s. It was particularly popular during the 'Turkish Fad' (Turquerie) in Europe, hence the alternative name.",
      originCountries: [
        'France',
      ],
      timeline: [
        '1710s: First described in French gaming manuals as a parlor gamble.',
        '1850s: Becomes a staple in common gambling dens across Paris and London.',
        '1920s: Mostly replaced in casinos by Baccarat, but remains a folk game in Rural France.',
        'Present: Played occasionally as a historical curiosity or in high-stakes private circles.',
      ],
      evolution: "The game evolved from a 32-card format (removing low cards to increase the 'Hit' frequency) to a full 52-card format for more participants.",
      cultural: "Symbolizes the 'Golden Age' of French salon gambling, where fortunes were won and lost on the flip of a single 'Paquet'.",
    },
