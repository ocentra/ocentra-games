        synthesis: {
          hero: {
            title: 'FAST TRACK',
            subtitle: 'The Card-Driven Race',
            tagline: 'Move your marbles. Bump your opponents. Watch the board. Go home.',
          },
          shortDescription: 'A high-energy race game combining card-driven movement with strategic bumping, split turns, and a dangerous shortcut through the center.',
          uiThemes: [
            'classic',
            'classic',
            'classic',
          ],
          uiLayout: {
            zones: [
              'stock',
              'stock',
            ],
            marketPosition: 'center',
            stockPosition: 'center',
            discardPosition: 'NA',
            playerHandLayout: 'arc',
            potPosition: 'center',
          },
        },
        prompts: {
          human: 'Welcome to Fast Track! You have 4 marbles to move from your Holding Pen around the board and into your Home Base. Play cards to move them. Save your 6s, Aces, Face Cards, and Jokers for extra turns. Use backwards 4s to shortcut into Home. Most importantly: bump your opponents and send them back to start!',
          ai: 'Game: Fast Track. Each player has own 54-card deck (52+2 Jokers). Goal: Move 4 marbles from Holding Pen around 68-space board into Home Base. Turn sequence: play 1 card to move marble(s), draw 1 card back to hand-size of 5. Card effects: 2-10=move forward that number, J/Q/K=10 or Start, A=1 or Start, 6=6 or Start with Play Again, 4=move backward 4, 7=move 7 OR split between 2 marbles, Joker=bump opponent OR Start with Play Again. Bumping: land exactly on opponent = they return to Holding Pen. Fast Track: central shortcut, risky but saves spaces. Play Again: granted by 6, A, Face Cards, Joker = extra turn.',
        },
        scoring: {
          description: 'Winner determined by first player/team to place all 4 marbles in Home Base.',
          winCondition: 'First player or team to move all 4 marbles from Holding Pen, around the track, and into Home Base.',
          cardValues: {
            A: '1',
            K: '13',
            Q: '12',
            J: '11',
          },
          penalties: {
            Bumped: 'Marble returns to Holding Pen, losing all forward progress.',
            Blocked: 'Cannot move forward through own marble; must choose different marble.',
          },
          splitRules: '7s can be split between two marbles (e.g., move one marble 3 spaces and another 4 spaces).',
          targetScore: 1,
          scoringDirection: 'high_wins',
          hasPlaceholders: false,
          nullReasons: {
            targetScore: 'Game does not use target score mechanic.',
          },
        },
