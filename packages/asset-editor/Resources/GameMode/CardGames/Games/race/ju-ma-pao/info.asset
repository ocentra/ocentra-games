  data: {
    hero: {
      title: 'Jū mǎ pāo 車馬包',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Jū mǎ pāo 車馬包',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Jū mǎ pāo (Chariot Horse Cannon) is a traditional Chinese matching and trick-taking game that uniquely utilizes the 32 pieces of a Chinese Chess (Xiangqi) set as cards. Played by 3 or 4 players, players treat the chess discs as a deck, shuffling them face-down and forming stacks. It is a game of memory, piece-value calculation, and specific combination-based captures.',
              },
              {
                type: 'paragraph',
                text: "Dates back to the late Qing dynasty or earlier. The use of Xiangqi pieces as cards is a common practice in Southern China and Southeast Asia (see 'Giog' in Malaysia).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Three or four players. The game is best with three, in which case each receives eight pieces; with four players the 32 Xiangqi pieces are distributed evenly (typically eight per player). No partnerships; each plays for themselves.',
              },
              {
                type: 'paragraph',
                text: 'A full set of 32 Chinese Chess pieces (16 Red, 16 Black).',
              },
              {
                type: 'paragraph',
                text: 'A full set of 32 Chinese Chess pieces (16 Red, 16 Black).',
              },
              {
                type: 'paragraph',
                text: 'Pieces are shuffled face-down and arranged in 16 stacks of two in a circle. Each player draws a set number of pieces (usually 8).',
              },
            ],
          },
        ],
      },
