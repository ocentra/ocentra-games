    tips: [
      {
        title: 'Tip',
        description: "Always hold one 'Start' card if you have marbles remaining in the Holding Pen.",
      },
      {
        title: 'Tip',
        description: "Never stay on Fast Track longer than one turnâ€”you're a sitting duck.",
      },
      {
        title: 'Tip',
        description: "If you're far behind, use 4s aggressively to reset opponent positions.",
      },
      {
        title: 'Tip',
        description: 'In the endgame with 1-2 marbles left, use face cards conservatively. Save Jokers for critical bumps.',
      },
      {
        title: 'Tip',
        description: "Track opponent hand sizes (do they have cards left to draw ). If an opponent is about to draw their last card, they're vulnerable to being forced into dead turns.",
