    },
    historyContent: {
      origins: 'Fast Track descends from the Aggravation and Wahoo family of race games, which themselves were adaptations of the English game Ludo. The card-based movement system emerged in the late 20th century as a DIY and homemade variant popular in Midwestern USA and Canada.',
      originCountries: [
        'USA',
        'Canada',
      ],
      timeline: [
        "Mid-20th Century: Board games like Aggravation popularize the 'bump' mechanic (sending opponent pieces back to start).",
        '1970s-1980s: Homemade wooden-board versions using cards emerge, particularly in Midwest and Canada.',
        '1990s-2000s: Fast Track gains widespread popularity through church groups, community centers, and family gatherings.',
        'Present: Played on custom hand-crafted wooden boards and in digital adaptations.',
      ],
      evolution: 'The transition from dice to cards added strategic depth: players must manage their hand (save high cards vs. play early), timing card usage, and hand-management decisions replace pure chance.',
      cultural: 'Often played on hand-crafted wooden boards passed down through generations. A staple of inter-generational family gaming, church socials, and community gatherings, particularly in the upper Midwest (Minnesota, Wisconsin) and Canada.',
    },
    setupContent: {
      players: '2 to 6 players (can be played in teams with partners sitting opposite each other on a square board).',
      deck: 'Each player (or team) has their own full 52-card deck PLUS 2 Jokers (54 cards total per player deck). Keep decks separated by player.',
      equipment: '1. **Fast Track Board**: Hexagonal or square board with 64-68 spaces around the perimeter plus 4 Home Base centers (one per player/team). 2. **Marbles or Pegs**: 4 marbles per player in their color. 3. **Holding Pen**: Off-board area where marbles start before being entered into play.',
      dealing: 'Each player shuffles their own deck and draws 5 cards into their starting hand. Place remaining cards face-down as draw pile.',
    },
