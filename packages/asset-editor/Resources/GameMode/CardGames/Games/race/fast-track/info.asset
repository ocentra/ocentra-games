  data: {
    hero: {
      title: 'FAST TRACK',
      subtitle: 'The Card-Driven Race',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Fast Track',
            subtitle: 'The Card-Driven Race',
            content: [
              {
                type: 'paragraph',
                text: "Fast Track is a high-energy North American race game that combines card-driven movement with a physical board of marbles or pegs. Similar in spirit to Sorry! or Ludo, Fast Track replaces dice with each player's personal deck of cards. The goal is to navigate all four marbles around the track and into a central Home Base. The game features strategic mechanics like backwards-moving 4s, split 7s (move two marbles), and a dangerous central shortcut called the 'Fast Track' that saves board space but leaves marbles vulnerable.",
              },
              {
                type: 'paragraph',
                text: 'Fast Track descends from the Aggravation and Wahoo family of race games, which themselves were adaptations of the English game Ludo. The card-based movement system emerged in the late 20th century as a DIY and homemade variant popular in Midwestern USA and Canada.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 6 players (can be played in teams with partners sitting opposite each other on a square board).',
              },
              {
                type: 'paragraph',
                text: 'Each player (or team) has their own full 52-card deck PLUS 2 Jokers (54 cards total per player deck). Keep decks separated by player.',
              },
              {
                type: 'paragraph',
                text: '1. **Fast Track Board**: Hexagonal or square board with 64-68 spaces around the perimeter plus 4 Home Base centers (one per player/team). 2. **Marbles or Pegs**: 4 marbles per player in their color. 3. **Holding Pen**: Off-board area where marbles start before being entered into play.',
              },
              {
                type: 'paragraph',
                text: 'Each player shuffles their own deck and draws 5 cards into their starting hand. Place remaining cards face-down as draw pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Pegs and Jokers: Identical rules but played with wooden peg tracks and interlocking boards. The interlocking design creates a unique cross-pattern for 4-player games.',
                  },
                  {
                    text: 'Tock (QuÃ©bÃ©cois Variant): Slight rule variations: 7 always means 7 steps (no split option). Jack values different card hierarchy. Popular in Quebec and Eastern Canada.',
                  },
                  {
                    text: 'Dirty Marbles (Aggressive Variant): Bumping is MANDATORY whenever you land on an opponent. Creates chaos and more aggressive play.',
                  },
                  {
                    text: 'Cooperative Fast Track: Teams work together to block a single opponent who starts with a head start. Last team standing wins.',
                  },
                  {
                    text: 'Speed Variant: Players draw back to 10 cards instead of 5, speeding up play dramatically.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Fast Track is a high-energy North American race game that combines card-driven movement with a physical board of marbles or pegs. Similar in spirit to Sorry! or Ludo, Fast Track replaces dice with each player's personal deck of cards. The goal is to navigate all four marbles around the track and into a central Home Base. The game features strategic mechanics like backwards-moving 4s, split 7s (move two marbles), and a dangerous central shortcut called the 'Fast Track' that saves board space but leaves marbles vulnerable.",
    tags: [
      'card-game',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'fast-track',
    LLM: 'Game: Fast Track. Each player has own 54-card deck (52+2 Jokers). Goal: Move 4 marbles from Holding Pen around 68-space board into Home Base. Turn sequence: play 1 card to move marble(s), draw 1 card back to hand-size of 5. Card effects: 2-10=move forward that number, J/Q/K=10 or Start, A=1 or Start, 6=6 or Start with Play Again, 4=move backward 4, 7=move 7 OR split between 2 marbles, Joker=bump opponent OR Start with Play Again. Bumping: land exactly on opponent = they return to Holding Pen. Fast Track: central shortcut, risky but saves spaces. Play Again: granted by 6, A, Face Cards, Joker = extra turn.',
    Player: 'Welcome to Fast Track! You have 4 marbles to move from your Holding Pen around the board and into your Home Base. Play cards to move them. Save your 6s, Aces, Face Cards, and Jokers for extra turns. Use backwards 4s to shortcut into Home. Most importantly: bump your opponents and send them back to start!',
    tagline: 'Move your marbles. Bump your opponents. Watch the board. Go home.',
    gameCategory: 'Race',
    subcategory: 'Gambling / Card Race',
    playerMode: 'multiplayer',
    difficulty: 'Beginner',
    duration: '30-60 minutes',
    origin: 'North America (USA / Canada)',
    originName: 'Fast Track',
    deck: 'One 52-card deck + 2 Jokers per player',
    alsoKnownAs: [
      'Tock',
      'Fast Paced Marbles',
    ],
    playersDisplay: '2-6',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
      variations: true,
