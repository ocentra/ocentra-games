    aiContent: {
      difficulty: {
        easy: 'Moves the marble closest to finishing; never uses 4s strategically; ignores opponent positions; randomly plays high cards.',
        medium: "Uses 4s to enter Home Base area faster. Understands when to 'Play Again' to chain moves. Tracks approximate opponent progress. Occasionally bumps nearby opponents.",
        hard: "Simulates all possible marble and card combinations to maximize win probability. Holds Jokers to bump opponents in critical positions. Optimizes 'Split 7s' to maximize board control. Models opponent hand states and card depletion. Recognizes when to sacrifice position for team advantage (in partnership play). Predicts optimal Fast Track usage.",
      },
      considerations: [
        'AI must handle pathfinding across two routes: traditional outer loop and dangerous Fast Track shortcut.',
        'AI must balance immediate win attempts against long-term board control.',
        'AI must track all player hand sizes and predict card availability for future turns.',
        'In partnership play, AI must communicate via play decisions (e.g., intentional bumps signal strategy).',
      ],
    },
