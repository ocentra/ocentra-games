        tabLabel: 'About',
        pages: [
          {
            title: 'Pegs and Jokers',
            subtitle: 'Race Game',
            content: [
              {
                type: 'paragraph',
                text: 'Pegs and Jokers is a North American partnership race game. Cards move pegs (or marbles) around a board. 4, 6, or 8 players; each player has 5 pegs. First team to move all pegs from START to HOME wins. Derived from Pachisi/Sorry.',
              },
              {
                type: 'paragraph',
                text: 'Derived from Pachisi via Sorry!. Cards control movement instead of dice. Based on Bill and Barb Bigger, John and Linda Bristol.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4, 6, or 8 in two teams. Sit alternately (or opposite in 6/8).',
              },
              {
                type: 'paragraph',
                text: '3 decks + 6 jokers (6p); 4 decks + 8 jokers (8p).',
              },
              {
                type: 'paragraph',
                text: 'Board (4/6/8 sides), 5 pegs per player (or marbles).',
              },
              {
                type: 'paragraph',
                text: '5 cards each. Remainder face-down.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Arizona Rules: Play then draw; move any team peg; 9 splits forward/back; joker rules for start.',
                  },
                  {
                    text: 'North Carolina: Regional rules.',
                  },
                  {
                    text: 'Pegoo: Simplified variant.',
                  },
                ],
              },
            ],
          },
        ],
