        supported: true,
        description: 'Keep your current piece; do not swap with your left-hand neighbour.',
        cost: '0',
        constraints: 'Legal when it is your turn in the swap round.',
        isTerminating: false,
        effectType: 'custom',
        effectHints: {},
        id: 'stand',
      },
      {
        supported: true,
        description: 'Offer to swap your piece with your left-hand neighbour. They must accept unless they hold a matador (Knight, Bird, Cat, or Inn).',
        cost: '0',
        constraints: 'Legal when it is your turn in the swap round.',
        isTerminating: false,
        effectType: 'custom',
        effectHints: {},
        id: 'swap_with_left',
      },
      {
        supported: true,
        description: 'Show your piece to all players; used when the swap round has ended to determine who has the lowest piece.',
        cost: '0',
        constraints: 'Legal in the reveal phase when all players show simultaneously.',
        isTerminating: false,
        effectType: 'reveal',
        effectHints: {},
        id: 'reveal_piece',
      },
