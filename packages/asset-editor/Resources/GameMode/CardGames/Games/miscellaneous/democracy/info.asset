        },
        rules: {
          objective: "Collect majority of points in suits to score 'tribes' (game points). First player to reach agreed number of tribes (usually 5, 7, or 10) wins the match.",
          gameplay: "1. Dealer flips card from voting pool to determine trump suit\n2. Each player selects one card from hand and places it face down\n3. On dealer's signal, all simultaneously reveal cards\n4. If trumps played: highest trump wins (except 6 beats 5 of trumps if both played)\n5. If no trumps: highest card wins regardless of suit\n6. Winner takes all played cards and voting card\n7. In case of tie for highest (no trumps): each takes own card, voting card discarded\n8. Jokers can represent any non-trump card\n9. Continue until all cards played, then score",
          keyRules: [
            'All players select and reveal cards simultaneously',
            'No requirement to follow suit or play trump',
            'Special rule: 6 of trumps beats 5 of trumps if both played',
            'Jokers represent any non-trump card (lose to any trump)',
            'Tie for highest (no trumps): each player keeps own card only',
            "Game played in two 'days' with half the deck each",
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Learn the unusual card ranking (5-4-3-A-K-Q-J-10-9-8-7-6)\nTrack which high-value cards have been played\nAim to capture cards in suits where you already have points\nUse jokers strategically when available',
          intermediate: 'Count cards to estimate opponent holdings\nPredict what suits opponents are collecting\nTime your high cards to win crucial tricks\nBalance capturing cards across multiple suits',
          advanced: "Bluff and misdirection in card selection\nRead opponents' patterns across multiple games\nCalculate probabilities of trump being played\nOptimize play for suit sweep bonuses if using that variation",
          tips: [
            'Watch for opportunities to play when no trump is likely',
            'Remember that 6 beats 5 of trumps - a key exception',
            'Track which players are collecting which suits',
            'Consider the two-day structure when planning your strategy',
            'Bad catch rule: if dealt only 1-point cards in first day, can call misdeal and score 1 tribe',
          ],
