  data: {
    hero: {
      title: 'DEMOCRACY',
      subtitle: 'Simultaneous Reveal Trick Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Democracy',
            subtitle: 'Simultaneous Reveal Trick Game',
            content: [
              {
                type: 'paragraph',
                text: "Democracy is a unique trick-taking game for 2-6 players where all players simultaneously select and reveal cards. The game features a colonial backstory where players represent powers attempting to annex an island. Cards have special rankings (5-4-3-A-K-Q-J-10-9-8-7-6) and point values, with the goal of capturing majority points in suits to score 'tribes'.",
              },
              {
                type: 'paragraph',
                text: "Country/Region of Origin: Cleveland, Ohio, USA\nTime Period: 2004 or earlier\nHistorical Development: Played at the Tabletop Board Game Cafe in Cleveland. Unknown whether invented there or introduced from elsewhere.\nCultural Significance: Part of a unique gaming culture in Cleveland along with related game 'Ribs'",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 3-5\nPartnerships: None - individual play',
              },
              {
                type: 'paragraph',
                text: 'Type: Modified standard deck\nNumber of Decks: 1\nJokers: Added for 4 players (2 jokers), 6 players (1 joker)\nCard removal: All twos removed (48 cards base)\nSpecial ranking: 5-4-3-A-K-Q-J-10-9-8-7-6 (high to low)',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck\nScore sheet for tracking tribes\nTable space for voting pool',
              },
              {
                type: 'paragraph',
                text: "Cards dealt face down clockwise\nExtra 'voting pool' hand dealt to center\nTwo-day structure: half deck each day (or play variations)\nExample: 4 players = 5 cards each + 5 in pool per day",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Days: Play the whole game as a single day, or divide into more than two days; more days means less choice and more luck.',
                  },
                  {
                    text: 'Bad Catch: Player dealt only one-point cards in first day may call misdeal and score one tribe automatically.',
                  },
                  {
                    text: 'High Stake: Bad-catch player may elect high stake; suits they win score 2 (or 3) tribes instead of 1.',
                  },
                  {
                    text: "Ghost / Klepto: When joker is voting card, each player draws one card from neighbour's hand and captures it; joker discarded.",
                  },
                  {
                    text: 'Dummy Joker: Joker worth zero, ranks below 6, always loses; no suit.',
                  },
                  {
                    text: 'Suit Sweep: Player capturing all 12 cards of a suit scores two tribes; some require announcing sweep before first vote.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
