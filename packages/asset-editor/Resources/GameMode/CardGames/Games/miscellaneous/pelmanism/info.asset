    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pelmanism',
            subtitle: 'Memory card game',
            content: [
              {
                type: 'paragraph',
                text: 'Pelmanism is a simple memory game in which players turn over two cards at a time from a face-down layout to find matching pairs. Also known as Concentration or Memory; in Japan as Shinkei-suijaku. The British name comes from the Pelman Institute (London, 1899).',
              },
              {
                type: 'paragraph',
                text: 'The name Pelmanism comes from Britain: Christopher Louis Pelman founded the Pelman Institute for the Scientific Development of Mind, Memory and Personality in London in 1899. The game is a simple memory pastime also known as Concentration or Memory (English) and Shinkei-suijaku in Japan.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 2\nPartnerships: None',
              },
              {
                type: 'paragraph',
                text: 'Type: Standard 52-card deck\nNumber of Decks: 1\nJokers: Not included',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck, table or floor space. Cards are spread face down and must not overlap.',
              },
              {
                type: 'paragraph',
                text: 'No cards are dealt to hands. All cards are thoroughly shuffled and spread face down on the playing surface in a regular pattern or irregular layout; positions are fixed for the round.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Match by rank and colour: When using only two cards of each type (e.g. from a standard pack), players may agree that cards match only if they have the same denomination and the same colour (e.g. both red or both black), making matching harder.',
                  },
                  {
                    text: 'Four of each type: Some packs have four identical cards of each type instead of two, so the first card of a new rank has three possible pairings and the start is easier; the game still gets easier as the layout shrinks.',
                  },
                ],
              },
            ],
          },
        ],
      },
