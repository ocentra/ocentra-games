          hero: {
            title: 'THREE CARD MONTE',
            subtitle: 'Card Game',
            tagline: 'Three Card Monte is a confidence trick: find the lady among three face-down cards. Played as a street scam or honestly with friends for no money.',
          },
          shortDescription: 'Three Card Monte (Find the Lady, Bonneteau) is a confidence trick using three cards—one queen and two others. The dealer mixes them face-down; the punter bets on which is the queen. Originated in Europe; often run as a scam.',
          uiThemes: [
            'classic',
          ],
