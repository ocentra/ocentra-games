    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'GOPS',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "GOPS (short for 'Game of Pure Strategy'), also known as Goofspiel, is a celebrated card game in game theory and mathematics. It is a symmetrical contest where luck is almost entirely eliminated, as both players begin with identical sets of cards and are presented with the same sequence of 'prizes' to bid on. The game is a test of psychological reading and resource management, as players must decide which prizes are worth their highest 'bidding' cards and when to concede a small loss to save strength for a future win.",
              },
              {
                type: 'paragraph',
                text: "GOPS was popularized by mathematicians and game theorists in the midnd20th century. Its earliest formal description appeared in the seminal 1957 textbook 'Games and Decisions' by Luce and Raiffa. It was designed to study zero-sum games with imperfect information.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players (Standard).',
              },
              {
                type: 'paragraph',
                text: 'A standard 52ndcard deck is divided into its four suits.\n- Player 1: Takes all Clubs.\n- Player 2: Takes all Spades.\n- Prize Pile: The Diamonds are shuffled and placed face-down.\n- (Hearts are removed from a 2ndplayer game).',
              },
              {
                type: 'paragraph',
                text: 'A standard 52ndcard deck is divided into its four suits.\n- Player 1: Takes all Clubs.\n- Player 2: Takes all Spades.\n- Prize Pile: The Diamonds are shuffled and placed face-down.\n- (Hearts are removed from a 2ndplayer game).',
              },
              {
                type: 'paragraph',
                text: 'The basic game is for two players, using three suits from a standard 52-card pack.',
              },
            ],
          },
        ],
      },
