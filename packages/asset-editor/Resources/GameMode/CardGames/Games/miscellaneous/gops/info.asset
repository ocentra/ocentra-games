    aiContent: {
      difficulty: {
        easy: "Bids exactly the value of the prize card every time ('Naive Counter'); easy to beat by bidding prize+1.",
        medium: "Tracks opponent's remaining card set; uses basic N+1 logic; understands the value of tie roll-overs.",
        hard: "Uses psychological 'Mixed Strategy' (Nash Equilibrium); randomizes bids on certain prize values to avoid being read; calculates the 'Future Value' of a card based on the remaining prizes in the deck.",
      },
      considerations: [
        'AI must avoid being predictable, as any pattern in GOPS can be immediately exploited.',
      ],
    },
