    tips: [
      {
        title: 'Tip',
        description: 'Always track which ranks have been fully revealed (both suits). Once both Queens are face-up, they are out of the deck possibilities.',
      },
      {
        title: 'Tip',
        description: "Be careful with your 'Self-Reveal' when you guess wrong. Reveal cards that you think your partner already deduced to give the opponents the least amount of new info.",
      },
