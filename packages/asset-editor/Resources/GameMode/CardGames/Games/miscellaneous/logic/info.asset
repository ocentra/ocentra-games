    historyContent: {
      origins: 'Developed in the late 20th century as a competitive abstract deduction exercise. It gained popularity in programming and mathematics circles as a test of logical inference.',
      originCountries: [
        'USA',
      ],
      timeline: [
        "1980s: Variations of 'Logic' (sometimes called 'Deduction') appear in university gaming clubs.",
        '2004: Standardized rules for the 24-card version are published on game archive sites.',
        'Present: Played online and in strategy forums as a pure mental challenge.',
      ],
      evolution: 'The game was simplified from a 52-card version to ensure that rounds are fast and the state-space is manageable for high-level human memory.',
      cultural: "Regarded as a 'Brain' game, often used as a training exercise for pattern recognition.",
    },
    setupContent: {
      players: '4 players in two fixed partnerships (A+C vs B+D).',
