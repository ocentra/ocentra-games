  data: {
    hero: {
      title: 'LOGIC',
      subtitle: 'The Deduction Duel',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Logic',
            subtitle: 'The Deduction Duel',
            content: [
              {
                type: 'paragraph',
                text: "Logic is a highly strategic deduction-based card game for four players in two teams. It is a game of perfect information (eventually), where players must deduce the identity and position of cards in their opponents' hands. Unlike traditional trick-taking games, 'Logic' is more akin to a competitive version of Mastermind or Hanabi, requiring careful observation of partners' clues and opponents' guesses.",
              },
              {
                type: 'paragraph',
                text: 'Developed in the late 20th century as a competitive abstract deduction exercise. It gained popularity in programming and mathematics circles as a test of logical inference.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships (A+C vs B+D).',
              },
              {
                type: 'paragraph',
                text: '24 cards: Ace (low) through Queen (high) of two suits (e.g., Red and Black).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck and privacy screens for card arrangement.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 6 cards face-down. They arrange their cards in front of them in **ascending order of value** from left to right.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: '52-Card Logic: A much longer and more difficult version.',
                  },
                  {
                    text: "Open Logic: A variant where the 'Show' phase is public.",
                  },
                  {
                    text: 'Deduction: A related single-player puzzle game.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Logic is a highly strategic deduction-based card game for four players in two teams. It is a game of perfect information (eventually), where players must deduce the identity and position of cards in their opponents' hands. Unlike traditional trick-taking games, 'Logic' is more akin to a competitive version of Mastermind or Hanabi, requiring careful observation of partners' clues and opponents' guesses.",
    tags: [
      'card-game',
      'social',
      'partnership',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'logic',
    LLM: 'Game: Logic. 4 players, 2 teams. 24 cards (A-Q of 2 suits). Deal 6 each; arrange ascending. Partner shows you one card privately. Guess opponent card by position+rank. Correct: opponent reveals. Wrong: you reveal one of yours. Can declare all remaining cards at any timeâ€”must be 100% correct or team loses.',
    Player: "Welcome to Logic! Arrange your 6 cards in ascending order. Your partner will show you one of theirsâ€”use this information wisely. Guess your opponents' hidden cards by position and rank. Guess right, they reveal. Guess wrong, you reveal one of yours. When you think you know ALL the hidden cards, declareâ€”but get even one wrong, and your team loses!",
    tagline: 'Infer, deduce, declareâ€”perfection is the only option.',
    gameCategory: 'Matching',
    subcategory: 'Memory / Partnership',
    playerMode: 'multiplayer',
    difficulty: 'Expert',
    duration: '20-30 minutes',
    origin: 'International (Modern Abstract)',
    originName: 'Logic',
    deck: '24 cards (A-Q from two suits, e.g., Hearts and Spades)',
