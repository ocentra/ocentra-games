          players: 'Minimum Players: 4\nMaximum Players: 4\nOptimal Players: 4\nPartnerships: None - individual play',
          deck: "Type: Standard 52-card deck with special classifications\nNumber of Decks: 1\nJokers: Not included\nSpecial classifications:\n- Diamonds = 'rabbits' (Ace of diamonds = 'Ace rabbit')\n- Hearts = 'dingoes'\n- Spades and Clubs = 'wolves'",
          equipment: 'Standard 52-card deck\nTable space for rabbit pile and discards\nScore sheet',
          dealing: 'First dealer chosen randomly, passes left after each game\nDealer separates diamonds from deck (except Ace of diamonds stays in main pack)\nDiamonds 2-K ordered low to high, placed face up in center (2 on top)\nMain pack: 40 cards (13 hearts, 13 spades, 13 clubs, 1 Ace of diamonds)\nShuffle and deal 10 cards to each player',
          hasPlaceholders: false,
        },
        rules: {
          objective: 'Score as many points as possible by the end of the game through the hunt phase.',
          gameplay: "DISCARD AND EXCHANGE PHASE (reduces hand from 10 to 6 cards):\n1. First Discard: Each player discards one card face up (Aces cannot be discarded)\n2. First Exchange (Left): Pass one card face down to left\n3. Second Discard: Everyone discards again\n4. Second Exchange (Across): Pass one card to player opposite\n5. Third Discard: Everyone discards again\n6. Third Exchange (Right): Pass one card to right\n7. Fourth Discard: Final discard, leaving 6 cards each\n\nTHE HUNT PHASE:\nRabbits hunted in ascending order (2 through King, then Ace)\nDealer calls rank, holder of dingo (heart) of that rank must play it\nOther players may play wolves (spades/clubs) of that rank:\n- No dingo: Rabbit discarded, no score\n- Dingo but no wolves: Dingo goes to penalty pile\n- Dingo and one wolf: Dingo to scoring pile, wolf player catches rabbit\n- Dingo and both wolves: First wolf and dingo to dingo player's scoring pile, second wolf catches rabbit\n\nACE HUNT (special rules):\nAll Aces must be in players' hands (cannot be discarded)\nDingo player plays Ace dingo, then each player in turn may play Ace wolves\nAce rabbit can only be played if both Ace wolves already played\nScoring based on which Aces are played",
          keyRules: [
            'Aces can never be discarded during exchange phase',
            'Dingo holder must play dingo when rank is called',
            'Only players other than dingo player can play wolves',
            'Ace rabbit can only be played after both Ace wolves played',
            'Never sensible to play both wolves if you hold both (first wolf scores for dingo player)',
            'Cards have different values in scoring vs penalty piles',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Manage your hand through discards and exchanges to keep valuable cards\nUnderstand when to play wolves during hunts\nAvoid being stuck with negative cards in penalty pile',
          intermediate: 'Strategic discarding to shape your hand for hunts\nEvaluate when to play wolves based on potential rabbit capture\nManage Ace cards carefully for final hunt',
          advanced: "Reading opponents' discards and exchanges for information\nComplex wolf play timing\nAce hunt endgame strategy\nProbability calculations for wolf distribution",
          tips: [
            'Never discard Aces - they cannot be replaced',
            'If you hold both wolves of a rank, never play both (first helps dingo player)',
            'Watch what cards opponents pass during exchanges',
            'Ace rabbit is very valuable (+10) but risky (-3 if stuck)',
            'Plan your 6-card hand carefully for the hunt phase',
          ],
          hasPlaceholders: false,
