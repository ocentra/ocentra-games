  data: {
    hero: {
      title: 'ONE-EYED JACK',
      subtitle: 'Card-Board Sequence Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'One-Eyed Jack',
            subtitle: 'Card-Board Sequence Game',
            content: [
              {
                type: 'paragraph',
                text: "One-Eyed Jack is a card-and-board game played in the Eastern USA. A 10x10 board has spaces corresponding to playing cards. Players use cards from hand to place chips on matching board spaces; the goal is to form rows of five chips. Two-eyed jacks (clubs, diamonds) are wildâ€”place a chip on any empty space. One-eyed jacks (hearts, spades) remove an opponent's chip from the board.",
              },
              {
                type: 'paragraph',
                text: 'Played in parts of the Eastern USA (North Carolina, Tennessee). Often home-made with a second deck cut and glued to form the board. Jax published a commercial version in 1982 under the name Sequence.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2, 3, or 4 players. Four typically play as partners (opposite seats).',
              },
              {
                type: 'paragraph',
                text: 'Two standard 52-card packs (104 cards). Board: 50 card-spaces from a second deck (4 jacks removed; 2 jokers = corner spaces).',
              },
              {
                type: 'paragraph',
                text: 'Two decks, board (10x10 with card faces in cells; jokers in corners), chips: 50 per colour (2 players/teams) or 40 per colour (3 players).',
              },
              {
                type: 'paragraph',
                text: '1. Deal 7 (2 players), 6 (3 players), or 5 (4 players) cards to each player. 2. Remaining cards form the stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Draw at Start: Draw a card at the start of your turn instead of the end.',
                  },
                  {
                    text: 'One-Eyed Jack Places: One-eyed jack can place a chip on any space (even occupied), replacing the token there.',
                  },
                  {
                    text: 'One-Eyed Cannot Break Row: One-eyed jack cannot remove a chip from a completed five-chip row.',
                  },
                  {
                    text: 'Dead Card Draw: If both spaces for a card are occupied, holder may discard it and draw a replacement (does not count as a turn).',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "One-Eyed Jack is a card-and-board game played in the Eastern USA. A 10x10 board has spaces corresponding to playing cards. Players use cards from hand to place chips on matching board spaces; the goal is to form rows of five chips. Two-eyed jacks (clubs, diamonds) are wildâ€”place a chip on any empty space. One-eyed jacks (hearts, spades) remove an opponent's chip from the board.",
    tags: [
