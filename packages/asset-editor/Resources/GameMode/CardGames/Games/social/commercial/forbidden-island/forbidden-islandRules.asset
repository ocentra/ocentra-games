  data: {
    LLM: 'Players take role actions to move, shore up flooded tiles, give cards, and claim treasures using matching treasure cards. After each turn, the flood deck floods or sinks island tiles, while Waters Rise cards increase pressure and reshuffle threats. The group wins or loses together.',
    Player: 'Players take role actions to move, shore up flooded tiles, give cards, and claim treasures using matching treasure cards. After each turn, the flood deck floods or sinks island tiles, while Waters Rise cards increase pressure and reshuffle threats. The group wins or loses together.',
    objective: 'Collect all four treasures and move every adventurer to the helicopter landing tile before the island sinks.',
    gameplay: 'Players take role actions to move, shore up flooded tiles, give cards, and claim treasures using matching treasure cards. After each turn, the flood deck floods or sinks island tiles, while Waters Rise cards increase pressure and reshuffle threats. The group wins or loses together.',
    keyRules: [
      'The flood deck maps directly to island locations.',
      'Treasure cards are collected as sets to claim treasures.',
      'All players share a cooperative win or loss.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
