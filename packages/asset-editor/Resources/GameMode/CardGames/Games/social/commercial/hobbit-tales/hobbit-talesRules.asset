    moveValidityConditions: {
      ante: "Beggar My Neighbour is a children's game of chance and does not utilize a monetary or chip-based ante.",
      deal: 'The entire deck is distributed equally by the system dealer at the start of the game session.',
      reveal_market: 'This is a closed-stack accumulation game where all cards are held in private stacks; no market exists.',
      buy_market: 'Players cannot purchase or swap cards from any shared area; they only play from their own stack.',
      buy_stock: "There is no remaining stock after the initial deal; every card is in a player's stack.",
      fold: "Participation is mandatory for every turn until a player's stack is completely exhausted.",
      check: 'The game follows a deterministic flip-and-pay structure rather than a vying structure with checks.',
      call: 'There are no bets to match in this game; competition is based on card accumulation through face-card triggers.',
      bet: 'Success is determined by collecting the physical cards rather than wagering points or currency.',
      raise: 'There is no wagering mechanic in this game, so raising stakes is not a valid action.',
      declare: 'The results of each card flip are immediate and public; no separate declaration phase is required.',
      reveal_hand: 'Stacks remain face down; only the top card is revealed when played onto the central pile.',
      award_pot: 'While players win the center pile, it is not a pot of chips; it is handled by Outcome A/B logic.',
      play_card: 'Must be your turn or your obligation to pay.',
      draw: 'New cards are only acquired by winning the central pile through successful face-card triggers.',
      discard: 'Every card remains in play until collected by a player or the game terminates; no discarding exists.',
      pass: 'Players cannot skip their turn to flip or pay; the sequence of actions is strictly forced.',
      bid: 'Beggar My Neighbour does not utilize a bidding system to determine game state or dealer.',
      meld: 'This is an accumulation game based on single card flips rather than building sets or sequences.',
      go_out: 'A player exits the game only when their stack is empty; the round terminates for the loser.',
    },
