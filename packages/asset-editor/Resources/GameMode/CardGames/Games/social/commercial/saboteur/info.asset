        rules: {
          objective: 'Miners try to complete a path to the gold while saboteurs try to prevent the route before the deck runs out.',
          gameplay: 'Players receive secret roles and hands of path or action cards. On each turn a player plays a path card, plays an action card to help or hinder, or discards and draws. The round score depends on whether a valid path reaches the treasure.',
          keyRules: [
            'Roles are hidden as Miner or Saboteur.',
            'Path cards must connect legally to the existing tunnel network.',
            'Action cards can block, repair, or manipulate other players.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Focus first on the visible objective in Saboteur: conserve cards or resources that directly advance the win condition.',
          intermediate: 'Track public information and avoid giving opponents easy tempo swings during the middle turns.',
          advanced: 'Plan several turns ahead around the scoring window and force opponents into low-value or defensive plays.',
          tips: [
            'Track the cards and roles that have already appeared.',
