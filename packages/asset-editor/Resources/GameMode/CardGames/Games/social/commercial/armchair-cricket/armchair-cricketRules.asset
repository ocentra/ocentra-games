  data: {
    LLM: 'Game: Armchair Cricket. Logic: Score more runs than the opponent while preserving wickets, using the selected cricket-length format.',
    Player: 'Armchair Cricket is a commercial cricket simulation card game using a dedicated 110-card pack where bowling and batting cards determine runs, wickets, and extras.',
    objective: 'Score more runs than the opponent while preserving wickets, using the selected cricket-length format.',
    gameplay: 'The bowler plays a delivery card and the batsman responds with a shot card. Same-suit higher cards score runs by the difference; lower off-suit cards can produce wickets. Optional no-ball, extras, lower-order, and two-card-shot rules add cricket detail.',
    keyRules: [
      'Requires a dedicated cricket-themed card pack.',
      'Bowler and batsman compare suit and value.',
      'Higher same-suit batting cards score runs.',
      'Different-suit lower batting cards can be out.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
