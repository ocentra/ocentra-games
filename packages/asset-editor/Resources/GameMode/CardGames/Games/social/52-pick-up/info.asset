    historyContent: {
      origins: '52 Pick-up is a long-standing English-language practical joke played with a standard deck. Reports place the prank before the 1974 novel titled 52 Pick-Up, including memories from the 1940s and later family play.',
      originCountries: [
        'USA',
      ],
      timeline: [
        '1940s: Reported as a children’s prank with a standard pack.',
        '1974: Elmore Leonard’s novel 52 Pick-Up uses the phrase as its title, after the game already existed.',
        'Modern era: Remains a well-known joke rather than a serious competitive game.',
      ],
      evolution: 'The activity has remained essentially unchanged: the offer to play is followed by scattering the cards and making the other person pick them up.',
      cultural: 'It is culturally remembered as a teasing children’s or family prank, useful mainly as a warning about accepting unfamiliar game invitations.',
    },
