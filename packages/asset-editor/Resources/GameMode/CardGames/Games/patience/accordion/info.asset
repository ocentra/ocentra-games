  data: {
    hero: {
      title: 'ACCORDION',
      subtitle: 'The Folding Row',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Accordion',
            subtitle: 'The Folding Row',
            content: [
              {
                type: 'paragraph',
                text: 'Accordion is a single-player patience game where all cards are laid into one row and compressed into piles by matching suit or rank. A card can move onto the pile immediately to its left or three positions to its left. The goal is to finish with one pile.',
              },
              {
                type: 'paragraph',
                text: 'Rules for The Idle Year published by William Brisbane Dick (1883) and Tarbart (1905). Wood & Goddard (1940) recorded it as Tower of Babel. The name Accordion appears in the 1950s (Culbertson, Goren). Parlett equates Accordion with Idle Year, Methuselah and Tower of Babel.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'One player. Accordion is a patience (solitaire) game played by a single player; there are no opponents or partners.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'One shuffled deck and table space for a long row of piles.',
              },
              {
                type: 'paragraph',
                text: 'Deal cards one by one from stock into a single row. After each deal, resolve any legal compression moves before dealing again if playing the incremental style.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Deal-All First: Deal all cards to the row first, then start moving.',
                  },
                  {
                    text: 'Play-As-You-Go: Deal one card at a time; resolve moves before dealing next. Original style, exceedingly difficult.',
                  },
                  {
                    text: 'Queen and Her Lad: Jones 1892. Q♥ as commencing card, J♥ at bottom of stock. Discard cards between two of same suit/rank.',
                  },
                  {
                    text: 'Royal Marriage: Reduce deck to King and Queen of same suit, placed at start and end of layout.',
                  },
                  {
                    text: 'Nidgi Novgorod: 1904 Standard Hoyle. Two equal-rank cards at top/bottom of pack; deal 4 in row; discard inner cards when outer match.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
