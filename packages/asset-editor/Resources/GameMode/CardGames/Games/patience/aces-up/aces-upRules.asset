      raise: 'Solitaire; no betting or raise.',
      declare: 'Patience game; no declaration phase.',
      reveal_hand: 'Solitaire; no hand reveal, tableau is always visible.',
      award_pot: 'Solitaire; no pot or award, win by reducing to one pile.',
      play_card: 'Source must be a top card; destination pile must be empty.',
      draw: 'Cards move from stock to tableau by deal action, not draw.',
      discard: 'Both cards must be top cards and same suit; discarded card must be lower rank.',
      pass: 'Solitaire; pass is a trick-taking concept, not used here.',
      bid: 'Solitaire; no bidding.',
      meld: 'Aces Up is patience; no melding of sets or runs.',
      go_out: 'Game ends when one pile remains or no moves; no go-out action.',
