    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Aces Up',
            subtitle: "Idiot's Delight",
            content: [
              {
                type: 'paragraph',
                text: 'Aces Up is a one-deck patience game where you discard lower top cards of a suit when a higher top card of that same suit is present. The objective is to finish with only the four aces.',
              },
              {
                type: 'paragraph',
                text: 'Aces Up appears in 20th-century patience collections and became widely known through digital solitaire suites.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'One player only. Aces Up is a patience (solitaire) game played by a single player using one deck and four tableau piles, with a space for discards.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'One shuffled deck and table space for four tableau piles.',
              },
              {
                type: 'paragraph',
                text: 'Deal four cards face up, one to each tableau pile. The rest of the deck is the stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Aces-Only Fill: Only an ace may be moved into an empty tableau space.',
                  },
                  {
                    text: 'Easy Aces Up: Allows moving any exposed card (not only top cards) to an empty space.',
                  },
                ],
              },
            ],
          },
        ],
      },
