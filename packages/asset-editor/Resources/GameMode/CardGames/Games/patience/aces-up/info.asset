          hasPlaceholders: false,
        },
        rules: {
          objective: 'The player wins by discarding all cards except the four aces. When the game ends, only the four aces should remain in the tableau; a maximum score of 48 discarded cards indicates a win, hence the name Aces Up.',
          gameplay: '1. Compare the top cards of the four tableau piles. 2. If two or more top cards share a suit, discard any lower-ranked card(s) of that suit; ace is highest. 3. If a tableau pile is empty, move any top card from another pile into that space. 4. When no further discard or move is available (or chosen), deal one new card onto each pile from stock. 5. Continue until stock is empty and no legal move remains.',
          keyRules: [
            'Only top cards are playable.',
            'Aces are high and therefore never discarded by same-suit comparison.',
            'Any top card may fill an empty pile in standard Aces Up.',
            'No redeal of stock in the standard game.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Create and preserve empty tableau spaces, since they are your main control tool.',
          intermediate: 'Prefer moves that expose buried high cards, especially aces and kings.',
          advanced: 'Delay dealing from stock when tactical moves remain, because each new row can lock useful moves.',
          tips: [
            'When several same-suit discards are possible, keep the highest card exposed.',
            'Use empty slots to extract trapped aces before final stock deals.',
          ],
          hasPlaceholders: false,
        },
