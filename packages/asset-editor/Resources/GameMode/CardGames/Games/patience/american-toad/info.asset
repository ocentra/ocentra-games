            content: [
              {
                type: 'paragraph',
                text: 'American Toad is a two-deck patience game related to Canfield, using a reserve, tableau, waste, and foundations that begin from a dealt base rank.',
              },
              {
                type: 'paragraph',
                text: 'American Toad is an American solitaire form in the Canfield family, extending that reserve-and-foundation pattern to a larger two-deck layout.',
              },
            ],
          },
