    tips: [
      {
        title: 'Tip',
        description: "The 'No Redeal' rule makes every card in the waste pile precious. Don't flip a stock card if you have a viable move on the tableau.",
      },
      {
        title: 'Tip',
        description: "Try to keep your tableau sequences 'pure' (uninterrupted suit order) to make them easier to move later.",
