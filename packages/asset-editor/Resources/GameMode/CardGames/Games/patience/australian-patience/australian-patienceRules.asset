      buy_market: 'There is no market or purchase mechanic in this patience game.',
      buy_stock: 'Cards are flipped from stock to waste only; no buying from stock.',
      fold: 'Single-player solitaire; no fold or surrender action.',
      check: 'No betting rounds; check does not apply to this game.',
      call: 'No betting; call is not used in Australian Patience.',
      bet: 'Patience has no wagering or bet action.',
      raise: 'No betting; raise does not apply to this solitaire.',
      declare: 'No declaration phase; players build foundations only.',
      reveal_hand: 'Tableau cards are always face-up; no reveal-hand phase.',
      award_pot: 'No pot or wager pool; win is by clearing all cards to foundations.',
      play_card: 'Moves use custom actions move_tableau_group and move_to_foundation.',
      draw: 'Drawing is flipping stock to waste via custom flip_stock action.',
      discard: 'Waste is a flip target only; no discard-from-hand in this game.',
      pass: 'Player always acts on tableau or waste; no pass action.',
      bid: 'No bidding; single player builds foundations only.',
      meld: 'No melding; cards move to tableau or foundations only.',
      go_out: 'Win is verified by system via verify_win when foundations are full.',
