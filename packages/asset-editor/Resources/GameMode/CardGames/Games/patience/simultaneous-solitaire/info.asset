    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Simultaneous Solitaire',
            subtitle: 'Solitaire',
            content: [
              {
                type: 'paragraph',
                text: 'Competitive patience in which two or more players each play the same solitaire layout (typically Klondike) at the same time; the first to complete their layout wins.',
              },
              {
                type: 'paragraph',
                text: 'Competitive patiences date to the late 19th century; any single-player patience can be played by two or more players in competition, each with their own layout.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players; each needs their own deck and table space.',
              },
              {
                type: 'paragraph',
                text: '52 cards per player',
              },
              {
                type: 'paragraph',
                text: 'One standard 52-card deck per player',
              },
              {
                type: 'paragraph',
                text: 'Each player deals their own deck into the chosen layout (e.g. Klondike: seven tableau columns with one to seven cards, first card face-up; remainder as stock).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Klondike: Use standard Klondike layout: seven tableau columns, four foundations, build down alternating color on tableau, up in suit on foundations; turn stock one or three at a time.',
                  },
                ],
              },
            ],
          },
        ],
      },
