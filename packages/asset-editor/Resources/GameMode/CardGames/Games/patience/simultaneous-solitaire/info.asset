        rules: {
          objective: "Be the first player to complete your solitaire layout by moving all cards to the foundations (or otherwise satisfying the chosen layout's win condition).",
          gameplay: 'All players start at the same time and play the same patience game (e.g. Klondike) on their own layout. There are no turns; everyone plays simultaneously. Legal moves are those of the underlying patience (e.g. build down in alternating color on the tableau, build up in suit on foundations, turn stock as allowed). The first to finish wins.',
          keyRules: [
            'Each player has an identical layout and deck.',
            'All players play at once; no turn order.',
            'Legal moves follow the underlying patience rules (e.g. Klondike).',
            'First player to complete their layout wins.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Play the same layout as your opponents; speed matters. Clear aces and deuces to foundations early.',
          intermediate: 'Balance building on tableau with filling foundations; avoid blocking key cards.',
          advanced: 'Memorize common Klondike dead-ends; prioritize moves that free the most cards.',
          tips: [
            'Agree on the layout (e.g. Klondike) and stock-turn rule (one or three cards) before starting.',
          ],
          hasPlaceholders: false,
        },
