    historyContent: {
      origins: "Developed in Sri Lanka as a local adaptation of games like 'Crapette' or 'Racing Demon'. The name 'Juse' (possibly a variant of the name 'Joseph' or a local exclamation) refers to the act of calling out a player's mistake.",
      originCountries: [
        'Sri Lanka',
      ],
      timeline: [
        'Mid-20th Century: Becomes a popular social game in Sri Lankan homes and schools.',
        '1990s: Rules are documented and standardized for club play.',
        "Present: A beloved traditional game, specifically known for the 'Juse!' penalty call.",
      ],
      evolution: "The game evolved to be cyclic (Ace follows King), which prevents the game from 'stalling' like many other solitaire variants.",
      cultural: "In Sri Lankan culture, Juse is a game of loud exclamations and sharp focus; calling 'Juse' on a friend is the highlight of the social interaction.",
