    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Juse',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Juse is a unique and high-intensity 'competitive patience' game from Sri Lanka. Unlike traditional solitaire, several players compete in real-time to build piles in the center and on each other's discard piles. It is a game of rapid pattern recognition where failure to play a 'forced' card results in a penalty (Juse!), making it a chaotic and energetic social experience.",
              },
              {
                type: 'paragraph',
                text: "Developed in Sri Lanka as a local adaptation of games like 'Crapette' or 'Racing Demon'. The name 'Juse' (possibly a variant of the name 'Joseph' or a local exclamation) refers to the act of calling out a player's mistake.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Any number, but odd numbers (3, 5, 7) are traditional.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranked cyclically: ...-A-2-3...-K-A-...',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranked cyclically: ...-A-2-3...-K-A-...',
              },
              {
                type: 'paragraph',
                text: 'Deal cards face-down equally until 1 card remains. That last card is placed in the center to start the first foundation pile.',
              },
            ],
          },
        ],
      },
