        rules: {
          objective: 'Expose all cards before the fourth king appears in the centre.',
          gameplay: 'Turn the top card of the current pile, move to the pile matching that rank, and continue until all cards are exposed or the king pile blocks the game.',
          keyRules: [
            'Thirteen piles are used.',
            'Ranks route play to the next pile.',
            'Kings route to the centre.',
            'The fourth king usually ends the game as a loss.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'There is almost no choice; use the game as a quick luck solitaire and track progress around the clock.',
          intermediate: 'Track the cards, suits, or resources that control the next legal plays, and avoid giving opponents a simple route to their scoring condition.',
          advanced: 'Use memory and tempo to force opponents into inefficient plays while preserving cards or resources that complete your own plan.',
