    historyContent: {
      origins: "Spider is a type of patience game and one of the more popular two-deck solitaires. The game originated in 1949; its name comes from a spider's eight legs, referencing the eight foundation piles (complete King-to-Ace same-suit sequences) that must be removed to win. It was said to be a favorite of Franklin D. Roosevelt. Spider became widely known through Microsoft Plus! 98 for Windows 98 (1998) and remains a standard computerized solitaire.",
      originCountries: [
        'USA',
      ],
      timeline: [
        '1917: Appears in game rule books.',
        '1998: Included in Windows 98 Plus! Pack.',
        'Present: A standard on every PC.',
      ],
      evolution: 'The 1-Suit variation was popularized by computers to make the game approachable.',
      cultural: "Known for its 'impossible' deals in 4-Suit mode requiring undo or pure luck.",
    },
    setupContent: {
