    historyContent: {
      origins: "First documented by the author 'Tarbart' in the 1905 publication 'Games of Patience'. Its name suggests an exotic origin, though it is more likely an English invention from the Victorian/Edwardian era fascination with North African themes.",
      originCountries: [
        'England',
      ],
      timeline: [
        '1905: Tarbart publishes the first known ruleset.',
        "1979: David Parlett includes it in the 'Penguin Book of Patience', standardizing the modern rules.",
        '2000s: Becomes a popular advanced level in computer solitaire collections like PySol.',
      ],
      evolution: "The game evolved as a more complex alternative to 'Tournament', adding more cells and the distinctive wrap-around building logic.",
      cultural: "Regarded by solitaire enthusiasts as a 'mental exercise' game rather than a quick pastime, often played in serious competition formats.",
    },
    setupContent: {
      players: 'One player only. Algerian is a solitaire (patience) game played by a single player.',
      deck: 'Two standard 52-card decks shuffled together (104 cards).',
      equipment: 'Standard tabletop or digital interface.',
      dealing: '1. **Foundations**: 8 slots (initially empty or 4 Aces/4 Kings placed if drawn). 2. **Tableau**: 8 depots with 1 card each. 3. **Reserve**: 6 piles with 4 cards each. 4. **Stock**: Remainder of the 104 cards.',
    },
    variationsContent: {
