      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: "Moves cards to foundations whenever possible without looking ahead. Frequently gets stuck because it 'packs away' cards needed for tableau sequencing.",
        medium: 'Understands the value of empty tableau slots. Tries to unblock reserve piles before making foundation moves.',
        hard: "Uses a search algorithm to look 5-10 moves ahead. Expertly balances the ascending and descending foundation heights and calculates when to 'wrap' the tableau for maximum clearance.",
      },
      considerations: [
        'The 104-card state space is massive; AI must use a priority-based move queue.',
        'Foundation meeting-point transfers must be modeled for high-level play.',
      ],
    },
