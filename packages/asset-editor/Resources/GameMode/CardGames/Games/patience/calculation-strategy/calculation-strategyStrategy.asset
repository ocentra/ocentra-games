    tips: [
      {
        title: 'Tip',
        description: "The 'Step of 4' sequence (4, 8, Q, 3...) is usually the hardest to remember. Practice reciting it before playing.",
      },
      {
        title: 'Tip',
        description: 'Never block a lower-value card with a higher-value one in a Waste pile unless you have no other choice.',
