    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Rangoon',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Rangoon (Rangoon Gaps) is a solitaire card game. Four rows of 13 cards with a gap in front of each. Move cards to gaps: a card may move only if it matches suit and is one rank lower than the card in front of the gap. Kings move to front gap. Goal: each row is one suit in order.',
              },
              {
                type: 'paragraph',
                text: 'Rangoon belongs to the Gaps (Montana) family of patience games, in which the goal is to arrange cards in suit sequence. The family includes Gaps, Montana, Spaces, Blue Moon, Addiction, Vacancies, and Clown Solitaire. These open non-builder solitaires use a single 52-card deck and are documented in twentieth-century card-game literature; Rangoon is a variant with four rows of thirteen cards and gaps filled by moving cards one rank lower than the card in front of the gap, with kings moving to the front gap.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack; single deck. Four suits, thirteen ranks each; no jokers.',
              },
              {
                type: 'paragraph',
                text: 'Cards, flat surface.',
              },
              {
                type: 'paragraph',
                text: 'Four rows of 13 face-up, one gap in front of each row.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
