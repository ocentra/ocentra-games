    historyContent: {
      origins: "Eight Off rose to prominence in the mid-20th century as part of the family of solitaire games that utilize 'cells' for temporary storage. It is often credited with inspiring Paul Alfille's creation of FreeCell in 1978.",
      originCountries: [
        'USA',
      ],
      timeline: [
        "Early 20th Century: Variations of 'reserves' games circulate in gambling and social circles.",
        "1970s: Standardized as 'Eight Off' in computer solitaire collections.",
        "Modern: Maintained as a standard challenge for solitaire enthusiasts who find FreeCell's alternating color rule too lenient.",
      ],
      evolution: 'The game shifted from simple foundations to its present form where sequence moves are heavily dependent on empty reserve calculation.',
      cultural: "Regarded as a 'Thinking Person's' solitaire due to its extremely high winnable percentage for skilled players.",
    },
    setupContent: {
      players: 'One player only. Eight Off is a patience (solitaire) game played by a single person; there are no opponents or partners.',
