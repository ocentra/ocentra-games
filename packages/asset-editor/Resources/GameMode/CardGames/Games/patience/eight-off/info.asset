        setup: {
          players: 'One player only. Eight Off is a patience (solitaire) game played by a single person; there are no opponents or partners.',
          deck: 'Single standard 52-card deck; all cards dealt face up into eight tableau columns and four reserve cells at the start.',
          equipment: 'Standard deck and a playing surface; no other equipment required.',
          dealing: 'Deal face up: six cards to each of eight tableau columns, and the remaining four cards into the first four reserve (free) cells.',
          hasPlaceholders: false,
        },
        rules: {
          objective: 'Move all 52 cards to the four foundation piles, organized by suit from Ace up to King.',
          gameplay: "1. Foundation Building: Move any available Ace to a foundation slot. Build up on it in the same suit (2, 3, 4...).\n2. Tableau Building: You may move a card onto another card in the tableau if it is exactly one rank lower and of the SAME SUIT (e.g., 9 of Hearts onto 10 of Hearts).\n3. Reserves: Any exposed card can be moved to an empty Free Cell. Only one card per cell.\n4. Moving Sequences: You can move a correctly ordered suit-sequence if you have enough empty cells to 'shuttle' the cards. Movement is limited to (Empty Cells + 1).",
          keyRules: [
            'Only KINGS (or sequences starting with a King) can be moved into an empty tableau column.',
            'Building is strictly SAME SUIT (unlike FreeCell which is alternating colors).',
            'Cells can be used for any card rank.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Prioritize clearing out the first four occupied cells as quickly as possible to increase your mobility. Never move a card into a cell if you can keep it in the tableau.',
          intermediate: 'Empty Columns: An empty column is more valuable than a free cell because it can hold a whole sequence of cards (starting with a King). Work toward emptying a column early.',
          advanced: "The Suit-Lock: Since building is by same suit, if you have a high card of a suit (like a Jack) buried under a low card of the SAME suit (like a 4), that column is 'locked' until the 4 is moved. Identify and solve these suit-locks immediately.",
          tips: [
            'Always scan the tableau for Aces to move to foundations first.',
            "Calculate sequence moves carefully; don't initiate a move if you won't have the cell space to complete it.",
          ],
          hasPlaceholders: false,
        },
