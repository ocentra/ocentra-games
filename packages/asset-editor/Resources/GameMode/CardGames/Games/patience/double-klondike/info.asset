    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Double Klondike',
            subtitle: 'Patience rules and play flow',
            content: [
              {
                type: 'paragraph',
                text: 'Double Klondike is a challenging two-deck variation of the world-famous Klondike Solitaire. By using 104 cards, the game features a larger tableau of nine columns and eight foundation piles. While the fundamental rules of alternating colors and building sequences remain the same, the increased volume of cards creates more opportunities for advanced maneuvering and sequencing.',
              },
              {
                type: 'paragraph',
                text: "Klondike itself originated during the 19th-century gold rush in the Yukon. The 'Double' version emerged in the early 20th century as players sought a more complex and longer-lasting challenge than the standard 52-card version.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'One player (solitaire). The player works alone with two combined 52-card decks, building the tableau of nine columns and eight foundation piles until all 104 cards are moved to the foundations.',
              },
              {
                type: 'paragraph',
                text: '104 cards (Two identical 52-card decks).',
              },
              {
                type: 'paragraph',
                text: 'Two card decks, large playing surface.',
              },
              {
                type: 'paragraph',
                text: 'Deal 9 tableau columns: Column 1 has 1 card, Column 2 has 2, ..., Column 9 has 9 cards. Only the top card of each column is face-up. Remaining cards form the Stock.',
              },
            ],
          },
        ],
      },
    ],
