    historyContent: {
      origins: "Fortress, also known as 'Chessboard' in some regional histories, is an old European solitaire that likely predates the 20th century. Its name is derived from the appearance of the ten columns of cards, which resemble the battlements of a castle's fortress.",
      originCountries: [
        'France',
        'Germany',
        'United Kingdom',
      ],
      timeline: [
        '1800s: Early versions of suit-based building solitaires appearing in France and Germany.',
        "1910s: Formalized in English 'Patience' books as 'The Fortress'.",
        "Present: A standard inclusion in digital solitaire collections for its unique 'two-way building' mechanic.",
      ],
      evolution: "The game is a cousin of 'Beleaguered Castle', but differentiates itself by allowing both ascending and descending sequences in the columns.",
      cultural: "Regarded as a 'thinker's solitaire' due to the complete lack of hidden information.",
    },
    setupContent: {
      players: 'One player only. Fortress is a patience (solitaire) game; the entire deck is laid out at the start and the single player moves cards between the tableau columns and the four foundations.',
      deck: 'Standard 52-card deck.',
      equipment: 'Standard 52-card deck.',
      dealing: 'Deal 52 cards face-up into 10 columns: two columns of 6 cards (one on the left, one on the right) and eight columns of 5 cards. Four foundation spaces in the centre for aces.',
    },
    variationsContent: {
      list: [
        {
          id: 'chessboard',
          name: 'Chessboard',
          description: 'Played like Fortress except the player may freely choose the starting rank of all four foundations. Building can go round-the-corner (aces may be placed on kings and vice versa).',
        },
      ],
      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: 'Makes any legal move without planning; frequently empties columns too early, leading to deadlocks.',
        medium: 'Prioritizes Ace-extraction; understands suit tracking; avoids emptying columns unless necessary.',
        hard: "Performs recursive depth searches to calculate multi-step maneuvers; identifies 'frozen suits' at the start and works to resolve them first; never loses a game that is mathematically solvable.",
      },
      considerations: [
        'AI must treat Fortress as a graph-search problem since all moves are deterministic and known from the start.',
      ],
    },
