  data: {
    LLM: 'Game: Streets and Alleys. Logic: See rules.objective and rules.gameplay.',
    Player: 'Streets and Alleys (also known as Gaps or Lane) is a solitaire game played with a single 52-card deck. It is similar to Beleaguered Castle but with a different layout. The entire deck is dealt into 8 tableau piles (wings). The goal is to build up the four foundations from Ace to King by suit.',
    objective: 'Move all 52 cards onto the four foundations. Build each foundation up in suit from Ace to King; the game is won when every card has been moved to the foundations.',
    gameplay: 'Top cards of tableau piles are available. Build tableaus down in sequence regardless of suit or color. Build foundations up in suit from Ace to King. An empty tableau pile may be filled with any single available card. Move cards between tableaus and from tableaus to foundations until all 52 cards are on the foundations.',
    keyRules: [
      'Tableau builds down regardless of suit.',
      'Foundations build up in suit from Ace.',
      'Empty tableau may hold any one card.',
      'Only the top card of each tableau is available.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'Single player. A patience or solitaire game for one; all cards are laid out at the start with no hidden information.',
      deck: 'One standard 52-card deck. The entire deck is dealt at the start into eight tableau piles; no draw pile remains.',
      equipment: 'One standard deck and table space for eight tableau piles and four foundations.',
      dealing: 'Shuffle and deal the entire deck into 8 tableau piles in two wings of four each, with four foundation spaces in between. The top four piles receive 7 cards each, the remaining four receive 6 each. All cards are dealt face up.',
    },
    turnFlow: 'Top cards of tableau piles are available. Build tableaus down in sequence regardless of suit or color. Build foundations up in suit from Ace to King. An empty tableau pile may be filled with any single available card. Move cards between tableaus and from tableaus to foundations until all 52 cards are on the foundations.',
