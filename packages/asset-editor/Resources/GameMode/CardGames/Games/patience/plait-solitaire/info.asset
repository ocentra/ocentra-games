    historyContent: {
      origins: "Dates back to the mid-19th century as a complex 'Grand Patience' played in European parlors. The 'Plait' layout was designed to provide a decorative yet difficult reserve element.",
      originCountries: [
        'United Kingdom',
        'Germany',
      ],
      timeline: [
        '1865: First appearance in German and British Patience manuals.',
        "1920s: Recorded in 'The Complete Patience' as a benchmark for high-level solo play.",
        '1990s: Implemented in early digital solitaire collections (e.g., BVS Solitaire).',
        'Present: Remains a favorite for players who find Klondike too simple and FreeCell too repetitive.',
      ],
      evolution: "The game was simplified from even more complex triple-deck versions (like 'The Rope') to maintain a balance between difficulty and table space.",
      cultural: "Often described as the 'Thinking Player's Solitaire' because it rewards memorization of the plait's internal layers.",
    },
