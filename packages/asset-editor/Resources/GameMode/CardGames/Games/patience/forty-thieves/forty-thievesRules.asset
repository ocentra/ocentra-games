  data: {
    LLM: 'Game: Forty Thieves. Logic: See rules.objective and rules.gameplay.',
    Player: "Forty Thieves, also known as 'Napoleon at St. Helena' or 'Roosevelt at San Juan', is a notoriously difficult and strategic two-deck Solitaire game. Requiring 104 cards, the game challenges players to organize a vast tableau of 40 cards into eight separate foundations. Unlike many solitaires, building in the tableau must be done strictly by suit and in descending order. Because the stock can only be cycled through once, and only a single card is drawn at a time, players must exercise extreme caution to avoid blocking their own win path.",
    objective: 'Move all 104 cards into the 8 foundation piles, building each from Ace up to King by suit.',
    gameplay: '1. Stock: Click the stock to deal one card at a time to the waste pile.\n2. Re-Deals: NO re-deals are allowed. Once the stock is empty, the game ends if no more moves remain.\n3. Foundations: Build from Ace, 2, 3... King by suit.',
    keyRules: [
      'Single Move Only: The inability to move stacks/sequences makes the preservation of empty columns the most vital part of the game.',
      'Face-Up: Since matches are by suit and rank, you are rarely searching for hidden information, but rather calculating complex sequences of moves.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: 'One player only. Forty Thieves is a patience (solitaire) game; the single player plays against the layout, moving cards from the tableau and stock to the eight foundations. There are no opponents or partnerships.',
      deck: 'Two standard decks shuffled together (104 cards).',
      equipment: 'Two standard decks shuffled together (104 cards).',
      dealing: 'Deal 40 cards in 10 columns of 4, all face-up. Place remaining 64 in stock. Eight foundation piles above.',
    },
