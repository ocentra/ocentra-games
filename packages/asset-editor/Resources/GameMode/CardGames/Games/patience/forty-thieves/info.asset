          equipment: '',
          dealing: 'Deal 40 cards in 10 columns of 4, all face-up. Place remaining 64 in stock. Eight foundation piles above.',
          hasPlaceholders: false,
        },
        rules: {
          objective: 'Move all 104 cards into the 8 foundation piles, building each from Ace up to King by suit.',
          gameplay: '1. Stock: Click the stock to deal one card at a time to the waste pile.\n2. Re-Deals: NO re-deals are allowed. Once the stock is empty, the game ends if no more moves remain.\n3. Foundations: Build from Ace, 2, 3... King by suit.',
          keyRules: [
            'Single Move Only: The inability to move stacks/sequences makes the preservation of empty columns the most vital part of the game.',
            'Face-Up: Since matches are by suit and rank, you are rarely searching for hidden information, but rather calculating complex sequences of moves.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Do not empty a column unless you have a card ready to put in it immediately. Empty columns are your only 'working space' to shuffle cards around.",
          intermediate: "Priority Foundation Building: Get the low cards (Aces and 2s) to the foundations as soon as possible. Because there are two of every card, it's easy to accidentally bury a 2 of Spades under a long sequence of other cards.",
          advanced: "The 'Empty Slot' Strategy: Treat an empty column like an extra hand. Use it to temporarily hold a card that is blocking a deep run in another column. If you can clear out two columns, your win percentage skyrockets.",
          tips: [
            'Wait to draw from the stock until you have exhausted all possible moves in the tableau.',
            'If you have two identical cards (e.g., two 8 of Diamonds) available to move onto a 9, check which one is blocking more important cards beneath it.',
          ],
          hasPlaceholders: false,
        },
        variations: {
          list: [],
          hasPlaceholders: false,
