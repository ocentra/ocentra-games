    historyContent: {
      origins: 'The game gained legendary status as the favorite pastime of Napoleon Bonaparte during his exile on the island of Saint Helena. Its name refers to the 40 cards dealt into the initial tableau, resembling a gathered band of thieves guarding their treasure.',
      originCountries: [
        'France',
        'United Kingdom',
      ],
      timeline: [
        '1800s: Traditional French and British versions documented in early patience manuals.',
        '1815-1821: Napoleon famously plays the game during his exile.',
        '1900s: Becomes a staple of high difficulty solitaire literature, known for its low win rate (estimated at 10-20% even for expert players).',
        'Present: A hallmark feature of premium digital solitaire suites.',
      ],
      evolution: "Has inspired numerous easier variations, like 'Lucas' or 'Maria', but the original 'Napoleon' rules remain the most respected.",
      cultural: 'Symbolizes patience and strategic endurance in the face of overwhelming odds.',
    },
    setupContent: {
      players: 'One player only. Forty Thieves is a patience (solitaire) game; the single player plays against the layout, moving cards from the tableau and stock to the eight foundations. There are no opponents or partnerships.',
      deck: 'Two standard decks shuffled together (104 cards).',
      equipment: 'Two standard decks shuffled together (104 cards).',
      dealing: 'Deal 40 cards in 10 columns of 4, all face-up. Place remaining 64 in stock. Eight foundation piles above.',
    },
    variationsContent: {
      list: [],
      noVariationsReason: 'Sources describe only the standard form; no separate named variants documented.',
    },
    aiContent: {
      difficulty: {
        easy: 'Moves cards to foundations immediately but fails to manage the tableau; draws from the stock too quickly; never creates empty columns.',
        medium: 'Attempts to clear columns; manages suit and building sequences; knows that only single cards move.',
        hard: "Performs exhaustive search to find the optimal 'Empty Slot' rotation; avoids moving cards that could be reached more efficiently via the stock; calculates the 'Thief Count' for every column to identify which are worth clearing.",
      },
      considerations: [
        "AI must factor in the 'No Re-deal' constraint, making stock management the highest priority weight.",
      ],
    },
