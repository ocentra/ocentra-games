      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: "Doesn't understand the 'Rubbish' vs 'Honor' distinction. Leads Sevens illegally.",
        medium: 'Respects the Seven-lead rule. Uses the stock swap when hand score is below a threshold.',
        hard: "Simulates the 8 cards in the stock to calculate the risk of the swap. Tracks ties and plays 'first' to win Jack-battles.",
      },
      considerations: [
        'AI must handle a highly non-standard ranking table.',
        'The tie-break rule (temporal priority) must be baked into the trick-evaluation logic.',
      ],
    },
