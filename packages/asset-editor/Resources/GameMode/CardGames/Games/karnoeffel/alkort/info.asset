    historyContent: {
      origins: 'Part of the oldest surviving family of European card games, Alkort was preserved in the isolation of Iceland for centuries. It shares DNA with the German Karnöffel and Swiss Kaiserspiel.',
      originCountries: [
        'Iceland',
      ],
      timeline: [
        '1726-1768: Referenced by Eggert Ólafsson as a native Icelandic pastime.',
        '1880s: Detailed rules published by Ólafur Davíðsson.',
        "1989: Modern Icelandic standard finalized in 'Spilabók AB'.",
      ],
      evolution: "Has changed little since the 18th century, maintaining its complex 'Stock Exchange' rule and the 'Stroke' scoring system.",
      cultural: "Regarded as a test of memory and partnership intuition. The term 'Bísefarnir' (Sevens) is a unique Icelandic card-game jargon.",
    },
    setupContent: {
      players: '4 players in two fixed partnerships (North-South vs East-West).',
      deck: '44 cards (52 minus the 10s and 5s). Ace is high, but rankings are non-linear.',
      equipment: '44-card deck, scoreboard.',
      dealing: 'Dealer gives 9 cards to each player in batches of 3. The remaining 8 cards form a face-down stock (hidden).',
    },
    variationsContent: {
