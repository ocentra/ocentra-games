        tabLabel: 'About',
        pages: [
          {
            title: 'Alkort',
            subtitle: 'Ice and Iron Tricks',
            content: [
              {
                type: 'paragraph',
                text: 'Alkort is a legendary Icelandic partnership game belonging to the ancient Karnöffel family. It is famous for its archaic, bizarre card rankings where Sevens are invincible when led, and the King of Diamonds reigns supreme—unless a Seven is turned against him.',
              },
              {
                type: 'paragraph',
                text: 'Part of the oldest surviving family of European card games, Alkort was preserved in the isolation of Iceland for centuries. It shares DNA with the German Karnöffel and Swiss Kaiserspiel.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: '44 cards (52 minus the 10s and 5s). Ace is high, but rankings are non-linear.',
              },
              {
                type: 'paragraph',
                text: '44-card deck, scoreboard.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives 9 cards to each player in batches of 3. The remaining 8 cards form a face-down stock (hidden).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Two-Player Alkort: Identical rules but played as a duel. The stock exchange remains a vital element.',
                  },
                ],
              },
            ],
          },
        ],
