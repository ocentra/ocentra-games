    hero: {
      title: 'Brus Denmark',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Brus Denmark',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Brus Denmark is a partnership or solo trick-taking game from the Karnöffel family in which special beating cards, sevens and certain kings outrank the rest of the deck. Players aim to win five tricks out of nine and can score bonus points by "risking" high honours that may be beaten.',
              },
              {
                type: 'paragraph',
                text: 'Brus descends from the German game Brusbart in the wider Karnöffel family and was historically a rural West Jutland game. It spread through Denmark and to Swedish-speaking communities in Estonia while retaining the family’s distinctive matadors and special sevens.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 4\nPartnerships: Optional',
              },
              {
                type: 'paragraph',
                text: 'Type: 36-card French pack (6–10, J, Q, K, A in each suit)\nNumber of Decks: 1\nJokers: Not included; created by removing all 2s, 3s, 4s and 10s plus jokers from a standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck\nScore sheet (optional)\nTable space',
              },
              {
                type: 'paragraph',
                text: 'Cards per Player: Varies by player count\nDealing Pattern: Clockwise\n--',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Brus with 4-card hands: Variant where each player is dealt four cards instead of three, making it possible to lead four cards together and increasing the frequency of multiple-card tricks while keeping the same beating-card structure.',
                  },
                  {
                    text: 'Brus with no stock: All cards are dealt at the start of the hand (for example 9 each in the four-player partnership game), so there is no stock to draw from and every trick is played from a fixed hand.',
                  },
                ],
              },
            ],
          },
        ],
      },
