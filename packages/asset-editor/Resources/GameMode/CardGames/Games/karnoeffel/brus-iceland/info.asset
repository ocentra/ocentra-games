        },
        scoring: {
          description: 'Teams track progress on a five-rung score comb, erasing one rung for each point earned by winning a hand, winning all nine tricks, or scoring from legal risks and smacks with the King of hearts.',
          winCondition: 'The first partnership to erase all five rungs on their side of the score comb wins the game; the number of remaining rungs on the losing side shows the margin of victory.',
          cardValues: {},
          penalties: {},
          splitRules: 'If tricks are shared without either side reaching five, no one scores that hand and the next hand is played normally.',
          targetScore: 5,
