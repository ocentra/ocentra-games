    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Bräus Gotland',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Bräus is an unusual partnership trick-taking game from the Swedish island of Gotland, played by two teams of two or three using a 36-card pack stripped from the standard deck.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: Sweden (Gotland)\nTime Period: Medieval roots via the Karnöffel family; modern Gotland rules documented in the late 20th century.\nHistorical Development: Local descendant of the German Karnöffel group, adapted and preserved as a regional partnership game on Gotland.\nCultural Significance: Traditional island game still played socially in Gotland, showcasing an unusual hierarchy of special cards and sevens-as-tricks.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 4\nMaximum Players: 6\nOptimal Players: 4\nPartnerships: Two teams of two or three players.',
              },
              {
                type: 'paragraph',
                text: 'Type: Standard 36-card deck (2–5 removed from each suit)\nNumber of Decks: 1\nJokers: Not included',
              },
              {
                type: 'paragraph',
                text: 'Standard 36-card deck\nScore sheet (optional)\nTable space',
              },
              {
                type: 'paragraph',
                text: "Four-player game: 9 cards per player. Six-player game: 6 cards per player. Dealing Pattern: Clockwise, with the player to dealer's right cutting.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Four-player Bräus (two teams of two): Canonical Bräus table with four players in two partnerships; each player is dealt nine cards from the 36-card pack.',
                  },
                  {
                    text: 'Six-player Bräus (two teams of three): Extended Bräus table with six players in two partnerships of three; each player is dealt six cards from the 36-card pack.',
                  },
                ],
              },
            ],
          },
        ],
      },
