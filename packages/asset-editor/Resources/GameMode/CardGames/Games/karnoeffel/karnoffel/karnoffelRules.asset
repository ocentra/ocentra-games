  data: {
    LLM: 'Game: Karnöffel. See rules.objective and rules.gameplay for details.',
    Player: "KarnÃ¶ffel is arguably the oldest identifiable European card game still played today, with records dating back to 1426. It is a highly unusual trick-taking game where players are allowed to communicate freely with their partners. The game is famous for its chaotic 'Elected Suit' ranking, featuring cards with evocative names like the Joker-like 'KarnÃ¶ffel' (Unter), the 'Pope' (6), and the 'Devil' (7).",
    objective: 'Win at least three out of the five tricks in a hand to score points for your team.',
    gameplay: '1. Standard trick-taking. NO OBLIGATION to follow suit (this is a key medieval rule).\n2. Players can talk to their partners, showing cards or suggesting plays.\n3. The leader of a partnership (the Director) often makes the final decision on signals.',
    keyRules: [
      'No requirement to follow suit; highest card of led suit or highest trump wins the trick.',
      'Lowest of the four face-up cards (one per player) determines the chosen (trump) suit for the deal.',
      'First team to win three tricks wins the deal. Partners sit opposite; communication between partners is allowed.',
      'Devil (7 of chosen suit) may not be played to the first trick; it beats all only when led.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Typically 4 players in two partnerships.',
      deck: '32 cards (Standard 32, German suits: Acorns, Leaves, Hearts, Bells). French equivalent: remove 2s through 6s.',
      equipment: '32 cards (Standard 32, German suits: Acorns, Leaves, Hearts, Bells). French equivalent: remove 2s through 6s.',
      dealing: "Deal 5 cards to each player, one at a time. The first card of each player's hand is dealt face up; the lowest of these face-up cards determines the chosen (trump) suit. If two tie, the first dealt decides. Then players pick up their cards.",
    },
