    historyContent: {
      origins: "Originates in Finland, likely derived from the Swedish game 'Mas' or 'Skitgubbe'. The name 'Knorri' is localized Finnish slang for the rhythmic flipping of cards.",
      originCountries: [
        'Finland',
        'Sweden',
      ],
      timeline: [
        'Late 19th Century: Beating games gain popularity in the Nordic maritime trade routes.',
        "1920s: Knorri becomes a distinct Finnish variant with the 'Diamonds-as-Trump' rule.",
        'Present: Played in rural Finland and among traditional card game enthusiasts.',
      ],
      evolution: "Knorri preserved the 'Complete Information' aspect of early Nordic beating games, where all cards are visible during the first phase.",
      cultural: "Commonly played as a social game where 'losing' is the main concern, rather than scoring high points.",
    },
