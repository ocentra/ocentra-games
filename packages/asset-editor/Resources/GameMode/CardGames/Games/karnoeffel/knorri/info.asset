    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Knorri (Hörri)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Knorri (also known as HÃ¶rri) is a traditional Finnish card game for three to eight players. It belongs to the 'beating' or 'avoidance' family of games (like Skitgubbe). The game is uniquely divided into two phases: a 'Collection Phase' where cards are picked up from the table based on rank-matching, and a 'Trick Phase' where players must play the cards they collected to avoid being the last person with cards in hand.",
              },
              {
                type: 'paragraph',
                text: "Originates in Finland, likely derived from the Swedish game 'Mas' or 'Skitgubbe'. The name 'Knorri' is localized Finnish slang for the rhythmic flipping of cards.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Best with 4-5 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Diamonds are **Trumps**. Clubs are **Hard/Anti-Trump** (Anti-Truff).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Diamonds are **Trumps**. Clubs are **Hard/Anti-Trump** (Anti-Truff).',
              },
              {
                type: 'paragraph',
                text: 'No cards are dealt to players. 9 cards are placed face-up on the table to start. The rest form a draw pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Soft clubs: Clubs can be beaten by any spade, heart or diamond; diamonds trump all, hearts and spades trump clubs, clubs beat only lower clubs.',
                  },
                  {
                    text: 'Scoring: Optional scoring: +1 per player still in when you go out; loser gets negative points so total is zero (e.g. 4-player: +3, +2, +1, -6).',
                  },
                  {
                    text: 'Last Card: Player with one card must announce "last card" before next player plays; forgetting forces them to take bottom card of trick on next turn instead of going out.',
                  },
                ],
              },
            ],
          },
        ],
      },
