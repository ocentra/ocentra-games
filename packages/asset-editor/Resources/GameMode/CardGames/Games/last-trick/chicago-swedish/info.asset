          {
            title: 'Chicago (Swedish)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Chicago (Swedish): 2â€“4 players, 52 cards. Three phases per hand: (1) draw then claim best poker hand for points; (2) draw again, claim again; (3) draw then play tricks, no trumps; last trick scores 5. Declare Chicago to take all 5 tricks for 15 or lose 15. First to 52 wins.',
              },
              {
                type: 'paragraph',
                text: 'Swedish game; popular in Ã–stergÃ¶tland; not the American Chicago poker nor Bridge Chicago.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2â€“4; dealer chosen at random, rotates clockwise.',
              },
              {
                type: 'paragraph',
                text: '52 cards, no jokers.',
              },
              {
                type: 'paragraph',
                text: 'Score sheet.',
              },
              {
                type: 'paragraph',
                text: '5 cards each, one at a time.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Four of a kind reset: Player with four of a kind may score 7 points or reset all other players' scores to zero; hand ends if reset.",
                  },
                  {
                    text: 'Straight flush 10 points: Some play 10 points for straight flush instead of 8.',
                  },
                  {
                    text: 'Exchange limit 42: Some play that the limit at which you can no longer exchange cards is 42 rather than 46.',
                  },
                  {
                    text: 'Chicago declarer leads: Player who declares Chicago in phase three then leads to the first trick.',
                  },
                  {
                    text: 'Chicago required in three-player: In three-player, a player must have succeeded with at least one Chicago to win at 52 or more; 52 without a Chicago is zeroed.',
                  },
                ],
              },
            ],
          },
        ],
      },
