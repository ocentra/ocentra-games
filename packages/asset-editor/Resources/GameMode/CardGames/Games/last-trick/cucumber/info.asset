        rules: {
          objective: 'Avoid winning the last trick of each hand; the player who takes the final trick receives penalty points. Stay below the elimination threshold (e.g. 21 or 30) and be the last player remaining.',
          gameplay: 'Forehand leads first trick. On each play, a player must either play a card equal to or higher than the current highest card in the trick, or play their lowest card. Highest card (or last of equals) wins trick and leads next. Winner of the final trick takes the penalty.',
          keyRules: [
            'Lose-last-trick objective: final trick winner is penalized.',
            'Beat-or-lowest rule governs legal play choices.',
            'Highest rank wins trick; in ties, last played equal rank wins.',
            'Penalty is typically the rank value of the losing last-trick card.',
            'Many tables eliminate players at threshold score (for example 21 or 30).',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Dump dangerous high cards when possible before the final trick.',
          intermediate: 'Track which players still hold high ranks to avoid being trapped into winning trick seven.',
          advanced: 'Manipulate lead timing so opponents are forced into overtake-or-lowest dilemmas late.',
          tips: [
            'Holding both very high and very low cards gives better endgame flexibility.',
            'Late-trick position strongly affects whether a tie-high can be forced onto another player.',
          ],
