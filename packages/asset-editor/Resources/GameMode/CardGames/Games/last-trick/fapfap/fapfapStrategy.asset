    tips: [
      {
        title: 'Tip',
        description: 'Never waste an Ace or 10 winning an early trick unless absolutely necessary.',
      },
      {
        title: 'Tip',
        description: 'If you win the 4th or 5th trick with a low card, you control the lead for the final trick and can play your strongest card.',
      },
      {
        title: 'Tip',
        description: "Count remaining players' likely hand strength: after 4 tricks, estimate what each opponent still holds.",
      },
      {
        title: 'Tip',
        description: "In Cameroon stakes variant, taking two consecutive tricks (especially the last two) with 3's is the ultimate combo.",
      },
