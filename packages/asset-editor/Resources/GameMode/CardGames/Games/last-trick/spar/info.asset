    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Spar',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Spar is the most popular card game in Ghana. It is a trick-taking game without trumps in which the object is to win the last trick. Played by 2 to 4 players (up to 7 possible) with 35 cards from a standard pack. Similar games are played in Benin as Jeu de Carte and in Togo as Sipa. Often played for money or for enjoyment.',
              },
              {
                type: 'paragraph',
                text: 'Likely introduced by European sailors playing Whist or similar games, adapted locally.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2, 3 or 4 (up to 7 possible).',
              },
              {
                type: 'paragraph',
                text: '35 cards: 6 through Ace in each suit; Ace of Spades normally not used.',
              },
              {
                type: 'paragraph',
                text: '35 cards: 6 through Ace in each suit; Ace of Spades normally not used.',
              },
              {
                type: 'paragraph',
                text: "First dealer chosen at random; thereafter the winner of each hand deals the next. Five cards to each player: a batch of three to each (starting with player to dealer's left if clockwise), then a batch of two each, ending with the dealer.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Seven cards: Some deal seven cards each; then max 5 players and the seventh (last) trick is scored.',
                  },
                  {
                    text: 'Include Ace of Spades: Some players include the Ace of Spades so the pack has 36 cards.',
                  },
                  {
                    text: 'Under ten rule: A player dealt no card higher than 9 may trade in all five cards for a new hand before play.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Spar is the most popular card game in Ghana. It is a trick-taking game without trumps in which the object is to win the last trick. Played by 2 to 4 players (up to 7 possible) with 35 cards from a standard pack. Similar games are played in Benin as Jeu de Carte and in Togo as Sipa. Often played for money or for enjoyment.',
