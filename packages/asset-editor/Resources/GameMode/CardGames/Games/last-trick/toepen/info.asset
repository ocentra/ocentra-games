    hero: {
      title: 'TOEPEN',
      subtitle: 'Dutch Last-Trick Pressure',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Toepen',
            subtitle: 'Dutch Last-Trick Pressure',
            content: [
              {
                type: 'paragraph',
                text: 'Toepen is a Dutch no-trump last-trick game for 3-8 players. Stakes increase through knocking, which forces fold-or-stay decisions and turns each four-trick hand into a bluffing and risk-management contest.',
              },
              {
                type: 'paragraph',
                text: 'Toepen is a long-standing Dutch social game, often played as a drinking or pub game, and is closely related to German regional forms such as Tuppen and Siwweschroom.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-8 players in clockwise order; dealer rotates.',
              },
              {
                type: 'paragraph',
                text: '32-card deck with rank 10 (high), 9, 8, 7, A, K, Q, J (low). No trumps.',
              },
              {
                type: 'paragraph',
                text: 'Cards and a life/penalty score tracker.',
              },
              {
                type: 'paragraph',
                text: 'Dealer gives 4 cards to each player. Player left of dealer leads first trick.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Fast Drinking Response: After a knock, players fold immediately (simultaneous tempo); hesitation counts as staying in.',
                  },
                  {
                    text: 'Ordered Tournament Response: After a knock, responses proceed in turn starting left of the knocker.',
                  },
                  {
                    text: 'Elimination Continuation: After one player reaches 10 points and drops out, others continue until one player remains.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Toepen is a Dutch no-trump last-trick game for 3-8 players. Stakes increase through knocking, which forces fold-or-stay decisions and turns each four-trick hand into a bluffing and risk-management contest.',
    tags: [
      'card-game',
      'trick-taking',
      'social',
      'bluffing',
    ],
    comingSoon: false,
    minPlayers: 3,
    maxPlayers: 8,
    routePath: 'toepen',
    LLM: 'Game: Toepen. Loop: deal 4 each -> 4 tricks no-trump follow-suit -> optional knock/fold windows -> score by last-trick result and knock level. Rank: 10,9,8,7,A,K,Q,J. Objective: minimize penalties; game ends when threshold reached.',
    Player: 'Toepen is about surviving the fourth trick. You can knock to raise the stake, but everyone still in pays more if they lose. Fold too early and you leak points; stay too long and you can get crushed.',
    tagline: 'Raise, fold, or bleed points.',
    gameCategory: 'Trick-taking',
    subcategory: 'Last-trick / Knocking',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-45 minutes',
