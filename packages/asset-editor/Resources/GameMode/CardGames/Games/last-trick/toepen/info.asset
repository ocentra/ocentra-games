    historyContent: {
      origins: 'Toepen is a long-standing Dutch social game, often played as a drinking or pub game, and is closely related to German regional forms such as Tuppen and Siwweschroom.',
      originCountries: [
        'Netherlands',
      ],
      timeline: [
        'Traditional play: Established in Dutch social circles as a fast last-trick game.',
        'Tournament era: Formalized procedures for knocking and folding appear in organized play.',
        'Present: Continues in both serious and drinking-table formats.',
      ],
      evolution: 'The core rules remained stable: 32 cards, unusual 10-high rank order, no trumps, and stake escalation by knocking.',
      cultural: 'Its social identity comes from table talk, bluffing, and timing pressure around immediate fold decisions after knocks.',
    },
    setupContent: {
      players: '3-8 players in clockwise order; dealer rotates.',
      deck: '32-card deck with rank 10 (high), 9, 8, 7, A, K, Q, J (low). No trumps.',
