        },
        rules: {
          objective: 'Win the fifth and last trick to win the game. There is no point scoring; the only goal is to take the final trick.',
          gameplay: "1. Deal: Five cards each in two batches (three then two). Player to dealer's right cuts. Play proceeds counter-clockwise.\n2. Play: The player to dealer's right leads any card face up. Each player in turn must play a card of the same suit if possible; otherwise any card. Highest card of the suit led wins the trick.\n3. Next trick: The winner of the trick leads any card to start the next trick.\n4. Winning: After five tricks, whoever won the fifth (last) trick wins the game and deals next.",
          keyRules: [
            'Must follow suit when possible; otherwise any card may be played',
            'Rank in each suit (high to low): A, 10, 9, 8, 7, 6, 5, 4, 3. In spades the highest card is 10 (Ace of Spades is removed)',
            'Winner of the last trick wins the game',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Follow suit when possible; try to keep high cards for the last trick.',
          intermediate: 'Track which cards have been played; count remaining cards in each suit to judge when to take the lead.',
          advanced: 'Time winning the lead so you can control the last trick; avoid wasting high cards early.',
          tips: [
            'Winning the fifth trick is the only goal; earlier tricks matter only for positioning.',
          ],
          hasPlaceholders: false,
        },
