        strategy: {
          basic: 'Preserve control cards for late tricks rather than spending them early.',
          intermediate: 'Track void suits to predict forced discards before final trick.',
          advanced: 'Shape trick flow so your lead/control aligns with trick six rather than intermediate trick count.',
          tips: [
            'Early sacrifice can be correct if it improves your final-trick position.',
            'Count remaining high cards in each suit as tricks progress.',
