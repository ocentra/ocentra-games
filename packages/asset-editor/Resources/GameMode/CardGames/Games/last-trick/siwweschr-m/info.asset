    historyContent: {
      origins: 'Siwweschroom is documented as a local West German form of Dutch Toepen, especially in the Eifel region and parts of the Rhineland.',
      originCountries: [
        'Germany',
        'Netherlands',
      ],
      timeline: [
        'Traditional period: Toepen family games circulate in the Low Countries and neighboring German regions.',
        'Modern documentation: Siwweschroom is recorded as a named regional variant linked to Toepen.',
        'Present: Still played as a social pub and table game under local spellings.',
      ],
      evolution: 'Compared with Dutch Toepen, Siwweschroom keeps the same core play but typically omits the theatrical whistle/stand announcements for three or four tens or jacks.',
      cultural: 'The game sits in a local tradition of noisy, social, risk-taking card play where table image and timing of knocks matter as much as card strength.',
    },
    setupContent: {
      players: '3-8 players in clockwise order. Dealer rotates each hand.',
      deck: '32-card pack. Rank in every suit is 10 (high), 9, 8, 7, A, K, Q, J (low). There are no trumps.',
      equipment: 'Cards plus a score track for penalty points.',
      dealing: "Deal 4 cards to each player. Leader is player to dealer's left.",
    },
