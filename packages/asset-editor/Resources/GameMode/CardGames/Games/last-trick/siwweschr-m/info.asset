    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Siwweschroom',
            subtitle: 'Eifel Last-Trick Elimination',
            content: [
              {
                type: 'paragraph',
                text: 'Siwweschroom is an Eifel and Rhineland variant of Toepen, a no-trump last-trick game played with four-card hands and aggressive knocking. Players who accumulate seven penalty points are eliminated; the last remaining player wins.',
              },
              {
                type: 'paragraph',
                text: 'Siwweschroom is documented as a local West German form of Dutch Toepen, especially in the Eifel region and parts of the Rhineland.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-8 players in clockwise order. Dealer rotates each hand.',
              },
              {
                type: 'paragraph',
                text: '32-card pack. Rank in every suit is 10 (high), 9, 8, 7, A, K, Q, J (low). There are no trumps.',
              },
              {
                type: 'paragraph',
                text: 'Cards plus a score track for penalty points.',
              },
              {
                type: 'paragraph',
                text: "Deal 4 cards to each player. Leader is player to dealer's left.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Fast Folding Response: After a knock, players effectively decide immediately and simultaneously whether to fold or stay.',
                  },
                  {
                    text: 'Ordered Folding Response: After a knock, responses proceed in turn starting left of the knocker.',
                  },
                  {
                    text: 'Toepen-Style End: Play to a fixed loser at 10 lives instead of elimination at 7.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Siwweschroom is an Eifel and Rhineland variant of Toepen, a no-trump last-trick game played with four-card hands and aggressive knocking. Players who accumulate seven penalty points are eliminated; the last remaining player wins.',
    tags: [
      'card-game',
      'trick-taking',
      'social',
      'bluffing',
    ],
    comingSoon: false,
    minPlayers: 3,
    maxPlayers: 8,
    routePath: 'siwweschr-m',
    LLM: 'Game: Siwweschroom. Structure: Deal 4 each -> 4 tricks -> score penalties -> eliminate at 7. Rules: no trumps, must follow suit, highest of led suit wins. Only last trick decides hand winner; knocks raise stake; folds concede current stake; cannot fold your own knock.',
    Player: 'Siwweschroom is last-trick survival. Four tricks decide each hand, and knocks can raise the pain at any time. Win the final trick or fold wisely, because seven penalty points knocks you out of the game.',
    tagline: 'Read the room, raise the stake, survive the table.',
    gameCategory: 'Trick-taking',
    subcategory: 'Last-trick / Elimination',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-45 minutes',
    origin: 'Germany (Eifel, Rhineland)',
    originName: 'Siwweschrööm / Schröömen',
    deck: '32-card French pack (10, 9, 8, 7, A, K, Q, J in each suit)',
    alsoKnownAs: [
      'Schroomen',
      'Eifelpoker',
      'Tuppen',
      'Siwweschr M Eifel Poker',
      'Siwweschroom Eifelpoker',
    ],
    playersDisplay: '3-8',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
