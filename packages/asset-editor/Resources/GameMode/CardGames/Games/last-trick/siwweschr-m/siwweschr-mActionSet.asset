    customActions: [
      {
        supported: true,
        description: 'Rap the table to raise the stake by one life; other players may fold (lose current stake) or stay in. The last player to knock may not knock again until someone else has knocked; a player may not knock and then fold on their own knock.',
        cost: '0',
        constraints: 'Allowed once all players have seen their cards; may occur at any time during the hand including during a trick.',
        isTerminating: false,
        effectType: 'play',
        id: 'knock',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Assign penalty lives: each player who stayed in but did not win the last trick loses one life plus one per knock in the hand; each player who folded loses the current stake (one life per knock that had occurred when they folded).',
        cost: '0',
        constraints: 'Applied after the fourth trick is complete; winner of last trick loses no life.',
        isTerminating: false,
        effectType: 'play',
        id: 'apply_penalties',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Remove from the game any player who has reached seven penalty points; the last remaining player wins the game.',
        cost: '0',
        constraints: 'Checked after penalties are applied each hand; players at seven points drop out.',
        isTerminating: false,
        effectType: 'play',
        id: 'eliminate_players',
