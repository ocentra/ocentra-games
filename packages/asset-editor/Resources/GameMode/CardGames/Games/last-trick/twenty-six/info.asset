                type: 'paragraph',
                text: '52 cards; for 6+ use multiple packs (one per ~4 players)',
              },
              {
                type: 'paragraph',
                text: '52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Seven cards each (or varies by variant).',
              },
