    historyContent: {
      origins: 'Candyman (also known as Drug Dealer) is a modern social deduction party game that uses playing cards to assign secret roles. The game was documented by Bonnie Fishell and has become popular as a party game due to its simple rules and social interaction elements.',
      originCountries: [
        'USA',
      ],
      timeline: [
        '20th century: Game created as social party game',
        'Documented by Bonnie Fishell with scoring system',
        'Current: Popular party game worldwide',
      ],
      evolution: "Originally played without scoring as a casual party game. Bonnie Fishell's version added a scoring system that reflects each role's objectives, making it suitable for competitive play over multiple rounds.",
      cultural: 'Known by two names - Candyman (family-friendly) and Drug Dealer (adult). The game is popular at parties and gatherings due to its social interaction and bluffing elements.',
    },
    setupContent: {
