    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Staekske Rape',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Staekske Rape (Limburgish: 'Pick Up the Stock') is a Dutch Jass game played in Maastricht and surrounding areas. It is played by four players with a 32-card deck (7s through Aces), featuring a bidding process where the winner takes the 4-card 'Stock' and names trumps. It combines trick-taking with meld declarations ('Stoek' and 'Vier' - 4 of a kind, sequence of 3+).",
              },
              {
                type: 'paragraph',
                text: "Dates to the 19th century as a local variant of Klaverjassen/Jass. The name is dialect for 'Stock Grabbing'.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players (or five with dealer sitting out each hand).',
              },
              {
                type: 'paragraph',
                text: '32 cards: A, K, Q, J, 10, 9, 8, 7 in clubs, spades, hearts, diamonds (French or Dutch indices).',
              },
              {
                type: 'paragraph',
                text: 'Cards.',
              },
              {
                type: 'paragraph',
                text: "First dealer: deal face-up clockwise until someone receives a jack. Then shuffle, player to dealer's right cuts. Deal clockwise: 3 cards to each player, 4 face-down in centre (stock), then 4 cards to each player. Everyone has 7 cards.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Blind 2: On first round only, a player may bid 2 without looking at cards (contract 120 points). Next bid over blind 2 must be 4, not 3.',
                  },
                  {
                    text: 'Without stock: Declarer may choose to play with original 7 cards without taking the stock. Card points in stock still count for declarer; game points won or lost are doubled.',
                  },
                ],
              },
            ],
          },
        ],
      },
