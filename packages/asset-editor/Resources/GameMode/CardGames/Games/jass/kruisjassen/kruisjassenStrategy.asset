    tips: [
      {
        title: 'Tip',
        description: 'The trump Nine (14 points) is almost as valuable as an Ace - protect it.',
      },
      {
        title: 'Tip',
        description: "If you have many trumps, lead them early to draw out opponents' trumps.",
      },
      {
        title: 'Tip',
        description: 'Pay attention to which high cards have been played to calculate remaining points.',
      },
