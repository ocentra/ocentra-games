    historyContent: {
      origins: "Brought to the Arabian Peninsula by French influence or via merchants in the early 20th century. While it shares the DNA of Belote, it was heavily adapted to local tastes, particularly with the introduction of the 'Sun' contract and the doubling of scores.",
      originCountries: [
        'Saudi Arabia',
      ],
      timeline: [
        '1920s: Belote-style games appear in Hijaz (Western Saudi Arabia).',
        "1950s: Rules for 'Sun' and 'Hokom' stabilize into the modern Baloot format.",
        '2018: The first officially sanctioned Saudi Baloot Championship is held in Riyadh with a record-breaking prize pool.',
        'Present: One of the most played social games in the Arab world, with numerous high-quality mobile apps.',
      ],
      evolution: 'Modern Baloot has become highly standardized due to national tournaments, which settled many regional rule disputes.',
      cultural: "Typically played in 'Siraus' (social gatherings) where tea and conversation accompany the rigorous mental play.",
    },
    setupContent: {
      players: '4 players. North-South vs East-West.',
      deck: '32-card pack. Remove cards 2-6 from a standard 52-card deck.',
      equipment: '32 cards, score pad.',
      dealing: 'Dealer gives 3 cards to each player, then 2. The next card is turned face up. Players then bid to take the contract (Hokom/Sun or Pass). Once a contract is chosen, the dealer finishes the deal so everyone has 8 cards.',
    },
    variationsContent: {
