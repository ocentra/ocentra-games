      noVariationsReason: '',
    },
    aiContent: {
      difficulty: {
        easy: "Doesn't remember cards played. Never declares projects unless prompted. Always bids Sun even with weak hands.",
        medium: 'Understands the basic card values. Calculates the 152-point goal but struggles with complex doubling logic.',
        hard: 'Expertly tracks every card in the 32-card deck. Predicts opponent voids by the 3rd trick. Perfect partnership signaling through discards.',
      },
      considerations: [
        'Requires two separate hand evaluation engines for Sun vs Hokom.',
        "Must handle the 'Challenge' phase (Gawa/Kahwa) using an expected value (EV) model.",
      ],
    },
