    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'baloot',
    LLM: 'Game: Baloot. Type: Trick-taking (Belote derivative). Rules: 32 cards. Contracts: Sun (doubled score, no trump) or Hokom (trump). Win last trick (10 pts). Target 152 game points. Projects: Sequences/Sets.',
    Player: 'The 7 of Diamonds is turned. Will you take it as Hokom, or call for the doubling power of Sun? Remember to declare your projects before the second trick, or those points are lost to the desert.',
    tagline: 'Sun or Hokom? The 152-point quest for Arabian supremacy begins here.',
    gameCategory: 'Trick-taking',
    subcategory: 'Jass / Belote',
    playerMode: 'multiplayer',
