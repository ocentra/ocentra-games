        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Thuni (Nigerian)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Nigerian Thuni is a trick-taking game related to South African Thunee but played as a plain-trick game (no card points). The objective is winning tricks rather than counting card values, though the unusual ranking (J-9 high) remains.',
              },
              {
                type: 'paragraph',
                text: 'Likely introduced by expatriates or travelers familiar with the South African or Indian versions.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '24 cards (or 32). Rank: J-9-A-10-K-Q.',
              },
              {
                type: 'paragraph',
                text: 'Cards',
              },
              {
                type: 'paragraph',
                text: 'Deal 6 cards each (4 then 2) with 24-card deck, or 8 each with 32-card deck. Dealer offers cut to left.',
              },
            ],
          },
        ],
      },
