  data: {
    LLM: 'Game: Thunee. Logic: See rules.objective and rules.gameplay.',
    Player: "Thunee (or Thuni) is a popular trick-taking card game in South Africa, particularly among Indian South Africans in Durban. It is related to the Jass family of games (like 304). The name 'Thunee' means 'water' in Tamil (though the connection is debated) or refers to a specific call. Unusually, the Jack and Nine are the highest cards. The game involves bidding and 'ball' scoring.",
    objective: 'Win tricks to score points (Balls). First to 12/13 Balls wins.',
    gameplay: '1. Deal 4. 2. Bidding (10, 20, etc., or Thunee). Highest bidder sets Trump. 3. Deal 2. 4. Play tricks. Must follow suit. Trumping allowed if void. 5. Scoring: Card values: J=30, 9=20, A=11, 10=10, K=3, Q=2. Total 104 points (plus bonus?).',
    keyRules: [
      'J > 9 > A > 10 > K > Q',
      'Thunee call = All tricks',
      'Khanock = Penalty/Double',
      'Ball scoring',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
