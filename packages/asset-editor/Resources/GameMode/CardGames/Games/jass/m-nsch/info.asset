    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mënsch',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "MÃ«nsch is a Swiss Jass game for four players in partnerships. It belongs to the Jass family of games popular in Switzerland and surrounding regions. The game features the 'Mensch' (Queen of Clubs) as a permanent highest trump, similar to other games in the Ombre/Solo family. Players bid for the right to choose trumps and must make their contract.",
              },
              {
                type: 'paragraph',
                text: 'MÃ«nsch is a Swiss Jass game, part of the larger Jass family that originated in the Netherlands and spread to Switzerland. It shares ancestry with games like Ombre and Solo.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships, partners sitting opposite each other.',
              },
              {
                type: 'paragraph',
                text: '36-card Jass deck (6 through Ace in four suits: Acorns, Shields, Flowers, Bells). Can use standard deck with 5s and below removed. Ranking in trumps: Under (Jack), 9, Ace, King, Ober (Queen), Banner (10), 8, 7, 6. In non-trump: Ace, King, Ober, Under, Banner, 9, 8, 7, 6.',
              },
              {
                type: 'paragraph',
                text: '36-card Jass deck or modified standard deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: '9 cards to each player, dealt in packets of 3.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Mënsch Luxembourg: Luxembourg variant with different bidding conventions.',
                  },
                  {
                    text: 'Schafkopf-Mensch: Bavarian-influenced variant with different card ranks.',
                  },
                ],
              },
            ],
          },
        ],
      },
