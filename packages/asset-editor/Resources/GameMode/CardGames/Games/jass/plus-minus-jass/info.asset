    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Plus-Minus Jass',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Plus-Minus Jass is a Swiss Jass variant for 3 or 4 players. Cards are dealt equally and played as in Mittlere or Molotow. Scoring is by sticks only (no potatoes). The first player to score 7 sticks wins. If everyone scores under 100 card points, the players with most and least points each score one stick; if someone takes 100 or more, only the player with least points scores a stick.',
              },
              {
                type: 'paragraph',
                text: 'Plus-Minus Jass is a Swiss Jass variant documented alongside Mittlere and Molotow in English-language card game literature. It uses the same deal and trick-taking rules as Mittlere (3 players) or Molotow (4 players) but scores only sticks; the first to 7 sticks wins.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 or 4 players, each playing for themselves.',
              },
              {
                type: 'paragraph',
                text: '36-card Jass deck (Ace, King, Ober, Under, Banner, 9, 8, 7, 6 in four suits). Can use standard deck with cards below 6 removed.',
              },
              {
                type: 'paragraph',
                text: '36-card Jass deck or modified standard deck; scoring tokens or slate for sticks.',
              },
              {
                type: 'paragraph',
                text: 'All cards dealt equally: 9 each for 4 players, 12 each for 3 players, in packets of 3. Deal and play anticlockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Three players: 12 cards each; scoring rules same as 4-player.',
                  },
                  {
                    text: 'Four-player tie for most or least: When two tie for most or least card points, neither scores but one stick is held in abeyance until the next hand when only one of them scores, then given to that player.',
                  },
                ],
              },
            ],
          },
        ],
      },
