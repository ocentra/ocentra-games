    tips: [
      {
        title: 'Tip',
        description: 'Announce your Bell (K-Q) when playing the second card to ensure the 20 points.',
      },
      {
        title: 'Tip',
        description: "Don't lead a lone non-trump Ace if trumps haven't been cleared; it's a prime target for a ruff.",
      },
      {
        title: 'Tip',
        description: "The 'Mule' (4 Jacks) is almost an automatic round win - protect those Jacks at all costs.",
