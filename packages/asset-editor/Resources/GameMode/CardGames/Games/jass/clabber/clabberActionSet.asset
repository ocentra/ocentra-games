    customActions: [
      {
        supported: true,
        description: 'Dealer deals all 24 cards one at a time clockwise so that each player receives six cards.',
        cost: '0',
        constraints: 'Dealer only; performed at start of each deal.',
        isTerminating: false,
        effectType: 'play',
        id: 'deal_6_per_player',
        effectHints: {},
      },
      {
        supported: true,
        description: "The dealer's last card is turned face up; its suit is the trump candidate for the first round of bidding.",
        cost: '0',
        constraints: 'Dealer only; after dealing, before bidding.',
        isTerminating: false,
        effectType: 'play',
        id: 'turn_up_trump_card',
        effectHints: {},
      },
      {
        supported: true,
        description: "Say 'I play' to accept the turned suit as trump (first round) or to name a different trump suit (second round). Your team undertakes to take more points than the opponents.",
        cost: '0',
        constraints: "You must hold at least one card of the trump suit you are proposing. First round: accept face-up card's suit. Second round: name a suit different from the turned card.",
        isTerminating: false,
        effectType: 'play',
        id: 'play',
        effectHints: {},
      },
      {
        supported: true,
        description: "Play the first card to the trick. Player to dealer's left leads to the first trick; thereafter the winner of the previous trick leads.",
        cost: '0',
        constraints: 'Legal when it is your turn to lead; any card from hand.',
        isTerminating: false,
        effectType: 'play',
        id: 'lead',
        effectHints: {},
      },
      {
        supported: true,
        description: 'Play a card of the suit that was led. You must follow suit if you can.',
        cost: '0',
        constraints: 'When following suit you must play a card of the led suit if you have one; no obligation to beat the cards already in the trick.',
        isTerminating: false,
        effectType: 'play',
        id: 'follow',
        effectHints: {},
      },
      {
        supported: true,
        description: 'When you have no card of the suit led, you must play a trump if you have one. Only if you have neither may you play a card of another non-trump suit.',
        cost: '0',
        constraints: 'Void in the led suit; must play a trump if able.',
        isTerminating: false,
        effectType: 'play',
        id: 'ruff_mandatory',
        effectHints: {},
      },
      {
        supported: true,
        description: 'When a trump is led, or a non-trump was trumped, you must beat the highest trump so far in the trick if you can; if you cannot beat it you must still play a trump if you have one.',
        cost: '0',
        constraints: 'When void in led suit and playing a trump, or when following to a trump lead; must overtrump if able.',
        isTerminating: false,
        effectType: 'play',
        id: 'overtrump',
        effectHints: {},
      },
      {
        supported: true,
        description: 'During the first trick, announce scoring combinations (Dad, Fifty, Running 100, four of a kind, Mule, Bell). The team with the highest-ranking meld scores all their melds; show melds before playing to the second trick.',
        cost: '0',
        constraints: 'Must announce just before playing a card to the first trick; no card may be used in more than one meld except Bell cards.',
        isTerminating: false,
        effectType: 'play',
        id: 'announce_meld',
        effectHints: {},
      },
    ],
