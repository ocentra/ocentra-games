    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mittlere Jass',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Mittlere Jass is an unusual Swiss Jass game for three players. It is a point trick game where the basic objective is to avoid ending up with the middle score. The game features dynamic trump determination - the first suit played that cannot be followed becomes trumps for the rest of the hand. It is played with sticks (which players try to win) and potatoes (which players try to avoid).',
              },
              {
                type: 'paragraph',
                text: 'Mittlere Jass is a Swiss Jass variant, part of the larger Jass family that originated in the Netherlands and became extremely popular in Switzerland. The game was documented by Nick Wedd in English-language card game literature.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 players, each playing for themselves.',
              },
              {
                type: 'paragraph',
                text: '36-card Jass deck (6 through Ace in four suits: Acorns, Shields, Flowers, Bells). Can use standard deck with 5s and below removed.',
              },
              {
                type: 'paragraph',
                text: '36-card Jass deck or modified standard deck, scoring slate (for sticks and potatoes).',
              },
              {
                type: 'paragraph',
                text: 'All 36 cards dealt out, 12 to each player, in packets of 3. Deal and play are anticlockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Molotow Jass: Four-player version derived from Mittlere, with modified scoring.',
                  },
                  {
                    text: 'Plus-Minus Jass: Another variant with different scoring structure.',
                  },
                ],
              },
            ],
          },
        ],
      },
