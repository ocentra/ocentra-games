    historyContent: {
      origins: 'Mittlere Jass is a Swiss Jass variant, part of the larger Jass family that originated in the Netherlands and became extremely popular in Switzerland. The game was documented by Nick Wedd in English-language card game literature.',
      originCountries: [
        'Switzerland',
        'Netherlands',
      ],
      timeline: [
        'Traditional: Developed within Swiss Jass tradition',
        'Modern: Documented and shared through Jass-playing communities',
        'Present: Played by Jass enthusiasts, particularly those seeking three-player options',
      ],
      evolution: 'The game is the three-player ancestor of Molotow Jass (for four players). The unique middle-score objective distinguishes it from other Jass games.',
      cultural: 'Jass is the national card game of Switzerland, played in pubs, clubs, and homes throughout the country. Mittlere offers a unique three-player option in a game family often optimized for four.',
