        rules: {
          objective: 'Avoid having the middle score. Score points by winning tricks, but avoid being caught in the middle.',
          gameplay: "Player to dealer's right leads to first trick. Must follow suit if possible. If unable to follow, may play any card - if no trump is established, this card's suit becomes trumps. Once trump is established, must follow suit or trump if void.",
          keyRules: [
            'First void play determines trumps',
            'Avoid the middle score',
            'Total 157 points in deck',
            'Sticks are good, potatoes are bad',
            '12 hands per game',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Try to win either many points (79-99 is safe) or very few points (under 29 is safe). Avoid the middle range. Ensure you win at least one trick.',
          intermediate: 'Control when trumps are established by choosing when to void yourself. Win early tricks to control the lead. Preserve 6s (guaranteed exits) and Aces.',
          advanced: 'Card counting is essential. Track suit distribution to predict when trumps will be established. Coordinate (without explicit communication) to force opponents into the middle. Calculate risk ranges based on cards played.',
          tips: [
            '79-99 points guarantees a stick (others have less)',
            'Under 29 points guarantees a stick (someone has 100+ or no tricks)',
            'Win at least one trick or you get 2 potatoes',
            '6s are valuable as guaranteed exits',
            'Leading short suits increases chance of establishing favorable trumps',
          ],
