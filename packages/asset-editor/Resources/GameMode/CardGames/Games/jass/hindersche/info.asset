        rules: {
          objective: 'Avoid taking tricks with high point values. The player with the MOST points in a round loses a point (mark on the slate).',
          gameplay: '1. The player to the right of the dealer leads.\n2. You must follow suit if possible.\n3. **Trumps**: The last card dealt to the dealer determines the trump suit.\n4. **The Reverse Rule**: If you cannot follow suit, you MUST play a trump if you have one.',
          keyRules: [
            'Follow the legal action constraints defined for Hindersche.',
            'Round outcome is resolved by the scoring method: Ace-Ten scoring (A=11, 10=10, K=4, O/Q=3, U/J=2).',
            'Winning condition: Avoid taking tricks with high point values.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Void suits early to smear high-value cards (Ace and Ten) onto opponents.',
          intermediate: "Manage your trumps carefully. If you have low trumps, use them to win 'cheap' tricks so you don't have to take expensive ones later.",
          advanced: "The 'March': If you have extremely high cards, you might try to win every single trick, which can sometimes result in a special bonus or clearing multiple strokes.",
          tips: [
            "Leading a Ten is called 'selling a Tenner' - hope that someone else is forced to buy it!",
            'Save a low card in each suit to exit tricks when needed.',
          ],
          hasPlaceholders: false,
        },
