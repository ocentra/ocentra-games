      title: 'HINDERSCHE',
      subtitle: 'The Black Forest Reverse Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Hindersche',
            subtitle: 'The Black Forest Reverse Game',
            content: [
              {
                type: 'paragraph',
                text: "Hindersche (meaning 'Backwards') is a rare and traditional reverse trick-taking game played exclusively in the central Black Forest of Germany. It is an Ace-Ten game where the objective is to *avoid* taking tricks containing card points. It is noted for its antiquity, using a 36-card pack and being played anticlockwise.",
              },
              {
                type: 'paragraph',
                text: 'A local game from the Kinzig and Wolf valleys. It is believed to be over 200 years old, traditionally played by farmers and foresters.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players playing individually (non-partnership).',
              },
              {
                type: 'paragraph',
                text: '36-card German-suited pack (A, K, O, U, 10, 9, 8, 7, 6). Ranking: A > K > O > U > 9 > 8 > 7 > 6 > 10 (Note the low Ten!).',
              },
              {
                type: 'paragraph',
                text: '36-card German-suited pack (A, K, O, U, 10, 9, 8, 7, 6). Ranking: A > K > O > U > 9 > 8 > 7 > 6 > 10 (Note the low Ten!).',
              },
              {
                type: 'paragraph',
                text: 'Play and dealing are ANTICLOCKWISE. Dealing varies but usually involves batches of cards to reach 9 cards per player.',
              },
            ],
          },
        ],
      },
    ],
    description: "Hindersche (meaning 'Backwards') is a rare and traditional reverse trick-taking game played exclusively in the central Black Forest of Germany. It is an Ace-Ten game where the objective is to *avoid* taking tricks containing card points. It is noted for its antiquity, using a 36-card pack and being played anticlockwise.",
    tags: [
      'card-game',
      'trick-taking',
      'social',
      'traditional',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 4,
    routePath: 'hindersche',
    LLM: 'Game: Hindersche (German Black Forest reverse trick-taking). 4 players, 36-card German deck, 9 cards each. Anticlockwise play. Trump: Last card to dealer. Follow suit if able; else trump if possible. Scoring: A(11) 10(10) K(4) O(3) U(2). Highest points = 1 stroke. 4 strokes = eliminated. Zero points in hand = clear 1 stroke.',
    Player: "Welcome to Hindersche, the ancient Black Forest game. Unlike most tricks games, you want to avoid taking points. Play anticlockwise with 9 cards using 36-card German suits. Aces and Tens are deadlyâ€”try to smear them onto other players. The player with the most points in a hand gets a stroke mark. Accumulate 4 strokes and you're out!",
    tagline: 'Avoid taking points. Spread high cards. Survive four strokes.',
    gameCategory: 'Trick-taking',
    subcategory: 'Trick-taking',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '30-45 minutes',
    origin: 'Germany (Black Forest)',
    originName: 'Hindersche (German dialect: backwards)',
    deck: '36-card German-suited deck (Schafkopf/Jass deck)',
    alsoKnownAs: [
      'Backwards',
      'Black Forest Trick Game',
      'German Hindersche',
      'Negative Trick Game',
    ],
    playersDisplay: '4',
    quality: 'complete',
    completeness: {
      overview: true,
      history: true,
      setup: true,
      rules: true,
      strategy: true,
      variations: true,
      ai: true,
      sources: true,
    },
    historyContent: {
      origins: 'A local game from the Kinzig and Wolf valleys. It is believed to be over 200 years old, traditionally played by farmers and foresters.',
      originCountries: [
        'Germany',
      ],
      timeline: [
        '1800s: Traditional oral transmission of rules.',
        '1933: First written mention of the game.',
        '2014: Official rules codified and published online for tournament play.',
        "Present: Annual 'World Championships' held in Schapbach, Germany.",
      ],
      evolution: "Developed as a 'negative' counterpart to a game called 'Viersche' (Forwards). It has preserved antique features like anticlockwise play and the Ten ranking low.",
      cultural: 'A point of regional pride and a rare survivor of localized card game cultures.',
    },
    setupContent: {
      players: '4 players playing individually (non-partnership).',
      deck: '36-card German-suited pack (A, K, O, U, 10, 9, 8, 7, 6). Ranking: A > K > O > U > 9 > 8 > 7 > 6 > 10 (Note the low Ten!).',
      equipment: '36-card German-suited pack (A, K, O, U, 10, 9, 8, 7, 6). Ranking: A > K > O > U > 9 > 8 > 7 > 6 > 10 (Note the low Ten!).',
      dealing: 'Play and dealing are ANTICLOCKWISE. Dealing varies but usually involves batches of cards to reach 9 cards per player.',
