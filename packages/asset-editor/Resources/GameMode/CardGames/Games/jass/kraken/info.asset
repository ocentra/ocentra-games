    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kraken',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Kraken is the most competitive and high-stakes variant of the Dutch national game Klaverjassen. Played by four players in two partnerships, it follows the standard 'Amsterdamse' rules but adds an aggressive bidding and doubling system ('Kraken'). In this version, the opponents can 'crack' a contract if they believe the makers will fails to win half the points, doubling the round's value. It is the preferred variant of serious Dutch Klaverjas players.",
              },
              {
                type: 'paragraph',
                text: "Developed in the mid-20th century in Amsterdam as a way to increase the psychological depth of Klaverjassen. The term 'Kraken' (to crack) refers to the act of challenging the contract-maker.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships (2 vs 2).',
              },
              {
                type: 'paragraph',
                text: '32 cards (7 through Ace). The Jack of Trumps (20 pts) and Nine of Trumps (14 pts) are the highest.',
              },
              {
                type: 'paragraph',
                text: '32 cards (7 through Ace). The Jack of Trumps (20 pts) and Nine of Trumps (14 pts) are the highest.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 8 cards (dealt 3-2-3 or 4-4).',
              },
            ],
          },
        ],
      },
