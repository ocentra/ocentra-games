    historyContent: {
      origins: "Developed in the mid-20th century in Amsterdam as a way to increase the psychological depth of Klaverjassen. The term 'Kraken' (to crack) refers to the act of challenging the contract-maker.",
      originCountries: [
        'Netherlands',
      ],
      timeline: [
        '1910s: Klaverjassen becomes the Dutch national card game.',
        '1950s: Kraken variant emerges in competitive cafe leagues.',
        "1980s: Standardized rules for 'Herkraken' (redoubling) are adopted.",
        'Present: The standard format for professional tournaments in the Netherlands.',
      ],
      evolution: "Transitioned from a leisurely social game to a high-tension bidding game where understanding your partner's 'roem' (melds) in hand is crucial.",
