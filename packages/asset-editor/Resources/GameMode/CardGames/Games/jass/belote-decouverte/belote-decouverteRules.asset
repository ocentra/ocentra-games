  data: {
    LLM: 'Game: Belote Découverte. Type: Open Info. Rules: 2 players. 6 stacks of 2 (1 up/1 down) + 4 in hand. J>9>A. Mechanics: Playing Tableau Card flips underlying card.',
    Player: "You see the Jack of Trumps on your opponent's tableau, covering a face-down card. If you lead a small trump, they MUST play it! Force it out early so your 9 becomes the boss.",
    objective: 'Score more points than the opponent. Standard Belote scoring applies (162 total).',
    gameplay: '1. **Trump Selection**: A bidding round occurs to Establish the trump suit. 2. **Play**: Non-dealer leads. 3. **The Cards**: You can play any card from your hand or any face-up card on your tableau. 4. **Uncovering**: When a face-up card is played from the tableau, the face-down card underneath it is immediately turned face up and becomes available for the next trick.',
    keyRules: [
      'Must follow suit if possible.',
      'Must trump if void in led suit.',
      'Must over-trump if trumps are played.',
      'Face-down cards are blocked until the covering card is played.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Two players only. Belote Découverte is the two-player open-cards variant: each player has a tableau of face-up and face-down cards plus a private hand; play is head-to-head with no partnerships.',
      deck: '32 cards (A-10-K-Q-J-9-8-7).',
      equipment: 'Standard 32-card French pack (Piquet deck).',
      dealing: "Each player receives 16 cards, but not all in hand. 1. Deal 6 cards to each player FACE DOWN in a row. 2. Deal 6 cards FACE UP on top of the face-down cards. 3. Deal the remaining 4 cards to each player's HAND (concealed).",
    },
    turnFlow: '1. **Trump Selection**: A bidding round occurs to Establish the trump suit. 2. **Play**: Non-dealer leads. 3. **The Cards**: You can play any card from your hand or any face-up card on your tableau. 4. **Uncovering**: When a face-up card is played from the tableau, the face-down card underneath it is immediately turned face up and becomes available for the next trick.',
    moveValidityConditions: {
      ante: 'Belote Découverte is a point-based trick-taking game and does not utilize a monetary or chip-based ante.',
      deal: 'The complex tableau and hand distribution are performed automatically by the system dealer at the start of the hand.',
      reveal_market: "The entire 32-card deck is distributed to the players' tableau and hands; no central market exists.",
      buy_market: 'Players cannot purchase or swap cards from any external area; they must succeed using only their provided cards.',
      buy_stock: 'The entire deck is exhausted during the initial distribution phase; no cards remain in stock to be drawn.',
      fold: 'Both players are committed to playing out all tricks to determine the final point winner of the deal.',
      check: 'The game uses a trick-taking structure rather than a vying structure where checking would be a valid option.',
      call: 'There is no pot to match in this game; competition is based strictly on card point accumulation.',
      bet: 'Success is determined by total points on a scorecard rather than through financial or chip-based betting.',
      raise: 'There are no wagering rounds in this game, so the value of the deal cannot be increased via raises.',
      declare: 'During trick play.',
      reveal_hand: 'Hand cards remain private until played; the tableau cards are already public information.',
      award_pot: 'Winning points are added to a cumulative total rather than distributed from a physical pot of assets.',
      play_card: 'Must follow suit; must trump if void in suit.',
      draw: 'All cards are distributed at the start; no drawing phase exists during the play of the tricks.',
      discard: 'Every card in the player hand and tableau must be played into a trick; no cards are discarded.',
      pass: 'Allowed when choosing not to accept the proposed trump suit.',
      bid: 'The trump is selected through an acceptance phase rather than a competitive bidding auction.',
      meld: 'Declared during the play of the first trick.',
      go_out: 'The hand terminates automatically once all cards from the tableau and hands have been played.',
    },
    exampleHands: [
      'Opening deal: 2-2 player(s), 4 card(s) per player, 1 deck(s), initial visibility mixed.',
      'Opening flow: start in dealing; system may use deal_tableau before auction.',
      'Scoring check: Standard Belote ranking/values apply to all captured tricks. Expected outcome: 500.',
