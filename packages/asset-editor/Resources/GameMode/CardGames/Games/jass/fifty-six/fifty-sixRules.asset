  data: {
    LLM: 'Game: Fifty-Six (Ambathiyaaru). Logic: See rules.objective and rules.gameplay.',
    Player: "Fifty-Six (56), known locally as 'Ambathiyaaru', is a complex and highly strategic trick-taking card game popular in the Kerala region of India. An expansion of the simpler game '28', it is played with a double deck of cards and a specialized point-count system from the Jass family. The game is known for its intense bidding phase and the use of 'tables' (physical cards from the unused portion of the deck) to keep track of match scores. It is a partnership game that demands precise card counting and team-wide tactical coordination.",
    objective: 'Win tricks to capture card points. The bidding team must reach their declared point total to win the round.',
    gameplay: "1. Lead: The player to the dealer's right leads the first card.\n2. Must Follow Suit: Players must follow the suit led. If they cannot, they may play any card.\n3. Trumps: Trumps are only active once the hidden trump card is revealed. A player who cannot follow suit may ask to 'Reveal Trumps'.",
    keyRules: [
      "No Trump revealed: Until revealed, cards of the 'secret' trump suit have no special power.",
      'Thani: A bid where a player promises to win every single trick alone.',
      'Tables: Match scoring is tracked by transferring low-value cards (2, 3, 4...) between teams.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '4, 6, or 8 players in two fixed teams. Partners sit alternately.',
      deck: 'Two standard decks stripped of all cards below 9. Total 48 cards (A, K, Q, J, 10, 9 of each suit, twice). For 8 players, Sevens and Eights are added (Total 64).',
      equipment: 'Two standard decks stripped of all cards below 9. Total 48 cards (A, K, Q, J, 10, 9 of each suit, twice). For 8 players, Sevens and Eights are added (Total 64).',
      dealing: 'Cards are dealt in three rounds: 8 cards per player initially. Bidding occurs during the dealing process.',
    },
    turnFlow: "1. Lead: The player to the dealer's right leads the first card.\n2. Must Follow Suit: Players must follow the suit led. If they cannot, they may play any card.\n3. Trumps: Trumps are only active once the hidden trump card is revealed. A player who cannot follow suit may ask to 'Reveal Trumps'.",
