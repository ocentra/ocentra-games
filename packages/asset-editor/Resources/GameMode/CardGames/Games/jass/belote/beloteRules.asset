  data: {
    LLM: 'Game: Belote. Type: Jass/Trick-Taking. Rules: J(20)>9(14)>A(11)>10(10). Must follow, Must Trump if void. 162 total points. Belote=K+Q of trump.',
    Player: "The turned card is the Jack of Diamonds. That's 20 points instantly! You hold the 9 and Ace of Diamonds too. Take it! You have the Top 3 Trumps ('Trente-Quatre'). Declare 'Tierce' on the first trick for bonus points.",
    objective: 'The contracting team must score more points than the defenders (usually > 81 points out of 162 total). First team to 501 or 1000 wins the match.',
    gameplay: "1. **Bidding**: Accept turned trump or call another suit. 2. **Declarations**: Announced during the first trick. Only the team with the highest declaration scores theirs. 3. **The Play**: Forehand leads. Must follow suit. If void, must trump (unless partner winning). Must over-trump if trumps are led. 4. **Scoring**: Sum card points + declarations + 'Dix de Der' (10 bonus).",
    keyRules: [
      'The Jack of Trumps is the boss card (20 pts). The 9 of Trumps is the second boss (14 pts).',
      'Strict trumping rules: You cannot undercut/under-trump unless forced.',
      "Melds (Declarations) are only valid if they are better than the opponents' best meld.",
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: '4 players in fixed partnerships (North-South vs East-West).',
      deck: '32 cards. Ranks: Ace (11), 10 (10), King (4), Queen (3), Jack (20/2), 9 (14/0), 8 (0), 7 (0).',
      equipment: 'Standard 32-card French pack (Piquet deck), score pad.',
      dealing: 'Deal 5 cards to each player (3-2). One card is turned face up (The Proposal). Players bid to take it as trump. If all pass, a second round of bidding allows naming any other suit. Remaining cards are dealt (3 each) for a total of 8.',
    },
    turnFlow: "1. **Bidding**: Accept turned trump or call another suit. 2. **Declarations**: Announced during the first trick. Only the team with the highest declaration scores theirs. 3. **The Play**: Forehand leads. Must follow suit. If void, must trump (unless partner winning). Must over-trump if trumps are led. 4. **Scoring**: Sum card points + declarations + 'Dix de Der' (10 bonus).",
    moveValidityConditions: {
      ante: 'Belote is a point-based partnership game and does not utilize a monetary or chip-based ante.',
      deal: 'The two-part distribution of cards and the turning of the trump proposal are handled by the system dealer.',
      reveal_market: 'The trump proposal card is public, but there is no shared community market of playable cards in this game.',
      buy_market: 'Players cannot purchase cards from any market area; cards are obtained only through the system-managed deal.',
      buy_stock: 'The entire deck is exhausted during the two-part deal phase; no cards remain in stock to be purchased during play.',
      fold: "Players are committed to their partnership's participation and must play through all eight tricks of the hand.",
      check: 'The game uses a trick-taking structure rather than a vying structure where checking would be an appropriate action.',
      call: 'There is no pot to match in classic Belote; competition is based on card point values and melds.',
      bet: 'Success is determined by total point accumulation on a scorecard rather than through financial or chip betting.',
      raise: 'The value of the deal is fixed by the game rules and cannot be raised through wagering rounds.',
      declare: 'Must be leading or playing to the first trick.',
      reveal_hand: 'Hands remain private until individual cards are played into tricks; no full-hand reveal phase occurs.',
      award_pot: 'Winning points are added to a cumulative session total rather than distributed from a physical pot.',
      play_card: 'Must follow suit; must trump if void; must over-trump if possible.',
      draw: 'All cards are distributed during the two-part deal; no drawing phase exists during the play of the tricks.',
      discard: "Every card in the player's hand must be played into a trick; no cards are discarded or buried.",
      pass: 'Allowed when choosing not to accept the proposed trump suit.',
      bid: 'Trump selection is performed via a simple acceptance check rather than a competitive bidding auction.',
      meld: 'Only the best meld at the table is awarded points.',
      go_out: 'The hand terminates only after all eight tricks have been played by all participants.',
    },
