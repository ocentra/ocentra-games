    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Lupfen',
            subtitle: 'Swiss Trick-Taking',
            content: [
              {
                type: 'paragraph',
                text: "Lupfen is a traditional trick-taking card game from Switzerland and Southern Germany. It is closely related to the game of 'Schafkopf' and 'Watten' but is played with a unique 36-card deck and features a distinctive auction system where players bid for the right to choose the trump suit and play solo against the other players. The game emphasizes precise card play and strategic bidding.",
              },
              {
                type: 'paragraph',
                text: 'Originated in the Alpine regions of Switzerland and Bavaria in the 19th century. It evolved from older German trick-taking games like Schafkopf and Watten, adapting to local preferences and card decks.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3-5 players (4 is optimal).',
              },
              {
                type: 'paragraph',
                text: '36-card Swiss-German deck: 6-10, Under, Ober, King, Ace in each of four suits (Acorns, Bells, Hearts, Leaves).',
              },
              {
                type: 'paragraph',
                text: 'Swiss-German deck and score counters.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 9 cards (in a 4-player game).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Three-Player Lupfen: Played with a 24-card deck (9-Ace only).',
                  },
                  {
                    text: 'Five-Player Lupfen: Two players sit out each hand, rotating.',
                  },
                  {
                    text: 'Ramsch: If all pass, play Ramsch where lowest score wins.',
                  },
                ],
              },
            ],
          },
        ],
      },
