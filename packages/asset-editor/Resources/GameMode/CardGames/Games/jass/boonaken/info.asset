    aiContent: {
      difficulty: {
        easy: 'Follows suit legally. Bids on any hand with an Ace. Does not understand Roem cancellation.',
        medium: 'Understands Jass trump rankings. Evaluates hand strength with center cards. Deduces basic opponent voids.',
        hard: 'Optimal bid evaluation including Roem probabilities. Exploits the Jack-withholding rule. Coordinates defense with other opponents perfectly.',
      },
      considerations: [
        "Must implement the 'Trump Over Suit' choice logic.",
        'Roem cancellation requires full-table hand state estimation.',
      ],
