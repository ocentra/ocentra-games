  data: {
    hero: {
      title: 'BOONAKEN',
      subtitle: 'The Dutch Drinking Jass Game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Boonaken',
            subtitle: 'The Dutch Drinking Jass Game',
            content: [
              {
                type: 'paragraph',
                text: "Boonaken is a lively Dutch Jass-family card game for 4-7 players, famously played for rounds of drinks. Its name is derived from the top three trumps: Boer (Jack), Nel (Nine), and Aas (Ace). It features a unique 'drinking game' structure where players strive to win twice to be safe, while losing twice results in buying the round. It combines standard Jass point-trick mechanics with a competitive auction and card exchange phase.",
              },
              {
                type: 'paragraph',
                text: 'Originating in the Dutch pub culture of the Hazerswoude-Rijndijk and Leimuiden areas, Boonaken is a social evolution of Pandoeren. It was specifically designed to find a single loser in a group to facilitate the purchase of drinks.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 to 7 players playing individually (but forming temporary alliances against the declarer).',
              },
              {
                type: 'paragraph',
                text: '32 cards (7, 8, 9, 10, J, Q, K, A in each suit).',
              },
              {
                type: 'paragraph',
                text: 'Standard 32-card French pack, score sheet with +/- columns.',
              },
              {
                type: 'paragraph',
                text: 'Deal 6 cards each. Center cards (widow) are dealt face-up or face-down depending on player count (e.g., 2 face-up for 5 players).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Misère Bid: A negative bid where the player must lose every trick. No trump suit.',
                  },
                  {
                    text: 'Zwabber: The player must win every trick alone against all opponents.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Boonaken is a lively Dutch Jass-family card game for 4-7 players, famously played for rounds of drinks. Its name is derived from the top three trumps: Boer (Jack), Nel (Nine), and Aas (Ace). It features a unique 'drinking game' structure where players strive to win twice to be safe, while losing twice results in buying the round. It combines standard Jass point-trick mechanics with a competitive auction and card exchange phase.",
    tags: [
      'card-game',
      'trick-taking',
      'bidding',
      'traditional',
      'strategy',
      'auction',
    ],
    comingSoon: false,
    minPlayers: 4,
    maxPlayers: 7,
    routePath: 'boonaken',
    LLM: 'Game: Boonaken. Dutch Jass. 4-7 players. 32-card deck. Jass trump order: J-9-A-K-Q-10-8-7. 6 cards each + centre card exchange. Bid types: Number (multiples of 5), Misère, Zwabber, Boonaak. Roem = card combinations announced at trick 1, can be cancelled. Can trump when able to follow suit. 2 wins = safe, 2 losses = buy drinks.',
    Player: "You've got one plus and one minus. Your hand after exchange: J♥ 9♥ A♥ K♠ Q♠ 10♣. Hearts trump gives you the top three trumps (BooNaAk!). You could bid Boonaak (all tricks) — but failure means you buy drinks. Bid 80 instead?",
    tagline: "Win twice, you're safe. Lose twice, you're buying.",
    gameCategory: 'Trick-taking',
    subcategory: 'Jass / Point-trick',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '30-60 minutes',
    origin: 'Netherlands (South Holland)',
    originName: 'Boonaken',
    deck: '32 cards (Stripped Pack)',
    alsoKnownAs: [
      'Bonaken',
      'Boonaaken',
      'Boonhaaken',
    ],
    playersDisplay: '4-7 (Best with 5)',
    quality: 'complete',
    completeness: {
