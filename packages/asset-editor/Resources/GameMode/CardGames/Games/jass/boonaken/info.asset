    },
    historyContent: {
      origins: 'Originating in the Dutch pub culture of the Hazerswoude-Rijndijk and Leimuiden areas, Boonaken is a social evolution of Pandoeren. It was specifically designed to find a single loser in a group to facilitate the purchase of drinks.',
      originCountries: [
        'Netherlands',
      ],
      timeline: [
        '19th Century: Jass games establish themselves across the Low Countries.',
        '1950s: Boonaken emerges as a distinct pub variant in South Holland.',
        'Present: Actively played in regional cafes; documented as a staple of local village social life.',
      ],
      evolution: "The game streamlined the complex scoring of Klaverjassen into a simplified 'win/loss' tracker to maintain the fast pace required for a drinking game.",
      cultural: "Deeply tied to 'Café culture' in the Netherlands, where the social stakes (buying drinks) are as important as the card play itself.",
    },
    setupContent: {
      players: '4 to 7 players playing individually (but forming temporary alliances against the declarer).',
      deck: '32 cards (7, 8, 9, 10, J, Q, K, A in each suit).',
