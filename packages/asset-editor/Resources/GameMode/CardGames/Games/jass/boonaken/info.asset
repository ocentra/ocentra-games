        synthesis: {
          hero: {
            title: 'BOONAKEN',
            subtitle: 'The Dutch Drinking Jass Game',
            tagline: "Win twice, you're safe. Lose twice, you're buying.",
          },
          shortDescription: "A fast Dutch Jass game for 4-7 players. Bid to win trick-points, exchange centre cards, announce Roem (card combinations) at the first trick, then battle through 6 tricks. Win twice and you're out safe. Lose twice? You buy the round. Named for the top three trumps: Boer-Nel-Aas.",
