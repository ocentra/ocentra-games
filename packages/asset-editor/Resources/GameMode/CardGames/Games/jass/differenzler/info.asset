    historyContent: {
      origins: 'Differenzler developed in Swiss Jass circles as a variant that rewards accurate prediction rather than only raw trick count.',
      originCountries: [
        'Switzerland',
      ],
      timeline: [
        '19th-20th century: Bidding and point-based Jass variants spread through Switzerland.',
        'Modern era: Differenzler is played in clubs and home circles as a precision-scoring Jass form.',
      ],
      evolution: 'Compared to plain point-trick Jass, Differenzler adds pre-play bidding and difference penalties that change risk-taking.',
      cultural: 'It is used as a social and competitive Jass variant that emphasizes judgment and memory.',
    },
    setupContent: {
      players: 'Three or four players. Four-player tables are common.',
