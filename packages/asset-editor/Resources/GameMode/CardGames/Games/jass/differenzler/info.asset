          hasPlaceholders: false,
        },
        rules: {
          objective: 'Minimize cumulative penalty by predicting your own card-point total as accurately as possible.',
          gameplay: "Trump suit is set by the suit of the bottom card of the cut packet. Beginning with the player to dealer's right and continuing clockwise, each player predicts a card-point total from 0 to 157. Play then proceeds anticlockwise with the player to dealer's right leading first. Usual Swiss Jass trick rules apply, including trump ranking and point values. After all tricks, each player's penalty is the absolute difference between predicted and achieved card points.",
          keyRules: [
            'Predictions are per player and must be between 0 and 157.',
            'Trump suit is fixed from the cut card for the hand.',
            'Scoring is absolute bid difference (exact prediction scores zero).',
            'Deal and play are anticlockwise and dealer rotates to the right.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Bid conservatively when your hand has weak trump control.',
          intermediate: 'Use early trick information to adjust card timing toward bid fulfillment.',
          advanced: 'Balance point-card capture against overbidding risk to keep long-run penalty low.',
          tips: [
            'Track high trumps that have already been played.',
            'Do not chase extra tricks if your bid is already secure and penalties are difference-based.',
          ],
          hasPlaceholders: false,
        },
