      ante: 'Differenzler uses trick and bid scoring, not ante betting.',
      deal: 'Dealer only at start of hand.',
      reveal_market: 'No open market exists in Differenzler.',
      buy_market: 'Players cannot buy cards from a market in this game.',
      buy_stock: 'No stock purchase mechanic is used.',
      fold: 'Players stay in hand until all tricks are played.',
      check: 'Betting rounds do not exist in Differenzler.',
      call: 'There is no wager to call in this trick game.',
      bet: 'Scoring is by bid difference and trick points, not bets.',
      raise: 'No raise action exists because there is no betting pot.',
