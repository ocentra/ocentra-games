    icon: '🃏',
  },
  data: {
    LLM: "Trump suit is set by the suit of the bottom card of the cut packet. Beginning with the player to dealer's right and continuing clockwise, each player predicts a card-point total from 0 to 157. Play then proceeds anticlockwise with the player to dealer's right leading first. Usual Swiss Jass trick rules apply, including trump ranking and point values. After all tricks, each player's penalty is the absolute difference between predicted and achieved card points.",
    Player: "Trump suit is set by the suit of the bottom card of the cut packet. Beginning with the player to dealer's right and continuing clockwise, each player predicts a card-point total from 0 to 157. Play then proceeds anticlockwise with the player to dealer's right leading first. Usual Swiss Jass trick rules apply, including trump ranking and point values. After all tricks, each player's penalty is the absolute difference between predicted and achieved card points.",
    objective: 'Minimize cumulative penalty by predicting your own card-point total as accurately as possible.',
    gameplay: "Trump suit is set by the suit of the bottom card of the cut packet. Beginning with the player to dealer's right and continuing clockwise, each player predicts a card-point total from 0 to 157. Play then proceeds anticlockwise with the player to dealer's right leading first. Usual Swiss Jass trick rules apply, including trump ranking and point values. After all tricks, each player's penalty is the absolute difference between predicted and achieved card points.",
    keyRules: [
      'Predictions are per player and must be between 0 and 157.',
      'Trump suit is fixed from the cut card for the hand.',
      'Scoring is absolute bid difference (exact prediction scores zero).',
      'Deal and play are anticlockwise and dealer rotates to the right.',
    ],
    bonusRuleGuids: [],
    useTrump: true,
    trumpBonusValues: null,
    setup: {
      players: 'Three or four players. Four-player tables are common.',
      deck: 'Swiss 36-card Jass deck (or French-suited equivalent regional pack).',
      equipment: 'Cards and score sheet.',
      dealing: 'Dealer deals all cards in packets of three: 9 each with 4 players, 12 each with 3 players. Trump is determined from the cut card as described in rules.',
    },
    turnFlow: "Trump suit is set by the suit of the bottom card of the cut packet. Beginning with the player to dealer's right and continuing clockwise, each player predicts a card-point total from 0 to 157. Play then proceeds anticlockwise with the player to dealer's right leading first. Usual Swiss Jass trick rules apply, including trump ranking and point values. After all tricks, each player's penalty is the absolute difference between predicted and achieved card points.",
