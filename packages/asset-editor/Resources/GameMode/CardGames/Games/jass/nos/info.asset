        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Nos',
            subtitle: 'Chilean Jass',
            content: [
              {
                type: 'paragraph',
                text: 'Nos is a Chilean Jass-type game related to the Austrian/Bavarian game Zehnern. It is a point-trick game where players aim to win tricks containing valuable cards, with special scoring for the last trick and specific card combinations.',
              },
              {
                type: 'paragraph',
                text: 'Nos is a Chilean card game related to Zehnern, which is played in Austria and Bavaria. The game belongs to the Jass family of point-trick games that are popular across Central Europe and have spread to other regions through migration and cultural exchange.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships; partners sit opposite each other.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack. Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2.',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, score pad.',
              },
              {
                type: 'paragraph',
                text: 'Cards dealt to each player (typically 12-13 each depending on variant).',
              },
            ],
          },
          {
            title: 'Variations',
