  data: {
    hero: {
      title: 'Twenty-Two',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Twenty-Two',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Twenty-Two (also known as 22) is a trick-taking card game where the winner of the last trick is penalised. Players try to avoid taking the final trick; the losing card is kept as penalty points (Aces 11, face cards 10, others face value). First player to reach 22 or more points is eliminated; last player remaining wins. Suits are irrelevant; cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2.',
              },
              {
                type: 'paragraph',
                text: 'This version of 22 comes from North America but is based on the Icelandic version of the Nordic game Cucumber.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 (one 52-card pack). With more than six players, combine packs (one pack per four players).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card Anglo-American pack without jokers. Suits irrelevant; rank A (high) to 2 (low).',
              },
              {
                type: 'paragraph',
                text: 'Cards; optional score sheet.',
              },
              {
                type: 'paragraph',
                text: "First dealer: highest card draw (repeat if tie). First hand: seven cards each, one at a time, clockwise. Subsequently the loser of each hand deals; number of cards dealt = value of loser's scoring card from the hand just ended (e.g. queen = 10 cards each). If insufficient cards, deal equally until fewer cards left than players.",
              },
            ],
          },
        ],
      },
