    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Klaberjass',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Klaberjass (also known as Clob, Bella, or Bela) is a quintessential two-player trick-taking game that has enjoyed immense popularity for over a century. Known for its complex ranking of trumps (where the Jack and Nine are the most powerful) and the 'Bella' bonus (King and Queen of trumps), it is a game of skill, nerve, and precise point-counting. It belongs to the Jass family of games.",
              },
              {
                type: 'paragraph',
                text: "Rooted in the Low Countries (Netherlands/Belgium) and popularized by Jewish communities in Central Europe. The name likely stems from 'Klaverjas' (Dutch for Jack of Clubs).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players. The game is played head-to-head; each player receives six cards initially, then after trump is determined each receives three more for a total of nine cards per hand.',
              },
              {
                type: 'paragraph',
                text: '32 cards (7, 8, 9, 10, J, Q, K, A).',
              },
              {
                type: 'paragraph',
                text: '32 cards (7, 8, 9, 10, J, Q, K, A).',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 6 cards (3 then 3). One card is turned up to start trump determination. After trump is set, another 3 cards are dealt to each player (total 9 per hand).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Clob: Popular American English name for the game.',
                  },
                  {
                    text: 'Klaber: Hungarian variant for 4 players.',
                  },
                  {
                    text: 'Kalooki-style Klab: A variant with Joker wildcards.',
                  },
                ],
              },
            ],
          },
        ],
      },
