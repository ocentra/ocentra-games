        rules: {
          objective: 'Be the first player to reach a target number of strokes (e.g., 7 or 9) without falling below the minimum point threshold in any given hand.',
          gameplay: "1. Players follow suit if possible. If they cannot follow suit, they may play any card (including a trump). 2. Trump Rules: In Jass, the 'Trump Under' (Jack) and 'Trump Nell' (Nine) are the highest cards. 3. A player may 'trump in' even if they can follow suit, unless they are playing the 'Jack of Trumps' (Pur). 4. Points are counted from cards taken in tricks.",
          keyRules: [
            'Must follow suit if possible.',
            'Trump Jack (Under) and Trump 9 (Nell) are the highest trumps.',
            'Total card points per hand = 157.',
            "Need at least 26 points to avoid a 'null' (penalty).",
            '26-100 points = 1 stroke; over 100 points (match) = 2 strokes.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Focus on taking at least 26 points to avoid the penalty. It is often better to dump high cards into an opponent's trick if you've already reached your threshold.",
          intermediate: "Count the trumps carefully. Knowing when the 'Jack' and 'Nell' have been played is critical.",
          advanced: 'Tactical passing or leading: Decide whether to push for a match (100+ points) or play conservatively to simply guarantee your single stroke.',
          tips: [
            'Keep the Trump Under if possible; it is worth 20 points and nearly guarantees your threshold if you win the last trick.',
            'In Berner Handjass, pay attention to the multipliers for specific suits.',
          ],
