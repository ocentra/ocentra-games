    hero: {
      title: 'Sidi Barrani Jass',
      subtitle: 'Trick-taking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Sidi Barrani Jass',
            subtitle: 'Trick-taking',
            content: [
              {
                type: 'paragraph',
                text: 'Swiss Jass variant for four players in fixed partnerships. Each deal starts with an auction to set trump (or Obenabe/Undenufe) and the point target the bidders must make. Play is anticlockwise; declarer leads first. Points from tricks, last trick, Weis and Stöck; first team to 2000 wins.',
              },
              {
                type: 'paragraph',
                text: 'Based on Schieber Jass; originated in Swiss armed forces mid-20th century; popular in Central Switzerland and Swiss overseas communities.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in fixed partnerships, partners opposite.',
              },
              {
                type: 'paragraph',
                text: '36-card pack (Swiss-German bells, shields, acorns, roses; or French hearts, diamonds, spades, clubs).',
              },
              {
                type: 'paragraph',
                text: 'Cards.',
              },
              {
                type: 'paragraph',
                text: 'First dealer random. Dealer shuffles, left player cuts. Deal all 36 cards anticlockwise in batches of 3, so each player receives 9 cards. Deal rotates right after each hand.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'No Weis or Stöck: Some play without announcing or scoring Weis or Stöck.',
                  },
                  {
                    text: 'Higher minimum bid: Lowest bid 50 or 60 instead of 40.',
                  },
                  {
                    text: 'Bid in steps of 5: Bidding in multiples of 5 (60, 65, 70, …) allowed.',
                  },
                  {
                    text: 'Different target: Play to 1500 or 2500 instead of 2000.',
                  },
                  {
                    text: "No double or redouble: Some play without doubling; others allow declarer's team to redouble.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
