        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mendikot',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mendikot is a trick-taking card game from India, particularly popular in the western states of Maharashtra and Gujarat. It is a partnership game where the objective is to win tricks containing tens. The name comes from Gujarati where 'mendi' refers to the zero in '10' and 'kot' means a decisive victory where opponents score nothing.",
              },
              {
                type: 'paragraph',
                text: 'Mendikot originated in western India, specifically in Maharashtra and Gujarat. The game reflects the Indian tradition of trick-taking games with specific card targets.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in fixed partnerships, partners sitting opposite each other.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: A (high), K, Q, J, 10, 9, 8, 7, 6, 5, 4, 3, 2 (low).',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, score sheet.',
              },
              {
                type: 'paragraph',
                text: '13 cards to each player, dealt in packets. The dealer is always a member of the losing team from the previous deal.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Mendikot with Trumps: Some variants include a trump suit determined by the first card played.',
                  },
                  {
                    text: 'Point Scoring Variant: Some variants assign point values to other cards besides 10s.',
                  },
                ],
              },
            ],
          },
        ],
