        strategy: {
          basic: 'Try to win tricks that contain 10s. Save high cards for tricks where 10s are played. Communicate with your partner through card play.',
          intermediate: 'Track which 10s have been played. Force opponents to use high cards on non-10 tricks. Set up situations where you can capture multiple 10s.',
