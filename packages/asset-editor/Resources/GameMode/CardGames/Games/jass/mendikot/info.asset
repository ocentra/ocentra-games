    historyContent: {
      origins: 'Mendikot originated in western India, specifically in Maharashtra and Gujarat. The game reflects the Indian tradition of trick-taking games with specific card targets.',
      originCountries: [
        'India',
      ],
      timeline: [
        'Traditional: Played for generations in western India',
        '20th Century: Rules passed down through families and communities',
        'Present: Still popular in Maharashtra and Gujarat, and among Indian communities abroad',
      ],
      evolution: 'The game has remained relatively stable, with minor regional variations in dealing and scoring.',
      cultural: 'A social game played in Indian households and community gatherings. The focus on capturing tens reflects the cultural significance of round numbers.',
