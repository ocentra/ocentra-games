        pages: [
          {
            title: 'Kontra (Finnish Jass Variant)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Kontra is a Finnish Jass game related to the broader family of trick-taking games with trump suits and point-based scoring. Played with partnerships, it features the characteristic elements of Jass games including special trump card rankings and the opportunity for opponents to double ('kontra') the stakes.",
              },
              {
                type: 'paragraph',
                text: "Kontra belongs to the Jass family of games that originated in Switzerland and spread across Europe. The Finnish variant developed with local adaptations to bidding, scoring, and gameplay. The name 'Kontra' refers to the doubling mechanic common in Jass games.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Four players in fixed partnerships (2 vs 2). Partners sit opposite each other.',
              },
              {
                type: 'paragraph',
                text: '32-card French-suited pack (7 through Ace). May also use German-suited cards.',
              },
              {
                type: 'paragraph',
                text: '32-card French-suited pack (7 through Ace). May also use German-suited cards.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 8 cards, typically dealt in packets (e.g., 3-2-3 or 4-4).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
