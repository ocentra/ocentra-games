                  {
                    text: "Klaverjassen: Dutch variant with bidding and 'roem' (meld) points.",
                  },
                  {
                    text: 'Jassen (Swiss): Original Swiss version with specific regional rules.',
                  },
                  {
                    text: 'Kruisjassen: Simplified Dutch variant without bidding.',
                  },
