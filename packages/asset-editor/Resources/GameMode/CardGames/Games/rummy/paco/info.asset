    hero: {
      title: 'PACO',
      subtitle: 'Mexican Identical-Set Rummy',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Paco',
            subtitle: 'Mexican Identical-Set Rummy',
            content: [
              {
                type: 'paragraph',
                text: "Paco is a Mexican gambling rummy closely related to Conquian. Players meld runs and identical-card sets, use forcing to block opponents, and pay the winner based on 'pay cards' (1, 3, 5, 7, 10, 12) melded. A massive 200-card deck made of five Spanish packs allows for sets of identical cards, a key departure from standard rummy.",
              },
              {
                type: 'paragraph',
                text: 'Paco evolved from Conquian in Mexico. Conquian was first documented in Mexico City in 1857 and spread to North America; Paco emerged as its popular gambling variant, played mostly by the older generation.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2â€“12 players. Deal and play are anticlockwise.',
              },
              {
                type: 'paragraph',
                text: '200 cards from five identical Spanish 40-card packs (suits: swords, clubs, cups, coins; ranks 1â€“7, 10â€“12).',
              },
              {
                type: 'paragraph',
                text: 'Five Spanish 40-card packs, chips or money for stakes.',
              },
              {
                type: 'paragraph',
                text: 'Ten cards dealt to each player, one at a time. Remainder forms a face-down stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Team Paco: With 4, 6, 8, etc. players, form two teams. Players sit between opponents. Winning team shares proceeds.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Paco is a Mexican gambling rummy closely related to Conquian. Players meld runs and identical-card sets, use forcing to block opponents, and pay the winner based on 'pay cards' (1, 3, 5, 7, 10, 12) melded. A massive 200-card deck made of five Spanish packs allows for sets of identical cards, a key departure from standard rummy.",
