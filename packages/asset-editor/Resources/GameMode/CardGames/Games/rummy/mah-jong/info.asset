          hasPlaceholders: false,
        },
        rules: {
          objective: 'Form a valid 14-card hand consisting of four sets of three and one pair.',
          gameplay: "1. Draw a card from the deck or 'steal' the previous discard.\n2. Stealing: You can call 'Chow' (only from the player to your left), 'Pung' or 'Kong' (from anyone).\n3. If you complete your 14th card, you call 'Mah Jong'.",
          keyRules: [
            'Each player has 13 tiles; East (dealer) has 14 to start. Win by completing 14 tiles in four melds and one pair.',
            'Draw one tile from the wall or claim a discard to meld (Chow from left neighbor only; Pung or Kong from any). Then discard one tile.',
            'Melds: Pung (three identical), Kong (four identical), Chow (three same suit in sequence). Declare Mah Jong when the 14th tile completes the hand.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Keep your options open. Don't commit to a 'Pung' early if it ruins a potential 'Chow' sequence. A hand made mostly of Chows is easier to complete but scores fewer points.",
          intermediate: "Efficiency (Shanten): Calculate how many cards you are away from a complete hand. If you are 'Yi-Shanten' (1 card away), focus entirely on speed rather than high points.",
          advanced: "Defensive Discarding: If an opponent has revealed three Pungs of the same suit, never discard a card of that suit. You risk 'giving' them the winning card (Feeding the Dragon).",
          tips: [
            "Wait for 'Two-Sided' sequences (e.g., 4-5) rather than 'Middle' sequences (4-6).",
            "Pay attention to 'Wall' counting. If three copies of a card are already showing, don't wait for the 4th.",
          ],
          hasPlaceholders: false,
        },
