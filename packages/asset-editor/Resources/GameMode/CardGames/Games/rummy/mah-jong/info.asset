    historyContent: {
      origins: 'Developed in the mid-19th century in the Yangtze River delta, likely from earlier card games like Madiao and Khanhoo.',
      originCountries: [
        'China',
      ],
      timeline: [
        '1850s: Earliest versions appear in Ningbo.',
        '1920: Abercrombie & Fitch brings Mah Jong to the USA, starting a global craze.',
        '1949: Forbidden in mainland China during the Cultural Revolution.',
        '1985: Re-introduced and legalized in China; remains a cultural cornerstone in Hong Kong and Taiwan.',
      ],
      evolution: 'The game branched into dozens of regional variants (Hong Kong, Japanese Riichi, American, Taiwanese), each with different scoring and special hands.',
      cultural: 'Used as a social lubricant and a test of character in Chinese business and family life.',
    },
    setupContent: {
      players: '4 players. Each represents a Wind (East, South, West, North).',
