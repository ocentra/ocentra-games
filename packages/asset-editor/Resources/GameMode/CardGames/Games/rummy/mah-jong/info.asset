    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Mah Jong (Traditional Chinese)',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Mah Jong (éº»å°‡) is a game of skill, strategy, and calculation, and it involves a degree of chance. While traditionally played with tiles, it is also frequently played with specialized 'Mahjong Cards'. Originating in China, it is played by four players. The game is similar to Rummy in that the goal is to build combinations (Sets and Runs) from a hand of 13 cards/tiles to achieve a 'Mahjong' with a 14th card.",
              },
              {
                type: 'paragraph',
                text: 'Developed in the mid-19th century in the Yangtze River delta, likely from earlier card games like Madiao and Khanhoo.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players. Each represents a Wind (East, South, West, North).',
              },
              {
                type: 'paragraph',
                text: '3 Suits (Circles, Bamboo, Characters) numbered 1-9 (4 of each). Winds (4 of each). Dragons (Red, Green, White - 4 of each). Plus 8 Flowers/Seasons.',
              },
              {
                type: 'paragraph',
                text: '3 Suits (Circles, Bamboo, Characters) numbered 1-9 (4 of each). Winds (4 of each). Dragons (Red, Green, White - 4 of each). Plus 8 Flowers/Seasons.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 13 cards. East (dealer) starts with 14.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Hong Kong (Old Hong Kong): Uses standard 144 tiles, simple scoring with a relatively small set of scoring hands. Common introductory variant.',
                  },
                  {
                    text: 'Japanese Riichi: Japanese variant with riichi (ready) declaration, furiten rule, and different scoring including yakuman hands.',
                  },
                  {
                    text: 'American Mah Jongg: USA variant with different tile sets, card-based hands that change annually, and distinct scoring.',
                  },
                ],
              },
            ],
          },
        ],
      },
