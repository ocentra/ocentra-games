    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Spot (Irish Rummy)',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Spot is a traditional Irish rummy game for 4 players, played for small stakes in pubs and homes. It uses an 8-card hand and a standard 52-card deck (Ac-10-K-Q-J-9 is NOT used, standard A=1, 2-10, J-K=10). The goal is to 'Drop' melds (sets of 3+ or sequences of 3+) to reduce the spot value of remaining cards. A player cannot drop more than 4 cards at once.",
              },
              {
                type: 'paragraph',
                text: 'Spot is a rummy game from the west of Ireland, played for small stakes in pubs and private houses. Its name comes from the spot values of cards (A=1, 2–10 face value, J/Q/K=10) used to settle payments at the end of each hand. It is likely a local variant of Basic Rummy or 500 Rummy, with the distinctive rule that no player may drop more than four cards in one turn. Traditionally stakes were a penny per spot with a 5-unit ante before the introduction of the Euro.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Usually 4; same rules allow more or fewer.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack, no jokers; Aces low.',
              },
              {
                type: 'paragraph',
                text: 'Agreed stake (traditionally 1 unit per spot, 5-unit ante).',
              },
              {
                type: 'paragraph',
                text: 'Ante to pot. Deal 8 cards each. 9th card to player left of dealer (start).',
              },
            ],
          },
        ],
      },
