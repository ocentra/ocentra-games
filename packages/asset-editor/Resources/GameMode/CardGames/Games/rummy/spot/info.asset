        setup: {
          players: 'Usually 4; same rules allow more or fewer.',
          deck: 'Standard 52-card pack, no jokers; Aces low.',
          equipment: 'Agreed stake (traditionally 1 unit per spot, 5-unit ante).',
          dealing: 'Ante to pot. Deal 8 cards each. 9th card to player left of dealer (start).',
          hasPlaceholders: false,
        },
        rules: {
          objective: 'Go out (Shed all cards) or have lowest spot count.',
          gameplay: 'Each turn: draw one card from stock or top of discard pile; optionally drop up to four cards as new groups or runs or add to existing table melds (groups of 3–4 equal rank, runs of 3+ same suit, Aces low); discard one card face up. First player does not draw, only drops and discards. No player may drop more than four cards in one turn. Play ends when a player goes out by discarding their last card, or when stock is exhausted.',
          keyRules: [
            'Max four cards may be dropped in one turn; only one new group or run per turn.',
            'Aces are always low; Q-K-A is not a valid run.',
            'Going out requires a final discard; a player with two cards who draws a completing card must discard one and cannot go out that turn.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Form melds quickly. Don't hold high cards (K, Q, J) hoping for a meld unless you have two. Discard 10-pointers early if unmatching.",
          intermediate: "The 4-Card Limit: You can't drop a 5-card run (e.g., 3-4-5-6-7) in one go. You must drop 3-4-5-6, then add 7 next turn? No, add to existing melds later. Plan your drops.",
          advanced: "Defensive Discarding: Don't give the next player a card they need to go out. If they pick up a 7, don't throw an 8 or 6.",
          tips: [
            'Aces are low only (A-2-3).',
            'The pot can grow large with antes.',
          ],
          hasPlaceholders: false,
        },
