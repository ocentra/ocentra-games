    historyContent: {
      origins: 'Spot is a rummy game from the west of Ireland, played for small stakes in pubs and private houses. Its name comes from the spot values of cards (A=1, 2–10 face value, J/Q/K=10) used to settle payments at the end of each hand. It is likely a local variant of Basic Rummy or 500 Rummy, with the distinctive rule that no player may drop more than four cards in one turn. Traditionally stakes were a penny per spot with a 5-unit ante before the introduction of the Euro.',
      originCountries: [
        'Ireland',
      ],
      timeline: [
        '1950s: Played in rural pubs.',
        '1980s: Still common in Galway and Mayo.',
      ],
      evolution: 'The 4-card drop limit is a unique anti-sandbagging rule.',
      cultural: 'Often played for pennies per spot.',
    },
    setupContent: {
      players: 'Usually 4; same rules allow more or fewer.',
      deck: 'Standard 52-card pack, no jokers; Aces low.',
      equipment: 'Agreed stake (traditionally 1 unit per spot, 5-unit ante).',
      dealing: 'Ante to pot. Deal 8 cards each. 9th card to player left of dealer (start).',
    },
