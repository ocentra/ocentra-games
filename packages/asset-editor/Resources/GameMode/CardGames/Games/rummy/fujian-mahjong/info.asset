          {
            title: 'Fujian Mahjong',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Fujian Mahjong refers to regional Mahjong play in China's Fujian province with local scoring conventions layered on top of standard draw-discard meld play. Games typically follow the familiar wall draw and discard-claim rhythm while using table profiles for what qualifies as a winning hand and how value is computed.",
              },
              {
                type: 'paragraph',
                text: 'Fujian Mahjong developed from Chinese Mahjong traditions as local table rules spread through home and community play in Fujian.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players seated by wind position.',
              },
              {
                type: 'paragraph',
                text: 'Standard Mahjong set with suited tiles, honor tiles, and bonus tiles according to table profile.',
              },
              {
                type: 'paragraph',
                text: 'Standard Mahjong set with suited tiles, honor tiles, and bonus tiles according to table profile.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 13 tiles; dealer receives 14 and discards first.',
              },
            ],
          },
        ],
