    historyContent: {
      origins: 'Fujian Mahjong developed from Chinese Mahjong traditions as local table rules spread through home and community play in Fujian.',
      originCountries: [
        'China',
      ],
      timeline: [
        '20th century: regional house rules become stable through repeated social play.',
        'Modern era: online implementations document common Fujian profiles and terminology.',
      ],
      evolution: 'While hand structure remains consistent with Mahjong, Fujian tables differ in acceptable wins, scoring patterns, and emphasis on speed versus value.',
      cultural: 'It is widely played as a social table game in Fujian communities and diaspora groups.',
    },
