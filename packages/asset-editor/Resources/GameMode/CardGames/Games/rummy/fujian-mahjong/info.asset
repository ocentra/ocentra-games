        rules: {
          objective: 'Complete a legal winning hand and satisfy the active Fujian scoring profile.',
          gameplay: 'Players take turns drawing one tile and discarding one tile. Discards can be claimed for legal melds subject to claim priority rules. A hand wins on self-draw or discard claim when it meets the hand structure and any profile-specific validity requirements.',
          keyRules: [
            'Draw then discard is the default turn loop.',
            'Claims interrupt turn order only when a legal meld is formed.',
            'Winning requires a complete hand under the chosen Fujian profile.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Build efficient shapes and avoid discarding tiles that complete obvious opponent waits.',
          intermediate: 'Track suit distribution and honor visibility to estimate remaining outs and danger tiles.',
          advanced: 'Switch between fast completion and higher-value shaping based on wall depth and opponent pressure.',
          tips: [
            'Preserve flexible tiles early to keep multiple routes open.',
            'Defend when opponents reveal strong, coherent meld direction.',
          ],
