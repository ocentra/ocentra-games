    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Canasta',
            subtitle: 'The 1950s Card Phenomenon',
            content: [
              {
                type: 'paragraph',
                text: "Canasta is a rummy-style partnership card game played with two 52-card decks plus 4 jokers (108 cards). Jokers and 2s are wild. Players form melds of 3+ cards of the same rank. A 'canasta' (meld of 7+ cards) earns powerful bonuses. The game originated in Uruguay in 1939 and became a worldwide phenomenon rivaling Contract Bridge in the 1950s. First partnership to 5000 points wins.",
              },
              {
                type: 'paragraph',
                text: "Created c.1939 by Segundo Santos (lawyer) and Alberto Serrato (architect) at the Jockey Club of Montevideo, Uruguay. 'Canasta' means 'basket' in Spanish (referring to the discard basket).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 in fixed partnerships (partners sit opposite). Variants for 2, 3, or 6.',
              },
              {
                type: 'paragraph',
                text: '108 cards (2Ã—52-card packs + 4 Jokers). Jokers and 2s are wild.',
              },
              {
                type: 'paragraph',
                text: 'Two shuffled 52-card decks + 4 jokers. Score sheet.',
              },
              {
                type: 'paragraph',
                text: '11 cards each (Classic). Remainder is stock. Top card turned face-up to start discard pile (if red 3 or wild, bury and turn another).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Modern American Canasta: More complex rules, goes-out requirements, and special hands. Dominant in North American clubs.',
                  },
                  {
                    text: 'Samba: 3 decks. Allows sequence melds (same suit runs). Samba = 7-card run bonus. Target 10000 pts.',
                  },
                  {
                    text: 'Hand and Foot: Each player gets 2 sets of cards (the Hand and the Foot). Foot is picked up when Hand is exhausted.',
                  },
                ],
              },
            ],
          },
        ],
      },
