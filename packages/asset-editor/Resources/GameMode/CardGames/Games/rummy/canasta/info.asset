        rules: {
          objective: 'Score 5000 points across multiple rounds by building melds, especially canastas (7-card melds).',
          gameplay: 'Draw from stock or take discard pile (if top matches meld). Meld 3+ same rank; canasta = 7+ card meld. Jokers and 2s wild. Red 3s: lay face-up, draw replacement. Opening meld: 50/90/120 pts by team score. Go out: meld all, discard last. Target 5000.',
          keyRules: [
            'Initial meld minimum: 0-1499 pts (50 pts min), 1500-2999 pts (90 pts min), 3000+ pts (120 pts min).',
            'Wild cards cannot form a meld by themselves.',
            'Going out scores 100-point bonus.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Race to your first canastaâ€”you cannot go out without one. Hoard wild cards; don't waste them on early small melds.",
          intermediate: "Discard Pile Control: Never discard a card that gives your opponent an easy pile takeback. Coordinate with partner on which ranks to pursueâ€”don't overlap efforts.",
          advanced: "Freeze the Pile: Discard a wild card (freezing) when opponents are about to take a large pile. Timing of going out is crucialâ€”go out when you maximize your card-point lead and prevent opponent's canastas.",
          tips: [
            'Red threes are pure bonus pointsâ€”lay them immediately and draw.',
            'In the late game, use wild cards to complete your canasta quickly and go out.',
          ],
