  data: {
    hero: {
      title: 'POKERIZE',
      subtitle: 'Rummy with poker hand ranking',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pokerize',
            subtitle: 'Rummy with poker hand ranking',
            content: [
              {
                type: 'paragraph',
                text: 'Pokerize is a rummy variant in which play follows basic draw-and-discard rummy (draw one, meld sets or runs, lay off on melds, discard one) and the result or scoring is interpreted using standard poker hand rankings (high card, pair, two pair, flush, full house, etc.).',
              },
              {
                type: 'paragraph',
                text: 'Rummy games derive from early 20th century; theories point to Mexican Conquian or Asian origins. Pokerize applies poker hand rankings to rummy outcomes, combining rummy melding with poker-style evaluation.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 6 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck.',
              },
              {
                type: 'paragraph',
                text: 'One standard deck; score sheet if playing to a target score.',
              },
              {
                type: 'paragraph',
                text: 'Deal 10 cards each for 2 players, 7 for 3–4 players, or 6 for 5–6 players, one at a time. Remaining cards form the stock; turn one card face up to start the discard pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Deadwood as poker hand: Only unmelded cards are evaluated as a poker hand; highest poker hand among deadwood wins or scores.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Pokerize is a rummy variant in which play follows basic draw-and-discard rummy (draw one, meld sets or runs, lay off on melds, discard one) and the result or scoring is interpreted using standard poker hand rankings (high card, pair, two pair, flush, full house, etc.).',
    tags: [
      'card-game',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'pokerize',
    LLM: 'Game: Pokerize. Rummy with poker scoring. Deal -> Draw -> Meld/lay off (optional) -> Discard -> next player | Score (poker hand ranking). Draw 1 from stock or discard_top; meld sets/runs; lay off; discard 1. Go out = hand ends; then evaluate best poker hand or deadwood per rules.',
    Player: 'Draw one from stock or discard. Meld sets (3–4 of a rank) or runs (3+ in suit). Lay off on any meld. Discard one to end your turn. First to empty hand ends the hand; hands are evaluated using poker hand rankings.',
