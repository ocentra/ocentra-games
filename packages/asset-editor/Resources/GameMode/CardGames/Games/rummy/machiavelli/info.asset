    historyContent: {
      origins: "Developed in post-WWII Italy as a variation of 'Manipulation Rummy'. Its rules were popularized in Mediterranean card clubs during the 1960s.",
      originCountries: [
        'Italy',
      ],
      timeline: [
        "1950s: Rules for 'Rummy a Terre' involve basic manipulation.",
        "1970s: The name 'Machiavelli' becomes standard in Italian gaming circles.",
        "1980s: The game's mechanics are used as the basis for the global hit board game Rummikub.",
        'Present: One of the most common family card games in Italy and widely played on digital platforms.',
      ],
      evolution: 'The game was traditionally played with Jokers, but modern tournament rules often omit them to increase the challenge of forming natural sequences.',
      cultural: "Seen as a 'smart' game, played in cafes and university lounges.",
    },
    setupContent: {
      players: '2-5 players individually.',
