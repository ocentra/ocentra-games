    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Machiavelli',
            subtitle: 'The Art of Manipulation',
            content: [
              {
                type: 'paragraph',
                text: "Machiavelli is a sophisticated Italian card game of the Rummy family, named after the political philosopher NiccolÃ² Machiavelli for its tactical complexity and the ability to 'manipulate' the board. Unlike standard Rummy where melds are static once played, players in Machiavelli can dismantle, rearrange, and recombine any cards already on the table to help them play cards from their hand. It is practically identical to the game Rummikub but played with standard cards.",
              },
              {
                type: 'paragraph',
                text: "Developed in post-WWII Italy as a variation of 'Manipulation Rummy'. Its rules were popularized in Mediterranean card clubs during the 1960s.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-5 players individually.',
              },
              {
                type: 'paragraph',
                text: '104 cards (Two standard decks).',
              },
              {
                type: 'paragraph',
                text: 'Two standard decks, playing surface for melds.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 13 cards (variants range from 11 to 15).',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Machiavelli with Jokers: Increases speed but reduces late-game logic complexity.',
                  },
                  {
                    text: 'Rummikub: The tile-based equivalent.',
                  },
                  {
                    text: 'Vatikan: A German variant with similar manipulation rules.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
