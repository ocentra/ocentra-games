    hero: {
      title: 'RAMINO POKERATO',
      subtitle: 'Card game',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Ramino Pokerato',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Ramino Pokerato is an Italian Rummy game that combines draw-and-discard melding with poker-style betting. Players receive 10 cards from a double deck with four Jokers; after an optional blind and betting round, play proceeds with draw from stock or discard, then discard, until a player goes out by melding 10 cards in sets and runs and discarding the 11th.',
              },
              {
                type: 'paragraph',
                text: "Ramino Pokerato is an Italian Rummy variant that combines Rummy melding with poker-style betting. The name means 'Pokerised Rummy' and applies to several Italian games; the version with Jokers and betting is described by John McLeod from Antonio de Sebastiano and others.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Three to five players (best); adaptable to more with extra packs.',
              },
              {
                type: 'paragraph',
                text: 'Double deck of standard 52-card packs plus four Jokers (108 cards total).',
              },
              {
                type: 'paragraph',
                text: 'Table and chips or agreed stakes.',
              },
              {
                type: 'paragraph',
                text: "Dealer shuffles and is cut by player to dealer's right. Each player receives 10 cards dealt one at a time. Remainder is stacked face down as stock.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Ramino Pokerato con Jolly immaginario: Played with double deck and no printed Jokers; when going out, one card in hand may be nominated as a wild card to complete one combination.',
                  },
                  {
                    text: 'Ramino Pokerato carioca: Contract version: eight deals, each with a different opening meld requirement; 13 cards each; no poker-style betting; scoring by card values; winner of game takes game pool.',
                  },
                  {
                    text: 'Ramino Pokerato con rilancio: Betting version with blind and raises (rilancio); same draw-discard and go-out rules as main game.',
                  },
                ],
              },
            ],
          },
        ],
      },
