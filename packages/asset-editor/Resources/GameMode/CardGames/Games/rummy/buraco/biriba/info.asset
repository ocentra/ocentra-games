    hero: {
      title: 'BIRIBA',
      subtitle: "Greece's Favourite Rummy Game",
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Biriba',
            subtitle: "Greece's Favourite Rummy Game",
            content: [
              {
                type: 'paragraph',
                text: "Biriba (Μπιρίμπα) is Greece's most popular card game, a rich and strategic partnership rummy game. Played with two decks and four Jokers, it challenges players to form sets and runs, including at least one 'biriba' (a 7-card meld), to go out. The game is famous for its 'pot' mechanic, where players pick up a reserve hand once they empty their initial deal. It combines the deep calculation of Burraco with the high-speed timing of Canasta.",
              },
              {
                type: 'paragraph',
                text: 'Believed to be derived from Italian Burraco or early Canasta variants, Biriba developed into a unique national pastime in Greece and Cyprus during the mid-20th century. It is a staple of Greek coffeehouse (kafeneia) culture.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships (North-South vs East-West).',
              },
              {
                type: 'paragraph',
                text: '108 cards: Two standard 52-card decks plus four Jokers. Jokers and 2s are wild.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack with jokers, score pad.',
              },
              {
                type: 'paragraph',
                text: "Deal 11 cards to each player. Two 'pots' (reserve hands) of 11 cards each are placed face down. Remaining cards form the stock.",
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Runs Only (No Sets): Only suit sequences are allowed; rank-based sets are prohibited, making the game much harder.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Biriba (Μπιρίμπα) is Greece's most popular card game, a rich and strategic partnership rummy game. Played with two decks and four Jokers, it challenges players to form sets and runs, including at least one 'biriba' (a 7-card meld), to go out. The game is famous for its 'pot' mechanic, where players pick up a reserve hand once they empty their initial deal. It combines the deep calculation of Burraco with the high-speed timing of Canasta.",
    tags: [
      'card-game',
      'rummy',
      'traditional',
      'partnership',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 6,
    routePath: 'biriba',
    LLM: "Game: Biriba. Greek rummy. 108 cards (2×52 + 4 Jokers). 4 players in partnerships. Meld sets and runs. Jokers/2s are wild. Complete a 'biriba' (7+ card meld) to go out. Clean biriba=500, dirty=300. Going out=100. Cards in hand are penalties. Play anti-clockwise. Target score: 2500 or 5000.",
    Player: "Your team has a run of 5♠ 6♠ 7♠ 8♠ 9♠ — two more cards and it's a clean biriba (500 pts)! You draw 10♠ from the stock. Do you add it to the run (now 6 cards, need one more) or hold it, hoping for 4♠ as well to maximize your options?",
    tagline: 'Build your melds. Complete your biriba. Go out in style.',
    gameCategory: 'Rummy',
    subcategory: 'Canasta Family / Partnership',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
