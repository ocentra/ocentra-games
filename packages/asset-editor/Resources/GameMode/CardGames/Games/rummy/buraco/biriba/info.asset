    historyContent: {
      origins: 'Believed to be derived from Italian Burraco or early Canasta variants, Biriba developed into a unique national pastime in Greece and Cyprus during the mid-20th century. It is a staple of Greek coffeehouse (kafeneia) culture.',
      originCountries: [
        'Greece',
        'Cyprus',
      ],
      timeline: [
        '1950s: Rummy variants like Burraco spread through the Mediterranean.',
        '1970s: Biriba becomes the dominant social game in urban Greek centers.',
        'Present: Remains the standard social game for Greek families and clubs, with numerous online implementations.',
      ],
      evolution: "Greek house rules added layers like the 'bonus suit' and specific discard-capture requirements that distinguish it from standard Burraco.",
      cultural: 'An essential part of Greek hospitality and social life, often played during holidays or extended cafe visits.',
    },
    setupContent: {
      players: '4 players in two fixed partnerships (North-South vs East-West).',
