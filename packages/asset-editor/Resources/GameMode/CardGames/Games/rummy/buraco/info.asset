  data: {
    hero: {
      title: 'Buraco',
      subtitle: 'Rummy',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Buraco',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Buraco is a popular Rummy-type card game family originating in South America, played with partnerships and featuring unique mechanics like the morto (extra hand). The main variants are Brazilian Buraco (Canastra/Biriba), Italian Burraco, and Argentinean Burako (tile version). Games are played with double decks and involve melding sequences to create canastas.',
              },
              {
                type: 'paragraph',
                text: "Buraco originated in South America, probably in the 1940s, likely in Brazil or Argentina. The game evolved from Canasta and shares similarities with Samba. The name comes from Portuguese/Spanish and refers to the 'hole' or extra hand mechanic.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players in two fixed partnerships',
              },
              {
                type: 'paragraph',
                text: '104-108 cards: two standard 52-card decks plus 0-4 jokers depending on variant',
              },
              {
                type: 'paragraph',
                text: 'Double deck with jokers, score sheet, table space for melds',
              },
              {
                type: 'paragraph',
                text: 'Two 11-card mortos (extra hands) set aside. Each player receives 11 cards. Remaining cards form draw pile. Brazilian: 108 cards with 4 jokers; Italian: 104 cards no jokers; twos often wild.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Buraco Fechado (Closed Buraco): Variation where the discard pile is closed (only the top card is visible), sets of equal rank are allowed as melds, and a canastra of twos can score a higher bonus; going out only requires at least one canastra, not necessarily clean.',
                  },
                  {
                    text: 'Alternative Target Scores: Some groups play to a target of 2000 or 3500 points instead of the standard 3000, ending the match when a team reaches or passes the chosen total.',
                  },
                  {
                    text: 'Rounded Scoring to Tens: In some tables all scores are rounded up to the nearest multiple of ten, for example 485 is recorded as 490 on the running score sheet.',
                  },
                  {
                    text: 'No Vulnerability Requirement: Some play without the vulnerability rule, so there is no minimum opening meld value even after a team has reached half of the target score.',
                  },
                  {
                    text: 'High-Value Jokers: A common scoring variation treats each joker as worth 50 points instead of the standard 20, increasing the impact of wild cards in melds and in hand.',
                  },
                  {
                    text: 'No Jokers, Only Twos Wild: Some play with no jokers in the deck so that only the twos act as wild cards, giving a 106-card pack while keeping the same meld structure.',
                  },
                  {
                    text: 'Alternative Canastra Bonuses: Some groups score 150 points for a dirty canastra and 300 for a clean one, count a clean set of all eight cards of a rank as a canastra real worth 1000 points, or award extra bonuses for special cutting situations.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
