    historyContent: {
      origins: "Buraco originated in South America, probably in the 1940s, likely in Brazil or Argentina. The game evolved from Canasta and shares similarities with Samba. The name comes from Portuguese/Spanish and refers to the 'hole' or extra hand mechanic.",
      originCountries: [
        'Brazil',
