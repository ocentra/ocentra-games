      list: [
        {
          id: 'buraco_fechado',
          name: 'Buraco Fechado (Closed Buraco)',
          description: 'Variation where the discard pile is closed (only the top card is visible), sets of equal rank are allowed as melds, and a canastra of twos can score a higher bonus; going out only requires at least one canastra, not necessarily clean.',
        },
        {
          id: 'target_score_2000_or_3500',
          name: 'Alternative Target Scores',
          description: 'Some groups play to a target of 2000 or 3500 points instead of the standard 3000, ending the match when a team reaches or passes the chosen total.',
        },
        {
          id: 'rounded_scores_to_tens',
          name: 'Rounded Scoring to Tens',
          description: 'In some tables all scores are rounded up to the nearest multiple of ten, for example 485 is recorded as 490 on the running score sheet.',
        },
        {
          id: 'no_vulnerability_rule',
          name: 'No Vulnerability Requirement',
          description: 'Some play without the vulnerability rule, so there is no minimum opening meld value even after a team has reached half of the target score.',
        },
        {
          id: 'jokers_worth_50',
          name: 'High-Value Jokers',
          description: 'A common scoring variation treats each joker as worth 50 points instead of the standard 20, increasing the impact of wild cards in melds and in hand.',
        },
        {
          id: 'no_jokers_only_twos_wild',
          name: 'No Jokers, Only Twos Wild',
          description: 'Some play with no jokers in the deck so that only the twos act as wild cards, giving a 106-card pack while keeping the same meld structure.',
        },
        {
          id: 'alternative_canastra_bonuses',
          name: 'Alternative Canastra Bonuses',
          description: 'Some groups score 150 points for a dirty canastra and 300 for a clean one, count a clean set of all eight cards of a rank as a canastra real worth 1000 points, or award extra bonuses for special cutting situations.',
        },
