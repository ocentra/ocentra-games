  data: {
    LLM: 'First player draws, decides to keep or discard, then may meld and discards. Other players: draw from stock or take all discards; optionally meld escaleras (same-color sequences) or piernas (same-number sets); discard one tile. First player to empty hand takes a muerto (11-tile extra hand). Team can go out after taking muerto and having at least one canasta.',
    Player: 'First player draws, decides to keep or discard, then may meld and discards. Other players: draw from stock or take all discards; optionally meld escaleras (same-color sequences) or piernas (same-number sets); discard one tile. First player to empty hand takes a muerto (11-tile extra hand). Team can go out after taking muerto and having at least one canasta.',
    objective: 'Be the first team to reach 3000+ points by melding tiles into sequences and sets, creating canastas (7+ tile melds), and going out.',
    gameplay: 'First player draws, decides to keep or discard, then may meld and discards. Other players: draw from stock or take all discards; optionally meld escaleras (same-color sequences) or piernas (same-number sets); discard one tile. First player to empty hand takes a muerto (11-tile extra hand). Team can go out after taking muerto and having at least one canasta.',
    keyRules: [
      '106 tiles: two each of 1-13 in four colors + 2 jokers',
      'Two 11-tile muertos set aside for first players out',
      'Escalera = sequence of 3+ consecutive same-color tiles',
      'Pierna = set of 3+ same-number tiles (any colors)',
      'Canasta = meld of 7+ tiles',
      'Max one wild tile (joker or 2) per meld',
      '1 can be low (next to 2) or high (next to 13)',
      'Need canasta and taken muerto to go out',
      'Target: 3000 points',
    ],
    bonusRuleGuids: [],
