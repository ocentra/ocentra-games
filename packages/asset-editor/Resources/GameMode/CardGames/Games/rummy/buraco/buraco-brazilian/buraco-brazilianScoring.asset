    scoringRules: {
      summary: 'Scoring uses point values per card plus bonuses for canastras: clean (no wild) sequences of seven or more cards score 200 points, dirty sequences with a wild score 100 points, clean 13-card sequences score 500 points, clean 14-card sequences score 1000 points, and going out scores 100 points; card values from Pagat are added for melded cards and subtracted for cards left in hand, with penalties for unused mortos.',
      winCondition: 'First team to reach the target score (typically 3,000 points) wins; higher cumulative score wins.',
