  data: {
    LLM: 'Deal seven cards to each player and turn one card to start the discard pile. On each turn a player draws from the stock or discard pile, then discards. A player may close by laying down valid sets and runs when deadwood is low enough; scores are penalties for unmatched card values, with bonuses for gin-like clean hands and special wins for a true chinchón.',
    Player: 'Deal seven cards to each player and turn one card to start the discard pile. On each turn a player draws from the stock or discard pile, then discards. A player may close by laying down valid sets and runs when deadwood is low enough; scores are penalties for unmatched card values, with bonuses for gin-like clean hands and special wins for a true chinchón.',
    objective: 'End a round with the lowest unmatched card value or win immediately with a valid seven-card run.',
    gameplay: 'Deal seven cards to each player and turn one card to start the discard pile. On each turn a player draws from the stock or discard pile, then discards. A player may close by laying down valid sets and runs when deadwood is low enough; scores are penalties for unmatched card values, with bonuses for gin-like clean hands and special wins for a true chinchón.',
    keyRules: [
      'Valid melds are same-rank sets and same-suit runs.',
      'Players draw and discard one card per turn.',
      'A seven-card run, the chinchón, can win immediately under the table rule.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
