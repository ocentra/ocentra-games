        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Chinchón',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Chinchón is a Spanish and Latin American rummy-family matching game closely related to Gin Rummy, where players form sets and runs and try to reduce unmatched card value or complete a seven-card run called chinchón.',
              },
              {
                type: 'paragraph',
                text: 'Chinchón is played in Spain, Uruguay, Argentina, Cape Verde and other regions, with local names such as Txintxon, Conga, and La Conga.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 players use the table arrangement described for Chinchón.',
              },
              {
                type: 'paragraph',
                text: 'Spanish 40-card or 48-card pack, sometimes with Jokers',
              },
              {
                type: 'paragraph',
                text: 'Spanish 40-card or 48-card pack, sometimes with Jokers, score area, and enough table space for play.',
              },
              {
                type: 'paragraph',
                text: 'Prepare Spanish 40-card or 48-card pack, sometimes with Jokers and deal or lay out cards according to the documented Chinchón rules before play begins.',
              },
            ],
          },
        ],
      },
