        pages: [
          {
            title: 'Telefunken',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Telefunken is a contract rummy game popular in South America (Venezuela, Ecuador, Peru, Bolivia). 2â€“4 players, two 52-card decks plus four jokers (108 cards), 7 chips per player. First to empty hand by forming required melds across seven deals; lowest penalty wins. Melds: sets (3+ same rank), runs (3+ same suit). Each deal has a specific contract. Draw and discard; buy discards with chips before initial meld.',
              },
              {
                type: 'paragraph',
                text: "Country/Region of Origin: South America (Venezuela, Ecuador, Peru, Bolivia, and to some extent Colombia).\nTime Period: Brought to South America around World War II (German Jews and others fled to South America; game name from German firm Telefunken).\nHistorical Development: Contract rummy variant played especially in Venezuela, Ecuador, Peru and Bolivia; not played in Germany nowadays.\nCultural Significance: Popular in several South American countries; regional variants in Ecuador, Peru (two versions), Bolivia, and a North American variation (Farmers' Rummy).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 4\nPartnerships: Optional',
              },
              {
                type: 'paragraph',
                text: 'Type: Standard 52-card deck\nNumber of Decks: 1\nJokers: Not included',
