        rules: {
          objective: 'Complete a legal 14-tile Mahjong hand of four melds and one pair with sufficient scoring value.',
          gameplay: 'Players draw one tile and discard one tile in turn. Discards may be claimed to form Chow, Pung, or Kong according to claim priority and position restrictions. A player wins by self-draw or discard claim when the hand is complete under table scoring requirements.',
          keyRules: [
            'East starts with 14 tiles; other players start with 13.',
            'Each turn is draw one tile, then discard one tile.',
            "Chow claims are limited to the player on the discarder's left; Pung and Kong can be claimed by any player.",
            'Winning hand structure is four melds and one pair, with fan requirements determined by the table rule set.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Prioritize efficient two-sided waits and avoid overcommitting to slow high-risk shapes.',
          intermediate: 'Track exposed tiles and likely dead waits to improve discard safety and completion speed.',
          advanced: 'Balance attack and defense based on seat position, hand value prospects, and visible opponent commitments.',
          tips: [
            'Keep flexible middle tiles early unless your hand has a clear value route.',
            'Do not force expensive patterns when a clean, faster hand is available.',
            'Watch claim tempo to infer opponent hand speed.',
          ],
          hasPlaceholders: false,
