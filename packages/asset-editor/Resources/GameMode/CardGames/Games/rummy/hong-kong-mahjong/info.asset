        tabLabel: 'About',
        pages: [
          {
            title: 'Hong Kong Mahjong',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Hong Kong Mahjong is a four-player Cantonese Mahjong variant that emphasizes practical hand building and fan-based scoring. The game uses the standard Mahjong tile set and straightforward meld structure, making it one of the most widely taught regional forms.',
              },
              {
                type: 'paragraph',
                text: 'Hong Kong Mahjong developed from earlier Chinese Mahjong forms and became the dominant urban Cantonese ruleset through the 20th century.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players. Seats are assigned East, South, West, North.',
              },
              {
                type: 'paragraph',
                text: 'Three suited tile groups 1-9, winds, dragons, flowers and seasons in a standard Mahjong set.',
              },
              {
                type: 'paragraph',
                text: 'Three suited tile groups 1-9, winds, dragons, flowers and seasons in a standard Mahjong set.',
              },
              {
                type: 'paragraph',
                text: 'Each player starts with 13 tiles; dealer (East) starts with 14 and discards first.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Minimum Fan Tables: Different clubs use different minimum fan thresholds to declare a winning hand.',
                  },
                  {
                    text: 'Flowers and Seasons Enabled: Flower and season bonuses are counted according to local table practice.',
                  },
                ],
              },
            ],
          },
        ],
