    historyContent: {
      origins: 'Hong Kong Mahjong developed from earlier Chinese Mahjong forms and became the dominant urban Cantonese ruleset through the 20th century.',
      originCountries: [
        'Hong Kong',
        'China',
      ],
      timeline: [
        'Early 20th century: Mahjong variants spread through southern China and Hong Kong.',
        'Mid 20th century: Hong Kong table rules become widely standardized in local clubs.',
        'Late 20th century onward: Rules documented and exported through diaspora communities.',
      ],
      evolution: 'The variant retained classic draw-discard play while settling on approachable scoring expectations and common house-rule families.',
      cultural: 'Hong Kong Mahjong is a core social game in family gatherings, tea houses, and club play.',
    },
