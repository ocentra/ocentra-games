    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Rummikub',
            subtitle: 'Tile Rummy',
            content: [
              {
                type: 'paragraph',
                text: 'Tile rummy for 2–4 players using 106 tiles (numbers 1–13 in four colors, two of each, plus two jokers). Players draw from the pool or meld groups and runs on the table; first to empty their rack wins. Sabra is the main version with table manipulation.',
              },
              {
                type: 'paragraph',
                text: "Tile rummy games invented by Ephraim Hertzano; conceived in 1940s Romania and later developed in Israel. Introduced to Western Europe and America; Sabra became the main version; American and International versions appear in Hertzano's 1978 Official Rummikub Book.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '106 Rummikub tiles',
              },
              {
                type: 'paragraph',
                text: 'Rummikub set',
              },
              {
                type: 'paragraph',
                text: 'Tiles are shuffled face down; each player takes 14 tiles onto a rack. The remaining tiles stay face down as the pool.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Sabra Rummikub: Default version: draw or meld each turn; initial meld 30+; table manipulation allowed; no discard pile.',
                  },
                  {
                    text: 'American Rummikub: Draw one, optionally meld, then discard one; initial meld 21+; discard pile; win by melding all but one tile and discarding the last.',
                  },
                  {
                    text: 'International Rummikub: More complex scoring; can win Open, Foot, or Closed with special hand types and point values.',
                  },
                ],
              },
            ],
          },
        ],
      },
