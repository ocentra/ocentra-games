    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 4,
    routePath: 'banakil',
    LLM: 'Game: Banakil. Type: Rummy (Levant). Rules: 106 cards. Hand: 18. Wilds: 2s and Jokers. Direction: Counter-clockwise. Draw/Discard cycle. Meld Sequences/Sets. Wild card swapping allowed.',
    Player: "Welcome to the coffee house. You have 18 cards and it's your turn to draw from the ground or the stock. Remember, those four 2s are wildâ€”will you use them to complete your sequence now, or wait to swap them for a King later?",
    tagline: 'Eighteen cards. Counter-clockwise chaos. Will the wild twos be your blessing or your curse?',
    gameCategory: 'Rummy',
