    aiContent: {
      difficulty: {
        easy: 'Melds sequences immediately, revealing its hand to opponents. Never swaps wild cards from the table.',
        medium: "Maintains a 'Hand Balance' between wilds and natural cards. Will only pick up from the ground if it completes a sequence of 5+ cards.",
        hard: "Tracks every card discarded. Calculates the 'Dead Hand' probability for opponents. Expertly plays for the 'Wild Card Swap' to accelerate its finish.",
      },
      considerations: [
        'AI must handle a 106-card tracking array.',
        "Requires logic for the 'Wild Card replacement' mechanic on the shared tableau.",
      ],
    },
