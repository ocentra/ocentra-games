  data: {
    hero: {
      title: 'BANAKIL',
      subtitle: 'The Wild 2 Rummy',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Banakil',
            subtitle: 'The Wild 2 Rummy',
            content: [
              {
                type: 'paragraph',
                text: "Banakil is a popular Rummy-style game widely played in Jordan, Palestine, Syria, and Lebanon. The name is derived from 'Bankal', the Arabic term for a 'Wild Two'. Using two full decks and distinct wild card rules, Banakil features a high initial hand size (18 cards) and a counter-clockwise play direction. It is a game of meticulous organization, where players must balance the pursuit of high-value melds against the risk of holding unmatched cards if an opponent suddenly 'goes out'.",
              },
              {
                type: 'paragraph',
                text: "Developed in the Levant as a regional adaptation of mid-20th century European Rummy games. It distinguished itself by incorporating all 2s as wild cards (the namesake 'Banakil'), echoing the mechanics of Canasta but within a purer Rummy framework.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-4 players. (4 players usually play in partners; 2-3 play individually).',
              },
              {
                type: 'paragraph',
                text: '106 cards. Two 52-card decks + 2 Jokers.',
              },
              {
                type: 'paragraph',
                text: 'Standard pack, score sheet, non-transparent discard tray.',
              },
              {
                type: 'paragraph',
                text: 'Dealer (rotating counter-clockwise) deals 18 cards to each player. The next card is placed face up on the table (The Ground) to start the discard pile. The rest is the Stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: "Partnership Banakil: Partners can add to each other's melds after their own initial meld is on the table.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Banakil is a popular Rummy-style game widely played in Jordan, Palestine, Syria, and Lebanon. The name is derived from 'Bankal', the Arabic term for a 'Wild Two'. Using two full decks and distinct wild card rules, Banakil features a high initial hand size (18 cards) and a counter-clockwise play direction. It is a game of meticulous organization, where players must balance the pursuit of high-value melds against the risk of holding unmatched cards if an opponent suddenly 'goes out'.",
    tags: [
