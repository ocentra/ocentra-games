    historyContent: {
      origins: "Developed in the Levant as a regional adaptation of mid-20th century European Rummy games. It distinguished itself by incorporating all 2s as wild cards (the namesake 'Banakil'), echoing the mechanics of Canasta but within a purer Rummy framework.",
      originCountries: [
        'Jordan',
        'Palestine',
        'Syria',
        'Lebanon',
      ],
      timeline: [
        '1940s: Rummy variations spread through the Arab world via trade and colonial influence.',
        '1960s: Banakil emerges as the dominant form in suburban and rural Jordan and Palestine.',
        'Present: A staple in Levantine coffee houses and social clubs, often played for low stakes or simply for social prestige.',
      ],
      evolution: "The game moved from a 'Partnership-only' format to allowing individual play, adjusting the hand size to 18 cards to accommodate the increased card flow.",
      cultural: "Frequently played during evening gatherings; successful players are often admired for their patience and ability to 'read the ground' (the discard pile).",
    },
    setupContent: {
      players: '2-4 players. (4 players usually play in partners; 2-3 play individually).',
      deck: '106 cards. Two 52-card decks + 2 Jokers.',
      equipment: 'Standard pack, score sheet, non-transparent discard tray.',
      dealing: 'Dealer (rotating counter-clockwise) deals 18 cards to each player. The next card is placed face up on the table (The Ground) to start the discard pile. The rest is the Stock.',
    },
