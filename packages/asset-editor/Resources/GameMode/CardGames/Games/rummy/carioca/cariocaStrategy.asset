    tips: [
      {
        title: 'Tip',
        description: 'Jokers are worth 50 points - try not to be stuck with them',
      },
      {
        title: 'Tip',
        description: 'Going down early gives more chances to play off cards',
      },
      {
        title: 'Tip',
        description: "Watch opponents' discards for clues about their hands",
