          equipment: '',
          dealing: 'Each player starts with 13 tiles; dealer with 14.',
          hasPlaceholders: false,
        },
        rules: {
          objective: "Complete a 14-tile hand with at least one 'Yaku' (scoring pattern).",
          gameplay: "Four players draw one tile from the wall (stock) each turn and discard one face-up. Players may call chii (sequence from left neighbor's discard), pon (triplet from any discard), or kan (quad). Declare Riichi when one tile from tenpai (ready hand). Win by completing 14 tiles (4 melds and 1 pair) with at least one Yaku (scoring pattern), either by self-draw (tsumo) or on an opponent's discard (ron).",
          keyRules: [
            'Each turn: draw one tile from the wall, then discard one face-up.',
            "Call chii (sequence) only from left neighbor; pon (triplet) and kan (quad) from any player's discard.",
            'Riichi: declare when one tile from tenpai; hand becomes closed for bonus.',
            'Win with 14 tiles (4 melds + 1 pair) and at least one Yaku.',
            'Furiten: if you could win on a discarded tile but did not call, you cannot win on discard until next turn.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Prioritize 'Five-Block' theory. Your hand should be visualized as 4 sets and 1 pair. If you have 6 potential blocks, discard the weakest one immediately to increase efficiency.",
          intermediate: "Yaku Awareness: Don't just pick up tiles. If you open your hand (call Chow/Pung), you lose the ability to declare Riichi. Only open your hand if you have a guaranteed Yaku like 'All Simples' or 'Dragon Pung'.",
          advanced: "Defensive Folding (Beta-Ori): If an opponent declares Riichi, stop trying to win. Discard 'Safe Tiles' (Genbutsu) that the opponent already discarded, as they cannot win on those due to the Furiten rule.",
          tips: [
            "Keep 'Middle Tiles' (3-7). They are the most flexible for building sequences.",
            "If you have no Yaku and the deck is running low, just 'Tenpai' (stay one away) to avoid the penalty in a draw.",
          ],
          hasPlaceholders: false,
        },
