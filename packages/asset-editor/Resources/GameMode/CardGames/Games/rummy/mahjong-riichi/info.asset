    historyContent: {
      origins: "Mahjong was introduced to Japan in the early 1900s. After WWII, the rules were standardized into the 'Riichi' style to facilitate national tournaments.",
      originCountries: [
        'Japan',
      ],
      timeline: [
        '1924: First Japanese Mahjong club opens in Tokyo.',
        "1947: Riichi rules allow for 'Tenpai' declarations.",
        '2006: Saki manga/anime and online platforms like Mahjong Soul globalize the Riichi variant.',
        'Present: The dominant form of professional Mahjong worldwide.',
      ],
      evolution: "The game moved away from the 'High-Fan' chaos of Chinese variants toward a system that rewards tile efficiency and defensive folding.",
      cultural: 'Professional leagues (M-League) and arcade culture in Japan treat players as celebrities.',
    },
    setupContent: {
      players: '4 players. Wind rotation (East/South).',
