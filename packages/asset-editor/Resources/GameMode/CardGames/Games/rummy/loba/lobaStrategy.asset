    tips: [
      {
        title: 'Tip',
        description: "Prioritize 'Escaleras' (Sequences) over 'Juegos' (Sets). Sequences are easier to extend and yield more opportunities to 'lay off' cards later.",
      },
      {
        title: 'Tip',
        description: "In Loba, the 2 is often a 'clean' cardâ€”use it naturally in sequences rather than as a wildcard unless desperate.",
      },
      {
        title: 'Tip',
        description: "Watch opponents' card counts. When someone is down to 2-3 cards, be very careful about what you discard.",
      },
      {
        title: 'Tip',
        description: 'If you have multiple possible melds, lay down the one that gives you the most flexibility for laying off remaining cards.',
