  data: {
    LLM: 'Game: Hand and Foot (Canasta variant, partnerships). Deal: 11 hand cards + 11 foot cards per player (5-6 deck). Play hand first, then foot. Melds: sets (3+ same rank). Canasta: 7+ cards = 300-500 points bonus. Scoring: cumulative, first 10,000+ wins.',
    Player: 'Welcome to Hand and Foot! Deal creates two card holdings: your Hand and your Foot. Meld cards into sets and runs. Form canastas (7+ cards of same rank) for huge bonuses. Work your Hand down, then play your Foot. First partnership to 10,000 points wins!',
    objective: 'Score the most points over 4 rounds by forming melds and canastas. Be the first partnership to go out (empty hand and foot).',
    gameplay: 'Turn Structure: 1. Draw: Draw 2 cards from stock OR pick up entire discard pile (if you can immediately use the top card in a meld). 2. Meld: Lay down melds or add to existing partnership melds. 3. Discard: Discard 1 card to end turn. Minimum Initial Meld: Round 1: 50 points, Round 2: 90 points, Round 3: 120 points, Round 4: 150 points. Picking Up Your Foot: After playing all cards from your hand, pick up your foot. If you discard your last hand card, pick up foot on next turn. If you play all hand cards without discarding, immediately pick up foot and continue playing.',
    keyRules: [
      'Must follow suit if possible; if not, may play any card.',
      'Red Threes: +100 points if melded, -100 if caught in hand/foot.',
      'Black Threes: Cannot be melded; -5 points if caught in hand/foot.',
      'Clean Canasta (7 natural cards): +500 points.',
      'Dirty Canasta (with wilds): +300 points.',
      'To go out: Need at least 1 clean and 1 dirty canasta; both partners must have picked up their feet.',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '2-6 players. Best with 4 in partnerships (partners sit opposite).',
      deck: '5-6 standard 52-card decks + Jokers (typically 5 decks for 4 players).',
      equipment: 'Two denominations of chips or counters for scoring.',
      dealing: 'Each player receives TWO sets of cards: Hand (11-15 cards) and Foot (11-15 cards face-down). Remaining cards form the stock. Top card turned face-up to start discard pile (if Red Three or Wild, bury it and turn another).',
    },
    turnFlow: 'Turn Structure: 1. Draw: Draw 2 cards from stock OR pick up entire discard pile (if you can immediately use the top card in a meld). 2. Meld: Lay down melds or add to existing partnership melds. 3. Discard: Discard 1 card to end turn. Minimum Initial Meld: Round 1: 50 points, Round 2: 90 points, Round 3: 120 points, Round 4: 150 points. Picking Up Your Foot: After playing all cards from your hand, pick up your foot. If you discard your last hand card, pick up foot on next turn. If you play all hand cards without discarding, immediately pick up foot and continue playing.',
