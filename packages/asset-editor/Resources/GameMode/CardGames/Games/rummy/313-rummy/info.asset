  data: {
    hero: {
      title: '313 RUMMY',
      subtitle: 'Rummy',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Three-Thirteen Rummy',
            subtitle: 'Rummy',
            content: [
              {
                type: 'paragraph',
                text: 'Rummy variant with eleven rounds. In round 1 three cards are dealt to each player, in round 2 four cards, and so on up to thirteen in round 11. Each round has a different wild card: round 1 threes are wild, round 2 fours, up to kings wild in round 11. Players draw one card from the stock or top of the discard pile, then discard one. Object is to form all cards into sets of three or more of the same rank or runs of three or more in the same suit; aces rank low. Lowest total penalty after eleven rounds wins.',
              },
              {
                type: 'paragraph',
                text: 'Three-Thirteen Rummy variant from the USA where card count per hand increases from 3 to 13 across successive rounds.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck',
              },
              {
                type: 'paragraph',
                text: 'Standard deck, scoring materials',
              },
              {
                type: 'paragraph',
                text: 'Eleven rounds. First dealer is chosen at random; the turn to deal passes to the left after each round. In round 1 three cards are dealt to each player, in round 2 four cards, and so on until round 11 when thirteen cards each are dealt. The remainder is placed face down as the stock; the top card is turned face up beside it to start the discard pile. One deck for two players, two decks for three or four.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Ace high or low: Aces may be used high or low so A-K-Q is a valid run; an ace left in hand at round end costs 15 points instead of 1.',
                  },
                  {
                    text: 'Face card scoring: Some groups score 10 points for Jacks, Queens, and Kings instead of 11, 12, and 13 as in the base rules.',
                  },
                  {
                    text: 'Jokers as wilds: Jokers are added as extra wild cards; a joker left in hand at round end scores 20 penalty points.',
                  },
                  {
                    text: '3-13 Speed: Simultaneous drawing and discarding controlled by a caller; for large groups.',
                  },
                  {
                    text: 'Five Crowns: Proprietary version using a five-suited pack.',
                  },
                  {
                    text: "Deuces Aren't Wild: Variant with an additional 14-card round and a bonus round in the event of a tie.",
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Rummy variant with eleven rounds. In round 1 three cards are dealt to each player, in round 2 four cards, and so on up to thirteen in round 11. Each round has a different wild card: round 1 threes are wild, round 2 fours, up to kings wild in round 11. Players draw one card from the stock or top of the discard pile, then discard one. Object is to form all cards into sets of three or more of the same rank or runs of three or more in the same suit; aces rank low. Lowest total penalty after eleven rounds wins.',
