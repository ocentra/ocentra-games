        rules: {
          objective: 'Finish each deal by going out (melding all cards and discarding one), and end the full series with the lowest cumulative penalty score.',
          gameplay: 'A game is played over sequential deals with changing wild rank. On each turn, player draws from stock or top discard, may meld/lay off/replace wilds if allowed, then discards one card. When a player goes out, others score cards left in hand. Continue through the planned deal sequence.',
          keyRules: [
            'Wild rank changes by deal (Ace, 2, 3 ... King in the 13-deal form).',
            'Valid melds are sets and runs; wild cards can substitute as allowed by house rules.',
            'A player may lay off onto existing melds after their first meld.',
            'To go out, player must usually discard a final card.',
            'Scoring is cumulative and low score wins the full game.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Meld early to reduce penalty risk while keeping flexibility for final discard.',
          intermediate: 'Track current wild rank and reserve natural cards that can reclaim wild substitutions in table melds.',
