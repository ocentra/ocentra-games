    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Crazy Rummy',
            subtitle: 'Rotating Wild Rummy',
            content: [
              {
                type: 'paragraph',
                text: 'Crazy Rummy is a multi-deal rummy game in which the wild rank changes each deal (Aces wild in deal 1, Twos wild in deal 2, and so on). Players draw, meld, lay off, and discard to go out with the lowest cumulative score over the series.',
              },
              {
                type: 'paragraph',
                text: 'Crazy Rummy is documented as a North American rummy family game with many local names and house-rule branches; it is also played in the UK (e.g. South Wales and Dorset).',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-6 players (4 is common).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck, usually without jokers in base rules.',
              },
              {
                type: 'paragraph',
                text: 'Deck, score sheet, and chips or tokens if side payments are used.',
              },
              {
                type: 'paragraph',
                text: 'Deal 7 cards to each player and an eighth card to player left of dealer, who begins.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: '13-Deal Standard: Classic sequence from Aces wild through Kings wild over 13 deals.',
                  },
                  {
                    text: 'Double Deck Variant: Uses two decks for larger groups and longer meld ladders.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
