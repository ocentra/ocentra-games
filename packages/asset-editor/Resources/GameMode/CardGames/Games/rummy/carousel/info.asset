    hero: {
      title: 'Carousel',
      subtitle: 'Manipulation Rummy',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Carousel',
            subtitle: 'Manipulation Rummy',
            content: [
              {
                type: 'paragraph',
                text: 'Carousel is a Manipulation Rummy game where players can rearrange existing melds on the table to create new combinations. Players draw 1-3 cards per turn and must meld after drawing 1 or 2 cards. Features jokers and a knocking mechanic to end rounds.',
              },
              {
                type: 'paragraph',
                text: "Carousel appears in Culbertson's Hoyle (1950) and was described by John Scarne in his Encyclopedia of Card Games (1973) as 'fairly popular and interesting.' It is part of the Manipulation Rummy family where table melds can be rearranged.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-5 players, each playing individually. 2 players: use 53 cards (1 deck + 1 joker). 3-5 players: use 106 cards (2 decks + 2 jokers).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card pack(s) with jokers. 2 players: 1 deck + 1 joker = 53 cards. 3-5 players: 2 decks + 2 jokers = 106 cards. Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2. Ace high or low in sequences (not both).',
              },
              {
                type: 'paragraph',
                text: '1-2 standard decks with jokers, score sheet',
              },
              {
                type: 'paragraph',
                text: '10 cards dealt to each player. Remaining cards form stock. No discard pile in this game.',
              },
            ],
          },
        ],
      },
    ],
