    historyContent: {
      origins: "Derived from European Rummy games (like Kalooki 40), it was heavily adapted in Jamaica to include the 'out-of-turn call' and specific contract escalations.",
      originCountries: [
        'Jamaica',
      ],
      timeline: [
        'Early 20th Century: European immigrants bring Rummy variants to the Caribbean.',
        '1950s: Modern Jamaican Kalooki rules emerge in Kingston social clubs.',
        '1980s: Becomes a popular competitive game in the UK and USA alongside the Jamaican diaspora.',
        'Present: A cultural icon of Jamaican gaming, played in professional tournaments and family gatherings.',
      ],
      evolution: "The game's length (9 rounds) and high card count (up to 16 cards per hand) make it one of the most endurance-based Rummy variants.",
      cultural: "In Jamaica, Kalooki is synonymous with social focus; 'calling' a card (taking a discard out of turn) is an aggressive and strategic social move.",
    },
