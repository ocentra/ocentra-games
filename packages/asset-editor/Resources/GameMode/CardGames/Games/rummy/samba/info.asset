          {
            title: 'Samba',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Samba is a rummy card game that involves melding, sets, runs. The game originated in USA/UK and has become popular worldwide.',
              },
              {
                type: 'paragraph',
                text: 'Country/Region of Origin: USA/UK\nTime Period: Early 1900s\nHistorical Development: The game evolved from traditional card games in the region\nCultural Significance: Popular social and family game',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Minimum Players: 2\nMaximum Players: 6\nOptimal Players: 4 (partnerships)\nPartnerships: With 4 or 6 players, partners sit opposite.',
              },
              {
                type: 'paragraph',
                text: 'Type: Three standard 52-card decks plus 6 jokers (162 cards total). Twos and jokers are wild.',
              },
              {
                type: 'paragraph',
                text: 'Three 52-card decks, 6 jokers, score sheet, table space.',
              },
              {
                type: 'paragraph',
                text: 'Cards per Player: 15 each for 2–5 players; 13 each for 6 players. One card turned face up to start discard pile; remainder forms stock. Dealing clockwise.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Bolivia: Similar to Samba but allows melds of seven wild cards (bolivia), worth 2500; to go out need two 7-card melds with at least one sequence (escalera).',
                  },
                ],
              },
            ],
          },
        ],
      },
