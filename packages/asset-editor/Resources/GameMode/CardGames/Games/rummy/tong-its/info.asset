    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Tong Its',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Tong Its is a popular Rummy-style game from the Philippines for three players. It involves drawing, melding sets/runs, and discarding. Players aim to empty their hands ('Tong Its') or minimize points. It features a mechanism to 'Draw' (fight) where players compare scores to end the hand early.",
              },
              {
                type: 'paragraph',
                text: 'Tong-its gained popularity in the 1990s in Luzon, the largest island of the Philippines. Its precise origin remains undocumented, but it is widely believed to have been introduced or influenced by US military presence in the 1940s and adapted from the American card game Tonk (1930s). The game was evolved and popularized among Ilocanos as Tong-its and spread to regions such as Pangasinan by the mid-1980s, where it is also known as Tung-it. Both the name and structure suggest a direct relationship to Tonk; Tong-its is effectively an extended version played with 12-card hands.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Three players only.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card. Values: Face=10, A=1, Num=Face.',
              },
              {
                type: 'paragraph',
                text: 'Cards, chips/money',
              },
              {
                type: 'paragraph',
                text: 'Dealer 13 cards, others 12.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Extra chips for long runs: Some play with more special hands that earn extra chips, e.g. 3 chips for any 5-card or longer run that the winner has.',
                  },
                  {
                    text: 'Reduced bonus payments: Some play with a payment of only 2 chips instead of 3 for secret sets of 4, Tongit, and winning a challenge after a Draw.',
                  },
                ],
              },
            ],
          },
