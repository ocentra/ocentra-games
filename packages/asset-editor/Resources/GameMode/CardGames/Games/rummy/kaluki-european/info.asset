  data: {
    hero: {
      title: 'KALUKI',
      subtitle: 'The Rummy of Champions',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Kaluki (European)',
            subtitle: 'The Rummy of Champions',
            content: [
              {
                type: 'paragraph',
                text: "Kaluki (also spelled Kalooki) is a widely played European variant of Rummy, characterized by its use of two 52-card decks plus Jokers. Primarily played for points over multiple hands, it features a 51-point initial meld threshold and a distinctive 'Joker Exchange' rule where players can 'rescue' wild cards from the board.",
              },
              {
                type: 'paragraph',
                text: "Believed to be a mid-20th century evolution of earlier Rummy games like Rummikub (the tile version) and standard 500 Rummy. The name likely derives from the Hungarian or Eastern European 'Kalooki' variants.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 5 players (optimal with 4).',
              },
              {
                type: 'paragraph',
                text: '106 cards. Two standard 52-card decks plus 2 Jokers. Suits are Hearts, Diamonds, Clubs, Spades.',
              },
              {
                type: 'paragraph',
                text: 'Standard cards, score sheet, chips or counters for stakes (optional).',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 13 cards dealt singly. The next card is turned face-up to start the discard pile; remaining cards form the stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Kalooki 40 (British): Initial meld requirement is 40 points instead of 51. More common in British clubs and faster-paced.',
                  },
                  {
                    text: 'Kalooki 51 (North American): Standard North American version requiring 51-point initial meld. More strategic and defensive.',
                  },
                  {
                    text: 'South African Kaluki: Uses 4 Jokers and has a 7-round contract structure with different opening requirements each round.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: "Kaluki (also spelled Kalooki) is a widely played European variant of Rummy, characterized by its use of two 52-card decks plus Jokers. Primarily played for points over multiple hands, it features a 51-point initial meld threshold and a distinctive 'Joker Exchange' rule where players can 'rescue' wild cards from the board.",
    tags: [
      'card-game',
      'rummy',
      'melding',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 5,
    routePath: 'kaluki-european',
    LLM: 'Game: Kaluki (European). Type: Rummy. Deck: 2x52+2 Jokers (106 cards). Hand: 13 cards. Opening: 51 point minimum. Melds: Sets (3-4 same rank) and Runs (3+ consecutive, Ace high). Jokers wild (15 penalty if held). Building allowed after opening. Goal: Empty hand first, minimize penalty points.',
    Player: "Welcome to Kaluki! You need 51 points to openâ€”can you get there with Aces and Face cards? Watch those Jokersâ€”15 penalty points each if you're caught holding them! Will you draw from the stock or grab that discard you need?",
    tagline: 'Master the meld, conquer the threshold, claim victory.',
    gameCategory: 'Rummy',
    subcategory: 'Melding',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '30-50 minutes',
    origin: 'Europe',
    originName: 'Kalooki',
    deck: '106 cards (2x52 + 2 Jokers)',
