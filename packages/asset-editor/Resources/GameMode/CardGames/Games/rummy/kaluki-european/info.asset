    historyContent: {
      origins: "Believed to be a mid-20th century evolution of earlier Rummy games like Rummikub (the tile version) and standard 500 Rummy. The name likely derives from the Hungarian or Eastern European 'Kalooki' variants.",
      originCountries: [
        'Hungary',
        'United Kingdom',
      ],
      timeline: [
        '1940s: Rummy variants using two decks emerge in the US and Europe.',
        "1960s: Standardized rules for 'Kalooki 51' appear in Western card books.",
        '2000s: Online gaming platforms bring Kaluki to a global audience.',
        'Present: A staple social game, often associated with bridge clubs and retirement social circles.',
      ],
      evolution: "The game branched into a 'Contract' version (popular in the Caribbean) and a 'Point' version (popular in Europe), with the latter focusing on a single high opening score.",
      cultural: "In North America, it is often called 'Double-Deck Rummy' or simply 'Kalooki'. It is known for being a 'polite' but intensely competitive game.",
    },
    setupContent: {
      players: '2 to 5 players (optimal with 4).',
      deck: '106 cards. Two standard 52-card decks plus 2 Jokers. Suits are Hearts, Diamonds, Clubs, Spades.',
