  data: {
    hero: {
      title: 'CONQUIAN',
      subtitle: 'The Ancestor of Rummy',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Conquian',
            subtitle: 'The Ancestor of Rummy',
            content: [
              {
                type: 'paragraph',
                text: 'Conquian is widely regarded as the ancestor of all Rummy games, originating in Mexico in the 19th century. It is a 2-player draw-and-meld card game played with a 40-card Spanish deck (8s, 9s, and 10s removed from a French deck). Players take turns forcing the opponent to take offered cards or themselves draw from stock, building melds of 3+ in sequence or of a kind. The first player to meld their entire 10-card hand wins.',
              },
              {
                type: 'paragraph',
                text: 'Believed to have originated in Mexico in the 1800s, possibly adapted from Chinese Mahjongg or from an earlier European game. It is considered the root ancestor of Gin Rummy, Oklahoma Gin, and all modern Rummy variants.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '40 cards: Standard 52-card deck with 8s, 9s, and 10s removed. Rank order: A-2-3-4-5-6-7-J-Q-K.',
              },
              {
                type: 'paragraph',
                text: '40-card stripped deck.',
              },
              {
                type: 'paragraph',
                text: '10 cards each. Rest is stock. No initial discard pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Coon Can (American variant): American Southwest variant of Conquian. Played with full 52-card deck. Otherwise very similar mechanics.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    description: 'Conquian is widely regarded as the ancestor of all Rummy games, originating in Mexico in the 19th century. It is a 2-player draw-and-meld card game played with a 40-card Spanish deck (8s, 9s, and 10s removed from a French deck). Players take turns forcing the opponent to take offered cards or themselves draw from stock, building melds of 3+ in sequence or of a kind. The first player to meld their entire 10-card hand wins.',
    tags: [
      'card-game',
      'social',
    ],
    comingSoon: false,
    minPlayers: 2,
    maxPlayers: 2,
    routePath: 'conquian',
    LLM: 'Game: Conquian. 40-card Mexican deck (8s/9s/10s removed). 2-player. 10 cards each. Offer top stock card; opponent must take if meldable. Sequences: A-2-3-4-5-6-7-J-Q-K. Sets: same rank Ã—3-4. First to meld all 10 wins.',
    Player: 'You have melds: [A-2-3â™£] and [J-Q-Kâ™ ]. Your hand has 4 remaining cards. Opponent offers the 4â™£. Your sequence in Clubs is A-2-3; the 4â™£ extends it to A-2-3-4. YOU MUST TAKE IT. (Missing taking a valid meld extension is compellable by opponent.)',
    tagline: 'Meld your 10 cards. Force your opponent. Win first.',
    gameCategory: 'Rummy',
    subcategory: 'Draw-Meld (Ancestor Rummy)',
    playerMode: 'multiplayer',
    difficulty: 'Intermediate',
    duration: '20-40 minutes',
    origin: 'Mexico (19th century)',
    originName: 'Con quién',
    deck: '40 cards (8s, 9s, 10s removed from standard deck)',
    alsoKnownAs: [
      'Con Quien',
      'Coon Can',
      'Rum (possible ancestor)',
    ],
    playersDisplay: '2',
