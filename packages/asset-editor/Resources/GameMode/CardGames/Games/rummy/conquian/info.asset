    historyContent: {
      origins: 'Believed to have originated in Mexico in the 1800s, possibly adapted from Chinese Mahjongg or from an earlier European game. It is considered the root ancestor of Gin Rummy, Oklahoma Gin, and all modern Rummy variants.',
      originCountries: [
        'Mexico',
      ],
      timeline: [
        "1800s: Documented in Mexico as 'Conquian' or 'Con Quien'.",
        '1870s-1880s: Spread to the American Southwest.',
        '1900s: Influenced the creation of Rum (Rummy) in the USA.',
        'Present: Played in Mexico under its traditional name; studied as the Rummy progenitor.',
      ],
      evolution: "Conquian introduced the core Rummy mechanic: draw one card, meld if possible, discard. Its unique 'forced take' mechanicâ€”where you can compel your opponent to meld a discardâ€”is preserved in almost no other modern game.",
      cultural: 'A foundational game of Mexican card culture and the documented ancestor of the entire Rummy family. Important in the history of card game taxonomy.',
    },
    setupContent: {
      players: 'Two or more players.',
      deck: '40 cards: Standard 52-card deck with 8s, 9s, and 10s removed. Rank order: A-2-3-4-5-6-7-J-Q-K.',
      equipment: '40-card stripped deck.',
      dealing: '10 cards each. Rest is stock. No initial discard pile.',
