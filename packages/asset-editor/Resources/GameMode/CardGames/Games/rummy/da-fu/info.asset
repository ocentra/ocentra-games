    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Da Fu',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Da Fu is a traditional Chinese money-card game played in the same money-suited ecosystem as Quan Dui and Luk Fu, emphasizing pair and sequence construction under draw-discard flow.',
              },
              {
                type: 'paragraph',
                text: "Dates back to the Qing Dynasty. Money cards (divided into Coins, Strings, and Myriads) were the direct ancestors of modern Mahjong tiles. Quan Dui evolved as a faster, pair-focused variant of the more complex 'Guan Pai' games.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 is most common.',
              },
              {
                type: 'paragraph',
                text: '120 cards (3 suits: Coins, Strings, Myriads; 4 sets of 1-9 each; plus 3 Special cards).',
              },
              {
                type: 'paragraph',
                text: '120 cards (3 suits: Coins, Strings, Myriads; 4 sets of 1-9 each; plus 3 Special cards).',
              },
              {
                type: 'paragraph',
                text: 'Dealer gets 16 cards, others get 15. Counter-clockwise play.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Quan Dui double stake: When the winner has all eight pairs as Dui (identical cards), they collect double the agreed stake from each opponent.',
                  },
                  {
                    text: 'Optional win claim: With eight pairs of mixed Ka and Dui, the player may choose to continue playing for quan dui instead of claiming; if the final pair was claimed from the discard as Ka, they must expose and win single stake.',
                  },
                ],
              },
            ],
          },
        ],
      },
