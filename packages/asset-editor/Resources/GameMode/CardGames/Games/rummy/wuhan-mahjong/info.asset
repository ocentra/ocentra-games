          {
            title: 'Wuhan Mahjong',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Wuhan Mahjong is a Hubei regional Mahjong variant associated with Wuhan play communities. It follows the standard draw-discard structure with meld claims and a complete-hand win condition, while the table profile determines which hands qualify and how scoring is evaluated.',
              },
              {
                type: 'paragraph',
                text: 'Wuhan Mahjong grew from Chinese Mahjong traditions as local scoring expectations and table conventions formed around Wuhan and Hubei social play.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4 players seated by wind position.',
              },
              {
                type: 'paragraph',
                text: 'Standard Mahjong set with suited tiles, honor tiles, and bonus tiles according to table profile.',
              },
              {
                type: 'paragraph',
                text: 'Standard Mahjong set with suited tiles, honor tiles, and bonus tiles according to table profile.',
              },
              {
                type: 'paragraph',
                text: 'Each player receives 13 tiles; dealer receives 14 and discards first.',
              },
            ],
          },
        ],
      },
