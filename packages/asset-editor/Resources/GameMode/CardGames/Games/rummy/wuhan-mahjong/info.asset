        rules: {
          objective: 'Complete a legal winning hand that satisfies the active Wuhan scoring profile.',
          gameplay: 'Players draw one tile and discard one tile in turn. Other players may claim discards for legal melds when claim rules permit. A player wins when their tiles form a complete hand and the scoring profile accepts the win.',
          keyRules: [
            'Default loop is draw then discard.',
            'Claims interrupt the turn sequence only when a legal meld is formed.',
            'Winning requires a complete 14-tile hand and profile-accepted validity.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Build efficient shapes and keep your hand flexible until tile flow forces a commitment.',
          intermediate: 'Track visible discards and meld direction to improve discard safety.',
          advanced: 'Profile-aware play adjusts risk versus speed based on wall depth and opponent threat signals.',
          tips: [
            'Avoid holding isolated honor tiles unless they are clearly part of your route.',
            'When opponents show strong tempo, prioritize safe discards over marginal efficiency gains.',
          ],
