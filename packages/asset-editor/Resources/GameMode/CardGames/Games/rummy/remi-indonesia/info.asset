    historyContent: {
      origins: 'Remi spread through Southeast Asia during the mid-20th century. While related to Gin Rummy and Loba, it developed a specific scoring flavor in Indonesia, particularly in Java and Sumatra.',
      originCountries: [
        'Indonesia',
      ],
      timeline: [
        'Mid-20th Century: Rummy variations become ubiquitous in Indonesian households.',
        "1980s: Standardized scoring for 'minus' points becomes common in urban parlors.",
        'Present: A staple social game alongside Domino Gaple.',
      ],
      evolution: "The game evolved into a high-stakes local favorite where tracking discards ('Sampah') is essential to avoid penalties.",
      cultural: "Often played for small stakes or as a way to pass long evenings ('Nongkrong').",
