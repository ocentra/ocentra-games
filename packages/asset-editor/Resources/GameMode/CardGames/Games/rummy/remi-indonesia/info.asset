    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Indonesian Rummy',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: "Remi Indonesia (or simply Remi) is a popular Indonesian distillation of classic Rummy. It is a draw-and-discard game for 2 to 4 players, emphasizing the creation of sets (three of a kind) and runs (sequences). It features a unique scoring system involving negative points for 'dead' cards and bonuses for ending the game with a 'Remi' (dumping the entire hand).",
              },
              {
                type: 'paragraph',
                text: 'Remi spread through Southeast Asia during the mid-20th century. While related to Gin Rummy and Loba, it developed a specific scoring flavor in Indonesia, particularly in Java and Sumatra.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 to 4 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces can be high or low but generally 11 points.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces can be high or low but generally 11 points.',
              },
              {
                type: 'paragraph',
                text: '7 cards to each player (if 2 players) or 7 cards (if 3-4 players). The rest forms the center stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Remi 7: Strict 7-card.',
                  },
                  {
                    text: 'Remi 10: 10 cards each.',
                  },
                  {
                    text: 'Loba: Two decks.',
                  },
                ],
              },
            ],
          },
