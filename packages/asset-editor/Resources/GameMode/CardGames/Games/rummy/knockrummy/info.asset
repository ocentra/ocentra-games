          hasPlaceholders: false,
        },
        rules: {
          objective: 'Form sets (3-4 of a kind) and runs (3+ in suit) and have the lowest point total of unmatched cards (deadwood) when the round ends.',
          gameplay: "1. Draw one card from the stock or discard pile.\n2. Form melds in hand (but do not lay them down on the table until the end).\n3. End of Turn: Discard one card. If you wish to end the round, announce 'Knock' before or during the discard.",
          keyRules: [
            'Form sets (3-4 of a kind) and runs (3+ consecutive in suit)',
            'Draw from stock or discard pile',
            'Can knock at any point after draw',
            "No laying off on opponent's melds",
            'Lowest deadwood wins',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Knock early. If you have two sets and your remaining 3 cards are an Ace-2-3, you have very low points (6). Knocking early prevents your opponent from finishing their high-value runs.',
          intermediate: "The 'High Card Dump': If you aren't close to a meld, discard your Kings and Queens first. Your goal is to keep your deadwood total low in case someone else knocks suddenly.",
          advanced: "Baiting the Discard: Discard a card that you think your opponent doesn't need, even if it fits your hypothetical run, to keep the stock pile moving without giving them an advantage.",
          tips: [
            'If you draw from the discard pile, you are signaling what rank you are collecting. Use the stock pile instead if you want to keep your strategy secret.',
            "Don't knock if you have more than 20 points in deadwoodâ€”the risk of being 'under-cut' is too high.",
          ],
          hasPlaceholders: false,
        },
