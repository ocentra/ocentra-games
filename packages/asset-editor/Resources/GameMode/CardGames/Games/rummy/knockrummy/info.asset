        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Knock Rummy',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Knock Rummy is a fast-paced variant of the classic Rummy family. Unlike standard Rummy where players must wait for a 'Gin' or empty their hand, in Knock Rummy any player can end the round by 'knocking' after their discard, provided they believe their unmatched card points (deadwood) are lower than their opponents'. It is a game of risk-assessment and speed.",
              },
              {
                type: 'paragraph',
                text: "Developed in the early 20th century as a quicker alternative to the lengthy '500 Rummy' matches. It directly influenced the development of Gin Rummy.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2 players (10 cards each), 3-5 players (7 cards each).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are low (1) or high (11) depending on house rules.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Aces are low (1) or high (11) depending on house rules.',
              },
              {
                type: 'paragraph',
                text: 'Cards are dealt face-down; one card is turned up to start the discard pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Gin Rummy: Adds the 10-point knock threshold and complex layoff rules.',
                  },
                  {
                    text: 'Five-Hundred Rummy: Allows laying down melds mid-turn.',
                  },
                  {
                    text: 'Rumino: An Italian variant.',
                  },
                ],
              },
            ],
          },
