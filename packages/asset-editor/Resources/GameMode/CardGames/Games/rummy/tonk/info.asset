            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Deal size: Five, seven, or nine cards dealt depending on number of players.',
                  },
                  {
                    text: 'House rules: Instant win at 49/50, high or low count, only runs as spreads, and other common house rules.',
                  },
                ],
              },
