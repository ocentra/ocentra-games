    historyContent: {
      origins: 'Cap-It is a variation of Push, a Contract Rummy game contributed by Paul Welty. The Cap-It variant was described by Wayne Ostrowski. It modifies Push by eliminating partnerships, dealing 10 cards each round, and changing the fifth round contract.',
      originCountries: [
        'USA',
      ],
      timeline: [
        'Original Push game developed as Contract Rummy variant',
        'Wayne Ostrowski describes Cap-It variation',
        'Current: Played as gambling game with pot contributions',
      ],
      evolution: 'Cap-It evolved from Push by: (1) eliminating partnerships for individual play, (2) dealing 10 cards each round instead of increasing deals, (3) changing the fifth round contract to run of 3 + run of 7, (4) adding gambling element with pot.',
      cultural: 'Played as a social gambling game where all players contribute to a pot. Winner of each round takes a share, overall winner takes remainder. Popular in casual gaming circles.',
    },
    setupContent: {
      players: '4-6 players, each playing individually (no partnerships). For 4 players: 2 decks. For 5-6 players: 3 decks.',
