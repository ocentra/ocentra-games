    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Cap-It',
            subtitle: 'Contract Rummy',
            content: [
              {
                type: 'paragraph',
                text: 'Cap-It is a variation of Push (Contract Rummy family) where players compete individually over 5 rounds with increasing contract requirements. Unlike Push which uses partnerships, Cap-It is every player for themselves. Players contribute to a pot and winners collect from it each round.',
              },
              {
                type: 'paragraph',
                text: 'Cap-It is a variation of Push, a Contract Rummy game contributed by Paul Welty. The Cap-It variant was described by Wayne Ostrowski. It modifies Push by eliminating partnerships, dealing 10 cards each round, and changing the fifth round contract.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '4-6 players, each playing individually (no partnerships). For 4 players: 2 decks. For 5-6 players: 3 decks.',
              },
              {
                type: 'paragraph',
                text: '4 players: 108 cards (2Ã—52-card packs + 4 jokers). 5-6 players: 162 cards (3Ã—52-card packs + 6 jokers). Jokers and 2s are wild. Cards rank A-K-Q-J-10-9-8-7-6-5-4-3-2 (Ace high or low in runs).',
              },
              {
                type: 'paragraph',
                text: '2 or 3 standard 52-card packs with jokers, chips/money for pot, score sheet',
              },
              {
                type: 'paragraph',
                text: 'All 5 rounds deal 10 cards to each player (unlike Push which increases). Remaining cards form stock. Turn up one card to start discard pile (cannot be wild - if 2 or joker, bury and turn up next).',
              },
            ],
          },
        ],
      },
