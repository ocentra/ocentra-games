    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Game, Flip, Flop',
            subtitle: 'The Ohio Rummy Gamble',
            content: [
              {
                type: 'paragraph',
                text: "Game, Flip, Flop is a high-stakes variation of the American Rummy game 'Tunk' (or Tonk). Originating in Dayton, Ohio, it is famous for its three distinct betting pots: 'Game', 'Flip', and 'Flop'. While the core gameplay follows standard Rummy melding rules, the 'Flip' and 'Flop' pots introduce a side-betting element based entirely on having the lowest cards of specific suits dealt in your initial hand. It is a fast-paced gambling game where players can win pots without even playing a card.",
              },
              {
                type: 'paragraph',
                text: "The game was documented by Chad Shumate as a local specialty of Dayton, Ohio. Its roots lie in the African-American card tradition of 'Tunk' (Tonk), which was widely played by soldiers and jazz musicians in the mid-20th century.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '3 to 5 players.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck (Aces are low, 1 point).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck (Aces are low, 1 point).',
              },
              {
                type: 'paragraph',
                text: "Deal 5 cards to each player. turn the next card (Dealer's last card) FACE-UP. This is the FLIP CARD.",
              },
            ],
          },
        ],
      },
