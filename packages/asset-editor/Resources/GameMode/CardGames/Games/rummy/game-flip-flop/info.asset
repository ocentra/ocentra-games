    historyContent: {
      origins: "The game was documented by Chad Shumate as a local specialty of Dayton, Ohio. Its roots lie in the African-American card tradition of 'Tunk' (Tonk), which was widely played by soldiers and jazz musicians in the mid-20th century.",
      originCountries: [
        'USA',
      ],
      timeline: [
        '1940s: Tonk becomes popular in the US.',
        "Late 20th Century: 'Game, Flip, Flop' evolves in Dayton as a more aggressive variant with side-pots.",
        'Present: Remains a regional favorite in Ohio home games.',
      ],
      evolution: "It added the 'Flip' and 'Flop' mechanics to standard Tonk, shifting the focus from pure hand management to initial deal luck.",
      cultural: "Often played for money, with strictly enforced rules about 'paying for the pots' before each deal.",
    },
    setupContent: {
      players: '3 to 5 players.',
      deck: 'Standard 52-card deck (Aces are low, 1 point).',
      equipment: 'Standard 52-card deck (Aces are low, 1 point).',
