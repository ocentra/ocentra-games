    historyContent: {
      origins: 'Developed in the 1930s-40s in the United States, particularly among the elite social circles of New York and Hollywood. It became the professional standard for competitive Gin Rummy matches.',
      originCountries: [
        'USA',
      ],
      timeline: [
        '1940s: Becomes the standard way to play Gin Rummy in card rooms.',
        "1950s: Immortalized in literature and cinema as the 'serious' card game.",
        'Present: The preferred scoring method for organized Gin tournaments.',
      ],
      evolution: "The base game (Gin Rummy) remained largely the same, but the Hollywood scoring system was invented to mitigate the 'luck of the draw' by extending the match over three games.",
      cultural: 'Associated with mid-century sophistication and the Golden Age of Hollywood.',
