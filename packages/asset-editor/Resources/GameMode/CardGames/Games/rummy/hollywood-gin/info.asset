    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Hollywood Gin',
            subtitle: 'Card game',
            content: [
              {
                type: 'paragraph',
                text: 'Hollywood Gin is a popular scoring variation of Gin Rummy. Instead of playing a single game, players record scores for three separate games simultaneously on a single score sheet. This format increases the strategic depth and the excitement of a match by allowing a single win to contribute to multiple game totals.',
              },
              {
                type: 'paragraph',
                text: 'Developed in the 1930s-40s in the United States, particularly among the elite social circles of New York and Hollywood. It became the professional standard for competitive Gin Rummy matches.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players. Each receives ten cards per hand. The first dealer is chosen by drawing from the shuffled pack (lower card deals); thereafter the winner of the previous hand deals. In serious play both players shuffle and the non-dealer cuts.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: K-Q-J-10...A (Aces are always low).',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck. Ranking: K-Q-J-10...A (Aces are always low).',
              },
              {
                type: 'paragraph',
                text: 'The first dealer is chosen randomly by drawing cards from the shuffled pack - the player who draws the lower card deals.',
              },
            ],
          },
        ],
      },
