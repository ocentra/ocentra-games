  data: {
    scoringRules: {
      summary: 'Teams score the point values of all cards they have melded on the table, receive bonuses for burracos (clean or dirty) and for going out, and subtract the values of any cards left in hand. A clean burraco (seven or more natural cards) is worth 200 points, a dirty burraco (seven or more cards including at least one wild card) is worth 100 points, going out (closing) is worth 100 points, and a team that has not taken its pozzetto at the end of the hand loses 100 points.',
      winCondition: 'The game is played over multiple hands; after each hand both teams add their hand score (melded cards plus bonuses minus cards in hand and pozzetto penalties) to a cumulative total. When at least one team has more than 2000 points, the team with the higher total wins the game.',
      targetScore: 2000,
      scoringDirection: 'high_wins',
