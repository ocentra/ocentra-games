  data: {
    LLM: 'Turn: draw from stock or take entire discard pile; optionally meld sets (3+ same rank) or sequences (3+ consecutive same suit) or add to team melds; discard one card. First player to empty hand takes a pozzetto (11-card extra hand). Direct pozzetto: meld all cards, take pozzetto, continue. Indirect: meld all but one, discard, take pozzetto face down, use next turn.',
    Player: 'Turn: draw from stock or take entire discard pile; optionally meld sets (3+ same rank) or sequences (3+ consecutive same suit) or add to team melds; discard one card. First player to empty hand takes a pozzetto (11-card extra hand). Direct pozzetto: meld all cards, take pozzetto, continue. Indirect: meld all but one, discard, take pozzetto face down, use next turn.',
    objective: 'Form melds (sets or sequences) and create burracos (7+ card melds). Be first team to go out after taking pozzetto and having at least one burraco. Score points from melded cards plus bonuses.',
    gameplay: 'Turn: draw from stock or take entire discard pile; optionally meld sets (3+ same rank) or sequences (3+ consecutive same suit) or add to team melds; discard one card. First player to empty hand takes a pozzetto (11-card extra hand). Direct pozzetto: meld all cards, take pozzetto, continue. Indirect: meld all but one, discard, take pozzetto face down, use next turn.',
    keyRules: [
      '108 cards: 2 decks + 4 jokers; twos are wild (pinelle)',
      'Two 11-card pozzetti set aside for first players out',
      'Sets: 3+ cards same rank, max 1 wild, max 9 cards',
      'Sequences: 3+ consecutive same suit, max 1 wild',
      'Ace can be high or low but not both in same sequence',
      'Burraco = 7+ card meld (clean or dirty)',
      'Need burraco and taken pozzetto to go out',
      'Target: 2005 points',
    ],
    bonusRuleGuids: [],
    useTrump: false,
    trumpBonusValues: null,
    setup: {
      players: '4 players in fixed partnerships; 2-5 player variants exist',
      deck: '108 cards: two standard 52-card packs with 4 jokers (jolly). Twos (pinelle) can be wild or natural.',
      equipment: 'Double deck with jokers, score sheet, table space',
      dealing: 'Dealer chosen by drawing cards (lowest deals). Dealer deals 11 cards each from bottom portion. Cutter takes top third (~22+ cards), deals two 11-card pozzetti from bottom alternately, stacks them crosswise. Remaining cards form draw pile (41 cards) with one face-up card.',
    },
    turnFlow: 'Turn: draw from stock or take entire discard pile; optionally meld sets (3+ same rank) or sequences (3+ consecutive same suit) or add to team melds; discard one card. First player to empty hand takes a pozzetto (11-card extra hand). Direct pozzetto: meld all cards, take pozzetto, continue. Indirect: meld all but one, discard, take pozzetto face down, use next turn.',
