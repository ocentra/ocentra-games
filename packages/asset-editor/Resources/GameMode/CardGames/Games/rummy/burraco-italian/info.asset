    variationsContent: {
      list: [
        {
          id: 'semipulito_burraco_bonus',
          name: 'Semipulito burraco bonus',
          description: 'Some Italian circles score an intermediate bonus for a semipulito burraco: an 8+ card meld that contains exactly seven consecutive natural cards plus one wild card, or at least seven equal cards with a wild card, commonly worth 150 points with a distinct crosswise marker.',
        },
        {
          id: 'stalemate_must_draw',
          name: 'Stalemate must-draw resolution',
          description: 'Instead of ending the hand when all four players in turn simply take the single discard and throw another card, some groups require that the next player in turn must break the stalemate by drawing from the stock pile so play continues.',
        },
        {
          id: 'three_player_burraco',
          name: 'Three-player Burraco',
          description: 'A three-player version in which each player begins with 11 cards and there are two pozzetti: one of 18 cards and one of 11. The first player to meld out takes the 18-card pozzetto and continues alone while the remaining two form a partnership and compete using the smaller pozzetto.',
        },
        {
          id: 'two_player_burraco',
          name: 'Two-player Burraco',
          description: 'A head-to-head variant where each player is dealt 11 cards and there are two 11-card pozzetti. Play and scoring follow the standard Italian Burraco rules, but there are no partnerships, so each player manages melds and pozzetto timing alone.',
        },
        {
          id: 'three_player_scoring_notes',
          name: 'Three-player scoring notes',
          description: 'In some descriptions of three-player Burraco, the two players who become partners after the first pozzetto is taken divide their partnership total between them for cumulative scoring, rather than tracking a separate team score.',
        },
        {
          id: 'two_player_scoring_notes',
          name: 'Two-player positional play',
          description: 'Two-player Burraco plays identically to the partnership game except that there is no benefit in exposing melds early unless it enables taking a pozzetto or prevents the opponent from closing before your next turn.',
        },
