        synthesis: {
          hero: {
            title: 'BURRACO ITALIAN',
            subtitle: 'Card game',
            tagline: 'Play and win.',
          },
          shortDescription: 'Burraco is an immensely popular Italian Rummy game related to Canasta. Four players in partnerships meld sets and sequences to create burracos (7+ card melds). The game features pozzetti (extra hands)',
          uiThemes: [
            'classic',
          ],
          uiLayout: {
            zones: [
              'hand',
              'stock',
              'trick',
            ],
            marketPosition: 'center',
            stockPosition: 'center',
            discardPosition: 'NA',
            playerHandLayout: 'arc',
            potPosition: 'center',
          },
        },
        prompts: {
          human: '',
          ai: '',
        },
        scoring: {
          description: 'Teams score the point values of all cards they have melded on the table, receive bonuses for burracos (clean or dirty) and for going out, and subtract the values of any cards left in hand. A clean burraco (seven or more natural cards) is worth 200 points, a dirty burraco (seven or more cards including at least one wild card) is worth 100 points, going out (closing) is worth 100 points, and a team that has not taken its pozzetto at the end of the hand loses 100 points.',
          winCondition: 'The game is played over multiple hands; after each hand both teams add their hand score (melded cards plus bonuses minus cards in hand and pozzetto penalties) to a cumulative total. When at least one team has more than 2000 points, the team with the higher total wins the game.',
          cardValues: {
            Joker: '30 points per joker.',
            'Two (pinella)': '20 points per two in any suit.',
            Ace: '15 points per ace.',
            'K, Q, J, 10, 9, 8': '10 points per card.',
            '7, 6, 5, 4, 3': '5 points per card.',
          },
          penalties: {
            CardsLeftInHand: "At the end of the hand, each team subtracts the total point value of all cards remaining in its players' hands.",
            UnclaimedPozzetto: 'A team that has not taken its pozzetto by the end of the hand loses a flat 100 points instead of the value of those cards.',
          },
          splitRules: 'If both teams exceed 2000 or more points in the same hand, the team with the higher total wins; if totals are exactly tied, play additional hands until the tie is broken.',
          targetScore: 2000,
          scoringDirection: 'high_wins',
