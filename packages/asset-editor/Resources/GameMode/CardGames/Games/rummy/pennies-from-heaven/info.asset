    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Pennies from Heaven',
            subtitle: 'Hand and Foot Canasta',
            content: [
              {
                type: 'paragraph',
                text: 'Pennies from Heaven is a Hand and Foot Canasta variant. 6 players, 4 packs+8 jokers. Four canasta types: natural(500), mixed(300), wild(1000), sevens(1500). Draw 2 per turn. Must complete one of each canasta type to go out. 13 hand + 11 face-down foot. 20,000 to win.',
              },
              {
                type: 'paragraph',
                text: "Pennies from Heaven is the name used in card game literature for a distinctive North American variety of Canasta related to Hand and Foot. Almost identical rules appear in the US Playing Card Company's Official Rules of Card Games and in John Scarne's Encyclopedia of Games. Related variants include Railroad Canasta and Bain Hand and Foot (Barbara Bain).",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '6 in two teams. Sit alternately.',
              },
              {
                type: 'paragraph',
                text: '4 packs, 8 jokers. Twos and jokers wild.',
              },
              {
                type: 'paragraph',
                text: '216 cards.',
              },
              {
                type: 'paragraph',
                text: '13 each + 11 face-down (foot). Top of stock turned for discard.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Railroad Canasta: 2 decks per person; different kitty rules.',
                  },
                  {
                    text: "Bain Hand and Foot: Barbara Bain's variant.",
                  },
                ],
              },
            ],
          },
        ],
      },
