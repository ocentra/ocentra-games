        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Arlington',
            subtitle: 'The Oklahoma Classic',
            content: [
              {
                type: 'paragraph',
                text: "Arlington, often called Oklahoma Rummy, is a complex contract rummy game played over seven distinct hands. It features an aggressive 'wild-stealing' mechanic and a unique 'Offering' phase after every turn, making it much more interactive than standard Draw-and-Discard rummy games.",
              },
              {
                type: 'paragraph',
                text: 'Arlington emerged alongside other contract rummy games like Phase 10 and Liverpool Rummy in the mid-20th century. It became a staple in Oklahoma and the American Midwest specifically for its high-scoring potential.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2-8 players. Individual play or 2-player partnerships.',
              },
              {
                type: 'paragraph',
                text: '105 cards (2 x 52 + 1 Joker). All 2s and the Joker are wild.',
              },
              {
                type: 'paragraph',
                text: 'Two standard decks, score sheet.',
              },
              {
                type: 'paragraph',
                text: 'Each player is dealt 13 cards. The remainder forms the stock pile. The top card is flipped to start the discard pile.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Arlington Queen: The Queen of Spades is worth 50 points (same as a Joker) but is NOT wild.',
                  },
                  {
                    text: 'Short Arlington: Played over 6 hands instead of 7 to speed up play.',
                  },
                ],
              },
            ],
          },
        ],
      },
