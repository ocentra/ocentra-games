    historyContent: {
      origins: 'Arlington emerged alongside other contract rummy games like Phase 10 and Liverpool Rummy in the mid-20th century. It became a staple in Oklahoma and the American Midwest specifically for its high-scoring potential.',
      originCountries: [
        'United States',
      ],
      timeline: [
        "1940s: Early iterations of 'Oklahoma Rummy' appear in social clubs.",
        "1960s: Standardized into the 'Arlington' ruleset with the 'Offering' phase.",
        'Present: Popular in digital rummy collections and regional American card clubs.',
      ],
      evolution: "The game evolved from basic Rummy by adding 'wild-replacement' rules, where players could liberate wild cards from opponents' melds using natural cards.",
      cultural: "Known as a 'long-form' social game, often played during weekend gatherings where the 7-hand progression can be fully appreciated.",
    },
