    tips: [
      {
        title: 'Tip',
        description: 'Wait to lay down your contract until you have almost your whole hand filled. Once you lay down, opponents can steal your wilds!',
      },
      {
        title: 'Tip',
        description: 'Hand 7 (Three runs of 4) is the decider; the winning bonus for that hand is usually enough to overcome any early lead.',
