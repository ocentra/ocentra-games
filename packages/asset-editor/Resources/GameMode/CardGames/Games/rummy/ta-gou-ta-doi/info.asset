    hero: {
      title: 'Ta Gou Ta Doi 搭九搭对',
      subtitle: 'Rummy',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Ta Gou Ta Doi 搭九搭对',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: "Ta Gou Ta Doi (搭九搭对, 'making nines and pairs') is a Malaysian rummy-like game played with 32 Chinese chess (Xiangqi) pieces used as cards. Each turn: draw one, discard one. Win by collecting three valid sets of two: Gou (two pieces summing to 9) or Doi (pair of same value). Easy and hard variants differ in what counts as a set.",
              },
              {
                type: 'paragraph',
                text: "Malaysian game using Xiangqi pieces as playing cards. Name (Fuzhou dialect) means 'making nines and pairs'. Documentation from Alexey Lobashev and Hua Kiong's blog.",
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: '2, 3 or 4 (best for 3).',
              },
              {
                type: 'paragraph',
                text: '32 Xiangqi pieces mixed face down, arranged in stacks of two in a circle.',
              },
              {
                type: 'paragraph',
                text: 'Chinese chess (Xiangqi) set of 32 pieces; table.',
              },
              {
                type: 'paragraph',
                text: 'Starting player determined by turning one stack face up and counting by total value. Players take stacks clockwise until each has two stacks; first player takes a third stack, then each takes one piece from next stacks so each has 5 pieces. Pieces held face down in a row.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: 'Easy: Gou: two pieces of any rank and colour whose values add up to 9. Doi: two pieces of the same value, any colour.',
                  },
                  {
                    text: 'Hard: Only valid sets are pairs of identical pieces (same colour) or the value-2 pair (marshal and general).',
                  },
                ],
              },
            ],
          },
        ],
      },
