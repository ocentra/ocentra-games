        rules: {
          objective: 'Collect three valid sets of two pieces and declare to win. Sets are Gou (two pieces whose values sum to 9) or Doi (pair of same value; in hard variant, same colour or the value-2 pair only).',
          gameplay: 'Each turn: draw one piece (from discard or from table in distribution order), then discard one. Starting player may declare immediately if holding three sets; otherwise discards. First player to hold three valid sets after drawing declares and wins. If the table is exhausted with no declaration, there is no winner.',
          keyRules: [
            'Draw one, discard one per turn.',
            'Gou: two pieces summing to 9; Doi: pair same value (easy) or identical piece or value-2 pair only (hard).',
            'Win by declaring when holding three valid sets.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Collect pieces that sum to 9 or pair; discard pieces that do not help form Gou or Doi.',
          intermediate: 'Track which values have been discarded; in easy variant use both Gou and Doi; in hard variant focus on identical pairs or value-2.',
          advanced: 'Optimise draw choice (discard vs table) to complete three sets before opponents; block by taking useful discards.',
          tips: [
            'In easy variant prefer Gou (sum to 9) when you have many high or low pieces; in hard variant only identical pairs or value-2 count.',
            'Track what has been discarded to know which pieces are still in play.',
