        rules: {
          objective: 'Complete a legal winning hand with four melds and one pair while meeting table scoring requirements.',
          gameplay: 'Play proceeds by drawing from the wall and discarding. Players may claim discards for Chow, Pung, or Kong subject to priority and seat restrictions. A player wins by self-draw or discard claim when hand structure and scoring conditions are satisfied.',
          keyRules: [
            'Turn flow is draw then discard, with claim interruptions handled by priority.',
            'Chow claims are position-limited; Pung and Kong claims have broader access.',
            'Winning hand is based on four melds plus one pair with table-specific scoring thresholds.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Build efficient waits and avoid committing to rigid high-variance hand shapes too early.',
          intermediate: 'Use discard reading and visible tile tracking to balance speed against safety.',
          advanced: 'Adjust hand value ambitions dynamically based on opponent pressure and tile-flow information.',
          tips: [
            'Prefer two-sided waits over closed middle waits when speed matters.',
            'Retain flexible tiles early until your scoring route is stable.',
          ],
          hasPlaceholders: false,
