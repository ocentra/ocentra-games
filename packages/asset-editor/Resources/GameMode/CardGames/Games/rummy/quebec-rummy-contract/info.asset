    historyContent: {
      origins: "Derived from Continental Rummy and early 20th-century American contract variants. It evolved within Quebecois social clubs and homes into a standardized series of 'Steps'.",
      originCountries: [
        'Canada',
      ],
      timeline: [
        '1940s: Rummy traditions establish in rural Quebec.',
        "1970s: The 'Buying' mechanic (La Pige) becomes the signature differentiator for the Quebec version.",
        "2000s: Standard rules for the '11-round' expert variant are published locally.",
        "Present: A cultural staple, with many families having their own 'Table of Contracts' written on a card inside the box.",
      ],
      evolution: "The game prioritizes 'Runs' (suites) more than American versions, making the building of sequences a more central skill.",
      cultural: "Commonly played with 2 decks and 4 jokers; the joker is often called 'Le Pingouin' or simply 'Le Joker'.",
    },
