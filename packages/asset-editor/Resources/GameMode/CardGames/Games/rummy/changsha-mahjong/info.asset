            content: [
              {
                type: 'paragraph',
                text: 'Changsha Mahjong is a Chinese regional Mahjong variant associated with Changsha and surrounding Hunan play communities. It preserves classic draw-discard meld structure while following local rule profiles and scoring expectations.',
              },
              {
                type: 'paragraph',
                text: 'Changsha Mahjong developed as a regional expression of Chinese Mahjong play with local table preferences for pacing and hand valuation.',
              },
