            'Ten hands with changing contract requirements.',
            'Must meet the hand contract before laying off freely.',
            'Jokers and 2s are commonly wild, subject to table limits.',
            'Players may buy the top discard out of turn under agreed rules.',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: 'Prioritize completing current hand contract before chasing low-point cleanup.',
          intermediate: 'Track likely contract targets from opponent picks and discard behavior.',
