    historyContent: {
      origins: 'The game has a long history in southern China and is similar to Chinese draw-and-discard games played since the 18th century. The deck originated in the 19th century based on Xiangqi (Chinese chess) pieces. Stewart Culin noted these chess-derived cards were peculiar to Fujian and Guangdong; Karl Himly confirmed they were specific to Fujian. Chess cards are more recent than money-suited and domino cards. The cards were often used for gambling and may have appeared after the 1740 Qing ban on playing cards.',
      originCountries: [
        'China',
        'Vietnam',
        'Taiwan',
      ],
      timeline: [
        '1800s: Standardizes with Chess Characters.',
        'Today: Popular in Vietnam (Tu Sac) and Taiwan.',
      ],
      evolution: 'The point system is intricate (Generals score high).',
      cultural: 'Played in tea houses and family gatherings.',
    },
