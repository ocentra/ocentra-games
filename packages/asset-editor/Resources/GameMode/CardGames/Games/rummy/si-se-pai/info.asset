        },
        rules: {
          objective: 'Go out (Hu) by melding all of your cards into valid sets (single General, pairs, Pongs, Kongs) so that your total point value is an odd number; the first player to do so wins the hand.',
          gameplay: 'Each turn a player draws one card from the stock or the top of the discard pile, may lay down melds (single General, pairs, triplets/Pongs, quads/Kongs), then discards one card. The first to go out (Hu) by melding all cards with an odd point total wins the hand. Point system uses piece values; Generals score high.',
          keyRules: [
            'Draw one from stock or top discard, then optionally meld, then discard one.',
            'Melds: single General, pairs, triplets (Pongs), quads (Kongs).',
            'Go out (Hu) when all cards are melded and total points are odd (e.g. 21).',
          ],
          hasPlaceholders: false,
        },
        strategy: {
          basic: "Keep pairs. Pairs become Pongs easily. Don't break up Chows unless necessary. Watch discards to know what's safe.",
          intermediate: "The 'Sacrifice': Discarding a dangerous card early to avoid a huge penalty later. If you have 3 Generals, keep them for a Pong.",
          advanced: "Defensive Discarding: Don't feed the next player. If they need Green Advisors, hold them.",
          tips: [
            'Generals are valuable.',
            'Odd points only to win.',
          ],
          hasPlaceholders: false,
