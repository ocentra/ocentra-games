    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Sì Sè Pái',
            subtitle: 'Card Game',
            content: [
              {
                type: 'paragraph',
                text: 'Sì Sè Pái (Four Color Cards or Si Se Pai) is a Chinese card game similar to Rummy or Mahjong. It uses a deck of 112 cards divided into 4 colors (Red, Green, Yellow, White), featuring Chinese Chess pieces (General, Advisor, Elephant, etc.). The goal is to meld cards into sets (Commanders/Generals can be melded singly, Pairs, Triplets/Pongs, Quads/Kongs) to reach an odd number of points (usually 21 cards total).',
              },
              {
                type: 'paragraph',
                text: 'The game has a long history in southern China and is similar to Chinese draw-and-discard games played since the 18th century. The deck originated in the 19th century based on Xiangqi (Chinese chess) pieces. Stewart Culin noted these chess-derived cards were peculiar to Fujian and Guangdong; Karl Himly confirmed they were specific to Fujian. Chess cards are more recent than money-suited and domino cards. The cards were often used for gambling and may have appeared after the 1740 Qing ban on playing cards.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two or more players.',
              },
              {
                type: 'paragraph',
                text: '112 cards: four color suits (green, white, yellow, red), 28 cards per suit, each with the seven Xiangqi piece ranks and four copies per card; some sets include optional jokers.',
              },
              {
                type: 'paragraph',
                text: '112 cards: four color suits (green, white, yellow, red), 28 cards per suit, each with the seven Xiangqi piece ranks and four copies per card; some sets include optional jokers.',
              },
              {
                type: 'paragraph',
                text: 'Deal 20 cards to non-dealers, 21 to dealer.',
              },
            ],
          },
        ],
      },
