    aiContent: {
      difficulty: {
        easy: 'Forms obvious melds, knocks late, and does limited discard inference.',
        medium: 'Tracks discard memory, deadwood thresholds, and knocks at favorable margins.',
        hard: 'Models opponent hand from pickup/discard history, manages undercut risk, and optimizes knock versus gin equity.',
      },
      considerations: [
        'AI must reason about hidden information and discard signal leakage in two-player perfect-recall style play.',
        'Knock decision policy should compare expected gain from immediate knock against draw continuation risk.',
      ],
