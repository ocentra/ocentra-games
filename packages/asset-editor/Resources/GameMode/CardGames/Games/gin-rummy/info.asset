    historyContent: {
      origins: 'Gin Rummy was created by New York Bridge player Elwood T. Baker around 1911, from the Mexican game Conquian and the American game Rum.',
      originCountries: [
        'United States',
      ],
      timeline: [
        'Early 1910s: Developed in New York as a two-player rummy form.',
        '1940s: Became a popular Hollywood and club game with bonus-heavy scoring variants.',
        'Modern era: Remains a widely played competitive and casual two-player card game.',
      ],
      evolution: 'Core draw-discard and knock structure remained stable while bonus values and deal procedures vary by table and tournament rules.',
      cultural: 'Gin Rummy became one of the best-known head-to-head card games in American social and tournament play.',
    },
