  data: {
    hero: {
      title: 'GIN RUMMY',
      subtitle: 'Two-Player Knock Rummy',
    },
    sections: [
      {
        type: 'about',
        tabLabel: 'About',
        pages: [
          {
            title: 'Gin Rummy',
            subtitle: 'Two-Player Knock Rummy',
            content: [
              {
                type: 'paragraph',
                text: 'Gin Rummy is a two-player knock-rummy game where players draw and discard to build sets and runs, then end a hand by knocking with low deadwood or going gin with no deadwood.',
              },
              {
                type: 'paragraph',
                text: 'Gin Rummy was created by New York Bridge player Elwood T. Baker around 1911, from the Mexican game Conquian and the American game Rum.',
              },
            ],
          },
          {
            title: 'Setup',
            subtitle: 'Table, deck, equipment, and deal',
            content: [
              {
                type: 'paragraph',
                text: 'Two players only, head-to-head; no partnerships. Each player receives ten cards per hand. Dealership alternates from round to round; the first dealer is often chosen by drawing cards from the pack (lower card deals), and subsequently the winner of the previous hand deals.',
              },
              {
                type: 'paragraph',
                text: 'Standard 52-card deck, ace low in runs.',
              },
              {
                type: 'paragraph',
                text: 'Scorepad for cumulative hand and game bonuses.',
              },
              {
                type: 'paragraph',
                text: 'Deal 10 cards to each player one at a time. Turn the next card face up as first discard and place the rest face down as stock.',
              },
            ],
          },
          {
            title: 'Variations',
            subtitle: 'Known ways this game changes',
            content: [
              {
                type: 'list',
                style: 'unordered',
                items: [
                  {
                    text: '25-Point Bonus Tables: Some groups use 25 for gin bonus and/or undercut bonus instead of 20 and 10.',
                  },
                  {
                    text: 'Oklahoma Gin: Initial upcard value sets knock limit and a spade upcard doubles hand score; game target is often 150.',
                  },
                  {
                    text: '11-Card Non-Dealer Start: Alternative opening deals 11 to non-dealer and 10 to dealer with no upcard, then non-dealer discards first.',
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
