{
  "name": "@ocentra/asset-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Asset Editor — standalone Vite app, dev-only tool for creating and editing game assets.",
  "scripts": {
    "validate:game-assets": "cd ../.. && npm run validate:game-assets",
    "dev:prep": "npm --prefix ../.. run dev:prep:editor",
    "generate:inspector-map": "node scripts/generate-inspector-map.mjs",
    "generate:processed-game-bundle": "npx tsx scripts/generate-processed-game-bundle.ts",
    "install:processed-game-bundle": "npx tsx scripts/install-processed-game-bundle.ts",
    "predev": "npm run validate:game-assets",
    "dev": "cd ../.. && npx tsx scripts/dev/dev-editor-interactive.ts",
    "predev:web": "npm run validate:game-assets",
    "dev:web": "cd ../.. && npx tsx scripts/dev/dev-editor-vite.ts",
    "predev:raw": "npm run validate:game-assets",
    "dev:raw": "cross-env VITE_ECHO_LOGS_TO_TERMINAL=1 vite",
    "prebuild": "npm run validate:game-assets",
    "build": "npm run generate:inspector-map && vite build",
    "preview": "vite preview",
    "pretest": "npm run validate:game-assets",
    "test": "npm --prefix ../game-domain run build && npm --prefix ../game-asset-domain run build && npm run generate:inspector-map && vitest run --config vitest.config.ts",
    "test:watch": "npm run generate:inspector-map && vitest --config vitest.config.ts",
    "test:coverage": "npm run generate:inspector-map && vitest run --config vitest.config.ts --coverage",
    "tauri": "cargo tauri",
    "predev:tauri": "npm run validate:game-assets",
    "dev:tauri": "cd ../.. && npx tsx scripts/dev/dev-editor-tauri.ts",
    "predev:tauri-fast": "npm run validate:game-assets",
    "dev:tauri-fast": "npm run dev:web",
    "prebuild:tauri": "npm run validate:game-assets",
    "build:tauri": "cargo tauri build",
    "type-check": "npm run generate:inspector-map && tsc --noEmit",
    "lint": "node -e \"const cmd = process.env.TURBO_HASH ? 'npm run lint:exec' : 'npx turbo run lint:exec --filter=@ocentra/asset-editor'; require('child_process').spawnSync(cmd.split(' ')[0], cmd.split(' ').slice(1), { stdio: 'inherit', shell: true });\"",
    "lint:exec": "eslint --cache src && tsc --noEmit",
    "lint:local": "eslint --cache src scripts vite.config.ts && tsc --noEmit && npm run validate:game-assets",
    "validate:assets": "cd ../.. && npx tsx --tsconfig tsconfig.node.json scripts/validate-assets-only.ts packages/asset-editor/Resources/**/*.asset",
    "validate-cards": "cd ../game-asset-domain && npm run validate-cards",
    "maintenance:reset-local-cache": "node scripts/reset-local-cache.mjs",
    "lint:eslint": "eslint --cache src scripts vite.config.ts",
    "lint:fix": "eslint --cache src scripts vite.config.ts --fix",
    "env:from-google-json": "node scripts/from-google-json.mjs",
    "meta:images:create-missing": "node scripts/create-missing-image-meta.mjs GameMode/CardGames/Images",
    "meta:images:create-missing:dry": "node scripts/create-missing-image-meta.mjs GameMode/CardGames/Images --dry-run"
  },
  "dependencies": {
    "@ocentra/app-assets": "file:../app-assets",
    "@ocentra/app-core": "file:../app-core",
    "@ocentra/asset-domain": "file:../asset-domain",
    "@ocentra/asset-editor-types": "file:../asset-editor-types",
    "@ocentra/boundary-domain": "file:../boundary-domain",
    "@ocentra/card-game-ui": "file:../card-game-ui",
    "@ocentra/card-games": "file:../card-games",
    "@ocentra/core-ui": "file:../core-ui",
    "@ocentra/endpoint-domain": "file:../endpoint-domain",
    "@ocentra/eventing-domain": "file:../eventing-domain",
    "@ocentra/game-asset-domain": "file:../game-asset-domain",
    "@ocentra/game-domain": "file:../game-domain",
    "@ocentra/game-layout-domain": "file:../game-layout-domain",
    "@ocentra/game-ui-types": "file:../game-ui-types",
    "@ocentra/logging-domain": "file:../logging-domain",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "firebase": "^12.5.0",
    "json5": "^2.2.3",
    "rc-dock": "^4.0.0-alpha.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@ocentra/schema-domain": "file:../schema-domain"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.12.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
