  "scripts": {
    "build": "tsc && tsc-alias && node scripts/fix-dist-aliases.mjs && node ../../scripts/fix-esm-imports.mjs && node scripts/fix-card-ranking-declarations.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache src && tsc --noEmit",
    "lint:eslint": "eslint --cache src",
    "lint:fix": "eslint --cache src --fix",
    "validate-assets": "npx tsx scripts/validate-assets.ts",
    "validate-card-rankings": "npx tsx scripts/validate-card-rankings.ts",
    "validate-cards": "npx tsx scripts/validate-cards.ts",
    "validate-decks": "npx tsx scripts/validate-decks.ts",
    "validate-deck-semantic-readiness": "npx tsx scripts/validate-deck-semantic-readiness.ts",
    "validate-domino-decks": "npx tsx scripts/validate-domino-decks.ts",
    "validate-hanafuda-decks": "npx tsx scripts/validate-hanafuda-decks.ts",
    "validate-mahjong-decks": "npx tsx scripts/validate-mahjong-decks.ts",
    "validate-playing-card-decks": "npx tsx scripts/validate-playing-card-decks.ts",
    "report-deck-triple-coverage": "npx tsx scripts/report-deck-triple-coverage.ts",
    "report-card-pool-duplication": "npx tsx scripts/report-card-pool-duplication.ts",
    "validate-deck-triple-coverage": "npx tsx scripts/report-deck-triple-coverage.ts --fail-on-gap",
    "sync-card-game-assets": "npx tsx scripts/sync-card-game-assets.ts",
    "sync-card-image-links": "npx tsx scripts/sync-card-image-links.ts",
    "sync-card-image-links:write": "npx tsx scripts/sync-card-image-links.ts --write",
    "sync-tile-image-links": "npx tsx scripts/sync-tile-image-links.ts",
    "sync-tile-image-links:write": "npx tsx scripts/sync-tile-image-links.ts --write",
    "sync-tarot-family-image-hashes": "node scripts/sync-tarot-family-image-hashes.mjs",
    "fill-normaldeck-image-hashes": "npx tsx scripts/fill-normaldeck-image-hashes.ts",
    "test": "npm --prefix ../game-domain run build && vitest --run -c vitest.config.ts"
  },
