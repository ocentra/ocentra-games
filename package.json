    "@ocentra/app-core": "file:./packages/app-core",
    "@ocentra/asset-domain": "file:./packages/asset-domain",
    "@ocentra/auth-domain": "file:./packages/auth-domain",
    "@ocentra/behaviour-domain": "file:./packages/behaviour-domain",
    "@ocentra/boundary-domain": "file:./packages/boundary-domain",
    "@ocentra/card-game-ui": "file:./packages/card-game-ui",
    "@ocentra/core-ui": "file:./packages/core-ui",
    "@ocentra/credentials-domain": "file:./packages/credentials-domain",
    "@ocentra/crypto-domain": "file:./packages/crypto-domain",
    "@ocentra/endpoint-domain": "file:./packages/endpoint-domain",
    "@ocentra/eventing-domain": "file:./packages/eventing-domain",
    "@ocentra/game-asset-domain": "file:./packages/game-asset-domain",
