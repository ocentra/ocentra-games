    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "json5": "^2.2.3",
    "playwright": "^1.56.1",
    "postcss": "^8.5.14",
    "postcss-px-to-viewport": "^1.1.1",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.0.0",
    "vite-plugin-inspect": "^11.3.3",
