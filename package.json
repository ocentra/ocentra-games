    "axios": "^1.16.1",
    "better-sqlite3": "^12.4.1",
    "bs58": "^6.0.0",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "fast-glob": "^3.3.3",
    "firebase": "^12.5.0",
    "framer-motion": "^12.38.0",
    "kokoro-js": "^1.2.1",
    "p-limit": "^7.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.4",
