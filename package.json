    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@coral-xyz/anchor": "^0.32.1",
    "@huggingface/transformers": "^3.7.6",
    "@ocentra/ai-domain": "file:./packages/ai-domain",
