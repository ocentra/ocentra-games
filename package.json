    "@ocentra/game-ui-types": "file:./packages/game-ui-types",
    "@ocentra/logging-domain": "file:./packages/logging-domain",
    "@ocentra/network-domain": "file:./packages/network-domain",
    "@ocentra/schema-domain": "file:./packages/schema-domain",
    "@ocentra/seo-domain": "file:./packages/seo-domain",
    "@ocentra/solana-domain": "file:./packages/solana-domain",
