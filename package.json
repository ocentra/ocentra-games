{
  "name": "@ocentra/main-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "infra/cloudflare",
    "infra/firebase",
    "infra/firebase/functions",
    "scratchpad"
  ],
  "type": "module",
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "protobufjs": "7.5.8",
    "tar": "7.5.15"
  },
  "scripts": {
    "security:scan-staged": "node scripts/security/scan-staged-secrets.mjs",
    "security:scan-repo": "node scripts/security/scan-staged-secrets.mjs --repo",
    "hooks:install": "node scripts/git-hooks/install-pre-commit.mjs",
    "validate:game-assets": "node scripts/validate-game-assets-strict.mjs",
    "build:domains:exec": "turbo run build --filter=./packages/* --filter=!@ocentra/asset-editor",
    "build:domains": "npm run build:domains:exec && npm run validate:game-assets",
    "prebuild:main": "npm run validate:game-assets",
    "build:main": "node scripts/build/run-main-build.cjs",
    "prebuild:editor": "npm run validate:game-assets",
    "build:editor": "node scripts/build/run-turbo-build.cjs @ocentra/asset-editor...",
    "prebuild": "node scripts/build/prebuild.cjs",
    "dev:prep": "npm run dev:prep:main",
    "dev:prep:main": "npx tsx scripts/dev/turbo-dev-prep.ts main",
    "dev:prep:editor": "npx tsx scripts/dev/turbo-dev-prep.ts editor",
    "dev:prep:worker": "npx tsx scripts/dev/turbo-dev-prep.ts worker",
    "pretest": "npm run build:domains",
    "generate:exports-flattened": "npx tsx scripts/generate-exports-flattened.ts",
    "generate:catalog-seo": "node scripts/seo/generate-catalog-seo-data.mjs",
    "seo:audit": "npm --prefix packages/seo-domain run build && node scripts/seo/audit-local.mjs",
    "seo:audit:full": "npm --prefix packages/seo-domain run build && node scripts/seo/audit-local.mjs --full",
    "seo:audit:local": "npm run seo:audit",
    "predev": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev": "npx tsx scripts/dev/dev-interactive.ts",
    "predev:nobackend": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:nobackend": "npx tsx scripts/dev/dev.ts",
    "predev:main": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:main": "npx tsx scripts/dev/dev-full.ts",
    "predev:main:nobackend": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:main:nobackend": "npx tsx scripts/dev/dev.ts",
    "predev:web": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:web": "npx tsx scripts/dev/dev-interactive.ts --target=web",
    "predev:tauri": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:tauri": "npx tsx scripts/dev/dev-interactive.ts --target=tauri",
    "predev:android": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:android": "npx tsx scripts/dev/dev-interactive.ts --target=android",
    "predev:ios": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:ios": "npx tsx scripts/dev/dev-interactive.ts --target=ios",
    "predev:compare": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:compare": "npx tsx scripts/dev/dev-platform-compare.ts",
    "predev:compare:web-tauri": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:compare:web-tauri": "npx tsx scripts/dev/dev-platform-compare.ts --targets=web,tauri",
    "predev:compare:web-android": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:compare:web-android": "npx tsx scripts/dev/dev-platform-compare.ts --targets=web,android",
    "predev:compare:all": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:compare:all": "npx tsx scripts/dev/dev-platform-compare.ts --targets=web,tauri,android",
    "predev:android:stack": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:android:stack": "npx tsx scripts/dev/dev-mobile-full.ts --target=android",
    "predev:ios:stack": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:ios:stack": "npx tsx scripts/dev/dev-mobile-full.ts --target=ios",
    "predev:worker": "npm run validate:game-assets",
    "dev:worker": "cd infra/cloudflare && npm run dev",
    "dev:seed": "cd infra/cloudflare && npm run seed:products:local",
    "dev:seed:assets": "node scripts/dev/run-seed-and-verify.mjs",
    "dev:seed:assets:tee": "node scripts/dev/run-seed-and-verify.mjs --tee",
    "dev:seed:assets:force": "node scripts/dev/run-seed-and-verify.mjs --force",
    "predev:editor": "npm run validate:game-assets",
    "dev:editor": "cd packages/asset-editor && npm run dev",
    "dev:scratchpad": "npm --prefix scratchpad run dev",
    "predev:editor:stack": "npm run validate:game-assets",
    "dev:editor:stack": "npx tsx scripts/dev/dev-editor-full.ts",
    "predev:editor:e2e": "npm run validate:game-assets",
    "dev:editor:e2e": "node scripts/dev/start-editor-e2e.mjs",
    "predev:editor:tauri": "npm run validate:game-assets",
    "dev:editor:tauri": "cd packages/asset-editor && cargo tauri dev",
    "predev:fast": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:fast": "node scripts/dev/dev-fast.cjs",
    "predev:clean": "npm run validate:game-assets && npm run generate:exports-flattened",
    "dev:clean": "npx tsx scripts/dev/dev.ts",
    "build": "npm run generate:catalog-seo && npx tsx scripts/generate-exports-flattened.ts && npx tsx scripts/generate-registry-maps.ts && tsc -b && vite build && node scripts/build/verify-build.js",
    "build:analyze": "npm run generate:catalog-seo && npx tsx scripts/generate-exports-flattened.ts && npx tsx scripts/generate-registry-maps.ts && tsc -b && cross-env VITE_ANALYZE=1 vite build",
    "build:verify": "node scripts/build/verify-build.js",
    "lint:schema-boundaries": "node scripts/check-no-zod-source.mjs && node scripts/check-no-naked-domain-strings.mjs",
    "lint": "npm run validate:game-assets && npm run lint:schema-boundaries && turbo run lint:exec type-check",
    "lint:scratchpad": "npm --prefix scratchpad run lint",
    "lint:local": "eslint src vite scripts vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js --ignore-pattern \"scripts/test/monitoring/**\" && npx tsx --tsconfig tsconfig.node.json scripts/validate-required-fields.ts && npm run type-check",
    "validate": "npm run validate:game-assets && npm run lint:schema-boundaries && turbo run lint:exec type-check",
    "validate:main": "npm run validate:game-assets && turbo run lint:exec type-check --filter=!@ocentra/asset-editor",
    "validate:editor": "npm run validate:game-assets && turbo run lint:exec type-check --filter=@ocentra/asset-editor...",
    "validate:pages:dist": "npx tsx scripts/dev/preview-stack.ts --pages --skip-build --smoke",
    "validate:pages:local": "npx tsx scripts/dev/preview-stack.ts --pages --with-worker --smoke",
    "validate:pages:routes": "npx tsx scripts/dev/preview-stack.ts --pages --with-worker --smoke --route-matrix",
    "validate:pages:routes:dev": "npx tsx scripts/dev/preview-stack.ts --pages --with-worker --smoke --route-matrix --compare-base=https://main.ocentra-games.pages.dev",
    "validate:pages:dev": "npx tsx scripts/dev/preview-stack.ts --pages --sync-assets=development --smoke",
    "validate:pages:prod": "npx tsx scripts/dev/preview-stack.ts --pages --sync-assets=production --smoke",
    "lint:fix": "eslint src vite scripts vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js --ignore-pattern \"scripts/test/monitoring/**\" --fix",
    "lint:eslint": "eslint src vite scripts vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js --ignore-pattern \"scripts/test/monitoring/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "type-check": "npx tsx scripts/generate-exports-flattened.ts && npx tsx scripts/generate-registry-maps.ts && npm run build:domains && tsc -b",
    "type-check:scratchpad": "npm --prefix scratchpad run type-check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:editor": "npm --prefix packages/asset-editor run test",
    "test:integration": "vitest --run src/services/storage/__tests__/R2Service.integration.test.ts",
    "test:load": "vitest --run src/services/__tests__/load",
    "test:storage:e2e": "vitest run src/services/storage/__tests__/R2Service.e2e.test.ts",
    "test:storage:hello": "vitest run src/services/storage/__tests__/R2Service.hello.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:editor": "playwright test -c playwright.editor-full.config.ts",
    "test:e2e:editor:ui": "playwright test -c playwright.editor.config.ts",
    "test:e2e:editor:full": "playwright test -c playwright.editor-full.config.ts",
    "test:editor:prod-smoke": "node scripts/test/editor-prod-smoke.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:firebase": "node scripts/firebase/test-firebase.cjs",
    "debug:auth": "node scripts/firebase/debug-auth.cjs",
    "upload-assets": "npx tsx --tsconfig tsconfig.node.json scripts/build/upload-assets.ts",
    "sync:assets:prod": "npx tsx scripts/sync-assets-to-prod.ts",
    "sync:assets:dev": "cross-env SYNC_ENV=development npx tsx scripts/sync-assets-to-prod.ts",
    "wipe:r2:remote-assets": "npx tsx infra/cloudflare/scripts/wipe-remote-r2-asset-buckets.ts",
    "validate:meta-system": "npx tsx --tsconfig tsconfig.node.json src/services/assets/__tests__/integration/validate-meta-system.ts",
    "validate:required-assets": "npx tsx --tsconfig tsconfig.node.json scripts/required-assets-report.ts",
    "test:meta-tdd": "npx tsx --tsconfig tsconfig.node.json src/services/assets/__tests__/integration/test-meta-system-comprehensive.ts",
    "test:idb-e2e": "playwright test --project db-e2e",
    "tunnel:bridge": "npx tsx scripts/start-tunnel-and-bridge.ts",
    "logs:main": "npx tsx scripts/logs/query-app-logs.ts recent --scope main",
    "logs:main:errors": "npx tsx scripts/logs/query-app-logs.ts errors --scope main",
    "logs:main:stats": "npx tsx scripts/logs/query-app-logs.ts stats --scope main",
    "logs:android": "node scripts/mobile/android-logcat.mjs",
    "logs:android:dump": "node scripts/mobile/android-logcat.mjs --dump",
    "logs:android:auth": "node scripts/mobile/android-logcat.mjs --auth",
    "logs:vite": "npx tsx scripts/logs/query-app-logs.ts recent --scope vite",
    "logs:vite:errors": "npx tsx scripts/logs/query-app-logs.ts errors --scope vite",
    "logs:query": "npx tsx scripts/logs/query-app-logs.ts",
    "chunk-map": "npx tsx scripts/dev/chunk-map.ts",
    "logs:db:rebuild": "npx tsx scripts/logs/rebuild-app-db.ts",
    "cap:sync": "vite build && npx cap sync",
    "cap:android": "vite build && npx cap sync android && npx cap open android",
    "run:android": "vite build && npx cap sync android && npx cap run android && node scripts/android-launch.mjs",
    "cap:ios": "vite build && npx cap sync ios && npx cap open ios",
    "tauri:dev": "cd platforms/desktop && tauri dev -c tauri/tauri.conf.json",
    "tauri:build": "cd platforms/desktop && tauri build -c tauri/tauri.conf.json",
    "tauri:clean": "cd platforms/desktop/tauri && cargo clean && cd ../../..",
    "env:from-google-json": "node scripts/from-google-json.mjs",
    "generate:icons": "npx @capacitor/assets generate --android --androidProject platforms/mobile/android --assetPath packages/app-assets/src/images/mobile-icons"
  },
  "dependencies": {
