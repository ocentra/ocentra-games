{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start tunnel and log bridge",
      "type": "shell",
      "command": "npm run tunnel:bridge",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Tunnel \\+ Bridge Startup",
          "endsPattern": "Bridge is ready"
        }
      },
      "group": "none",
      "runOptions": {
        "instanceLimit": 1,
        "runOn": "folderOpen"
      }
    }
  ]
}
