{
  "productName": "Ocentra",
  "version": "0.1.0",
  "identifier": "gg.ocentra.desktop",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npx tsx scripts/dev/wait-for-dev-server.ts --url=http://localhost:3000",
    "beforeBuildCommand": "npm run build:main"
  },
  "app": {
    "windows": [
      {
        "title": "Ocentra",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
