# Single claim-storage worker (matches, credits, assets, admin APIs)
VITE_R2_WORKER_URL=http://127.0.0.1:8787

# Consolidated claim-storage base URL for asset API routes.
# Deprecated fallback still exists in code: VITE_ASSETS_WORKER_URL
VITE_CLAIM_STORAGE_URL=http://127.0.0.1:8787

# Public asset base URL (main app/editor reads by GUID/hash/checksum)
# Local dev should point to the local claim-storage asset route.
# Production should point to your public assets host, e.g. https://assets.ocentra.ca
VITE_ASSETS_PUBLIC_URL=http://127.0.0.1:8787/api/v1/assets

VITE_R2_BUCKET_NAME=claim-matches
VITE_R2_ASSETS_BUCKET=ocentra-assets

# Asset Editor — Google OAuth (Tauri desktop sign-in via system browser)
# Use the Web client ID that Firebase auto-created for your project:
#   Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID
# It looks like: 123456789-abcdef.apps.googleusercontent.com
#
# Then in Google Cloud Console → APIs & Services → Credentials → find that Web client →
# add http://127.0.0.1 to Authorized redirect URIs (no port needed — Google allows any port on 127.0.0.1)
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Test-only credentials (copy to repo-root .env; never commit .env). CI: set matching repository secrets — see .github/workflows/cloudflare-security-tests.yml env.
CF_TESTS_STRIPE_SECRET_KEY=
CF_TESTS_AI_API_KEY=
CF_TESTS_FIREBASE_PRIVATE_KEY_PEM=
CF_TESTS_AI_SUBSTITUTE_DEFAULT_KEY=
CF_TESTS_AI_LEAKAGE_FAKE_KEY=
